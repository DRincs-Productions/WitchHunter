# TODO: Translation updated at 2023-07-25 15:55 #|#|# # game/scripts/quests/elyonDepravity/elyon_depravity_intro.rpy:4 #-#-# translate crowdin elyon_depravity_intro_f8d988aa:
msgid "[_cedrick_] (Что ж, думаю, настало время для развращения нашей дорогой Элион. После всего, что произошло, она попросту не сможет мне отказать)"
msgstr "[_cedrick_] (Bueno, creo que es hora de corromper a nuestra querida Elyon. Después de todo lo que ha pasado, ella simplemente no puede rechazarme.)"

# game/scripts/quests/elyonDepravity/elyon_depravity_intro.rpy:5 #-#-# translate crowdin elyon_depravity_intro_6d9e92ca:
msgid "[_cedrick_] Элион. У меня для тебя есть одно задание"
msgstr "[_cedrick_] Elyon. Tengo una tarea para ti."

# game/scripts/quests/elyonDepravity/elyon_depravity_intro.rpy:9 #-#-# translate crowdin elyon_depravity_intro_bbf1520e:
msgid "[_elion_] Мм? Какое задание, Рик?"
msgstr "[_elion_] ¿Mmm? ¿Qué tarea, Rick?"

# game/scripts/quests/elyonDepravity/elyon_depravity_intro.rpy:10 #-#-# translate crowdin elyon_depravity_intro_7d4c462e:
msgid "[_cedrick_] Помнишь, мы говорили о твоей неконтролируемой развратности?"
msgstr "[_cedrick_] ¿Recuerdas que hablamos de tu depravación incontrolable?"

# game/scripts/quests/elyonDepravity/elyon_depravity_intro.rpy:13 #-#-# translate crowdin elyon_depravity_intro_6371948e:
msgid "[_elion_] Э-эм.. Да, я помню.."
msgstr "[_elion_] Um… Sí, lo recuerdo…"

# game/scripts/quests/elyonDepravity/elyon_depravity_intro.rpy:14 #-#-# translate crowdin elyon_depravity_intro_78d23bb8:
msgid "[_cedrick_] Самое время заняться твоей развращенностью"
msgstr "[_cedrick_] Es hora de lidiar con tu depravación."

# game/scripts/quests/elyonDepravity/elyon_depravity_intro.rpy:17 #-#-# translate crowdin elyon_depravity_intro_f29ad734:
msgid "[_elion_] Ч-что!? Что ты имеешь ввиду, Рик!?"
msgstr "[_elion_] ¿¡Q-qué!? ¿¡Qué quieres decir, Rick!?"

# game/scripts/quests/elyonDepravity/elyon_depravity_intro.rpy:18 #-#-# translate crowdin elyon_depravity_intro_7778e5ad:
msgid "[_cedrick_] Эм, не пойми меня неправильно. Я лишь хочу сказать, что твои похотливые желания могут спадать на нет, если ими как следует заняться"
msgstr "[_cedrick_] Um, no me malinterpretes. Sólo quiero decir que tus deseos lujuriosos pueden disminuir si se abordan adecuadamente."

# game/scripts/quests/elyonDepravity/elyon_depravity_intro.rpy:19 #-#-# translate crowdin elyon_depravity_intro_bbe4e9ba:
msgid "[_cedrick_] Мы же это обсуждали, помнишь? Твои похотливые желания нужно удовлетворять, раз ты не можешь их сдерживать, об этом мы договорились"
msgstr "[_cedrick_] Hablamos de esto, ¿recuerdas? Tus deseos lujuriosos deben ser satisfechos, ya que no puedes reprimirlos, acordamos esto."

# game/scripts/quests/elyonDepravity/elyon_depravity_intro.rpy:20 #-#-# translate crowdin elyon_depravity_intro_dbb61f1f:
msgid "[_cedrick_] Ты подумала над моим предложением? Согласна, чтобы я помог тебе с, эм… Твоей развратной стороной? Чтобы это не привело к ситуации, которая случилась в школе"
msgstr "[_cedrick_] ¿Has pensado en mi propuesta? ¿Quieres que te ayude con tu… um… tu lado travieso? Para que esto no conduzca a la situación que pasó en la escuela."

# game/scripts/quests/elyonDepravity/elyon_depravity_intro.rpy:23 #-#-# translate crowdin elyon_depravity_intro_9cc91c12:
msgid "[_elion_] Д-да, Рик. Хорошо, я согласна. Помоги мне с.. с моей развратностью. Не знаю, что ты имеешь ввиду под этим и куда это может завести, но.. Я доверюсь тебе в этом"
msgstr "[_elion_] S-sí, Rick. Está bien, estoy de acuerdo. Ayúdame con… con mi depravación. No sé qué quieres decir con eso ni adónde podría llevar, pero… confiaré en ti en esto."

# game/scripts/quests/elyonDepravity/elyon_depravity_intro.rpy:25 #-#-# translate crowdin elyon_depravity_intro_7b3847cf:
msgid "[_Somka108_] {size=16}Теперь вы можете делать различные вещи с Элион через кнопку действия, данные действия будут повышать развратность. Реакция Элион на просьбы будет изменяться в зависимости от количество развратности. Прохождение данных действий необходимо для продолжение сюжета игры, каждое из, действий нужно пройти несколько раз{/size}"
msgstr "[_Somka108_] {size=16}Ahora puedes hacer varias cosas con Elyon a través del botón de acción, estas acciones aumentarán la depravación. La reacción de Elyon a las solicitudes variará según la cantidad de depravación. Completar estas acciones es necesario para continuar la trama del juego, cada una de las acciones debe completarse varias veces{/size}"

