# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:180 #-#-# translate crowdin gallery_d_060_bfc3fece:
msgid "[_susan_] Ох, Рик, ты такой заботливый. Это отличная идея"
