# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:3 #-#-# translate crowdin crystal_essence_2_go_to_will_home_8f648b59:
msgid "[_centered_] {size=37}В ДОМЕ СЕМЕЙСТВА ВЭНДОМ{/size}"
msgstr "[_centered_] {size=37}LA CASA DE LA FAMILIA Vandom{/size}"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:7 #-#-# translate crowdin gallery_d_059_e0f1bceb:
msgid "[_cedrick_] Хей, Сьюзан, Вилл, я дома!"
msgstr "[_cedrick_] ¡Oye, Susan, Will, estoy en casa!"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:8 #-#-# translate crowdin gallery_d_059_6362dd8e:
msgid "[_cedrick_] (Хах, как странно говорить подобные слова.. Словно это моя семья или типо того. Я определенно начинаю к этому привыкать)"
msgstr "[_cedrick_] (Ja, qué extraño es decir tales palabras. Es como si fuera mi familia o eso. Definitivamente estoy empezando a acostumbrarme.)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:9 #-#-# translate crowdin gallery_d_059_fe2dd863:
msgid "[_susan_] Рик, ты опоздал! Я на кухне, твой особый десерт уже готов.."
msgstr "[_susan_] ¡Rick, llegas tarde! Estoy en la cocina, tu postre especial está listo."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:10 #-#-# translate crowdin gallery_d_059_dfa579a6:
msgid "[_cedrick_] Ооо, уже иду"
msgstr "[_cedrick_] Ooh, ya viene"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:12 #-#-# translate crowdin gallery_d_059_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:15 #-#-# translate crowdin gallery_d_059_a0956af0:
msgid "[_cedrick_] Воооу, это и есть мой особенный десерт?"
msgstr "[_cedrick_] Voy, ¿es mi postre especial?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:17 #-#-# translate crowdin gallery_d_059_296728ce:
msgid "[_susan_] Ммм, да.. Ты последнее время так много сил и времени уделяешь нам, прямо как полноценный член семьи.. И Вилл уже принимает тебя как родного"
msgstr "[_susan_] Mmm, sí. Nos has estado dando tanto tiempo últimamente, como un miembro de la familia de pleno derecho. Y Will ya te está tomando como nativo"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:19 #-#-# translate crowdin gallery_d_059_bf3a16e7:
msgid "[_susan_] Вот я и решила отблагодарить тебя, эм.. Совместной семейной готовкой. Вилл нам не помешает, последнее время она надолго задерживается у себя в комнате"
msgstr "[_susan_] Así que decidí agradecerte, um. Co-cocina familiar. ¿No podemos hacer daño, ella ha estado en su habitación últimamente por mucho tiempo"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:20 #-#-# translate crowdin gallery_d_059_0ce339c5:
msgid "[_cedrick_] (Хах, я ожидал чего-то подобного от Сьюзан. Все же она становится чертовски развратной женщиной, если как следует дать ей попробовать хорошего члена)"
msgstr "[_cedrick_] (Jaja, esperaba algo como esto de Susan. Aún así, ¿se convierte en una mujer depravada si le das un buen pene?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:21 #-#-# translate crowdin gallery_d_059_251c4945:
msgid "[_cedrick_] (Интересно, это семейная черта? Хотя, думаю вскоре я это узнаю)"
msgstr "[_cedrick_] (Me pregunto si es un rasgo familiar. Aunque creo que pronto lo averiguaré)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:23 #-#-# translate crowdin gallery_d_059_bc17000e:
msgid "[_susan_] Ну, чего же ты ждешь? Давай, помоги мне приготовить блинчики"
msgstr "[_susan_] Bueno, ¿qué esperas? Vamos, ayúdame a preparar panqueques."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:24 #-#-# translate crowdin gallery_d_059_d46a557b:
msgid "[_cedrick_] Ооо, поверь, еще как помогу!"
msgstr "[_cedrick_] Ooh, créeme, ¡de qué otra manera ayudaré!"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:26 #-#-# translate crowdin gallery_d_059_a20cefa7_1:
msgid "..."
msgstr "..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:30 #-#-# translate crowdin gallery_d_059_fd92f976:
msgid "[_cedrick_] Ох, черт, отлично входит"
msgstr "[_cedrick_] Oh, maldita sea, genial iniciar sesión"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:31 #-#-# translate crowdin gallery_d_059_bca24eed:
msgid "[_susan_] Ммм, да, Рик, возьми меня сзади!"
msgstr "[_susan_] ¡Mmm, sí, Rick, llévame por detrás!"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:32 #-#-# translate crowdin gallery_d_059_283d2576:
msgid "[_cedrick_] Твоя киска все сильнее привыкает к моему члену, уже машинально начинает втягивать"
msgstr "[_cedrick_] Tu vagina se acostumbra cada vez más a mi pene; ya empieza a succionarlo por reflejo."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:33 #-#-# translate crowdin gallery_d_059_95c1e5b4:
msgid "[_susan_] Еще бы.. После того, как ты начал так часто и жестко меня трахать.. К этому сложно не привыкнуть, знаешь ли.."
msgstr "[_susan_] Claro... Después de que empezaste a cogerme tan seguido y con tanta fuerza... Es difícil no acostumbrarse, ¿sabes?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:34 #-#-# translate crowdin gallery_d_059_45b2fc89:
msgid "[_cedrick_] Уххх, знаешь, никогда бы не подумал, что ты такая извращенка.. Твоя дочь ведь может войти в любой момент, где твоя осторожность"
msgstr "[_cedrick_] Uh, ya sabes, nunca pensé que fueras tan perverso... Su hija puede entrar en cualquier momento donde su precaución"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:35 #-#-# translate crowdin gallery_d_059_65b415fd:
msgid "[_susan_] Аааххх.. Ну прости, после вчерашней ночи я могу думать только о твоем члене.. Сложно быть осторожной, когда в доме живет такой мужчина"
msgstr "[_susan_] Aaaah... Perdón, después de anoche solo puedo pensar en tu pene... Es difícil ser prudente cuando un hombre así vive en casa."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:36 #-#-# translate crowdin gallery_d_059_c16b9e49:
msgid "[_cedrick_] Ооо, даже так? Несмотря на свой волевой характер, ты все же нуждаешься в твердой мужской руке?"
msgstr "[_cedrick_] Oh, ¿incluso So? A pesar de tu carácter de voluntad fuerte, ¿todavía necesitas una mano masculina sólida?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:37 #-#-# translate crowdin gallery_d_059_749e3e55:
msgid "[_susan_] Мммф.. Само собой.. Вся моя твердость была лишь вынужденной мерой матери одиночки.."
msgstr "[_susan_] Mmf... Por supuesto... Toda mi dureza era solo la medida forzada de una madre soltera."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:38 #-#-# translate crowdin gallery_d_059_7932a0ed:
msgid "[_susan_] Но если рядом есть сильный мужчина, на которого можно положиться, я начинаю таять"
msgstr "[_susan_] Pero si hay un hombre fuerte en el que puedes confiar, estoy empezando a derretir"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:39 #-#-# translate crowdin gallery_d_059_a7418d52:
msgid "[_cedrick_] (Ох, эта женщина будит во мне зверя)"
msgstr "[_cedrick_] (Oh, esta mujer despierta a la bestia en mí)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:40 #-#-# translate crowdin gallery_d_059_24c3c3c0:
msgid "[_cedrick_] Ууух, Сьюзан, отлично сказано. Давай-ка проверим, насколько далеко ты готова зайти"
msgstr "[_cedrick_] Wuhu, Susan, bien dicho. Vamos a comprobar hasta dónde está listo para ir"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:45 #-#-# translate crowdin gallery_d_059_df1ab82b:
msgid "[_cedrick_] Уффф, а как тебе такое, Сьюзан? Отличная поза для послушной домохозяйки, не считаешь?"
msgstr "[_cedrick_] Wuff, ¿cómo te gusta esto, Susan? Excelente pose para un ama de casa obediente, ¿no crees?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:46 #-#-# translate crowdin gallery_d_059_4c95052f:
msgid "[_susan_] Мммф, Рик, да.. Трахай меня жестче.. Вот так"
msgstr "[_susan_] Mmmf, Rick, sí... Cógeme más fuerte... Así."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:47 #-#-# translate crowdin gallery_d_059_a9c1aa41:
msgid "[_cedrick_] Главное не забывай о блинчиках, скоро время завтрака"
msgstr "[_cedrick_] Main simplemente no te olvides de los panqueques, pronto la hora de desayuno"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:48 #-#-# translate crowdin gallery_d_059_0d44cb56:
msgid "[_susan_] Ммм.. Уугум.."
msgstr "[_susan_] Mmm... Uugum..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:49 #-#-# translate crowdin gallery_d_059_e6010d35:
msgid "[_cedrick_] Ахах, да, черт возьми, у тебя потрясная киска, Сьюзан!"
msgstr "[_cedrick_] Ahah, sí, maldita sea, tienes un gran coño, Susan!"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:50 #-#-# translate crowdin gallery_d_059_3cb6636a:
msgid "[_susan_] Уууф.. Рик.. Как хорошо.."
msgstr "[_susan_] Uuf. Rick. Qué bueno..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:51 #-#-# translate crowdin gallery_d_059_42d0110e:
msgid "[_cedrick_] Знаешь, мне бы хотелось, чтобы ты чаще готовила завтраки в таком виде, это отличное начало дня!"
msgstr "[_cedrick_] Me gustaría que desayunaras más a menudo así, ¡es un gran comienzo para el día!"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:52 #-#-# translate crowdin gallery_d_059_fb204c4e:
msgid "[_susan_] Мммв.. Вилл тогда точно нас рано или поздно, ааах.. Застукает.."
msgstr "[_susan_] Mmm... Entonces Will nos sorprenderá tarde o temprano... aaah..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:53 #-#-# translate crowdin gallery_d_059_c66e5bcc:
msgid "[_cedrick_] Но если этого не избежать, то не все ли равно? Думаешь она уже не догадалась, учитывая, как часто я тебя трахаю?"
msgstr "[_cedrick_] Pero si no puedes evitarlo, ¿no importa? ¿No crees que está adivinando, considerando la frecuencia con la que te jodo?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:54 #-#-# translate crowdin gallery_d_059_65e8e57c:
msgid "[_susan_] Аааав.. Охх, ты думаешь она уже знает?.."
msgstr "[_susan_] Aaaah... Oooh, ¿crees que ya lo sabe...?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:55 #-#-# translate crowdin gallery_d_059_3fbe958f:
msgid "[_cedrick_] Ммм, черт, конечно же.. Как можно не трахать такую сочную женщину.."
msgstr "[_cedrick_] Mmm, maldita sea, por supuesto. ¿Cómo puedes no cogerte a una mujer tan jugosa?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:56 #-#-# translate crowdin gallery_d_059_eb06c684:
msgid "[_susan_] Аааах, Рик.."
msgstr "[_susan_] Aah, Rick."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:57 #-#-# translate crowdin gallery_d_059_6e42829e:
msgid "[_cedrick_] Знаешь что? Нагнись, я хочу трахнуть тебя в попку!"
msgstr "[_cedrick_] ¿Sabes qué? ¡Agáchate, quiero cogerte por el culo!"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:58 #-#-# translate crowdin gallery_d_059_c46df020:
msgid "[_susan_] Ох, ч-что?"
msgstr "[_susan_] Oh, ¿qué?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:59 #-#-# translate crowdin gallery_d_059_40991da7:
msgid "[_cedrick_] Ты слышала. Давно хотел трахнуть тебя в другую твою дырочку. Давай, тебе понравится!"
msgstr "[_cedrick_] Ya lo oíste. He estado tratando de cogerte en tus otros agujeros durante mucho tiempo. ¡Vamos, te gustará!"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:60 #-#-# translate crowdin gallery_d_059_a1ff9ed3:
msgid "[_susan_] Мммм, Рик, ты такой грубый, но.. Мне это нравится, не могу отказать.."
msgstr "[_susan_] Mmm, Rick, eres muy duro, pero... Me gusta, no puedo decir que no."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:64 #-#-# translate crowdin gallery_d_059_c6193643:
msgid "[_susan_] Ооох, Рик, ну же, скорее, трахни меня!"
msgstr "[_susan_] ¡Oh, Rick, vamos, blasfemia, blasfemia!"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:65 #-#-# translate crowdin gallery_d_059_c23d086e:
msgid "[_cedrick_] Ммм, эта сочная попка.."
msgstr "[_cedrick_] Mmm, este jugoso culo.."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:71 #-#-# translate crowdin gallery_d_059_6d141de4:
msgid "[_will_] Мам, Рик, что за крики у вас тууу... ЧТООО!?"
msgstr "[_will_] Mamá, Rick, ¿qué hay en los gritos de ti... ¿¡Qué es cualquiera!?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:72 #-#-# translate crowdin gallery_d_059_555a2770:
msgid "[_susan_] О-ох, Вилл! Дорогая, не смотри!"
msgstr "[_susan_] ¡Oh, ooh, Will! ¡Cariño, no mires!"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:74 #-#-# translate crowdin gallery_d_059_8a508fc2:
msgid "[_will_] ДА КАК ТУТ НЕ СМОТРЕТЬ!? КАК ВЫ МОГЛИ? ПРЯМО НА КУХНЕ!!"
msgstr "[_will_], ¿Cómo no lo ves!? ¿Cómo pudiste? Justo en la cocina!!"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:75 #-#-# translate crowdin gallery_d_059_9e181110:
msgid "[_cedrick_] (Хах, нас все же застукали.. Интересно, как она отреагирует. Хотя еще интереснее то, что будет делать с этим Сьюзан)"
msgstr "[_cedrick_] (Ja, todavía estábamos atrapados. Me pregunto cómo reaccionará. Aunque aún más interesante es lo que Susan hará con esto)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:77 #-#-# translate crowdin gallery_d_059_f7e23d74:
msgid "[_will_] Я.. Я ухожу!"
msgstr "[_will_] Yo... ¡Me voy!"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:79 #-#-# translate crowdin gallery_d_059_a20cefa7_2:
msgid "..."
msgstr "..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:83 #-#-# translate crowdin gallery_d_059_a20cefa7_3:
msgid "..."
msgstr "..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:86 #-#-# translate crowdin gallery_d_059_b0c554cc:
msgid "[_susan_] Ох, Рик, и что же нам с ней делать.. Она не должна была этого видеть"
msgstr "[_susan_] Oh, Rick, ¿y qué debemos hacer con ella? No debería haberlo visto"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:87 #-#-# translate crowdin gallery_d_059_b1e4dad5:
msgid "[_cedrick_] Сьюзан, мы взрослые люди, я живу у вас в доме, Вилл знает, что мы встречаемся. Это рано или поздно произошло бы"
msgstr "[_cedrick_] Susan, somos adultos, vivo en tu casa, Will sabe que estamos saliendo. Esto ocurriría tarde o temprano"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:88 #-#-# translate crowdin gallery_d_059_ceba5f58:
msgid "[_susan_] Д-да.. Думаю, ты прав.. Но в любом случае, нужно с ней поговорить.."
msgstr "[_susan_] D-Da... Creo que tienes razón. Pero de todos modos, tenemos que hablar con ella..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:89 #-#-# translate crowdin gallery_d_059_fee3ea1a:
msgid "[_cedrick_] Давай дадим ей немного времени. Ты пока доготовишь завтрак, а я отлучусь ненадолго. Посидим за общим столом и все обсудим, хорошо?"
msgstr "[_cedrick_] Démosle algo de tiempo. Vas a desayunar un rato, y me iré por un tiempo. Nos sentamos en la mesa común y hablamos de todo, ¿de acuerdo?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:90 #-#-# translate crowdin gallery_d_059_c691d9c8:
msgid "[_susan_] Да, пожалуй так и поступим. Хорошо, что ты с нами, Рик"
msgstr "[_susan_] Hagámoslo, hagámoslo. Es bueno que estés con nosotros, Rick"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:91 #-#-# translate crowdin gallery_d_059_342c626d:
msgid "[_cedrick_] Хорошо, что у меня есть вы"
msgstr "[_cedrick_] Es bueno que te tenga"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:94 #-#-# translate crowdin gallery_d_060_73c7decf:
msgid "[_cedrick_] (Я должен проверить реакцию Вилл на произошедшее. Главное, чтобы она меня не заметила)"
msgstr "[_cedrick_] (Tengo que comprobar la reacción de Will a lo que sucedió. Lo principal es que no me nota)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:98 #-#-# translate crowdin gallery_d_060_0ac00543:
msgid "[_cedrick_] (О, она уже дошла до игрушек? Бедная девочка)"
msgstr "[_cedrick_] (Oh, ¿ya ha llegado a los juguetes? Pobre chica)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:100 #-#-# translate crowdin gallery_d_060_598acfd5:
msgid "[_will_] (Чертов Рик.. Чертова Сьюзан.. Да как они вообще могли..)"
msgstr "[_will_] (Maldito Rick. Maldita Susan... Cómo podrían...)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:101 #-#-# translate crowdin gallery_d_060_4a888ed1:
msgid "[_will_] (..Мммв, просто как животные.. Прямо на кухне..)"
msgstr "[_will_] (...Mmm, al igual que los animales .. Justo en la cocina.)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:103 #-#-# translate crowdin gallery_d_060_dda1732a:
