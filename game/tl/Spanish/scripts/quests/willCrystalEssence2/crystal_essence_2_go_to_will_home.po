# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:145 #-#-# translate crowdin gallery_d_060_93bebfbb:
msgid "[_will_] То, что ты так легко смогла найти себе отличного парня не значит, что это так же легко для всех остальных, Сьюзан!"
