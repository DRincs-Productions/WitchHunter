# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:121 #-#-# translate crowdin gallery_d_060_ba5d4120:
msgid "[_susan_] Что ж.. Вилл, о том, что ты видела сегодня.."
