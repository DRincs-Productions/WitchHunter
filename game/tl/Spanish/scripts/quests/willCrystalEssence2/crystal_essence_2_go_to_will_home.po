# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:176 #-#-# translate crowdin gallery_d_060_1e47c724:
msgid "[_will_] Ч-что?.. Н-но у мамы даже нет подходящего купальника. У тебя, Рик, думаю тоже"
msgstr "[_will_] ¿Qué?... Pero mi madre ni siquiera tiene el traje de baño adecuado. Tú, Rick, creo que tú también"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:178 #-#-# translate crowdin gallery_d_060_d9930b45:
