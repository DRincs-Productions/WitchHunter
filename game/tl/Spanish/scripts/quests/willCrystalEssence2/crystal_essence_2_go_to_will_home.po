# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:192 #-#-# translate crowdin gallery_d_060_bdb859a5:
msgid "[_cedrick_] Хах, обязательно"
msgstr "[_cedrick_] Hah, obligatorio"

