# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:166 #-#-# translate crowdin gallery_d_060_77fa34f8:
msgid "[_cedrick_] (Да, моя теория верна. Ей уже от простых разговоров хочется члена, ее даже не смущает, что мы говорим об этом вместе с Сьюзан)"
msgstr "[_cedrick_] (Sí, mi teoría es correcta. Una simple conversación ya hace que desee un pene; ni siquiera le incomoda que hablemos de esto con Susan.)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:167 #-#-# translate crowdin gallery_d_060_b4d229d1:
msgid "[_cedrick_] (Хм.. Из этого может получиться нечто интересное)"
