# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:163 #-#-# translate crowdin gallery_d_060_3cd35197:
msgid "[_will_] (Кто бы говорил, Рик.. Именно из-за твоих прикосновений я все больше нуждаюсь в... уууух, да какого черта я опять думаю о его члене!..)"
