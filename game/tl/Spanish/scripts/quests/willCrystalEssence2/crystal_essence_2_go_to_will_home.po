# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:139 #-#-# translate crowdin gallery_d_060_7276caea:
msgid "[_susan_] В-вилл.."
msgstr "[_susan_] Will."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:140 #-#-# translate crowdin gallery_d_060_6aeb0e35:
msgid "[_cedrick_] (О, она уже во время кино нас застукала.. Это многое объясняет)"
