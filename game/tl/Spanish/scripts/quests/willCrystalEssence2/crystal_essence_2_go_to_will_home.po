# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:148 #-#-# translate crowdin gallery_d_060_1c92d782:
msgid "[_cedrick_] (О, последнее было явно про Мартина)"
msgstr "[_cedrick_] (Oh, el último fue claramente sobre Martin)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:150 #-#-# translate crowdin gallery_d_060_c62644f5:
msgid "[_susan_] Д-да как ты разговариваешь с матерью.."
