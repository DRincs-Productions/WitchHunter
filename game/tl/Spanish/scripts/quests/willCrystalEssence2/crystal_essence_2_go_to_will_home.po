# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:152 #-#-# translate crowdin gallery_d_060_56d56aed:
msgid "[_cedrick_] Кхм.. Так, дорогие мои дамы, давайте успокоимся. Ссоры здесь ни к чему"
