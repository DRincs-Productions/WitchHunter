# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:143 #-#-# translate crowdin gallery_d_060_2570e01a:
msgid "[_susan_] Э-эм.. Ух, Вилл, дорогая, ты еще найдешь того самого, с кем сможешь.. Ну.."
