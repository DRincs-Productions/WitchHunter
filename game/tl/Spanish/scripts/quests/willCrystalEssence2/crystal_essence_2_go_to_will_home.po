# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:158 #-#-# translate crowdin gallery_d_060_e8a5d7ba:
msgid "[_cedrick_] Не стоит стесняться говорить прямо, что когда-нибудь Вилл найдет того, с кем сможет, кхм.. Проводить время так же хорошо, как мы с тобой"
msgstr "[_cedrick_] No sea tímido para ser honesto de que algún día Will encontrará a alguien con quien pueda, kmm. ¿Pasar tiempo tan bien como tú y yo"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:160 #-#-# translate crowdin gallery_d_060_bb82fde7:
