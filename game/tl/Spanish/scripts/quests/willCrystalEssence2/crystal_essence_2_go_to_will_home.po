# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:127 #-#-# translate crowdin gallery_d_060_bbe6fc9c:
msgid "[_will_] ...Что? Трахаетесь на кухне, как животные?"
