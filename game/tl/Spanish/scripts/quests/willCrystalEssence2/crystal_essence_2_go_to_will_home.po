# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home.rpy:169 #-#-# translate crowdin gallery_d_060_5aeece47:
msgid "[_susan_] Да, давайте сменим тему.. Знаете, я давно хотела вам предложить вместе сходить куда-нибудь. А то мы то и дело сидим дома"
