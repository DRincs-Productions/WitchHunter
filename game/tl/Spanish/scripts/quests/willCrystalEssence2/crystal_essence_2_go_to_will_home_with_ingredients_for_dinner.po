# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:177 #-#-# translate crowdin gallery_d_064_f0f0c328:
msgid "[_cedrick_] Я надеюсь это чертовски срочно, потому что я тут занят ооочень важными вещами"
msgstr "[_cedrick_] Espero que sea jodidamente hetero, porque estoy ocupado con cosas muy importantes aquí"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:180 #-#-# translate crowdin gallery_d_064_cf369d18:
msgid "[_elion_] Рик, сюда приходили двое детективов и сказали, что у них ордер на твой арест.."
