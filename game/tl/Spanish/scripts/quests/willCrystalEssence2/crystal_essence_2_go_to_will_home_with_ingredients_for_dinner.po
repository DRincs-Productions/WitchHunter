msgstr "[_elion_] Sí.. Los oficiales acaban de salir de la tienda y están soplando desde afuera. Inmediatamente te llamé"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:189 #-#-# translate crowdin gallery_d_064_45fc8672:
msgid "[_cedrick_] А детективы прямо сейчас направляются в дом Вилл?"
msgstr "[_cedrick_] ¿Los detectives se dirigen a la casa de la Will ahora mismo?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:190 #-#-# translate crowdin gallery_d_064_2858bd1e:
msgid "[_elion_] ..Да, они знают, что ты последнее время сблизился с Сьюзан"
msgstr "[_elion_] .Ye.y. saben que te has estado acercando a Susan últimamente"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:191 #-#-# translate crowdin gallery_d_064_c8e0684f:
