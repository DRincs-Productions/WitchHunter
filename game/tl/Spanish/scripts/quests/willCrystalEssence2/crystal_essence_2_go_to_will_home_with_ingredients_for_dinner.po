msgstr "[_cedrick_] ..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:182 #-#-# translate crowdin gallery_d_064_be4dcd43:
msgid "[_cedrick_] ...Что?"
msgstr "[_cedrick_] ...¿Qué?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:183 #-#-# translate crowdin gallery_d_064_db3d8ac3:
msgid "[_elion_] Они что-то говорили про пропажу Корнелии.. И они считают, что это все связано с пропажей Брайана и Алхими.. Они сказали, что ты в этом замешан.."
msgstr "[_elion_] Dijeron algo sobre la pérdida de Cornelia. Y creen que tiene que ver con la pérdida de Brian y Alchemy. Dijeron que estabas involucrado..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:184 #-#-# translate crowdin gallery_d_064_a94a1b85:
msgid "[_elion_] Рик, я ничего не понимаю.. Что за ужасные вещи они про тебя считают.. Ты же хороший человек..."
msgstr "[_elion_] Rick, no entiendo nada. Qué cosas terribles piensan de ti... Eres un buen hombre..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:185 #-#-# translate crowdin gallery_d_064_ebed3d65:
msgid "[_cedrick_] ......."
msgstr "[_cedrick_] ......."

