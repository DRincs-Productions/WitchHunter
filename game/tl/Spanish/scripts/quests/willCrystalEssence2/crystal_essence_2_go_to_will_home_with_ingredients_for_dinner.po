msgstr "[_will_] ...¿Rick?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:195 #-#-# translate crowdin gallery_d_064_f714969a:
msgid "[_cedrick_] Я.. Эм.. Мне надо идти..."
msgstr "[_cedrick_] Yo... Um. Tengo que ir..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:197 #-#-# translate crowdin gallery_d_064_4f14bc45:
