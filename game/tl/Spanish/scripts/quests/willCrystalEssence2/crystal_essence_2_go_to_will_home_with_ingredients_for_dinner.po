msgstr "[_cedrick_] ¿Qué diablos es, quién más?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:176 #-#-# translate crowdin gallery_d_064_b71fcaea:
