# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:9 #-#-# translate crowdin crystal_essence_2_go_to_will_home_with_ingredients_for_dinner_6ccf36a6:
msgid "[_cedrick_] Хах, ну что ты, всегда рад помочь"
msgstr "[_cedrick_] Hach, bueno, siempre estarás encantado de ayudarte"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:11 #-#-# translate crowdin crystal_essence_2_go_to_will_home_with_ingredients_for_dinner_311f0876:
msgid "[_will_] И в этот раз обошлись без происшествий.."
msgstr "[_will_] Y esta vez sin incidentes."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:13 #-#-# translate crowdin crystal_essence_2_go_to_will_home_with_ingredients_for_dinner_ed72e9d4:
