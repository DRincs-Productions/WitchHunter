# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:360 #-#-# translate crowdin gallery_d_065_f7ad36fd:
msgid "[_tarani_] Вилл.. Она.."
msgstr "[_tarani_] Will. Ella es..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:364 #-#-# translate crowdin gallery_d_065_7230f59f:
