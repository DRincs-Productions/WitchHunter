msgstr "[_susan_] Khm.."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:15 #-#-# translate crowdin crystal_essence_2_go_to_will_home_with_ingredients_for_dinner_e0183bd5:
msgid "[_cedrick_] Ахахах, всегда любил твое чувство юмора, Вилл.. Но могла бы и похвалить наши старания"
msgstr "[_cedrick_] Ah, siempre te encantó tu sentido del humor, Will. Pero también podría elogiar nuestros esfuerzos"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:17 #-#-# translate crowdin crystal_essence_2_go_to_will_home_with_ingredients_for_dinner_f353dde8:
msgid "[_will_] Хах.. Ладно ужин действительно вышел что надо"
msgstr "[_will_] H. H.. La cena real salió lo que necesitabas"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:19 #-#-# translate crowdin crystal_essence_2_go_to_will_home_with_ingredients_for_dinner_2bfa12d8:
msgid "[_cedrick_] Вооот, другое дело"
msgstr "[_cedrick_] Aquí, otra cosa"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:22 #-#-# translate crowdin crystal_essence_2_go_to_will_home_with_ingredients_for_dinner_26556723:
msgid "[_cedrick_] (На самом деле на стряпню мне все равно. Главное, что Вилл уже отпила эссенцию, что я добавил в ее кружку, пока все отвлеклись)"
msgstr "[_cedrick_] (En realidad, no me importa. Lo principal es que Will ya ha bebido la esencia, que añadí a su taza, mientras todo el mundo estaba distraído)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:23 #-#-# translate crowdin crystal_essence_2_go_to_will_home_with_ingredients_for_dinner_501bf0c8:
msgid "[_cedrick_] (Это была последняя капля. После этого она не сможет мне сопротивляться)"
msgstr "[_cedrick_] (Esta fue la última gota. Después de eso, ella no será capaz de resistirme)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:24 #-#-# translate crowdin crystal_essence_2_go_to_will_home_with_ingredients_for_dinner_2eb2c485:
msgid "[_will_] (Ч-что со мной.. Черт, снова бросает в жар.. При чем сильнее, чем обычно.. Аааах, что со мной...)"
msgstr "[_will_] (¿Q-qué me pasa...? Mierda, vuelvo a sentir calor... y más fuerte de lo normal... Aaah, ¿qué me pasa...?)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:26 #-#-# translate crowdin crystal_essence_2_go_to_will_home_with_ingredients_for_dinner_4611dbb9:
msgid "[_will_] Я.. Я, пожалуй, пойду к себе.. Было очень вкусно, всем спасибо.."
msgstr "[_will_] Yo... Creo que iré a mi casa. Estaba delicioso, gracias a todos."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:27 #-#-# translate crowdin crystal_essence_2_go_to_will_home_with_ingredients_for_dinner_7d77babe:
msgid "[_cedrick_] Всегда рад помочь с готовкой.."
msgstr "[_cedrick_] Siempre dispuesto a ayudar con la cocina.."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:29 #-#-# translate crowdin crystal_essence_2_go_to_will_home_with_ingredients_for_dinner_28ce1454:
msgid "[_susan_] Что ж, я пока приберу весь тот бардак, что мы устроили в процессе готовки"
msgstr "[_susan_] ¿Qué, me voy a tomar todo el desastre que tenemos en el proceso de cocción"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:30 #-#-# translate crowdin crystal_essence_2_go_to_will_home_with_ingredients_for_dinner_071112b8:
msgid "[_cedrick_] Да, было бы чудесно. А я пока отойду по своим делам"
msgstr "[_cedrick_] Sí, sería maravilloso. Mientras tanto, me iré por mi negocio"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:35 #-#-# translate crowdin gallery_d_064_6d4df805:
msgid "[_cedrick_] (Хмм? В комнате ее нет? Странно, тогда где же она..)"
msgstr "[_cedrick_] (¿Hmm? ¿No está en la habitación? Es extraño, donde está...)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:37 #-#-# translate crowdin gallery_d_064_aac356e4:
msgid "[_will_] Ч-черт.. Да как же так.."
msgstr "[_will_] Ch-Dr.. Cómo Así..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:39 #-#-# translate crowdin gallery_d_064_f5087268:
msgid "[_cedrick_] Хах, все ясно.. Звуки идут из туалета.."
msgstr "[_cedrick_] Hach, todo claro. Los sonidos vienen del baño."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:45 #-#-# translate crowdin gallery_d_064_2d9adce5:
msgid "[_will_] Р-Рик!? Что ты.. Ааах.. Что ты.. Тут делаешь?"
msgstr "[_will_] R-Rick!? ¿Qué eres tú...? Aah... ¿Qué eres tú...? ¿Lo está haciendo aquí?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:46 #-#-# translate crowdin gallery_d_064_c56e21b2:
msgid "[_cedrick_] Хммм? Что такое, Вилл? Руки не останавливаются, даже после того, как я вошел в туалет?"
msgstr "[_cedrick_] ¿Hmm? ¿Qué pasa, Will? ¿No se detienen las manos, incluso después de que he entrado en el baño?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:48 #-#-# translate crowdin gallery_d_064_7f3ef0eb:
msgid "[_will_] Ч-черт... ооооххх.. Выметайся отсюда.. Я ведь могу закричать и тогда Сьюзан все.."
msgstr "[_will_] M-mierda... Oooh... Lárgate de aquí... Puedo gritar, y entonces Susan..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:49 #-#-# translate crowdin gallery_d_064_e22c0acb:
msgid "[_cedrick_] Ох, Вилл, в твоем нынешнем положении ты можешь разве что застонать, не обманывай себя"
msgstr "[_cedrick_] Oh, Will, en tu posición actual solo puedes gemir, no te engañes"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:50 #-#-# translate crowdin gallery_d_064_8f12d33f:
msgid "[_cedrick_] Единственное, что сейчас неоднозначно - так это то, что же я с тобой сделаю.."
msgstr "[_cedrick_] Lo único que es ambiguo en este momento es lo que voy a hacerte."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:52 #-#-# translate crowdin gallery_d_064_03ed1365:
msgid "[_will_] С-сделаешь.. Не.. Нет, постой.."
msgstr "[_will_] L-lo harás... No... No, espera..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:58 #-#-# translate crowdin gallery_d_064_3982efe1:
msgid "[_cedrick_] Хах, хорошо, Вилл. Я дам тебе шанс сделать все самой"
msgstr "[_cedrick_] Hach, está bien, Will. Te daré la oportunidad de hacer todo yo mismo"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:59 #-#-# translate crowdin gallery_d_064_da3f1678:
msgid "[_will_] Ч-что?.."
msgstr "[_will_] ¿Qué?..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:60 #-#-# translate crowdin gallery_d_064_a0190eb6:
msgid "[_cedrick_] Ну же, давай, попробуй кончить самостоятельно, я не буду вмешиваться. Только будь хорошей девочкой и раздвинь для меня ноги"
msgstr "[_cedrick_] Vamos, intenta correrte tú sola; no intervendré. Solo sé una buena chica y abre las piernas para mí."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:62 #-#-# translate crowdin gallery_d_064_0ac24f32:
msgid "[_will_] Да ты... ааав.. Ты совсем охренел, Рик.. С чего ты взял, что я буду.."
msgstr "[_will_] Pero tú... aaah... Te volviste loco, Rick... ¿Por qué crees que voy a...?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:66 #-#-# translate crowdin gallery_d_064_eb8c95ff:
msgid "[_will_] Ч-что.. Нет.. Это.."
msgstr "[_will_] ¿Qué? ¿Qué? No. No. Eso es..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:67 #-#-# translate crowdin gallery_d_064_d337558e:
msgid "[_cedrick_] Вот и умница, Вилл"
msgstr "[_cedrick_] Aquí está la chica inteligente, Will"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:69 #-#-# translate crowdin gallery_d_064_069ac169:
msgid "[_will_] (Н-нет, что происходит.. Тело не слушается.. Вернее слушается не меня, а Рика.. Неужели это то, чего я действительно хочу?.. Дрочить перед ним, раздвинув ноги?.. Поверить не могу..)"
msgstr "[_will_] (N-no, lo que está pasando... El cuerpo no obedece. No soy yo, sino Rick. ¿Es eso lo que realmente quiero? ¿Muriendo delante de él, extendiendo sus piernas? No puedo creerlo.)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:70 #-#-# translate crowdin gallery_d_064_152f5d26:
msgid "[_cedrick_] Ну же, Вилл, давай, делай свое любимое дело"
msgstr "[_cedrick_] Vamos, Will, vamos, haz tu cosa favorita"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:72 #-#-# translate crowdin gallery_d_064_fc4b3a69:
msgid "[_will_] Я.. М.. Да.."
msgstr "[_will_] Yo... M. Sí."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:74 #-#-# translate crowdin gallery_d_064_4c9dd808:
msgid "[_will_] ...Аааах.. Ммммв.."
msgstr "[_will_] ...Aaaah... Mmmm..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:76 #-#-# translate crowdin gallery_d_064_3ba51e77:
msgid "[_will_] Оооооххх... Ч-черт.."
msgstr "[_will_] Ch-DISPOSITIVO."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:77 #-#-# translate crowdin gallery_d_064_3cc0ef5a:
msgid "[_cedrick_] Что такое? Не получается кончить?"
msgstr "[_cedrick_] ¿Qué pasa? ¿No puedes correrte?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:79 #-#-# translate crowdin gallery_d_064_90fb74ca:
msgid "[_will_] Ах ты.."
msgstr "[_will_] Ah..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:80 #-#-# translate crowdin gallery_d_064_101d3ce7:
msgid "[_cedrick_] Мы оба понимаем, что одними руками у тебя уже давно не получается довести себя до оргазма, не стоит и пытаться.."
msgstr "[_cedrick_] Ambos entendemos que con tus manos no has podido llevarte al orgasmo durante mucho tiempo, no intentes..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:81 #-#-# translate crowdin gallery_d_064_8d5dba3a:
msgid "[_cedrick_] Уверен, что даже дилдо тебе уже не помогает"
msgstr "[_cedrick_] Está seguro de que incluso el consolador no le ayuda"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:83 #-#-# translate crowdin gallery_d_064_09af50fd:
msgid "[_will_] (...Он абсолютно прав. Обычных игрушек для меня уже недостаточно.. Пришлось недавно купить анальный стимулятор, с ним хоть как-то получается дойти до оргазма..)"
msgstr "[_will_] (...Él tiene toda la razón. Los juguetes ordinarios no son suficientes para mí. Recientemente tuve que comprar un estimulador anal, con él de alguna manera lograr alcanzar el orgasmo.)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:84 #-#-# translate crowdin gallery_d_064_edb6bcf4:
msgid "[_cedrick_] Все это лишь баловство, Вилл. Ты же знаешь, что тебе действительно нужно. Чего ты действительно хочешь"
msgstr "[_cedrick_] Todo es solo mimar, Will. Sabes lo que realmente necesitas. Lo que realmente quieres"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:86 #-#-# translate crowdin gallery_d_064_e90284fe:
msgid "[_will_] Н-нет.. Ааав.. Я знаю о чем-ты.. П-подожди.."
msgstr "[_will_] N-no... Aaah... Sé de qué... E-espera..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:90 #-#-# translate crowdin gallery_d_064_234aee59:
msgid "[_cedrick_] Вот то, чего ты действительно жаждешь. Толстый мясистый член, а не все эти долбаные игрушки"
msgstr "[_cedrick_] Es de lo que realmente tienes sed. Verga carnosa gruesa, no todos estos malditos juguetes"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:91 #-#-# translate crowdin gallery_d_064_2bb5504b:
msgid "[_will_] Я... Я..."
msgstr "[_will_] Yo... Yo..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:92 #-#-# translate crowdin gallery_d_064_40a66b83:
msgid "[_will_] (О нет, он сделал это.. Он достал свой член и тычет им прямо в лицо.. Я наконец увидела его.. И не для Сьюзан, как раньше.. Теперь этот член предназначен для меня..)"
msgstr "[_will_] (Oh no, lo hizo. Se sacó la verga y se la bombeó directamente a la cara. Por fin lo vi. Y no para Susan, como antes... Ahora este miembro es para mí.)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:93 #-#-# translate crowdin gallery_d_064_8fd9e7c4:
msgid "[_will_] (Боже, нет, о чем я вообще думаю)"
msgstr "[_will_] (Dios, no, en lo que pienso)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:97 #-#-# translate crowdin gallery_d_064_12dde0e8:
msgid "[_cedrick_] Ну же, Вилл, ты вся трепещешь. Ни к чему скрывать тот факт, что ты хочешь мой член. Хочешь меня. Все уже все прекрасно понимают. Думаю даже Сьюзан уже догадалась)"
msgstr "[_cedrick_] Vamos, Will, estás temblando. No hay necesidad de ocultar el hecho de que quieres mi pene. Tú me quieres. Todo el mundo lo entiende todo. Creo que hasta Susan ya lo ha adivinado)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:98 #-#-# translate crowdin gallery_d_064_91dd3499:
msgid "[_cedrick_] Никого, кроме себя, ты уже не обманешь"
msgstr "[_cedrick_] Nadie más que tú mismo, ya no puedes engañar"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:99 #-#-# translate crowdin gallery_d_064_0beb5a99:
msgid "[_will_] (Не обману?.. Может я все это время обманывала саму себя.. Может я и вправду просто извращенка, которая хочет члена Рика..)"
msgstr "[_will_] (¿No mentiré...? Quizá me estuve engañando todo este tiempo... Quizá de verdad solo soy una pervertida que quiere el pene de Rick...)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:100 #-#-# translate crowdin gallery_d_064_bbdfe426:
msgid "[_will_] (Черт, да это и так уже давно было очевидно.. Я начала дрочить из-за него, мне становилось чертовски горячо только рядом с ним, я могла кончить, только думая о нем)"
msgstr "[_will_] (Mierda, ya era evidente desde hace tiempo... Empecé a masturbarme por él, me calentaba muchísimo con solo estar cerca y solo podía correrme pensando en él.)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:101 #-#-# translate crowdin gallery_d_064_da5e1ada:
msgid "[_will_] (Я просто дура, которая обманывала сама себя. А еще называюсь предводительницей стражниц. Как я могу спасать мир, если сама лгу себе в том, чего хочу.. Лгу себе в том, кто я есть..)"
msgstr "[_will_] (Solo soy un tonto que me ha engañado. También me llaman el líder de los guardianas. ¿Cómo puedo salvar el mundo si me miento a mí mismo lo que quiero? Le mentí a quien soy.)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:102 #-#-# translate crowdin gallery_d_064_31354e65:
msgid "[_will_] (Я просто жалкая извращенка..)"
msgstr "[_will_] (Solo soy un pervertido patético.)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:107 #-#-# translate crowdin gallery_d_064_5ba76745:
msgid "[_cedrick_] Что ж, я долго терпел. Теперь пришло время жестких решительных действий"
msgstr "[_cedrick_], he sido paciente durante mucho tiempo. Ahora es el momento de una acción decisiva dura"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:108 #-#-# translate crowdin gallery_d_064_ebe4983f:
msgid "[_will_] Ч-что!?.. Что ты имеешь ввиду.."
msgstr "[_will_] ¿¡Qué!? .. ¿Qué quieres decir con...?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:109 #-#-# translate crowdin gallery_d_064_f5418208:
msgid "[_cedrick_] Ты не в состоянии ничего сделать нормально, Вилл. Посмотри на себя, даже кончить сама не можешь. Это просто жалко"
msgstr "[_cedrick_] No puedes hacer nada bien, Will. Mírate a ti mismo, ni siquiera puedes correrte por tu cuenta. Es sólo una pena"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:111 #-#-# translate crowdin gallery_d_064_0d3fd7c0:
msgid "[_will_] ..Д-да пошел ты.. Пошел ты, Рик"
msgstr "[_will_] ..D. Tú Ve... Tú vete, Rick"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:112 #-#-# translate crowdin gallery_d_064_c8f52b18:
msgid "[_cedrick_] Хах, ты не в том положении, чтобы меня посылать. Или ты до сих пор этого не поняла? Давай тогда я тебе покажу"
msgstr "[_cedrick_] Hah, no estás en condiciones de enviarme. ¿O todavía no lo has entendido? Entonces vamos a mostrarte"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:116 #-#-# translate crowdin gallery_d_064_0c86f027:
msgid "[_will_] Ч-что ты делаешь?! Сраный извращенец, а ну прекрати сейчас-же!"
msgstr "[_will_] C-¿qué estás haciendo?! ¡Maldito pervertido, y detente ahora!"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:117 #-#-# translate crowdin gallery_d_064_31aa01a0:
msgid "[_cedrick_] Так, и что же ты сделаешь, если я не перестану?"
msgstr "[_cedrick_] Entonces, ¿y qué harás si no paro?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:119 #-#-# translate crowdin gallery_d_064_1e39c1a6:
msgid "[_will_] Я.. Я.. Ооохх.."
msgstr "[_will_] Yo... Yo... Ooohh..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:120 #-#-# translate crowdin gallery_d_064_74dfbed0:
msgid "[_will_] (Черт, он так грубо со мной обращается.. Я должна дать ему отпор, но вместо этого моя киска еще сильнее начинает течь от его прикосновений.. Как же так..)"
msgstr "[_will_] (Maldita sea, me trata tan groseramente. Tengo que luchar contra él, pero en cambio, es aún más probable que mi coño fluya de su toque. Cómo Así...)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:121 #-#-# translate crowdin gallery_d_064_7464cd8d:
msgid "[_cedrick_] Ты не в состоянии дать мне отпор, Вилл. Более того, ты хочешь, чтобы я прикасался к тебе. И почему же?"
msgstr "[_cedrick_] No puedes luchar contra mí, Will. De hecho, quieres que te toque. ¿Y por qué?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:122 #-#-# translate crowdin gallery_d_064_db67d3c5:
msgid "[_will_] ...."
msgstr "[_will_] ...."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:123 #-#-# translate crowdin gallery_d_064_112f7b30:
msgid "[_cedrick_] Давай я сам отвечу"
msgstr "[_cedrick_] Déjame responder"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:127 #-#-# translate crowdin gallery_d_064_8ef50f81:
msgid "[_will_] Что ты... аааах... оооов..."
msgstr "[_will_] ¿Qué eres... Aah... Osona..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:128 #-#-# translate crowdin gallery_d_064_f5542313:
msgid "[_cedrick_] Да потому что ты сама уже даже кончить не в состоянии. Не то что руками, уверен, тебе даже твой дилдо уже не помогает"
msgstr "[_cedrick_] Porque ya ni siquiera puedes correrte sola. Ni con las manos; estoy seguro de que ni tu consolador te ayuda."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:130 #-#-# translate crowdin gallery_d_064_176f3d9b:
msgid "[_will_] (Засранец.. Он прав.. Последнее время у меня получалось кончить только за счет того, что я купила себе анальный стимулятор в довесок к дилдо..)"
msgstr "[_will_] (Bastardo... Tiene razón... Últimamente solo podía correrme porque compré un estimulador anal para acompañar el consolador...)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:131 #-#-# translate crowdin gallery_d_064_6d0f3764:
msgid "[_cedrick_] Но знаешь, что тебе точно помогает? Мои, черт возьми, прикосновения. Ты вся течешь, Вилл. Твоя киска хочет меня, хоть ты сама пытаешься это отрицать"
msgstr "[_cedrick_] ¿Pero sabes qué te ayuda exactamente? Mi maldito toque. Todos están fluyendo, Will. Tu coño me quiere, a pesar de que intentas negarlo tú mismo"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:133 #-#-# translate crowdin gallery_d_064_e7b9a859:
msgid "[_will_] Д-думаешь.. Аааахххх.. Думаешь тебе так просто сойдет это с рук? Я все еще могу сопротивляться.."
msgstr "[_will_] ¿C-crees que... aaaah... que te saldrás con la tuya tan fácilmente? Todavía puedo resistirme..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:134 #-#-# translate crowdin gallery_d_064_905ce251:
msgid "[_cedrick_] Ох, Вилл.. Я знал, что ты извращенка, но не думал, что ты еще и дура.. Думаешь, что можешь сопротивляться? Хах, ну давай посмотрим"
msgstr "[_cedrick_] Oh, loca. Sabía que eras perversa, pero no pensé que fueras estúpido. ¿Crees que puedes resistirte? ¡Ja, vamos a ver"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:138 #-#-# translate crowdin gallery_d_064_2e8f7c15:
msgid "[_will_] Да как ты смеешь.."
msgstr "[_will_] Cómo te atreves..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:139 #-#-# translate crowdin gallery_d_064_76ac1813:
msgid "[_cedrick_] Ооо, такая недовольная, но такая беспомощная. Вилл, у тебя очень грозное лицо, но посмотри на себя. Я тычу тебе членом прямо в лицо, что же ты не сопротивляешься?"
msgstr "[_cedrick_] Ooh, tan insatisfecho, pero tan indefenso. Will, tienes una cara muy amenazadora, pero mírate. Te pongo un pene en la cara, ¿por qué no te resistes?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:141 #-#-# translate crowdin gallery_d_064_2bb5504b_1:
msgid "[_will_] Я... Я..."
msgstr "[_will_] Yo... Yo..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:142 #-#-# translate crowdin gallery_d_064_901406c7:
msgid "[_cedrick_] Хах, а ты не глотай язык, он тебе еще пригодится. Ты не сопротивляешься, потому что это то, чего ты хочешь. Чего давно хотела - моего члена"
msgstr "[_cedrick_] Hach, y no te tragues la lengua, aún la necesitarás. No te resistes porque eso es lo que quieres. Lo que he querido durante mucho tiempo - mi miembro"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:144 #-#-# translate crowdin gallery_d_064_896b27a8:
msgid "[_will_] Н-не правда.."
msgstr "[_will_] N-no realmente..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:145 #-#-# translate crowdin gallery_d_064_ea77cae1:
msgid "[_cedrick_] Вилл, хорош прикидываться! Ты можешь сколько угодно обманывать саму себя, пытаться доказать себе, что ты не такая, но посмотри, в каком ты сейчас положении"
msgstr "[_cedrick_] Will, ¡buena idea! Puedes engañarte tanto como quieras, tratar de demostrarte a ti mismo que no lo eres, pero mira en qué posición estás ahora"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:149 #-#-# translate crowdin gallery_d_064_de05deea:
msgid "[_cedrick_] Мой член упирается прямо в твои губы и все, что ты делаешь - это грозно на меня смотришь и что-то пытаешься возразить? Это же смешно"
msgstr "[_cedrick_] Mi colgante descansa en tus labios y todo lo que haces es mirarme y tratar de objetar? Es gracioso"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:150 #-#-# translate crowdin gallery_d_064_130fbded:
msgid "[_will_] (Черт.. Почему я ничего не делаю.. Я же предводительница стражниц.. Меня унижают и домогаются, а я не делаю ничего..)"
msgstr "[_will_] (Maldito. ¿Por qué no hago nada...? Soy el líder de los guardianas... Soy humillado y acosado, y no hago nada.)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:151 #-#-# translate crowdin gallery_d_064_101297ef:
msgid "[_will_] (Нет.. Вернее, все, что я делаю - это теку, как сучка в период течки.. Черт, Рик, ты такой мудак.. Но почему, почему я хочу твой член..)"
msgstr "[_will_] (No. O mejor dicho, todo lo que hago es como una perra durante el estro. Maldita sea, Rick, eres un imbécil. Pero, ¿por qué, por qué quiero tu pene?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:152 #-#-# translate crowdin gallery_d_064_1a6f19f8:
msgid "[_will_] (Я поняла.. Поняла, что не сопротивляюсь, потому что хочу его.. Даже если он ведет себя грубо и домогается меня - я не возражаю, даже если мне это не нравится)"
msgstr "[_will_] (Entiendo.. Me di cuenta de que no me resistía porque lo quería. Incluso si se comporta de manera grosera y me acosa, no me importa, incluso si no me gusta)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:153 #-#-# translate crowdin gallery_d_064_2829e66c:
msgid "[_will_] (Черт, да даже если этот ублюдок решит прямо сейчас трахнуть меня в задницу, я несомненно стану сопротивляться, но в итоге мне может начать это нравиться..)"
msgstr "[_will_] (Maldita sea, incluso si este bastardo decide cogerme ahora mismo, sin duda me resistiré, pero al final puedo empezar a gustarle.)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:154 #-#-# translate crowdin gallery_d_064_0ecfc7a3:
msgid "[_will_] (Но что.. Что же мне делать.. Признать свое положение и отдаться ему? Я правда.. Правда готова пойти на это, чтобы наконец получить долгожданное наслаждение? Какая я стражница после этого..)"
msgstr "[_will_] (Pero ¿qué... ¿Qué debo hacer...? ¿Reconocer su posición y rendirse a él? Estoy realmente... ¿Está realmente listo para hacer esto para finalmente obtener el placer tan esperado? Qué tipo de guardia estoy detrás de eso.)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:160 #-#-# translate crowdin gallery_d_064_de652716:
msgid "[_cedrick_] Ну же, Вилл. Пора признаться в том, чего ты действительно хочешь. Скажи это."
msgstr "[_cedrick_] Vamos, vil. Es hora de admitir lo que realmente quieres."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:164 #-#-# translate crowdin gallery_d_064_1963f88d:
msgid "[_will_] Да... Да, черт возьми, да! Я хочу твой член.. Боже, просто вставь его уже в мой рот! Хватит дразнить меня, ты, придурок.."
msgstr "[_will_] Sí... ¡Sí, maldita sea, sí! Quiero tu pene. ¡Dios, ponlo en mi boca! Deja de burlarte de mí, idiota..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:165 #-#-# translate crowdin gallery_d_064_fdd9c33c:
msgid "[_cedrick_] Хммм… И это все?"
msgstr "[_cedrick_] Hmm... ¿Y eso es todo?"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:166 #-#-# translate crowdin gallery_d_064_3c151ade:
msgid "[_will_] Я признаю.. Признаю! Я просто долбаная извращенка!"
msgstr "[_will_] Admito... ¡Lo admito! ¡Solo soy el maldito pervertido!"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:167 #-#-# translate crowdin gallery_d_064_fd63d5b6:
msgid "[_will_] Даже когда ты тычешь мне своим огромным твердым членом прямо в лицо, я больше не могу сопротивляться!"
msgstr "[_will_] ¡Incluso cuando dejas caer tu enorme verga dura justo en la cara, ya no puedo resistirme!"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:169 #-#-# translate crowdin gallery_d_064_4becd2ea:
msgid "[_will_] Я больше не могу отрицать своих желаний.. Давай, сделай это, Рик!"
msgstr "[_will_] Ya no puedo negar mis deseos. ¡Vamos, hazlo, Rick!"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:170 #-#-# translate crowdin gallery_d_064_cf088194:
msgid "[_cedrick_] Отлично сказано..."
msgstr "[_cedrick_] está bien dicho..."

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:172 #-#-# translate crowdin gallery_d_064_279344ff:
