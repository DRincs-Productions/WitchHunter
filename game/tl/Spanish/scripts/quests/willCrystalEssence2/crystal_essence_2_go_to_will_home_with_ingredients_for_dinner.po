msgstr "[_cedrick_] Chicas despreciables, ¿creen que son fuertes? ¡En un combate individual ninguna tendría oportunidad contra mí!"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:398 #-#-# translate crowdin dialoigs_in_fight_with_tarani_and_irma_b5bafd20:
msgid "[_tarani_] Думал только тебе можно использовать грязные трюки, ублюдок!? Мы бьем тебя твоим же "
msgstr "[_tarani_] ¿Solo pensé que podrías usar trucos sucios, bestia? Te ganamos con la tuya"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:399 #-#-# translate crowdin dialoigs_in_fight_with_tarani_and_irma_a155c240:
msgid "[_irma_] Что, уже вымотался, змей? В форме стражниц тебе с нами не тягаться!"
msgstr "[_irma_] ¿Qué, ya agotado, serpiente? En forma de guardianas, ¡no puedes competir con nosotros!"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:400 #-#-# translate crowdin dialoigs_in_fight_with_tarani_and_irma_58a0d9ad:
msgid "[_cedrick_] (Нужно подгадать время и бежать к порталу. Эти мелкие стервы из меня почти все силы вытянули)"
msgstr "[_cedrick_] (Necesitamos adivinar el tiempo y correr al portal. Estas pequeñas perras fuera de mí casi toda mi fuerza fue sacada)"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:409 #-#-# translate crowdin dialoigs_in_fight_with_tarani_and_irma_ae1d3204:
msgid "[_irma_] Вот и настал твой конец, Седрик!"
msgstr "[_irma_] ¡Ese es tu final, Cedric!"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:410 #-#-# translate crowdin dialoigs_in_fight_with_tarani_and_irma_6a300b5e:
msgid "[_tarani_] Сейчас ты за все поплатишься!"
msgstr "[_tarani_] ¡Ahora pagarás por todo!"

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_ingredients_for_dinner.rpy:411 #-#-# translate crowdin dialoigs_in_fight_with_tarani_and_irma_1a37bafa:
msgid "[_cedrick_] (Черт... Эти мелкие сучки из меня весь дух выбили, я остался без сил.. Не думал, что без своей силы я и двух стражниц не потяну..)"
msgstr "[_cedrick_] (Maldito... Estas perras de mí todo el espíritu, me quedé sin fuerza. No pensé que sería capaz de forzar y dos guardianas no...”)"

