# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:242 #-#-# translate crowdin gallery_d_061_b13c58c2:
msgid "[_will_] Х.. Хорошо.."
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:246 #-#-# translate crowdin gallery_d_061_465a2978:
msgid "[_susan_] Тогда на позиции! Начинаем на счет три"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:248 #-#-# translate crowdin gallery_d_061_6b89ac76:
msgid "[_cedrick_] (Думаю решающее преимущество на моей стороне, ведь эссенция скоро подействует и затуманит ее разум, она не сможет нормально соображать и действовать)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:249 #-#-# translate crowdin gallery_d_061_bb917fc5:
msgid "[_cedrick_] (Но даже с учетом этого, она довольно опасный соперник, я должен выбрать правильную тактику..)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:250 #-#-# translate crowdin gallery_d_061_c8a034be:
msgid "[_cedrick_] (Хм.. Вспомним теорию о стилях и видах плавания, я же что-то читал об этом. Как же там было...)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:251 #-#-# translate crowdin gallery_d_061_2a32d1c1:
msgid "[_cedrick_] (Есть вольный стиль на груди - самый быстрый. Это тот стиль, которым плавает Вилл. Даже ее увесистая грудь не мешает ее аэродинамике)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:252 #-#-# translate crowdin gallery_d_061_05ca6459:
msgid "[_cedrick_] (Есть техника плавания брассом. Руки вперед, всегда над головой. Самый распространенный стиль)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:253 #-#-# translate crowdin gallery_d_061_d6913fbb:
msgid "[_cedrick_] (Еще есть баттерфляй - самый позерский стиль. Считается довольно сложным и требующим много сил. Тело совершает волнообразные движения, ноги всегда вместе)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:254 #-#-# translate crowdin gallery_d_061_a2cf9a95:
msgid "[_cedrick_] (Какой же выбрать.. Эссенция скорее всего подействует, когда мы будем плыть в обратную сторону. До этого я просто не должен отставать. На обратном пути я могу поменять стиль)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:258 #-#-# translate crowdin gallery_d_061_ed7c823b:
msgid "[_cedrick_] (Но какой стиль должен быть вначале?)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:262 #-#-# translate crowdin gallery_d_061_540dd648:
msgid "[_cedrick_] (Вольный стиль считается самым быстрым. Пожалуй не буду изощряться и просто выберу его)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:266 #-#-# translate crowdin gallery_d_061_408c8ccf:
msgid "[_cedrick_] (Раньше я никогда не плавал в бассейне и не использовал какой-то стиль. Техника брассом самая простая в освоении, использую ее)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:271 #-#-# translate crowdin gallery_d_061_56d56630:
msgid "[_cedrick_] (Вольный стиль - это тот, в котором плавает Вилл, в нем я ей не соперник. Брасс легок в освоении, но он самый медленный из трех..)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:272 #-#-# translate crowdin gallery_d_061_6e3230f5:
msgid "[_cedrick_] (Баттерфляй, каким бы позерским не казался, единственный может посоперничать с вольным стилем)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:273 #-#-# translate crowdin gallery_d_061_c1143521:
msgid "[_cedrick_] (К тому же его основа в том, чтобы держать руки и корпус над водой, а ногами делать плавные движения, всегда держа их вместе)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:274 #-#-# translate crowdin gallery_d_061_c863a6ef:
msgid "[_cedrick_] (Это очень похоже на то, как я плаваю в форме змея, так что этот стиль больше всего мне подходит. Для начала выберу его)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:283 #-#-# translate crowdin gallery_d_061_4f583bfe:
msgid "[_will_] (Хм, он неплохо держится, хоть по его словам он раньше никогда не плавал.. Черт, он в отличной форме, так я могу и проиграть..)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:284 #-#-# translate crowdin gallery_d_061_63b51ef3:
msgid "[_will_] (Ох, у меня начинает кружиться голова.. Неужели это из-за волнения?)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:291 #-#-# translate crowdin gallery_d_061_7d0afba9:
msgid "[_will_] (Хм, несмотря на то, что он хорошо держится, у него не получится меня догнать. Все же отсутствие опыта стало решающим фактором. А значит, я смогу загадать ему желание!)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:292 #-#-# translate crowdin gallery_d_061_4e425ac0:
msgid "[_will_] (Ох, от этих мыслей у меня даже начинает кружиться голова.. Это нехорошо..)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:294 #-#-# translate crowdin gallery_d_061_6c45342d:
msgid "[_cedrick_] (Половина пути пройдена. На Вилл уже начинает действовать эссенция, ее рефлексы и движения становятся заторможенными. Но я тоже уже устал, все же отсутствие опыта дает о себе знать)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:298 #-#-# translate crowdin gallery_d_061_9541f834:
msgid "[_cedrick_] (Какой стиль мне выбрать теперь?)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:301 #-#-# translate crowdin gallery_d_061_311263b4:
msgid "[_cedrick_] (Вилл уже на пределе, она не сможет плыть в своем стиле так же хорошо, как до этого. А я как раз перераспределю нагрузку, так что вольный стиль - это отличный выбор)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:305 #-#-# translate crowdin gallery_d_061_b60fcd3d:
msgid "[_cedrick_] (Техника брассом сохранит мне силы и на обратном пути я смогу держать нужный темп до самого финиша)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:309 #-#-# translate crowdin gallery_d_061_0006aa03:
msgid "[_cedrick_] (Стиль Баттерфляй больше остальных мне подходит, стоит придерживаться его, если я хочу достигнуть финиша первым!)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:322 #-#-# translate crowdin gallery_d_061_a98e3181:
msgid "[_will_] (Он что, сменил стиль на мой собственный? Не уж то догадался, что я выбилась из сил..)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:323 #-#-# translate crowdin gallery_d_061_f13a7ffe:
msgid "[_will_] (Черт, а Рик хорош.. Несмотря на весь мой опыт, боюсь, в моем нынешнем состоянии против него у меня нет шансов..)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:326 #-#-# translate crowdin gallery_d_061_e0533972:
msgid "Вилл проиграла. Рик пришел к финишу первым"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:328 #-#-# translate crowdin gallery_d_061_b8f9e4ab:
msgid "[_cedrick_] Хах, да, я победил!"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:329 #-#-# translate crowdin gallery_d_061_6e4fd283:
msgid "[_will_] (Вот черт.. Как я могла проиграть.. Со всем моим опытом, несмотря на все мои тренировки, Рик меня просто размазал.. Он действительно невероятный мужчина..)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:330 #-#-# translate crowdin gallery_d_061_f8f6dcf1:
msgid "[_will_] (Оххх, я полностью без сил, ноги не держат.. Я сейчас пойду ко дну..)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:333 #-#-# translate crowdin gallery_d_062_522336eb:
msgid "[_cedrick_] Вилл!? Эй, что с тобой? Держись!"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:337 #-#-# translate crowdin gallery_d_062_ddd4ff2f:
msgid "[_cedrick_] Вилл, все в порядке? Ты вдруг так резко начала терять равновесие.."
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:339 #-#-# translate crowdin gallery_d_062_6a7d918a:
msgid "[_will_] Я, да.. Совсем выбилась из сил.."
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:340 #-#-# translate crowdin gallery_d_062_55aafc16:
msgid "[_cedrick_] Хах, это объясняет, почему я смог тебя победить.."
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:341 #-#-# translate crowdin gallery_d_062_a7defc4d:
msgid "[_will_] Нет, ты.. Ты выиграл честно и абсолютно заслуженно.."
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:343 #-#-# translate crowdin gallery_d_062_44c22f43:
msgid "[_will_] (Оооох, что со мной.. Мне так жарко, я буквально таю.. Таю в руках Рика.. Так хорошо и приятно..)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:344 #-#-# translate crowdin gallery_d_062_654fb7a7:
msgid "[_will_] (Черт.. Когда он схватил меня за зад, чтобы удержать на воде, я инстинктивно взялась за него бедрами..)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:345 #-#-# translate crowdin gallery_d_062_f886328e:
msgid "[_will_] (Значит, теперь так мое тело реагирует на него?.. Впрочем, это уже не удивительно.. Побеждена и унижена, моему телу остается только пресмыкаться...)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:346 #-#-# translate crowdin gallery_d_062_a646b657:
msgid "[_cedrick_] (Отлично, Вилл полностью беспомощна, а я буквально держу ее на плаву, она в моей власти. Как дальше поступить?)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:350 #-#-# translate crowdin gallery_d_062_3bc0ca0a:
msgid "[_cedrick_] (Что ж, не буду пока перегибать палку. Для этого еще найдется время. А пока..)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:352 #-#-# translate crowdin gallery_d_062_3dee621b:
msgid "[_cedrick_] Ох, Вилл, тебе совсем не хорошо. Бросьте кто-нибудь спасательный круг!"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:356 #-#-# translate crowdin gallery_d_062_d1ba57d5:
msgid "[_cedrick_] Все, ты на спасательном круге, можешь расслабиться. Я донесу тебя до берега"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:358 #-#-# translate crowdin gallery_d_062_80c9cf45:
msgid "[_will_] Спасибо, Рик, но, кхм.. Как тут расслабишься, когда в меня упирается такая штуковина..."
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:359 #-#-# translate crowdin gallery_d_062_b3e9aaed:
msgid "[_cedrick_] Ох, черт, прости, это видимо результат выработанного тестостерона во время плавания.."
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:361 #-#-# translate crowdin gallery_d_062_1f1163ef:
msgid "[_will_] Или это ты настолько рад своей победе.."
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:362 #-#-# translate crowdin gallery_d_062_0fd48aaa:
msgid "[_cedrick_] Ахахах, рад что ты все такая же бодрая в плане юмора, значит не все так плохо. Но уж прости, придется потерпеть данное, кхм, неудобство, пока я несу тебя до берега.."
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:364 #-#-# translate crowdin gallery_d_062_98ccc8f2:
msgid "[_will_] Все, ммм.. Все в порядке.. К тому же это уже не первый раз, когда я сталкиваюсь с этой твоей... штукой.."
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:366 #-#-# translate crowdin gallery_d_062_5b77ad18:
msgid "[_will_] (Ооооох.. Черт, такими темпами я начну привыкать к тому, что он тычет в меня своим членом.. Он же так и норовит выскочить у него из трусов..)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:367 #-#-# translate crowdin gallery_d_062_c9791113:
msgid "[_will_] (Ааааах, я чувствую, как он пульсирует, даже через одежду.. Такой горячий.. Игрушки никогда не смогут дать таких же ощущений..)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:368 #-#-# translate crowdin gallery_d_062_0ccd596e:
msgid "[_will_] (Ахх.. Ахх.. У меня, кажется, начинают мозги плавиться..)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:369 #-#-# translate crowdin gallery_d_062_e6963d07:
msgid "[_cedrick_] (Хмм, у нее участилось дыхание. Видимо ей уже сложно себя контролировать. Самое время воспользоваться ее положением)"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:370 #-#-# translate crowdin gallery_d_062_619a179e:
msgid "[_cedrick_] Кстати, Вилл, к вопросу о нашем пари. Я выиграл, так что я теперь могу загадать тебе желание"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:372 #-#-# translate crowdin gallery_d_062_6454497d:
msgid "[_will_] Ааххх.. И ч-чего ты хочешь?"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:373 #-#-# translate crowdin gallery_d_062_90e728fa:
msgid "[_cedrick_] Хммм.. Дай подумать.. Ну, когда ты в таком положении и я вижу тебя во всей красе, мысли могут быть лишь об одном"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:374 #-#-# translate crowdin gallery_d_062_f29ecc3f:
msgid "[_will_] Опять, ууф.. Опять что-то извращенное?"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:375 #-#-# translate crowdin gallery_d_062_e761be88:
msgid "[_cedrick_] Хах, ну, ты и сама сейчас в довольно извращенной позе, так что не тебе тут жаловаться"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:377 #-#-# translate crowdin gallery_d_062_396f788a:
msgid "[_will_] Чего.. Чего ты хочешь?"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:378 #-#-# translate crowdin gallery_d_062_b0bc12cf:
msgid "[_cedrick_] Хм.. Давай так, пока мы не добрались до берега и Сьюзан нас не увидела.. Я хочу увидеть твою грудь. Здесь и сейчас"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:379 #-#-# translate crowdin gallery_d_062_9d01df35:
msgid "[_will_] Ч-чертов извращенец.. Хочешь, ааххх.. Хочешь сделать это за спиной у Сьюзан?"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:380 #-#-# translate crowdin gallery_d_062_8d600836:
msgid "[_cedrick_] А что я еще могу поделать, если ты такая горячая сейчас?"
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:381 #-#-# translate crowdin gallery_d_062_c920c584:
msgid "[_will_] Ахх.. Ахх.."
msgstr ""

# game/scripts/quests/willCrystalEssence2/crystal_essence_2_go_to_will_home_with_bathing_suits.rpy:382 #-#-# translate crowdin gallery_d_062_bcd124bf:
