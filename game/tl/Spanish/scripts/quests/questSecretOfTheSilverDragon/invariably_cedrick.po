# TODO: Translation updated at 2023-07-25 15:55 #|#|# # game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:2 #-#-# translate crowdin invariably_cedrick_1_63272ad7:
msgid "[_cedrick_] Добрый вечер. У вас заказан столик?"
msgstr "[_cedrick_] Buenas noches. ¿Tienes una mesa?"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:3 #-#-# translate crowdin invariably_cedrick_1_777552c8:
msgid "[_restaurant_goer_5_] Да, на 19:30, угловой"
msgstr "[_restaurant_goer_5_] Sí, a las 19:30, esquina"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:7 #-#-# translate crowdin invariably_cedrick_2_09e4f74a:
msgid "[_cedrick_] Хорошо, проходите, скоро вам выдадут меню. Следующий"
msgstr "[_cedrick_] De acuerdo, vamos, pronto se te dará un menú. Siguiente"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:8 #-#-# translate crowdin invariably_cedrick_2_e61cce21:
msgid "[_restaurant_goer_6_] Здравствуйте. Мы не заказывали столик, есть ли у вас место для двоих?"
msgstr "[_restaurant_goer_6_] Hola. No reservamos una mesa, ¿tienes un lugar para dos?"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:12 #-#-# translate crowdin invariably_cedrick_3_750a5ed0:
msgid "[_cedrick_] Простите, на данный момент все места заняты. Но судя по моим наблюдениям примерно через 20 минут одна пара уходит"
msgstr "[_cedrick_] Disculpe, en este momento no tenemos mesas libres. Pero, por lo que veo, una pareja se irá dentro de unos veinte minutos."

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:13 #-#-# translate crowdin invariably_cedrick_3_f689912c:
msgid "[_cedrick_] Через дорогу продается отличный бабл ти. Можете пока попробовать его, погулять по парку и вернуться"
msgstr "[_cedrick_] está vendiendo mucho dinero al otro lado de la calle. Puedes probarlo mientras das un paseo por el parque y regresas"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:14 #-#-# translate crowdin invariably_cedrick_3_37bf9a45:
msgid "[_cedrick_] Столик ваш, если придете через 20 минут"
msgstr "[_cedrick_] Mesa tuya si vienes en 20 minutos"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:15 #-#-# translate crowdin invariably_cedrick_3_e07e880f:
msgid "[_restaurant_goer_6_] Х-хорошо! Спасибо вам"
msgstr "[_restaurant_goer_6_] ¡Está bien! Gracias"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:16 #-#-# translate crowdin invariably_cedrick_3_296b8c64:
msgid "[_restaurant_goer_6_] Такой учтивый молодой человек, да, дорогая?"
msgstr "[_restaurant_goer_6_] Un joven tan cortés, ¿sí, cariño?"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:17 #-#-# translate crowdin invariably_cedrick_3_aba2e11f:
msgid "[_restaurant_goer_7_] Ага, еще и такой красавчик"
msgstr "[_restaurant_goer_7_] Agha, también tan guapo"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:18 #-#-# translate crowdin invariably_cedrick_3_7405dc9d:
msgid "[_restaurant_goer_6_] ..."
msgstr "[_restaurant_goer_6_] ..."

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:19 #-#-# translate crowdin invariably_cedrick_3_c4dc91a5:
msgid "[_restaurant_goer_6_] Так, в смысле?"
msgstr "[_restaurant_goer_6_] ¿De acuerdo, quiero decir?"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:20 #-#-# translate crowdin invariably_cedrick_3_5a89b56e:
msgid "[_cedrick_] (Хах, думаю после этих слов они уже не вернутся..)"
msgstr "[_cedrick_] (Hah, creo que después de estas palabras no volverán.)"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:24 #-#-# translate crowdin invariably_cedrick_4_9669f8ea:
msgid "[_cedrick_] Следующий!"
msgstr "[_cedrick_] ¡A continuación!"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:25 #-#-# translate crowdin invariably_cedrick_4_63272ad7:
msgid "[_cedrick_] Добрый вечер. У вас заказан столик?"
msgstr "[_cedrick_] Buenas noches. ¿Tienes una mesa?"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:26 #-#-# translate crowdin invariably_cedrick_4_eb1d374a:
msgid "[_restaurant_goer_8_] Да. Столик должен быть забронирован на имя Сильвио"
msgstr "[_restaurant_goer_8_] Sí. La mesa debe reservarse en nombre de silvio"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:27 #-#-# translate crowdin invariably_cedrick_4_2f665184:
msgid "[_cedrick_] Хм.. Сейчас посмотрю"
msgstr "[_cedrick_] Hmm.. Ya lo veré"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:28 #-#-# translate crowdin invariably_cedrick_4_ab1ecd37:
msgid "[_cedrick_] Не помните какой конкретно был столик? Угловой для компании или для двоих?"
msgstr "[_cedrick_] ¿No recuerdas exactamente cuál era la mesa? ¿Esquina para la empresa o para dos?"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:29 #-#-# translate crowdin invariably_cedrick_4_06a9d4d8:
msgid "[_tony_] На двоих. Пацан, давай быстрее, не хочу задерживать остальных посетителей"
msgstr "[_tony_] Para dos. Chico, vamos más rápido, no quiero detener a otros visitantes"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:30 #-#-# translate crowdin invariably_cedrick_4_6ef555cc:
msgid "[_cedrick_] Пацан? Хах. Простите, но я не могу найти вашего имени в списке"
msgstr "[_cedrick_] ¿Niña? Hah. Lo siento, pero no encuentro tu nombre en la lista"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:31 #-#-# translate crowdin invariably_cedrick_4_1b031679:
msgid "[_tony_] Да ты издеваешься!"
msgstr "[_tony_] ¡Estás bromeando!"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:33 #-#-# translate crowdin invariably_cedrick_4_2e62511c:
msgid "[_haylin_] (Мммфф.. Ч-что там происходит.. Буйный клиент..)"
msgstr "[_haylin_] (Mmff.. Lo que está pasando ahí... El motín...”)"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:34 #-#-# translate crowdin invariably_cedrick_4_cc2e9b4d:
msgid "[_cedrick_] (Думаю это надолго. Хай Лин, придется потерпеть..)"
msgstr "[_cedrick_] (Creo que durante mucho tiempo. Hola Lin, tendré que aguantar.)"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:43 #-#-# translate crowdin invariably_cedrick_4_ade8cdbc:
msgid "[_cedrick_] Никак нет, можете сами посмотреть. Вы уверены, что заказывали столик именно в этом ресторане?"
msgstr "[_cedrick_] No hay manera, puedes verlo por ti mismo. ¿Seguro que pidió una mesa en este restaurante?"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:45 #-#-# translate crowdin invariably_cedrick_4_c162c519:
msgid "[_tony_] Да, мать твою, уверен. Я далеко не каждый день предпочитаю классической итальянской кухне эту азиатскую обрыгаловку, знаешь ли"
msgstr "[_tony_] Sí, carajo, estoy seguro. No prefiero todos los días a la cocina italiana clásica este saqueo asiático, ya sabes"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:47 #-#-# translate crowdin invariably_cedrick_4_22b85b2c:
msgid "[_cedrick_] Сэр, это приличное заведение. Прекратите так выражаться, иначе я попрошу вас уйти"
msgstr "[_cedrick_] Señor, es un lugar decente. Deja de decir eso, o te pediré que vayas"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:49 #-#-# translate crowdin invariably_cedrick_4_98ecc634:
msgid "[_tony_] Уйти? Меня!? Хахах, пацан, да ты хоть знаешь, с кем ты, мать твою, говоришь?"
msgstr "[_tony_] ¿Para irte? ¡¿Yo!? Jaja, chico, ¿sabes con quién estás hablando?"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:51 #-#-# translate crowdin invariably_cedrick_4_d39bc80e:
msgid "[_cedrick_] Не думаю, что это важно. Вы для меня такой же клиент, как и остальные"
msgstr "[_cedrick_] No creo que sea importante. Eres el mismo cliente que los demás"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:53 #-#-# translate crowdin invariably_cedrick_4_bbcf77ee:
msgid "[_tony_] Слушай сюда, шкет, я, Сильвио мать его Данте.."
msgstr "[_tony_] Escucha aquí, patina, yo, Silvio madre su Dante..."

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:55 #-#-# translate crowdin invariably_cedrick_4_fde31832:
msgid "[_johnlin_] Сил! Какого черта ты делаешь в моем ресторане?! Я же сказала никогда больше здесь не появляться"
msgstr "[_johnlin_] ¡Poder! ¿Qué diablos haces en mi restaurante? Te dije que no volvieras a estar aquí"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:57 #-#-# translate crowdin invariably_cedrick_4_6a3f4484:
msgid "[_tony_] Я буду появляться там, где захочу, Джоан. Я пришел чтобы поговорить"
msgstr "[_tony_] Apareceré donde quiera, Joan. He venido a hablar"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:59 #-#-# translate crowdin invariably_cedrick_4_3364fa15:
msgid "[_johnlin_] Нам не о чем с тобой говорить, Сильвио, убирайся"
msgstr "[_johnlin_] No tenemos nada de qué hablar contigo, Silvio, ¡sal de ahí"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:61 #-#-# translate crowdin invariably_cedrick_4_93b12f82:
msgid "[_tony_] Речь о твоих долгах. Мы либо обсудим это лично, либо у всех на глазах, мне плевать"
msgstr "[_tony_] es sobre sus deudas. Lo discutiremos en persona, o delante de todos, no me importa"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:62 #-#-# translate crowdin invariably_cedrick_4_2433f236:
msgid "[_tony_] Хотел ведь по-хорошему, заказал столик"
msgstr "[_tony_] Quería ser bueno, pidió una mesa"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:64 #-#-# translate crowdin invariably_cedrick_4_04746d3e:
msgid "[_cedrick_] Сэр, я попрошу вас уйти"
msgstr "[_cedrick_] Señor, le pediré que se vaya"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:66 #-#-# translate crowdin invariably_cedrick_4_ba6c2d99:
msgid "[_tony_] Не лезь, пиздюк, тебя никто не спрашивал"
msgstr "[_tony_] No te muevas, peduk, nadie te preguntó"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:68 #-#-# translate crowdin invariably_cedrick_4_47ebef09:
msgid "[_johnlin_] Р-рик, не надо.."
msgstr "[_johnlin_] R-rh, no..."

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:69 #-#-# translate crowdin invariably_cedrick_4_dde439ff:
msgid "[_cedrick_] Вы задерживаете других посетителей. Мешаете бизнесу"
msgstr "[_cedrick_] Usted retrasa a otros visitantes. Interferir con los negocios"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:71 #-#-# translate crowdin invariably_cedrick_4_576f32e9:
msgid "[_tony_] И что? Хах, вызовешь полицию?"
msgstr "[_tony_] ¿Y qué? Ja, ¿vas a llamar a la policía?"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:73 #-#-# translate crowdin invariably_cedrick_4_4be56df5:
msgid "[_cedrick_] Нет, лишняя шумиха нам ни к чему. Я просто сразу позвоню своей подруге Медине из Интерпола"
msgstr "[_cedrick_] No, no necesitamos ningún bombo extra. Llamaré a mi amiga Medina de la interpol de inmediato"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:75 #-#-# translate crowdin invariably_cedrick_4_447322ad:
msgid "[_tony_] Марие Медине? Пиздюк, да ты блефуешь"
msgstr "[_tony_] ¿María Medina? Pizduk, estás faroleando"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:77 #-#-# translate crowdin invariably_cedrick_4_0fb2c0f5:
msgid "[_cedrick_] Хах, хочешь проверить? Не знаю уж что тут происходит, но судя по твоему поведению ты мутный тип с какими-то криминальными связями"
msgstr "[_cedrick_] Hah, ¿quieres comprobarlo? No sé qué está pasando aquí, pero a juzgar por tu comportamiento, eres un tipo turbio con algunas conexiones criminales"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:79 #-#-# translate crowdin invariably_cedrick_4_45ef639c:
msgid "[_cedrick_] А всех таких людей вроде тебя объединяет знаешь что, Сильвио?"
msgstr "[_cedrick_] ¿Y toda esta gente como tú sabes qué, Silvio?"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:81 #-#-# translate crowdin invariably_cedrick_4_f689ef80:
msgid "[_tony_] Просвети уж, умник"
msgstr "[_tony_]HEHEHEAD, Smart"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:83 #-#-# translate crowdin invariably_cedrick_4_644ec41f:
msgid "[_cedrick_] Вы все как один с микрофонами прослушки в жопе. Даже если не подозреваете об этом"
msgstr "[_cedrick_] Todos ustedes son como uno con micrófonos que hacen wiretapping en el culo. Incluso si no lo sabes"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:84 #-#-# translate crowdin invariably_cedrick_4_25550378:
msgid "[_cedrick_] Любой правительственный агент только и мечтает о том, чтобы залезть к тебе в дом, осмотреть твой гараж, проверить содержимое твоей машины"
msgstr "[_cedrick_] Cualquier agente del gobierno solamente y sueña con subir a su casa, inspeccionar su garaje, verificar el contenido de su automóvil"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:85 #-#-# translate crowdin invariably_cedrick_4_418ec301:
msgid "[_cedrick_] Но у них нет достаточного предлога. А поэтому они следят день и ночь за тобой, чтобы найти этот предлог"
msgstr "[_cedrick_] Pero no tienen suficiente pretexto. Y así ven día y noche para que encuentres este pretexto"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:87 #-#-# translate crowdin invariably_cedrick_4_ea46cc18:
msgid "[_cedrick_] Такой, как, например, драка с пацаном у прилавка азиатского ресторанчика, после того, как ты вышел из себя"
msgstr "[_cedrick_] Como, por ejemplo, una pelea con un niño en el mostrador de un restaurante asiático, después de perder los estribos"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:88 #-#-# translate crowdin invariably_cedrick_4_101cfda0:
msgid "[_cedrick_] Одна простая драка и все твои грязные секреты вылезут наружу. Ну что, хочешь устроить это? Я готов хоть сейчас"
msgstr "[_cedrick_] Una simple pelea y todos tus sucios secretos saldrán. Entonces, ¿quieres arreglar esto? Estoy listo ahora"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:90 #-#-# translate crowdin invariably_cedrick_4_5379e471:
msgid "[_tony_] ..."
msgstr "[_tony_] ..."

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:92 #-#-# translate crowdin invariably_cedrick_4_dc676f1d:
msgid "[_cedrick_] А ты готов?"
msgstr "[_cedrick_] ¿Estás listo?"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:94 #-#-# translate crowdin invariably_cedrick_4_68f131b2:
msgid "[_tony_] ...."
msgstr "[_tony_] ...."

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:97 #-#-# translate crowdin invariably_cedrick_4_f447c171:
msgid "[_cedrick_] Медина у меня на быстром наборе. Думаю в отличии от продажных копов, которые закрыли бы на все глаза, Медина вцепится в тебя мертвой хваткой"
msgstr "[_cedrick_] Medina está en mi set rápido. Creo que, a diferencia de los corruptos policías que se cubrirían los ojos, Medina se aferrará a ti con un agarre muerto"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:98 #-#-# translate crowdin invariably_cedrick_4_270e5198:
msgid "[_tony_] ......."
msgstr "[_tony_] ......."

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:100 #-#-# translate crowdin invariably_cedrick_4_f638664d:
msgid "[_tony_] Я пойду. Не смею больше вас задерживать, господа. Джоан, еще увидимся"
msgstr "[_tony_] Me voy. No puedo retenerte más, caballeros. Joan, nos vemos de nuevo"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:101 #-#-# translate crowdin invariably_cedrick_4_0d9b9265:
msgid "[_cedrick_] Если и увидитесь, то я буду рядом, Сил"
msgstr "[_cedrick_] Si ves, estaré allí,"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:103 #-#-# translate crowdin invariably_cedrick_4_d9d65c68:
msgid "[_tony_] Пф.. Не зазнавайся, пиздюк.."
msgstr "[_tony_] Pf. No te hagas conceder, monstruo..."

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:116 #-#-# translate crowdin proverka_haaylin_vibro_98e124ae:
msgid "[_restaurant_goer_1_] Эй, что это за стоны!?"
msgstr "[_restaurant_goer_1_] Hey, ¿qué clase de gemidos son estos!?"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:117 #-#-# translate crowdin proverka_haaylin_vibro_afcafdec:
msgid "[_restaurant_goer_2_] Я не одна это слышу?"
msgstr "[_restaurant_goer_2_] ¿No soy el único que escucha esto?"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:118 #-#-# translate crowdin proverka_haaylin_vibro_6b6b9ed6:
msgid "[_restaurant_goer_3_] Что блин происходит в этом ресторане.."
msgstr "[_restaurant_goer_3_] ¿Qué pasa en este restaurante?"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:119 #-#-# translate crowdin proverka_haaylin_vibro_d8039f96:
msgid "[_cedrick_] (Ч-черт, нас поймали.. Это зашло слишком далеко)"
msgstr "[_cedrick_] (Maldita sea, nos han atrapado... Se fue demasiado lejos)"

# game/scripts/quests/questSecretOfTheSilverDragon/invariably_cedrick.rpy:120 #-#-# translate crowdin proverka_haaylin_vibro_64b31956:
msgid "[_haylin_] Р-рик, что ты наделал.."
msgstr "[_haylin_] R-r-Rick, lo que has hecho..."

