# TODO: Translation updated at 2023-07-25 15:55 #|#|# # game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:5 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_a6eb14d4:
msgid "[_centered_] {size=37}Днем на следующий день{/size} [withDissolve1]"
msgstr "[_centered_] {size=37}Al día siguiente, por la tarde{/size} [withDissolve1]"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:11 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_294eec35:
msgid "[_chenlin_] Так вы уходите?"
msgstr "[_chenlin_] ¿Así que te vas?"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:13 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_b2cacfae:
msgid "[_haylin_] Д-да. Мам, пап, простите, сегодня я не смогу помочь вам в ресторане. И, возможно, завтра тоже"
msgstr "[_haylin_] D-Da. Mamá, papá, lo siento, no puedo ayudarte en el restaurante esta noche. Y tal vez mañana también"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:15 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_a7261517:
msgid "[_chenlin_] Ох, ну.."
msgstr "[_chenlin_] Oh, bueno…"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:16 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_b0514ffb:
msgid "[_johnlin_] В-все хорошо, дорогая. Мы понимаем. Молодые должны отдыхать и наслаждаться жизнью. Хоть иногда.."
msgstr "[_johnlin_] B está bien, cariño. Lo entendemos. Los jóvenes deben relajarse y disfrutar de la vida. Al menos a veces…"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:17 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_34384eee:
msgid "[_johnlin_] Верно, Чен?"
msgstr "[_johnlin_] ¿Verdad, Chen?"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:18 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_66a2e45d:
msgid "[_chenlin_] Д-да, все так.. Отдыхайте, молодежь, развлекайтесь. Наслаждайтесь компанией друг друга"
msgstr "[_chenlin_] D-da, está bien. Descansa, jóvenes, diviértete. Disfrutad de la compañía del otro"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:19 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_86766964:
msgid "[_chenlin_] Я надеюсь ты как следует присмотришь за моей дочерью, Рик"
msgstr "[_chenlin_] Espero que cuides bien de mi hija, Rick."

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:20 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_c3bb20f6:
msgid "[_chenlin_] Головой за нее отвечаешь"
msgstr "[_chenlin_] Su cabeza por ello es responsable"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:22 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_b67e9578:
msgid "[_cedrick_] Конечно, мистер Чен. Верну вашу дочь в целости и сохранности"
msgstr "[_cedrick_] Por supuesto, el Sr. Chen. Traeré a tu hija de vuelta a salvo"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:24 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] …"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:26 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_293ea85c:
msgid "[_cedrick_] Можете не сомневаться"
msgstr "[_cedrick_] No se puede insurgir"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:28 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_87c5dd71:
msgid "[_haylin_] ..."
msgstr "[_haylin_] …"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:29 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_686cd998:
msgid "[_johnlin_] Что ж, тогда не станем вам больше задерживать. Чем быстрее уйдете, тем быстрее останьтесь наедине, верно?"
msgstr "[_johnlin_] Bien, entonces no los retendremos más. Cuanto antes se vayan, antes podrán quedarse a solas, ¿verdad?"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:30 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_a4a111d1:
msgid "[_chenlin_] Д-джоан.. Ты что это такое имеешь ввиду?"
msgstr "[_chenlin_] Joan. ¿A qué te refieres?"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:31 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_47f0ce29:
msgid "[_johnlin_] Ахах, я просто шучу, Чен, шучу"
msgstr "[_johnlin_] Jajaja, solo bromeo, Chen. Es broma."

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:32 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_2c595be4:
msgid "[_chenlin_] ..."
msgstr "[_chenlin_] …"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:34 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_6c065667:
msgid "[_johnlin_] Ох, чуть не забыла. Хай Лин, у меня для тебя есть подарок. Вот, держи"
msgstr "[_johnlin_] Oh, casi lo olvido. Hay Lin, tengo un regalo para ti. Aquí, espera"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:36 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_d27fbe22:
msgid "[_haylin_] П-подарок?"
msgstr "[_haylin_] ¿U-un regalo?"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:37 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_a2890acd:
msgid "[_johnlin_] Это подарок вам, как новоиспеченной паре, от заботливой матери, хаха"
msgstr "[_johnlin_] Es un regalo para ti como una nueva pareja, de una madre cariñosa, jaja"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:39 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_bc8f7cae:
msgid "[_haylin_] Мхх.. С-спасибо, мам.."
msgstr "[_haylin_] Mx… Gracias, mamá…"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:41 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_226e712e:
msgid "[_cedrick_] Да, мы обязательно откроем его чуть позже"
msgstr "[_cedrick_]Y Sí, definitivamente lo abriremos un poco más tarde"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:43 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_8dd329f5:
msgid "[_johnlin_] Ох, уверена вам понравится, голубки"
msgstr "[_johnlin_] Oh, estoy seguro que te gustarán, palomas"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:44 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_79e77999:
msgid "[_chenlin_] (Интересно, что там..)"
msgstr "[_chenlin_] (Curiosamente lo que hay…)"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:46 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_43db60a3:
msgid "[_cedrick_] Спасибо вам, Джоан. За все. Мы пойдем"
msgstr "[_cedrick_] Gracias, Joan. Para todo. Iremos"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:48 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_57ec8fea:
msgid "[_johnlin_] Д-да, конечно. Не стану вас больше задерживать.."
msgstr "[_johnlin_] Sí, por supuesto. No te demoraré más."

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:50 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_a4cc314d:
msgid "[_cedrick_] Хорошего дня, Джоан. Мистер Чен"
msgstr "[_cedrick_] Es un buen día, Joan. ¿Sr. ¿Chen"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:52 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_90317ed7:
msgid "[_johnlin_] Удачи, Рик. Пока, дочка"
msgstr "[_johnlin_] Buena suerte, Rick. Adiós, hija"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:53 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_e7f1d045:
msgid "[_chenlin_] Н-не забывайте писать"
msgstr "[_chenlin_] N-no olvides escribir"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:55 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_68a8264d:
msgid "[_haylin_] Н-не забудем.."
msgstr "[_haylin_] N-no olvides…"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:60 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_e1c03a80:
msgid "Седрик и Хай Лин уходят. Джоан и Чен провожают их вслед"
msgstr "Cedric y Hay Lin se van. Joan y Chen los acompañan después"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:66 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_813dae41:
msgid "[_chenlin_] Как думаешь, у них все будет хорошо?"
msgstr "[_chenlin_] ¿Crees que van a estar bien?"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:67 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_2f0933f2:
msgid "[_johnlin_] Думаю у них все будет отлично, Чен?"
msgstr "[_johnlin_] Creo que lo harán muy bien, Chen?"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:68 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_f2b556b3:
msgid "[_johnlin_] Чего это ты так распереживался? Давно не видела тебя таким сентиментальным"
msgstr "[_johnlin_] ¿Por qué estás tan preocupado? Hace mucho que no te veo tan sentimental"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:69 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_9e2e2049:
msgid "[_chenlin_] Эм.."
msgstr "[_chenlin_] Mm."

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:70 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_506a68f8:
msgid "[_chenlin_] Скажем так, я даже не заметил, как быстро выросла наша дочурка"
msgstr "[_chenlin_] Digamos que ni siquiera me di cuenta de lo rápido que creció nuestra hija"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:71 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_29c5938e:
msgid "[_johnlin_] Н-неужели?"
msgstr "[_johnlin_] ¿D-de verdad?"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:72 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_7a756f4f:
msgid "[_chenlin_] Да.."
msgstr "[_chenlin_] Sí…"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:73 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_446bb7df:
msgid "[_chenlin_] А еще ее вкус в парнях.. Явно мне что-то напоминает.."
msgstr "[_chenlin_] Y su gusto por los chicos. Creo que es como algo."

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:74 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_b3232a9d:
msgid "[_johnlin_] Ахах, вся в мать, ты это хочешь сказать?"
msgstr "[_johnlin_] Jajaja, de tal madre, tal hija, ¿eso quieres decir?"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:75 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_278391f8:
msgid "[_chenlin_] Да уж, она точно в тебя. Вы похожи куда больше, чем мне до этого казалось.."
msgstr "[_chenlin_] Sí, definitivamente salió a ti. Se parecen mucho más de lo que creía…"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:76 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_2c595be4_1:
msgid "[_chenlin_] ..."
msgstr "[_chenlin_] …"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:77 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_8d2b2b88:
msgid "[_chenlin_] Т-ты ничего вчера не слышала?"
msgstr "[_chenlin_] ¿No escuchaste nada ayer?"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:78 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_07f0db1c:
msgid "[_johnlin_] М-ммм? О-о чем ты?"
msgstr "[_johnlin_] ¿Mmm? Oh, ¿qué eres?"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:79 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_a042ebb9:
msgid "[_chenlin_] Ничего вчера не мешало уснуть?"
msgstr "[_chenlin_] ¿Nada te impidió dormir anoche?"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:80 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_19c63dba:
msgid "[_johnlin_] Н-нет, конечно нет.. Мы вчера так активно работали, что я мигом отрубилась"
msgstr "[_johnlin_] N-no, por supuesto que no. Ayer trabajamos tan duro que instantáneamente me desmayé"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:81 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_e538bee2:
msgid "[_chenlin_] П-понятно.. Хорошо.."
msgstr "[_chenlin_] Ya veo. Muy bien."

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:82 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_7335c90c:
msgid "[_johnlin_] А-агам.. Хорошо.."
msgstr "[_johnlin_] A-ajá… Está bien…"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:83 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_2c595be4_2:
msgid "[_chenlin_] ..."
msgstr "[_chenlin_] …"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:84 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_d3a6f6dc:
msgid "[_chenlin_] А что это был за подарок?"
msgstr "[_chenlin_] ¿Y qué fue este regalo?"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:85 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_a9b06c00:
msgid "[_johnlin_] Ммм.. П-просто красивая одежда для Хай Лин.. Т-традиционный наряд"
msgstr "[_johnlin_] Mmm… Solo ropa hermosa para Hay Lin. Atuendo tradicional"

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:86 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_4266863a:
msgid "[_chenlin_] Хм, понятно.. Мило.."
msgstr "[_chenlin_] Hmm, por supuesto. Milo."

# game/scripts/quests/questSecretOfTheSilverDragon/questSecretOfTheSilverDragon_epilog.rpy:87 #-#-# translate crowdin questSecretOfTheSilverDragon_epilog_1c533ede:
msgid "[_johnlin_] Ох, интересно, как он будет на ней смотреться.."
msgstr "[_johnlin_] Oh, me pregunto cómo se verá como Él."

