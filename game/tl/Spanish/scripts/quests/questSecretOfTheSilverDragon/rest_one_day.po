# TODO: Translation updated at 2023-07-25 15:55 #|#|# # game/scripts/quests/questSecretOfTheSilverDragon/rest_one_day.rpy:2 #-#-# translate crowdin rest_one_day_7192f0d0:
msgid "[_cedrick_] Элион, сегодня я помогаю в Серебряном драконе. Присмотришь за магазином?"
msgstr "[_cedrick_] Elyon, hoy estoy ayudando en el dragón de plata. ¿Cuidando la tienda?"

# game/scripts/quests/questSecretOfTheSilverDragon/rest_one_day.rpy:4 #-#-# translate crowdin rest_one_day_47a83a02:
msgid "[_elion_] Х-хорошо, Рик. Ты надолго?"
msgstr "[_elion_] - Bien, Rick. ¿Durante mucho tiempo?"

# game/scripts/quests/questSecretOfTheSilverDragon/rest_one_day.rpy:6 #-#-# translate crowdin rest_one_day_7ba62884:
msgid "[_cedrick_] Скорее всего на весь день. Буду поздно ночью, либо вообще утром"
msgstr "[_cedrick_] es probablemente todo el día. Llegaré tarde por la noche o por la mañana"

# game/scripts/quests/questSecretOfTheSilverDragon/rest_one_day.rpy:8 #-#-# translate crowdin rest_one_day_9258c05b:
msgid "[_elion_] Ох.. А что по-поводу нашего, эм.. с-свидания?"
msgstr "[_elion_] Oh. ¿Qué hay de la nuestra, um... ¿Una reunión?"

# game/scripts/quests/questSecretOfTheSilverDragon/rest_one_day.rpy:9 #-#-# translate crowdin rest_one_day_19125ffa:
msgid "[_cedrick_] Да, я помню. Прости, но сегодня точно не получится. Как только освобожусь от всех дел, сразу тебе скажу"
msgstr "[_cedrick_] Sí, lo recuerdo. Lo siento, pero definitivamente no funcionará hoy. Tan pronto como esté libre de todas las cosas, te lo diré"

# game/scripts/quests/questSecretOfTheSilverDragon/rest_one_day.rpy:11 #-#-# translate crowdin rest_one_day_1841f9cf:
msgid "[_elion_] Х-хорошо, я поняла.. Удачи там!"
msgstr "[_elion_] es bueno, lo entiendo. ¡Buena suerte ahí!"

# game/scripts/quests/questSecretOfTheSilverDragon/rest_one_day.rpy:12 #-#-# translate crowdin rest_one_day_7126ec15:
msgid "[_cedrick_] Спасибо"
msgstr "[_cedrick_] Gracias."

