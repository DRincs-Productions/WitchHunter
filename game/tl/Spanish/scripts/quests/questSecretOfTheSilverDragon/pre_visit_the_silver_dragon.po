# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:6 #-#-# translate crowdin gallery_d_086_939eea21:
msgid "[_johnlin_] Р-рик!? Ч-что ты здесь делаешь.."
msgstr "[_johnlin_] R-rick!? Ch... lo que está haciendo aquí."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:7 #-#-# translate crowdin gallery_d_086_9be6f75a:
msgid "[_cedrick_] Хах, а что такое, Джоан? Я что, не могу прийти в ваш ресторан? К тому же сегодня я намерен отведать ваш особый десерт.."
msgstr "[_cedrick_] Haah, ¿qué te pasa, Joan? ¿No puedo ir a tu restaurante? Además, hoy pretendo probar tu postre especial."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:11 #-#-# translate crowdin gallery_d_086_dcefa3b4:
msgid "[_johnlin_] Ох.. Я так и знала, что ты рано или поздно придешь за этим.."
msgstr "[_johnlin_] Oh. Sabía que vendrías después de eso tarde o temprano."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:12 #-#-# translate crowdin gallery_d_086_8cc34450:
msgid "[_cedrick_] Пойдем, у нас не так много времени..."
msgstr "[_cedrick_] Vamos, no tenemos mucho tiempo..."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:16 #-#-# translate crowdin gallery_d_086_6a3a8fa9:
msgid "[_johnlin_] ..."
msgstr "[_johnlin_] ..."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:24 #-#-# translate crowdin gallery_d_086_10930a08:
msgid "[_centered_] {size=37}СПУСТЯ ОПРЕДЕЛЕННОЕ ВРЕМЯ{/size} [withDissolve1]"
msgstr "[_centered_] {size=37}DESPUÉS DE UN CIERTO TIEMPO{/size} [withDissolve1]"

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:29 #-#-# translate crowdin gallery_d_086_461e48d7:
msgid "[_cedrick_] Что ж, Джоан, мне пора идти"
msgstr "[_cedrick_] Bueno, Joan, estoy genial"

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:30 #-#-# translate crowdin gallery_d_086_85dd4b4b:
msgid "[_cedrick_] Не забудь, завтра я тоже к вам зайду. Как договаривались"
msgstr "[_cedrick_] No lo olvides, yo también iré a ti mañana. Cómo negociar"

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:32 #-#-# translate crowdin gallery_d_086_aa5f8ae2:
msgid "[_johnlin_] Аааххх.. Ооохх.."
msgstr "[_johnlin_] Aahhh... Oh, oh..."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:34 #-#-# translate crowdin gallery_d_086_ffd8d270:
msgid "[_cedrick_] Ты слышишь меня?"
msgstr "[_cedrick_] ¿Me oyes?"

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:36 #-#-# translate crowdin gallery_d_086_a8d10cf8:
msgid "[_johnlin_] Д-да.."
msgstr "[_johnlin_] D-Da..."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:38 #-#-# translate crowdin gallery_d_086_dd799c96:
msgid "[_cedrick_] И что я говорил до этого?"
msgstr "[_cedrick_] ¿Y qué he dicho antes?"

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:40 #-#-# translate crowdin gallery_d_086_29161a2c:
msgid "[_johnlin_] Ааахх.. Уууххх.."
msgstr "[_johnlin_] Aahh... Uuhhhhhhhh"

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:42 #-#-# translate crowdin gallery_d_086_d49ab8f3:
msgid "[_johnlin_] Я.. Ммм.. Ты говорил, что хочешь завтра помочь нам.. В-в ресторане.."
msgstr "[_johnlin_] Yo... Mmm... Dijiste que querías ayudarnos mañana. En el restaurante..."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:44 #-#-# translate crowdin gallery_d_086_37814de1:
msgid "[_cedrick_] И что еще?"
msgstr "[_cedrick_] ¿Y qué más?"

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:46 #-#-# translate crowdin gallery_d_086_73a51834:
msgid "[_johnlin_] Ч-что я.. аахх.. что хочешь, чтобы я воспользовалась игрушкой.. Виброяйцом.."
msgstr "[_johnlin_] Q-qué... Ahh... ¿Quieres que use el juguete... el huevo vibrador...?"

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:48 #-#-# translate crowdin gallery_d_086_5b3c2afe:
msgid "[_cedrick_] И?"
msgstr "[_cedrick_] ¿Y?"

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:50 #-#-# translate crowdin gallery_d_086_d3c87316:
msgid "[_johnlin_] Завтра оно будет во мне весь день.. Я обещаю.."
msgstr "[_johnlin_] Mañana será todo el día. Te lo prometo..."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:52 #-#-# translate crowdin gallery_d_086_060a2da8:
msgid "[_cedrick_] Еще что-нибудь?"
msgstr "[_cedrick_] ¿Algo más?"

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:54 #-#-# translate crowdin gallery_d_086_da69d532:
msgid "[_johnlin_] Да.. Т-ты сказал оставить костюм тебе.."
msgstr "[_johnlin_] Sí.. Me dijiste que te dejara el traje."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:55 #-#-# translate crowdin gallery_d_086_95e6f61d:
msgid "[_johnlin_] Я верну его.."
msgstr "[_johnlin_] Lo devolveré."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:57 #-#-# translate crowdin gallery_d_086_847e6d17:
msgid "[_johnlin_] Как только.."
msgstr "[_johnlin_] Tan pronto como..."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:59 #-#-# translate crowdin gallery_d_086_5611bad7:
msgid "[_johnlin_] Будут силы… Снять его.."
msgstr "[_johnlin_] se verá obligado... Quítalo."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:61 #-#-# translate crowdin gallery_d_086_d3df6823:
msgid "[_cedrick_] Ты же помнишь, для чего мне нужен этот костюм? Почему я его забираю?"
msgstr "[_cedrick_] ¿Recuerdas por qué necesito este disfraz? ¿Por qué me lo llevo?"

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:63 #-#-# translate crowdin gallery_d_086_a8d10cf8_1:
msgid "[_johnlin_] Д-да.."
msgstr "[_johnlin_] D-Da..."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:65 #-#-# translate crowdin gallery_d_086_6cc37307:
msgid "[_cedrick_] И тебя все устраивает, верно?"
msgstr "[_cedrick_] Y estás bien, ¿verdad?"

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:67 #-#-# translate crowdin gallery_d_086_1144ab1c:
msgid "[_johnlin_] Я.. аааххх.. я.. ммм.."
msgstr "[_johnlin_] Yo... aaah... yo... mmm..."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:68 #-#-# translate crowdin gallery_d_086_d5d313ad:
msgid "[_cedrick_] Ну же, говори"
msgstr "[_cedrick_] Vamos, habla"

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:70 #-#-# translate crowdin gallery_d_086_1e150f19:
msgid "[_johnlin_] Если.. если все по обоюдному согласию.. Тогда я не против.. Т-только не говори ей, что мы тоже это делаем.."
msgstr "[_johnlin_] Si... Si todo por consentimiento mutuo... Entonces no me importa... No le digas que también lo haremos."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:72 #-#-# translate crowdin gallery_d_086_9e1f631b:
msgid "[_johnlin_] Ч-что до этого я была в нем.."
msgstr "[_johnlin_] Que antes de eso estaba en él..."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:74 #-#-# translate crowdin gallery_d_086_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:76 #-#-# translate crowdin gallery_d_086_0e3929ff:
msgid "[_cedrick_] Джоан.. ты же понимаешь, на сколько ты безумная шлюха?"
msgstr "[_cedrick_] Joan... ¿Sabes lo loco que estás?"

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:78 #-#-# translate crowdin gallery_d_086_86dba6db:
msgid "[_johnlin_] Я.. ааххх.. н-ничего не могу с собой поделать.. я просто.."
msgstr "[_johnlin_] Yo... Ahhhhhhhh. Solo estoy..."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:80 #-#-# translate crowdin gallery_d_086_a088bb52:
msgid "[_johnlin_] П-просто хочу еще.."
msgstr "[_johnlin_] Sólo quiero más..."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:82 #-#-# translate crowdin gallery_d_086_a0646b8f:
msgid "[_cedrick_] Хах. И я дам тебе еще. Просто делай все как я скажу"
msgstr "[_cedrick_] H. H. Y te daré más. Hazlo como te digo"

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:84 #-#-# translate crowdin gallery_d_086_f48eca9d:
msgid "[_johnlin_] Х-хорошо.."
msgstr "[_johnlin_] Muy bien."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:86 #-#-# translate crowdin gallery_d_086_7f70a283:
msgid "[_cedrick_] И раз уж ты не против, может вручишь этот костюм сама? Как подарок, в таком, красивом пакетике"
msgstr "[_cedrick_] Y como no te importa, ¿por qué no le das este traje tú mismo? Como regalo, en una bolsa tan hermosa"

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:88 #-#-# translate crowdin gallery_d_086_e0d66509:
msgid "[_johnlin_] Д-да.. я поняла.."
msgstr "[_johnlin_] D-Da... Lo entiendo..."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:90 #-#-# translate crowdin gallery_d_086_e640ba61:
msgid "[_cedrick_] А, и еще.. Мне нужны будут наручники. У тебя они точно есть, приложишь к комплекту?"
msgstr "[_cedrick_] A, y más. Voy a necesitar unas esposas. Definitivamente los tienes, ¿te adjuntarás al kit?"

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:92 #-#-# translate crowdin gallery_d_086_3d67d985:
msgid "[_johnlin_] Аааххх.. Л-ладно.. Я добавлю наручники"
msgstr "[_johnlin_] Aahhhhhhhh todo bien. Añadiré esposas"

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:94 #-#-# translate crowdin gallery_d_086_ea63e47a:
msgid "[_cedrick_] Хахаха.. Ты просто повернута на сексе, Джоан, для тебя и вправду нет никаких границ, когда дело касается члена"
msgstr "[_cedrick_] Hahaha.. Acabas de excitar el sexo, Joan, por ti y realmente no hay límites cuando se trata del pene"

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:96 #-#-# translate crowdin gallery_d_086_3238beb1:
msgid "[_johnlin_] Г-главное, чтобы это было добровольно и она была согласно.. А так.. Ааавв.. То, что происходит в постели - это дело каждого.."
msgstr "[_johnlin_] es lo principal para hacerlo voluntariamente y es según... Oh, así que... Aaav. Lo que pasa en la cama es asunto de todos."

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:98 #-#-# translate crowdin gallery_d_086_9910ed00:
msgid "[_johnlin_] Е-если моей дочери это нравится хоть немного так же, как и мне, то.. аааахх.. к-кто я такая, чтобы ее осуждать.."
msgstr "[_johnlin_] Si a mi hija le gusta un poco como yo, entonces... Aahhhhhhhh ¿quién soy yo para condenarla?"

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:100 #-#-# translate crowdin gallery_d_086_55f75c6f:
msgid "[_cedrick_] Я тебя понял. Тогда до завтра. Подарок вручишь сама"
msgstr "[_cedrick_] Te entiendo. Luego hasta mañana. Dale un regalo tú mismo"

# game/scripts/quests/questSecretOfTheSilverDragon/pre_visit_the_silver_dragon.rpy:102 #-#-# translate crowdin gallery_d_086_93627fab:
msgid "[_johnlin_] Д-да, я поняла.. До завтра.."
msgstr "[_johnlin_] D-da, entiendo... Hasta mañana..."

