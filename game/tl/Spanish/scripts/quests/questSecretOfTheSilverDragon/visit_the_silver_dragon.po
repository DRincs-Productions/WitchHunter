# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:4 #-#-# translate crowdin visit_the_silver_dragon_ada0e601:
msgid "[_haylin_] Р-рик!? Что ты.."
msgstr "[_haylin_] R-rick!? ¿Qué eres tú...?"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:5 #-#-# translate crowdin visit_the_silver_dragon_8bde9c86:
msgid "[_cedrick_] Я пришел сегодня помочь вам в ресторане. Твоя мама меня попросила"
msgstr "[_cedrick_] He venido a ayudarte en un restaurante hoy. Tu madre me lo pidió"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:9 #-#-# translate crowdin visit_the_silver_dragon_87c5dd71:
msgid "[_haylin_] ..."
msgstr "[_haylin_] ..."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:10 #-#-# translate crowdin visit_the_silver_dragon_e9f06cd3:
msgid "[_cedrick_] И еще я пришел отдать то, что поможет твоей бабушке. Или ты забыла?"
msgstr "[_cedrick_] Y vine a dar lo que ayudará a tu abuela. ¿O lo olvidaste?"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:14 #-#-# translate crowdin visit_the_silver_dragon_6378059a:
msgid "[_haylin_] Нет, не забыла.."
msgstr "[_haylin_] No, no lo he olvidado."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:15 #-#-# translate crowdin visit_the_silver_dragon_bc8d4a1b:
msgid "[_cedrick_] Тогда давай отойдем в твою комнату"
msgstr "[_cedrick_] Entonces vamos a tu habitación"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:19 #-#-# translate crowdin visit_the_silver_dragon_87c5dd71_1:
msgid "[_haylin_] ..."
msgstr "[_haylin_] ..."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:22 #-#-# translate crowdin visit_the_silver_dragon_72358297:
msgid "[_centered_] {size=37}В КОМНАТЕ ХАЙ ЛИН{/size} [withDissolve1]"
msgstr "[_centered_] {size=37}LA HABITACIÓN DE Hay Lin{/size} [withDissolve1]"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:27 #-#-# translate crowdin gallery_d_087_cf555ccd:
msgid "[_haylin_] И что на этот раз ты собрался со мной делать.."
msgstr "[_haylin_] Y qué fue esta vez que vas a hacer conmigo."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:31 #-#-# translate crowdin gallery_d_087_7a7638cd:
msgid "[_cedrick_] Ну, во первых, отдать тебе сосуд с водой из источника.."
msgstr "[_cedrick_] Bueno, en primer lugar, date un recipiente de agua de la fuente."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:35 #-#-# translate crowdin gallery_d_087_079fa205:
msgid "[_haylin_] А во-вторых.."
msgstr "[_haylin_] Y segundo."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:39 #-#-# translate crowdin gallery_d_087_c93d80e0:
msgid "[_cedrick_] Ирма и Тарани ведь просили твоей помощи, когда планировали напасть на меня?"
msgstr "[_cedrick_] ¿Irma y Taranee pidieron tu ayuda cuando planearon atacarme?"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:43 #-#-# translate crowdin gallery_d_087_8d1c0a42:
msgid "[_haylin_] Да, они приходили.."
msgstr "[_haylin_] Sí, vinieron..."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:47 #-#-# translate crowdin gallery_d_087_c820bd37:
msgid "[_cedrick_] И почему ты отказалась?"
msgstr "[_cedrick_] ¿Y por qué te negaste?"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:51 #-#-# translate crowdin gallery_d_087_7fddfd9c:
msgid "[_haylin_] Я.. Вся эта история со стражницами.. Мне так надоела.. Я не просила этой силы, я не хотела, чтобы меня связывало с еще какими-то четырьмя девчонками.."
msgstr "[_haylin_] Yo... Toda esta historia con los guardianas. Estoy tan cansada de... No pedí ese poder, no quería estar atado a otras cuatro chicas."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:52 #-#-# translate crowdin gallery_d_087_c4c95076:
msgid "[_haylin_] Я же их почти не знаю.. По крайней мере далеко не так хорошо, как свою семью.."
msgstr "[_haylin_] Apenas los conozco. Al menos no tan bueno como tu familia."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:56 #-#-# translate crowdin gallery_d_087_afb87ef4:
msgid "[_haylin_] Мама, бабушка, папа - вот что для меня самое важное. Я хочу сберечь свою семью, вот и все.Поэтому.."
msgstr "[_haylin_] Mamá, abuela, papá, eso es lo más importante para mí. Quiero salvar a mi familia, eso es todo."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:57 #-#-# translate crowdin gallery_d_087_fd19c6ec:
msgid "[_haylin_] Поэтому я не хотела идти против тебя.."
msgstr "[_haylin_] Así que no quise ir en contra de ti."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:61 #-#-# translate crowdin gallery_d_087_48575009:
msgid "[_cedrick_] Но ты и не предупредила"
msgstr "[_cedrick_] Pero no te lo advertiste"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:65 #-#-# translate crowdin gallery_d_087_e9b8435b:
msgid "[_haylin_] Не предупредила.."
msgstr "[_haylin_] No advirtió..."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:69 #-#-# translate crowdin gallery_d_087_87c5dd71:
msgid "[_haylin_] ..."
msgstr "[_haylin_] ..."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:73 #-#-# translate crowdin gallery_d_087_e9b8435b_1:
msgid "[_haylin_] Не предупредила.."
msgstr "[_haylin_] No advirtió..."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:77 #-#-# translate crowdin gallery_d_087_8ea922b1:
msgid "[_cedrick_] В любом случае, не могу не восхищаться твоей рациональностью и искреннем желанием сохранить свою семью"
msgstr "[_cedrick_] En cualquier caso, no puedo dejar de admirar tu racionalidad y sincero deseo de salvar a mi familia"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:81 #-#-# translate crowdin gallery_d_087_85525aee:
msgid "[_cedrick_] Они и вправду самое важное"
msgstr "[_cedrick_] Son realmente los más importantes"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:85 #-#-# translate crowdin gallery_d_087_c3f8d9b4:
msgid "[_haylin_] Хватит слов, ты просто пользуешься моим положением.."
msgstr "[_haylin_] Es suficiente palabra, solo usas mi posición."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:86 #-#-# translate crowdin gallery_d_087_5abadbb5:
msgid "[_cedrick_] Все так. А еще, теперь Ирма и Тарани заточены в темнице замка Фобоса. Как и Вилл"
msgstr "[_cedrick_] está bien. Y, sin embargo, ahora Irma y Taranee están encarcelados en la prisión del castillo de Fobos. Como Will"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:90 #-#-# translate crowdin gallery_d_087_62590884:
msgid "[_haylin_] Ч-что.. Н-нет.."
msgstr "[_haylin_] ¿Qué? ¿Qué? No. No."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:91 #-#-# translate crowdin gallery_d_087_5e1736d1:
msgid "[_cedrick_] И кто знает, может, если бы ни твоя трусость, сейчас я был бы повержен"
msgstr "[_cedrick_] ¿Y quién sabe, tal vez si tu cobardía, sería derrotado ahora"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:95 #-#-# translate crowdin gallery_d_087_87c5dd71_1:
msgid "[_haylin_] ..."
msgstr "[_haylin_] ..."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:96 #-#-# translate crowdin gallery_d_087_2a4021d4:
msgid "[_cedrick_] Но ты не помогла им. Потому что семья важнее. Хорошая девочка, Хай Лин"
msgstr "[_cedrick_] Pero no los ayudaste. Porque la familia es más importante. ¡Buena chica, Hay Lin"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:100 #-#-# translate crowdin gallery_d_087_1af5fb72:
msgid "[_haylin_] Я.."
msgstr "[_haylin_] Yo..."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:104 #-#-# translate crowdin gallery_d_087_87c5dd71_2:
msgid "[_haylin_] ..."
msgstr "[_haylin_] ..."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:108 #-#-# translate crowdin gallery_d_087_a2b0980f:
msgid "[_haylin_] Давай просто покончим с этим!"
msgstr "[_haylin_] ¡Acabemos con esto!"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:109 #-#-# translate crowdin gallery_d_087_5b780033:
msgid "[_cedrick_] Да, конечно. Я отдам тебе эссенцию, а потом мы пойдем вместе на рабочую смену в твоем любимом ресторанчике"
msgstr "[_cedrick_] Sí, por supuesto. Te daré la esencia, y luego iremos juntos a un turno de trabajo en tu restaurante favorito"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:113 #-#-# translate crowdin gallery_d_087_87c5dd71_3:
msgid "[_haylin_] ..."
msgstr "[_haylin_] ..."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:117 #-#-# translate crowdin gallery_d_087_81f56208:
msgid "[_cedrick_] Но сначала. Помимо спасительного сосуда для твоей бабушки, я также хочу отдать тебе вот это"
msgstr "[_cedrick_] Pero primero. Además del sillo de vida para tu abuela, también quiero darte esto"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:121 #-#-# translate crowdin gallery_d_087_c2ca7376:
msgid "[_haylin_] Ч-что это?.."
msgstr "[_haylin_] W-¿Qué es?"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:125 #-#-# translate crowdin gallery_d_087_2403f894:
msgid "[_haylin_] Это то, о чем я думаю"
msgstr "[_haylin_] Es lo que estoy pensando"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:126 #-#-# translate crowdin gallery_d_087_e17abf10:
msgid "[_cedrick_] Именно"
msgstr "[_cedrick_] Exacto."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:130 #-#-# translate crowdin gallery_d_087_67a27905:
msgid "[_haylin_] Я не стану вставлять это в себя.."
msgstr "[_haylin_] No lo voy a poner.."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:131 #-#-# translate crowdin gallery_d_087_35b8606c:
msgid "[_cedrick_] Нет станешь. Иначе твоя бабушка долго не протянет, ты же сама прекрасно понимаешь"
msgstr "[_cedrick_] No lo harás. De lo contrario, tu abuela no durará mucho, y tú misma lo sabes bien."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:135 #-#-# translate crowdin gallery_d_087_87c5dd71_4:
msgid "[_haylin_] ..."
msgstr "[_haylin_] ..."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:136 #-#-# translate crowdin gallery_d_087_bc236cd3:
msgid "[_cedrick_] Вставь в себя эту игрушку и мы пойдем работать"
msgstr "[_cedrick_] Inserta este juguete y nos pondremos a trabajar"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:140 #-#-# translate crowdin gallery_d_087_76e18fcb:
msgid "[_haylin_] Зачем тебе все это.."
msgstr "[_haylin_] ¿Por qué necesitas todo esto?"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:141 #-#-# translate crowdin gallery_d_087_53a1947c:
msgid "[_cedrick_] Хах, скоро узнаешь"
msgstr "[_cedrick_] Hach, pronto lo sabrás"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:145 #-#-# translate crowdin gallery_d_087_0fdafe6d:
msgid "[_haylin_] (Лишь бы мои родители ничего не заметили..)"
msgstr "[_haylin_] (Si solo mis padres no han notado nada.)"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:149 #-#-# translate crowdin gallery_d_087_cf23cb85:
msgid "[_haylin_] Хорошо, давай ее сюда"
msgstr "[_haylin_] De acuerdo, déjala aquí"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:155 #-#-# translate crowdin gallery_d_087_4cfc95ba:
msgid "[_centered_] {size=37}Хай Лин вставляет виброяйцо{/size} [withDissolve1]"
msgstr "[_centered_] {size=37}Hay Lin se introduce el huevo vibrador{/size} [withDissolve1]"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:157 #-#-# translate crowdin gallery_d_087_4b5b9ed1:
msgid "[_haylin_] Уххх.. Чувствую, как оно меня заполняет.."
msgstr "[_haylin_] Uh... Siento que me llena..."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:158 #-#-# translate crowdin gallery_d_087_5cdfc00c:
msgid "[_cedrick_] Отлично. Идем"
msgstr "[_cedrick_] es genial. Vamos"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:163 #-#-# translate crowdin gallery_d_087_4cc87b28:
msgid "[_cedrick_] Ах, точно. Совсем забыл"
msgstr "[_cedrick_] Ah, así es. Me olvidé por completo"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:165 #-#-# translate crowdin gallery_d_087_7da9198c:
msgid "[_haylin_] Ч-что ты забыл, Рик?"
msgstr "[_haylin_] C-¿qué has olvidado, Rick?"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:166 #-#-# translate crowdin gallery_d_087_8a543233:
msgid "[_cedrick_] Забыл проверить, работает ли оно"
msgstr "[_cedrick_] Olvidé comprobar si funciona"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:167 #-#-# translate crowdin gallery_d_087_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:175 #-#-# translate crowdin gallery_d_087_bb474eca:
msgid "[_haylin_] Мххх.."
msgstr "[_haylin_] Mxx.."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:176 #-#-# translate crowdin gallery_d_087_4dba01d8:
msgid "[_cedrick_] И как, работает?"
msgstr "[_cedrick_] ¿Y cómo funciona?"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:180 #-#-# translate crowdin gallery_d_087_94955d7f:
msgid "[_haylin_] Д-да.. Оно работает, Р-рик.. М-может перестанешь?"
msgstr "[_haylin_] D-Da... Funciona, R-rick... ¿Puedes detenerlo?"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:181 #-#-# translate crowdin gallery_d_087_8f749e73:
msgid "[_cedrick_] Хах, хорошо, пока выключу"
msgstr "[_cedrick_] Hach, bien mientras me apago"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:190 #-#-# translate crowdin gallery_d_087_fe2d5d6f:
msgid "[_haylin_] Ааааххх.. Р-рик, оно работает.. Работает.. П-перестань.."
msgstr "[_haylin_] Aahhh... R-rick, funciona. Obras. P-parar."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:191 #-#-# translate crowdin gallery_d_087_bcf61b8a:
msgid "[_cedrick_] Хах, ладно, пока что выключу"
msgstr "[_cedrick_] Hach, está bien, hasta ahora me voy a apagar"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:196 #-#-# translate crowdin gallery_d_087_831f996f:
msgid "[_cedrick_] (Пожалуй стоило начать с минимальной мощности)"
msgstr "[_cedrick_] (Tal vez valió la pena comenzar con una potencia mínima)"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:200 #-#-# translate crowdin gallery_d_087_4997d001:
msgid "[_haylin_] (Это было неожиданно..)"
msgstr "[_haylin_] (Fue inesperado.)"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:202 #-#-# translate crowdin gallery_d_087_e62dea8c:
msgid "[_haylin_] (Но он точно не последний раз включает эту штуку.. Нужно начать привыкать..)"
msgstr "[_haylin_] (Pero definitivamente no es la última vez que se ha incluido esta cosa. Tienes que empezar a acostumbrarte a ello.)"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:211 #-#-# translate crowdin gallery_d_087_3e91ecae:
msgid "[_haylin_] Аааааааххх!! Р-рик!! Какого.. К-какого черта ты творишь!!"
msgstr "[_haylin_] Aahhhh!! R-rick!! ¿Qué... ¡¡¿Qué diablos estás haciendo?!"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:215 #-#-# translate crowdin gallery_d_087_486a963e:
msgid "[_haylin_] Я.. Яяяя.. ааааххх.. В-выключи эээту штуку!!"
msgstr "[_haylin_] Yo... Supongo que... Aahhhhhhhh de esta cosa!!"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:216 #-#-# translate crowdin gallery_d_087_4f0972e8:
msgid "[_cedrick_] Ого, так вот какая максимальная мощность"
msgstr "[_cedrick_] Wow, así que esa es la potencia máxima"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:220 #-#-# translate crowdin gallery_d_087_279d2d9d:
msgid "[_haylin_] Аааахх… П-проверил!? А теперь выключи.. В-выключай давай!!"
msgstr "[_haylin_] Aaaah... ¿¡Y-ya lo comprobaste!? Ahora apágalo... ¡A-apágalo de una vez!"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:225 #-#-# translate crowdin gallery_d_087_ac45133c:
msgid "[_cedrick_] (Хах, это было интересно, но пожалуй сразу включать на полную мощность довольно рискованно)"
msgstr "[_cedrick_] (Hah, fue interesante, pero tal vez encender inmediatamente a plena capacidad es bastante arriesgado)"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:234 #-#-# translate crowdin gallery_d_087_c5e6e69e:
msgid "[_johnlin_] О, Рик, ты уже здесь"
msgstr "[_johnlin_] Oh, Rick, estás aquí"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:239 #-#-# translate crowdin gallery_d_087_ace8501e:
msgid "[_chenlin_] Здравствуйте, Рик. Привет, дочка"
msgstr "[_chenlin_] Hola, Rick. Hola, hija"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:248 #-#-# translate crowdin gallery_d_087_5ab120de:
msgid "[_cedrick_] Добрый день, Миссис Джоан, Мистер Чен"
msgstr "[_cedrick_] Buenas tardes, señora. Joan, señor. ¿Chen"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:254 #-#-# translate crowdin gallery_d_087_5eeebcad:
msgid "[_johnlin_] Хай Лин, ты сегодня рано"
msgstr "[_johnlin_] Hay Lin, hoy llegas temprano"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:263 #-#-# translate crowdin gallery_d_087_eb283bd1:
msgid "[_haylin_] Д-да, я пораньше освободилась со школы сегодня.."
msgstr "[_haylin_] D-da, salí de la escuela temprano hoy."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:271 #-#-# translate crowdin gallery_d_087_06aed2c1:
msgid "[_johnlin_] Хм, хорошо. Ну что, Рик, поможешь нам сегодня?"
msgstr "[_johnlin_] Hmm, está bien. Rick, ¿puedes ayudarnos esta noche?"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:279 #-#-# translate crowdin gallery_d_087_cd5b042e:
msgid "[_cedrick_] С большим удовольствием, миссис Джоан"
msgstr "[_cedrick_] Con mucho gusto, la señora. ¿Joan"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:286 #-#-# translate crowdin gallery_d_087_312d8b92:
msgid "[_johnlin_] Ахах, не называй меня так, у нас не такая уж и большая разница в возрасте. Можешь просто Джоан"
msgstr "[_johnlin_] Jajaja, no me llames así; no nos llevamos tantos años. Puedes llamarme Joan."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:295 #-#-# translate crowdin gallery_d_087_47c15fea:
msgid "[_cedrick_] Хорошо, Джоан"
msgstr "[_cedrick_]H Bien, Joan"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:303 #-#-# translate crowdin gallery_d_087_65577a18:
msgid "[_johnlin_] (Такой учтивый, когда мы разговариваем при моем муже с дочкой. Так сразу и не подумаешь, насколько жестким он может быть в постели..)"
msgstr "[_johnlin_] (Tan cortés cuando hablamos con mi esposo y mi hija. Así que inmediatamente no pensarás en lo mucho que puede estar en la cama.)"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:311 #-#-# translate crowdin gallery_d_087_d7f36525:
msgid "[_haylin_] Д-давайте уже начнем обслуживать гостей.."
msgstr "[_haylin_] D-d-d-d-daway comenzará a servir a los huéspedes."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:312 #-#-# translate crowdin gallery_d_087_045eff6a:
msgid "[_cedrick_] Да, конечно"
msgstr "[_cedrick_] Sí sí, por supuesto"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:320 #-#-# translate crowdin gallery_d_087_cb0a8b52:
msgid "[_johnlin_] И так, Рик, для начала можешь постоять на кассе. Думаю с этим ты отлично справишься, все же у тебя свой магазин"
msgstr "[_johnlin_] Y así, Rick, puedes pararte en la taquilla para empezar. Creo que lo harás muy bien, todavía tienes tu propia tienda"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:328 #-#-# translate crowdin gallery_d_087_315c4cc3:
msgid "[_cedrick_] Как скажете, Джоан"
msgstr "[_cedrick_] Cómo dices, Joan"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:336 #-#-# translate crowdin gallery_d_087_f4666174:
msgid "[_johnlin_] Хай Лин, ты пока принимаешь заказы. Я буду относить еду гостям. Чен, ты на кухне"
msgstr "[_johnlin_] Hay Lin, estás tomando órdenes por ahora. Llevaré la comida a los invitados. Chen, estás en la cocina"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:345 #-#-# translate crowdin gallery_d_087_02b8b7df:
msgid "[_chenlin_] Хорошо, дорогая"
msgstr "[_chenlin_] Bueno, querida"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:353 #-#-# translate crowdin minigame_3_43592652:
msgid "[_johnlin_] И так, все за работу!"
msgstr "[_johnlin_] ¡Y así, todo por el trabajo!"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:355 #-#-# translate crowdin minigame_3_91b58356:
msgid "[_cedrick_] (Хм, нужно быть аккуратным при использовании виброяйца)"
msgstr "[_cedrick_] (Hmm, debe tener cuidado al usar una dama vibratoria)"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:356 #-#-# translate crowdin minigame_3_856ffef8:
msgid "[_cedrick_] (Если Джоан заметит, думаю особых проблем не будет, но нельзя, чтобы гости что-то заподозрили)"
msgstr "[_cedrick_] (Si Joan se da cuenta, no creo que haya ningún problema especial, pero no se puede hacer que los invitados sospechen nada)"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:357 #-#-# translate crowdin minigame_3_c179811b:
msgid "[_cedrick_] (Я должен слегка развратить Хай Лин перед финальным ужином, но нужно знать меру)"
msgstr "[_cedrick_] (tengo que acostarme un poco antes de la cena final, pero necesitas saber la medida)"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:361 #-#-# translate crowdin minigame_3_d077a124:
msgid "[_haylin_] Добрый день, что будете заказывать?"
msgstr "[_haylin_] Buenas tardes, ¿qué pedirá?"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:362 #-#-# translate crowdin minigame_3_2bce89b8:
msgid "[_restaurant_goer_1_] Мне, пожалуйста, салат из овощей с имбирно-чесночным соусом иии.."
msgstr "[_restaurant_goer_1_] Por favor, por favor, ensalada de verduras con salsa de jengibre-granate.."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:363 #-#-# translate crowdin minigame_3_fd3d13d2:
msgid "[_restaurant_goer_1_] Хм, апельсиновый сок, пожалуйста"
msgstr "[_restaurant_goer_1_] Hm, jugo de naranja, por favor"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:365 #-#-# translate crowdin minigame_3_8edf6075:
msgid "[_haylin_] У нас, к сожалению, остался только яблочный"
msgstr "[_haylin_] Tenemos, por desgracia, solo manzana"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:366 #-#-# translate crowdin minigame_3_b0ee6447:
msgid "[_restaurant_goer_1_] Жаль.. Ну тогда давайте яблочный"
msgstr "[_restaurant_goer_1_] Es una pena.. Bueno, entonces, da la manzana"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:368 #-#-# translate crowdin minigame_3_29ba17bc:
msgid "[_haylin_] Хорошо, а вы что желаете?"
msgstr "[_haylin_] Bien, ¿qué quieres?"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:370 #-#-# translate crowdin minigame_3_c3fba66e:
msgid "[_restaurant_goer_2_] Мне два номера девять.."
msgstr "[_restaurant_goer_2_] Soy dos habitaciones nueve.."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:372 #-#-# translate crowdin minigame_3_c234c28f:
msgid "[_restaurant_goer_2_] Номер девять большой.."
msgstr "[_restaurant_goer_2_] Número nueve grande..."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:374 #-#-# translate crowdin minigame_3_ddbcc05a:
msgid "[_restaurant_goer_2_] Номер шесть с дополнительным соусом.."
msgstr "[_restaurant_goer_2_] Número seis con salsa extra."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:375 #-#-# translate crowdin minigame_3_79e224e1:
msgid "[_restaurant_goer_2_] Номер семь, два номера сорок пятый.."
msgstr "[_restaurant_goer_2_] Número siete, dos habitaciones cuadragésima quinta."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:377 #-#-# translate crowdin minigame_3_1f0f8586:
msgid "[_restaurant_goer_2_] Один с сыром и большую содовую.."
msgstr "[_restaurant_goer_2_] Solitario con queso y soda grande..."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:384 #-#-# translate crowdin minigame_3_0617848c:
msgid "[_haylin_] Эм.. Кхм.."
msgstr "[_haylin_] Mm. Khm."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:386 #-#-# translate crowdin minigame_3_4bec08c4:
msgid "[_haylin_] Я.. Я уточню, есть ли у нас все ингридиенты на кухне.."
msgstr "[_haylin_] Yo... Te diré si tenemos todos los ingredientes de la cocina."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:388 #-#-# translate crowdin minigame_3_21564680:
msgid "[_haylin_] Ух.."
msgstr "[_haylin_] Uh..."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:389 #-#-# translate crowdin minigame_3_13abd3d9:
msgid "[_restaurant_goer_2_] Хорошо, но не заставляйте меня сильно ждать, я голоден"
msgstr "[_restaurant_goer_2_]H Es bueno, pero no me hagas esperar mucho, tengo hambre"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:391 #-#-# translate crowdin minigame_3_cc720990:
msgid "[_haylin_] Х-хорошо, сэр"
msgstr "[_haylin_] Muy bien, señor"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:393 #-#-# translate crowdin minigame_3_dda9251b:
msgid "[_haylin_] (Эта штука так неожиданно заработала.. ух, хорошо, что мощность была не такой большой..)"
msgstr "[_haylin_] (Esta cosa funcionó tan inesperadamente... Vaya, es bueno que el poder no fuera tan grande.)"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:400 #-#-# translate crowdin minigame_3_9d9eac7c:
msgid "[_haylin_] А-аах.. Уф.."
msgstr "[_haylin_] A-aah... Uf."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:401 #-#-# translate crowdin minigame_3_b2b33996:
msgid "[_restaurant_goer_1_] С вами все впорядке?"
msgstr "[_restaurant_goer_1_] ¿Está bien contigo?"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:403 #-#-# translate crowdin minigame_3_5dc6ae7d:
msgid "[_haylin_] Ух.. Д-да, просто я не уверена, что в-все ингредиенты сейчас доступны.."
msgstr "[_haylin_] Uh... Sí, no estoy seguro de si todos los ingredientes están disponibles."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:405 #-#-# translate crowdin minigame_3_9c9d173b:
msgid "[_restaurant_goer_2_] Ох, ну тогда уточните узнайте и возвращайтесь"
msgstr "[_restaurant_goer_2_] Oh, bueno, entonces echa un vistazo y vuelve"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:407 #-#-# translate crowdin minigame_3_2591a4e4:
msgid "[_haylin_] Д-да, я спрошу у повара.."
msgstr "[_haylin_] S-sí, le preguntaré al cocinero..."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:409 #-#-# translate crowdin minigame_3_95120a82:
msgid "[_restaurant_goer_2_] Хорошо. И можно быстрее? Я с самого утра не ел"
msgstr "[_restaurant_goer_2_] es bueno. ¿Y tal vez más rápido? No he comido desde la mañana"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:410 #-#-# translate crowdin minigame_3_7f80ca7d:
msgid "[_restaurant_goer_1_] Дорогой, но сейчас все еще утро.."
msgstr "[_restaurant_goer_1_] Querida, pero todavía es por la mañana."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:412 #-#-# translate crowdin minigame_3_de33a449:
msgid "[_restaurant_goer_2_] К этому времени я уже завтракаю второй раз"
msgstr "[_restaurant_goer_2_] En este momento desayuno por segunda vez"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:414 #-#-# translate crowdin minigame_3_96f3a9e3:
msgid "[_restaurant_goer_1_] И-и то верно.."
msgstr "[_restaurant_goer_1_] Y así es.."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:415 #-#-# translate crowdin minigame_3_b5cac010:
msgid "[_haylin_] (Ух, Рик, мог бы быть и помягче.. Включил ее прямо во время разговора с гостями..)"
msgstr "[_haylin_] (Wow, Rick, podría ser más suave.. Lo encendió durante una conversación con los invitados.)"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:416 #-#-# translate crowdin minigame_3_62f3c6b3:
msgid "[_haylin_] (Ч-что, если бы они заметили..)"
msgstr "[_haylin_] (H-¿qué pasa si se dan cuenta...)"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:424 #-#-# translate crowdin minigame_3_cb04ee61:
msgid "[_haylin_] А-аааххх!!"
msgstr "[_haylin_] A-aahakhh!!"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:425 #-#-# translate crowdin minigame_3_7899511b:
msgid "[_restaurant_goer_1_] Ч-что с вами!?"
msgstr "[_restaurant_goer_1_] W-¿¡Qué te pasa!?"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:427 #-#-# translate crowdin minigame_3_ae321fb3:
msgid "[_haylin_] Я.. Кхм.. Яяя просто вспомнила, что у нас не осталось ингредиентов для.. аахх.. н-номера пять.."
msgstr "[_haylin_] Yo... Ejem... S-solo recordé que ya no nos quedan ingredientes para... aaah... el n-número cinco..."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:429 #-#-# translate crowdin minigame_3_7b5fef3b:
msgid "[_restaurant_goer_2_] Ох, ну.. эм.. вы так не расстраивайтесь.. мы можем заказать что-нибудь еще"
msgstr "[_restaurant_goer_2_] Oh, bueno... Um. No estás tan molesto... Podemos pedir otra cosa"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:431 #-#-# translate crowdin minigame_3_dccbe00f:
msgid "[_haylin_] Х-хорошо.. Ух.. Тогда я подойду чуть позже.."
msgstr "[_haylin_] Muy bien. Uh... Entonces estaré allí más tarde..."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:433 #-#-# translate crowdin minigame_3_4c05b6f7:
msgid "[_haylin_] (Р-рик, какого черта.. т-такой резкий и мощный импульс, он его на максимум что-ли включил..)"
msgstr "[_haylin_] (R-Rick, ¿qué demonios...? E-ese impulso tan brusco y potente... ¿lo puso al máximo?)"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:434 #-#-# translate crowdin minigame_3_375507c7:
msgid "[_haylin_] (Если так продолжится, клиенты могут что-нибудь заподозрить.. или того хуже, мои родители начнут что-то подозревать..)"
msgstr "[_haylin_] (Si esto continúa, los clientes pueden sospechar cualquier cosa. O peor aún, mis padres empezarán a sospechar algo.)"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:441 #-#-# translate crowdin minigame_3_7e4c255e:
msgid "[_centered_] {size=37}Седрик все оставшееся утро простоял за прилавком{/size} [withDissolve1]"
msgstr "[_centered_] {size=37}Cedric toda la mañana restante se paró detrás del mostrador{/size} [withDissolve1]"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:445 #-#-# translate crowdin minigame_3_debe30c7:
msgid "[_chenlin_] Рик, ну как ты тут, справляешься?"
msgstr "[_chenlin_] Rick, ¿cómo estás aquí, de acuerdo?"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:449 #-#-# translate crowdin minigame_3_34d09eea:
msgid "[_cedrick_] Да, все отлично, Мистер Чен"
msgstr "[_cedrick_] Sí, todo es genial, Sr. ¿Chen"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:450 #-#-# translate crowdin minigame_3_0cddbe11:
msgid "[_cedrick_] За кассой куда проще следить, когда всякая мелюзга не пытается украсть у тебя книги каждые пять секунд.."
msgstr "[_cedrick_] En la taquilla es mucho más fácil de ver cuando cualquier meluzzo no intenta robar sus libros cada cinco segundos."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:454 #-#-# translate crowdin minigame_3_cc85d877:
msgid "[_chenlin_] Хах, вижу это наболевшее.."
msgstr "[_chenlin_] Hah, veo esto doloroso..."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:458 #-#-# translate crowdin minigame_3_85f3fc32:
msgid "[_cedrick_] Вы даже не представляете. Иногда за восьмичасовой рабочий день мне приходится наставлять на людей дробовик раз по десять"
msgstr "[_cedrick_] No tienes ni idea. A veces, en una jornada laboral de ocho horas, tengo que instruir a la gente una escopeta diez veces"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:462 #-#-# translate crowdin minigame_3_0f53a261:
msgid "[_chenlin_] Оу, как.. Кхм, как интересно.. Надеюсь тебе не придется делать подобное в нашем ресторане, ахахах.."
msgstr "[_chenlin_] Oh... Ejem, qué interesante... Espero que no tengas que hacer algo así en nuestro restaurante, jajaja..."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:466 #-#-# translate crowdin minigame_3_0eff90f9:
msgid "[_cedrick_] Да, я тоже надеюсь.."
msgstr "[_cedrick_]Y Sí, espero que también."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:470 #-#-# translate crowdin minigame_3_1cbb1bc3:
msgid "[_chenlin_] Кхм.. эм.. Давай днем Хай Лин подменит тебя за прилавком. А ты поможешь мне на кухне. Х-хорошо?"
msgstr "[_chenlin_] Khm.. Um. Tomemos el día de Hay Lin para reemplazarte con un mostrador. Y me ayudarás en la cocina. ¿Eso es bueno?"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:474 #-#-# translate crowdin minigame_3_ff17d692:
msgid "[_cedrick_] Да, почему бы и нет. С ножами я тоже умею обращаться"
msgstr "[_cedrick_] Sí, ¿por qué no? Con cuchillos también sé cómo manejar"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:478 #-#-# translate crowdin minigame_3_3a8e87b6:
msgid "[_chenlin_] Эм, я о них ничего и не говорил.. Думал ты поможешь мне растягивать лапшу или напитать рис бульоном.."
msgstr "[_chenlin_] M, no dije nada sobre ellos. Pensaste que podrías ayudarme a estirar los fideos o alimentar el arroz con un caldo."

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:482 #-#-# translate crowdin minigame_3_81e1aa8f:
msgid "[_cedrick_] А, да, точно. Хаха, простите, Чен, я на своей кухне в основном только ножами и орудую"
msgstr "[_cedrick_] A, sí, es cierto. Jaja, lo siento, Chen, estoy en mi cocina con cuchillos y estoy tan descansando"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:486 #-#-# translate crowdin minigame_3_561dcd4c:
msgid "[_chenlin_] Я тебя понял.. Ну хорошо, можешь взять на себя нарезку"
msgstr "[_chenlin_] Te entiendo. Bueno, bueno, puedes tomar el corte"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:490 #-#-# translate crowdin minigame_3_ef8e1f0b:
msgid "[_cedrick_] Как скажете так и будет, в конце концов это ваша кухня и ваш ресторан"
msgstr "[_cedrick_] Cómo lo dices y serás, al final es tu cocina y tu restaurante"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:494 #-#-# translate crowdin minigame_3_27a17bff:
msgid "[_chenlin_] Да, давай лучше будем использовать твои сильные стороны"
msgstr "[_chenlin_]Y Sí, seamos mejores para usar tus fortalezas"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:498 #-#-# translate crowdin minigame_3_69a06f42:
msgid "[_chenlin_] (Чем больше узнаю об этом Рике, тем более опасным типом он мне кажется.. Наставлять дробовик на людей, жуть..)"
msgstr "[_chenlin_] (Cuanto más conozco a Rick, más peligroso me parece. Instruir la escopeta sobre la gente, el horror.)"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:499 #-#-# translate crowdin minigame_3_1084a21c:
msgid "[_chenlin_] (Надеюсь моя Хай Лин не будет водиться с подобными парнями..)"
msgstr "[_chenlin_] (Espero que mi Hay Lin no esté con tales tipos.)"

# game/scripts/quests/questSecretOfTheSilverDragon/visit_the_silver_dragon.rpy:500 #-#-# translate crowdin minigame_3_8afc36ea:
msgid "[_chenlin_] (Хотя, если ее вкус к парням такой же, как у ее матери в том же возрасте.. Боже, боюсь даже представить..)"
