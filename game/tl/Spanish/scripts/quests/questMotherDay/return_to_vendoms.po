# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1448 #-#-# translate crowdin gallery_d_107_73e58986:
msgid "[_cedrick_] (Черт, точно… Я ведь тогда трахал ее в зад в облике Тома, отца Ирмы…)"
msgstr "[_cedrick_] (Maldita sea, seguro... Luego la follé en el culo con la apariencia de Tom, el padre de Irma...)"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1450 #-#-# translate crowdin gallery_d_107_539b69c9:
