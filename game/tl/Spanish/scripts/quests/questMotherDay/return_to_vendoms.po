# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1743 #-#-# translate crowdin gallery_d_108_f2ffcd1a:
msgid "[_will_] Я же говорила ему понравится!"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1745 #-#-# translate crowdin gallery_d_108_48e44ddd:
msgid "[_susan_] Ох, Рик, ты такая прелесть"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1748 #-#-# translate crowdin gallery_d_108_326a2baa:
msgid "Теперь Рик может приходить домой в дом Семьи Вандом в любое время"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1750 #-#-# translate crowdin gallery_d_108_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1752 #-#-# translate crowdin gallery_d_108_f8a5bc5f:
msgid "[_cedrick_] Я даже не знаю, что сказать.."
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1754 #-#-# translate crowdin gallery_d_108_10b2d9f0:
msgid "[_cedrick_] Поэтому.. Эм.. Сьюзан, у меня тоже есть для тебя кое-какой подарок"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1756 #-#-# translate crowdin gallery_d_108_57dd9764:
msgid "[_susan_] Ох, правда? И что же это"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1758 #-#-# translate crowdin gallery_d_108_3c31af0f:
msgid "[_cedrick_] Вот"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1760 #-#-# translate crowdin gallery_d_108_5453ada5:
msgid "[_susan_] Это… Эм… Ого… Это же"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1762 #-#-# translate crowdin gallery_d_108_b8568a1a:
msgid "[_will_] Эротическое нижнее белье.."
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1764 #-#-# translate crowdin gallery_d_108_a7732568:
msgid "[_susan_] Эм.. Ахах.. Это очень приятно, Рик, за это мы тебя тоже очень ценим, но.. Кхм, думаю мы с этим разберемся у нас в комнате, когда Вилл уже уйдет спать"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1766 #-#-# translate crowdin gallery_d_108_3223fe77:
msgid "[_will_] Ну конечно.."
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1767 #-#-# translate crowdin gallery_d_108_a49239a3:
msgid "[_susan_] (Так и думала, что ее это заденет.. Нужно как-то сменить тему)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1769 #-#-# translate crowdin gallery_d_108_2036bb23:
msgid "[_susan_] Ох, точно, Вилл! Мой для тебя подарок. Вот"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1771 #-#-# translate crowdin gallery_d_108_dbb5f7c5:
msgid "[_will_] Ого.. Это.. Это приставка?"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1773 #-#-# translate crowdin gallery_d_108_e1b3e610:
msgid "[_susan_] Да, я помню, в детстве ты любила играть в такие игры. Могла весь день за ними провести"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1774 #-#-# translate crowdin gallery_d_108_66bcbfc2:
msgid "[_susan_] Потом ты занялась плаванием и забросила такие игры. Но я недавно ходила по супермаркету и решила, ну…"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1775 #-#-# translate crowdin gallery_d_108_afc46f8e:
msgid "[_susan_] Почему бы не купить тебе что-то новое, чтобы напомнить о старых прелестях жизни"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1777 #-#-# translate crowdin gallery_d_108_f08aa4f6:
msgid "[_will_] Ох, мам, спасибо… Это мило…"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1779 #-#-# translate crowdin gallery_d_108_f149b4d0:
msgid "[_will_] Да, я помню как в детстве играла в похожую приставку. Тогда у нас был такой толстый, почти квадратный телевизор"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1781 #-#-# translate crowdin gallery_d_108_c88c96b7:
msgid "[_susan_] Хах, да, он был таким тяжелым. Я иногда боялась, как бы он не упал и не придавил тебя, пока ты играешь"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1783 #-#-# translate crowdin gallery_d_108_1e9e1ffa:
msgid "[_will_] Хах, да, он был монструозный и старый. Толстый ламповый телевизор, за которым я провела тогда немало времени.."
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1785 #-#-# translate crowdin gallery_d_108_741fcc2c:
msgid "[_will_] Эх, обожала тогда играть на нем в приставку, смотреть всякие мультики и другую фигню"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1786 #-#-# translate crowdin gallery_d_108_e6828cda:
msgid "[_cedrick_] (Толстый.. Ламповый.. телевизор.. Смотреть всякую фигню…)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1787 #-#-# translate crowdin gallery_d_108_99e75483:
msgid "[_cedrick_] (Черт, Элион же притащила такой вчера! Я обещал ей сегодня посмотреть с ней всякие шоу на этом допотопном телевизоре)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1789 #-#-# translate crowdin gallery_d_108_16b0a7f8:
msgid "[_susan_] Рик, все хорошо?"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1791 #-#-# translate crowdin gallery_d_108_5b8edf2d:
msgid "[_cedrick_] Эм.. Я вдруг резко понял, что мне пора бежать. У меня, эм.. У меня есть незаконченное дело в магазине"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1793 #-#-# translate crowdin gallery_d_108_3c4a3ce0:
msgid "[_susan_] Ох, но как же.."
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1795 #-#-# translate crowdin gallery_d_108_cfdebe21:
msgid "[_cedrick_] Я вернусь, Сьюзан. Поздно ночью, но вернусь. Можешь подождать меня в комнате сама знаешь с чем"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1797 #-#-# translate crowdin gallery_d_108_8923f747:
msgid "[_susan_] Ох, я поняла.. Тогда, эм.. Тогда пойду пока примерю это кое-что"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1799 #-#-# translate crowdin gallery_d_108_1240d977:
msgid "[_will_] Боже, да я ведь уже знаю, что вы про белье. Вам не нужно передо мной секретничать, я ж даже видела, как вы двое трахаетесь"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1801 #-#-# translate crowdin gallery_d_108_3437a2d8:
msgid "[_susan_] Ох, Вилл.."
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1803 #-#-# translate crowdin gallery_d_108_52ed6982:
msgid "[_cedrick_] Я побегу"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1805 #-#-# translate crowdin gallery_d_108_63cc0b3d:
msgid "[_will_] Я провожу тебя, Рик"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1810 #-#-# translate crowdin gallery_d_108_894efe44:
msgid "[_will_] Рик, что-то серьезное? Мамы рядом нет. Если что, ты можешь сказать"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1814 #-#-# translate crowdin gallery_d_108_e116e1df:
msgid "[_cedrick_] Эм, нет, ничего катастрофического, я справлюсь"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1818 #-#-# translate crowdin gallery_d_108_08e0fe90:
msgid "[_will_] Хорошо. Но если что, я готова помочь. Только скажи"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1822 #-#-# translate crowdin gallery_d_108_87cc3834:
msgid "[_cedrick_] Хм…"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1823 #-#-# translate crowdin gallery_d_108_a028cfec:
msgid "[_cedrick_] (Мне нужно веская причина, по которой я так задержался)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1824 #-#-# translate crowdin gallery_d_108_807dd1a6:
msgid "[_cedrick_] Эм, вообще-то, ты можешь помочь. Не одолжишь мне ту приставку, что тебе подарила Сьюзан?"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1828 #-#-# translate crowdin gallery_d_108_6ed4af4d:
msgid "[_will_] Эм.."
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1829 #-#-# translate crowdin gallery_d_108_be84c09d:
msgid "[_cedrick_] Это важно"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1833 #-#-# translate crowdin gallery_d_108_1dabe189:
msgid "[_will_] Ну.. Хорошо, Рик. Бери"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1837 #-#-# translate crowdin gallery_d_108_807705d6:
msgid "[_cedrick_] Спасибо. Я побежал"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1841 #-#-# translate crowdin gallery_d_108_eb5a7421:
msgid "[_will_] У-удачи!"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1843 #-#-# translate crowdin gallery_d_108_99aabdc4:
msgid "[_cedrick_] (Теперь нужно отправиться в книжный)"
msgstr ""

