msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:354 #-#-# translate crowdin gallery_d_104_ad71c591:
msgid "[_laurent_] Бля, для учителя истории он чертовски быстро бегает"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:355 #-#-# translate crowdin gallery_d_104_de21d019:
