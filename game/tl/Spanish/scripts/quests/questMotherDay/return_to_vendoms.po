# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1266 #-#-# translate crowdin gallery_d_107_811347de:
msgid "[_uria_] А я говорил вам, идиоты. Весь интерес фоткать голых девок в том, что они на это не соглашались"
msgstr "[_uria_] Te lo dije, idiotas. Todo el interés de fotografiar a las chicas desnudas es que no estaban de acuerdo con esto"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1270 #-#-# translate crowdin gallery_d_107_7fdb7c56:
