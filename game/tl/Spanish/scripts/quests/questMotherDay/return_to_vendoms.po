# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/questMotherDay/return_to_vendoms.rpy:7 #-#-# translate crowdin return_to_vendoms_7b901386:
msgid "[_susan_] Ну что, все готовы?"
msgstr "[_susan_] ¿Están todos listos?"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:16 #-#-# translate crowdin return_to_vendoms_41a3708d:
msgid "[_will_] Да! У меня как раз все готово"
msgstr "[_will_] ¡Sí! Lo tengo todo listo"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:22 #-#-# translate crowdin return_to_vendoms_6a2a11fc:
msgid "[_cedrick_] Я тоже уже готов"
msgstr "[_cedrick_] Yo también estoy listo"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:28 #-#-# translate crowdin return_to_vendoms_0fa51dba:
msgid "[_susan_] Отлично. Тогда все в машину и на пляж!!"
msgstr "[_susan_] ¡Genial! ¡Entonces suban al coche y a la playa!!"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:33 #-#-# translate crowdin return_to_vendoms_55c38cf2:
msgid "[_will_] Дааа!"
msgstr "[_will_] ¡Sí!"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:34 #-#-# translate crowdin return_to_vendoms_0c62d75e:
msgid "[_cedrick_] (Хах, Вилл явно в приподнятом настроении. Интересно, это она правда так искренне рада празднику?)"
msgstr "[_cedrick_] (Ja, Will está claramente de muy buen humor. Me pregunto si de verdad está tan emocionada por las vacaciones)"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:35 #-#-# translate crowdin return_to_vendoms_54a9906c:
msgid "[_cedrick_] (Или же есть другая причина для радости)"
msgstr "[_cedrick_] (¿O existe otro motivo para alegrarse?)"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:38 #-#-# translate crowdin return_to_vendoms_151531fc:
msgid "[_centered_] {size=37}Седрик, Сьюзан и Вилл едут на пляж{/size}"
msgstr "[_centered_] {size=37}Cedric, Susan y Will van a la playa{/size}"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:40 #-#-# translate crowdin return_to_vendoms_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:41 #-#-# translate crowdin return_to_vendoms_5f9b772e:
msgid "...."
msgstr "...."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:42 #-#-# translate crowdin return_to_vendoms_0fd4d656:
msgid "......"
msgstr "......"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:51 #-#-# translate crowdin return_to_vendoms_cb16a2d8:
msgid "[_susan_] Так, вот мы и здесь"
msgstr "[_susan_] Así que, aquí estamos"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:57 #-#-# translate crowdin return_to_vendoms_4ddd357a:
msgid "[_cedrick_] Какой свежий морской воздух..."
msgstr "[_cedrick_] Qué aire fresco del mar..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:61 #-#-# translate crowdin return_to_vendoms_5f8b8763:
msgid "[_susan_] Ох, точно, Рик, ты же впервые на пляже. И как тебе?"
msgstr "[_susan_] Ah, cierto, Rick, esta es tu primera vez en la playa. ¿Qué te parece?"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:65 #-#-# translate crowdin return_to_vendoms_92b83e91:
msgid "[_cedrick_] Интересно... Но думаю я сложу свое мнение ближе к концу мероприятия"
msgstr "[_cedrick_] Interesante... Pero creo que formaré mi opinión más cerca del final del evento"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:69 #-#-# translate crowdin return_to_vendoms_c5862961:
msgid "[_susan_] Хах, поняла тебя. Ну что, Вилл, пойдем переодеваться?"
msgstr "[_susan_] Jaja, ya entiendo. Bueno, Will, ¿vamos a cambiarnos?"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:73 #-#-# translate crowdin return_to_vendoms_fc608b5f:
msgid "[_will_] Д-да, точно. Пошли"
msgstr "[_will_] S-si, claro. Vamos"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:78 #-#-# translate crowdin return_to_vendoms_112ba739:
msgid "[_centered_] {size=37}Спустя немного времени{/size}"
msgstr "[_centered_] {size=37}Después de un rato{/size}"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:83 #-#-# translate crowdin return_to_vendoms_6b9432ea:
msgid "[_susan_] Что, серьезно? Тут все кабинки для переодевания сломаны!?"
msgstr "[_susan_] ¿En serio? ¿Están todos los vestuarios rotos aquí!?"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:91 #-#-# translate crowdin return_to_vendoms_17c2faad:
msgid "[_will_] Думаю это Урия с его шайкой постарались. Слышала они тут недалеко прячутся и фоткают девушек, пока те переодеваются"
msgstr "[_will_] Creo que fueron Uriah y su pandilla quienes hicieron esto. Oí que se esconden cerca y les toman fotos a las chicas mientras se cambian"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:97 #-#-# translate crowdin return_to_vendoms_b7608967:
msgid "[_susan_] К-какой кошмар... Ну и молодежь нынче пошла..."
msgstr "[_susan_] ¡Qué pesadilla! ¿Qué clase de jóvenes hay hoy en día..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:101 #-#-# translate crowdin return_to_vendoms_e16c490f:
msgid "[_susan_] (Хотя, не то чтобы в мое время парни этим не занимались... За мной и самой помню подглядывали...)"
msgstr "[_susan_] (Aunque, no es que los chicos no hicieran eso en mi época... Recuerdo que también me espiaban...)"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:105 #-#-# translate crowdin return_to_vendoms_4bb05df1:
msgid "[_will_] Хм... Мы можем переодеваться в разных местах, чтобы они не смогли заснять нас всех разом"
msgstr "[_will_] Mmm... Podemos cambiarnos de ropa en diferentes lugares para que no nos filmen a todos a la vez"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:109 #-#-# translate crowdin return_to_vendoms_97db0a23:
msgid "[_will_] По-отдельности думаю они растеряются..."
msgstr "[_will_] Individualmente, creo que estarían confundidos..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:115 #-#-# translate crowdin return_to_vendoms_ecfa9092:
msgid "[_cedrick_] Я бы лучше прикрыл вас, пока вы переодеваетесь"
msgstr "[_cedrick_] Prefiero cubrirte mientras te cambias"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:121 #-#-# translate crowdin return_to_vendoms_8d5555d5:
msgid "[_susan_] Ты можешь прикрыть Вилл, пока я переодеваюсь в более укромном месте, Рик. Думаю так будет правильнее"
msgstr "[_susan_] Puedes cubrir a Will mientras me cambio a un lugar más privado, Rick. Creo que sería lo mejor"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:127 #-#-# translate crowdin return_to_vendoms_932dfbb7:
msgid "[_will_] Э-эм... Н-нет, подожди, п-пускай лучше он прикрывает тебя. С Урией я в одной школе учусь, так что если что задам ему трепку потом"
msgstr "[_will_] Eh... N-no, espera, prefiero que él te cubra. Voy a la misma escuela que Uriah, así que si pasa algo, le daré una buena reprimenda después"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:133 #-#-# translate crowdin return_to_vendoms_d2cefb05:
msgid "[_susan_] Ну не знаю... Рик, что думаешь?"
msgstr "[_susan_] Bueno, no lo sé... Rick, ¿qué piensas?"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:134 #-#-# translate crowdin return_to_vendoms_1045b5e1:
msgid "[_cedrick_] Хм..."
msgstr "[_cedrick_] Um..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:137 #-#-# translate crowdin return_to_vendoms_746ffe8e:
msgid "[_cedrick_] Думаю Сьюзан права, Вилл. Она взрослая женщина и не нуждается в защите от школьных хулиганов"
msgstr "[_cedrick_] Creo que Susan tiene razón, Will. Es una mujer adulta y no necesita protección contra los acosadores escolares"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:141 #-#-# translate crowdin return_to_vendoms_25e9f6d8:
msgid "[_will_] Н-но..."
msgstr "[_will_] P-pero..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:142 #-#-# translate crowdin return_to_vendoms_d05565bc:
msgid "[_cedrick_] А вот ты потенциально можешь стать объектом для буллинга в школе. Поверь, не важно на сколько стальной у тебя характер. Буллинг может надломить каждого..."
msgstr "[_cedrick_] Pero podrías convertirte en víctima de acoso escolar. Créeme, no importa cuán fuerte sea tu carácter. El acoso puede destrozar a cualquiera..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:148 #-#-# translate crowdin return_to_vendoms_c3fa9b59:
msgid "[_will_] Ух... Л-ладно, как хочешь"
msgstr "[_will_] Eh... B-bueno, como desees"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:154 #-#-# translate crowdin return_to_vendoms_83702155:
msgid "[_susan_] Хорошо. Тогда увидимся у лежаков, когда переоденемся"
msgstr "[_susan_] De acuerdo. Entonces nos vemos en las tumbonas cuando nos hayamos cambiado"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:158 #-#-# translate crowdin return_to_vendoms_ff042b3a:
msgid "[_will_] (Блин, я хотела, чтобы Рик все увидел неожиданно. А теперь из-за этого гребаного Урии сюрприза не получится...)"
msgstr "[_will_] (Maldita sea, quería que Rick lo viera todo por sorpresa. Y ahora, por culpa de ese maldito Uriah, no habrá sorpresa...)"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:162 #-#-# translate crowdin return_to_vendoms_42a3c7dd:
msgid "[_centered_] {size=37}Вилл идет переодеваться, Седрик прикрывает ее{/size}"
msgstr "[_centered_] {size=37}Will va a cambiarse, Cedric la cubre{/size}"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:168 #-#-# translate crowdin return_to_vendoms_4cfc9464:
msgid "[_cedrick_] Думаю Вилл права, Сьюзан"
msgstr "[_cedrick_] Creo que Will tiene razón, Susan"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:169 #-#-# translate crowdin return_to_vendoms_949f8c40:
msgid "[_cedrick_] С Урией я могу и в школе разобраться, особенно если это коснется Вилл.."
msgstr "[_cedrick_] Puedo lidiar con Uriah en la escuela, especialmente si se trata de Will.."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:170 #-#-# translate crowdin return_to_vendoms_b59e9fd1:
msgid "[_cedrick_] Но вот в твоем случае, тут моя компетенция заканчивается"
msgstr "[_cedrick_] Pero en su caso, ahí termina mi competencia"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:171 #-#-# translate crowdin return_to_vendoms_e2cc3bbc:
msgid "[_cedrick_] А что будет, если твои обнаженные фото сольют в интернет? Как это отразиться на твоей работе в it-компании?"
msgstr "[_cedrick_] ¿Qué ocurre si tus fotos desnuda se filtran en internet? ¿Cómo afectará eso a tu trabajo en la empresa de informática?"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:177 #-#-# translate crowdin return_to_vendoms_914bfdea:
msgid "[_susan_] (Ох, а ведь и точно... Уж парни оттуда-то точно быстро мои фотки найдут, если они в интернете появятся...)"
msgstr "[_susan_] (Ah, claro... Los chicos de allí seguro que encontrarán mis fotos enseguida si aparecen en Internet...)"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:181 #-#-# translate crowdin return_to_vendoms_84b407b9:
msgid "[_susan_] Д-думаю ты прав, Рик..."
msgstr "[_susan_] Creo que tienes razón, Rick..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:187 #-#-# translate crowdin return_to_vendoms_cee91699:
msgid "[_will_] Отлично, тогда я пойду в укромное место, а вы возьмите на себя Урию с другими отморозками. Увидимся на пляже"
msgstr "[_will_] Genial, entonces me iré a algún lugar apartado y tú te encargarás de Uriah y los demás matones. Nos vemos en la playa"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:191 #-#-# translate crowdin return_to_vendoms_0e4f8f51:
msgid "[_susan_] Да, увидимся!"
msgstr "[_susan_] ¡Sí, nos vemos!"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:193 #-#-# translate crowdin return_to_vendoms_07e67464:
msgid "[_centered_] {size=37}Сьюзан идет переодеваться, Седрик прикрывает ее{/size}"
msgstr "[_centered_] {size=37}Susan va a cambiarse de ropa, Cedric la cubre{/size}"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:205 #-#-# translate crowdin gallery_d_103_e68f4ba5:
msgid "[_cedrick_] Вилл, ты там скоро?"
msgstr "[_cedrick_] Will, ¿estarás allí pronto?"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:208 #-#-# translate crowdin gallery_d_103_8709b1a3:
msgid "[_will_] Н-не смотри!! Рик!!"
msgstr "[_will_] ¡¡No mires!! ¡¡Rick!!"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:210 #-#-# translate crowdin gallery_d_103_75d2c83c:
msgid "[_cedrick_] Хах, да чего я там не видел?"
msgstr "[_cedrick_] Jaja, ¿qué es lo que no vi?"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:212 #-#-# translate crowdin gallery_d_103_1875b1f6:
msgid "[_cedrick_] С чего вдруг начала скромничать?"
msgstr "[_cedrick_] ¿Por qué de repente te volviste tímida?"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:214 #-#-# translate crowdin gallery_d_103_2b166d80:
msgid "[_will_] Д-дело не в этом... Н-не смотри пока..."
msgstr "[_will_] E-ese no es el punto... N-no mires todavía..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:216 #-#-# translate crowdin gallery_d_103_ff35d45d:
msgid "[_will_] П-потом можешь обсмотреться сколько хочешь... Я тебе и дома все покажу..."
msgstr "[_will_] Entonces, puedes mirar todo lo que quieras... También te enseñaré todo en casa..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:218 #-#-# translate crowdin gallery_d_103_5193cf2b:
msgid "[_will_] Н-но пока подожди... Это сюрприз..."
msgstr "[_will_] P-pero espera un momento... Es una sorpresa..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:220 #-#-# translate crowdin gallery_d_103_8a2e2433:
msgid "[_cedrick_] Сюрприз? Еще один? Не многовато?"
msgstr "[_cedrick_] ¿Sorpresa? ¿Otra más? ¿No es demasiado?"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:222 #-#-# translate crowdin gallery_d_103_37ac6cb8:
msgid "[_will_] Его я приготовила еще до того, как мы отправились в темницы"
msgstr "[_will_] Lo preparé antes de que fuéramos a las mazmorras"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:224 #-#-# translate crowdin gallery_d_103_2c0ea923:
msgid "[_cedrick_] Хм, ладно... Но полюбуюсь тобой еще немного, пока ты в такой позе..."
msgstr "[_cedrick_] Mmm, de acuerdo... Pero te admiraré un poco más mientras mantienes esta pose..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:226 #-#-# translate crowdin gallery_d_103_dbfa1cf7:
msgid "[_will_] Р-рик..."
msgstr "[_will_] R-Rick..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:228 #-#-# translate crowdin gallery_d_103_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:230 #-#-# translate crowdin gallery_d_103_dbd7690d:
msgid "[_will_] Е-если хочешь, дома я тебе потом как угодно могу попозировать..."
msgstr "[_will_] S-si quieres, puedo posar para ti como yo quiera en casa..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:232 #-#-# translate crowdin gallery_d_103_378695a8:
msgid "[_cedrick_] Но дома это ведь не здесь... Ты с мамой была права, в пляжах определенно есть своя прелесть..."
msgstr "[_cedrick_] Pero aquí no es como en casa, ¿verdad? Tu madre y tú tenían razón, las playas definitivamente tienen su propio encanto..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:234 #-#-# translate crowdin gallery_d_103_25731385:
msgid "[_will_] У-ууухх..."
msgstr "[_will_] U-uuuhh..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:236 #-#-# translate crowdin gallery_d_103_bcd124bf:
msgid "[_will_] ..."
msgstr "[_will_] ..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:238 #-#-# translate crowdin gallery_d_103_16d05cf7:
msgid "[_will_] Я почти все... Прикроешь меня еще немного?"
msgstr "[_will_] Ya casi termino... ¿Puedes cubrirme un poco más?"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:240 #-#-# translate crowdin gallery_d_103_b08cf301:
msgid "[_will_] Только не подглядывать..."
msgstr "[_will_] Simplemente no mires..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:242 #-#-# translate crowdin gallery_d_103_42c5257a:
msgid "[_cedrick_] Хах. Хорошо хорошо"
msgstr "[_cedrick_] Ja. Bien, bien."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:245 #-#-# translate crowdin gallery_d_103_b933b214:
msgid "[_centered_] {size=37}Седрик ждет еще какое-то время{/size}"
msgstr "[_centered_] {size=37}Cedric espera un rato{/size}"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:248 #-#-# translate crowdin gallery_d_103_9dbc0174:
msgid "[_will_] Я готова. Ну что, пойдем на пляж?"
msgstr "[_will_] Estoy lista. Entonces, ¿vamos a la playa?"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:249 #-#-# translate crowdin gallery_d_103_4f59e98b:
msgid "[_cedrick_] Да, пошли"
msgstr "[_cedrick_] Sí, vamos"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:256 #-#-# translate crowdin gallery_d_104_df799027:
msgid "[_cedrick_] Сьюзан, ты там скоро?"
msgstr "[_cedrick_] Susan, ¿estarás allí pronto?"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:259 #-#-# translate crowdin gallery_d_104_e053dcdc:
msgid "[_susan_] Р-рик, я еще не переоделась, подожди..."
msgstr "[_susan_] R-rick, aún no me he cambiado, espera..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:261 #-#-# translate crowdin gallery_d_104_4bb1ca01:
msgid "[_cedrick_] Ого, какой роскошный вид"
msgstr "[_cedrick_] Guau, qué vista tan hermosa"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:263 #-#-# translate crowdin gallery_d_104_b9547864:
msgid "[_susan_] Хах, и чего же нового для себя ты тут видел?"
msgstr "[_susan_] Jaja, ¿y qué cosas nuevas viste aquí?"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:265 #-#-# translate crowdin gallery_d_104_1dc36b0d:
msgid "[_cedrick_] Дело ведь не в том, видел я это раньше или нет, а в том, что это новое для тебя амплуа"
msgstr "[_cedrick_] No se trata de si lo he visto antes o no, sino de que este es un papel nuevo para ti"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:267 #-#-# translate crowdin gallery_d_104_d99099e3:
msgid "[_cedrick_] Раньше ты при мне так пикантно не раздевалась"
msgstr "[_cedrick_] Nunca te habías desnudado de forma tan provocativa delante de mí"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:269 #-#-# translate crowdin gallery_d_104_8d2c9198:
msgid "[_susan_] Ммм, если хочешь, могу устроить тебе дома стриптиз"
msgstr "[_susan_] Mmm, si quieres, puedo hacerte un striptease en casa"

