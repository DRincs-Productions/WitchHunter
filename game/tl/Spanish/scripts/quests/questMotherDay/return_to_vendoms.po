# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1212 #-#-# translate crowdin gallery_d_107_e2b33dc1:
msgid "[_cedrick_] (Но, с другой стороны… Чем дольше я здесь нахожусь, тем больше рискую быть застуканным рядом с этой девчонкой…)"
