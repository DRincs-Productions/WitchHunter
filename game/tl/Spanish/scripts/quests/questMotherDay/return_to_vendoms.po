# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1458 #-#-# translate crowdin gallery_d_107_9185e2bd:
msgid "[_cedrick_] (Хм, возможно, у меня еще будет шанс.. Нужно будет только улучшить отношения с Ирмой)"
