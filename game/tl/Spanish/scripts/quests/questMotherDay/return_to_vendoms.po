msgid "Прикрыть Сьюзан"
msgstr "¡Cubra a Susan"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:720
msgid "Поплавать с Вилл"
msgstr "Nadar con Will"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:720
msgid "Позагорать со Сьюзан"
msgstr "Tome el sol con Susan"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1214
msgid "Вытащить свисток"
msgstr "Tire del silbato"

