msgstr "[_cedrick_] (...)"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:1210 #-#-# translate crowdin gallery_d_107_e9b23976:
msgid "[_cedrick_] (Черт, а она вообще жива?)"
