msgstr "[_cedrick_] ..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:965 #-#-# translate crowdin gallery_d_105_2a4fafa8:
msgid "[_will_] Н-ну что, пойдем?"
msgstr "[_will_], ¿Bien, vamos?"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:969 #-#-# translate crowdin gallery_d_105_c5a7a077:
msgid "[_cedrick_] Давай сначала ты, а я приду через 5-10 минут. Чтобы никто не увидел, что мы вышли из туалета одновременно"
msgstr "[_cedrick_] Vamos primero a ti y volveré en 5-10 minutos. Para que nadie pueda ver que salimos del baño al mismo tiempo"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:973 #-#-# translate crowdin gallery_d_105_539cd41f:
msgid "[_will_] Д-да, точно. Хорошо, тогда ждем тебя с мамой снаружи"
msgstr "[_will_] S-sí, cierto. Bien, mamá y yo te esperamos afuera."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:974 #-#-# translate crowdin gallery_d_105_389e0edd:
msgid "[_cedrick_] Ага, я пока тут.. Займусь другими делами, скажем так"
msgstr "[_cedrick_] Agha, estoy aquí por ahora. Haré otras cosas, digamos"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:978 #-#-# translate crowdin gallery_d_105_05c989a5:
msgid "[_will_] А-ага, поняла тебя.. До скорого"
msgstr "[_will_] A-aha, lo entiendo. Antes de la velocidad"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:981 #-#-# translate crowdin gallery_d_105_53a1b62e:
