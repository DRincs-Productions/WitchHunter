msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:357 #-#-# translate crowdin gallery_d_104_deb133c5:
msgid "[_kurt_] Твою мать, я выронил свой телефон"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:358 #-#-# translate crowdin gallery_d_104_b9265b75:
msgid "[_uria_] Криворукий мудак..."
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:360 #-#-# translate crowdin gallery_d_104_ca198321:
msgid "[_cedrick_] (Это мой шанс! Плевать на этих мелких засранцев, нужно взять телефон!)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:363 #-#-# translate crowdin gallery_d_104_739afe6a:
msgid "[_cedrick_] (Нужно найти те фото и удалить... Так, что тут у нас)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:366 #-#-# translate crowdin gallery_d_104_10151032:
msgid "[_cedrick_] (Что за...)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:367 #-#-# translate crowdin gallery_d_104_13278760:
msgid "[_cedrick_] (Что это за хрень?)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:368 #-#-# translate crowdin gallery_d_104_4f301b8c:
msgid "[_cedrick_] (Если бы не пляжный антураж, я бы подумал, что это фото с Хэллоуина...)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:369 #-#-# translate crowdin gallery_d_104_a467e8c9:
msgid "[_cedrick_] (Девушка выглядит на удивление знакомо...)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:370 #-#-# translate crowdin gallery_d_104_aa0de2a5:
msgid "[_cedrick_] (А мужик в маске… Черт, надеюсь это просто косплей и здесь на орудует маньяк)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:371 #-#-# translate crowdin gallery_d_104_95cc7e52:
msgid "[_cedrick_] (Иначе шайка Урии будет наименьшей из наших проблем)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:372 #-#-# translate crowdin gallery_d_104_5cb93643:
msgid "[_cedrick_] (Но, черт, не могу отрицать, что выглядит это сцена довольно захватывающе)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:373 #-#-# translate crowdin gallery_d_104_2ef90216:
msgid "[_cedrick_] (...)"
msgstr "[_cedrick_] (...)"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:374 #-#-# translate crowdin gallery_d_104_5dfe53ba:
msgid "[_cedrick_] (......)"
msgstr "[_cedrick_] (......)"

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:375 #-#-# translate crowdin gallery_d_104_9714df9a:
msgid "[_cedrick_] (Так, о чем это я...)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:376 #-#-# translate crowdin gallery_d_104_bcd8b51a:
msgid "[_cedrick_] (Нужно же найти то фото, что он сделал сейчас)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:382 #-#-# translate crowdin gallery_d_104_10966c1c:
msgid "[_cedrick_] (Кажется нашел...)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:383 #-#-# translate crowdin gallery_d_104_84444edf:
msgid "[_cedrick_] (Хм, размытое фото?)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:384 #-#-# translate crowdin gallery_d_104_49519944:
msgid "[_cedrick_] (Черт, Курт, какие же у тебя кривые руки...)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:385 #-#-# translate crowdin gallery_d_104_e190c273:
msgid "[_cedrick_] (Даже нормального фото сделать не смог)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:386 #-#-# translate crowdin gallery_d_104_476aa7e0:
msgid "[_cedrick_] (Тут же ничего толком не видно...)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:387 #-#-# translate crowdin gallery_d_104_b00475a8:
msgid "[_cedrick_] (Ладно, наверное тем лучше для меня)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:388 #-#-# translate crowdin gallery_d_104_8273209a:
msgid "[_cedrick_] (Думаю Вилл и Сьюзан уже переоделись. Пора вернуться к ним)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:403 #-#-# translate crowdin gallery_d_104_781cd6ea:
msgid "[_susan_] В-вилл!? Ч-что это за наряд на тебе..."
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:409 #-#-# translate crowdin gallery_d_104_9f6983f9:
msgid "[_will_] Ну... Мне надоело постоянно ходить в плавательном костюме. К тому же он ведь спортивный, для соревнований, а не для пляжа"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:413 #-#-# translate crowdin gallery_d_104_d9e83e1c:
msgid "[_will_] Настоящего купальника у меня до этого не было. Вот я и решила, кхм, вот такой себе заказать"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:419 #-#-# translate crowdin gallery_d_104_309cf47e:
msgid "[_susan_] (Боже, да с таким купальником можно было и не беспокоиться о том, что Урия и остальные сфоткают ее во время переодевания...)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:420 #-#-# translate crowdin gallery_d_104_5e22bd58:
msgid "[_susan_] (В таком наряде практически все видно независимо от того, одета она или нет...)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:424 #-#-# translate crowdin gallery_d_104_6430a82d:
msgid "[_susan_] (Ох.. моя девочка.. Куда же тебя понесло..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:425 #-#-# translate crowdin gallery_d_104_cc4562d2:
msgid "[_cedrick_] (Кажется, теперь я понял, что она имела ввиду, когда говорила, что его нужно будет доработать..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:426 #-#-# translate crowdin gallery_d_104_4ed84155:
msgid "[_cedrick_] (Это же, очевидно, вообще не костюм для пляжа.. Она купила его для откровенного и развратного секса..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:427 #-#-# translate crowdin gallery_d_104_a5488b61:
msgid "[_cedrick_] (Ясно.. Поэтому она и не хотела, чтобы я видел его заранее, это был сюрприз для меня)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:431 #-#-# translate crowdin gallery_d_104_90cb852b:
msgid "[_cedrick_] (Видимо она не ожидала предложения с пляжем и сориентировалась на ходу. Попыталась скрыть изначальную развратность, кхм, так называемого купальника..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:432 #-#-# translate crowdin gallery_d_104_c877fa6e:
msgid "[_cedrick_] (Сверху надела майку, а снизу решила надеть короткие шорты, при этом не застегнув.. Хах, она явно не сильно старалас)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:433 #-#-# translate crowdin gallery_d_104_2e446e9c:
msgid "[_cedrick_] (Кстати о майке…)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:434 #-#-# translate crowdin gallery_d_104_5c38c539:
msgid "[_cedrick_] Вилл, а почему твоя футболка мокрая?"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:440 #-#-# translate crowdin gallery_d_104_f31ad8f4:
msgid "[_susan_] Ох, а ведь и правда.."
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:446 #-#-# translate crowdin gallery_d_104_746e44cd:
msgid "[_will_] Эм.. Я просто гонялась за Урией, чтобы наподдать ему за ту попытку сфоткать. Но его подпевалы подкрались сзади и толкнули меня в бассейн"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:450 #-#-# translate crowdin gallery_d_104_94bd6930:
msgid "[_cedrick_] Мелкие ублюдки.."
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:454 #-#-# translate crowdin gallery_d_104_6cc79156:
msgid "[_susan_] Да уж.. Ну и поколение.."
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:455 #-#-# translate crowdin gallery_d_104_0b7423c7:
msgid "[_cedrick_] (И все же… В таком купальнике она с таким же успехом могла надеть мокрую футболку и короткие шорты сразу на голое тело)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:456 #-#-# translate crowdin gallery_d_104_cba2bdae:
msgid "[_cedrick_] (Мне даже нравится ее развратно-креативный подход.. Но вот как на подобное отреагирует Сьюзан..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:457 #-#-# translate crowdin gallery_d_104_764b4ce1:
msgid "[_cedrick_] (Это интересно)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:463 #-#-# translate crowdin gallery_d_104_22877a29:
msgid "[_susan_] (Ну точно, как я сутра и думала.. Моя дочь на пути познания собственной сексуальности..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:464 #-#-# translate crowdin gallery_d_104_501d953a:
msgid "[_susan_] (Видимо сначала она сравнивала себя со мной в фартуке на голое тело. А теперь решила пойти дальше и открыто заявить о том, что она сексуальна..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:465 #-#-# translate crowdin gallery_d_104_005aa117:
msgid "[_susan_] (Боже, это все так быстро.. и внезапно..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:466 #-#-# translate crowdin gallery_d_104_2f476108:
msgid "[_susan_] (С чего вдруг такие изменения..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:472 #-#-# translate crowdin gallery_d_104_7840012d:
msgid "[_susan_] (Хотя стоп, чего это я.. Тот случай с Риком, когда она нас застукала.. Она же после этого четко дала понять, что ей не хватает того же.. Что она завидует..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:473 #-#-# translate crowdin gallery_d_104_f87092ca:
msgid "[_susan_] (Какая же я дура, раньше не заметила..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:477 #-#-# translate crowdin gallery_d_104_3d939d01:
msgid "[_susan_] (Наша активная сексуальная жизнь с Риком заставляет комплексовать Вилл по-поводу своей сексуальности..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:479 #-#-# translate crowdin gallery_d_104_fd9e3d87:
msgid "[_susan_] (И теперь она хочет доказать, что тоже может быть сексуальной и желанной..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:480 #-#-# translate crowdin gallery_d_104_caa47b2e:
msgid "[_susan_] (Т-таким вот.. абсолютно вульгарным образом..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:484 #-#-# translate crowdin gallery_d_104_6e3723cd:
msgid "[_susan_] (Е-если я ее сейчас не поддержу, любой другой мой комментарий она воспримет в штыки)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:488 #-#-# translate crowdin gallery_d_104_d16d6f65:
msgid "[_susan_] (Мол я ее совсем не понимаю и прочее. И тогда кто знает, как еще она захочет, кхм, доказать свою сексуальность..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:492 #-#-# translate crowdin gallery_d_104_d99812f8:
msgid "[_susan_] (Опять же, у нас буквально в доме живет мужчина, который ей не отец, а просто тот, кто трахает ее мать..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:494 #-#-# translate crowdin gallery_d_104_7cc7438d:
msgid "[_susan_] (И при этом на нее совершенно не обращает внимания..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:498 #-#-# translate crowdin gallery_d_104_1fd1c6f1:
msgid "[_susan_] (Да, теперь все встало на свои места.. Эх, все это так не вовремя..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:503 #-#-# translate crowdin gallery_d_104_9421a012:
msgid "[_will_] Ну и чего вы молчите? Настолько плохой пляжный костюм что-ли получился?"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:509 #-#-# translate crowdin gallery_d_104_c04d713e:
msgid "[_susan_] Н-нет!"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:515 #-#-# translate crowdin gallery_d_104_ce85f47c:
msgid "[_cedrick_] Нет-нет, вполне себе отличный"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:517 #-#-# translate crowdin gallery_d_104_d5fbcdea:
msgid "[_cedrick_] Знаешь, теперь у вас с мамой практически парные пляжные костюмы. И у тебя и у нее он цельный, с вырезом в виде буквы v"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:523 #-#-# translate crowdin gallery_d_104_1730a225:
msgid "[_susan_] Р-рик.."
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:527 #-#-# translate crowdin gallery_d_104_dfe2739a:
msgid "[_will_] Хах, а ведь и правда, я об этом не подумала. Спасибо, Рик!"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:533 #-#-# translate crowdin gallery_d_104_b6e0be95:
msgid "[_susan_] (Да, они похожи, вот только.. Мой костюм изначально подразумевался как провокационный..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:534 #-#-# translate crowdin gallery_d_104_8052314c:
msgid "[_susan_] (Но в итоге, если сравнивать, то даже в моем купальнике ткани больше, чем в ее..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:538 #-#-# translate crowdin gallery_d_104_6d5df9b0:
msgid "[_susan_] (По сравнению с ее купальником мой можно считать закрытым, как костюм монашки..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:539 #-#-# translate crowdin gallery_d_104_27520c19:
msgid "[_susan_] (И все же.. Я не могу осуждать ее.. По крайней мере не сейчас.. Возможно потом мне стоит провести с ней серьезный разговор.. Но пока..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:545 #-#-# translate crowdin gallery_d_104_6f9dea82:
msgid "[_susan_] О-отличный костюм, Вилл.. Он прямо таки, кхм.. Подчеркивает все твои сильные стороны!"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:549 #-#-# translate crowdin gallery_d_104_ffd7540e:
msgid "[_susan_] ..."
msgstr "[_susan_] ..."

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:553 #-#-# translate crowdin gallery_d_104_d9f56e11:
msgid "[_susan_] Ты ж моя красотка"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:557 #-#-# translate crowdin gallery_d_104_09bcd0f4:
msgid "[_will_] Ох, с-спасибо, мам… Не ожидала услышать от тебя подобное. Этот мамин день претендует на то, чтобы быть лучшим из всех"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:563 #-#-# translate crowdin gallery_d_104_042aba6d:
msgid "[_susan_] Д-да.."
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:564 #-#-# translate crowdin gallery_d_104_11dbf67e:
msgid "[_cedrick_] (Огооо, Сьюзан, вот этого я не ожидал..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:565 #-#-# translate crowdin gallery_d_104_a40563d8:
msgid "[_cedrick_] (Пошла Вилл навстречу вместо того, чтобы отчитывать за откровенно развратный вид..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:566 #-#-# translate crowdin gallery_d_104_723c25a6:
msgid "[_cedrick_] (Интересно, чем это вызвано? Почему она пересмотрела свой взгляд на воспитание Вилл..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:567 #-#-# translate crowdin gallery_d_104_98acc11c:
msgid "[_cedrick_] (Хм, возможно..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:571 #-#-# translate crowdin gallery_d_104_4af80e8c:
msgid "[_cedrick_] (Да, точно, это было в книге по психологии по воспитанию детей от Фрейда..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:572 #-#-# translate crowdin gallery_d_104_a29fd8df:
msgid "[_cedrick_] (Видимо Сьюзан решила, что ее дочь начала проявлять свою сексуальность и не порицает ее, чтобы у нее не появились комплексы и впоследствии, кхм..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:573 #-#-# translate crowdin gallery_d_104_0220560f:
msgid "[_cedrick_] (Как выражаются люди на земле, Вилл не сорвало башню на теме секса)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:574 #-#-# translate crowdin gallery_d_104_2676e0c9:
msgid "[_cedrick_] (Ох, Сьюзан, к сожалению, крыша у твоей дочери съехала на теме секса еще до этого.. Я над этим очень сильно постарался..)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:575 #-#-# translate crowdin gallery_d_104_19087afe:
msgid "[_cedrick_] (То, что видишь ты - это следствие, а не причина)"
msgstr ""

# game/scripts/quests/questMotherDay/return_to_vendoms.rpy:576 #-#-# translate crowdin gallery_d_104_ee7b618c:
msgid "[_cedrick_] (Но интересно, как далеко зайдет поощрение сексуальности Вилл со стороны Сьюзан. Возможно я даже смогу это использовать)"
