# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/questMotherDay/game_with_elion.rpy:6 #-#-# translate crowdin game_with_elion_c962de1f:
msgid "[_cedrick_] Элион? Элион, я пришел!"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:8 #-#-# translate crowdin game_with_elion_aff05ace:
msgid "[_elion_] Р-рик? Т-ты правда пришел.. Так поздно, но.."
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:10 #-#-# translate crowdin game_with_elion_0140b2d2:
msgid "[_cedrick_] Я задержался в магазине. Искал, чем бы загладить свою вину за то, что не уделял тебе достаточно времени"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:11 #-#-# translate crowdin game_with_elion_48c37357:
msgid "[_cedrick_] В общем, вот"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:13 #-#-# translate crowdin game_with_elion_0d360d6f:
msgid "[_elion_] Это что, игровая приставка?"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:15 #-#-# translate crowdin game_with_elion_b790350f:
msgid "[_cedrick_] Да.. Просто, ты принесла телевизор. Вот я и решил, что было бы хорошим дополнением купить к нему приставку"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:17 #-#-# translate crowdin game_with_elion_b59647a6:
msgid "[_elion_] Ох, Рик, это.. Это очень мило.. Я.. Я правда ценю это"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:19 #-#-# translate crowdin game_with_elion_5d1b3f5f:
msgid "[_elion_] Давай пойдем ко мне в комнату и подключим ее к телевизору"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:24 #-#-# translate crowdin game_with_elion_3c12abc9:
msgid "[_cedrick_] Ого.. Элион.."
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:25 #-#-# translate crowdin game_with_elion_415ae5f1:
msgid "[_cedrick_] Смотрю ты навела здесь порядок. Теперь тут намного уютнее, чем было раньше"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:27 #-#-# translate crowdin game_with_elion_ca133266:
msgid "[_elion_] Да, я.. Эм, я решила принести еще несколько своих вещей из дома родителей"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:29 #-#-# translate crowdin game_with_elion_038178c1:
msgid "[_elion_] Здесь было неуютно последнее время и я хотела как-то разнообразить это место"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:31 #-#-# translate crowdin game_with_elion_9e67516b:
msgid "[_elion_] Сделать его… эм, более родным?"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:32 #-#-# translate crowdin game_with_elion_9eb83469:
msgid "[_cedrick_] Хм, да, могу понять.."
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:34 #-#-# translate crowdin game_with_elion_7981a167:
msgid "[_cedrick_] Сейчас комната и вправду выглядит куда более персональной, сразу видно, что здесь живет Элион Браун"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:36 #-#-# translate crowdin game_with_elion_338e35b3:
msgid "[_elion_] Ахах, спасибо, Рик.."
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:38 #-#-# translate crowdin game_with_elion_433e6992:
msgid "[_elion_] Ну что, давай подключим консоль?"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:42 #-#-# translate crowdin game_with_elion_a00a4bf0:
msgid "[_elion_] Тааак, сейчас распакуем. Давай посмотрим, что там за игры"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:43 #-#-# translate crowdin game_with_elion_5cb41734:
msgid "[_cedrick_] (Игры? Черт, они что, идут отдельно?)"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:44 #-#-# translate crowdin game_with_elion_c2b1d93f:
msgid "[_elion_] Хм, в комплекте шел только один диск. И это, ох.. Стрит Файтер?"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:45 #-#-# translate crowdin game_with_elion_350ca472:
msgid "[_cedrick_] А что такое?"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:46 #-#-# translate crowdin game_with_elion_0da48b6a:
msgid "[_elion_] Ох, ничего, просто я думала что будет что-то более, эм.. Девчачие?"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:47 #-#-# translate crowdin game_with_elion_f45502f7:
msgid "[_cedrick_] Хах, прости, в магазине было только это"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:48 #-#-# translate crowdin game_with_elion_89bfb4a8:
msgid "[_elion_] Что ж, я никогда не была хороша в файтингах, но… Главное ведь, что я провожу это время с тобой"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:49 #-#-# translate crowdin game_with_elion_1cac564f:
msgid "[_cedrick_] Это точно"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:50 #-#-# translate crowdin game_with_elion_e89bb867:
msgid "[_elion_] Ну, давай попробуем ее подключить!"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:51 #-#-# translate crowdin game_with_elion_75a278b0:
msgid "[_cedrick_] Пойдем"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:54 #-#-# translate crowdin game_with_elion_5b63292f:
msgid "[_centered_] {size=37}Седрик и Элион подключают консоль к телевизору и запускают игру{/size}"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:57 #-#-# translate crowdin game_with_elion_10e1543d:
msgid "[_elion_] Так, выбор персонажа. Я чур играю за Зангиева! Он выглядит очень сильным и таким брутальным"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:59 #-#-# translate crowdin game_with_elion_42fba2ef:
msgid "[_elion_] Играя за него я точно выиграю!"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:61 #-#-# translate crowdin game_with_elion_d7f10532:
msgid "[_cedrick_] Эм, а я тогда выбираю… Хм.. Я выбираю Кэмми. Она выглядит спортивной, и при этом сексуальной. Смогу смотреть на ее задницу, пока играю"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:63 #-#-# translate crowdin game_with_elion_bc95ce37:
msgid "[_elion_] Р-рик!"
msgstr "[_elion_] R-Rick!"

# game/scripts/quests/questMotherDay/game_with_elion.rpy:65 #-#-# translate crowdin game_with_elion_c17c34ca:
msgid "[_cedrick_] Хах, да шучу я, шучу"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:67 #-#-# translate crowdin game_with_elion_5a384c2b:
msgid "[_elion_] Н-ну что, начнем?"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:69 #-#-# translate crowdin game_with_elion_f8994ce5:
msgid "[_cedrick_] Сейчас, только посмотрю какое тут управление"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:71 #-#-# translate crowdin game_with_elion_02b75342:
msgid "[_elion_] Н-нечестно, я ведь тоже играть не умею"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:73 #-#-# translate crowdin game_with_elion_27956bed:
msgid "[_cedrick_] Хах, хорошо. Тогда начнем"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:91 #-#-# translate crowdin cedrick_win_1_0395fa38:
msgid "[_elion_] Это не честно, я совсем не умею играть в такие игры..."
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:92 #-#-# translate crowdin cedrick_win_1_cb17e283:
msgid "[_cedrick_] Хммм, знаешь, Элион, у меня есть одна идея..."
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:93 #-#-# translate crowdin cedrick_win_1_c5c9cdb8:
msgid "[_elion_] К-какая?"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:94 #-#-# translate crowdin cedrick_win_1_6a7dc948:
msgid "[_cedrick_] Довольно скучно играть без приза. Как насчет пари? Проигравший исполняет желание победителя?"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:95 #-#-# translate crowdin cedrick_win_1_45ed82f3:
msgid "[_elion_] Э-это не честно, ты же выигрываешь?"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:96 #-#-# translate crowdin cedrick_win_1_2c38bd42:
msgid "[_cedrick_] Вдруг ты еще отыграешься?"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:97 #-#-# translate crowdin cedrick_win_1_3b185e81:
msgid "[_elion_] Пф... Тогда пусть все заранее озвучат свое желание"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:98 #-#-# translate crowdin cedrick_win_1_81ac4e4c:
msgid "[_cedrick_] Хм... Хочу трахнуть тебя между грудей"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:99 #-#-# translate crowdin cedrick_win_1_bc95ce37:
msgid "[_elion_] Р-рик!"
msgstr "[_elion_] R-Rick!"

# game/scripts/quests/questMotherDay/game_with_elion.rpy:100 #-#-# translate crowdin cedrick_win_1_a27b2527:
msgid "[_cedrick_] Что? Мы этого еще не делали"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:101 #-#-# translate crowdin cedrick_win_1_ee9d1d0f:
msgid "[_elion_] Н-ну тогда... Хочу, чтобы ты сделал мне куни"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:102 #-#-# translate crowdin cedrick_win_1_6eac3ad8:
msgid "[_cedrick_] Хах, договорились. Продолжим?"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:103 #-#-# translate crowdin cedrick_win_1_576ffbdd:
msgid "[_elion_] Д-да!"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:118 #-#-# translate crowdin elion_win_1_950b3403:
msgid "[_elion_] Хаха, я победила!!"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:119 #-#-# translate crowdin elion_win_1_4baafd4c:
msgid "[_cedrick_] Черт, не думал, что это так сложно"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:120 #-#-# translate crowdin elion_win_1_d0fc8822:
msgid "[_elion_] Агааа! Я не так уж и плоха в этом!"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:121 #-#-# translate crowdin elion_win_1_afa48879:
msgid "[_cedrick_] Хах, видимо"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:122 #-#-# translate crowdin elion_win_1_20c15389:
msgid "[_elion_] Эй, Рик, а как насчет пари? Проигравший исполняет желание победителя"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:123 #-#-# translate crowdin elion_win_1_caba43b6:
msgid "[_cedrick_] О, выиграла один матч и уже так осмелела? И чего же ты хочешь, если победишь?"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:124 #-#-# translate crowdin elion_win_1_50f65dec:
msgid "[_elion_] Хммм.. Хочу, чтобы ты поиграл языком с моей киской"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:125 #-#-# translate crowdin elion_win_1_0f486dbd:
msgid "[_cedrick_] Хах, тогда если выиграю я, то трахну тебя между грудей и кончу тебе в рот"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:126 #-#-# translate crowdin elion_win_1_bc95ce37:
msgid "[_elion_] Р-рик!"
msgstr "[_elion_] R-Rick!"

# game/scripts/quests/questMotherDay/game_with_elion.rpy:127 #-#-# translate crowdin elion_win_1_304006c8:
msgid "[_cedrick_] Что? Все честно"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:128 #-#-# translate crowdin elion_win_1_3355b4af:
msgid "[_elion_] Н-ну хорошо. Продолжим!"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:142 #-#-# translate crowdin gallery_d_109_c617453d:
msgid "[_cedrick_] Э-элион!? Ч-что ты делаешь.. Уххх.. Э-это против правил.."
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:143 #-#-# translate crowdin gallery_d_109_22da4254:
msgid "[_elion_] Мммххх.. Н-ну и что.. Да и вообще.. Мы не оговаривали ничего подобного в правилах.."
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:144 #-#-# translate crowdin gallery_d_109_1ae596dc:
msgid "[_cedrick_] Ты... уууххх... Ты очень грязно играешь.."
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:145 #-#-# translate crowdin gallery_d_109_137a6cc2:
msgid "[_elion_] Мммвв.. Говоришь так, словно тебе неприятно.."
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:146 #-#-# translate crowdin gallery_d_109_4fed375f:
msgid "[_cedrick_] М-мне приятно.. Но, неприятно при этом проигрывать.. К-к тому же ты делаешь это из корыстных побуждений"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:147 #-#-# translate crowdin gallery_d_109_ac00f7b2:
msgid "[_elion_] Ааааххх.. Как будто ты не сделал бы того же самого, если бы начал проигрывать"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:148 #-#-# translate crowdin gallery_d_109_ee321121:
msgid "[_cedrick_] Хах.. Уххх.. В-возможно.. Но это тебя не оправдывает"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:149 #-#-# translate crowdin gallery_d_109_ffaac971:
msgid "[_elion_] Ох, еще как оправдывает"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:150 #-#-# translate crowdin gallery_d_109_1a5a860c:
msgid "[_cedrick_] Д-думаешь это сможет отвлечь меня от игры?"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:151 #-#-# translate crowdin gallery_d_109_a61b7b21:
msgid "[_elion_] Ооочень на это надеюсь.. Ты ведь оценишь мои старания? Я так усердно тебе сосу"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:152 #-#-# translate crowdin gallery_d_109_d28e2c97:
msgid "[_cedrick_] Ч-черт.."
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:153 #-#-# translate crowdin gallery_d_109_54b20847:
msgid "[_elion_] Ну Рииик"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:154 #-#-# translate crowdin gallery_d_109_0e504c96:
msgid "[_cedrick_] Уууххх, к-кончаю.."
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:157 #-#-# translate crowdin gallery_d_109_e506965d:
msgid "[_elion_] Ммммммвввв..."
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:159 #-#-# translate crowdin gallery_d_109_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/questMotherDay/game_with_elion.rpy:161 #-#-# translate crowdin gallery_d_109_0fd4d656:
msgid "......"
msgstr "......"

# game/scripts/quests/questMotherDay/game_with_elion.rpy:163 #-#-# translate crowdin gallery_d_109_278c7e29:
msgid "........."
msgstr "........."

# game/scripts/quests/questMotherDay/game_with_elion.rpy:170 #-#-# translate crowdin gallery_d_109_ed06e470:
msgid "[_elion_] Ахахах, я победила! Вот так то!"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:171 #-#-# translate crowdin gallery_d_109_72c195e1:
msgid "[_cedrick_] Победила, используя грязные приемы"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:172 #-#-# translate crowdin gallery_d_109_683bd3c2:
msgid "[_elion_] И что? Главное ведь результат"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:173 #-#-# translate crowdin gallery_d_109_beaa3ce7:
msgid "[_cedrick_] Думаешь второй раз у тебя получится?"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:174 #-#-# translate crowdin gallery_d_109_cdd0a51c:
msgid "[_elion_] Мммм, посмотрим. Может мне и не понадобится прибегать к таким трюкам"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:175 #-#-# translate crowdin gallery_d_109_7790de5a:
msgid "[_cedrick_] Вот и увидим. Начнем третий раунд"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:188 #-#-# translate crowdin cedrick_loose_2_ec5e5c78:
msgid "[_elion_] Хах, я отыгралась!"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:190 #-#-# translate crowdin cedrick_loose_2_dedda071:
msgid "[_cedrick_] Что ж, это было неплохо"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:192 #-#-# translate crowdin cedrick_loose_2_da8a2c8f:
msgid "[_elion_] Неплохо? Да я тебя сделала"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:194 #-#-# translate crowdin cedrick_loose_2_2dbf5a68:
msgid "[_cedrick_] Рано радуешься, впереди еще финальный раунд"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:196 #-#-# translate crowdin cedrick_loose_2_cac0d5c4:
msgid "[_elion_] Ууухх. Я тебя уделаю!"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:198 #-#-# translate crowdin cedrick_loose_2_7e522beb:
msgid "[_cedrick_] Еще посмотрим кто кого"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:209 #-#-# translate crowdin cedrick_loose_1_902e453a:
msgid "[_elion_] Что ж, у тебя получилось отыграться. Но не расслабляйся, финальная битва еще впереди!"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:211 #-#-# translate crowdin cedrick_loose_1_14998ae5:
msgid "[_cedrick_] Хах, я готов. Готова ли ты к поражению?"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:213 #-#-# translate crowdin cedrick_loose_1_d8370505:
msgid "[_elion_] Пф.. Еще посмотрим!"
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:225 #-#-# translate crowdin gallery_d_110_f5fd5238:
msgid "[_elion_] Р-рик.. Ааххх.. Ч-что.."
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:227 #-#-# translate crowdin gallery_d_110_ab9154b1:
msgid "[_elion_] Что ты делаешь, мммххх..."
msgstr ""

# game/scripts/quests/questMotherDay/game_with_elion.rpy:229 #-#-# translate crowdin gallery_d_110_a39ea46f:
msgid "[_cedrick_] Пытаюсь выиграть, разве не видно?"
msgstr ""

