# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:4 #-#-# translate crowdin give_miranda_shred_of_tom_lair_hair_e23f3887:
msgid "[_miranda_] Ты достал образец волос твоего полицейского?"
msgstr "[_miranda_] ¿Conseguiste un mechón de pelo del policía?"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:5 #-#-# translate crowdin give_miranda_shred_of_tom_lair_hair_e6f6bc07:
msgid "[_cedrick_] Еще нет"
msgstr "[_cedrick_] Todavía no"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:7 #-#-# translate crowdin give_miranda_shred_of_tom_lair_hair_50cb3a93:
msgid "[_miranda_] Не забыл взять одежду подходящего размера? У тебя будет не так много времени после перевоплощения"
msgstr "[_miranda_] ¿Recordaste traer la ropa de la talla adecuada? No tendrás mucho tiempo después de la transformación"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:8 #-#-# translate crowdin give_miranda_shred_of_tom_lair_hair_99cdc16b:
msgid "[_cedrick_] Совсем забыл"
msgstr "[_cedrick_] Lo olvidé por completo"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:20 #-#-# translate crowdin give_miranda_shred_of_tom_lair_hair_scenes_9a35e979:
msgid "[_cedrick_] Я принес тебе то, что требуется для оборотного зелья…"
msgstr "[_cedrick_] Te he traído lo que necesitas para la poción multijugos…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:25 #-#-# translate crowdin give_miranda_shred_of_tom_lair_hair_scenes_190e2d29:
msgid "[_miranda_] Отлично, давай сюда… И подожди…"
msgstr "[_miranda_] Genial, ven aquí… Y espera…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:31 #-#-# translate crowdin give_miranda_shred_of_tom_lair_hair_scenes_ece6bd4b:
msgid "[_centered_] {size=37}Спустя 10 минут{/size} [withDissolve1]"
msgstr "[_centered_] {size=37}10 minutos después{/size} [withDissolve1]"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:41 #-#-# translate crowdin gallery_d_013_ac69f219:
msgid "[_miranda_] Оборотное зелье готово!"
msgstr "[_miranda_] ¡La poción multijugos está lista!"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:45 #-#-# translate crowdin gallery_d_013_e37871f4:
msgid "[_cedrick_] Отлично! Давай его сюда..."
msgstr "[_cedrick_] ¡Genial! Dámela…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:50 #-#-# translate crowdin gallery_d_013_f2242b72:
msgid "[_miranda_] Не так быстро…"
msgstr "[_miranda_] No tan rápido…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:51 #-#-# translate crowdin gallery_d_013_07da4e43:
msgid "[_miranda_] Ты постоянно приходишь ко мне со своими просьбами, но я ничего не получаю в замен…"
msgstr "[_miranda_] Sigues viniendo a mí con tus peticiones, pero no recibo nada a cambio…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:52 #-#-# translate crowdin gallery_d_013_243b26ce:
msgid "[_cedrick_] и чего же ты хочешь?"
msgstr "[_cedrick_] ¿Y qué quieres?"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:56 #-#-# translate crowdin gallery_d_013_488ab97d:
msgid "[_miranda_] Я хочу, чтобы ты трахнул меня, Седрик…"
msgstr "[_miranda_] Quiero que me cojas, Cedric…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:58 #-#-# translate crowdin gallery_d_013_df1659e2:
msgid "[_centered_] {size=37}Спустя несколько мгновений{/size} [withDissolve1]"
msgstr "[_centered_] {size=37}Momentos después{/size} [withDissolve1]"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:62 #-#-# translate crowdin gallery_d_013_935c9d4d:
msgid "[_miranda_] …."
msgstr "[_miranda_] …."

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:64 #-#-# translate crowdin gallery_d_013_043b4169:
msgid "[_miranda_] Ох…."
msgstr "[_miranda_] Oh…."

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:65 #-#-# translate crowdin gallery_d_013_1a5ae650:
msgid "[_miranda_] я так давно этого хотела …"
msgstr "[_miranda_] He querido esto durante tanto tiempo…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:66 #-#-# translate crowdin gallery_d_013_5cc0c5bc:
msgid "[_cedrick_] … могла бы попросить …"
msgstr "[_cedrick_] … Podrías haber preguntado…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:67 #-#-# translate crowdin gallery_d_013_0d3a21e9:
msgid "[_cedrick_] и раньше…"
msgstr "[_cedrick_] Mucho antes…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:68 #-#-# translate crowdin gallery_d_013_6a781b9b:
msgid "…."
msgstr "…."

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:69 #-#-# translate crowdin gallery_d_013_44834f38:
msgid "[_miranda_] ох.."
msgstr "[_miranda_] oh…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:72 #-#-# translate crowdin gallery_d_013_5c8d1def:
msgid "[_miranda_] надеюсь… твое семя не ядовито…"
msgstr "[_miranda_] Espero… Que tu semen no sea venenoso…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:74 #-#-# translate crowdin gallery_d_013_6a781b9b_1:
msgid "…."
msgstr "…."

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:76 #-#-# translate crowdin gallery_d_013_7924ec00:
msgid "[_cedrick_] Что ж, раз уж мы закончили…"
msgstr "[_cedrick_] Bueno, ya que hemos terminado…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:77 #-#-# translate crowdin gallery_d_013_0707212e:
msgid "[_miranda_] Уф… Да… Держи…"
msgstr "[_miranda_] Uf… Sí… Aquí tienes…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:83 #-#-# translate crowdin gallery_d_013_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:93 #-#-# translate crowdin gallery_d_013_52e3310e:
msgid "[_cedrick_] Ну и запах!"
msgstr "[_cedrick_] ¡Qué olor!"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:99 #-#-# translate crowdin gallery_d_013_8c4a35c4:
msgid "[_miranda_] Ты должен выпить его до дна…"
msgstr "[_miranda_] Debes bebértelo todo…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:107 #-#-# translate crowdin gallery_d_013_beac44f6:
msgid "[_cedrick_] грл…"
msgstr "[_cedrick_] grrr…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:111 #-#-# translate crowdin gallery_d_013_2c44d6dc:
msgid "[_cedrick_] ж..жгется.."
msgstr "[_cedrick_] Q…quema…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:115 #-#-# translate crowdin gallery_d_013_ce617998:
msgid "…"
msgstr "…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:119 #-#-# translate crowdin gallery_d_013_ce617998_1:
msgid "…"
msgstr "…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:120 #-#-# translate crowdin gallery_d_013_d6e1285f:
msgid "[_cedrick_]  На вкус как перепревшая капуста…"
msgstr "[_cedrick_] Sabe a col demasiado madura…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:126 #-#-# translate crowdin gallery_d_013_73617deb:
msgid "[_miranda_] Сработало!"
msgstr "[_miranda_] ¡Funcionó!"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:128 #-#-# translate crowdin gallery_d_013_bdb6395c:
msgid "[_miranda_] не забудь снять свои очки и переодеться..."
msgstr "[_miranda_] No olvides quitarte las gafas y cambiarte…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:132 #-#-# translate crowdin gallery_d_013_7f36ce4e:
msgid "[_cedrick_] (пожалуй… сперва мне стоит заглянуть в полицейский участок)"
msgstr "[_cedrick_] (tal vez… debería visitar la estación de policía en primer lugar)"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:139 #-#-# translate crowdin gallery_d_013_941db9b7:
msgid "[_cedrick_] (Это, должно быть, полицейский участок. Надеюсь, что мне удастся проникнуть сразу в кабинет шефа полиции и избежать лишнего внимания. У меня не так много времени…)"
msgstr "[_cedrick_] (Esta debe ser la estación de policía. Con suerte podré entrar directamente en el despacho del jefe de policía y evitar atención innecesaria. No tengo mucho tiempo…)"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:143 #-#-# translate crowdin gallery_d_013_4ee33cdc:
msgid "[_cedrick_] Здравия желаю, Шеф…"
msgstr "[_cedrick_] Hola, jefe…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:147 #-#-# translate crowdin gallery_d_013_1b32b8ee:
msgid "[_gordon_] Том? Лэир?? Это ты???"
msgstr "[_gordon_] ¿Tom Lair? ¿Eres tú???"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:148 #-#-# translate crowdin gallery_d_013_54e71687:
msgid "[_cedrick_] Так точно! Шеф!"
msgstr "[_cedrick_] ¡Sí, señor! ¡Jefe!"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:149 #-#-# translate crowdin gallery_d_013_b6c41ce1:
msgid "[_gordon_] Где ты пропадал? Мы уже объявили тебя без вести пропавшим… Твоя семья знать не знает где ты…"
msgstr "[_gordon_] ¿Dónde has estado? Ya hemos denunciado tu desaparición… Tu familia no sabe dónde estabas…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:150 #-#-# translate crowdin gallery_d_013_e1935f5f:
msgid "[_gordon_] Я не помню, чтобы за все время работы ты хоть раз опаздывал…"
msgstr "[_gordon_] No recuerdo que hayas llegado tarde ni una sola vez en todo el tiempo que llevas trabajando…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:151 #-#-# translate crowdin gallery_d_013_b651d3f2:
msgid "[_gordon_] А тут ты пропал на несколько недель и явился как ни в чем не бывало…"
msgstr "[_gordon_] Y luego desapareces durante unas semanas y apareces como si nada…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:152 #-#-# translate crowdin gallery_d_013_b2725251:
msgid "[_cedrick_] Я все объясню, шеф…"
msgstr "[_cedrick_] Se lo explicaré todo, Jefe…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:156 #-#-# translate crowdin gallery_d_013_42ec1610:
msgid "[_gordon_] Ну конечно объяснишь…"
msgstr "[_gordon_] Por supuesto que debes explicar…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:160 #-#-# translate crowdin gallery_d_013_d9781c0c:
msgid "[_gordon_] Детективы Медина и Мактиннен уже считают, что тебя похитил продавец из книжного магазина! Хахаха..."
msgstr "[_gordon_] ¡Los detectives Medina y Maktinen, creen que fuiste secuestrado por un empleado de una librería! Jajaja…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:161 #-#-# translate crowdin gallery_d_013_dd54bdf8:
msgid "[_cedrick_] Нет… Как оказалось, у него было алиби на время пропажи детей и он ни в чем не виновен…"
msgstr "[_cedrick_] No… Resultó que tenía una coartada para el momento en que desaparecieron los niños y no era culpable de nada…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:165 #-#-# translate crowdin gallery_d_013_3c0c0440:
msgid "[_gordon_] Ты проверил его документы на владение магазина, как и хотел?"
msgstr "[_gordon_] ¿Comprobaste los papeles de propiedad de la tienda como querías?"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:169 #-#-# translate crowdin gallery_d_013_f2eae615:
msgid "[_cedrick_] Да, с его документами все в порядке…"
msgstr "[_cedrick_] Sí, todos sus papeles están en regla…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:170 #-#-# translate crowdin gallery_d_013_5c30fbd1:
msgid "[_cedrick_] А похитили меня эти чертовы мексиканцы! Я заметил группу людей и мне они показались очень подозрительными. Оказалось, что они проводили сделку по продаже наркотиков…"
msgstr "[_cedrick_] ¡Me secuestraron unos malditos mexicanos! Me fijé en un grupo de personas que me parecieron muy sospechosas. Resulta que tienen un negocio de drogas…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:171 #-#-# translate crowdin gallery_d_013_f3c4fb24:
msgid "[_cedrick_] Я не мог не вмешаться, но в итоге потерял сознание… Видимо получив удар по голове со спины..."
msgstr "[_cedrick_] No pude evitar intervenir, pero acabé desmayándome… Al parecer me golpearon en la cabeza por la espalda…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:172 #-#-# translate crowdin gallery_d_013_70cc09c2:
msgid "[_cedrick_] Они продержали меня какое-то время в подвале, видимо не смогли решиться убить копа, как и не могли решить, что же делать со мной. Один из них предлагал продать меня на органы…"
msgstr "[_cedrick_] Me retuvieron en un sótano durante un tiempo, al parecer no podían decidirse si matar a un policía, ni podían decidir qué hacer conmigo. Uno de ellos propuso vender mis órganos…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:173 #-#-# translate crowdin gallery_d_013_c442d032:
msgid "[_cedrick_] В итоге… В один удачный день мне удалось сбежать! Один из мексиканцев, который должен был караулить меня, перебрал с героином, и я, сняв наручники с помощью скрепки, которая у меня завалялась в кармане, сумел проскользнуть мимо него…"
msgstr "[_cedrick_] Finalmente… ¡Un día de suerte conseguí escapar! Uno de los mexicanos que se suponía que me custodiaba consumió demasiada heroína, y con un clip que llevaba en el bolsillo conseguí quitarme las esposas, por lo que pude escabullirme de él…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:177 #-#-# translate crowdin gallery_d_013_d19cf3e1:
msgid "[_gordon_] Захватывающая история! Даже не знаю, что сказать…"
msgstr "[_gordon_] Una historia fascinante. No sé ni qué decir…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:181 #-#-# translate crowdin gallery_d_013_63482881:
msgid "[_gordon_] Мы вместе найдем этих ублюдков, Том! Они ответят за содеянное!"
msgstr "[_gordon_] ¡Encontraremos a esos bastardos juntos, Tom! ¡Responderán por lo que han hecho!"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:182 #-#-# translate crowdin gallery_d_013_08be640a:
msgid "[_cedrick_] Да… Насчет этого… Знаешь, после этого случая я решил, что это работа не для меня… Слишком опасно, понимаете… У меня семья…"
msgstr "[_cedrick_] Sí… Sobre eso… Sabes, después de este incidente decidí que este trabajo no es para mí… Demasiado peligroso, ya sabes… Tengo una familia…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:186 #-#-# translate crowdin gallery_d_013_18408a4f:
msgid "[_gordon_] Понимаю... И что ты планируешь делать?"
msgstr "[_gordon_] Ya veo… ¿Y qué piensas hacer?"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:190 #-#-# translate crowdin gallery_d_013_fdede4ce:
msgid "[_cedrick_] Для начала я хочу увидеться с семьей… Наверное… Они жутко скучают…"
msgstr "[_cedrick_] Para empezar, quiero ver a mi familia… Probablemente… Me echan mucho de menos…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:191 #-#-# translate crowdin gallery_d_013_e6077b38:
msgid "[_gordon_] Так и есть… Ну, тебе стоит поторопиться… Они достаточно долго тебя не видели…"
msgstr "[_gordon_] Es… Bueno, deberías darte prisa… No te han visto en mucho tiempo…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:192 #-#-# translate crowdin gallery_d_013_328a9047:
msgid "[_cedrick_] Эм, сэр… Возможно это прозвучит глупо…"
msgstr "[_cedrick_] Um, señor… Esto puede sonar tonto…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:193 #-#-# translate crowdin gallery_d_013_4e510893:
msgid "[_cedrick_] Но вы не могли бы напомнить… Где я живу?"
msgstr "[_cedrick_] Pero ¿podría recordarme… dónde vivo?"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:197 #-#-# translate crowdin gallery_d_013_c35e4bfd:
msgid "[_gordon_] Ты меня пугаешь, Том…"
msgstr "[_gordon_] Me asustas, Tom…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:198 #-#-# translate crowdin gallery_d_013_0f3a41bb:
msgid "[_gordon_] 112 Мерсер Стрит…"
msgstr "[_gordon_] Calle Mercer 112…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:202 #-#-# translate crowdin gallery_d_013_91118092:
msgid "[_cedrick_] Ах да, точно! Видимо я частично потерял память из-за шока…"
msgstr "[_cedrick_] ¡Oh, sí, es cierto! Aparentemente perdí parte de mi memoria por el shock…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:203 #-#-# translate crowdin gallery_d_013_26b5301f:
msgid "[_gordon_] Не забудь навестить врача!"
msgstr "[_gordon_] ¡No olvides visitar al médico!"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:205 #-#-# translate crowdin gallery_d_013_a708d291:
msgid "[_cedrick_] Ну разумеется, шеф…"
msgstr "[_cedrick_] Por supuesto, señor…"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:212 #-#-# translate crowdin gallery_d_013_fa03bb9a:
msgid "[_cedrick_] (Так, это должен быть дом Лэиров…)"
msgstr "[_cedrick_] (Bien, esta debe de ser la casa de la familia Lair…)"

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:213 #-#-# translate crowdin gallery_d_013_6a781b9b_2:
msgid "…."
msgstr "…."

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:215 #-#-# translate crowdin gallery_d_013_872b6187:
msgid "[_cedrick_] Открыто?"
msgstr "[_cedrick_] ¿Está abierto?"

