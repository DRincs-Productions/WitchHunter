# TODO: Translation updated at 2023-07-25 15:55 #|#|# # game/scripts/quests/theMaidsUniformForEyion/get_order_of_maids_uniform.rpy:3 #-#-# translate crowdin get_order_of_maids_uniform_c0bc3184:
msgid "[_cedrick_] Элион, твоя новая рабочая форма пришла, готова примерить?"
msgstr "[_cedrick_] Elyon, su nuevo formulario de trabajo está aquí, ¿listo para probar?"

# game/scripts/quests/theMaidsUniformForEyion/get_order_of_maids_uniform.rpy:8 #-#-# translate crowdin get_order_of_maids_uniform_c16e5e60:
msgid "[_elion_] Агам, дай наконец посмотреть, что ты там выбрал. Сейчас пойду примерить"
msgstr "[_elion_] Ajá, déjame ver de una vez qué elegiste. Voy a probármelo."

# game/scripts/quests/theMaidsUniformForEyion/get_order_of_maids_uniform.rpy:12 #-#-# translate crowdin get_order_of_maids_uniform_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/theMaidsUniformForEyion/get_order_of_maids_uniform.rpy:13 #-#-# translate crowdin get_order_of_maids_uniform_a20cefa7_1:
msgid "..."
msgstr "..."

# game/scripts/quests/theMaidsUniformForEyion/get_order_of_maids_uniform.rpy:14 #-#-# translate crowdin get_order_of_maids_uniform_10bc3d07:
msgid "[_elion_] Рик, что это? П-почему она вся такая.. Эм, такая!"
msgstr "[_elion_] Rick, ¿qué es? ¿Por qué está así? Uh, ¡eso es!"

# game/scripts/quests/theMaidsUniformForEyion/get_order_of_maids_uniform.rpy:15 #-#-# translate crowdin get_order_of_maids_uniform_24b44f7f:
msgid "[_cedrick_] Хах, а что не так?"
msgstr "[_cedrick_] Ja, ¿qué pasa?"

# game/scripts/quests/theMaidsUniformForEyion/get_order_of_maids_uniform.rpy:16 #-#-# translate crowdin get_order_of_maids_uniform_78c17b24:
msgid "[_elion_] А то, что это форма развратной горничной!"
msgstr "[_elion_] Y el hecho de que es una forma de una criada depravada!"

# game/scripts/quests/theMaidsUniformForEyion/get_order_of_maids_uniform.rpy:20 #-#-# translate crowdin get_order_of_maids_uniform_ae02cece:
msgid "[_cedrick_] Хоооо, по моему смотрится просто потрясающе"
msgstr "[_cedrick_] Hooo, en mi opinión se ve simplemente increíble"

# game/scripts/quests/theMaidsUniformForEyion/get_order_of_maids_uniform.rpy:23 #-#-# translate crowdin get_order_of_maids_uniform_4c3c50f2:
msgid "[_elion_] Рик! У формы полностью открытый низ! Я же словно в нижнем белье разгуливаю"
msgstr "[_elion_] ¡Rick! La forma tiene un fondo completamente abierto! Es como si estuviera caminando en ropa interior"

# game/scripts/quests/theMaidsUniformForEyion/get_order_of_maids_uniform.rpy:24 #-#-# translate crowdin get_order_of_maids_uniform_68677952:
msgid "[_cedrick_] Эм.. Ты не понимаешь, это профессиональная форма горничных высшего класса"
msgstr "[_cedrick_] Mm. No lo entiendes, es una forma profesional de criadas de clase alta"

# game/scripts/quests/theMaidsUniformForEyion/get_order_of_maids_uniform.rpy:27 #-#-# translate crowdin get_order_of_maids_uniform_97bc3510:
msgid "[_elion_] П-правда?"
msgstr "[_elion_] D-de verdad?"

# game/scripts/quests/theMaidsUniformForEyion/get_order_of_maids_uniform.rpy:28 #-#-# translate crowdin get_order_of_maids_uniform_f7da0f4b:
msgid "[_cedrick_] Да, эта форма была специально разработана лучшими дизайнерами, с учетом всех сложных задач профессиональных горничных"
msgstr "[_cedrick_] Sí, este formulario ha sido especialmente diseñado por los mejores diseñadores, teniendo en cuenta todas las tareas complejas de las criadas profesionales"

# game/scripts/quests/theMaidsUniformForEyion/get_order_of_maids_uniform.rpy:29 #-#-# translate crowdin get_order_of_maids_uniform_1dd79a70:
msgid "[_cedrick_] Все элементы одежды не просто открыты, а сделаны максимально эргономичными! Сама удивишься, как легко будет в этой одежде протирать пыль"
msgstr "[_cedrick_] Todos los elementos de la ropa no solo están abiertos, sino que están lo más ergonómicos posible. Te sorprenderá lo fácil que será limpiar el polvo de esta ropa"

# game/scripts/quests/theMaidsUniformForEyion/get_order_of_maids_uniform.rpy:32 #-#-# translate crowdin get_order_of_maids_uniform_f341a893:
msgid "[_elion_] Ух, ну, если ты так говоришь.. Хорошо, Рик, спасибо. Постараюсь привыкнуть к этой новой форме.."
msgstr "[_elion_] Uh, bueno, si lo dices. Muy bien, Rick, gracias. Intentaré acostumbrarme a esta nueva forma."

# game/scripts/quests/theMaidsUniformForEyion/get_order_of_maids_uniform.rpy:35 #-#-# translate crowdin get_order_of_maids_uniform_142dc6eb:
msgid "[_cedrick_] (Фух, выкрутился..)"
msgstr "[_cedrick_] (Pie, fuera…)"

