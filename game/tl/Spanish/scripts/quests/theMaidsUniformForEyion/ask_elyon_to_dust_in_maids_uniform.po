# TODO: Translation updated at 2023-07-25 15:55 #|#|# # game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:4 #-#-# translate crowdin ask_elyon_to_dust_in_maids_uniform_2fd34c9b:
msgid "[_cedrick_] Элион, дорогуша, не могла бы ты протереть пыль с верхних полок?"
msgstr "[_cedrick_] Elyon, cariño, ¿podrías limpiar el polvo de los estantes superiores?"

# game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:7 #-#-# translate crowdin ask_elyon_to_dust_in_maids_uniform_083390c6:
msgid "[_elion_] Да, конечно, сейчас, только схожу за стремянкой"
msgstr "[_elion_] Sí, por supuesto, ahora, solo ve por la escalera"

# game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:10 #-#-# translate crowdin ask_elyon_to_dust_in_maids_uniform_89429a81:
msgid "[_cedrick_] (Отлично, шоу начинается)"
msgstr "[_cedrick_] (Genial, comienza el espectáculo)"

# game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:12 #-#-# translate crowdin ask_elyon_to_dust_in_maids_uniform_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:16 #-#-# translate crowdin ask_elyon_to_dust_in_maids_uniform_13ec7779:
msgid "[_cedrick_] (Ооооо, черт, ее попка просто шикарна в этой форме! Да еще и с такого ракурса)"
msgstr "[_cedrick_] (Ooo, maldita sea, su culo es simplemente hermoso en esta forma! Y desde tal ángulo)"

# game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:17 #-#-# translate crowdin ask_elyon_to_dust_in_maids_uniform_59d4abb1:
msgid "[_cedrick_] (Хах, и как она только согласилась разгуливать по магазину в одних трусах, бесстыжая девка)"
msgstr "[_cedrick_] (Ja, y cómo ella solo accedió a caminar por la tienda en ropa interior, una chica desvergonzada)"

# game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:18 #-#-# translate crowdin ask_elyon_to_dust_in_maids_uniform_0b3986b3:
msgid "[_cedrick_] (Ммм, так и хочется снять с нее эти трусики..)"
msgstr "[_cedrick_] (Mmm, así que quiero quitar estas panties de él.)"

# game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:24 #-#-# translate crowdin ask_elyon_to_dust_in_maids_uniform_9557c42a:
msgid "[_cedrick_] (Хм, думаю все же не стоит этого делать. Оголять ее зад, посреди дня, когда в любой момент может зайти посетитель. Нет, слишком рискованно)"
msgstr "[_cedrick_] (Hmm, no creo que valga la pena. Doble su culo, en medio del día, cuando un visitante puede venir en cualquier momento. No, es demasiado arriesgado)"

# game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:26 #-#-# translate crowdin ask_elyon_to_dust_in_maids_uniform_486d1671:
msgid "[_cedrick_] Отлично, Элион. Вот твои 10$ за работу. Рад, что форма тебе подошла"
msgstr "[_cedrick_] Es genial, Elyon. Aquí están tus $10 por trabajo. Me alegro de que el formulario te convenga"

# game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:27 #-#-# translate crowdin ask_elyon_to_dust_in_maids_uniform_8f49d722:
msgid "[_elion_] Спасибо, Рик, она и вправду очень удобная. Хоть я и чувствую себя в ней так, словно я голая.."
msgstr "[_elion_] Gracias, Rick, ella es muy cómoda. Aunque siento que estoy desnuda."

# game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:28 #-#-# translate crowdin ask_elyon_to_dust_in_maids_uniform_6309eea1:
msgid "[_cedrick_] Так и задумано"
msgstr "[_cedrick_] Está diseñado"

# game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:33 #-#-# translate crowdin ask_elyon_to_dust_in_maids_uniform_2ae0b979:
msgid "[_cedrick_] Эм, Элион, ну как тебе новая форма? Как ощущения?"
msgstr "[_cedrick_] Em, Elyon, ¿te gusta una nueva forma? ¿Cómo te sientes?"

# game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:34 #-#-# translate crowdin ask_elyon_to_dust_in_maids_uniform_f197f7ac:
msgid "[_elion_] Она действительно очень удобная, Рик. Я ее практически не чувствую на себе"
msgstr "[_elion_] Es muy cómodo, Rick. Casi ni noto que lo llevo puesto."

# game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:35 #-#-# translate crowdin ask_elyon_to_dust_in_maids_uniform_07b57659:
msgid "[_cedrick_] Хм, очень интересно. Дай-ка еще раз посмотреть, что это за чудесный такой материал"
msgstr "[_cedrick_] Hmm, muy interesante. Permítanme ver de nuevo qué es este maravilloso material"

# game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:39 #-#-# translate crowdin ask_elyon_to_dust_in_maids_uniform_2fc5eb9f:
msgid "[_elion_] Р-рик! Что ты делаешь!? Нас могут увидеть!"
msgstr "[_elion_] ¡R-Rick! ¿¡Qué estás haciendo!? ¡Nos pueden ver!"

# game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:40 #-#-# translate crowdin ask_elyon_to_dust_in_maids_uniform_710aa1bf:
msgid "[_cedrick_] Я не смог удержаться. Ты стоишь тут, выпятив зад, да еще и в одних трусиках, что так и хочется с тебя их сорвать"
msgstr "[_cedrick_] No pude resistirme. Te paras aquí, te desmoronas el culo, e incluso en algunas panties, que quieres arrancarte"

# game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:43 #-#-# translate crowdin ask_elyon_to_dust_in_maids_uniform_42d1dc1d:
msgid "[_elion_] Р-рик.. Не здесь, пожалуйста.."
msgstr "[_elion_] R-Rick… Aquí no, por favor."

# game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:45 #-#-# translate crowdin ask_elyon_to_dust_in_maids_uniform_f979afe8:
msgid "[_cedrick_] Хах.. Ладно, а то еще упадешь. Хорошо, слезай. Вот твои 10$"
msgstr "[_cedrick_] H. H… Muy bien, te caerás. Muy bien, baja. Aquí tienes tus $10"

# game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:46 #-#-# translate crowdin ask_elyon_to_dust_in_maids_uniform_054ef1c6:
msgid "[_elion_] С-спасибо…"
msgstr "[_elion_] Gracias…"

# game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:47 #-#-# translate crowdin ask_elyon_to_dust_in_maids_uniform_3337fcef:
msgid "[_cedrick_] И, Элион, у тебя все еще отличная киска"
msgstr "[_cedrick_] Y, Elyon, todavía tienes un gran coño"

# game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:48 #-#-# translate crowdin ask_elyon_to_dust_in_maids_uniform_dea913dd:
msgid "[_elion_] Р-рик, хватит! Т-ты смущаешь меня.."
msgstr "[_elion_] ¡R-Rick, ya basta! Me estás avergonzando."

# §translate crowdin strings: #|#|# # game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:21
msgid "Снять трусики с элион?"
msgstr "¿Quitarle la ropa interior a Elyon?"

# game/scripts/quests/theMaidsUniformForEyion/ask_elyon_to_dust_in_maids_uniform.rpy:21
msgid "Снять"
msgstr "Quitar"

