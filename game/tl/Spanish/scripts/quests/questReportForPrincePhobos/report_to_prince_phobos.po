# TODO: Translation updated at 2023-07-25 15:55 #|#|# # game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:4 #-#-# translate crowdin report_to_prince_phobos_71772b4c:
msgid "[_phobos_] А вот и ты, Седрик. Как ты посмел опоздать на доклад!?"
msgstr "[_phobos_] Y aquí está, Cedric. ¡¿Cómo te atreves a llegar tarde al informe?!"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:5 #-#-# translate crowdin report_to_prince_phobos_41b574d6:
msgid "[_cedrick_] Прошу прощения, Князь Фобос. Моя задержка была связана с нашей главной целью, вашей сестрой Элион"
msgstr "[_cedrick_] Le pido disculpas, príncipe Fobos. Mi demora estuvo relacionada con nuestro principal objetivo: su hermana Elyon."

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:9 #-#-# translate crowdin report_to_prince_phobos_2c813bda:
msgid "[_phobos_] Меня не волнуют твои оправдания."
msgstr "[_phobos_] No me importan tus excusas."

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:10 #-#-# translate crowdin report_to_prince_phobos_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] …"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:14 #-#-# translate crowdin report_to_prince_phobos_2df9a143:
msgid "[_phobos_] Каковы результаты твоей миссии под прикрытием? Чего ты достиг за столь долгий срок?"
msgstr "[_phobos_] ¿Cuáles son los resultados de su misión encubierta? ¿Qué has conseguido en tanto tiempo?"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:18 #-#-# translate crowdin report_to_prince_phobos_304ee2fd:
msgid "[_cedrick_] Элион почти полностью под моим контролем, милорд. А наше главное препятствие в виде стражниц завесы практически полностью разгромлено"
msgstr "[_cedrick_] Elyon está casi completamente bajo mi control, mi señor. Y nuestro principal obstáculo en forma de guardianas del velo es casi completamente derrotado"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:22 #-#-# translate crowdin report_to_prince_phobos_0507030a:
msgid "[_phobos_] И каким же образом, Седрик?"
msgstr "[_phobos_] ¿Y cómo, Cedric?"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:26 #-#-# translate crowdin report_to_prince_phobos_c55340c4:
msgid "[_cedrick_] К каждой из них я нашел персональный подход, втерся в доверие, подобрался максимально близко к ним и их семьям"
msgstr "[_cedrick_] Para cada uno de ellos encontré un enfoque personal, gemido en la confianza, me acerqué lo más posible a ellos y a sus familias"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:27 #-#-# translate crowdin report_to_prince_phobos_2db92938:
msgid "[_cedrick_] Они даже не заметили, как я обвил хвостом горло каждой из этих дрянных девчонок.. Метафорически, конечно же. По крайней мере пока"
msgstr "[_cedrick_] Ni siquiera se dieron cuenta de que tenía una cola de cada una de estas chicas cagadas. Metafóricamente, por supuesto. Al menos no todavía"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:28 #-#-# translate crowdin report_to_prince_phobos_125ab36c:
msgid "[_cedrick_] Скоро вы и сами во всем убедитесь"
msgstr "[_cedrick_] Pronto usted y usted verá para todo"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:29 #-#-# translate crowdin report_to_prince_phobos_0093a1b9:
msgid "[_cedrick_] Параллельно с этим я пустил корни в правительственную систему всего Шеффилда"
msgstr "[_cedrick_] En paralelo a esto, eché raíces en el sistema de gobierno de todo Sheffield"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:30 #-#-# translate crowdin report_to_prince_phobos_e887bcb4:
msgid "[_cedrick_] Я могу принять облик одного из полицейских, полностью заменив его. Правительственный агент в этом городе сама того не зная стала моей подчиненной"
msgstr "[_cedrick_] Puedo tomar la cara de uno de los policías, reemplazándolo por completo. El agente del gobierno en esta ciudad no sabía que se convirtió en mi subordinado"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:31 #-#-# translate crowdin report_to_prince_phobos_ed21aade:
msgid "[_cedrick_] Не говоря уже о том, что представительница судебного органа теперь у меня на поводке из-за всплывших о ней грязных подробностей, которыми я владею"
msgstr "[_cedrick_] Sin mencionar el hecho de que el representante de la autoridad judicial ahora tiene una correa debido a los detalles sucios que se me han ocurrido, que tengo"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:35 #-#-# translate crowdin report_to_prince_phobos_aaf11263:
msgid "[_phobos_] Хм, звучит так, словно у тебя абсолютно все под контролем и дела идут без каких либо проблем, настолько сладкими речами ты говоришь"
msgstr "[_phobos_] Hmm, suena como si tuvieras absolutamente todo bajo control y el negocio no tiene ningún problema, así que dulces discursos que dices"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:37 #-#-# translate crowdin report_to_prince_phobos_d40dce7e:
msgid "[_cedrick_] Премного благодарен столь высокой оценкой, мой князь. Я был бы искренне рад, если бы дела обстояли именно так"
msgstr "[_cedrick_] Le agradezco mucho tan alta valoración, mi príncipe. Me alegraría sinceramente que así fuera."

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:41 #-#-# translate crowdin report_to_prince_phobos_cc056de9:
msgid "[_cedrick_] На деле же каждый из этих этапов имел свои трудности. Полицейского, чье тело я заменил, сейчас находится на подводной шахте"
msgstr "[_cedrick_] Sin embargo, cada una de esas etapas tuvo sus dificultades. El policía cuyo cuerpo suplanté está ahora en la mina submarina."

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:42 #-#-# translate crowdin report_to_prince_phobos_e8c0e4dd:
msgid "[_cedrick_] Правительственного агента я подчинил, находясь на тот момент у грани своих физических и моральных сил"
msgstr "[_cedrick_] Sometí al agente del gobierno cuando ya estaba al límite de mis fuerzas físicas y morales."

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:43 #-#-# translate crowdin report_to_prince_phobos_027093f9:
msgid "[_cedrick_] Даже судья попала в мои благодаря тому, что я находился в изначально отчаянном положении. Только попав в суд как обвиняемый, я смог до нее добраться"
msgstr "[_cedrick_] Incluso el juez estaba en mi camino porque estaba en una situación desesperada. Solo después de ser juzgado como acusado, pude llegar a ella"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:44 #-#-# translate crowdin report_to_prince_phobos_091bef94:
msgid "[_cedrick_] Не говоря уже о множестве других жителях земли, которых я поймал и отправил на подводные шахты в наш мир, либо подставил и посадил в земную тюрьму"
msgstr "[_cedrick_] Por no hablar de los muchos otros habitantes de la tierra, a quienes atrapé y envié a las minas submarinas de nuestro mundo, ya sea enmarcados y puestos en una prisión terrestre"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:48 #-#-# translate crowdin report_to_prince_phobos_f0a04c60:
msgid "[_phobos_] Иными словами..."
msgstr "[_phobos_] En otras palabras…"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:49 #-#-# translate crowdin report_to_prince_phobos_49316299_1:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] …"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:53 #-#-# translate crowdin report_to_prince_phobos_9bfa77cf:
msgid "[_phobos_] На твоем пути было множество преград, каждую из которых ты успешно устранил. Как и одну из последних, а именно Короля Морпионов"
msgstr "[_phobos_] Había muchos obstáculos en su camino, cada uno de los cuales eliminó con éxito. Como uno de los últimos, es decir, el Rey de los Morpiones"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:54 #-#-# translate crowdin report_to_prince_phobos_2d214d15:
msgid "[_phobos_] Это заслуживает уважения, Седрик. Не с моей стороны, но со стороны стражников так точно"
msgstr "[_phobos_] Merece respeto, Cedric. No por mi parte, pero los guardias con tanta precisión"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:58 #-#-# translate crowdin report_to_prince_phobos_34566bd1:
msgid "[_cedrick_] Благодарю, Князь Фобос"
msgstr "[_cedrick_] Gracias, príncipe Fobos"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:62 #-#-# translate crowdin report_to_prince_phobos_583e1634:
msgid "[_phobos_] О людях, попавших на наши шахты я был осведомлен с самого начала. Неужели ты думал, что подобная деталь сможет ускользнуть от моих глаз?"
msgstr "[_phobos_] Sobre la gente que vino a nuestras minas he sido consciente desde el principio. ¿Pensaste que tal detalle podría escapar de mis ojos?"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:66 #-#-# translate crowdin report_to_prince_phobos_2ac60f98:
msgid "[_cedrick_] Никак нет, ваша светлость. Я не хотел докучать вам, докладывая о каждом новом поступившем на шахты землянине"
msgstr "[_cedrick_] No está ahí, señoría. No quería molestarte informando sobre cada nuevo terrícola recibido en las minas"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:67 #-#-# translate crowdin report_to_prince_phobos_7bb75c69:
msgid "[_cedrick_] В мои планы входило доложить вам обо всем в более значимый момент, чтобы не тратить ваше время попусту"
msgstr "[_cedrick_] En mis planes era informarle sobre todo en un punto más significativo, para no perder su tiempo"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:71 #-#-# translate crowdin report_to_prince_phobos_3f70a02b:
msgid "[_phobos_] Это было правильным решением, Седрик"
msgstr "[_phobos_] Fue la decisión correcta, Cedric"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:72 #-#-# translate crowdin report_to_prince_phobos_461c5124:
msgid "[_phobos_] Знаешь, Райтер докладывал мне о каждом, кто поступал на наши шахты и хоть как-то был похож на землянина"
msgstr "[_phobos_] Sabes, Reiter me informaba sobre todos los que llegaban a nuestras minas y se parecían aunque fuera un poco a alguien de la Tierra."

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:74 #-#-# translate crowdin report_to_prince_phobos_7ec9e3a7:
msgid "[_phobos_] Он явно хотел еще больше испортить тебе жизнь. Но я решил подождать и посмотреть, как долго ты будешь держать эту информацию при себе"
msgstr "[_phobos_] Él claramente quería arruinar tu vida aún más. Pero decidí esperar y ver cuánto tiempo mantendrás esta información contigo"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:75 #-#-# translate crowdin report_to_prince_phobos_011efde4:
msgid "[_phobos_] По итогу могу лишь сказать, что в твоих действиях и вправду не было злого умысла, ведь ты доложил мне обо всем"
msgstr "[_phobos_] Como resultado, solo puedo decir que en tus acciones realmente no había intención maliciosa, porque me reportaste sobre todo"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:76 #-#-# translate crowdin report_to_prince_phobos_2789dc7b:
msgid "[_cedrick_] Благодарю вас за то, что доверились мне, Князь Фобос. У Райтера не было и шанса, когда он решил манипулировать вами подобным образом"
msgstr "[_cedrick_] Gracias por confiar en mí, príncipe Fobos. Reiter no tuvo oportunidad cuando decidió manipularte de esta manera"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:80 #-#-# translate crowdin report_to_prince_phobos_632bb5e5:
msgid "[_phobos_] Да, этот идиот все больше начинает меня разочаровывать. Я бы давно его уже казнил, но у нас осталось не так уж и много компетентных людей.."
msgstr "[_phobos_] Sí, este idiota está empezando a decepcionarme cada vez más. Lo habría ejecutado hace mucho tiempo, pero no nos quedan tanta gente competente."

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:81 #-#-# translate crowdin report_to_prince_phobos_49316299_2:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] …"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:85 #-#-# translate crowdin report_to_prince_phobos_214f6813:
msgid "[_phobos_] Что касается Элион, Седрик, я надеюсь в скором времени ты приведешь ее ко мне"
msgstr "[_phobos_] En cuanto a Elyon, Cedric, espero que me lo traiga pronto"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:86 #-#-# translate crowdin report_to_prince_phobos_1e10a721:
msgid "[_cedrick_] Да, Князь Фобос. Я делаю для этого все, что в моих силах и даже больше"
msgstr "[_cedrick_] Sí, príncipe Fobos. Hago todo lo que está en mi poder y aún más"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:90 #-#-# translate crowdin report_to_prince_phobos_234e4284:
msgid "[_phobos_] Именно на такую отдачу я и рассчитываю, Седрик"
msgstr "[_phobos_] Exactamente para este regreso cuento, Cedric"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:91 #-#-# translate crowdin report_to_prince_phobos_cf354c77:
msgid "[_cedrick_] И еще одна деталь, мой Князь…"
msgstr "[_cedrick_] Y otro detalle, mi príncipe…"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:95 #-#-# translate crowdin report_to_prince_phobos_cb2b21fe:
msgid "[_phobos_] Что еще, Седрик?"
msgstr "[_phobos_] ¿Qué más, Cedric?"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:96 #-#-# translate crowdin report_to_prince_phobos_a84d5170:
msgid "[_cedrick_] Алхими, девушка с земли, отданная вам в дар. Боюсь, ей придется вернуться на Землю…"
msgstr "[_cedrick_] Alchemy, una chica de la tierra, te la dieron como regalo. Me temo que tendrá que volver a la Tierra…"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:100 #-#-# translate crowdin report_to_prince_phobos_3bfdc471:
msgid "[_phobos_] Ты отдал мне ее в качестве извинений, а теперь смеешь просить, чтобы я отдать ее?! Говоришь мне подобные вещи прямо в лицо, Седрик!?"
msgstr "[_phobos_] Me lo diste como disculpa, y ahora te atreves a pedirme que lo dé?! ¿Me estás diciendo cosas como esa en la cara, Cedric!?"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:101 #-#-# translate crowdin report_to_prince_phobos_49316299_3:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] …"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:102 #-#-# translate crowdin report_to_prince_phobos_43a64b3b:
msgid "[_phobos_] ..."
msgstr "[_phobos_] …"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:106 #-#-# translate crowdin report_to_prince_phobos_70a495a2:
msgid "[_phobos_] Хаха, насмешил ты меня, Седрик. Мне хотелось увидеть твою реакцию. К моему удивлению ты встретил мою ярость с достоинством"
msgstr "[_phobos_] Haha, me estás haciendo reír, Cedric. Quería ver tu reacción. Para mi sorpresa, conociste mi rabia con dignidad"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:107 #-#-# translate crowdin report_to_prince_phobos_ec88b4b3:
msgid "[_phobos_] Конечно, Седрик, конечно, девочка не может вот так просто взять и пропасть из мира людей, даже с промытыми мозгами"
msgstr "[_phobos_] Por supuesto, Cedric, por supuesto, una chica no puede simplemente quitarle el mundo a la gente, incluso con el cerebro lavado"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:108 #-#-# translate crowdin report_to_prince_phobos_2b65159d:
msgid "[_phobos_] Будь все так просто, Элион уже давно была бы здесь в качестве моей персональной подставки для ног"
msgstr "[_phobos_] Era tan simple, Elyon habría estado aquí hace mucho tiempo como mi pila personal de piernas"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:109 #-#-# translate crowdin report_to_prince_phobos_49316299_4:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] …"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:110 #-#-# translate crowdin report_to_prince_phobos_e21457bb:
msgid "[_phobos_] Если ее нужно вернуть для того, чтобы твоя миссия оставалась в тайне, то так тому и быть"
msgstr "[_phobos_] Si necesita devolverlo para que su misión permanezca en secreto, entonces que así sea"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:111 #-#-# translate crowdin report_to_prince_phobos_42ff2712:
msgid "[_phobos_] К тому же эта игрушка уже успела мне надоесть, знаешь ли.."
msgstr "[_phobos_] Además, este juguete ya ha logrado aburrirse, ya sabes."

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:112 #-#-# translate crowdin report_to_prince_phobos_13f35135:
msgid "[_cedrick_] Прошу прощения за то, что предоставленная мною девушка не смогла оправдать всех ваших ожиданий"
msgstr "[_cedrick_] Le pido disculpas porque la chica que le proporcioné no cumplió todas sus expectativas."

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:116 #-#-# translate crowdin report_to_prince_phobos_627b3866:
msgid "[_phobos_] Она ни первая и далеко не последняя, Седрик. Было бы удивительно, если бы простая землянка смогла удовлетворить все желания Князя, не находишь?"
msgstr "[_phobos_] No es la primera ni será la última, Cedric. Sería sorprendente que una simple terrícola pudiera satisfacer todos los deseos del príncipe, ¿no crees?"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:117 #-#-# translate crowdin report_to_prince_phobos_a18df50a:
msgid "[_cedrick_] Это верно…"
msgstr "[_cedrick_] Esto es cierto…"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:121 #-#-# translate crowdin report_to_prince_phobos_15fce169:
msgid "[_phobos_] Она твоя, Седрик, можешь забрать ее"
msgstr "[_phobos_] Ella es tuya, Cedric, puedes tomarla"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:125 #-#-# translate crowdin report_to_prince_phobos_8b04642e:
msgid "[_phobos_] На этом все, ты свободен. Можешь идти"
msgstr "[_phobos_] Se trata de, eres libre. Puedes irte"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:129 #-#-# translate crowdin report_to_prince_phobos_3ae5a24a:
msgid "[_cedrick_] Благодарю, мой милорд"
msgstr "[_cedrick_] Gracias, mi señor"

