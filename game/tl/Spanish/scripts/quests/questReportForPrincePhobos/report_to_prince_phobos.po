# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:136 #-#-# translate crowdin report_to_prince_phobos_243dfb83:
msgid "[_phobos_] И еще кое-что, Седрик"
msgstr "[_phobos_] Y otra cosa, Cedric"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:137 #-#-# translate crowdin report_to_prince_phobos_6586ca6b:
msgid "[_cedrick_] ..Я вас слушаю"
msgstr "[_cedrick_] … Te escucho"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:141 #-#-# translate crowdin report_to_prince_phobos_77da3399:
msgid "[_phobos_] С тобой что-то произошло? Ты какой-то.. Ни такой, как обычно. Более собранный. Более серьезный. Более внимательный к словам"
msgstr "[_phobos_] ¿Te ha pasado algo? Eres una especie de… No es así como siempre. Más recogidos. Más serio. Más atento a las palabras"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:142 #-#-# translate crowdin report_to_prince_phobos_557071e9:
msgid "[_phobos_] Исходящая от тебя энергия немного поменялась. Что случилось?"
msgstr "[_phobos_] La energía que emanas ha cambiado un poco. ¿Qué ocurrió?"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:146 #-#-# translate crowdin report_to_prince_phobos_2e44b966:
msgid "[_cedrick_] Это.. Это результат экспериментов Миранды, мой князь. В последнем сражении Король Морпионов знатно меня потрепал"
msgstr "[_cedrick_] Es… Este es el resultado de los experimentos de Miranda, mi príncipe. En la última batalla, el rey de los Morpiones me golpeó"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:147 #-#-# translate crowdin report_to_prince_phobos_d623dd96:
msgid "[_cedrick_] Миранда подлатала меня своими зельями, но видимо они дали своего рода побочный эффект"
msgstr "[_cedrick_] Miranda me dibujó con sus pociones, pero al parecer dieron una especie de efecto secundario"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:151 #-#-# translate crowdin report_to_prince_phobos_2af335d9:
msgid "[_phobos_] Хм… Это вполне естественно, что тебе было тяжко в сражении с королем Морпионов, учитывая, что я забрал часть твоей силы"
msgstr "[_phobos_] Mmm… Es natural que te costara tanto luchar contra el Rey de los Morpiones, teniendo en cuenta que te quité parte de tu poder."

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:155 #-#-# translate crowdin report_to_prince_phobos_36f761a6:
msgid "[_phobos_] Но ведь даже так ты справился, верно?"
msgstr "[_phobos_] Pero incluso eso es lo que hiciste, ¿verdad?"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:159 #-#-# translate crowdin report_to_prince_phobos_49316299_5:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] …"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:163 #-#-# translate crowdin report_to_prince_phobos_37615ee6:
msgid "[_phobos_] Что ж, я понял. Можешь идти, Седрик"
msgstr "[_phobos_] Bueno, lo entiendo. Puedes irte, Cedric"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:164 #-#-# translate crowdin report_to_prince_phobos_c4d8f4cc:
msgid "[_cedrick_] Да, милорд"
msgstr "[_cedrick_] Sí, milord"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:166 #-#-# translate crowdin report_to_prince_phobos_3770622e:
msgid "[_cedrick_] (Все прошло почти так, как я планировал. Но он.. он что-то почувствовал. Это была моя новая сила. Или же он почувствовал мое четкое желание свергнуть его?)"
msgstr "[_cedrick_] (Todo salió casi como lo planeé. Pero él es… Él sintió algo. Era mi nueva fuerza. ¿O sintió mi claro deseo de derrocarlo?)"

# game/scripts/quests/questReportForPrincePhobos/report_to_prince_phobos.rpy:167 #-#-# translate crowdin report_to_prince_phobos_a6dfd37b:
msgid "[_cedrick_] Нужно быть аккуратнее с этим"
msgstr "[_cedrick_] Debe tener cuidado con esto"

