# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:357 #-#-# translate crowdin deny_her_e16a7a1d:
msgid "[_cedrick_] (Если верить тем книгам по психологии, что я прочитал, то каждый человек ведом своими привычками)"
msgstr "[_cedrick_] (Si crees en los libros sobre psicología que he leído, entonces cada persona sabe de sus hábitos)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:358 #-#-# translate crowdin deny_her_c092d506:
msgid "[_cedrick_] (Не важно, положительно или негативно они влияют на человека, суть в том, что когда привычка сформирована, от нее очень сложно избавиться)"
msgstr "[_cedrick_] (No importa si afectan a una persona positiva o negativamente, la esencia es que cuando se forma el hábito, es muy difícil deshacerse de él)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:359 #-#-# translate crowdin deny_her_48405c2c:
msgid "[_cedrick_] (Кажется, в этом задействованы новые нейронные связи. Каждый раз их укрепляя, мозговой импульс уже невольно сам идет по протоптанной дорожке)"
msgstr "[_cedrick_] (Parece que las nuevas conexiones neuronales están involucradas en esto. Cada vez que los fortalecen, el impulso cerebral ya está sucediendo involuntariamente en el camino temblado)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:360 #-#-# translate crowdin deny_her_b405769a:
msgid "[_cedrick_] (Хах, и передо мною сейчас стоит на коленях прямое доказательство этой теории)"
msgstr "[_cedrick_] (Ja, y antes de mí ahora está de rodillas prueba directa de esta teoría)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:362 #-#-# translate crowdin deny_her_afe08a31_3:
msgid "шлепок"
msgstr "¡Bofetada"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:363 #-#-# translate crowdin deny_her_a4bdc815:
msgid "[_will_] Аааахх.. Р-рик.."
msgstr "[_will_] Aahh… R-rick…"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:365 #-#-# translate crowdin deny_her_45f0db8d:
msgid "[_tarani_] Ублюдок.. Хватит над ней издеваться.."
msgstr "[_tarani_] El bastardo… Deja de burlarte de ella…"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:366 #-#-# translate crowdin deny_her_a0211649:
msgid "[_irma_] Т-так жестко.."
msgstr "[_irma_] Tan rígidamente…"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:367 #-#-# translate crowdin deny_her_b29b7ccd:
msgid "[_irma_] (П-пожалуй просто приму свою участь.. Боюсь, если начну своевольничать, то Седрик сделает со мной то же самое..)"
msgstr "[_irma_] (Tal vez me lleve mi destino… Me temo que si empiezo a terminar, Cedric hará lo mismo conmigo.)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:368 #-#-# translate crowdin deny_her_b16758e3:
msgid "[_cedrick_] (Все пошло не по ее плану, но она так мягко встала на колени, без малейшего сопротивления. И даже сейчас она, хочет того или нет, но получает удовольствие)"
msgstr "[_cedrick_] (Las cosas no salieron según su plan, pero se arrodilló con suavidad, sin la menor resistencia. Y ahora, quiera o no, está disfrutándolo.)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:369 #-#-# translate crowdin deny_her_00b9dc36:
msgid "[_cedrick_] (Видимо я так часто ставил ее на колени, что невольно сам приучил ее преклоняться перед моим членом)"
msgstr "[_cedrick_] (Aparentemente la puse de rodillas tan a menudo que involuntariamente le enseñé a inclinarse ante mi pene)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:370 #-#-# translate crowdin deny_her_b172868b:
msgid "[_cedrick_] (Создал в ней новую привычку, которой она следует. Интересный механизм)"
msgstr "[_cedrick_] (Creado en ella un nuevo hábito que sigue. Mecanismo interesante)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:372 #-#-# translate crowdin deny_her_afe08a31_4:
msgid "шлепок"
msgstr "¡Bofetada"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:374 #-#-# translate crowdin deny_her_19ac952c:
msgid "[_will_] Р-рик.. Ууууф.. Я-я поняла тебя.. Ааахх.. Не надо так жестоко меня дразнить.."
msgstr "[_will_] R-Rick… Wuuf… Yo-yo te entiendo. Aahh… No seas tan cruel para burlarte de mí."

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:376 #-#-# translate crowdin deny_her_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] …"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:377 #-#-# translate crowdin deny_her_b0937ebf:
msgid "[_cedrick_] Отлично, вижу мы поняли друг друга. Оставайтесь здесь в подземелье и не высовывайтесь. Вашим наказанием я займусь чуть позже"
msgstr "[_cedrick_] Es genial, veo que nos entendemos. Quédate aquí en la mazmorra y no sobresalgas. Me encargaré de tu castigo un poco más tarde"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:379 #-#-# translate crowdin deny_her_bb5f0fbe:
msgid "[_will_] Х-хорошо.."
msgstr "[_will_] Muy bien."

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:390 #-#-# translate crowdin accept_her_offer_80d14c83:
msgid "[_cedrick_] (Хм.. Думаю и вправду не стоит быть таким жестоким)"
msgstr "[_cedrick_] (Mmm… Creo que en verdad no debería ser tan cruel.)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:392 #-#-# translate crowdin accept_her_offer_f09db756:
msgid "[_cedrick_] Хорошо, Вилл. Я пойду тебе навстречу. Но только в этот раз"
msgstr "[_cedrick_] Es bueno, Will. Iré a verte. Pero sólo esta vez"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:394 #-#-# translate crowdin accept_her_offer_24d81fca:
msgid "[_will_] Ах, Рик, я так рада! Давай же, засади в мою попку"
msgstr "[_will_] ¡Oh, Rick, qué feliz estoy! Vamos, métemela en el culo"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:395 #-#-# translate crowdin accept_her_offer_e529eaab:
msgid "[_cedrick_] Я не говорил, что все пойдет по твоему сценарию. Я лишь сказал, что пойду к тебе на встречу"
msgstr "[_cedrick_] No dije que todo saldría según tu plan. Solo dije que accedería a tu petición."

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:397 #-#-# translate crowdin accept_her_offer_e793f2b2:
msgid "[_will_] Ч-что? Тогда что ты имеешь ввиду?"
msgstr "[_will_] ¿Qué carajo es? Entonces, ¿qué quieres decir?"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:399 #-#-# translate crowdin accept_her_offer_71ca5676:
msgid "[_cedrick_] Повернись ко мне"
msgstr "[_cedrick_] Vuelve a mí"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:401 #-#-# translate crowdin accept_her_offer_5177ce06:
msgid "[_will_] Х-хорошо"
msgstr "[_will_] E-está bien"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:406 #-#-# translate crowdin accept_her_offer_81cd6112:
msgid "[_centered_] {size=37}Седрик поставил Вилл на колени и зажимает член между ее грудей{/size} [withdissolve]"
msgstr "[_centered_] {size=37}Cedric pone a Will de rodillas y aprieta la verga entre sus pechos{/size} [withdissolve]"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:407 #-#-# translate crowdin accept_her_offer_bb48271b:
msgid "[_cedrick_] Вот мое встречное предложение. И лучше от него не отказывайся"
msgstr "[_cedrick_] Es mi contraoferta. Y es mejor no renunciar a ella"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:408 #-#-# translate crowdin accept_her_offer_1fcce525:
msgid "[_will_] Я поняла.."
msgstr "[_will_] Entiendo…"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:413 #-#-# translate crowdin accept_her_offer_9c4756de:
msgid "[_cedrick_] Не бери его в рот. Ты можешь использовать только грудь и свои губы"
msgstr "[_cedrick_] No te lo metas en la boca. Solo puedes usar los senos y los labios"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:414 #-#-# translate crowdin accept_her_offer_f520a3a5:
msgid "[_will_] М-мгум.. Хорошо, Рик, как тебе будет угодно"
msgstr "[_will_] M-Mg… Muy bien, Rick, como quieras"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:415 #-#-# translate crowdin accept_her_offer_c2376d2d:
msgid "[_cedrick_] Хорошая девочка. Продолжай в том же духе"
msgstr "[_cedrick_] Buena chica. Sigue así."

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:416 #-#-# translate crowdin accept_her_offer_cbd03df4:
msgid "[_cedrick_] (Возможно, если я пойду ей навстречу и покажу, что буду добр с ней, когда она четко следует указаниям и не своевольничает, то она станет послушнее в будущем)"
msgstr "[_cedrick_] (Tal vez si voy a encontrarla y le muestro que seré amable con ella cuando siga claramente las instrucciones y no suplique, se volverá más obediente en el futuro)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:417 #-#-# translate crowdin accept_her_offer_5bf5c59d:
msgid "[_will_] Мммввв.. Рик, тебе хорошо?"
msgstr "[_will_] Mmmuvv… Rick, ¿estás bien?"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:418 #-#-# translate crowdin accept_her_offer_5ac72e8f:
msgid "[_cedrick_] Продолжай в том же духе"
msgstr "[_cedrick_] Sigue así."

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:419 #-#-# translate crowdin accept_her_offer_f6479420:
msgid "[_cedrick_] (Это должно быть хорошим примером для Ирмы и Тарани. Интересно, как они воспримут такой мой шаг)"
msgstr "[_cedrick_] (Este debería ser un buen ejemplo para Irma y Taranee. Me pregunto cómo darán mi paso.)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:420 #-#-# translate crowdin accept_her_offer_fd011589:
msgid "[_cedrick_] (Пожалуй, сейчас и стоит проверить)"
msgstr "[_cedrick_] (Tal vez ahora vale la pena comprobar)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:421 #-#-# translate crowdin accept_her_offer_b7cf6ea1:
msgid "[_cedrick_] (Вилл не получит желаемого и даже если заставит меня кончить, то все достанется другим девушкам)"
msgstr "[_cedrick_] (Will no conseguirá lo que quiere. Aunque haga que me corra, todo terminará sobre las otras chicas.)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:422 #-#-# translate crowdin accept_her_offer_6aa6e85e:
msgid "[_cedrick_] (Таким будет наказание для Вилл и проверка реакции Тарани и Ирмы)"
msgstr "[_cedrick_] (Esto será un castigo para Will y comprobar la reacción de Taranee e Irma)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:423 #-#-# translate crowdin accept_her_offer_50b14c0f:
msgid "[_will_] Ммммввв.. Правда мои губы очень мягкие?"
msgstr "[_will_] Mmmuvv… ¿Mis labios son muy suaves?"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:424 #-#-# translate crowdin accept_her_offer_008f482f:
msgid "[_cedrick_] Ух, да, ты работаешь ими все лучше и лучше"
msgstr "[_cedrick_] Uh, sí, trabajas mejor y mejor"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:425 #-#-# translate crowdin accept_her_offer_519a9d07:
msgid "[_cedrick_] (Хах, она так на меня смотрит.. Явно думает, что такого небольшого жеста послушания достаточно..)"
msgstr "[_cedrick_] (Ja, ella me está mirando así. Obviamente piensa que un gesto tan pequeño de obediencia es suficiente.)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:426 #-#-# translate crowdin accept_her_offer_49b3908d:
msgid "[_will_] А моя грудь, Рик? Такая упругая и плотная, твоему члену хорошо?"
msgstr "[_will_] ¿Son mis pechos, Rick? Tan elástico y denso, ¿tu verga es buena?"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:427 #-#-# translate crowdin accept_her_offer_d2367e1a:
msgid "[_cedrick_] Хах, все отлично, Вилл. Таким темпом я скоро кончу"
msgstr "[_cedrick_] Ja, todo es genial, Will. A este ritmo pronto terminaré"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:428 #-#-# translate crowdin accept_her_offer_c4cc513c:
msgid "[_will_] Аааммм. Тогда сделай это прямо на меня, Рик! Я так этого хочу!!"
msgstr "[_will_] Aamm. ¡Entonces hazlo bien conmigo, Rick! ¡Eso es lo que quiero!!"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:429 #-#-# translate crowdin accept_her_offer_85fe53a8:
msgid "[_cedrick_] Ууухх.. К-как бы ни так, дорогая"
msgstr "[_cedrick_] ¿Por qué… Sea lo que sea, cariño"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:432 #-#-# translate crowdin accept_her_offer_344a32eb:
msgid "[_will_] Ч-что!?"
msgstr "[_will_] ¿¡Qué!?"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:433 #-#-# translate crowdin accept_her_offer_4fbf68eb:
msgid "[_cedrick_] (И так, кто же это будет? Тарани или Ирма)"
msgstr "[_cedrick_] (Y así, ¿quién será? Taranee o Irma)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:444 #-#-# translate crowdin cumshot_to_irma_efbdf396:
msgid "[_cedrick_] И-ирма, приготовься принять на себя результат трудов Вилл"
msgstr "[_cedrick_] Y-yo-Yo-Irma, prepárate para asumir el resultado de las obras de Will"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:445 #-#-# translate crowdin cumshot_to_irma_e4d9fb71:
msgid "[_will_] Ч-что!? Н-нет.."
msgstr "[_will_] ¿¡Qué!? No. No."

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:446 #-#-# translate crowdin cumshot_to_irma_b1f03f5b:
msgid "[_irma_] А-ага, я поняла"
msgstr "[_irma_] A-aha, lo entiendo"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:451 #-#-# translate crowdin cumshot_to_irma_4d55e0fc:
msgid "[_cedrick_] Ууухх, п-получай!"
msgstr "[_cedrick_] Uuuh… ¡T-toma!"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:453 #-#-# translate crowdin cumshot_to_irma_64d929d1:
msgid "[_irma_] Аааамм"
msgstr "[_irma_] Aaaammm…"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:454 #-#-# translate crowdin cumshot_to_irma_6c8becde:
msgid "[_cedrick_] (Ух, ч-черт, она и вправду приготовилась.. Поставила руки так, чтобы не проронить ни капли)"
msgstr "[_cedrick_] (Uf, m-mierda, de verdad vino preparada… Puso las manos de modo que no se derramara ni una gota.)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:455 #-#-# translate crowdin cumshot_to_irma_3290a8c9:
msgid "[_cedrick_] К-кончаю!!"
msgstr "[_cedrick_] ¡M-me corro!"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:458 #-#-# translate crowdin cumshot_to_irma_64d929d1_1:
msgid "[_irma_] Аааамм"
msgstr "[_irma_] Aaaammm…"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:459 #-#-# translate crowdin cumshot_to_irma_4e91de20:
msgid "[_will_] Н-несправедливо!! Это должна была быть я.."
msgstr "[_will_] Injusto!! Se suponía que era yo."

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:460 #-#-# translate crowdin cumshot_to_irma_e772367e:
msgid "[_irma_] Ааааамммвв.."
msgstr "[_irma_] Aaamammv…"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:461 #-#-# translate crowdin cumshot_to_irma_bd24a2e2:
msgid "[_cedrick_] Уффф.. Ты умница, Ирма.."
msgstr "[_cedrick_] Wuff… Eres inteligente, Irma…"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:462 #-#-# translate crowdin cumshot_to_irma_4296b83c:
msgid "[_tarani_] Какая мерзость.."
msgstr "[_tarani_] Qué abominación…"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:463 #-#-# translate crowdin cumshot_to_irma_80ebfc2f:
msgid "[_irma_] Я-я подумала, что если проявлю чуть больше инициативы и пойду навстречу, то тебе понравится и ты..."
msgstr "[_irma_] Pensé que si mostraba un poco más de iniciativa y me iba a conocer, entonces te gustará…"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:464 #-#-# translate crowdin cumshot_to_irma_8501b0c4:
msgid "[_cedrick_] Что, не стану тебя наказывать?"
msgstr "[_cedrick_] ¿Qué pasa? ¿Crees que no voy a castigarte?"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:465 #-#-# translate crowdin cumshot_to_irma_795678bb:
msgid "[_irma_] ..."
msgstr "[_irma_] …"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:466 #-#-# translate crowdin cumshot_to_irma_919f750a:
msgid "[_cedrick_] Хах, не беспокойся. Я сделаю все должным образом"
msgstr "[_cedrick_] Ja, no te preocupes. Voy a hacer todo correctamente"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:467 #-#-# translate crowdin cumshot_to_irma_4dd12bd0:
msgid "[_irma_] Х-хорошо"
msgstr "[_irma_] E-está bien"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:468 #-#-# translate crowdin cumshot_to_irma_7ff75c80:
msgid "[_will_] Сначала Корнелия, а теперь и Ирма.."
msgstr "[_will_] Primera Cornelia, y ahora Irma…"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:474 #-#-# translate crowdin cumshot_to_tarani_07da8738:
msgid "[_cedrick_] Т-тарани, сейчас ты получишь свою порцию спермы..."
msgstr "[_cedrick_] T-t-Taranee, ahora estás consiguiendo tu porción de esperma…"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:475 #-#-# translate crowdin cumshot_to_tarani_44645d7c:
msgid "[_will_] Ч-что!? Н-нет..."
msgstr "[_will_] ¿¡Qué!? No…"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:476 #-#-# translate crowdin cumshot_to_tarani_c2acd5c2:
msgid "[_tarani_] К-какого хрена, нет!!"
msgstr "[_tarani_] ¡Qué caballo, no!!"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:482 #-#-# translate crowdin cumshot_to_tarani_b0e784a6:
msgid "[_tarani_] У-ублюдок, я не просила об этом..."
msgstr "[_tarani_] Oh, bastardo, no lo pedí…"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:484 #-#-# translate crowdin cumshot_to_tarani_d4d92310:
msgid "[_tarani_] К-какого черта ты направляешь на меня свой член... Ч-чуть в рот не попало..."
msgstr "[_tarani_] ¿Por qué demonios apuntas tu verga hacia mí…? Casi me das en la boca…"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:486 #-#-# translate crowdin cumshot_to_tarani_88d844ee:
msgid "[_cedrick_] А тебя никто не спрашивает, Тарани. Делай что говорят, иначе твое наказание будет еще жестче"
msgstr "[_cedrick_] Y nadie te pregunta, Taranee. Haz lo que digan, de lo contrario tu castigo será aún más duro"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:488 #-#-# translate crowdin cumshot_to_tarani_81d83f93:
msgid "[_tarani_] Пф, думаешь мне не плевать? Что еще такого ты не делал с моим телом?"
msgstr "[_tarani_] Pf, ¿crees que no me importa? ¿Qué más le has hecho a mi cuerpo?"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:490 #-#-# translate crowdin cumshot_to_tarani_1b4d0c71:
msgid "[_cedrick_] Ох, ты даже не представляешь, что еще я мог бы с тобой сделать"
msgstr "[_cedrick_] Oh, ni siquiera sabes qué más podría hacerte"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:492 #-#-# translate crowdin cumshot_to_tarani_83552452:
msgid "[_tarani_] Ну-ну, жду не дождусь, сраный змей"
msgstr "[_tarani_] Bueno, no puedo esperar, maldita serpiente"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:493 #-#-# translate crowdin cumshot_to_tarani_7b7684fa:
msgid "[_cedrick_] (Хах, все огрызается и огрызается)"
msgstr "[_cedrick_] (Ja, no deja de responderme mal.)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:494 #-#-# translate crowdin cumshot_to_tarani_f484005c:
msgid "[_cedrick_] (Интересно. У нее есть какая-то фиксация на том, что ей нельзя кончать в рот. На полноценную слабость это не тянет, но в будущем я с этим поработаю)"
msgstr "[_cedrick_] (Interesante. Tiene alguna fijación que no puede meter en la boca. No se necesita mucha debilidad, pero en el futuro trabajaré con él)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:496 #-#-# translate crowdin cumshot_to_tarani_53e7356d:
msgid "[_cedrick_] (Как минимум это хороший показатель того, насколько она ко мне расположена)"
msgstr "[_cedrick_] (Al menos este es un buen indicador de cuánto se encuentra para mí)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:497 #-#-# translate crowdin cumshot_to_tarani_8bc1ff7c:
msgid "[_cedrick_] (Думаю, она станет полностью моей, когда я буду кончать ей в рот по ее желанию)"
msgstr "[_cedrick_] (creo que será completamente mía cuando termine su boca a petición de ella)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:498 #-#-# translate crowdin cumshot_to_tarani_cbd7aa5f:
msgid "[_cedrick_] (Но пока до этого чертовски далеко.. Пока что я вообще не знаю, как ее расколоть..)"
msgstr "[_cedrick_] (Pero hasta ahora está muy lejos… No sé cómo dividirlo todavía.)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:499 #-#-# translate crowdin cumshot_to_tarani_7bd05bdb:
msgid "[_tarani_] (Д-думаю я бы приняла член Седрика лучше..)"
msgstr "[_tarani_] (C-creo que habría recibido mejor el pene de Cedric…)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:500 #-#-# translate crowdin cumshot_to_tarani_8f5fe4c1:
msgid "[_will_] Л-ладно Корнелия, но вот Тарани!! Она же постоянно ведет себя как сучка.."
msgstr "[_will_] Está bien lo de Cornelia, ¡pero Taranee! Siempre se comporta como una perra…"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:507 #-#-# translate crowdin end_conversation_with_guards_52b29d52:
msgid "[_will_] Почему они забирают то, что должно было быть моим.."
msgstr "[_will_] ¿Por qué se llevan lo que se entendía por Mi…"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:511 #-#-# translate crowdin end_conversation_with_guards_4afb0b83:
msgid "[_cedrick_] Это часть твоего наказания, Вилл. Ты должна понять, что я решаю, что мне принадлежит и от меня зависит, как, когда и на кого я кончу"
msgstr "[_cedrick_] Es parte de tu castigo, Will. Debes entender que yo decido qué me pertenece y que depende de mí cómo, cuándo y sobre quién me corro."

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:512 #-#-# translate crowdin end_conversation_with_guards_4837d006:
msgid "[_cedrick_] Мой член тебе не принадлежит, девочка"
msgstr "[_cedrick_] Mi verga no te pertenece, chica"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:516 #-#-# translate crowdin end_conversation_with_guards_635fd754:
msgid "[_will_] Н-но.."
msgstr "[_will_] N-No."

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:517 #-#-# translate crowdin end_conversation_with_guards_83bd3652:
msgid "[_cedrick_] На этом все. Мне пора идти. Увидимся через пару дней"
msgstr "[_cedrick_] Eso es todo. Tengo que irme. Nos vemos en un par de días."

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:524 #-#-# translate crowdin epilog_d4569c07:
msgid "[_cedrick_] (Возьму воду из жизненного источника у Миранды и потом загляну в магазинчик Шеффилда)"
msgstr "[_cedrick_] (Tomo agua de una fuente de vida en Miranda y luego miro en la tienda de Sheffield)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:525 #-#-# translate crowdin epilog_202de069:
msgid "[_cedrick_] (Вся эта тема с атрибутами для наказания натолкнула меня на одну мысль)"
msgstr "[_cedrick_] (Todo este tema con atributos al castigo me llevó a un pensamiento)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:526 #-#-# translate crowdin epilog_8f7060a6:
msgid "[_cedrick_] (А ведь в мире людей полно секс-игрушек, по типу тех, что заказывала Вилл..)"
msgstr "[_cedrick_] (Y en el mundo de la gente llena de juguetes sexuales, como los que la Will ordenó.)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:527 #-#-# translate crowdin epilog_f6cf374d:
msgid "[_cedrick_] (Пожалуй, куплю одну из них и проверю в деле)"
msgstr "[_cedrick_] (Por favor, compre uno de ellos y verifique en el caso)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:528 #-#-# translate crowdin epilog_538cfbb3:
msgid "[_cedrick_] (Сейчас мне особое внимание стоит уделить Хай Лин, давно я с ней не работал)"
msgstr "[_cedrick_] (Ahora debería prestar especial atención a Hay Lin, no he trabajado con ella durante mucho tiempo)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:529 #-#-# translate crowdin epilog_964de117:
msgid "[_cedrick_] (Но стоит начать не с нее, а с ее слабостей, чтобы у меня был козырь. Думаю пора навестить ее дорогую маму)"
msgstr "[_cedrick_] (Pero es necesario empezar no con ella, sino con sus debilidades para que tenga una carta de triunfo. Creo que es hora de visitar a su querida madre)"

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:532 #-#-# translate crowdin epilog_1a078262:
msgid "[_centered_] {size=37}Седрик получает воду из жизненного источника{/size} [withDissolve1]"
msgstr "[_centered_] {size=37}Cedric recibe agua de una fuente de vida{/size} [withDissolve1]"

