# TODO: Translation updated at 2023-07-25 15:55 #|#|# # game/scripts/quests/questReportForPrincePhobos/cedric_monologue_in_the_bookshop.rpy:3 #-#-# translate crowdin cedric_monologue_in_the_bookshop_41c4e7ce:
msgid "[_cedrick_] (Итак, я отдохнул и набрался сил. Теперь нужно спланировать свои дальнейшие действия..)"
msgstr "[_cedrick_] (Ya descansé y recuperé fuerzas. Ahora debo planear mis próximos pasos…)"

# game/scripts/quests/questReportForPrincePhobos/cedric_monologue_in_the_bookshop.rpy:4 #-#-# translate crowdin cedric_monologue_in_the_bookshop_a2d46730:
msgid "[_cedrick_] (Перед выходом из суда я попросил Алхими дождаться Вилл, Ирму и Корнелию, чтобы они вместе отправились на Меридиан)"
msgstr "[_cedrick_] (Antes de salir del tribunal, le pedí a Alchemy que esperara a Will, Irma y Cornelia para que fueran juntas a Meridian.)"

# game/scripts/quests/questReportForPrincePhobos/cedric_monologue_in_the_bookshop.rpy:5 #-#-# translate crowdin cedric_monologue_in_the_bookshop_c82dbcc3:
msgid "[_cedrick_] (Там их должен встретить Булдж и незаметно провести в замок. Заодно проверю надежность Булджа как главного исполнителя)"
msgstr "[_cedrick_] (Bulj debe recibirlas allí y conducirlas al castillo sin llamar la atención. De paso comprobaré si es fiable como principal ejecutor de mis planes.)"

# game/scripts/quests/questReportForPrincePhobos/cedric_monologue_in_the_bookshop.rpy:6 #-#-# translate crowdin cedric_monologue_in_the_bookshop_098ae814:
msgid "[_cedrick_] (Хм, мне уже тоже пора бы выдвигаться)"
msgstr "[_cedrick_] (Mmm, ya es hora de que yo también me ponga en marcha.)"

# game/scripts/quests/questReportForPrincePhobos/cedric_monologue_in_the_bookshop.rpy:7 #-#-# translate crowdin cedric_monologue_in_the_bookshop_2a66d640:
msgid "[_cedrick_] (Сегодняшний день ознаменуется началом падения стражниц)"
msgstr "[_cedrick_] (Hoy marca el comienzo de la caída de las Guardianas)"

# game/scripts/quests/questReportForPrincePhobos/cedric_monologue_in_the_bookshop.rpy:8 #-#-# translate crowdin cedric_monologue_in_the_bookshop_db3513a3:
msgid "[_cedrick_] (Основная проблема - Тарани и Хай Лин)"
msgstr "[_cedrick_] (Los principales problemas son Taranee y Hay Lin.)"

# game/scripts/quests/questReportForPrincePhobos/cedric_monologue_in_the_bookshop.rpy:9 #-#-# translate crowdin cedric_monologue_in_the_bookshop_f0162614:
msgid "[_cedrick_] (С Хай Лин я давно не пересекался, она не ходила на мои уроки и не присоединилась к совместной атаке Ирмы и Тарани)"
msgstr "[_cedrick_] (Hace mucho que no coincido con Hay Lin: no asistió a mis clases ni participó en el ataque conjunto de Irma y Taranee.)"

# game/scripts/quests/questReportForPrincePhobos/cedric_monologue_in_the_bookshop.rpy:10 #-#-# translate crowdin cedric_monologue_in_the_bookshop_760157bc:
msgid "[_cedrick_] (Даже вся эта судебная история обошла ее стороной. Хм, она явно пытается держаться от меня подальше. Возможно даже от всей истории со стражницами)"
msgstr "[_cedrick_] (Incluso quedó al margen de todo el asunto del tribunal. Mmm, es evidente que intenta mantenerse lejos de mí, quizá incluso de todo lo relacionado con las Guardianas.)"

# game/scripts/quests/questReportForPrincePhobos/cedric_monologue_in_the_bookshop.rpy:11 #-#-# translate crowdin cedric_monologue_in_the_bookshop_c12307c6:
msgid "[_cedrick_] (Пожалуй стоит ей напомнить, что моя помощь ей необходима)"
msgstr "[_cedrick_] (Debería recordarle que necesita mi ayuda.)"

# game/scripts/quests/questReportForPrincePhobos/cedric_monologue_in_the_bookshop.rpy:12 #-#-# translate crowdin cedric_monologue_in_the_bookshop_ec0b5776:
msgid "[_cedrick_] (Другая проблема - Тарани. Если рычаги давления на Хай Лин я знаю и поработать с ее сознанием не будет большой проблемой. То вот Тарани..)"
msgstr "[_cedrick_] (El otro problema es Taranee. Conozco los medios para presionar a Hay Lin y no será difícil trabajar en su mente. Pero Taranee…)"

# game/scripts/quests/questReportForPrincePhobos/cedric_monologue_in_the_bookshop.rpy:13 #-#-# translate crowdin cedric_monologue_in_the_bookshop_8fbc0d66:
msgid "[_cedrick_] (Черт.. В чем же слабость этой девчонки, я должен выяснить. Иначе в будущем ее несломленный характер может создать брешь во всем моем плане)"
msgstr "[_cedrick_] (Mierda… Debo descubrir cuál es la debilidad de esa mujer. De lo contrario, su carácter indomable podría abrir una brecha en todo mi plan.)"

# game/scripts/quests/questReportForPrincePhobos/cedric_monologue_in_the_bookshop.rpy:14 #-#-# translate crowdin cedric_monologue_in_the_bookshop_555881dc:
msgid "[_cedrick_] (Хм, можем Миранда сможет подсказать? Думаю у нее найдется какое-нибудь очередное зелье на этот случай)"
msgstr "[_cedrick_] (Mmm, quizá Miranda pueda orientarme. Seguro que tiene alguna otra poción para un caso así.)"

# game/scripts/quests/questReportForPrincePhobos/cedric_monologue_in_the_bookshop.rpy:15 #-#-# translate crowdin cedric_monologue_in_the_bookshop_f3238a53:
msgid "[_cedrick_] (Но перед этим.. Я должен предстать перед Фобосом с докладом о последних событиях..)"
msgstr "[_cedrick_] (Pero antes de… Tengo que comparecer ante Fobos con un informe sobre los últimos acontecimientos.)"

# game/scripts/quests/questReportForPrincePhobos/cedric_monologue_in_the_bookshop.rpy:16 #-#-# translate crowdin cedric_monologue_in_the_bookshop_48558f38:
msgid "[_cedrick_] (Благо в этот раз я заранее все продумал и предугадал его каверзные вопросы. На столько, на сколько это возможно...)"
msgstr "[_cedrick_] (Por suerte, esta vez lo pensé todo de antemano y anticipé sus preguntas capciosas… en la medida de lo posible.)"

# game/scripts/quests/questReportForPrincePhobos/cedric_monologue_in_the_bookshop.rpy:17 #-#-# translate crowdin cedric_monologue_in_the_bookshop_37813957:
msgid "[_cedrick_] (Пора выдвигаться)"
msgstr "[_cedrick_] (Es hora de salir)"

