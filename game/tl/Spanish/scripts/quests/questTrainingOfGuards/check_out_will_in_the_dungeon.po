# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:5 #-#-# translate crowdin check_out_will_in_the_dungeon_2773c5d4:
msgid "[_cedrick_] Булдж, я вернулся"
msgstr "[_cedrick_] Bulj, estoy de vuelta"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:6 #-#-# translate crowdin check_out_will_in_the_dungeon_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:7 #-#-# translate crowdin check_out_will_in_the_dungeon_2ee3c359:
msgid "[_cedrick_] Булдж..?"
msgstr "[_cedrick_] ¿Abultamiento...?"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:8 #-#-# translate crowdin check_out_will_in_the_dungeon_87b7ed4a:
msgid "[_cedrick_] ......"
msgstr "[_cedrick_] ......"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:9 #-#-# translate crowdin check_out_will_in_the_dungeon_8c4dc0cc:
msgid "[_cedrick_] (Что за черт!? Булдж без сознания? Что-то с огромной силой впечатало его в землю...)"
msgstr "[_cedrick_] (¿Qué diablos es? ¿Bulj inconsciente? Algo con gran fuerza lo imprimió en el suelo...)"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:12 #-#-# translate crowdin check_out_will_in_the_dungeon_457cfb13:
msgid "Вы совершили неправильный выбор. Далее вас ждет GAME OVER, в котором присутствует NTR-сцена с мимиком. Если вы хотите продолжить, нажмите «Да». Чтобы пропустить этот контент и вернуться в главное меню, нажмите «Нет». Вы хотите продолжить?"
msgstr "Hiciste la elección equivocada. A continuación encontrarás el juego terminado, en el que hay una tercera escena con una Mímico. Si quieres continuar, haz clic en “sí”. Para omitir este contenido y volver al menú principal, haga clic en “no”. ¿Quieres continuar?"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:18 #-#-# translate crowdin gallery_d_090_c4aba167:
msgid "[_will_] Н-неееееет... Аааах... Ааааахххх... Оно внутри... В-внутри... Н-нет места..."
msgstr "[_will_] ¡N-noooo...! Aaaah... Aaaaah... Está dentro... D-dentro... N-no hay espacio..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:19 #-#-# translate crowdin gallery_d_090_ea8fd90b:
msgid "[_cedrick_] О нет..."
msgstr "[_cedrick_] Oh No..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:22 #-#-# translate crowdin gallery_d_090_628ac41c:
msgid "[_will_] Рик!... Ммммххх... П-помоги мне!"
msgstr "[_will_] ¡Rick!... Mmmkh... ¡Ayúdame!"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:24 #-#-# translate crowdin gallery_d_090_edd851c8:
msgid "[_cedrick_] Вилл..."
msgstr "[_cedrick_] Will..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:26 #-#-# translate crowdin gallery_d_090_de3720f1:
msgid "[_cedrick_] (У этой твари что, появилась рука!? Миранда была права, мимик эволюционирует.. Но кто мог знать, что это происходит так быстро...)"
msgstr "[_cedrick_] (¡Esta criatura tiene una mano!? Miranda tenía razón, las expresiones faciales están evolucionando. Pero quién sabía que iba tan rápido...)"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:28 #-#-# translate crowdin gallery_d_090_a5b775e2:
msgid "[_cedrick_] В-вилл... Я не могу ее атаковать, не поранив тебя. Эта тварь опутала тебя всю..."
msgstr "[_cedrick_] W-Will... No puedo atacarla sin herirte. Esta criatura te tiene completamente atrapada..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:30 #-#-# translate crowdin gallery_d_090_aaff9746:
msgid "[_will_] Н-нет, Рик... Она входит в меня... А-аааааа..."
msgstr "[_will_] N-no, Rick... Ella está entrando en mí... Ahhhhhhhh"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:31 #-#-# translate crowdin gallery_d_090_b17239d0:
msgid "[_cedrick_] (К-какого черта... Эта штука своими маленькими щупальцами лезет к ней в уши...)"
msgstr "[_cedrick_] (Qué rasgo... Esta cosa con sus pequeños tentáculos se sube a sus orejas...)"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:32 #-#-# translate crowdin gallery_d_090_a74cf31c:
msgid "[_cedrick_] (В-видимо чтобы добраться до мозга!! Н-нет, она что, способна таким образом влиять на сознание...)"
msgstr "[_cedrick_] (Aparentemente para llegar al cerebro!! N-no, qué, ella es capaz de influir en la conciencia de esta manera."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:34 #-#-# translate crowdin gallery_d_090_03ca6447:
msgid "[_cedrick_] (Миранда предупреждала, что эта штука умна, но я не думал, что она способна на подобные манипуляции...)"
msgstr "[_cedrick_] (Miranda advirtió que esta cosa es inteligente, pero no pensé que fuera capaz de tales manipulaciones)."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:36 #-#-# translate crowdin gallery_d_090_56901ad4:
msgid "[_cedrick_] Ч-черт, как это произошло..."
msgstr "[_cedrick_] M-mierda, cómo sucedió..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:41 #-#-# translate crowdin gallery_d_090_ebed3d65:
msgid "[_cedrick_] ......."
msgstr "[_cedrick_] ......."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:43 #-#-# translate crowdin gallery_d_090_ec55e55d:
msgid "[_will_] Я-я задыхаюсь... Эта тварь к-каждым толчком сдвигает мои органы..."
msgstr "[_will_] Me estoy sofocando... Esta cosa es que cada cuerpo cambia mis órganos..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:44 #-#-# translate crowdin gallery_d_090_73758d74:
msgid "[_cedrick_] П-прости, Вилл... Все... Все должно было быть иначе... Это провал..."
msgstr "[_cedrick_] P-perdón, Will... Todo... Todo debía ser distinto... Esto es un fracaso..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:46 #-#-# translate crowdin gallery_d_090_980e85a1:
msgid "[_will_] Р-рик... Аааахххх... Ммммммвввв..."
msgstr "[_will_] R-Rh... Aahhhhhhhhvv..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:48 #-#-# translate crowdin gallery_d_090_6ad7f81a:
msgid "[_will_] Ааавв... аааахх... Эта штука..."
msgstr "[_will_] Aaav... Aahhh... Esta cosa..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:50 #-#-# translate crowdin gallery_d_090_54358896:
msgid "[_will_] Долбит меня... К-как свою собственность..."
msgstr "[_will_] Me Dola... ¿Cómo está su propiedad..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:51 #-#-# translate crowdin gallery_d_090_ed8f22fc:
msgid "[_will_] Как насадку на свой член..."
msgstr "[_will_] Como una boquilla en tu verga..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:52 #-#-# translate crowdin gallery_d_090_52df030a:
msgid "[_will_] С-словно я... ааааххх... Словно я просто инструмент для доставления удовольствия..."
msgstr "[_will_] Es como si yo... Aahhhhhhhh es como si fuera sólo una herramienta para dar placer..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:53 #-#-# translate crowdin gallery_d_090_2f620338:
msgid "[_will_] М-монстр использует меня как игрушку для траха..."
msgstr "[_will_] M-monster me usa como un juguete para la mierda..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:55 #-#-# translate crowdin gallery_d_090_be9ef23a:
msgid "[_will_] Аааааххх..."
msgstr "[_will_] Aahhh..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:57 #-#-# translate crowdin gallery_d_090_ad54f656:
msgid "[_will_] П-почему..."
msgstr "[_will_] P-por qué..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:59 #-#-# translate crowdin gallery_d_090_bfa13246:
msgid "[_will_] Почему мне начинает это нравится..."
msgstr "[_will_] ¿Por qué empiezo a amarlo?"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:61 #-#-# translate crowdin gallery_d_090_f0efedfd:
msgid "[_will_] Ммммввв... Эта штука... О-она скоро кончит, я это чувствуююю..."
msgstr "[_will_] Mmmvv... Esta cosa... Oh, ella terminará pronto, lo siento..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:62 #-#-# translate crowdin gallery_d_090_782da11f:
msgid "[_cedrick_] ...."
msgstr "[_cedrick_] ...."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:65 #-#-# translate crowdin gallery_d_090_853a4d93:
msgid "[_will_] Аааааааххх... Оно заполняет меня..."
msgstr "[_will_] Aahah... Me llena..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:67 #-#-# translate crowdin gallery_d_090_8ae67cf0:
msgid "[_will_] Всю меня, до краев..."
msgstr "[_will_] Todo de mí, al borde..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:68 #-#-# translate crowdin gallery_d_090_634782df:
msgid "[_cedrick_] (Это полный провал... Без лидера стражниц ничего не выйдет...)"
msgstr "[_cedrick_] (Este es un completo fracaso... Sin el líder de los guardianas, nada va a pasar ...)"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:70 #-#-# translate crowdin gallery_d_090_10a686fa:
msgid "[_will_] Ммм... Дааа..."
msgstr "[_will_] Mmm... - Sí..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:71 #-#-# translate crowdin gallery_d_090_cfd9d2d4:
msgid "[_will_] Е-еще... Хочу еще..."
msgstr "[_will_] M-más... Quiero más..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:72 #-#-# translate crowdin gallery_d_090_dae3f371:
msgid "[_cedrick_] (Моему плану пришел конец...)"
msgstr "[_cedrick_] (Mi plan ha terminado...)"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:81 #-#-# translate crowdin gallery_d_090_b3c9eea2:
msgid "[_cedrick_] Миранда, я вернулся"
msgstr "[_cedrick_] Miranda, estoy de vuelta"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:82 #-#-# translate crowdin gallery_d_090_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:83 #-#-# translate crowdin gallery_d_090_0285ce5c:
msgid "[_cedrick_] Миранда..?"
msgstr "[_cedrick_] ¿Miranda...?"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:84 #-#-# translate crowdin gallery_d_090_87b7ed4a:
msgid "[_cedrick_] ......"
msgstr "[_cedrick_] ......"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:85 #-#-# translate crowdin gallery_d_090_a1068434:
msgid "[_cedrick_] (Что за черт!? Почему она не отвечает...)"
msgstr "[_cedrick_] (¿Qué diablos es? ¿Por qué no contesta...)"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:87 #-#-# translate crowdin gallery_d_090_457cfb13:
msgid "Вы совершили неправильный выбор. Далее вас ждет GAME OVER, в котором присутствует NTR-сцена с мимиком. Если вы хотите продолжить, нажмите «Да». Чтобы пропустить этот контент и вернуться в главное меню, нажмите «Нет». Вы хотите продолжить?"
msgstr "Hiciste la elección equivocada. A continuación encontrarás el juego terminado, en el que hay una tercera escena con una Mímico. Si quieres continuar, haz clic en “sí”. Para omitir este contenido y volver al menú principal, haga clic en “no”. ¿Quieres continuar?"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:93 #-#-# translate crowdin gallery_d_089_efb6c342:
msgid "[_miranda_] П-пусти меня, мерзкая тварь"
msgstr "[_miranda_] Déjame, rancio que vale la pena el despertar"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:94 #-#-# translate crowdin gallery_d_089_3c13a462:
msgid "[_will_] Аааах... Ааааахххх... Н-нет… Оно подбирается... Его щупальца хотят проникнуть внутрь..."
msgstr "[_will_] Aaaaaaaaahhhhhhhhahaaaaaaaahahhhhhhhh Se está acercando... Sus tentáculos quieren entrar..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:95 #-#-# translate crowdin gallery_d_089_ea8fd90b:
msgid "[_cedrick_] О нет..."
msgstr "[_cedrick_] Oh No..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:98 #-#-# translate crowdin gallery_d_089_30e0a2d4:
msgid "[_miranda_] Р-рик... М-мимик, он эволюционировал..."
msgstr "[_miranda_] R-Rh... Mmimik, ha evolucionado..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:100 #-#-# translate crowdin gallery_d_089_635e4c8f:
msgid "[_will_] Мммхх... Эти щупальца... Т-так умело играются с моим клитором..."
msgstr "[_will_] Mmkh... Estos tentáculos... T-tan hábilmente jugar con mi clítoris..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:101 #-#-# translate crowdin gallery_d_089_1a6e8eef:
msgid "[_cedrick_] К-как это вообще произошло!?"
msgstr "[_cedrick_] K-¿Cómo sucedió en absoluto!?"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:103 #-#-# translate crowdin gallery_d_089_a77eb7db:
msgid "[_miranda_] Я... Мххх... Видимо эта тварь накапливала силу, пряча руки под крышкой... Как только я на мгновение отвлеклась, эти руки вырвались и схватили меня... Аааххх..."
msgstr "[_miranda_] Yo... Mxh... Aparentemente, esta criatura acumulaba fuerza, ocultando sus manos bajo la tapa... Tan pronto como me distraje por un momento, estas manos se rompieron y me agarraron... Aahhh..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:104 #-#-# translate crowdin gallery_d_089_fd135a94:
msgid "[_cedrick_] (Черт... Эта тварь оказалась гораздо умнее, чем мы думали... Она еще и эволюционирует...)"
msgstr "[_cedrick_] (Maldito... Esta cosa resultó ser mucho más inteligente de lo que pensábamos... También está evolucionando...)"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:106 #-#-# translate crowdin gallery_d_089_76abcf5b:
msgid "[_miranda_] Ааахх... С-седрик, помоги... Эта тварь... Она пытается проникнуть... П-проникнуть в мой зад..."
msgstr "[_miranda_] Aaah... C-Cedric, ayúdame... Esta criatura... Intenta penetrarme... P-penetrarme el trasero..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:108 #-#-# translate crowdin gallery_d_089_32095c2d:
msgid "[_will_] Мххх, и в мою киску тоже... Р-рик, останови ее..."
msgstr "[_will_] Mhhh, y en mi pus, también... R-rick, deténgala..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:109 #-#-# translate crowdin gallery_d_089_73330928:
msgid "[_cedrick_] Я... Я не смогу помочь... У меня не выйдет атаковать эту тварь и при этом не задеть вас..."
msgstr "[_cedrick_] Yo... No puedo ayudar... No correré a atacar esta cosa y no te haría daño."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:110 #-#-# translate crowdin gallery_d_089_329d31c1:
msgid "[_cedrick_] М-миранда! Попробуй превратиться! Возможно тогда у вас получится вырваться"
msgstr "[_cedrick_] ¡M-miranda! ¡Intente girar! Tal vez entonces puedas salir"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:112 #-#-# translate crowdin gallery_d_089_ce172ab0:
msgid "[_miranda_] Ааахх... Даже если моя трансформация может ранить Вилл?"
msgstr "[_miranda_] Aahh... ¿Incluso si mi transformación puede doler a Will?"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:114 #-#-# translate crowdin gallery_d_089_49360f5d:
msgid "[_will_] Ааавв... Ч-что!?... Н-нет..."
msgstr "[_will_] Aaav... ¿¡Qué!?... No..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:116 #-#-# translate crowdin gallery_d_089_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:117 #-#-# translate crowdin gallery_d_089_eb9f09aa:
msgid "[_cedrick_] Просто сделай это! Эту тварь нужно остановить. Я не хочу потерять тебя..."
msgstr "[_cedrick_] ¡Solo hazlo! Hay que detener a esa criatura. No quiero perderte..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:119 #-#-# translate crowdin gallery_d_089_5802249d:
msgid "[_miranda_] Я-я поняла, Седрик..."
msgstr "[_miranda_] Lo entiendo, Cedric..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:121 #-#-# translate crowdin gallery_d_089_d4985876:
msgid "[_will_] Н-нет, подождите... Может есть другой выход... Аааххх... Эти щупальца сейчас войдут в меня... Я чувствую..."
msgstr "[_will_] N-n-no, espera... Tal vez hay otra salida... Aahhh... Esos tentáculos ahora entrarán en Mí... Me siento..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:122 #-#-# translate crowdin gallery_d_089_10110b44:
msgid "[_cedrick_] Миранда, давай!"
msgstr "[_cedrick_] ¡Miranda, vamos!"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:124 #-#-# translate crowdin gallery_d_089_42744fe8:
msgid "[_miranda_] Да, сейчас!... Я..."
msgstr "[_miranda_] ¡Sí, ahora!... Yo..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:129 #-#-# translate crowdin gallery_d_089_ebed3d65:
msgid "[_cedrick_] ......."
msgstr "[_cedrick_] ......."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:130 #-#-# translate crowdin gallery_d_089_03ff20c0:
msgid "[_cedrick_] Что за..."
msgstr "[_cedrick_] ¿Pero qué...?"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:132 #-#-# translate crowdin gallery_d_089_443631df:
msgid "[_miranda_] Р-рик... аааааххх... эти щупальца, они... мммммввв..."
msgstr "[_miranda_] R-Rh... Aahhhhhhhh estos tentáculos, ellos... Mmmuvvv..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:137 #-#-# translate crowdin gallery_d_089_2d28f415:
msgid "[_will_] Аааааххх... Оно внутри... Оно внутри меня, я чувствую это..."
msgstr "[_will_] Aahhh... Está dentro... Está dentro de mí, lo siento..."

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:139 #-#-# translate crowdin gallery_d_089_4de02be2:
