# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:10 #-#-# translate crowdin go_to_meredian_to_miranda_f6c57393:
msgid "[_cedrick_] Я здесь. Пора устроить собрание"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:14 #-#-# translate crowdin go_to_meredian_to_miranda_e1c86a59:
msgid "[_miranda_] Хорошо, я как раз позвала Булджа, он скоро придет"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:18 #-#-# translate crowdin go_to_meredian_to_miranda_6988b51c:
msgid "[_cedrick_] Стражницы не доставили хлопот?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:22 #-#-# translate crowdin go_to_meredian_to_miranda_5ef11178:
msgid "[_miranda_] На удивление нет, все прошло гладко"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:27 #-#-# translate crowdin go_to_meredian_to_miranda_ddfcd6fa:
msgid "[_bulj_] Главнокомандующий, вы уже здесь! Простите, что заставил ждать..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:33 #-#-# translate crowdin go_to_meredian_to_miranda_7306450a:
msgid "[_cedrick_] Ничего, Булдж, ты как раз вовремя. Миранда, ты установила звуконепроницаемый барьер вокруг комнаты?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:37 #-#-# translate crowdin go_to_meredian_to_miranda_49571465:
msgid "[_miranda_] Еще до того как ты вошел"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:38 #-#-# translate crowdin go_to_meredian_to_miranda_a9a6a83e:
msgid "[_cedrick_] Хорошо, тогда я начну. Расставим все по своим местам, прежде чем начать действовать"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:42 #-#-# translate crowdin go_to_meredian_to_miranda_f705bbb1:
msgid "[_cedrick_] Итак. Нынешняя ситуация такова, что мы не можем позволить стражницам быть заточенными в подземелье, иначе мои планы не осуществятся"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:43 #-#-# translate crowdin go_to_meredian_to_miranda_f5e36985:
msgid "[_cedrick_] Если они попадут в руки Фобоса, о его свержении можно позабыть"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:44 #-#-# translate crowdin go_to_meredian_to_miranda_8e7112a3:
msgid "[_cedrick_] Как ни скверно это признавать, но я слишком слаб, чтобы справиться с Фобосом в одиночку..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:45 #-#-# translate crowdin go_to_meredian_to_miranda_cb50f715:
msgid "[_cedrick_] У меня есть необходимый мне опыт, вряд ли на Меридиане есть хоть кто-то, кто знает Фобоса лучше, чем я... Но мои силы - это лишь блеклая тень того, что я когда-то мог"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:46 #-#-# translate crowdin go_to_meredian_to_miranda_3f3d5c65:
msgid "[_cedrick_] Да и даже если бы я был на пике своих магических способностей и вы двое поддерживали бы меня, Фобосу мы все еще не ровня..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:47 #-#-# translate crowdin go_to_meredian_to_miranda_10242dc1:
msgid "[_miranda_] ..."
msgstr "[_miranda_] ..."

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:48 #-#-# translate crowdin go_to_meredian_to_miranda_1f6be6e5:
msgid "[_bulj_] ..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:49 #-#-# translate crowdin go_to_meredian_to_miranda_fa609902:
msgid "[_cedrick_] В свою очередь у стражниц есть сила. Огромная сила, с которой они могли бы дать отпор Фобосу"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:50 #-#-# translate crowdin go_to_meredian_to_miranda_c3f1c2f7:
msgid "[_cedrick_] Но они все еще неопытные девчонки, которыми легко манипулировать. У них слишком мало боевого опыта"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:51 #-#-# translate crowdin go_to_meredian_to_miranda_7bf4d373:
msgid "[_cedrick_] Если мы и сможем свергнуть Фобоса, то только вместе с ними"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:55 #-#-# translate crowdin go_to_meredian_to_miranda_f074e1f4:
msgid "[_miranda_] А что на счет Элион?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:56 #-#-# translate crowdin go_to_meredian_to_miranda_903cd8b8:
msgid "[_cedrick_] С Элион еще сложнее. Помимо того, что она не контролирует свои силы, она по сути о них еще даже не подозревает"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:60 #-#-# translate crowdin go_to_meredian_to_miranda_13d7ddde:
msgid "[_cedrick_] К тому же внимание Фобоса жестко приковано к его младшей сестре. Если мы попытаемся действовать через нее, когда она уже будет в замке, Фобос сразу же это заметит"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:61 #-#-# translate crowdin go_to_meredian_to_miranda_ffeea71f:
msgid "[_cedrick_] Элион слишком рискованный вариант, работы с ней требуется куда больше, чем со Стражницами"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:62 #-#-# translate crowdin go_to_meredian_to_miranda_21bd524e:
msgid "[_cedrick_] Ситуация с Элион слишком непредсказуемая. Стражницы знают, как устроен Меридиан и кем является Фобос. С Элион же..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:63 #-#-# translate crowdin go_to_meredian_to_miranda_04687535:
msgid "[_cedrick_] Неизвестно, продолжит ли она быть на нашей стороне, если узнает о всей той лжи, что стоит за нашими отношениями"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:64 #-#-# translate crowdin go_to_meredian_to_miranda_10242dc1_1:
msgid "[_miranda_] ..."
msgstr "[_miranda_] ..."

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:65 #-#-# translate crowdin go_to_meredian_to_miranda_20d3ca20:
msgid "[_cedrick_] Поэтому, сейчас мы делаем ставку на стражниц. И в этом самом подземелье мы устроим для них достойный спектакль"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:69 #-#-# translate crowdin go_to_meredian_to_miranda_2c11e823:
msgid "[_bulj_] Спектакль, Лорд Седрик?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:70 #-#-# translate crowdin go_to_meredian_to_miranda_8cc4e939:
msgid "[_cedrick_] Верно. Стражницы ни за что не встанут на мою сторону, если я просто попрошу их об этом..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:74 #-#-# translate crowdin go_to_meredian_to_miranda_d8c5268a:
msgid "[_cedrick_] И даже сила короля Морпионов здесь не поможет. Она слишком специфически работает на сознании людей и их личность подавить не удастся"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:75 #-#-# translate crowdin go_to_meredian_to_miranda_2a09f634:
msgid "[_cedrick_] С Корнелией и Мединой у меня вышло, но вот Ирма пример того, как примененная в неправильный момент способность может создать в сознании противоречие"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:76 #-#-# translate crowdin go_to_meredian_to_miranda_119cd548:
msgid "[_cedrick_] Эссенция королевы Морпионов довольно хорошо сработала на Вилл и Алхими, но, к сожалению, больше этого зелья добыть не удастся"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:80 #-#-# translate crowdin go_to_meredian_to_miranda_fe9d320a:
msgid "[_miranda_] Да уж, стоило заточить эту Королеву в подземелье. Тогда у нас был бы стабильный поток эссенции"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:81 #-#-# translate crowdin go_to_meredian_to_miranda_1c1497eb:
msgid "[_cedrick_] Хах, а ты бы выдержала конкуренцию с еще одной знойной девушкой-монстром?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:85 #-#-# translate crowdin go_to_meredian_to_miranda_79ee0491:
msgid "[_miranda_] С-седрик!"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:86 #-#-# translate crowdin go_to_meredian_to_miranda_0389d355:
msgid "[_cedrick_] Я просто шучу. К тому же, в тот момент у меня не хватило бы сил привести ее в замок живой"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:92 #-#-# translate crowdin go_to_meredian_to_miranda_9e9a2263:
msgid "[_bulj_] Возможно, рог Гипноса смог бы нам с этим помочь"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:93 #-#-# translate crowdin go_to_meredian_to_miranda_ca3c39bb:
msgid "[_cedrick_] Он был помог, но..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:99 #-#-# translate crowdin go_to_meredian_to_miranda_ea330f69:
msgid "[_cedrick_] (Но он был утерян после того, как старший брат Фобоса забрал его с собой... Перед своим изгнанием в один из параллельных миров)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:100 #-#-# translate crowdin go_to_meredian_to_miranda_e453d274:
msgid "[_cedrick_] (Хотя, я бы даже не назвал это изгнанием... Скорее устранением конкурента со стороны Фобоса)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:101 #-#-# translate crowdin go_to_meredian_to_miranda_e67c6373:
msgid "[_cedrick_] (Но это уже совсем другая история...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:105 #-#-# translate crowdin go_to_meredian_to_miranda_59e06574:
msgid "[_bulj_] Сэр?"
msgstr "[_bulj_] ¿Señor?"

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:109 #-#-# translate crowdin go_to_meredian_to_miranda_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:110 #-#-# translate crowdin go_to_meredian_to_miranda_1dffb958:
msgid "[_cedrick_] Рог Гипноса нам не поможет"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:111 #-#-# translate crowdin go_to_meredian_to_miranda_523e832f:
msgid "[_cedrick_] Все, что нам сейчас остается - это взять ситуацию в свои руки"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:115 #-#-# translate crowdin go_to_meredian_to_miranda_28245fb0:
msgid "[_bulj_] Устроить так называемый спектакль? Но что вы имеете ввиду?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:119 #-#-# translate crowdin go_to_meredian_to_miranda_323ae352:
msgid "[_cedrick_] Я использую все те навыки, которые наработал за сотни лет участия в дворцовых интригах"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:120 #-#-# translate crowdin go_to_meredian_to_miranda_8a5baec5:
msgid "[_cedrick_] И на стражницах я использую один из самых древних, но также один из самых эффективных способов манипуляции"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:121 #-#-# translate crowdin go_to_meredian_to_miranda_6743b8b2:
msgid "[_cedrick_] Даже на Земле есть эта поговорка. У них она звучит как 'враг твоего врага - твой друг', кажется..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:125 #-#-# translate crowdin go_to_meredian_to_miranda_3be3c43d:
msgid "[_miranda_] Хах, все так просто?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:126 #-#-# translate crowdin go_to_meredian_to_miranda_28625cc3:
msgid "[_cedrick_] Просто оно только на словах. На деле же мне нужно погрузить их в пучину ужаса и отчаяния"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:127 #-#-# translate crowdin go_to_meredian_to_miranda_ebc8b440:
msgid "[_cedrick_] При этом нужно не только убедить их в том, что это все не моих рук дело, а Фобоса, но и не дать им утонуть в этой бездне"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:128 #-#-# translate crowdin go_to_meredian_to_miranda_fc517157:
msgid "[_cedrick_] Человеческое сознание довольно хрупкая вещь. Меридиан может довольно быстро их сломать, если мы не будем подстраховывать их"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:132 #-#-# translate crowdin go_to_meredian_to_miranda_9b8e3717:
msgid "[_miranda_] Иными словами, прямо сейчас ты хочешь устроить им контролируемую пыточную на Меридиане, но при этом убедить в том, что это все рук Фобоса?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:136 #-#-# translate crowdin go_to_meredian_to_miranda_34bd9dcf:
msgid "[_bulj_] И тогда на фоне этих злодеяний вы будете выглядеть наименьшим злом?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:140 #-#-# translate crowdin go_to_meredian_to_miranda_94e5eaf8:
msgid "[_cedrick_] Нет, я пойду еще дальше. Я должен убедить стражниц в том, что я сам являюсь лишь жертвой обстоятельств"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:144 #-#-# translate crowdin go_to_meredian_to_miranda_b19d3e47:
msgid "[_cedrick_] Только так я смогу по-настоящему заручиться их поддержкой в будущем"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:148 #-#-# translate crowdin go_to_meredian_to_miranda_4bf776f6:
msgid "[_miranda_] Будешь играть хорошего парня после того, как их всех изнасиловал? Серьезно?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:152 #-#-# translate crowdin go_to_meredian_to_miranda_5963da37:
msgid "[_cedrick_] Поэтому я и сказал, что это спектакль. Хорошего парня мне уже сыграть не удастся, но это и не нужно"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:153 #-#-# translate crowdin go_to_meredian_to_miranda_3a681be3:
msgid "[_cedrick_] Достаточно показать им, что на самом деле мы находимся в одной лодке и у нас с ними общие цели"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:154 #-#-# translate crowdin go_to_meredian_to_miranda_ff72072e:
msgid "[_cedrick_] Они должны поверить, что я нужен им так же сильно, как и они нужны мне. Иначе Фобоса нам не одолеть"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:155 #-#-# translate crowdin go_to_meredian_to_miranda_2ef90216:
msgid "[_cedrick_] (...)"
msgstr "[_cedrick_] (...)"

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:156 #-#-# translate crowdin go_to_meredian_to_miranda_9bbc63c7:
msgid "[_cedrick_] (Возможно, если бы я не пытался манипулировать ими с помощью насилия с самого начала, а выбрал бы путь мягкой силы, любви и мира, тогда убедить их было бы куда проще...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:157 #-#-# translate crowdin go_to_meredian_to_miranda_262b608e:
msgid "[_Somka108_] А наша команда напоминает, что в данный момент времени мы разрабатываем маршрут шантажа. Любовный маршрут будет доступен после завершения разработки данного маршрута"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:158 #-#-# translate crowdin go_to_meredian_to_miranda_a23116ea:
msgid "[_cedrick_] (Но, какой смысл сейчас об этом думать? Уже слишком поздно...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:162 #-#-# translate crowdin go_to_meredian_to_miranda_f7d3081a:
msgid "[_miranda_] Значит наша задача - надломить стражниц, чтобы они почувствовали настоящий ужас в лице Фобоса, но при этом не сломать их? Параллельно выставив тебя такой же жертвой обстоятельств?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:166 #-#-# translate crowdin go_to_meredian_to_miranda_6e88a220:
msgid "[_cedrick_] Верно. И самое главное..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:170 #-#-# translate crowdin go_to_meredian_to_miranda_f36a73d0:
msgid "[_bulj_] Да, главнокомандующий?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:174 #-#-# translate crowdin go_to_meredian_to_miranda_19dc79ff:
msgid "[_cedrick_] Они не должны попасться на глаза Фобосу. Как только он увидит их на Меридиане, то в лучшем случае сочтет мою миссию по устранению стражниц завершенной"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:175 #-#-# translate crowdin go_to_meredian_to_miranda_b378b2dc:
msgid "[_cedrick_] После чего навечно заключит их в подземелье..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:179 #-#-# translate crowdin go_to_meredian_to_miranda_3b2bb1a6:
msgid "[_miranda_] А в худшем случае?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:183 #-#-# translate crowdin go_to_meredian_to_miranda_b6ab14cf:
