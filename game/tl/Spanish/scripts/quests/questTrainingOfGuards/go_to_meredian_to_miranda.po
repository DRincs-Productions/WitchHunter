# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:353 #-#-# translate crowdin go_to_meredian_to_miranda_87b7ed4a:
msgid "[_cedrick_] ......"
msgstr "[_cedrick_] ......"

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:357 #-#-# translate crowdin go_to_meredian_to_miranda_8485b144:
msgid "[_miranda_] Седрик?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:361 #-#-# translate crowdin go_to_meredian_to_miranda_e9f684f4:
msgid "[_cedrick_] Выбора нет. Придется ускорить процесс. Разберемся со стражницами здесь и сейчас. Их и наша с вами судьба решится сегодня"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:365 #-#-# translate crowdin go_to_meredian_to_miranda_95ecf7d6:
msgid "[_miranda_] Но как ты планируешь это провернуть?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:369 #-#-# translate crowdin go_to_meredian_to_miranda_ab4a747d:
msgid "[_cedrick_] С вашей помощью. Нас как раз трое, каждый присмотрит за одной из трех команд стражниц"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:373 #-#-# translate crowdin go_to_meredian_to_miranda_1e07c5b5:
msgid "[_miranda_] Думаешь у тебя получится одновременно присматривать за стражницами и сопровождать Фобоса? Серьезно?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:377 #-#-# translate crowdin go_to_meredian_to_miranda_ab3a801e:
msgid "[_cedrick_] (Черт, она права, это рискованно, но...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:378 #-#-# translate crowdin go_to_meredian_to_miranda_3b7de581:
msgid "[_cedrick_] Другого выхода у нас нет. Риски быть обнаруженными слишком высоки. Единственное, что мы можем сделать - это ускорить процесс"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:382 #-#-# translate crowdin go_to_meredian_to_miranda_22006084:
msgid "[_bulj_] Вас понял, сэр. Но как тогда распределится наша группа?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:386 #-#-# translate crowdin go_to_meredian_to_miranda_cdbcebc0:
msgid "[_cedrick_] (Начать стоит с Вилл. Но кто должен будет присматривать за ней?)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:387 #-#-# translate crowdin go_to_meredian_to_miranda_16e65cf6:
msgid "[_cedrick_] (Миранда немало знает о мимике, которого мы натравим на Вилл в рамках спектакля, но, с другой стороны, я слышал, что в присутствии девушек этот мимик особо активен)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:388 #-#-# translate crowdin go_to_meredian_to_miranda_3e8dc6a8:
msgid "[_cedrick_] (Не будет ли рискованно оставлять их двоих на эту тварь? С другой стороны, Миранда такой же монстр, как и я, уверен она сможет дать отпор)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:389 #-#-# translate crowdin go_to_meredian_to_miranda_0acf29c5:
msgid "[_cedrick_] (С другой стороны Булдж. С мужчинами мимик ведет себя спокойнее. Но Булдж недостаточно опытен, чтобы справляться с такого рода тварями)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:390 #-#-# translate crowdin go_to_meredian_to_miranda_86916491:
msgid "[_cedrick_] (Хотя, в битве с Королем Морпионов он умудрился остаться в живых)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:391 #-#-# translate crowdin go_to_meredian_to_miranda_2ef90216_1:
msgid "[_cedrick_] (...)"
msgstr "[_cedrick_] (...)"

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:392 #-#-# translate crowdin go_to_meredian_to_miranda_086ae1a4:
msgid "[_cedrick_] (Я мог бы сам присмотреть за Вилл, но это крайне рискованно. Фобос требует моего присутствия прямо сейчас и если я заставлю его слишком долго ждать, меня определенно ждет кара)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:393 #-#-# translate crowdin go_to_meredian_to_miranda_7da84f45:
msgid "[_cedrick_] (Я же в любом случае буду присутствовать в самом начале пыток Вилл, чтобы направить разыгрываемый спектакль в нужное русло)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:394 #-#-# translate crowdin go_to_meredian_to_miranda_07068368:
msgid "[_cedrick_] (И все же... Кого мне выбрать...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:399 #-#-# translate crowdin questTrainingOfGuards_1_c5ec4493:
msgid "[_cedrick_] Я доверю это тебе, Миранда. Ты, кажется, лучше нас всех разбираешься в этой твари"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:403 #-#-# translate crowdin questTrainingOfGuards_1_7e2668db:
msgid "[_miranda_] Бррр, моих знаний хватает лишь на то, чтобы не соваться к этой сундучной твари. Но если ты просишь, Седрик, то я сделаю это"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:407 #-#-# translate crowdin questTrainingOfGuards_1_7b0e7f99:
msgid "[_cedrick_] Я поручаю это тебе, Булдж. Мимик не так падок на мужчин, думаю ты сможешь с ним совладать"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:411 #-#-# translate crowdin questTrainingOfGuards_1_bda22a9c:
msgid "[_bulj_] Ценю ваше доверие, сэр. Я вас не подведу"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:417 #-#-# translate crowdin questTrainingOfGuards_1_0265f4cb:
msgid "[_miranda_] (Хвала богам, он поручил это не мне...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:420 #-#-# translate crowdin questTrainingOfGuards_1_51afbec5:
msgid "[_cedrick_] Я сделаю это сам"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:424 #-#-# translate crowdin questTrainingOfGuards_1_a26e2447:
msgid "[_miranda_] Н-но, Седрик..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:428 #-#-# translate crowdin questTrainingOfGuards_1_e4b6d500:
msgid "[_cedrick_] Я знаю чем мы рискуем. Но интуиция подсказывает мне, что лучше взять ситуацию с Вилл в свои руки. Не то чтобы я не верил в вас, просто..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:429 #-#-# translate crowdin questTrainingOfGuards_1_e4ae74ca:
msgid "[_cedrick_] Лучше я сам буду держать мимика под контролем. Не хочу, чтобы кто-то из вас пострадал"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:433 #-#-# translate crowdin questTrainingOfGuards_1_dea0f588:
msgid "[_miranda_] Х-хорошо, Седрик..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:437 #-#-# translate crowdin questTrainingOfGuards_1_45a99e36:
msgid "[_bulj_] Ценю вашу заботу, главнокомандующий"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:446 #-#-# translate crowdin questTrainingOfGuards_1_06599463:
msgid "[_miranda_] И все же.. Как тогда поступим с Фобосом? Он требует вашего немедленного присутствия, но вы же будете заняты Вилл прямо сейчас"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:450 #-#-# translate crowdin questTrainingOfGuards_1_8106e52e:
msgid "[_cedrick_] Хм, его нужно будет задержать, пока я буду с Вилл..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:454 #-#-# translate crowdin questTrainingOfGuards_1_99f376d8:
msgid "[_miranda_] Н-неужели ты поручишь это мне..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:455 #-#-# translate crowdin questTrainingOfGuards_1_fa2d1fc9:
msgid "[_cedrick_] Нет, на самом деле, я хотел предложить это Булджу"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:461 #-#-# translate crowdin questTrainingOfGuards_1_6f7041d1:
msgid "[_bulj_] Ч-что!? Мне? Задержать Фобоса..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:465 #-#-# translate crowdin questTrainingOfGuards_1_e74ff31b:
msgid "[_bulj_] ....."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:469 #-#-# translate crowdin questTrainingOfGuards_1_e24cf2cd:
msgid "[_cedrick_] Не переживай так, Булдж. Помнишь я попросил тебя не докладывать о побеге Райтера во время нападения короля морпионов?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:470 #-#-# translate crowdin questTrainingOfGuards_1_723c2a0a:
msgid "[_cedrick_] Что ж, я хотел разыграть козырь с Райтером на переговорах с повстанцами, предложив им временный союз"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:471 #-#-# translate crowdin questTrainingOfGuards_1_e14c002b:
msgid "[_cedrick_] В знак доброй воли я отдал бы им действующего главнокомандующего стражей Фобоса, Райтера"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:472 #-#-# translate crowdin questTrainingOfGuards_1_62de87e2:
msgid "[_cedrick_] Но, видимо, придется воспользоваться этим козырем сейчас. Ты задержишь Фобоса, докладывая ему о бегстве Райтера"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:473 #-#-# translate crowdin questTrainingOfGuards_1_3268d114:
msgid "[_cedrick_] Это достаточно веская информация, чтобы задержать ненадолго внимание Фобоса"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:477 #-#-# translate crowdin questTrainingOfGuards_1_2690ad85:
msgid "[_bulj_] В-вас понял..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:481 #-#-# translate crowdin questTrainingOfGuards_1_670b61c2:
msgid "[_cedrick_] (Мда, чувствую это мне еще аукнется. Действительно ли я правильно поступаю, размениваясь ценной информацией о Райтере вот так?)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:482 #-#-# translate crowdin questTrainingOfGuards_1_7616a4bd:
msgid "[_cedrick_] (Время покажет...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:483 #-#-# translate crowdin questTrainingOfGuards_1_b6a77ac7:
msgid "[_cedrick_] Что ж. Отправляемся"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:486 #-#-# translate crowdin questTrainingOfGuards_1_bc1998c3:
msgid "[_centered_] {size=37}В подземелье Вилл{/size} [withDissolve1]"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:495 #-#-# translate crowdin questTrainingOfGuards_1_edd851c8:
msgid "[_cedrick_] Вилл..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:499 #-#-# translate crowdin questTrainingOfGuards_1_497ef4f5:
msgid "[_will_] Р-рик? Ты какой-то обеспокоенный. Что-то случилось?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:501 #-#-# translate crowdin questTrainingOfGuards_1_dc562231:
msgid "[_cedrick_] (Вот и начинается спектакль. Хм, Вилл ведет себя чертовски спокойно для той, кто заточен в подземелье. Но это ненадолго)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:502 #-#-# translate crowdin questTrainingOfGuards_1_35421083:
msgid "[_cedrick_] Ты так спокойна"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:506 #-#-# translate crowdin questTrainingOfGuards_1_b02696f0:
msgid "[_will_] Хах, конечно. Мы же это уже обсуждали. Как бы то ни было я знаю, что ты не причинишь мне вреда. По крайней мере того, которого я сама бы не хотела..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:507 #-#-# translate crowdin questTrainingOfGuards_1_a8fb2a8a:
msgid "[_cedrick_] Прости, Вилл, но теперь все изменится..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:511 #-#-# translate crowdin questTrainingOfGuards_1_af3a2697:
msgid "[_will_] Ч-что?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:512 #-#-# translate crowdin questTrainingOfGuards_1_0187018a:
msgid "[_cedrick_] Ко мне только что поступило распоряжение от Фобоса"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:516 #-#-# translate crowdin questTrainingOfGuards_1_d3f45166:
msgid "[_will_] Что... Что это значит?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:518 #-#-# translate crowdin questTrainingOfGuards_1_cddb1ef9:
msgid "[_cedrick_] Знаешь, Вилл... Мне очень нравилась динамика наших отношений. Вся эта игра в семью... В какой-то момент я даже начал в это верить"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:519 #-#-# translate crowdin questTrainingOfGuards_1_705a348c:
msgid "[_cedrick_] Вся эта семейная рутина... Сначала была такой непривычной и раздражающей но в конечном итоге, неожиданно для меня самого, эта рутина вместе с вами стала для меня родной..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:523 #-#-# translate crowdin questTrainingOfGuards_1_b389d14a:
msgid "[_will_] К-конечно, Рик... Я понимаю твои чувства..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:524 #-#-# translate crowdin questTrainingOfGuards_1_7e16f03a:
msgid "[_cedrick_] А какие твоя мама блинчики готовит, хах, просто объедение"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:525 #-#-# translate crowdin questTrainingOfGuards_1_3b2681bd:
msgid "[_cedrick_] Но... Всему этому настал конец. Это даже грустно. Но эта грусть говорит о том, что я на мгновение забыл о своей роли. Как и о вашей. Я Лорд, а вы стражницы. Мы враги"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:529 #-#-# translate crowdin questTrainingOfGuards_1_f33e2aaf:
msgid "[_will_] Р-рик... Нет..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:530 #-#-# translate crowdin questTrainingOfGuards_1_c2967350:
msgid "[_cedrick_] Теперь моя миссия выполнена. Вы все заключены под стражу, а значит, как бы противоречиво оно не звучало, но я над вами больше не властен"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:531 #-#-# translate crowdin questTrainingOfGuards_1_f168e6f8:
msgid "[_cedrick_] Теперь Фобос командует происходящим... А я... Что ж... Могу лишь исполнять волю своего князя, как и всегда"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:532 #-#-# translate crowdin questTrainingOfGuards_1_215ed9b6:
msgid "[_cedrick_] (Черт, теперь меня самого тошнит от этого. И как я мог когда-то говорить подобное всерьез. Хотя... Даже тогда мне было просто плевать, я ни к чему не относился серьезно)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:536 #-#-# translate crowdin questTrainingOfGuards_1_99b18069:
msgid "[_will_] Рик, нет... Как же так... Ты не можешь... Я думала, что..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:537 #-#-# translate crowdin questTrainingOfGuards_1_bed7d4d3:
msgid "[_cedrick_] Это уже не важно, Вилл. Приказ Фобоса теперь висит тяжким грузом над всеми нами"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:541 #-#-# translate crowdin questTrainingOfGuards_1_39b4a586:
msgid "[_cedrick_] И как предводительницу стажниц, я должен отдать твою плоть на растерзание мимику, согласно приказу Фобоса"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:545 #-#-# translate crowdin questTrainingOfGuards_1_f304a689:
msgid "[_cedrick_] Хотя я бы не сказал, что он разорвет твою плоть.. Скорее.. Что ж, ты сама увидишь"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:549 #-#-# translate crowdin gallery_d_088_ebdf6f28:
msgid "[_centered_] {size=37}СЕРИК ОТКРЫВАЕТ СУНДУК С МИМИКОМ, ЧАСТИЧНО ВЫСВОБОЖДАЯ ЕГО ЩУПАЛЬЦА{/size} [withDissolve1]"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:551 #-#-# translate crowdin gallery_d_088_99bc0b73:
msgid "[_will_] Н-нет, Рик... Д-думаешь я просто так отдамся этой твари!? Если ты перестал бороться, то я еще нет!"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:552 #-#-# translate crowdin gallery_d_088_9da9e2b3:
msgid "[_will_] Мы едины!"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:553 #-#-# translate crowdin gallery_d_088_dfc4b0c4:
msgid "[_cedrick_] (Ого, превратилась в стражницу. В ней все еще есть прыть и желание сражаться. Чего и следовало ожидать от Лидера Чародеек)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:556 #-#-# translate crowdin gallery_d_088_08af2d88:
msgid "[_will_] Хах, только попробуй лезть ко мне, ты, склизкая тварь!"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:557 #-#-# translate crowdin gallery_d_088_3fae3796:
msgid "[_cedrick_] (К твоему несчастью, Вилл, твоя борьба в любом случае была лишь частью моего плана. Иначе я бы не использовал против тебя мимика)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:558 #-#-# translate crowdin gallery_d_088_41506602:
msgid "[_cedrick_] Рад, что в тебе все еще есть желание сражаться, Вилл"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:560 #-#-# translate crowdin gallery_d_088_84c4d55e:
msgid "[_will_] А в тебе нет? Рик, я тебя не узнаю..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:561 #-#-# translate crowdin gallery_d_088_6a2c846b:
msgid "[_cedrick_] К сожалению, Вилл, я знаю, на что способен Фобос. Знаю лучше, чем кто бы это ни было. Ведь я знаком с ним уже не одну сотню лет"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:563 #-#-# translate crowdin gallery_d_088_44dcb0b1:
msgid "[_will_] Н-но тогда, почему..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:565 #-#-# translate crowdin gallery_d_088_4a90eb78:
msgid "[_will_] Я же вижу, что ты не воплощение зла! Может другие девочки думают так, но я нет... Я видела другую сторону тебя..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:566 #-#-# translate crowdin gallery_d_088_98082080:
msgid "[_will_] Чуткую и заботливую... П-почему ты готов отказаться от всего этого!?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:568 #-#-# translate crowdin gallery_d_088_82b03704:
msgid "[_cedrick_] Эх... Он отнял мою магическую силу, Вилл. Та форма змея, которой я сейчас обладаю - это в лучшем случае одна десятая от того, чем я раньше владел"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:570 #-#-# translate crowdin gallery_d_088_075a9a03:
msgid "[_will_] К-как же так... Все это время..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:572 #-#-# translate crowdin gallery_d_088_06c096e2:
msgid "[_will_] (Неужели все это время Рик был жертвой Фобоса...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:574 #-#-# translate crowdin gallery_d_088_4f32a1b1:
msgid "[_cedrick_] Но даже будь у меня вся моя сила... Ты не понимаешь, Вилл... Фобос слишком силен..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:576 #-#-# translate crowdin gallery_d_088_8c7b2c8c:
msgid "[_will_] Неужели даже со всей своей силой, ты..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:577 #-#-# translate crowdin gallery_d_088_19010867:
msgid "[_cedrick_] Хах... Иначе, думаешь я бы служил ему? Похоже, что я делаю это добровольно?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:579 #-#-# translate crowdin gallery_d_088_bcd124bf:
msgid "[_will_] ..."
msgstr "[_will_] ..."

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:580 #-#-# translate crowdin gallery_d_088_2c3150e4:
msgid "[_will_] (Рик... Так все это время ты...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:584 #-#-# translate crowdin gallery_d_088_7de39fe9:
msgid "[_will_] (Ч-черт... Я замешкалась. Из-за возникших чувств горечи о Рике, я не заметила, как эта тварь подобралась...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:587 #-#-# translate crowdin gallery_d_088_79ad363a:
msgid "[_cedrick_] Прости, Вилл, но такова наша судьба. Твоя и моя"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:589 #-#-# translate crowdin gallery_d_088_074f82f7:
msgid "[_will_] Н-нет..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:590 #-#-# translate crowdin gallery_d_088_80dd5b83:
msgid "[_cedrick_] В какой-то степени мне даже жаль..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:592 #-#-# translate crowdin gallery_d_088_0dbea255:
msgid "[_will_] Р-рик, помоги..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:594 #-#-# translate crowdin gallery_d_088_342471e5:
msgid "[_cedrick_] Узнав тебя поближе, я мог многого желать на твой счет, но я точно не желал бы того, что для тебя подготовил Фобос..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:596 #-#-# translate crowdin gallery_d_088_327e1d55:
msgid "[_will_] (Мх... Ч-что со мной происходит? Мое тело... Мне так жарко...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:597 #-#-# translate crowdin gallery_d_088_ceb72105:
msgid "[_cedrick_] Уверен, сейчас ты задаешься вопросом, что происходит с твоим телом?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:598 #-#-# translate crowdin gallery_d_088_59d8f3f7:
msgid "[_will_] Мхххх..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:599 #-#-# translate crowdin gallery_d_088_324779e0:
msgid "[_cedrick_] Все дело в щупальцах этой твари. Они выделяют слизь, которая срабатывает на женском теле как афродизиак"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:601 #-#-# translate crowdin gallery_d_088_423cfe25:
msgid "[_will_] Н-нет... Так вот что это такое... Мххх..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:603 #-#-# translate crowdin gallery_d_088_d1b2d344:
msgid "[_cedrick_] Когда-то Корнелия тоже тесно познакомилась с этими щупальцами. Собственно, так она и стала первой стражницей-узницей подземелья"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:605 #-#-# translate crowdin gallery_d_088_98c182f3:
msgid "[_will_] Рик... Аааахххх... Это слишком..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:606 #-#-# translate crowdin gallery_d_088_c2a4a463:
msgid "[_will_] Боже... Как корнелия только справлялась с этим..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:608 #-#-# translate crowdin gallery_d_088_a069873b:
msgid "[_cedrick_] А я и не говорил, что Корнелия справлялась"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:609 #-#-# translate crowdin gallery_d_088_d8aada8d:
msgid "[_will_] (Эти щупальца снуют по всему моему телу, как только им вздумается... Ч-черт, я не контролирую реакцию своего тела)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:610 #-#-# translate crowdin gallery_d_088_28c61a3d:
msgid "[_cedrick_] (С этой тварью, Мимиком, и вправду лучше быть крайне осторожным. Нужно немало усилий, чтобы держать крышку его сундука едва открытой)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:611 #-#-# translate crowdin gallery_d_088_93a3513c:
msgid "[_cedrick_] (К тому же я уверен, что эта тварь раньше вела себя немного иначе и щупальца у нее были другие. Видимо Мимик и вправду эволюционирует после контакта с девушками...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:613 #-#-# translate crowdin gallery_d_088_fa63bd10:
msgid "[_cedrick_] (Если сундук полностью откроется... Тогда моему плану, впрочем как и Вилл, придет конец...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:616 #-#-# translate crowdin gallery_d_088_e41e9d31:
msgid "[_will_] Ч-что!? Нееет..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:618 #-#-# translate crowdin gallery_d_088_520f8155:
msgid "[_cedrick_] Ого... Впервые вижу, чтобы эта тварь решила устроить прелюдию, прежде чем засунуть свои щупальца во все имеющиеся отверстия"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:620 #-#-# translate crowdin gallery_d_088_03567ba2:
msgid "[_will_] Т-ты серьезно!? Рик... Прошу, ты же не оставишь меня с этой тварью"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:622 #-#-# translate crowdin gallery_d_088_0bab239b:
msgid "[_cedrick_] (На самом деле фраза про прелюдию даже не блеф. Обычно Мимик ведет себе более агрессивно)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:624 #-#-# translate crowdin gallery_d_088_989a764d:
msgid "[_cedrick_] Хм... Видимо ты ему понравилась, Вилл"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:626 #-#-# translate crowdin gallery_d_088_2d16e97f:
msgid "[_will_] Н-не шути так, прошу... Ааахххх..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:628 #-#-# translate crowdin gallery_d_088_884f997f:
msgid "[_cedrick_] (Я и сам не до конца уверен, является ли это шуткой или же...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:629 #-#-# translate crowdin gallery_d_088_2ef90216:
msgid "[_cedrick_] (...)"
msgstr "[_cedrick_] (...)"

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:633 #-#-# translate crowdin gallery_d_088_298e857a:
msgid "[_cedrick_] (В любом случае, пока эта тварь замедлилась, я могу позволить себе отлучиться)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:635 #-#-# translate crowdin gallery_d_088_d5f32da5:
msgid "[_cedrick_] (Да, щупальца у Мимика страшные, но Фобос в гневе куда страшнее. Сейчас мне его гнев ни к чему)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:637 #-#-# translate crowdin gallery_d_088_69e832b3:
msgid "[_will_] Нет, Рик, к-куда ты собрался..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:639 #-#-# translate crowdin gallery_d_088_bb3765e2:
msgid "[_cedrick_] Я должен идти, Фобос вызывает меня"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:640 #-#-# translate crowdin gallery_d_088_048be784:
msgid "[_cedrick_] Не переживай, Вилл, меня заменит Булдж"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:642 #-#-# translate crowdin gallery_d_088_ed931728:
msgid "[_will_] К-кто!? Ааххх..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:644 #-#-# translate crowdin gallery_d_088_1ca68df7:
msgid "[_bulj_] Здравствуйте, мисс Вилл"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:646 #-#-# translate crowdin gallery_d_088_d368533a:
msgid "[_cedrick_] (Хах, вежлив даже с чародейкой? И как только он смог научиться таким манерам среди стражников...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:648 #-#-# translate crowdin gallery_d_088_cf480c43:
msgid "[_cedrick_] (Впрочем, сейчас это не важно)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:650 #-#-# translate crowdin gallery_d_088_3140dd9b:
msgid "[_will_] Рик! Мххх... П-подожди... Не бросай меня..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:652 #-#-# translate crowdin gallery_d_088_4f55da7b:
msgid "[_bulj_] Не волнуйтесь, Вилл, я позабочусь о том, чтобы тварь не выбралась из сундука"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:654 #-#-# translate crowdin gallery_d_088_84e648ea:
msgid "[_will_] Д-да пошел ты, не нужна мне твоя забота"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:656 #-#-# translate crowdin gallery_d_088_43f878af:
msgid "[_cedrick_] (Хах, все такая же дерзкая. Что ж, мне пора к Фобосу)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:660 #-#-# translate crowdin gallery_d_088_2e2d52bc:
msgid "[_cedrick_] (Что ж, в любом случае, эта тварь замедлилась. А значит, лучше воспользоваться моментом и дать Миранде меня сменить)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:661 #-#-# translate crowdin gallery_d_088_13d4c866:
msgid "[_cedrick_] (Лучше не испытывать терпение Фобоса)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:663 #-#-# translate crowdin gallery_d_088_37d20482:
msgid "[_will_] Р-рик!? Ты что, собрался оставить меня одну с этой тварью? Куда ты уходишь!?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:665 #-#-# translate crowdin gallery_d_088_2684c0c0:
msgid "[_cedrick_] Не переживай, Вилл. За тобой будет кому присмотреть. Я оставляю тебя в надежных руках"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:667 #-#-# translate crowdin gallery_d_088_7a498a71:
msgid "[_miranda_] Ну здравствуй, стражница"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:669 #-#-# translate crowdin gallery_d_088_0a73d347:
msgid "[_will_] Ч-черт, только не эта паучиха... Она же меня отдаст на растерзание!"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:671 #-#-# translate crowdin gallery_d_088_65f80082:
msgid "[_miranda_] Ох, я бы с радостью, но Седрик этому не обрадуется, да и приказа Фобоса на этот счет полного твоего устранения с помощью Мимика пока не было"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:672 #-#-# translate crowdin gallery_d_088_e05300a1:
msgid "[_cedrick_] Как раз об этом. Меня вызывает Фобос, поэтому, Вилл, я тебя покидаю. Но я вернусь"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:674 #-#-# translate crowdin gallery_d_088_3c46d913:
msgid "[_cedrick_] Доверяю это тебе, Миранда"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:675 #-#-# translate crowdin gallery_d_088_9855a77a:
msgid "[_miranda_] Д-да, Седрик"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:676 #-#-# translate crowdin gallery_d_088_c806b532:
msgid "[_cedrick_] (Что ж. Теперь к Фобосу)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:681 #-#-# translate crowdin gallery_d_091_ca411c04:
msgid "[_cedrick_] (Этот Мимик, он ведет себя иначе, чем в прошлый раз, когда я дал ему развлечься с Корнелией...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:682 #-#-# translate crowdin gallery_d_091_feef8627:
msgid "[_cedrick_] (Возможно, оставь я Мимика на Булджа или даже Миранду, могло произойти что-то непредвиденное...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:684 #-#-# translate crowdin gallery_d_091_49f3e7a1:
msgid "[_will_] Мммххх... Р-рик... Эта тварь, с ней что-то происходит... Мне страшно..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:686 #-#-# translate crowdin gallery_d_091_3527423a:
msgid "[_cedrick_] (Да уж, Меридиан и вправду опасное место для кого-то вроде стражниц. Какими бы силами они не обладали, на деле это все еще обычные земные девушки)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:687 #-#-# translate crowdin gallery_d_091_bb16a4d7:
msgid "[_cedrick_] Стоп... Что значит с ней что-то происходит?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:689 #-#-# translate crowdin gallery_d_091_13dec6d9:
msgid "[_will_] Н-не знаю... Аххх... Но ее щупальца пульсируют..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:691 #-#-# translate crowdin gallery_d_091_c295f5a1:
msgid "[_cedrick_] Что за... Я тоже чувствую, сундук трясется... Что с этим Мимиком происходит..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:695 #-#-# translate crowdin gallery_d_091_e2f19c65:
msgid "[_will_] Черт, она все активнее лезет ко мне... Н-не смей меня так держать, гребаное чудовище"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:697 #-#-# translate crowdin gallery_d_091_d550d403:
msgid "[_cedrick_] К-какого черта... Это уже не просто щупальце... Это что, рука? Из сундука только что вырвалась рука Мимика..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:699 #-#-# translate crowdin gallery_d_091_1484c6ac:
msgid "[_will_] Мммхх... Он так крепко держит меня, н-не вырваться... Я только и могу что сдерживать руками его щупальца..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:700 #-#-# translate crowdin gallery_d_091_dde3e3be:
msgid "[_will_] Н-но когда касаюсь их, слизь еще сильнее начинает на меня действовать... Д-довольно хитроумный механизм для такого монстра... Ааааххх..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:702 #-#-# translate crowdin gallery_d_091_e7facdab:
msgid "[_cedrick_] (Теперь я полностью убежден в том, что поступил верно, решив сам присмотреть за Вилл...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:704 #-#-# translate crowdin gallery_d_091_34efaf7d:
msgid "[_cedrick_] (Будь здесь Булдж или Миранда, им скорее всего не удалось бы сдержать крышку сундука в тот момент, когда из него вылезла рука)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:706 #-#-# translate crowdin gallery_d_091_d0b3b88d:
msgid "[_will_] Д-даже не думай стягивать с меня юбку... Я... Ахххх... Я не позволю тебе сделать что-то подобное..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:708 #-#-# translate crowdin gallery_d_091_a718dbee:
msgid "[_will_] Рик, останови ее... П-прошу..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:710 #-#-# translate crowdin gallery_d_091_7af13f49:
msgid "[_cedrick_] (Так... Не нужно забывать о своей роли... Мимик все еще под моим контролем, я должен этим воспользоваться...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:712 #-#-# translate crowdin gallery_d_091_224745b3:
msgid "[_cedrick_] Прости, Вилл, но такова воля Фобоса. Это его приказ. Я стараюсь удерживать тварь, чтобы она не зашла слишком далеко"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:714 #-#-# translate crowdin gallery_d_091_b2e47690:
msgid "[_cedrick_] Но это все, что я могу для тебя сделать..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:716 #-#-# translate crowdin gallery_d_091_dbfa1cf7:
msgid "[_will_] Р-рик..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:718 #-#-# translate crowdin gallery_d_091_4dead6fb:
msgid "[_cedrick_] Если бы я остановил действия Мимика сейчас, то был бы наказан Фобосом за несоблюдение приказа"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:720 #-#-# translate crowdin gallery_d_091_a79629be:
msgid "[_will_] Н-но, как же так... Аааххх..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:722 #-#-# translate crowdin gallery_d_091_ac70d856:
msgid "[_cedrick_] Мне... Мне правда жаль, Вилл... Прости..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:724 #-#-# translate crowdin gallery_d_091_66b1fba4:
msgid "[_will_] Ммммхх... Эти щупальца... Они все активнее лезут ко мне... А я... Аааххх..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:725 #-#-# translate crowdin gallery_d_091_c3dc1c15:
msgid "[_will_] Я становлюсь все слабее... Это из-за слизи? М-мне все сложнее сдерживать этого Мимика..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:727 #-#-# translate crowdin gallery_d_091_415af845:
msgid "[_will_] Я-я сейчас... Ох, н-нет... Я теряю хватку..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:729 #-#-# translate crowdin gallery_d_091_a7ceec3f:
msgid "[_cedrick_] (Вилл уже явно на пределе...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:730 #-#-# translate crowdin gallery_d_091_b9cdfba1:
msgid "[_cedrick_] Ч-что? Из сундука еще что-то вырывается..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:733 #-#-# translate crowdin gallery_d_091_748bcd06:
msgid "[_will_] О нет... Он... Он правда хочет проникнуть в меня..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:735 #-#-# translate crowdin gallery_d_091_fceb1b16:
msgid "[_cedrick_] (Это что, вторая рука? Они всегда были у этой твари или же она реально так быстро прогрессирует? Связано ли это с тем, что у него в руках сейчас Вилл?)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:736 #-#-# translate crowdin gallery_d_091_3214188c:
msgid "[_cedrick_] (Возможно, Мимик становится сильнее в зависимости от того, насколько сильна жертва в его щупальцах и как долго он ее держит)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:738 #-#-# translate crowdin gallery_d_091_86a5e67f:
msgid "[_will_] Ааааххх... Н-не надо... Не трись о мою киску своим щупальцем..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:739 #-#-# translate crowdin gallery_d_091_ad293bb6:
msgid "[_cedrick_] (Так, сейчас не время думать об этом... Я должен не дать Мимику сделать то, что он задумал)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:740 #-#-# translate crowdin gallery_d_091_a3487edf:
msgid "[_cedrick_] (Но я также не могу сам начать действовать, иначе мой план не сработает...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:742 #-#-# translate crowdin gallery_d_091_22569337:
msgid "[_will_] Ммммххх... Нет, с-стой... Остановись..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:744 #-#-# translate crowdin gallery_d_091_a7549502:
msgid "[_will_] Р-рик... Т-ты правда позволишь этому случиться!? После всего, что между нами было..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:746 #-#-# translate crowdin gallery_d_091_0de13acf:
msgid "[_cedrick_] (Вот он, ключевой момент, Вилл в отчаянии.. Я должен подыграть ей, чтобы мой блеф выглядел как искренний переход на сторону Стражниц)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:747 #-#-# translate crowdin gallery_d_091_a7a77a3f:
msgid "[_cedrick_] Вилл, я... Я не хочу всего этого... Не хочу, чтобы эта тварь сделала что-то подобное с тобой, но... Но что мы можем?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:748 #-#-# translate crowdin gallery_d_091_94e213cf:
msgid "[_cedrick_] Если я ослушаюсь приказа Фобоса, то меня ждет наказание... Он уже отнял большую часть моей силы в качестве кары... Боюсь, в этот раз все может быть еще хуже..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:750 #-#-# translate crowdin gallery_d_091_9490410b:
msgid "[_will_] Н-но как же так... Ты же... Ты все это время был его марионеткой, жертвой обстоятельств... Но неужели ты хочешь и дальше жить так, Рик?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:752 #-#-# translate crowdin gallery_d_091_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:753 #-#-# translate crowdin gallery_d_091_e8129d45:
msgid "[_cedrick_] Н-нет... нет, не хочу..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:754 #-#-# translate crowdin gallery_d_091_bd06b1a9:
msgid "[_cedrick_] Вилл, я не хочу всего этого..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:756 #-#-# translate crowdin gallery_d_091_457ad141:
msgid "[_will_] Тогда, мммххх... Т-тогда поверь в меня, поверь в нас, стражниц... М-мы... аааххх... Мы что-нибудь обязательно придумаем..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:758 #-#-# translate crowdin gallery_d_091_55f04935:
msgid "[_will_] Мы же в конце концов стражницы завесы, мы должны помогать жертвам тирании Фобоса... И тебе мы тоже поможем..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:760 #-#-# translate crowdin gallery_d_091_196ab64b:
msgid "[_cedrick_] Но что вы можете сейчас? Вы же уже заключены в подземелье, Фобос уже победил вас..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:762 #-#-# translate crowdin gallery_d_091_a8827f37:
msgid "[_will_] Мххх... Н-нет, это не так... Фобос не побеждал нас, нас победил ты! И если мы с тобой объединимся, мы точно сможем одолеть Фобоса! В-вместе..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:764 #-#-# translate crowdin gallery_d_091_782da11f:
msgid "[_cedrick_] ...."
msgstr "[_cedrick_] ...."

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:766 #-#-# translate crowdin gallery_d_091_c522dff1:
msgid "[_will_] Рик?... Аааааххх... Эта тварь, Мимик, он все ближе... Я чувствую, как его щупальце пульсирует.."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:768 #-#-# translate crowdin gallery_d_091_45325874:
msgid "[_will_] Мммммхх... Он вот вот войдет в меня..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:770 #-#-# translate crowdin gallery_d_091_87b7ed4a:
msgid "[_cedrick_] ......"
msgstr "[_cedrick_] ......"

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:772 #-#-# translate crowdin gallery_d_091_7a2c1b54:
msgid "[_will_] Р-рик!?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:775 #-#-# translate crowdin gallery_d_091_ffaaf0b2:
msgid "[_cedrick_] (П-проклятье, это сложнее, чем я думал... Мимик становится сильнее)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:776 #-#-# translate crowdin gallery_d_091_a26f9617:
msgid "[_will_] Р-рик, ты поверил в меня? Поверил в нас..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:778 #-#-# translate crowdin gallery_d_091_146cf510:
msgid "[_cedrick_] (Давай же, тварь, поддавайся...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:779 #-#-# translate crowdin gallery_d_091_905b872c:
msgid "[_will_] У-у тебя получится, Рик! Покажи этой сундучной твари!"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:781 #-#-# translate crowdin gallery_d_091_6ca50fcd:
msgid "[_cedrick_] Пфффф... З-захлопнись уже, чертов мимик"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:786 #-#-# translate crowdin gallery_d_091_51802361:
msgid "[_will_] Рик, ты смог... Ты... Ты спас меня..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:788 #-#-# translate crowdin gallery_d_091_d76b456a:
msgid "[_cedrick_] Да, Вилл.. Д-да, спас... Но это может очень многого мне стоить..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:790 #-#-# translate crowdin gallery_d_091_eb2034de:
msgid "[_will_] Мы справимся, Рик... Главное, что теперь ты на нашей стороне"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:791 #-#-# translate crowdin gallery_d_091_49316299_1:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:793 #-#-# translate crowdin gallery_d_091_c854bea3:
msgid "[_cedrick_] Думаешь другие стражницы разделят твою симпатию?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:795 #-#-# translate crowdin gallery_d_091_fd054a66:
msgid "[_will_] Я... Эм, я с ними поговорю..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:797 #-#-# translate crowdin gallery_d_091_a3e48743:
msgid "[_cedrick_] Не думаю, что они послушают..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:799 #-#-# translate crowdin gallery_d_091_512ab185:
msgid "[_cedrick_] В любом случае... Сейчас, только поставлю этот долбаный сундук..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:801 #-#-# translate crowdin gallery_d_091_34bf2371:
msgid "[_cedrick_] (Черт, этот сундук довольно тяжелый... Я ели закрыл его, ну и сильная же тварь этот Мимик..)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:809 #-#-# translate crowdin gallery_d_091_33310d24:
msgid "[_cedrick_] Хм... Сейчас вы не готовы к битве с Фобосом... Даже если я освобожу вас всех, вы не сможете одолеть Фобоса даже с моей помощью..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:813 #-#-# translate crowdin gallery_d_091_a7a41921:
msgid "[_will_] Н-но что же нам тогда делать? Мы не можем просто так сбежать. Если Фобос обнаружит нашу пропажу, тебя... тебя ведь казнят, Рик"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:817 #-#-# translate crowdin gallery_d_091_511ad2f0:
msgid "[_cedrick_] Хах, это в лучшем случае..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:821 #-#-# translate crowdin gallery_d_091_bcd124bf:
msgid "[_will_] ..."
msgstr "[_will_] ..."

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:825 #-#-# translate crowdin gallery_d_091_5d928ffa:
msgid "[_cedrick_] Но, есть у меня одна идея. Решение временное, но оно может сработать"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:829 #-#-# translate crowdin gallery_d_091_314a13b4:
msgid "[_will_] И что же это?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:833 #-#-# translate crowdin gallery_d_091_5ae990f6:
msgid "[_cedrick_] Могриффы. Это оборотни с Меридиана, способные принять любой облик, в том числе и ваш. Какое-то время они смогут водить Фобоса за нос"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:837 #-#-# translate crowdin gallery_d_091_f428eb26:
msgid "[_will_] П-правда!? Отлично, значит у нас будет время подготовиться!"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:838 #-#-# translate crowdin gallery_d_091_1a388e3f:
msgid "[_cedrick_] (На самом деле Фобос моментально смог бы отличить Могриффа от настоящей стражницы)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:842 #-#-# translate crowdin gallery_d_091_77b0c1ef:
msgid "[_cedrick_] (Если бы все было настолько просто, я бы уже давно воспользовался способностью этих оборотней)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:843 #-#-# translate crowdin gallery_d_091_4be7b4d0:
msgid "[_cedrick_] (Стоит и вправду задуматься о том, что я буду делать, если Фобос потребует покорить стражниц, поставив жесткий ультиматум...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:844 #-#-# translate crowdin gallery_d_091_79c7d665:
msgid "[_cedrick_] Да, на подготовку будет время, но я бы не рассчитывал на Могриффов в долгосрочной перспективе. В будущем нам нужно будет более изящное решение"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:848 #-#-# translate crowdin gallery_d_091_d268be20:
msgid "[_will_] Какое, например? Сделать вид, что ты поймал нас и притвориться рабынями?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:852 #-#-# translate crowdin gallery_d_091_8c079d4b:
msgid "[_cedrick_] Хм... На самом деле я бы так не рисковал. Это рабочий вариант, но есть риск того, что вы никогда не выберетесь из пут Фобоса, если попадете в них"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:856 #-#-# translate crowdin gallery_d_091_c347645f:
msgid "[_will_] Да уж, не хотелось бы..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:860 #-#-# translate crowdin gallery_d_091_49316299_2:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:864 #-#-# translate crowdin gallery_d_091_db243037:
msgid "[_cedrick_] Я что нибудь придумаю. А пока, мне нужно отправляться на переговоры с Фобосом и к другим стражницам"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:868 #-#-# translate crowdin gallery_d_091_97ea9a2b:
msgid "[_will_] Р-рик... Все ведь будет хорошо? У нас... у нас получится сбежать?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:872 #-#-# translate crowdin gallery_d_091_ab5e0f39:
msgid "[_cedrick_] Да, я сделаю для этого все возможное, Вилл"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:876 #-#-# translate crowdin gallery_d_091_54542fde:
msgid "[_will_] Я рада... Правда рада, что теперь наши мотивы совпадают... Наверное я еще даже до конца не осознала, на сколько это все для нас меняет..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:880 #-#-# translate crowdin gallery_d_091_7ac3e0e0:
msgid "[_cedrick_] У тебя будет время подумать над этим. Не сочти за издевку, но тебе придется побыть здесь какое-то время, пока я не разберусь с остальными стражницами"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:884 #-#-# translate crowdin gallery_d_091_fa38521f:
msgid "[_will_] Эм... Х-хорошо..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:888 #-#-# translate crowdin gallery_d_091_9125e2ea:
msgid "[_will_] Главное, убери этот сундук от меня подальше..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:892 #-#-# translate crowdin gallery_d_091_141f81ee:
msgid "[_cedrick_] Да, точно. Само собой, в камере с этой тварью я тебя не оставлю"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:896 #-#-# translate crowdin gallery_d_091_4429e29b:
msgid "[_will_] Спасибо, Рик. Я верю, что ты справишься и буду ждать тебя"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:900 #-#-# translate crowdin gallery_d_091_870457ed:
msgid "[_cedrick_] Благодарю. До скорого, Вилл"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:902 #-#-# translate crowdin gallery_d_091_449fdf75:
msgid "[_cedrick_] (Черт, вот бы со всеми ними было также просто...)"
msgstr ""

