msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:184 #-#-# translate crowdin go_to_meredian_to_miranda_1f6be6e5_1:
msgid "[_bulj_] ..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:188 #-#-# translate crowdin go_to_meredian_to_miranda_10242dc1_2:
msgid "[_miranda_] ..."
msgstr "[_miranda_] ..."

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:192 #-#-# translate crowdin go_to_meredian_to_miranda_9b72ecb5:
msgid "[_bulj_] Тогда, как мы поступим со Стражницами, лорд Седрик?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:198 #-#-# translate crowdin go_to_meredian_to_miranda_e295306f:
msgid "[_cedrick_] План простой - разделяй и властвуй. Я уже разделил их на три группы. Не без твоей помощи, Булдж"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:199 #-#-# translate crowdin go_to_meredian_to_miranda_4bcbe637:
msgid "[_cedrick_] Корнелия и Хай Лин находятся в борделе - месте, хозяйка которого уже дала понять, что находится лично на моей стороне. Там стражниц не найдут"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:200 #-#-# translate crowdin go_to_meredian_to_miranda_5cc6882e:
msgid "[_cedrick_] Где Ирма и Тарани, Булдж?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:204 #-#-# translate crowdin go_to_meredian_to_miranda_e86c7bf1:
msgid "[_bulj_] В казармах, Сэр. После боя с Королем Морпионов, некоторые стражники поклялись в верности лично вам. Теми темницами как раз заведует лояльная вам группа стражников"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:208 #-#-# translate crowdin go_to_meredian_to_miranda_48513c4d:
msgid "[_cedrick_] И, наконец, предводительница стражниц, Вилл?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:212 #-#-# translate crowdin go_to_meredian_to_miranda_ca3fafae:
msgid "[_miranda_] Ей занялась я, как ты и просил. Правда я все еще считаю, что отдавать ее на растерзание мимику все еще слишком жестоко"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:216 #-#-# translate crowdin go_to_meredian_to_miranda_a9afb7bb:
msgid "[_cedrick_] Ого, Миранда. Совсем недавно ты воспринимала ее исключительно в качестве конкуретнки. А теперь что, беспокоишься за нее?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:220 #-#-# translate crowdin go_to_meredian_to_miranda_dea2ff59:
msgid "[_miranda_] Н-нет, просто.. Если хочешь устроить спектакль, лучше не приносить на него настоящие мечи, понимаешь, о чем я?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:224 #-#-# translate crowdin go_to_meredian_to_miranda_d315464b:
msgid "[_cedrick_] Хм, думаешь сундук-мимик слишком опасен?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:228 #-#-# translate crowdin go_to_meredian_to_miranda_99b3d502:
msgid "[_miranda_] После того, как он развлекся с Корнелией, он стал даже еще сильнее. Эта тварь эволюционирует, Рик"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:232 #-#-# translate crowdin go_to_meredian_to_miranda_2f6f8fea:
msgid "[_miranda_] Поэтому это единственный экземпляр, который я не осмеливаюсь изучать. Потому что пока ты изучаешь эту тварь, она изучает тебя"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:236 #-#-# translate crowdin go_to_meredian_to_miranda_49316299_1:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:237 #-#-# translate crowdin go_to_meredian_to_miranda_36146fca:
msgid "[_cedrick_] Звучит устрашающе, но..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:238 #-#-# translate crowdin go_to_meredian_to_miranda_993c82be:
msgid "[_cedrick_] Иначе Вилл не поверит в происходящее. Наши с ней отношения стали довольно специфичными за это время, не без помощи силы морпиона и эссенции"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:242 #-#-# translate crowdin go_to_meredian_to_miranda_bec3863c:
msgid "[_cedrick_] Иными словами, она почувствует настоящую угрозу только если с ней произойдет то, чего, как она считает, я бы никогда с ней не допустил"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:246 #-#-# translate crowdin go_to_meredian_to_miranda_5f44c3a6:
msgid "[_miranda_] Хм, значит это ее расплата за чрезмерную близость с тобой? Беру свои слова назад, мне нисколько ее не жаль"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:250 #-#-# translate crowdin go_to_meredian_to_miranda_2830ef00:
msgid "[_cedrick_] Хах. за несколько сотен лет ни разу не видел, чтобы ты к кому-то меня ревновала. Неужели чувствуешь от Вилл угрозу для своего статуса моей любимой?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:254 #-#-# translate crowdin go_to_meredian_to_miranda_13f9794c:
msgid "[_miranda_] Я... Эм... Кхм... Давай не при Булдже, Сэдрик"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:260 #-#-# translate crowdin go_to_meredian_to_miranda_f088951d:
msgid "[_bulj_] Я как раз собирался уходить, Лорд Сэдрик. Если вы закончили"
