# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:266 #-#-# translate crowdin go_to_meredian_to_miranda_6d743bdf:
msgid "[_cedrick_] Да, в целом я все объяснил. Враг моего врага - мой друг. Разделяй и властвуй. Я жертва обстоятельств. Все в этом духе"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:267 #-#-# translate crowdin go_to_meredian_to_miranda_418b072c:
msgid "[_cedrick_] Стражницы пробудут на Меридиане пару дней, после чего я сделаю вид, что спас их и хочу присоединиться к команде хороших ребят"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda.rpy:268 #-#-# translate crowdin go_to_meredian_to_miranda_e83ec873:
msgid "[_cedrick_] А пока, можешь устроить им пытки согласно плану. Я присоединюсь чуть позже. У нас с Мирандой намечается разговор"
