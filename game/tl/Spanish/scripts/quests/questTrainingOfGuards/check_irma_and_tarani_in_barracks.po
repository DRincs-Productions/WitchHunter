# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:6 #-#-# translate crowdin check_irma_and_tarani_in_barracks_ed65cc5d:
msgid "[_cedrick_] Как продвигаются тренировки стражниц, Булдж?"
msgstr "[_cedrick_] ¿Cómo progresan las Guardianas en el entrenamiento, Bulj?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:7 #-#-# translate crowdin check_irma_and_tarani_in_barracks_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] …"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:8 #-#-# translate crowdin check_irma_and_tarani_in_barracks_2ee3c359:
msgid "[_cedrick_] Булдж..?"
msgstr "[_cedrick_] ¿Abultamiento…?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:9 #-#-# translate crowdin check_irma_and_tarani_in_barracks_87b7ed4a:
msgid "[_cedrick_] ......"
msgstr "[_cedrick_] …"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:10 #-#-# translate crowdin check_irma_and_tarani_in_barracks_2e57c77f:
msgid "[_cedrick_] (Черт, Булдж что, без сознания!? Неужели Ирма и Тарани объединились и сбежали...)"
msgstr "[_cedrick_] (Mierda, ¿Bulj está inconsciente? ¿Irma y Taranee se unieron y escaparon…?)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:11 #-#-# translate crowdin check_irma_and_tarani_in_barracks_e4f5300b:
msgid "[_cedrick_] (Или же... О нет...)"
msgstr "[_cedrick_] (O… Oh No…)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:13 #-#-# translate crowdin check_irma_and_tarani_in_barracks_df9020d6:
msgid "Вы совершили неправильный выбор. Далее вас ждет GAME OVER, в котором присутствует NTR-сцена с воинами. Если вы хотите продолжить, нажмите «Да». Чтобы пропустить этот контент и вернуться в главное меню, нажмите «Нет». Вы хотите продолжить?"
msgstr "Hiciste la elección equivocada. A continuación encontrarás el juego, en el que hay una ntr-escena con guerreros. Si quieres continuar, haz clic en “sí”. Para omitir este contenido y volver al menú principal, haga clic en “no”. ¿Quieres continuar?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:19 #-#-# translate crowdin gallery_d_093_05bd1bbb:
msgid "[_tarani_] Мххх... П-пустите нас, гребаные ублюдки... Н-не прикасайтесь..."
msgstr "[_tarani_] Mxx… Déjanos, malditos bastardos… No toques…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:20 #-#-# translate crowdin gallery_d_093_f9886bb8:
msgid "[_irma_] Аааххх... Н-не надо.. П-прошу..."
msgstr "[_irma_] Aahhh… No… Por favor…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:21 #-#-# translate crowdin gallery_d_093_2f25ca3b:
msgid "[_cedrick_] Ч-что... Что здесь происходит..."
msgstr "[_cedrick_] ¿Qué… ¿Qué está pasando aquí…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:24 #-#-# translate crowdin gallery_d_093_1a90a763:
msgid "[_irma_] С-серик, п-помоги... Ммммхх..."
msgstr "[_irma_] C-Cedric, ayúdame… Mmm…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:26 #-#-# translate crowdin gallery_d_093_d5b8b257:
msgid "[_str1_] О, бывший главнокомандующий, а вот и вы"
msgstr "[_str1_] O, ex comandante en jefe, y aquí estás"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:27 #-#-# translate crowdin gallery_d_093_47e6b6f2:
msgid "[_cedrick_] Какого черта вы делаете?"
msgstr "[_cedrick_] ¿Qué diablos estás haciendo?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:28 #-#-# translate crowdin gallery_d_093_641e43c6:
msgid "[_str2_] А что такого? Мы просто учим этих земных девок хорошим манерам"
msgstr "[_str2_] ¿Qué pasa? Solo enseñamos a estas chicas terrenales buenos modales"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:29 #-#-# translate crowdin gallery_d_093_54db0aec:
msgid "[_cedrick_] И кто вам позволил?"
msgstr "[_cedrick_] ¿Y quién te ha permitido?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:31 #-#-# translate crowdin gallery_d_093_b943cf48:
msgid "[_str3_] Хах, скорее нужно спросить, а кто нам запрещал? А, точно. Этот выскочка Булдж что-то мямлил про подготовку и неприкосновенность"
msgstr "[_str3_] Ja, más bien necesita preguntar, ¿quién nos prohibió? Oh, eso es correcto. Este advenedizo Bulj algo se quedó con calma sobre el entrenamiento y la inviolabilidad"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:33 #-#-# translate crowdin gallery_d_093_81e14541:
msgid "[_tarani_] Ааааххх... Аааххх... Х-хватит тыкать его в мое лицо..."
msgstr "[_tarani_] Aahhhhhhhh aahhh… Deja de apuntarlo a mi cara…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:35 #-#-# translate crowdin gallery_d_093_7082d299:
msgid "[_irma_] Ммммххх... Их так много..."
msgstr "[_irma_] Mmm… Hay muchos de ellos…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:37 #-#-# translate crowdin gallery_d_093_c0de625b:
msgid "[_str2_] Да, Булдж даже огрызаться начал. Но мы все делали согласно уставу. Сегодня после полудня мы как обычно меняемся казармами с другим отрядом"
msgstr "[_str2_] Sí, Bulj incluso comenzó a romperse. Pero hicimos todo de acuerdo con la carta. Hoy, tarde, cambiamos los cuarteles con otro destacamento como siempre"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:38 #-#-# translate crowdin gallery_d_093_a62f606a:
msgid "[_str2_] Булдж начал возражать, ну мы и приложили его малость головушкой в стену, ахахах"
msgstr "[_str2_] Bulj comenzó a objetar, bueno, lo pusimos una pequeña cabeza en la pared, ahaha"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:39 #-#-# translate crowdin gallery_d_093_fbd84016:
msgid "[_cedrick_] (Черт, так вот что произошло... Смена казармами... Точно, согласно расписанию несколько раз в месяц стражников тасуют между казармами, чтобы они не засиживались на одном месте...)"
msgstr "[_cedrick_] (Maldita sea, ¿qué pasó… Cambiar los cuarteles… Precisamente, según el horario varias veces al mes, los guardias se mezclan entre los cuarteles, para que no se sienten en un solo lugar…)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:40 #-#-# translate crowdin gallery_d_093_0fcbeecb:
msgid "[_cedrick_] (Но как мы этого не предвидели... Или же...)"
msgstr "[_cedrick_] (Pero cómo no lo previmos… O…)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:42 #-#-# translate crowdin gallery_d_093_fd594e17:
msgid "[_irma_] Аааххх... Мммххх... Они не только в моей киске, но и в попке... Д-двигаются одновременно... Аааххх... Это... Это просто безумие..."
msgstr "[_irma_] Aahhh… Mmhhhh… No solo están en mi coño, también en mi culo… S-se mueven al mismo tiempo… Aahhh… Esto… esto es una locura…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:44 #-#-# translate crowdin gallery_d_093_dbcaa711:
msgid "[_tarani_] Аааахх... Ч-черт... Я... Ммвввв... Я не собираюсь брать твой член в рот, ублюдок... О-отпусти меня..."
msgstr "[_tarani_] Aaaah… M-mierda… Yo… Mmmvvv… ¡No voy a meterme tu verga en la boca, bastardo… S-suéltame…!"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:46 #-#-# translate crowdin gallery_d_093_adf1061e:
msgid "[_cedrick_] Кто был инициатором смены казарм? Это явно произошло не по расписанию"
msgstr "[_cedrick_] ¿Quién fue el iniciador del cambio de cuartel? Esto claramente no sucedió según lo previsto"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:47 #-#-# translate crowdin gallery_d_093_000557e1:
msgid "[_str3_] Князь Фобос приказал нам. Сегодня он явно настроен на перемены"
msgstr "[_str3_] El príncipe Fobos nos ha ordenado. Hoy está claramente decidido a cambiar"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:49 #-#-# translate crowdin gallery_d_093_27f43070:
msgid "[_cedrick_] (Черт, так он обо всем знал... Или же это просто случайность?)"
msgstr "[_cedrick_] (Maldita sea, así que sabía de todo… ¿O es solo un accidente?)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:50 #-#-# translate crowdin gallery_d_093_e5d2d290:
msgid "[_cedrick_] (Нет, раз я все еще не под стражей, значит это лишь совпадение. Фобос сегодня и вправду ведет себя странно. Но это... Проклятье, этого мы не могли предвидеть...)"
msgstr "[_cedrick_] (No, ya que todavía no estoy bajo custodia, es solo una coincidencia. Fobos realmente se está comportando de manera extraña hoy. Pero esto es… Maldita sea, no podríamos haberlo previsto…)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:52 #-#-# translate crowdin gallery_d_093_bac96aae:
msgid "[_str2_] Булдж говорил что-то о тренировках и посвящении в воины, прежде чем мы окончательно его вырубили"
msgstr "[_str2_] Bulj dijo algo sobre el entrenamiento y la dedicación a los guerreros antes de que finalmente lo reduzcamos"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:53 #-#-# translate crowdin gallery_d_093_dfda862c:
msgid "[_str1_] Но как мы поняли, этих девок нужно было посвятить в воины, как часть будущей стражи"
msgstr "[_str1_] Pero como entendimos, estas chicas tuvieron que dedicarse a los soldados como parte de los futuros guardias"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:55 #-#-# translate crowdin gallery_d_093_325a23a3:
msgid "[_irma_] Аааааххх... П-перестаньте... Не долбите меня так жестко... Я... Мммм... Я скоро кончу..."
msgstr "[_irma_] Aaaaah… P-paren… No me den tan fuerte… Yo… Mmmm… pronto me voy a correr…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:57 #-#-# translate crowdin gallery_d_093_452695dd:
msgid "[_tarani_] Аааххх... Мммммхх... У-ублюдки, так нещадно трахать мою киску... Д-да как вы смеете..."
msgstr "[_tarani_] Aahhh… Mmmmhhhhhhhh bastardos, tan despiadadamente a la mierda mi coño… ¿Cómo te atreves…?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:59 #-#-# translate crowdin gallery_d_093_e75fce70:
msgid "[_str3_] Вот мы и решили посвятить девчонок в воины. Ведь когда они станут частью стражи, подобное будет происходить с ними каждый день! Ахахаха"
msgstr "[_str3_] Así que decidimos dedicar a las chicas a los soldados. Después de todo, cuando se conviertan en parte de los guardias, ¡esto les sucederá todos los días! Ahahaha"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:60 #-#-# translate crowdin gallery_d_093_ba937f4b:
msgid "[_str2_] Ахахахах, отлично сказано!"
msgstr "[_str2_] Ahahaha, bien dicho!"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:61 #-#-# translate crowdin gallery_d_093_4e69a4f6:
msgid "[_str1_] Кстати говоря, раз это земные девки, не значит ли это, что они одни из тех самых стражниц завесы?"
msgstr "[_str1_] Por cierto, si son chicas terrenales, ¿no significa que son uno de esos mismos guardianas de velo?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:62 #-#-# translate crowdin gallery_d_093_f89f7db9:
msgid "[_cedrick_] ....."
msgstr "[_cedrick_] …"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:63 #-#-# translate crowdin gallery_d_093_6bbe9a13:
msgid "[_cedrick_] (Это конец... Мало того, что мой план с Ирмой и Тарани провалился, так еще и их раскрыли. Не важно, как именно я сейчас оправдаюсь)"
msgstr "[_cedrick_] (Este es el fin… No solo fracasó mi plan con Irma y Taranee, sino que además las descubrieron. Ahora da igual cómo intente justificarme.)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:64 #-#-# translate crowdin gallery_d_093_369d7964:
msgid "[_cedrick_] (В будущем один из стражников в любом случае проболтается Фобосу о том, что кто-то когда-то трахал двух стражниц в казармах...)"
msgstr "[_cedrick_] (En el futuro, una de las Guardianas en cualquier caso se arremolina a Fobos que alguien una vez se cogió a dos guardianas en el cuartel…)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:65 #-#-# translate crowdin gallery_d_093_cbf6cd10:
msgid "[_cedrick_] (А после того, как узнает Фобос, нас всех казнят... Это была фатальная ошибка...)"
msgstr "[_cedrick_] (Y después de que los Fobos se enteren, todos somos ejecutados… Fue un error fatal…)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:67 #-#-# translate crowdin gallery_d_093_0df57cd6:
msgid "[_tarani_] Аааххх... Ч-черт... Я кончаю... Кончаю из-за этих долбаных ублюдков..."
msgstr "[_tarani_] Aahhh… M-mierda… Me corro… ¡Me corro por culpa de estos malditos bastardos…!"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:69 #-#-# translate crowdin gallery_d_093_88a4e3d5:
msgid "[_irma_] Мммммххх... И я... И я кончаю, Тарани... К-как же до этого дошло..."
msgstr "[_irma_] Mmmmkh… Y yo… Y estoy triste, Taranee… ¿Cómo llegó a esto…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:75 #-#-# translate crowdin gallery_d_093_16eaeaba:
msgid "[_str1_] Получайте, шлюшки!"
msgstr "[_str1_] ¡Tomen esto, zorras!"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:76 #-#-# translate crowdin gallery_d_093_ad073976:
msgid "[_str2_] Добро пожаловать в ряды княжеской стражи, аахахах!!"
msgstr "[_str2_] Bienvenido a las filas de los guardias principescos, aahahach!!"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:77 #-#-# translate crowdin gallery_d_093_76b78ebb:
msgid "[_str3_] Да, черт, я спустил прямо на нее"
msgstr "[_str3_] Sí, maldita sea, me decepcioné"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:79 #-#-# translate crowdin gallery_d_093_39285f72:
msgid "[_str4_] Ну все, теперь моя очередь трахать ее в задницу"
msgstr "[_str4_] Bien, ahora es mi turno de cogérmela por el culo."

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:80 #-#-# translate crowdin gallery_d_093_b0781c14:
msgid "[_str5_] Эй, вообще-то сейчас был мой черед"
msgstr "[_str5_] Oye, en realidad me tocó"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:82 #-#-# translate crowdin gallery_d_093_06964fbc:
msgid "[_str6_] Мужики, давайте тогда решим очередность игрой в кости"
msgstr "[_str6_] Hombres, decidamos entonces el orden del juego en los dados"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:84 #-#-# translate crowdin gallery_d_093_f89f7db9_1:
msgid "[_cedrick_] ....."
msgstr "[_cedrick_] …"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:85 #-#-# translate crowdin gallery_d_093_2cba10cf:
msgid "[_cedrick_] Вот и все..."
msgstr "[_cedrick_] Eso es todo…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:96 #-#-# translate crowdin gallery_d_094_29fbf160:
msgid "[_cedrick_] Как ваши успехи, Миранда?"
msgstr "[_cedrick_] ¿Cómo estás, Miranda?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:97 #-#-# translate crowdin gallery_d_094_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] …"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:98 #-#-# translate crowdin gallery_d_094_5f32efff:
msgid "[_cedrick_] Ч-что за..."
msgstr "[_cedrick_] ¿Qué es…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:99 #-#-# translate crowdin gallery_d_094_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:100 #-#-# translate crowdin gallery_d_094_0fd4d656:
msgid "......"
msgstr "…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:101 #-#-# translate crowdin gallery_d_094_278c7e29:
msgid "........."
msgstr "…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:102 #-#-# translate crowdin gallery_d_094_6ca7d185:
msgid "[_cedrick_] Миранда, что они здесь устроили?"
msgstr "[_cedrick_] Miranda, ¿qué hicieron aquí?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:103 #-#-# translate crowdin gallery_d_094_b4cfb35e:
msgid "[_tarani_] Ааааххх... Ааааххх..."
msgstr "[_tarani_] Aahhh… Aahhhhhhhh"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:107 #-#-# translate crowdin gallery_d_094_9a2d1578:
msgid "[_irma_] Вот так, шлюшка... П-получай!! Нравится, когда я трахаю тебя своим членом!?"
msgstr "[_irma_] Eso es, puta… ¡Consíguelo!! Me gusta cuando te jodo mi verga!?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:108 #-#-# translate crowdin gallery_d_094_a455dd0c:
msgid "[_tarani_] Аааххх... Мммхх... И-ирма, хватит... Я... Ааавв... Я сдаюсь... "
msgstr "[_tarani_] Aaaah… Mmmmh… Yo-Irma, basta… Yo… Aaah… Me rindo…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:110 #-#-# translate crowdin gallery_d_094_24bbc277:
msgid "[_miranda_] Что ж, Тарани проиграла. И уже довольно давно. Я впечатлена, Ирма. Думала исход будет иным"
msgstr "[_miranda_] Barani perdió. Y ha pasado mucho tiempo. Estoy impresionado, Irma. Pensé que el resultado sería diferente"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:111 #-#-# translate crowdin gallery_d_094_41c8e8e1:
msgid "[_cedrick_] Миранда, что здесь происходит?"
msgstr "[_cedrick_] Miranda, ¿qué está pasando aquí?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:112 #-#-# translate crowdin gallery_d_094_45432c52:
msgid "[_miranda_] Как видишь, их тренировка слегка вышла из под контроля"
msgstr "[_miranda_] Como puede ver, su entrenamiento está ligeramente fuera de control"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:114 #-#-# translate crowdin gallery_d_094_62899f13:
msgid "[_tarani_] Ааааххх... Ааааххх... Ирма, прошу, х-хватит... Умоляю, остановись..."
msgstr "[_tarani_] Aahhh… Aahhhhhhhh Irma, por favor, oh, uh… Te lo ruego, para…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:116 #-#-# translate crowdin gallery_d_094_aa7067d9:
msgid "[_irma_] Я остановлюсь когда сама захочу!"
msgstr "[_irma_] ¡Me detendré cuando lo quiera!"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:118 #-#-# translate crowdin gallery_d_094_d2557803:
msgid "[_tarani_] Мммммххх... Т-такими темпами я снова кончу..."
msgstr "[_tarani_] Mmmmm… A este ritmo volveré a correrme…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:120 #-#-# translate crowdin gallery_d_094_782da11f:
msgid "[_cedrick_] ...."
msgstr "[_cedrick_] …"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:121 #-#-# translate crowdin gallery_d_094_4cd628b6:
msgid "[_miranda_] Что такое, Седрик?"
msgstr "[_miranda_] ¿Qué pasa, Cedric?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:122 #-#-# translate crowdin gallery_d_094_fd38cb03:
msgid "[_cedrick_] Мне кажется, для них это немного перебор..."
msgstr "[_cedrick_] Creo que es un poco demasiado para ellos…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:123 #-#-# translate crowdin gallery_d_094_b55c0c5c:
msgid "[_miranda_] Эм... Кхм, а разве не в этом была суть их тренировки? Согласно приказу Фобоса, само собой"
msgstr "[_miranda_] Mm… Km, ¿no era esa la esencia de su entrenamiento? Según el orden de Fobos, por supuesto"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:124 #-#-# translate crowdin gallery_d_094_a83765d0:
msgid "[_cedrick_] Д-да, но..."
msgstr "[_cedrick_] Sí, pero…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:125 #-#-# translate crowdin gallery_d_094_b2e47b92:
msgid "[_cedrick_] Тарани, ты там в порядке?"
msgstr "[_cedrick_] Taranee, ¿estás bien?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:127 #-#-# translate crowdin gallery_d_094_68392a14:
msgid "[_tarani_] Мммммввв... П-похоже на то, что я в порядке, придурок!?"
msgstr "[_tarani_] Mmmvv… Parece que estoy bien, ¿imbécil?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:129 #-#-# translate crowdin gallery_d_094_38695d1a:
msgid "[_cedrick_] Кхм. Понял, хоть и немного сломлена, но она в порядке.Чего не могу сказать об Ирме..."
msgstr "[_cedrick_] Ejem. Entiendo: aunque está un poco quebrada, se encuentra bien. No puedo decir lo mismo de Irma…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:131 #-#-# translate crowdin gallery_d_094_81ce81f0:
msgid "[_irma_] Дааа, вот так, получи его в свою киску!!"
msgstr "[_irma_] Sííí, así, ¡recíbela en tu vagina!"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:132 #-#-# translate crowdin gallery_d_094_7ee56146:
msgid "[_cedrick_] (Интересно, это ее так накрыло из-за того, что я использовал силу короля морпионов?)"
msgstr "[_cedrick_] (Me pregunto, ¿lo cubrió tanto porque usé el poder del rey de los marineros?)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:133 #-#-# translate crowdin gallery_d_094_570a6c2c:
msgid "[_cedrick_] (Или же просто все ее потаенные желания вырвались наружу, как только она получила каплю власти? В любом случае, мне это на руку)"
msgstr "[_cedrick_] (¿O acaso todos sus deseos ocultos salieron a la luz en cuanto obtuvo una pizca de poder? De cualquier modo, esto me conviene.)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:135 #-#-# translate crowdin gallery_d_094_8e908abb:
msgid "[_cedrick_] Миранда, никаких происшествий не было в мое отсутствие?"
msgstr "[_cedrick_] Miranda, ¿no hubo incidentes en mi ausencia?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:136 #-#-# translate crowdin gallery_d_094_3c38723a:
msgid "[_miranda_] Кое-что было. Приходил отряд стражников и сказал, что сегодня должна произойти смена казармами. Хотели занять это место"
msgstr "[_miranda_] Algo fue. Un destacamento de guardias vino y dijo que hoy debería haber un cambio de cuartel. Quería tomar este lugar"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:138 #-#-# translate crowdin gallery_d_094_3ebcb0ba:
msgid "[_miranda_] Но, само собой, я их даже на порог не пустила. Сказала, что провожу тут один эксперимент и любым посторонним вход воспрещен"
msgstr "[_miranda_] Pero, por supuesto, ni siquiera los dejé en la puerta. Dijo que estoy llevando a cabo un experimento aquí y que cualquier extraño está prohibido"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:140 #-#-# translate crowdin gallery_d_094_1a8fcbe7:
msgid "[_cedrick_] Смена казармами? Вот черт... Будь на твоем месте Булдж, не уверен, что он смог бы дать такой отпор. Значит я сделал правильный выбор"
msgstr "[_cedrick_] ¿Cambiar barracones? Eso es el infierno… Si Bulj fueras tú, no estoy seguro de que pudiera luchar contra eso. Así que tomé la decisión correcta"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:141 #-#-# translate crowdin gallery_d_094_53358ebf:
msgid "[_miranda_] Еще бы. Но, что странно, неожиданная смена произошла сегодня по приказу Фобоса. Поэтому Булдж о ней не знал. Думаешь он догадался?"
msgstr "[_miranda_] sería más. Pero, extrañamente, un cambio inesperado ocurrió hoy por orden de Fobos. Por eso Bulj no sabía nada de ella. ¿Crees que lo ha adivinado?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:142 #-#-# translate crowdin gallery_d_094_e40af106:
msgid "[_cedrick_] Вряд ли... Но все же, это странно..."
msgstr "[_cedrick_] No creo… Pero aún así, es raro…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:144 #-#-# translate crowdin gallery_d_094_c9ccb02c:
msgid "[_tarani_] Мммммввв... Н-нет, я кончаю... Аааааххх"
msgstr "[_tarani_] Mmmvv… N-no, he terminado… Aaahhh"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:146 #-#-# translate crowdin gallery_d_094_e171b4d3:
msgid "[_irma_] Да, шлюшка, кончай от моего члена, давай!"
msgstr "[_irma_] Sí, puta, córrete con mi verga. ¡Vamos!"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:148 #-#-# translate crowdin gallery_d_094_0397ba17:
msgid "[_tarani_] Ммммммхххх..."
msgstr "[_tarani_] Mmmmmhhh…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:149 #-#-# translate crowdin gallery_d_094_39fbacc0:
msgid "[_cedrick_] Так, пожалуй стоит разделить этих двоих, пока они совсем не обезумели"
msgstr "[_cedrick_] Es, tal vez, que vale la pena dividir estos dos, hasta que no estén enojados"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:154 #-#-# translate crowdin gallery_d_094_5887470a:
msgid "[_cedrick_] Давай, Ирма, отпусти Тарани. С нее уже хватит"
msgstr "[_cedrick_] Vamos, Irma, deja ir a Taranee. Ya es suficiente"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:155 #-#-# translate crowdin gallery_d_094_0b2241cf:
msgid "[_tarani_] Ааахх... Аааххх..."
msgstr "[_tarani_] Aahh… Aahhh…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:156 #-#-# translate crowdin gallery_d_094_370dc0e2:
msgid "[_irma_] Н-нет, еще не все..."
msgstr "[_irma_] N-no, no todos…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:157 #-#-# translate crowdin gallery_d_094_88b7ebef:
msgid "[_cedrick_] А я сказал все"
msgstr "[_cedrick_] Lo dije todo"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:158 #-#-# translate crowdin gallery_d_094_795678bb:
msgid "[_irma_] ..."
msgstr "[_irma_] …"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:159 #-#-# translate crowdin gallery_d_094_d5ced0bb:
msgid "[_cedrick_] Тарани, ты как?"
msgstr "[_cedrick_] Taranee, ¿cómo estás?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:160 #-#-# translate crowdin gallery_d_094_f9c4ef12:
msgid "[_tarani_] Мммххх..."
msgstr "[_tarani_] Mmkh…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:161 #-#-# translate crowdin gallery_d_094_6b1aef94:
msgid "[_cedrick_] Думаю ей нужно время, чтобы прийти в себя. И тебе тоже, Ирма"
msgstr "[_cedrick_] Creo que se necesita tiempo para recuperarse. Y tú también, Irma"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:162 #-#-# translate crowdin gallery_d_094_c378d731:
msgid "[_cedrick_] Миранда, можешь пока идти, я присмотрю за ними"
msgstr "[_cedrick_] Miranda, puedes ir mientras los veo"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:163 #-#-# translate crowdin gallery_d_094_f8d9c91f:
msgid "[_miranda_] Как скажешь, Седрик. Если что я рядом"
msgstr "[_miranda_] Puedes decir, Cedric. Si estoy cerca"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:167 #-#-# translate crowdin gallery_d_094_3bf7cd5c:
msgid "[_centered_] {size=37}Седрик дает Ирме и Тарани немного времени, чтобы прийти в себя{/size}"
msgstr "[_centered_] {size=37}Cedric le da a Irme y Taranee un poco de tiempo para recuperarse{/size}"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:175 #-#-# translate crowdin gallery_d_094_804089e5:
msgid "[_cedrick_] Как вы себя чувствуете?"
msgstr "[_cedrick_] ¿Cómo te sientes?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:179 #-#-# translate crowdin gallery_d_094_7b971d00:
msgid "[_irma_] О боже... Я... Тарани, я... П-прости меня, я не знаю, что на меня нашло..."
msgstr "[_irma_] Oh, Dios… Yo… Taranee, yo… P-perdóname, no sé qué me pasó…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:183 #-#-# translate crowdin gallery_d_094_6fc115a4:
msgid "[_irma_] Это... О нет, какой кошмар, что же я наделала..."
msgstr "[_irma_] Es… No, qué pesadilla, qué hice…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:187 #-#-# translate crowdin gallery_d_094_95d9464e:
msgid "[_cedrick_] Тарани, ты в порядке?"
msgstr "[_cedrick_] Taranee, ¿estás bien?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:192 #-#-# translate crowdin gallery_d_094_98f84176:
msgid "[_tarani_] ..."
msgstr "[_tarani_] …"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:196 #-#-# translate crowdin gallery_d_094_3452955c:
msgid "[_tarani_] Я уже в норме..."
msgstr "[_tarani_] Estoy bien ahora…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:200 #-#-# translate crowdin gallery_d_094_dd23ae9a:
msgid "[_cedrick_] Ирма, вот что происходит с людьми, когда они получают над кем-то власть и при этом их всегда может оправдать чей-то чужой приказ от того, кто стоит выше"
msgstr "[_cedrick_] Irma, esto es lo que le sucede a la gente cuando obtiene poder sobre alguien y al mismo tiempo siempre puede ser justificado por la orden de otra persona de quien está arriba"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:204 #-#-# translate crowdin gallery_d_094_9b5d804c:
msgid "[_cedrick_] Лишь немногие могут сопротивляться этой опьяняющей силе... Я тоже не смог..."
msgstr "[_cedrick_] Sólo unos pocos pueden resistir este poder embriagador. Yo tampoco podría…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:208 #-#-# translate crowdin gallery_d_094_98f84176_1:
msgid "[_tarani_] ..."
msgstr "[_tarani_] …"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:212 #-#-# translate crowdin gallery_d_094_d9d9cce2:
msgid "[_irma_] Т-теперь я понимаю..."
msgstr "[_irma_] Ahora entiendo…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:216 #-#-# translate crowdin gallery_d_094_855ff183:
msgid "[_irma_] (Так вот, через что на самом деле проходил Седрик...)"
msgstr "[_irma_] (Así que aquí, lo que realmente fue Cedric…)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:217 #-#-# translate crowdin gallery_d_094_5e0a1d6d:
msgid "[_cedrick_] Это не мои действия и поступки, меня же принудили, я лишь исполняю данный мне приказ, я заложник обстоятельств - это ведь звучало в твоей голове?"
msgstr "[_cedrick_] Estas no son mis acciones y acciones, fui forzado, solo obedezco la orden que soy, soy un rehén de las circunstancias, ¿sonaba en tu cabeza?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:221 #-#-# translate crowdin gallery_d_094_887fc7fd:
msgid "[_irma_] Д-да... Боже, все так и было... А потом все как во сне..."
msgstr "[_irma_] D-Da… Dios, fue tan… Y entonces es como un sueño…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:225 #-#-# translate crowdin gallery_d_094_51d56c49:
msgid "[_cedrick_] Тарани, не держи зла на свою подругу. Она лишь выполняла приказ. Приказ, данный Фобосом. Ни к чему выплескивать ненависть за это на Тарани"
msgstr "[_cedrick_] Taranee, no hagas daño a tu novia. Sólo seguía órdenes. La orden dada por Fobos. No hay necesidad de echar el odio por esto en Taranee"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:231 #-#-# translate crowdin gallery_d_094_b6be3c67:
msgid "[_tarani_] Я... Кхм... Я и не собиралась ненавидеть ее... Э-это наше личное дело. Если мы захотим в этом разобраться, то сделаем это сами между собой"
msgstr "[_tarani_] Yo… Km… No iba a odiarla… Es nuestro negocio personal. Si queremos entender esto, lo haremos entre nosotros"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:235 #-#-# translate crowdin gallery_d_094_3a4645ce:
msgid "[_tarani_] У-уж точно без твоего участия. Не лезь в это, Седрик"
msgstr "[_tarani_] Wu definitivamente está sin tu participación. No te metas en eso, Cedric"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:239 #-#-# translate crowdin gallery_d_094_795678bb_1:
msgid "[_irma_] ..."
msgstr "[_irma_] …"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:240 #-#-# translate crowdin gallery_d_094_3dca7ade:
msgid "[_cedrick_] Как скажешь, Тарани"
msgstr "[_cedrick_] Lo que dices, Taranee"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:244 #-#-# translate crowdin gallery_d_094_0be49d12:
msgid "[_irma_] И все же... Я чувствую себя такой виноватой... С-словно я никогда не смогу простить саму себя..."
msgstr "[_irma_] Y aun así… Me siento tan culpable… C-como si nunca pudiera perdonarme…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:248 #-#-# translate crowdin gallery_d_094_b9b996b7:
msgid "[_cedrick_] Мне это знакомо, Ирма"
msgstr "[_cedrick_] Lo sé, Irma"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:254 #-#-# translate crowdin gallery_d_094_75eed00d:
msgid "[_irma_] Т-так вот... вот что ты испытывал..."
msgstr "[_irma_] A-así que esto… esto es lo que sentías…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:255 #-#-# translate crowdin gallery_d_094_de4bb4e6:
msgid "[_irma_] Е-если ты испытываешь то же самое, тогда почему... П-почему все еще служишь на стороне Фобоса!?"
msgstr "[_irma_] S-si sientes lo mismo, entonces ¿por qué… por qué sigues sirviendo a Fobos?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:259 #-#-# translate crowdin gallery_d_094_49316299_1:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] …"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:261 #-#-# translate crowdin gallery_d_094_138198db:
msgid "[_cedrick_] Простите, но нам не получится продолжать тихо беседовать на эту тему"
msgstr "[_cedrick_] Perdóneme, pero no podremos seguir hablando en voz baja sobre este tema"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:263 #-#-# translate crowdin gallery_d_094_0261a390:
msgid "[_cedrick_] Тарани проиграла, а значит должна быть наказана. Если мы не будем следовать очевидному сценарию, тогда стражники что-то заподозрят"
msgstr "[_cedrick_] Taranee perdió, por lo que debe ser castigado. Si no seguimos el escenario obvio, entonces los guardias sospecharán algo"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:267 #-#-# translate crowdin gallery_d_094_79d7ea3e:
msgid "[_cedrick_] Не забывайте, мы здесь не одни"
msgstr "[_cedrick_] No olvides que aquí no estamos solos"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:268 #-#-# translate crowdin gallery_d_094_98f84176_2:
msgid "[_tarani_] ..."
msgstr "[_tarani_] …"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:269 #-#-# translate crowdin gallery_d_094_be2ac9d4:
msgid "[_cedrick_] Прости, Тарани, но мне придется..."
msgstr "[_cedrick_] Lo siento, Taranee, pero tendré que…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:273 #-#-# translate crowdin gallery_d_094_e360c100:
msgid "[_tarani_] Пф... Просто делай, что должен..."
msgstr "[_tarani_] Pff… Limítate a hacer lo que debes…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:277 #-#-# translate crowdin gallery_d_094_48111316:
msgid "[_cedrick_] Тебе тоже, Ирма. Идемте"
msgstr "[_cedrick_] Tú también, Irma. Vamos."

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:279 #-#-# translate crowdin gallery_d_094_194abc91:
msgid "[_centered_] {size=37}Седрик заключает Тарани в кандалы{/size}"
msgstr "[_centered_] {size=37}Cedric encierra a Taranee en grilletes{/size}"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:286 #-#-# translate crowdin gallery_d_094_6f81bd29:
msgid "[_irma_] Т-тарани, я вхожу..."
msgstr "[_irma_] T-t-Taranee, estoy entrando…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:288 #-#-# translate crowdin gallery_d_094_f5d99b68:
msgid "[_tarani_] (Ааааххх... Ч-черт, я все еще слишком чувствительна для такого...)"
msgstr "[_tarani_] (Aaah ch-h-h-h-h-h-h-h-, todavía soy demasiado sensible para eso…)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:290 #-#-# translate crowdin gallery_d_094_34cd9b04:
msgid "[_cedrick_] Тарани, я постараюсь сделать это аккуратно, но все же тебе придется взять его в рот. Знаю, ты всячески избегаешь орального контакта, но..."
msgstr "[_cedrick_] Taranee, intentaré hacerlo con cuidado, pero tendrás que meterlo en la boca. Sé que estás evitando el contacto oral, pero…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:292 #-#-# translate crowdin gallery_d_094_35073506:
msgid "[_tarani_] Просто сделай это уже... Ни к чему медлить. Как говорится, горькую пилюлю лучше не рассасывать, а сразу проглотить. Действуй... Я не буду кусаться..."
msgstr "[_tarani_] Hazlo de una vez… No tiene sentido retrasarlo. Como dicen, una píldora amarga es mejor tragarla de golpe que saborearla. Vamos… No morderé…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:294 #-#-# translate crowdin gallery_d_094_0715d77b:
msgid "[_cedrick_] (Хооо? Видимо мой подход дает нужные плоды. Хоть и немного, но даже Тарани стала мягче. Раньше она никогда бы не позволила мне трахнуть ее в рот)"
msgstr "[_cedrick_] (¿Mmm? Parece que mi método está dando frutos. Aunque sea un poco, hasta Taranee se ha vuelto más dócil. Antes jamás me habría permitido cogerla por la boca.)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:296 #-#-# translate crowdin gallery_d_094_f08b559a:
msgid "[_tarani_] Н-но учти, я делаю это только потому, что иначе нас с Ирмой заподозрят воины Фобоса"
msgstr "[_tarani_] P-pero ten en cuenta que solo hago esto porque, de lo contrario, los guerreros de Fobos sospecharían de Irma y de mí."

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:298 #-#-# translate crowdin gallery_d_094_5e78c07b:
msgid "[_cedrick_] Само собой..."
msgstr "[_cedrick_] Por supuesto…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:300 #-#-# translate crowdin gallery_d_094_838d17bf:
msgid "[_tarani_] И не вздумай кончать мне в рот, понял?"
msgstr "[_tarani_] Y ni se te ocurra correrte en mi boca, ¿entendido?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:302 #-#-# translate crowdin gallery_d_094_618d7002:
msgid "[_cedrick_] Как скажешь"
msgstr "[_cedrick_] Lo que dices"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:303 #-#-# translate crowdin gallery_d_094_98f84176_3:
msgid "[_tarani_] ..."
msgstr "[_tarani_] …"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:308 #-#-# translate crowdin gallery_d_094_e767f89e:
msgid "[_tarani_] Мммхххх..."
msgstr "[_tarani_] Mmm…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:309 #-#-# translate crowdin gallery_d_094_42e5e49c:
msgid "[_irma_] Аааххх... Ммммм..."
msgstr "[_irma_] Aahhh… Mmm…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:310 #-#-# translate crowdin gallery_d_094_c1f0cde3:
msgid "[_tarani_] (Черт, видимо Ирма инстинктивно ускоряет ритм... Такими темпами я сново...)"
msgstr "[_tarani_] (Maldita sea, aparentemente Irma acelera instintivamente el ritmo de… A este paso, lo estoy de nuevo…)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:311 #-#-# translate crowdin gallery_d_094_c8ea81b2:
msgid "[_cedrick_] Ирма, чуть сбавь темп. Думаю Тарани все еще слишком чувствительная для такого"
msgstr "[_cedrick_] Irma, más despacio un poco. Creo que Taranee sigue siendo demasiado sensible para tal"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:312 #-#-# translate crowdin gallery_d_094_dce7b24e:
msgid "[_irma_] Х-хорошо... Аааххх..."
msgstr "[_irma_] E-está bien… Aahhh…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:313 #-#-# translate crowdin gallery_d_094_466b198e:
msgid "[_tarani_] (Д-да что с ним такое? Он что, серьезно? Пока его не было, Ирма рассказала мне об из разговоре)"
msgstr "[_tarani_] (D-¿Qué es? ¿Es él serio? Antes de que se fuera, Irma me habló de la conversación)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:314 #-#-# translate crowdin gallery_d_094_53cbac70:
msgid "[_tarani_] (Ей показалось, что Седрик сожалеет о том, что заточил нас, но для меня это звучало как бред)"
msgstr "[_tarani_] (Le pareció que Cedric lamentaba habernos encarcelado, pero para mí sonaba como una tontería)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:315 #-#-# translate crowdin gallery_d_094_d167ef86:
msgid "[_tarani_] (Но сейчас... Глядя на него... Это не звучит так уж бредово)"
msgstr "[_tarani_] (Pero ahora… Mirándolo… No suena tan loco)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:316 #-#-# translate crowdin gallery_d_094_1a177b45:
msgid "[_tarani_] Ммммввв.. Мммххх.."
msgstr "[_tarani_] Mmmmff… Mmmmh…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:317 #-#-# translate crowdin gallery_d_094_36fa4ed4:
msgid "[_tarani_] (Проклятье, даже со средним ритмом от Ирмы, я не продержусь долго...)"
msgstr "[_tarani_] (Maldito, incluso con un ritmo medio de Irma, no duraré mucho…)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:318 #-#-# translate crowdin gallery_d_094_05330fd6:
msgid "[_tarani_] (И все же...)"
msgstr "[_tarani_] (Y aún así…)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:319 #-#-# translate crowdin gallery_d_094_4157105c:
msgid "[_tarani_] Ф-федрик... Зафем тебе это?"
msgstr "[_tarani_] C-Cedric… ¿P-para qué necesitas esto?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:320 #-#-# translate crowdin gallery_d_094_b2bd1e80:
msgid "[_cedrick_] О чем ты, Тарани?"
msgstr "[_cedrick_] ¿De qué estás hablando, Taranee?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:321 #-#-# translate crowdin gallery_d_094_564f7b7a:
msgid "[_tarani_] Ты пофедил, так пофему? Пофему ты беспокоифся о нас?"
msgstr "[_tarani_] Eres un feto, ¿un poema? ¿Te molestas por nosotros?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:322 #-#-# translate crowdin gallery_d_094_955ee7d1:
msgid "[_cedrick_] Честно говоря... Я знаю, что мои попытки мало чем вам помогут. Приказ Фобоса так или иначе висит на вас тяжелым грузом"
msgstr "[_cedrick_] Sinceramente… Sé que mis intentos no les ayudarán mucho. La orden de Fobos pesa sobre ustedes como una carga insoportable."

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:323 #-#-# translate crowdin gallery_d_094_43e7c9d3:
msgid "[_cedrick_] Ровно также, как и на мне... Я не уверен, но, может это просто мое чувство солидарности... Я прекрасно знаю, что вас ждет, потому что прошел через то же самое"
msgstr "[_cedrick_] Es tanto como yo… No estoy seguro, pero tal vez es mi sentido de solidaridad… Sé perfectamente lo que te espera, porque pasé por lo mismo"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:324 #-#-# translate crowdin gallery_d_094_57edbf27:
msgid "[_cedrick_] А может это чувство вины, ведь я сам загнал вас в эту ловушку..."
msgstr "[_cedrick_] Y tal vez ese sentimiento de culpa, porque te llevé a esta trampa."

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:325 #-#-# translate crowdin gallery_d_094_629d5804:
msgid "[_tarani_] Фины? О чем тебе фалеть, Седрик? Ты фе с самого начала знал, фто так все и будет..."
msgstr "[_tarani_] ¿Multas? ¿De qué te parece tu sucia, Cedric? Desde el principio sabías que la foto iba a ser tan…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:326 #-#-# translate crowdin gallery_d_094_bcf8a37c:
msgid "[_cedrick_] Да, верно, но... Хм... Как будто в процессе выполнения этого очередного бессмысленного приказа, что-то во мне изменилось..."
msgstr "[_cedrick_] Sí, es cierto, pero… Mmm… Es como si algo hubiera cambiado dentro de mí al cumplir otra de estas órdenes sin sentido…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:327 #-#-# translate crowdin gallery_d_094_edae4530:
msgid "[_cedrick_] Словно пребывание на земле сделало меня более сентиментальным, хах... Хотя, да, звучит бредово..."
msgstr "[_cedrick_] Es como si estar en la tierra me hiciera más sentimental, jaja… Aunque, sí, parece una locura…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:328 #-#-# translate crowdin gallery_d_094_23af184a:
msgid "[_cedrick_] Честно, я не могу однозначно ответить, почему помогаю вам... Это просто то, чего я хочу сейчас... Как бы бредово это не звучало..."
msgstr "[_cedrick_] Honestamente, no puedo responder inequívocamente por qué te estoy ayudando… Es justo lo que quiero ahora… Sea cual sea el desastre."

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:329 #-#-# translate crowdin gallery_d_094_72a79972:
msgid "[_tarani_] ....."
msgstr "[_tarani_] …"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:330 #-#-# translate crowdin gallery_d_094_5555dffb:
msgid "[_tarani_] (Да, это бредово... Чертовски бредово... И от того, это выглядит так... Так человечно...)"
msgstr "[_tarani_] (Sí, es una locura… Malditas tonterías… Y por eso, se ve así… Es tan humano…)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:331 #-#-# translate crowdin gallery_d_094_0ed2074a:
msgid "[_tarani_] (Не уж то мы и сами не заметили, как в Седрике что-то изменилось? Может... Может это наш шанс на спасение...)"
msgstr "[_tarani_] (¿No vimos nada en Cedric? Tal vez… Tal vez es nuestra oportunidad de salvar…)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:332 #-#-# translate crowdin gallery_d_094_0dfa051d:
msgid "[_tarani_] Ф-федрик... Пофлушай..."
msgstr "[_tarani_] C-Cedric… E-escucha…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:333 #-#-# translate crowdin gallery_d_094_c5ab66cb:
msgid "[_cedrick_] (Вот оно. Она заглотила наживку)"
msgstr "[_cedrick_] (Aquí está. Se tragó el cebo)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:334 #-#-# translate crowdin gallery_d_094_9415af4c:
msgid "[_tarani_] М-мофет... Мофет нам объединиться..."
msgstr "[_tarani_] M-mophet… Las mofetas nos unen…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:335 #-#-# translate crowdin gallery_d_094_bc775c73:
msgid "[_cedrick_] Что ты имеешь ввиду?"
msgstr "[_cedrick_] ¿Qué quieres decir?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:336 #-#-# translate crowdin gallery_d_094_ca25ab83:
msgid "[_tarani_] Ты и фтражницы? Мы могли бы... Протиф Фобоса..."
msgstr "[_tarani_] ¿Tú y las Guardianas? Podríamos… contra Fobos…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:337 #-#-# translate crowdin gallery_d_094_76c86798:
msgid "[_cedrick_] П-подожди... Не здесь... Ирма, давай закончим это сейчас и после отойдем в темницу, чтобы поговорить всем наедине"
msgstr "[_cedrick_] E-espera… Aquí no… Irma, terminemos con esto y luego vayamos a la mazmorra para hablar todos en privado."

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:338 #-#-# translate crowdin gallery_d_094_dc7be0b6:
msgid "[_irma_] Х-хорошо... Тарани, прости, н-но я ускорюсь"
msgstr "[_irma_] E-está bien… Taranee, lo siento, voy a acelerar"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:339 #-#-# translate crowdin gallery_d_094_19924d1b:
msgid "[_tarani_] Ммммхххх... Ааааххх..."
msgstr "[_tarani_] Mmmmhhh… Aaaah…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:340 #-#-# translate crowdin gallery_d_094_c84f494a:
msgid "[_cedrick_] (В-вот черт, из-за ускорения Ирмы, Тарани начала сильнее сжимать мой член своим ртом)"
msgstr "[_cedrick_] (Oh, debido a la aceleración de irma, Taranee comenzó a apretar mi verga con la boca más dura)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:341 #-#-# translate crowdin gallery_d_094_02166bcd:
msgid "[_cedrick_] (А из-за усиленных толчков, Тарани непроизвольно двигает ртом в мою сторону)"
msgstr "[_cedrick_] (Y, con las embestidas más fuertes, Taranee mueve involuntariamente la boca hacia mí.)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:342 #-#-# translate crowdin gallery_d_094_0620539f:
msgid "[_cedrick_] Т-тарани, я кончаю..."
msgstr "[_cedrick_] T-t-Taranee, he terminado…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:343 #-#-# translate crowdin gallery_d_094_20acbbf9:
msgid "[_tarani_] Ммммфммм!!!"
msgstr "[_tarani_] Mmmfmmmm!!"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:344 #-#-# translate crowdin gallery_d_094_d0b89529:
msgid "[_cedrick_] Я-я помню..."
msgstr "[_cedrick_] Y-yo recuerda…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:350 #-#-# translate crowdin gallery_d_094_732ca01a:
msgid "[_tarani_] Ааааххххх..."
msgstr "[_tarani_] Aaaaah…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:351 #-#-# translate crowdin gallery_d_094_d5f3d768:
msgid "[_tarani_] (Я... Я кончила, пока Ирма трахаал меня сзади, а Седрик кончал на лицо... Что за сюрреалистичная картина...)"
msgstr "[_tarani_] (Yo… me corrí mientras Irma me cogía por detrás y Cedric se corría sobre mi cara… Qué escena tan surrealista…)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:352 #-#-# translate crowdin gallery_d_094_6323c424:
msgid "[_cedrick_] Уххх... Думаю, нам нужно отойти"
msgstr "[_cedrick_] Uh… Creo que tenemos que alejarnos"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:353 #-#-# translate crowdin gallery_d_094_56f546d4:
msgid "[_irma_] Д-да..."
msgstr "[_irma_] D-Da…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:357 #-#-# translate crowdin gallery_d_094_b8889c6d:
msgid "[_centered_] {size=37}Седрик, Ирма и Тарани отходят в темницу неподалеку{/size}"
msgstr "[_centered_] {size=37}CEDRIC, IRMA Y TARANEE SE RETIRAN A UNA MAZMORRA CERCANA{/size}"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:367 #-#-# translate crowdin gallery_d_094_d0c2dca2:
msgid "[_cedrick_] Тарани, ты не шутишь? Предлагая мне подобное... Ты... Ты же никогда не сможешь простить меня за..."
msgstr "[_cedrick_] Taranee, ¿estás bromeando? Ofreciéndome así… Tú eres… Nunca puedes perdonarme por…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:371 #-#-# translate crowdin gallery_d_094_c477d43a:
msgid "[_tarani_] Да, не смогу. То, что произошло с Найджелом... Да и не только... Я никогда не прощу тебя за это..."
msgstr "[_tarani_] Sí, no puedo. ¿Qué le pasó a Nigel… Y no solo… Nunca te perdonaré por eso…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:373 #-#-# translate crowdin gallery_d_094_ccaf1b56:
msgid "[_tarani_] Но... Но сейчас это не важно... То, что я поняла сегодня, так это то, что ты не безнадежен. В тебе все же есть что-то человеческое и ты готов сотрудничать..."
msgstr "[_tarani_] Pero… ahora eso no importa. Hoy comprendí que no eres un caso perdido. Aún queda algo humano en ti y estás dispuesto a cooperar…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:377 #-#-# translate crowdin gallery_d_094_5675a812:
msgid "[_tarani_] А значит, настоящее зло - это Фобос. Присоединись к нам, Седрик"
msgstr "[_tarani_] ¿Qué significa que el verdadero mal es Fobos? Únete a nosotros, Cedric"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:383 #-#-# translate crowdin gallery_d_094_39e5227f:
msgid "[_irma_] Т-тарани, ты серьезно?"
msgstr "[_irma_] T-Taranee, ¿hablas en serio?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:389 #-#-# translate crowdin gallery_d_094_2749335a:
msgid "[_tarani_] Мы не обещаем тебе прощение и искупление грехов. Но как минимум ты избавишься от гнета Фобоса"
msgstr "[_tarani_] No te prometemos perdón y expiación por los pecados. Pero al menos te desharás del yugo de Fobos"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:390 #-#-# translate crowdin gallery_d_094_9279a4ab:
msgid "[_tarani_] Тебе же самому отвратно исполнять его приказы... Я... Я ведь права?"
msgstr "[_tarani_] A ti mismo te repugna cumplir sus órdenes… Yo… Tengo razón, ¿verdad?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:391 #-#-# translate crowdin gallery_d_094_1ef8b66b:
msgid "[_cedrick_] (Вот он, ключевой момент моего спектакля с этими двумя...)"
msgstr "[_cedrick_] (Aquí está, el momento clave de mi actuación con estos dos…)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:397 #-#-# translate crowdin gallery_d_094_49316299_2:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] …"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:398 #-#-# translate crowdin gallery_d_094_87b7ed4a:
msgid "[_cedrick_] ......"
msgstr "[_cedrick_] …"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:399 #-#-# translate crowdin gallery_d_094_dbfe1405:
msgid "[_cedrick_] Да, Тарани, ты права... Я бы встал на вашу сторону, даже если бы после свержения Фобоса мне светило тюремное заключение, но..."
msgstr "[_cedrick_] Sí, Taranee, tienes razón… Me pararía de tu lado, incluso si después del derrocamiento de Fobos estuviera en prisión, pero…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:403 #-#-# translate crowdin gallery_d_094_cb7ed462:
msgid "[_tarani_] ...Но?"
msgstr "[_tarani_] … ¿Pero?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:407 #-#-# translate crowdin gallery_d_094_71b04421:
msgid "[_cedrick_] Как вы собираетесь одолеть Фобоса? Нет, даже не так... Как вы собираетесь сбежать отсюда?"
msgstr "[_cedrick_] ¿Cómo vas a derrotar a Fobos? No, ni siquiera así… ¿Cómo vas a salir de aquí?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:413 #-#-# translate crowdin gallery_d_094_0723be43:
msgid "[_tarani_] Я... Эм... Если мы объединимся..."
msgstr "[_tarani_] Yo… Um… Si nos unimos…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:414 #-#-# translate crowdin gallery_d_094_a1c6f5b5:
msgid "[_cedrick_] Вы не сможете отбиться от всего войска Фобоса, даже с моей помощью"
msgstr "[_cedrick_] No podrás luchar contra todas las tropas de Fobos, incluso con mi ayuda"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:420 #-#-# translate crowdin gallery_d_094_98f84176_4:
msgid "[_tarani_] ..."
msgstr "[_tarani_] …"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:424 #-#-# translate crowdin gallery_d_094_c0cffd98:
msgid "[_irma_] Н-но что же тогда нам делать"
msgstr "[_irma_] Pero, ¿qué hacemos entonces"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:428 #-#-# translate crowdin gallery_d_094_49316299_3:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] …"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:434 #-#-# translate crowdin gallery_d_094_f94f7617:
msgid "[_cedrick_] Есть одна идея. Временное решение, но оно может сработать"
msgstr "[_cedrick_] Tiene una idea. Decisión temporal, pero puede funcionar"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:438 #-#-# translate crowdin gallery_d_094_d5ec88d3:
msgid "[_tarani_] И что же это?"
msgstr "[_tarani_] ¿Y qué es?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:442 #-#-# translate crowdin gallery_d_094_f6a6b063:
msgid "[_cedrick_] Могриффы. Оборотни с Меридиана, способные принять любой облик, в том числе и ваш. Какое-то время с их помощью мы сможем водить за нос Фобоса"
msgstr "[_cedrick_] Mogriffs. Cambiaformas de Meridian capaces de adoptar cualquier aspecto, incluso el de ustedes. Durante un tiempo podremos usarlos para engañar a Fobos"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:446 #-#-# translate crowdin gallery_d_094_8f5d4238:
msgid "[_irma_] П-правда!? У нас есть шанс..."
msgstr "[_irma_] ¿D-de verdad? Tenemos una oportunidad…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:452 #-#-# translate crowdin gallery_d_094_e2998fdb:
msgid "[_tarani_] Но их маскировка не вечна, верно?"
msgstr "[_tarani_] Pero su disfraz no es eterno, ¿verdad?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:458 #-#-# translate crowdin gallery_d_094_76a378c9:
msgid "[_cedrick_] Все верно..."
msgstr "[_cedrick_] Es correcto…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:464 #-#-# translate crowdin gallery_d_094_83b9170d:
msgid "[_tarani_] И как только она спадет, ты попадешь под удар, так?"
msgstr "[_tarani_] Y tan pronto como desaparezca, vas a golpear, ¿verdad?"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:470 #-#-# translate crowdin gallery_d_094_5e3336f7:
msgid "[_cedrick_] Да..."
msgstr "[_cedrick_] Sí…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:474 #-#-# translate crowdin gallery_d_094_795678bb_2:
msgid "[_irma_] ..."
msgstr "[_irma_] …"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:478 #-#-# translate crowdin gallery_d_094_1a168f5c:
msgid "[_tarani_] Значит, мы должны подготовиться до этого времени. Когда маскировка могриффов спадет, мы должны быть готовы свергнуть Фобоса"
msgstr "[_tarani_] Así que tenemos que prepararnos hasta entonces. Cuando los disfraces libres de segado disminuyen, debemos estar listos para derrocar a Fobos"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:482 #-#-# translate crowdin gallery_d_094_80311587:
msgid "[_cedrick_] (Хах, а мне нравится ее настрой. Но, к сожалению, все не совсем так, как она себе представляет)"
msgstr "[_cedrick_] (Ja, y me gusta su estado de ánimo. Pero, desafortunadamente, todo no es exactamente lo que imagina)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:483 #-#-# translate crowdin gallery_d_094_ad41a3ca:
msgid "[_cedrick_] Скажу честно, этого времени не хватит, чтобы подготовить вас должным образом. Я говорю это как человек, сражавшийся с вами и знакомый с Фобосом ни одну сотню лет"
msgstr "[_cedrick_] Para ser sincero, ese tiempo no bastará para prepararlas como es debido. Se los digo como alguien que luchó contra ustedes y conoce a Fobos desde hace varios siglos."

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:487 #-#-# translate crowdin gallery_d_094_942325d9:
msgid "[_tarani_] Черт..."
msgstr "[_tarani_] Maldición…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:493 #-#-# translate crowdin gallery_d_094_7c8d0929:
msgid "[_cedrick_] Но это не значит, что прямо сейчас у вас не будет возможности сбежать"
msgstr "[_cedrick_] Pero eso no significa que no puedas escapar ahora mismo"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:497 #-#-# translate crowdin gallery_d_094_8c235efd:
msgid "[_irma_] Н-но Седрик... Если тебя раскроют, а мы все еще будет не готовы к битве, тогда..."
msgstr "[_irma_] N-no Cedric… Si te están abriendo, y todavía no estamos listos para luchar, entonces…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:500 #-#-# translate crowdin gallery_d_094_e9c5a106:
msgid "[_cedrick_] Тогда меня казнят, все верно. Думаю, это соразмерная кара за все то, что я совершил. Лично я готов к этому. Главное сейчас - это чтобы стражницы завесы спаслись"
msgstr "[_cedrick_] Entonces me ejecutarán, así es. Creo que sería un castigo proporcional a todo lo que he hecho. Estoy dispuesto. Lo importante ahora es que las Guardianas del Velo se salven."

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:504 #-#-# translate crowdin gallery_d_094_fc7ad22f:
msgid "[_tarani_] (Он... Он и вправду изменился... Раньше я думала, что это какая-то уловка, но услышав эти слова сейчас... Не похоже, чтобы он врал...)"
msgstr "[_tarani_] (Él… Él realmente cambió… Solía pensar que era una especie de truco, pero cuando escuché esas palabras ahora… No parece que haya mentido…)"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:508 #-#-# translate crowdin gallery_d_094_6dfba506:
msgid "[_irma_] Седрик, ты..."
msgstr "[_irma_] Cedric, tú…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:512 #-#-# translate crowdin gallery_d_094_45c4e922:
msgid "[_cedrick_] Я помогу вам. Попробую договориться с другими стражницами о совместном побеге. Вам нужно будет подождать здесь. Но как только все будут готовы, мы сбежим"
msgstr "[_cedrick_] Las ayudaré. Intentaré acordar una fuga conjunta con las demás Guardianas. Tendrán que esperar aquí. En cuanto todas estén listas, escaparemos."

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:516 #-#-# translate crowdin gallery_d_094_474739a9:
msgid "[_cedrick_] Миранда и Булдж помогут нам. Какой бы злодейкой Миранда вам не казалась, на деле же она разделяет мои чувства"
msgstr "[_cedrick_] Miranda y Bulj nos ayudarán. Por muy malvada que les parezca Miranda, en realidad comparte mis sentimientos."

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:520 #-#-# translate crowdin gallery_d_094_adaddc43:
msgid "[_tarani_] Хорошо, Седрик. Мы примем твою помощь. Пока что. Мы будем ждать"
msgstr "[_tarani_] Bien, Cedric. Aceptaremos tu ayuda. Por ahora. Estaremos esperando."

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:524 #-#-# translate crowdin gallery_d_094_618288b4:
msgid "[_cedrick_] Я ценю ваше доверие. Как только мы все устроим, Миранда придет за вами. А пока, я пойду и все подготовлю"
msgstr "[_cedrick_] Agradezco su confianza. Una vez que lo hagamos todo, Miranda vendrá por ti. Mientras tanto, iré a prepararlo todo"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:528 #-#-# translate crowdin gallery_d_094_04c3232e:
msgid "[_tarani_] Тогда удачи. Надеюсь тебе удастся уговорить остальных девочек"
msgstr "[_tarani_] Entonces buena suerte. Espero que puedas convencer a las otras chicas"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:534 #-#-# translate crowdin gallery_d_094_ece543c6:
msgid "[_irma_] У-удачи, Седрик..."
msgstr "[_irma_] B-Buena suerte, Cedric…"

# game/scripts/quests/questTrainingOfGuards/check_irma_and_tarani_in_barracks.rpy:539 #-#-# translate crowdin gallery_d_094_2da8c997:
msgid "[_cedrick_] (Что ж, трое из пяти уже есть. Остались Корнелия и Хай Лин. За ними мне нужно будет отправиться в бордель)"
msgstr "[_cedrick_] (Bien, ya tengo a tres de cinco. Quedan Cornelia y Hay Lin. Tendré que ir a buscarlas al burdel.)"

