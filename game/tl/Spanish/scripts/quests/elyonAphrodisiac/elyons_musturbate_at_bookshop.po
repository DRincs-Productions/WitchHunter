# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/elyonAphrodisiac/elyons_musturbate_at_bookshop.rpy:4 #-#-# translate crowdin gallery_d_049_cf58a5d1:
msgid "[_cedrick_] (Что это за шум? Он исходит из комнаты Элион? Надо бы проверить..)"
msgstr "[_cedrick_] (¿Qué es ese ruido? ¿Viene de la habitación de Elyon? Deberíamos comprobarlo.)"

# game/scripts/quests/elyonAphrodisiac/elyons_musturbate_at_bookshop.rpy:8 #-#-# translate crowdin gallery_d_049_24c88512:
msgid "[_elion_] Д-да, вот так..."
msgstr "[_elion_] S-sí, así…"

# game/scripts/quests/elyonAphrodisiac/elyons_musturbate_at_bookshop.rpy:9 #-#-# translate crowdin gallery_d_049_b0cab4de:
msgid "[_cedrick_] (Ого, она уже делает это сама, даже без афродизиака.. Видимо она занималась этим и раньше)"
msgstr "[_cedrick_] (Vaya, ya lo hace sola, incluso sin afrodisíaco… Está claro que lo había hecho antes.)"

# game/scripts/quests/elyonAphrodisiac/elyons_musturbate_at_bookshop.rpy:10 #-#-# translate crowdin gallery_d_049_633a6557:
msgid "[_elion_] Мммм... Хорошо..."
msgstr "[_elion_] Mmmm… Que bien… "

# game/scripts/quests/elyonAphrodisiac/elyons_musturbate_at_bookshop.rpy:11 #-#-# translate crowdin gallery_d_049_0667ccdb:
msgid "[_cedrick_] (Думаю, стоит посмотреть еще немного..)"
msgstr "[_cedrick_] (Creo que vale la pena verlo un poco más.)"

# game/scripts/quests/elyonAphrodisiac/elyons_musturbate_at_bookshop.rpy:12 #-#-# translate crowdin gallery_d_049_5c37c5f9:
msgid "[_elion_] Д-да, Рик.. Позаботься обо мне.. Удовлетворяй мою похотливую натуру.. Чтобы ее больше никто не увидел...."
msgstr "[_elion_] S-sí, Rick… Cuídame… Satisface mi naturaleza lujuriosa… Para que nadie más la vea."

# game/scripts/quests/elyonAphrodisiac/elyons_musturbate_at_bookshop.rpy:13 #-#-# translate crowdin gallery_d_049_9d8a22cc:
msgid "[_cedrick_] (Что!? Черт возьми, видимо афродизиак в тот раз лишь открыл то, что в ней и так всегда сидело. Не уж то ей так снесло крышу после того, как она все потеряла?)"
msgstr "[_cedrick_] (¿¡Qué!? Maldita sea, aparentemente el afrodisíaco de esa vez solo reveló algo que siempre había estado dentro de ella. ¿Estaba realmente tan loca después de perderlo todo?)"

# game/scripts/quests/elyonAphrodisiac/elyons_musturbate_at_bookshop.rpy:14 #-#-# translate crowdin gallery_d_049_b5a1f0f9:
msgid "[_cedrick_] (Хотя, с другой стороны, весь род Фобоса – это те еще развратники.. Кто еще в здравом уме попросит трахнуть собственную сестру)"
msgstr "[_cedrick_] (Aunque, por otro lado, todo el clan de Fobos sigue siendo unos libertinos… ¿Quién más en su sano juicio pediría coger con su propia hermana?)"

# game/scripts/quests/elyonAphrodisiac/elyons_musturbate_at_bookshop.rpy:15 #-#-# translate crowdin gallery_d_049_2b312f29:
msgid "[_cedrick_] (Что ж, думаю эти ее слова можно воспринять, как согласие на то, чтобы я начал развращать ее дальше)"
msgstr "[_cedrick_] (Bueno, creo que estas palabras suyas pueden tomarse como un consentimiento para que yo comience a corromperla aún más.)"

# game/scripts/quests/elyonAphrodisiac/elyons_musturbate_at_bookshop.rpy:16 #-#-# translate crowdin gallery_d_049_8fb5a6cf:
msgid "[_cedrick_] (Главное не переборщить, ведь в остальном она все та же скромная и зажатая Элион)"
msgstr "[_cedrick_] (Lo principal es no exagerar, porque de lo contrario sigue siendo la misma Elyon modesta y tensa.)"

# game/scripts/quests/elyonAphrodisiac/elyons_musturbate_at_bookshop.rpy:17 #-#-# translate crowdin gallery_d_049_5ca3fc9c:
msgid "[_elion_] Мммм, да, Рик, вот так..."
msgstr "[_elion_] Mmmm, sí, Rick, eso es…"

# game/scripts/quests/elyonAphrodisiac/elyons_musturbate_at_bookshop.rpy:18 #-#-# translate crowdin gallery_d_049_6262f6c4:
msgid "[_cedrick_] (Ну.. по большей части..)"
msgstr "[_cedrick_] (Bueno… en su mayor parte.)"

