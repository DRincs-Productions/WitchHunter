# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:5 #-#-# translate crowdin toss_aphrodisiac_to_elyon_in_school_93f5b332:
msgid "[_cedrick_] (осталось добавить афродизиак в кофе)"
msgstr "[_cedrick_] (Queda por añadir el afrodisíaco al café)"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:10 #-#-# translate crowdin toss_aphrodisiac_to_elyon_in_school_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:15 #-#-# translate crowdin gallery_d_046_c30392ba:
msgid "[_cedrick_] Элион, не хочешь перед уроком взбодриться? Я купил нам кофе"
msgstr "[_cedrick_] Elyon, ¿quieres animarte antes de clase? He comprado café"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:18 #-#-# translate crowdin gallery_d_046_dea49141:
msgid "[_elion_] Ох, спасибо, Рик, это так мило.."
msgstr "[_elion_] Oh, gracias, Rick, eso es tan dulce…"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:19 #-#-# translate crowdin gallery_d_046_967702e4:
msgid "[_cedrick_] (Отлично, теперь нужно просто подождать, пока препарат сработает. Хм, лучше мне не присутствовать в классе, когда эффект афродизиака проявит себя)"
msgstr "[_cedrick_] (Genial, ahora solamente tengo que esperar a que la droga haga efecto. Hmm, será mejor que no esté en clase cuando los efectos afrodisíacos hagan efecto)"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:21 #-#-# translate crowdin gallery_d_046_4ab00fb5:
msgid "[_cedrick_] (Без учителя в этот момент, у учеников и Элион не будет сдерживающего фактора)"
msgstr "[_cedrick_] (Sin un profesor en ese momento, los estudiantes y Elyon no tendrán impedimentos)"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:24 #-#-# translate crowdin gallery_d_046_d3204e6c:
msgid "[_centered_] {size=37}Позже, после урока{/size}"
msgstr "[_centered_] {size=37}Más tarde, después de clase{/size}"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:28 #-#-# translate crowdin gallery_d_046_6b14704b:
msgid "[_cedrick_] И так, класс, первый урок закончен. Я ненадолго отлучусь, а после мы еще раз повторим основы Права Византийской империи 4 века нашей эры"
msgstr "[_cedrick_] Muy bien, clase, terminó la primera lección. Saldré un momento y después repasaremos los fundamentos del derecho del Imperio bizantino del siglo IV d. C."

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:31 #-#-# translate crowdin gallery_d_046_05782f4a:
msgid "[_irma_] Скуууукаааа"
msgstr "[_irma_] Abuuuurriiiidoooo"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:32 #-#-# translate crowdin gallery_d_046_6dff9d29:
msgid "[_haylin_] Ну хоть в этот раз без контрольной.."
msgstr "[_haylin_] Al menos esta vez no hubo una prueba…"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:35 #-#-# translate crowdin gallery_d_046_576697a3:
msgid "[_centered_] {size=37}На перемене{/size}"
msgstr "[_centered_] {size=37}En el receso{/size}"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:40 #-#-# translate crowdin gallery_d_046_15f4035e:
msgid "[_elion_] (Д-да что со мной такое.. Я весь урок не могла сосредоточиться, в голову все время лезли странные мысли..)"
msgstr "[_elion_] (S-sí, qué me pasa… No pude concentrarme en toda la lección, no paraba de tener pensamientos raros en la cabeza…)"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:41 #-#-# translate crowdin gallery_d_046_c45508d0:
msgid "[_elion_] (Я не могу нормально соображать.. Тут так жарко.. И-или это я такая горячая..)"
msgstr "[_elion_] (No puedo pensar con claridad… Hace tanto calor aquí… O tal vez soy yo quien tiene tanto calor…)"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:42 #-#-# translate crowdin gallery_d_046_53559d45:
msgid "[_elion_] (Мммф.. Все мое тело так и зудит.. Почему я стала такой чувствительной? Кажется я намокла, просто ерзая на стуле во время урока...)"
msgstr "[_elion_] (Mmmph. Me pica todo el cuerpo… ¿Por qué me he vuelto tan sensible? Creo que me he mojado solo de moverme en la silla durante la clase…)"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:43 #-#-# translate crowdin gallery_d_046_5e62cb3c:
msgid "[_elion_] (Черт, как же хочется сбросить это напряжение.. Так хочется ощутить чье-то прикосновение, чью-то ласку..)"
msgstr "[_elion_] (Maldita sea, quiero deshacerme de esta tensión… Quiero sentir el tacto de alguien, la caricia de alguien…)"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:44 #-#-# translate crowdin gallery_d_046_f50a71e2:
msgid "[_elion_] (И когда я вообще стала такой развратной... Н-но, с этим определенно нужно что-то делать, иначе я просто взорвусь, даже встать со стула уже сложно..)"
msgstr "[_elion_] (¿Y cuándo me volví tan depravada en primer lugar… P-pero definitivamente tengo que hacer algo al respecto, de lo contrario voy a explotar, es difícil incluso levantarse de la silla…)"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:45 #-#-# translate crowdin gallery_d_046_db05da89:
msgid "[_elion_] (Вроде бы в классе мало народа, все либо спят, либо сидят в телефонах.. Никто ведь не заметит, если я просто.. я..)"
msgstr "[_elion_] (No parece haber mucha gente en clase, todos están dormidos o con sus teléfonos… Nadie se daría cuenta si yo… yo…)"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:49 #-#-# translate crowdin gallery_d_046_e287e954:
msgid "[_elion_] (П-потрогаю себя, там..)"
msgstr "[_elion_] (Me toco, allí…)"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:50 #-#-# translate crowdin gallery_d_046_863474cd:
msgid "[_elion_] (Ммм, да, как же хорошо...)"
msgstr "[_elion_] (Mmm, sí, que bueno…)"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:54 #-#-# translate crowdin gallery_d_046_ae7772dc:
msgid "[_elion_] (Д-да... Так намного лучше.. Как же долго я этого ждала..)"
msgstr "[_elion_] (S-sí… Eso está mucho mejor… He esperado mucho tiempo por esto…)"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:55 #-#-# translate crowdin gallery_d_046_9e991cca:
msgid "[_elion_] (Я уже так давно не прикасалась к себе, видимо поэтому мое тело так истосковалось по ласке..)"
msgstr "[_elion_] (Hace tanto tiempo que no me toco, que probablemente por eso mi cuerpo está tan hambriento de afecto…)"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:58 #-#-# translate crowdin gallery_d_046_5becf2c7:
msgid "[_elion_] (Ммм, да, вот так, хорошо.. хорошооооо.. я уже почти..)"
msgstr "[_elion_] (Mmm, sí, eso es, eso es bueno… biiieeen… Ya casi estoy…)"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:62 #-#-# translate crowdin gallery_d_046_4ca78f9d:
msgid "[_girl_] Эй, Элион, что ты делаешь под столо... Твою мать!"
msgstr "[_girl_] Oye, Elyon, ¿qué haces debajo de la mesa?… ¡Mierda!"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:65 #-#-# translate crowdin gallery_d_046_053bf008:
msgid "[_guy_] Воу-воу-воу, Элион, но не в классе же.."
msgstr "[_guy_] Whoa-whoa-whoa-whoa, Elyon, No en clase…"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:66 #-#-# translate crowdin gallery_d_046_d3f40c6e:
msgid "[_guy2_] Охренеть, не знал, что она такая развратная..."
msgstr "[_guy2_] Mierda, no sabía que era tan zorra…"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:67 #-#-# translate crowdin gallery_d_046_fceba688:
msgid "[_elion_] Н-нет, ребят, вы неправильно поняли.. Я просто.."
msgstr "[_elion_] N-no, ustedes tienen una idea equivocada. Yo solo…"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:68 #-#-# translate crowdin gallery_d_046_5664e32e:
msgid "[_girl2_] Ахахах, да все мы правильно поняли! Ты дрочишь прямо в классе"
msgstr "[_girl2_] Jajaja, ¡tenemos razón! Te estás masturbando en clase"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:69 #-#-# translate crowdin gallery_d_046_f6bee3c3:
msgid "[_girl_] Это все потому что у нее парня нет!"
msgstr "[_girl_] ¡Todo es porque no tiene novio!"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:70 #-#-# translate crowdin gallery_d_046_40156632:
msgid "[_elion_] Я-я не.."
msgstr "[_elion_] Y-yo no…"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:71 #-#-# translate crowdin gallery_d_046_5bc1f49e:
msgid "[_guy_] Эй, Элион, если тебе так невтерпеж, можем вечером пойти ко мне!"
msgstr "[_guy_] Oye, Elyon, si estás tan urgida, ¡podemos ir a mi casa esta noche!"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:73 #-#-# translate crowdin gallery_d_046_4a7238b2:
msgid "[_centered_] {size=37}Элион выбегает из класса{/size}"
msgstr "[_centered_] {size=37}Elyon sale corriendo de la clase{/size}"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:77 #-#-# translate crowdin gallery_d_046_f56b30c0:
msgid "[_cedrick_] Так, что за хрень тут происходит? Почему Элион убежала из класса?"
msgstr "[_cedrick_] Entonces, ¿qué carajo está pasando aquí? ¿Por qué Elyon se escapó de clase?"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:78 #-#-# translate crowdin gallery_d_046_4507c1ab:
msgid "[_girl2_] Эм, ну..."
msgstr "[_girl2_] Um, bueno…"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:79 #-#-# translate crowdin gallery_d_046_c39dd294:
msgid "[_guy_] Ей просто нездоровится, учитель Рик.."
msgstr "[_guy_] No se siente bien, maestro Rick…"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:80 #-#-# translate crowdin gallery_d_046_34e02628:
msgid "[_cedrick_] (Видимо афродизиак сработал как надо, отлично)"
msgstr "[_cedrick_] (Aparentemente el afrodisíaco funcionó bien, genial)"

# game/scripts/quests/elyonAphrodisiac/toss_aphrodisiac_to_elyon_in_school.rpy:84 #-#-# translate crowdin gallery_d_046_52227770:
msgid "[_centered_] {size=37}По школе начали разноситься слухи о том, что Элион мастурбировала прямо во время перемены{/size}"
msgstr "[_centered_] {size=37}Comenzaron a correr rumores por la escuela de que Elyon se masturbaba durante el receso{/size}"

