# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:1321 #-#-# translate crowdin q_dfk_cornelia_dialogs_continue_d996c70f:
msgid "[_cedrick_] (Единственная моя зацепка — это то, что они как-то связаны с тем комиссаром, к которому я приходил в обличие отца Ирмы)"
