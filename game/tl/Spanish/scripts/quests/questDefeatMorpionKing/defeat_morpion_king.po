# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:1318 #-#-# translate crowdin q_dfk_cornelia_dialogs_continue_bf164ccc:
msgid "[_cedrick_] (Так, первым делом нужно разобраться с детективами. Ирма и Тарани, несмотря на всю свою силу, всего лишь две школьницы. С ними я справлюсь, а вот с розыском сложнее..)"
