# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:1319 #-#-# translate crowdin q_dfk_cornelia_dialogs_continue_aed41212:
msgid "[_cedrick_] (Там было два детектива. Медина и Мактиннен. Нужно провернуть с Мединой тот же фокус, что с Корнелией, но..)"
