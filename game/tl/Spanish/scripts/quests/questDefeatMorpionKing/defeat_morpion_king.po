# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:1320 #-#-# translate crowdin q_dfk_cornelia_dialogs_continue_24c6ccaa:
msgid "[_cedrick_] (Я ничего не знаю о Медине.. С Корнелией было проще, я знал ее характер, а в случае Медины я даже не знаю, где она живет..)"
