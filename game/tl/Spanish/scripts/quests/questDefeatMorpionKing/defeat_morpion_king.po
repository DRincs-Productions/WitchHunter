# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:6 #-#-# translate crowdin begin_fight_with_morpion_king_eee6c4b2:
msgid "[_cedrick_] Черт, ну и урод же ты.. Похож на одного хана из учебников истории"
msgstr "[_cedrick_] Maldita sea, eres tan feo. Pareces uno de esos Khans de los libros de historia."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:10 #-#-# translate crowdin begin_fight_with_morpion_king_b2763bb1:
msgid "[_king_of_morpions_] Ррррр.."
msgstr "[_king_of_morpions_] Rrrrr..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:11 #-#-# translate crowdin begin_fight_with_morpion_king_816f20dd:
msgid "[_cedrick_] Но я и невооруженным взглядом вижу, ты силен.."
msgstr "Pero puedo ver a simple vista que eres fuerte."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:15 #-#-# translate crowdin begin_fight_with_morpion_king_c7cd77e6:
msgid "[_king_of_morpions_] Ты.. Это был ты.."
msgstr "[_king_of_morpions_] Tú... Eras tú..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:19 #-#-# translate crowdin begin_fight_with_morpion_king_b02130c5:
msgid "[_cedrick_] (Он еще и разговаривает.. Впрочем, его королева тоже могла говорить..)"
msgstr "[_cedrick_] (Él también habla... Sin embargo, su reina también podía hablar...)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:23 #-#-# translate crowdin begin_fight_with_morpion_king_f5e0ef9e:
msgid "[_king_of_morpions_] Этот запах.. Ее запах.. Это ты.."
msgstr "[_king_of_morpions_] Ese olor... Su olor... Eres tú..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:27 #-#-# translate crowdin begin_fight_with_morpion_king_fe737e6f:
msgid "[_cedrick_] (Вот черт, видимо он учуял остатки эссенции..)"
msgstr "[_cedrick_] (Oh, mierda, debe haber olido algo de esencia restante...)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:31 #-#-# translate crowdin begin_fight_with_morpion_king_eea422ab:
msgid "[_king_of_morpions_] Это ты.. отнял ее у меня!"
msgstr "[_king_of_morpions_] ¡Fuiste tú... quien me la arrebató!"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:32 #-#-# translate crowdin begin_fight_with_morpion_king_fbbbddab:
msgid "[_cedrick_] Хах, а ты соображаешь. Неплохо для чудища вроде тебя"
msgstr "[_cedrick_] Ja, eres inteligente. Nada mal para un monstruo como tú."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:33 #-#-# translate crowdin begin_fight_with_morpion_king_010b4900:
msgid "[_cedrick_] Ладно, так или иначе, ты напал бы на меня даже не будь я убийцей твоей королевы, верно?"
msgstr "[_cedrick_] Bueno, de todos modos, me habrías atacado incluso si no fuera el asesino de tu reina, ¿verdad?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:34 #-#-# translate crowdin begin_fight_with_morpion_king_88c09d34:
msgid "[_king_of_morpions_] Ты заплатишь.."
msgstr "[_king_of_morpions_] Pagarás por eso."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:73 #-#-# translate crowdin defeat_morpion_king_6086c765:
msgid "[_cedrick_] (Черт, меня аж из формы змея вышибло.. Откуда в нем столько сил?.. Или.. Или это я ослабел?)"
msgstr "[_cedrick_] (Maldita sea, me sacó de mi forma de serpiente... ¿De dónde saca tanta fuerza?... O... ¿O soy yo el que se debilitó?)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:74 #-#-# translate crowdin defeat_morpion_king_65740cd8:
msgid "[_cedrick_] (Так и знал, я на пределе.. Битва со стражницами отняла у меня слишком много сил..)"
msgstr "[_cedrick_] (Lo sabía, estaba en mi límite. La batalla con las guardianas me quitó demasiada fuerza.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:78 #-#-# translate crowdin defeat_morpion_king_bb21f3a6:
msgid "[_king_of_morpions_] Слабый.. Слабый.."
msgstr "[_king_of_morpions_] Débil... Muy débil..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:82 #-#-# translate crowdin defeat_morpion_king_c6649851:
msgid "[_cedrick_] (Вот урод, еще и издевается.. Но должен отдать должное, регенеративные способности у него куда мощнее моих.. Даже с зельями я ему уступаю..)"
msgstr "[_cedrick_] (Qué idiota, incluso se burla de mí... Pero tengo que darle crédito, sus habilidades regenerativas son mucho más poderosas que las mías... Incluso con pociones, soy inferior a él.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:83 #-#-# translate crowdin defeat_morpion_king_53bb7643:
msgid "[_cedrick_] (Уффф, ладно, Седрик, соберись.. Нужно получить хоть какое-то преимущество.. Заговорю ему зубы или выведу из себя, чтобы его атаки стали предсказуемыми.. )"
msgstr "[_cedrick_] (Uffff, vale, Cedric, cálmate... Necesitamos conseguir al menos algo de ventaja... Le hablaré hasta por los codos o lo haré enfadar para que sus ataques se vuelvan predecibles.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:84 #-#-# translate crowdin defeat_morpion_king_6e4bd214:
msgid "[_cedrick_] Хей, здоровяк, знаешь.. А твоя королева отлично отсасывала мне своим ртом. Могу понять, почему ты такой злой.."
msgstr "[_cedrick_] Oye, grandullón, ¿sabes? Y tu reina me hizo una mamada buenísima con la boca. Entiendo por qué estás tan enojado."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:85 #-#-# translate crowdin defeat_morpion_king_250a5250:
msgid "[_king_of_morpions_] ..."
msgstr "[_king_of_morpions_] ..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:86 #-#-# translate crowdin defeat_morpion_king_866d5894:
msgid "[_cedrick_] Тебе ведь от нее минет явно не перепал, хаха.."
msgstr "[_cedrick_] Claramente no recibiste una mamada de ella, jaja."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:90 #-#-# translate crowdin defeat_morpion_king_250a5250_1:
msgid "[_king_of_morpions_] ..."
msgstr "[_king_of_morpions_] ..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:91 #-#-# translate crowdin defeat_morpion_king_c2609125:
msgid "[_king_of_morpions_] ....."
msgstr "[_king_of_morpions_] ....."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:92 #-#-# translate crowdin defeat_morpion_king_de5156bc:
msgid "[_cedrick_] (Так, он явно готовится напас..)"
msgstr "[_cedrick_] (Entonces, claramente se está preparando para atacar.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:95 #-#-# translate crowdin defeat_morpion_king_9d0579d5:
msgid "[_cedrick_] (Ч-что...)"
msgstr "[_cedrick_] (¿Q-qué...?)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:100 #-#-# translate crowdin defeat_morpion_king_89c61dfd:
msgid "[_cedrick_] (Я..)"
msgstr "[_cedrick_] (Oh...)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:101 #-#-# translate crowdin defeat_morpion_king_feb5394c:
msgid "[_cedrick_] (Я даже..)"
msgstr "[_cedrick_] (Incluso si yo...)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:102 #-#-# translate crowdin defeat_morpion_king_3b1a9f81:
msgid "[_cedrick_] (Не смог отследить его атаку..)"
msgstr "[_cedrick_] (No pude anticipar su ataque.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:105 #-#-# translate crowdin defeat_morpion_king_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:106 #-#-# translate crowdin defeat_morpion_king_07bdde05:
msgid "....."
msgstr "....."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:107 #-#-# translate crowdin defeat_morpion_king_b39c6fcb:
msgid "[_cedrick_] Да.. Провоцировать его было явно не лучшей моей идеей.."
msgstr "[_cedrick_] Sí... Provocarlo definitivamente no fue mi mejor idea."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:113 #-#-# translate crowdin defeat_morpion_king_2d5b897a:
msgid "[_cedrick_] Смотрю.. Шуток ты совсем не понимаешь.."
msgstr "[_cedrick_] Ya veo... No entiendes los chistes en absoluto."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:118 #-#-# translate crowdin defeat_morpion_king_df78b66c:
msgid "[_cedrick_] (Я уже говорю с ним на автомате..)"
msgstr "[_cedrick_] (Ya estoy hablando con él automáticamente.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:123 #-#-# translate crowdin defeat_morpion_king_3344452e:
msgid "[_cedrick_] (Голова идет кругом, мысли плывут..)"
msgstr "[_cedrick_] (Mi cabeza da vueltas, mis pensamientos se inundan.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:128 #-#-# translate crowdin defeat_morpion_king_9db0b091:
msgid "[_cedrick_] (Что вообще.. Происходит..)"
msgstr "[_cedrick_] (¿Qué diablos está pasando?)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:134 #-#-# translate crowdin defeat_morpion_king_f6204058:
msgid "[_king_of_morpions_] Слабый.."
msgstr "[_king_of_morpions_] Débil."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:140 #-#-# translate crowdin defeat_morpion_king_f6bb4d79:
msgid "[_cedrick_] (И в глазах темнеет.. Но при этом становится легче..)"
msgstr "[_cedrick_] (Y se oscurece ante mis ojos. Pero al mismo tiempo se vuelve más fácil.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:146 #-#-# translate crowdin defeat_morpion_king_4dcd4f0a:
msgid "[_cedrick_] (А.. Я кажется понял..)"
msgstr "[_cedrick_] (Ah... creo que lo entiendo.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:151 #-#-# translate crowdin defeat_morpion_king_2ef90216:
msgid "[_cedrick_] (...)"
msgstr "[_cedrick_] (...)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:156 #-#-# translate crowdin defeat_morpion_king_d6a16f40:
msgid "[_cedrick_] (Я умираю...)"
msgstr "[_cedrick_] (Me estoy muriendo.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:161 #-#-# translate crowdin defeat_morpion_king_cfc7b887:
msgid "[_cedrick_] (Этот ублюдок задел мозг..)"
msgstr "[_cedrick_] (El cerebro de ese bastardo.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:166 #-#-# translate crowdin defeat_morpion_king_1b3407dd:
msgid "[_cedrick_] (Вот черт.. Я что, вот так просто умру?)"
msgstr "[_cedrick_] (Oh mierda. ¿Voy a morir así como así?)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:171 #-#-# translate crowdin defeat_morpion_king_a686c877:
msgid "[_cedrick_] (Сражаясь с непонятным лесным чудищем..)"
msgstr "[_cedrick_] (Luchando contra un extraño monstruo del bosque.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:176 #-#-# translate crowdin defeat_morpion_king_60d8b595:
msgid "[_cedrick_] (Что я вообще.. Сделал не так?)"
msgstr "[_cedrick_] (¿Qué hice mal de todas formas?)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:177 #-#-# translate crowdin defeat_morpion_king_3f22f923:
msgid "[_cedrick_] (Я же всегда считал, что преждевременная смерть — это результат собственных глупых ошибок. И вот я здесь..)"
msgstr "[_cedrick_] (Siempre creí que la muerte prematura es resultado de los propios errores estúpidos. Y aquí estoy.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:178 #-#-# translate crowdin defeat_morpion_king_8dede367:
msgid "[_cedrick_] (Все из-за того, что я проиграл стражницам? Нужно было быть жестче? Или же хитроумнее?)"
msgstr "[_cedrick_] (¿Fue porque perdí contra los guardias? ¿Debería haber sido más duro? ¿O más astuto?)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:179 #-#-# translate crowdin defeat_morpion_king_7533b595:
msgid "[_cedrick_] (Да, определенно.. Но ошибки были и раньше.. Я мог бы справиться с двумя ведьмами, если бы остался при своих силах..)"
msgstr "[_cedrick_] (Sí, definitivamente... Pero hubo errores antes... Podría haber manejado a dos brujas si hubiera conservado mis poderes.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:180 #-#-# translate crowdin defeat_morpion_king_4e3933a2:
msgid "[_cedrick_] (Получается, все началось с той ошибки, когда я потерял отряд воинов? Не оступись я тогда, Фобос бы меня не наказал..)"
msgstr "[_cedrick_] (¿Entonces todo empezó con ese error cuando perdí un escuadrón de guerreros? Si no hubiera tropezado entonces, Fobos no me habría castigado.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:181 #-#-# translate crowdin defeat_morpion_king_79f23387:
msgid "[_cedrick_] (А что привело к этой ошибке?..)"
msgstr "[_cedrick_] (¿Y qué provocó este error?)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:182 #-#-# translate crowdin defeat_morpion_king_0a7b3817:
msgid "[_cedrick_] (Ошибки, ошибки.. Я умираю, а в моей голове вместо памятных приятных воспоминаний сплошные ошибки..)"
msgstr "[_cedrick_] (Errores, errores... Me estoy muriendo, y en mi cabeza, en lugar de recuerdos agradables, solo hay errores.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:183 #-#-# translate crowdin defeat_morpion_king_ccf41eba:
msgid "[_cedrick_] (Что было первопричиной? Как я вообще стал таким..)"
msgstr "[_cedrick_] (¿Cuál fue la raíz de la causa? ¿Cómo llegué a estar así?)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:184 #-#-# translate crowdin defeat_morpion_king_f6204058_1:
msgid "[_king_of_morpions_] Слабый.."
msgstr "[_king_of_morpions_] Débil."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:185 #-#-# translate crowdin defeat_morpion_king_2ef90216_1:
msgid "[_cedrick_] (...)"
msgstr "[_cedrick_] (...)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:186 #-#-# translate crowdin defeat_morpion_king_b1ade90d:
msgid "[_cedrick_] (Король Морпионов прав.. Это результат моей слабости.. Но всегда ли я был таким?..)"
msgstr "[_cedrick_] (El Rey Morpion tiene razón... Este es el resultado de mi debilidad... ¿Pero siempre he sido así?)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:187 #-#-# translate crowdin defeat_morpion_king_2ef90216_2:
msgid "[_cedrick_] (...)"
msgstr "[_cedrick_] (...)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:188 #-#-# translate crowdin defeat_morpion_king_ff78f636:
msgid "[_cedrick_] (...Нет.)"
msgstr "[_cedrick_] (...No.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:189 #-#-# translate crowdin defeat_morpion_king_018968cd:
msgid "[_cedrick_] (Я же чертов Лорд. Я был рожден править. Но в итоге все, что я делал, это лишь прислуживал..)"
msgstr "[_cedrick_] (Soy un maldito Señor. Nací para gobernar. Pero al final, todo lo que hice fue servir.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:196 #-#-# translate crowdin defeat_morpion_king_7eb565d1:
msgid "[_cedrick_] (Прислуживал так долго, что уже и забыл об иной жизни..)"
msgstr "[_cedrick_] (Serví tanto tiempo que incluso me olvidé de otra vida.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:201 #-#-# translate crowdin defeat_morpion_king_a2c43818:
msgid "[_soldiers_] Лорд Седрик!"
msgstr "[_soldiers_] ¡Señor Cedric!"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:206 #-#-# translate crowdin defeat_morpion_king_f5f140e0:
msgid "[_cedrick_] (Прислуживал так долго, что чтобы смириться со своим положением, начал утопать в алкоголе и разврате..)"
msgstr "[_cedrick_] (Serví durante tanto tiempo que, para aceptar su posición, comencé a ahogarme en el alcohol y el libertinaje.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:211 #-#-# translate crowdin defeat_morpion_king_a2c43818_1:
msgid "[_soldiers_] Лорд Седрик!"
msgstr "[_soldiers_] ¡Señor Cedric!"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:216 #-#-# translate crowdin defeat_morpion_king_b3e0a97e:
msgid "[_cedrick_] (Все это время.. Я подавлял это жгучее чувство несправедливости и заглушил его настолько, что забыл, кто я есть)"
msgstr "[_cedrick_] (Todo este tiempo... reprimí ese ardiente sentimiento de injusticia y lo apagué tanto que olvidé quién era)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:221 #-#-# translate crowdin defeat_morpion_king_6b30f716:
msgid "[_soldiers_] Главнокомандующий!"
msgstr "[_soldiers_] ¡Comandante en jefe!"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:226 #-#-# translate crowdin defeat_morpion_king_e5b023a2:
msgid "[_cedrick_] (Все мои ошибки были результатом моего безразличия. Я заставил себя стать безразличным, пустить все на самотек..)"
msgstr "[_cedrick_] (Todos mis errores fueron resultado de mi indiferencia. Me obligué a volverme indiferente, a dejar que todo pasara.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:231 #-#-# translate crowdin defeat_morpion_king_bb121ba4:
msgid "[_cedrick_] (Все для того, чтобы забыться.. И я настолько преуспел в этом самообмане, что стал прощать себе даже критические ошибки..)"
msgstr "[_cedrick_] (Todo con el fin de olvidar... Y he llegado a tener tanto éxito en este autoengaño que he empezado a perdonarme incluso errores críticos...)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:236 #-#-# translate crowdin defeat_morpion_king_fe1d7bb4:
msgid "[_cedrick_] (Закрывал глаза даже на банальные просчеты.. Как же я сейчас жалок..)"
msgstr "[_cedrick_] (Hice la vista gorda incluso ante errores triviales. Qué patético soy ahora.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:241 #-#-# translate crowdin defeat_morpion_king_326679f2:
msgid "[_soldiers_] Главнокомандующий Седрик!"
msgstr "[_soldiers_] ¡Comandante Cedric!"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:246 #-#-# translate crowdin defeat_morpion_king_f3aaf97c:
msgid "[_cedrick_] Я Лорд, черт возьми! Я здесь, чтобы править, а не подчиняться! Но все это время я только выполнял то, что мне велели. И где я оказался!?"
msgstr "[_cedrick_] ¡Soy un Señor, maldita sea! ¡Estoy aquí para gobernar, no para que me gobernaran! Pero todo este tiempo, solo he hecho lo que me decían. ¿Y dónde he acabado?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:251 #-#-# translate crowdin defeat_morpion_king_12573e08:
msgid "[_soldiers_] Лорд Седрик, что с вами!? Эта ужасная рана, да как вы только на ногах стоите!?"
msgstr "[_soldiers_] Lord Cedric, ¿qué le pasa? ¡Con esta terrible herida, cómo puede siquiera mantenerse en pie!"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:252 #-#-# translate crowdin defeat_morpion_king_8493902c:
msgid "[_soldiers_] Лорд Седрик, бегите, мы задержим это чудовище!?"
msgstr "[_soldiers_] ¡Lord Cedric, corra, detendremos a este monstruo!"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:257 #-#-# translate crowdin defeat_morpion_king_dbd9627e:
msgid "[_cedrick_] А ну все в сторону.. Это приказ главнокомандующего.. Хватит с меня смертей подчиненных.."
msgstr "[_cedrick_] Ahora, a un lado. Es una orden del comandante en jefe. Ya estoy harto de que mueran mis subordinados."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:258 #-#-# translate crowdin defeat_morpion_king_6f668225:
msgid "[_cedrick_] (Ваша смерть будет лишь очередной моей ошибкой.. А ошибок я себе больше не позволю)"
msgstr "[_cedrick_] (Tu muerte será solo otro error mío... Y no me permitiré cometer más errores)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:259 #-#-# translate crowdin defeat_morpion_king_0ecf91c2:
msgid "[_soldiers_] Г-главнокомандующий.."
msgstr "[_soldiers_] Co-Comandante."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:260 #-#-# translate crowdin defeat_morpion_king_7d6b09b7:
msgid "[_cedrick_] Всем солдатам отступить, вы должны перегруппироваться у ворот замка. Это приказ.."
msgstr "[_cedrick_] Retírense todos los soldados. Reagrupense en las puertas del castillo. Es una orden."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:261 #-#-# translate crowdin defeat_morpion_king_3a062751:
msgid "[_soldiers_] Е-есть.."
msgstr "[_soldiers_] S-sí..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:265 #-#-# translate crowdin defeat_morpion_king_2c5ad0ba:
msgid "[_cedrick_] Эй, здоровяк.. Давай покончим с этим.."
msgstr "[_cedrick_] Oye, grandullón... Terminemos con esto de una vez."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:266 #-#-# translate crowdin defeat_morpion_king_250a5250_2:
msgid "[_king_of_morpions_] ..."
msgstr "[_king_of_morpions_] ..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:267 #-#-# translate crowdin defeat_morpion_king_f4487c2b:
msgid "[_cedrick_] (Все, что я могу сейчас - это вложить все силы в один последний удар, на большее меня не хватит..)"
msgstr "[_cedrick_] (Lo único que puedo hacer ahora es poner todas mis fuerzas en un último golpe, no puedo hacer más.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:268 #-#-# translate crowdin defeat_morpion_king_83bad0d2:
msgid "[_cedrick_] (Судя по характеру его восстановления, самое уязвимое его место - это грудь. Это свечение под кожей, с этого места он всегда начинает восстанавливаться, значит там источник его сил..)"
msgstr "[_cedrick_] (A juzgar por la naturaleza de su recuperación, su punto más vulnerable es su pecho. Ese brillo debajo de la piel, siempre comienza a recuperarse desde allí, lo que significa que de ahí provienen sus poderes.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:269 #-#-# translate crowdin defeat_morpion_king_18dad461:
msgid "[_cedrick_] (Тогда решено..)"
msgstr "[_cedrick_] (Entonces está decidido.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:270 #-#-# translate crowdin defeat_morpion_king_dbe1a4cb:
msgid "[_cedrick_] Знаешь, хах.. Мне тут недавно понравился прием одного вильтрумита.. Сейчас покажу.."
msgstr "[_cedrick_] ¿Sabes? jaja. Hace poco me gustó una técnica de un Viltrumite. Te la muestro ahora."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:272 #-#-# translate crowdin defeat_morpion_king_a20cefa7_1:
msgid "..."
msgstr "..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:278 #-#-# translate crowdin defeat_morpion_king_010c3c18:
msgid "[_king_of_morpions_] Не.."
msgstr "[_king_of_morpions_] Ja..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:279 #-#-# translate crowdin defeat_morpion_king_18d30d3a:
msgid "[_king_of_morpions_] Невозмож.."
msgstr "[_king_of_morpions_] Imposible..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:280 #-#-# translate crowdin defeat_morpion_king_0d720778:
msgid "[_king_of_morpions_] Но.."
msgstr "[_king_of_morpions_] Pero..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:281 #-#-# translate crowdin defeat_morpion_king_250a5250_3:
msgid "[_king_of_morpions_] ..."
msgstr "[_king_of_morpions_] ..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:282 #-#-# translate crowdin defeat_morpion_king_e27331bc:
msgid "[_king_of_morpions_] Прости.."
msgstr "[_king_of_morpions_] Comó..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:283 #-#-# translate crowdin defeat_morpion_king_0b2b8bd8:
msgid "[_king_of_morpions_] Моя королева.."
msgstr "[_king_of_morpions_] Mi reina..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:287 #-#-# translate crowdin defeat_morpion_king_bdec9d39:
msgid "[_cedrick_] (Все, это мой предел.. Даже веки становятся слишком тяжелыми, глаза сами закрываются..)"
msgstr "[_cedrick_] (Eso es, este es mi límite. Incluso mis párpados se están volviendo demasiado pesados, mis ojos se están cerrando solos.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:292 #-#-# translate crowdin defeat_morpion_king_45b4a10d:
msgid "[_cedrick_] (Если таков мой конец, то хотя бы в последний момент своей жизни я сделал все, что мог..)"
msgstr "[_cedrick_] (Si este es mi final, entonces al menos en el último momento de mi vida hice todo lo que pude.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:297 #-#-# translate crowdin defeat_morpion_king_c8d73717:
msgid "[_cedrick_] (Как же горько от того, что корень своих бед я смог осознать лишь сейчас..)"
msgstr "[_cedrick_] (Qué amargo es que recién ahora pude entender la raíz de mis problemas.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:302 #-#-# translate crowdin defeat_morpion_king_4e4c38ee:
msgid "[_cedrick_] (Хах.. Аж плакать хочется..)"
msgstr "[_cedrick_] (Me dan ganas de llorar.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:306 #-#-# translate crowdin defeat_morpion_king_a20cefa7_2:
msgid "..."
msgstr "..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:307 #-#-# translate crowdin defeat_morpion_king_07bdde05_1:
msgid "....."
msgstr "....."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:308 #-#-# translate crowdin defeat_morpion_king_3928a113:
msgid "......."
msgstr "......."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:310 #-#-# translate crowdin defeat_morpion_king_7cb08984:
msgid "[_young_phobos_] Седрик.."
msgstr "[_young_phobos_] Cedric"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:311 #-#-# translate crowdin defeat_morpion_king_2dd7dd21:
msgid "[_young_cedrick_] Хах, что такое, старина? Выглядишь опечаленным"
msgstr "[_young_cedrick_] Ja, ¿qué pasa, viejo? Te ves triste."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:312 #-#-# translate crowdin defeat_morpion_king_2b71d235:
msgid "[_young_phobos_] Моя семья сказала, что с сегодняшнего дня мы с тобой больше не можем общаться на равных"
msgstr "[_young_phobos_] Mi familia dijo que a partir de hoy tú y yo ya no podremos comunicarnos como iguales."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:313 #-#-# translate crowdin defeat_morpion_king_281bec18:
msgid "[_young_cedrick_] Ч-что? Но почему.. Мы же оба из знати.."
msgstr "[_young_cedrick_] ¿Q-qué? ¿Pero por qué? Ambos somos de la nobleza."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:314 #-#-# translate crowdin defeat_morpion_king_7d03549a:
msgid "[_young_phobos_] ..."
msgstr "[_young_phobos_] ..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:315 #-#-# translate crowdin defeat_morpion_king_d0aef12e:
msgid "[_young_cedrick_] Мы вместе росли, вместе учились, вместе сражались.. Бок о бок, всегда как равные, разве нет?"
msgstr "[_young_cedrick_] Crecimos juntos, estudiamos juntos, luchamos juntos. Codo con codo, siempre como iguales, ¿verdad?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:316 #-#-# translate crowdin defeat_morpion_king_ab1ff957:
msgid "[_young_phobos_] Родители говорят, что они воспитывали меня подобным образом, чтобы развить во мне дух соперничества"
msgstr "[_young_phobos_] Mis padres dicen que me criaron de esta manera para desarrollar un espíritu competitivo en mí."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:317 #-#-# translate crowdin defeat_morpion_king_a5128ccd:
msgid "[_young_phobos_] Сам знаешь, мой брат никудышный правитель, у него нет амбиций и с ним не получится конкурировать на равных.."
msgstr "[_young_phobos_] Tú mismo lo sabes, mi hermano es un pésimo gobernante, no tiene ambición y será imposible competir con él en igualdad de condiciones."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:318 #-#-# translate crowdin defeat_morpion_king_30b60336:
msgid "[_young_phobos_] Несмотря на то, что он на несколько десятилетий старше, я лучше разбираюсь в геополитике и интригах.. А он только и думает о своих зельях.."
msgstr "[_young_phobos_] Aunque es décadas mayor, entiendo mejor la geopolítica y las intrigas. Y solo piensa en sus pociones."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:319 #-#-# translate crowdin defeat_morpion_king_7b73c457:
msgid "[_young_cedrick_] Но, как же так.. Мы же оба были рождены править, ты и я.."
msgstr "[_young_cedrick_] Pero ¿cómo puede ser esto? Ambos nacimos para gobernar, tú y yo."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:320 #-#-# translate crowdin defeat_morpion_king_969dd8dc:
msgid "[_young_phobos_] Ты Лорд, Седрик, твое дело - управлять людьми и командовать при дворе. Я же князь, мое дело - это править всеми землями"
msgstr "[_young_phobos_] Tú eres un Señor, Cedric, y tu trabajo es gobernar al pueblo y dirigir la corte. Yo soy un príncipe y mi trabajo es gobernar todas las tierras."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:321 #-#-# translate crowdin defeat_morpion_king_01c89b7c:
msgid "[_young_phobos_] Ты был моим братом по оружию, но моя семья говорит, что для будущего князя не должно быть разницей между Лордом и монстром-простолюдином, вроде Миранды"
msgstr "[_young_phobos_] Fuiste mi hermano de armas, pero mi familia dice que para un futuro príncipe no debería haber diferencia entre un Lord y un monstruo plebeyo como Miranda."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:322 #-#-# translate crowdin defeat_morpion_king_4a17e3de:
msgid "[_young_cedrick_] Не смей говорить так о Миранде!"
msgstr "[_young_cedrick_] ¡No te atrevas a hablar así de Miranda!"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:323 #-#-# translate crowdin defeat_morpion_king_e1fd74dc:
msgid "[_young_phobos_] Вот об этом и говорит моя семья. Я не должен позволять тебе огрызаться"
msgstr "[_young_phobos_] De esto habla mi familia. No debería dejar que te enfades."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:324 #-#-# translate crowdin defeat_morpion_king_e2623dbe:
msgid "[_young_phobos_] Мы с тобой так давно были товарищами, что я позабыл о своем статусе Князя.. Больше я себе этого не позволю"
msgstr "[_young_phobos_] Tú y yo hemos sido camaradas durante tanto tiempo que me olvidé de mi condición de Príncipe... No me permitiré hacerlo más."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:325 #-#-# translate crowdin defeat_morpion_king_7d03549a_1:
msgid "[_young_phobos_] ..."
msgstr "[_young_phobos_] ..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:326 #-#-# translate crowdin defeat_morpion_king_d65c1b74:
msgid "[_young_phobos_] Прости, Седрик, но мы уже давно не дети.. И мы оба это понимаем.. Править всем может лишь один.."
msgstr "[_young_phobos_] Lo siento, Cedric, pero ya no somos niños... Y ambos entendemos que... Sólo uno puede gobernarlo todo."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:327 #-#-# translate crowdin defeat_morpion_king_fde0c2f6:
msgid "[_young_cedrick_] ..."
msgstr "[_young_cedrick_] ..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:328 #-#-# translate crowdin defeat_morpion_king_3928a113_1:
msgid "......."
msgstr "......."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:329 #-#-# translate crowdin defeat_morpion_king_3928a113_2:
msgid "......."
msgstr "......."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:330 #-#-# translate crowdin defeat_morpion_king_3928a113_3:
msgid "......."
msgstr "......."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:332 #-#-# translate crowdin defeat_morpion_king_1a9e8e7d:
msgid "[_miranda_] Седрик.."
msgstr "[_miranda_] Cedric"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:333 #-#-# translate crowdin defeat_morpion_king_3928a113_4:
msgid "......."
msgstr "......."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:334 #-#-# translate crowdin defeat_morpion_king_5258e5f8:
msgid "[_miranda_] Седрик!"
msgstr "[_miranda_] Cedric!"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:335 #-#-# translate crowdin defeat_morpion_king_4e2b42cf:
msgid "[_cedrick_] Править всем может лишь один.."
msgstr "[_cedrick_] Sólo uno puede gobernarlo todo."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:360 #-#-# translate crowdin defeat_morpion_king_4423f0fd:
msgid "[_miranda_] Седрик, ты живой!.. Я.. Я так боялась тебя потерять.."
msgstr "[_miranda_] ¡Cedric, estás vivo! Yo... Tenía tanto miedo de perderte."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:361 #-#-# translate crowdin defeat_morpion_king_16f1fec4:
msgid "[_cedrick_] Н-но как? Я же сражался с королем морпионов.. А потом.."
msgstr "[_cedrick_] ¿Pero cómo? Luché contra el Rey Morpion... Y luego..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:365 #-#-# translate crowdin defeat_morpion_king_b9595db3:
msgid "[_miranda_] Тебя принесли стражники, ты был в ужасном состоянии.. Они несли тебя так аккуратно, как только могли"
msgstr "[_miranda_] Los guardias te trajeron, estabas en un estado lamentable. Te llevaron con todo el cuidado posible."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:369 #-#-# translate crowdin defeat_morpion_king_30472b96:
msgid "[_cedrick_] Стражники?"
msgstr "[_cedrick_] ¿Guardias?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:373 #-#-# translate crowdin defeat_morpion_king_23b09fe7:
msgid "[_miranda_] Да. После того, как ты заступился за них в битве с тем чудищем, многие прониклись к тебе еще большим уважением.."
msgstr "[_miranda_] Sí. Después de defenderlos en la batalla contra ese monstruo, mucha gente comenzó a respetarte aún más."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:377 #-#-# translate crowdin defeat_morpion_king_af3459bf:
msgid "[_cedrick_] Хах, нет, я же.. А впрочем неважно.. Как я выжил?"
msgstr "[_cedrick_] Ja, no, yo no... Pero no importa... ¿Cómo sobreviví?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:381 #-#-# translate crowdin defeat_morpion_king_b175882a:
msgid "[_miranda_] Это.. Это долгая история.."
msgstr "[_miranda_] Es... Es una larga historia."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:385 #-#-# translate crowdin defeat_morpion_king_1a389e5e:
msgid "[_cedrick_] Думаю у меня есть время выслушать.. Я пока на ногах то еле стою, так что не сбегу даже от самой скучной лекции"
msgstr "[_cedrick_] Creo que tengo tiempo para escuchar... Apenas puedo mantenerme en pie, así que no huiré ni siquiera de la conferencia más aburrida."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:389 #-#-# translate crowdin defeat_morpion_king_8ac1b68b:
msgid "[_miranda_] Хах, ну.. Ты помнишь свой последний удар по Королю Морпионов?"
msgstr "[_miranda_] Ja, bueno... ¿Recuerdas tu último golpe al Rey Morpion?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:390 #-#-# translate crowdin defeat_morpion_king_fe8e7c44:
msgid "[_cedrick_] Да, я пробил ему грудь, кажется.."
msgstr "[_cedrick_] Sí, creo que le di un puñetazo en el pecho."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:391 #-#-# translate crowdin defeat_morpion_king_27f23579:
msgid "[_miranda_] В той груди был источник всей его силы, особая восстановительная железа с массой свойств.."
msgstr "[_miranda_] En ese cofre estaba la fuente de toda su fuerza, una glándula reparadora especial con multitud de propiedades."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:392 #-#-# translate crowdin defeat_morpion_king_a440f98d:
msgid "[_miranda_] Железа Короля Морпионов — это самое редкое сокровище для любого алхимика.. Его так сложно добыть, что о нем почти нет никакой информации"
msgstr "[_miranda_] El Hierro del Rey Morpión es el tesoro más raro para cualquier alquimista. Es tan difícil de conseguir que casi no hay información disponible sobre él."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:396 #-#-# translate crowdin defeat_morpion_king_2b8b3111:
msgid "[_cedrick_] Так.."
msgstr "[_cedrick_] Entonces..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:400 #-#-# translate crowdin defeat_morpion_king_5f7263cf:
msgid "[_miranda_] Времени было в обрез, счет шел на минуты, а я могла опираться только на имеющиеся у меня знания, коих было не много"
msgstr "[_miranda_] El tiempo se acababa, cada minuto contaba y yo solo podía confiar en los conocimientos que tenía, que no eran muchos."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:404 #-#-# translate crowdin defeat_morpion_king_2d39cb86:
msgid "[_cedrick_] ..Миранда? Что ты сделала?"
msgstr "[_cedrick_] Miranda, ¿qué hiciste?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:406 #-#-# translate crowdin defeat_morpion_king_10242dc1:
msgid "[_miranda_] ..."
msgstr "[_miranda_] ..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:410 #-#-# translate crowdin defeat_morpion_king_cd1d4720:
msgid "[_miranda_] Ты умирал буквально у меня на руках и все, что я могла сделать - это создать зелье из железы Короля Морпионов и надеяться на ее восстанавливающие свойства.."
msgstr "[_miranda_] Literalmente estabas muriendo en mis brazos y todo lo que podía hacer era crear una poción de la glándula del Rey Morpion y esperar sus propiedades restauradoras."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:414 #-#-# translate crowdin defeat_morpion_king_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:418 #-#-# translate crowdin defeat_morpion_king_6c58f743:
msgid "[_miranda_] Но, как видишь, это помогло. Твоя голова восстановилась меньше чем за 5 минут.."
msgstr "[_miranda_]  Pero como puedes ver, te ayudó. Tu cabeza se recuperó en menos de 5 minutos."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:419 #-#-# translate crowdin defeat_morpion_king_5d5853d5:
msgid "[_cedrick_] ...А побочные действия? Вспоминая случай с Алхими, жидкость разумных морпионов, мягко говоря, пагубно влияет на сознание.."
msgstr "[_cedrick_] ¿Y qué hay de los efectos secundarios? Recordando el incidente de la Alquimia, el fluido de los morpiones conscientes, por decirlo suavemente, tiene un efecto perjudicial sobre la consciencia."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:424 #-#-# translate crowdin defeat_morpion_king_1590bb0f:
msgid "[_miranda_] Я помню.. Поэтому я должна задать тебе ряд вопросов, Седрик. Отвечай быстро, но четко"
msgstr "[_miranda_] Lo recuerdo... Así que necesito hacerte algunas preguntas, Cedric. Responde rápido, pero con claridad."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:428 #-#-# translate crowdin defeat_morpion_king_42f512f5:
msgid "[_cedrick_] Это тест на вменяемость?"
msgstr "[_cedrick_] ¿Es esto una prueba de cordura?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:432 #-#-# translate crowdin defeat_morpion_king_4c392040:
msgid "[_miranda_] Типо того"
msgstr "[_miranda_] Algo así."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:437 #-#-# translate crowdin defeat_morpion_king_ac12c9e8:
msgid "[_cedrick_] Ты что серьез.."
msgstr "[_cedrick_] ¿Hablas en serio?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:441 #-#-# translate crowdin defeat_morpion_king_e24ca099:
msgid "[_miranda_] Первое. Что приходит в голову, когда ты слышишь слова желе, кромсать, фиолетовый, кишки?"
msgstr "[_miranda_] Primero, ¿qué te viene a la mente cuando escuchas las palabras gelatina, triturar, morado, tripas?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:445 #-#-# translate crowdin defeat_morpion_king_698f6d22:
msgid "[_cedrick_] Бред.."
msgstr "[_cedrick_] Puntilla."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:449 #-#-# translate crowdin defeat_morpion_king_5a780ca7:
msgid "[_miranda_] Отвечай на вопрос"
msgstr "[_miranda_] Responde la pregunta"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:453 #-#-# translate crowdin defeat_morpion_king_8d33d6b2:
msgid "[_cedrick_] Это был ответ. Похоже на бредятину"
msgstr "[_cedrick_] Esa fue la respuesta. Parece una tontería."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:457 #-#-# translate crowdin defeat_morpion_king_57501df3:
msgid "[_miranda_] Хм.. Хорошо, второе.."
msgstr "[_miranda_] Hmm... Bueno, segundo..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:462 #-#-# translate crowdin defeat_morpion_king_ce627275:
msgid "[_cedrick_] Миранда.."
msgstr "[_cedrick_] Miranda.."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:466 #-#-# translate crowdin defeat_morpion_king_860e025b:
msgid "[_miranda_] Не перебивай.."
msgstr "[_miranda_] No interrumpas."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:470 #-#-# translate crowdin defeat_morpion_king_f6a041a2:
msgid "[_cedrick_] Миранда, я ведь чуть не умер там.."
msgstr "[_cedrick_] Miranda, casi muero allí."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:474 #-#-# translate crowdin defeat_morpion_king_10242dc1_1:
msgid "[_miranda_] ..."
msgstr "[_miranda_] ..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:475 #-#-# translate crowdin defeat_morpion_king_6f9ee366:
msgid "[_cedrick_] И знаешь, в тот самый момент.. Я словно проснулся.. Словно пелена спала с моих глаз, и я наконец увидел, в чем так сильно ошибался.."
msgstr "[_cedrick_] Y sabes, en ese mismo momento... Fue como si me despertara... Fue como si un velo hubiera caído de mis ojos, y finalmente vi lo mucho que me había equivocado."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:479 #-#-# translate crowdin defeat_morpion_king_2c28a78a:
msgid "[_miranda_] О чем ты говоришь?"
msgstr "[_miranda_] ¿De qué estás hablando?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:480 #-#-# translate crowdin defeat_morpion_king_641c7e62:
msgid "[_cedrick_] И еще.. Еще я понял, как на самом деле боюсь тебя потерять.. В тот момент, когда стражницы напали на тебя.."
msgstr "[_cedrick_] Y además. También me di cuenta del miedo que realmente tengo de perderte. En ese momento, cuando los guardias te atacaron..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:484 #-#-# translate crowdin defeat_morpion_king_10242dc1_2:
msgid "[_miranda_] ..."
msgstr "[_miranda_] ..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:485 #-#-# translate crowdin defeat_morpion_king_f702d32e:
msgid "[_cedrick_] За всю жизнь у меня не было никого ближе тебя.. Самый дорогой мне человек, всегда остающийся на моей стороне.."
msgstr "[_cedrick_] En toda mi vida, nunca he tenido a nadie más cerca que tú. La persona más querida para mí, que siempre permanece a mi lado."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:489 #-#-# translate crowdin defeat_morpion_king_e0e08da1:
msgid "[_miranda_] Седрик, я.."
msgstr "[_miranda_] Cedric, yo..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:493 #-#-# translate crowdin defeat_morpion_king_a26d5bf6:
msgid "[_cedrick_] Знаешь, раньше я никогда об этом не думал.. Из всех, кого я знаю, ты ближе всех к той, кого я мог бы любить.."
msgstr "[_cedrick_] Sabes, nunca había pensado en esto antes. De todas las personas que conozco, tú eres la más cercana a la persona a la que podría amar."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:497 #-#-# translate crowdin defeat_morpion_king_74b7dbd1:
msgid "[_miranda_] Седрик, я.. Я тоже тебя люблю.."
msgstr "[_miranda_] Cedric, yo... yo también te amo."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:501 #-#-# translate crowdin defeat_morpion_king_7d6c3d39:
msgid "[_cedrick_] И я вспомнил еще кое что.. Свою главную ошибку.."
msgstr "[_cedrick_] Y recordé algo más. Mi principal error."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:505 #-#-# translate crowdin defeat_morpion_king_18f426af:
msgid "[_miranda_] Какую же?"
msgstr "[_miranda_] ¿Cuál?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:506 #-#-# translate crowdin defeat_morpion_king_ce627275_1:
msgid "[_cedrick_] Миранда.."
msgstr "[_cedrick_] Miranda.."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:508 #-#-# translate crowdin defeat_morpion_king_b5118f00:
msgid "[_cedrick_] Я собираюсь свергнуть Фобоса"
msgstr "[_cedrick_] Voy a derrocar a Fobos"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:509 #-#-# translate crowdin defeat_morpion_king_10242dc1_3:
msgid "[_miranda_] ..."
msgstr "[_miranda_] ..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:510 #-#-# translate crowdin defeat_morpion_king_1db6d8f2:
msgid "[_cedrick_] Ты со мной?"
msgstr "[_cedrick_] ¿Estas conmigo?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:511 #-#-# translate crowdin defeat_morpion_king_6fc7e72c:
msgid "[_miranda_] (Видимо после того, как Король Морпионов снес Седрику часть головы, его мозг, в процессе восстановления, обновил все нейронные связи..)"
msgstr "[_miranda_] (Al parecer, después de que el Rey Morpion le volara parte de la cabeza a Cedric, su cerebro, en proceso de recuperación, renovó todas las conexiones neuronales.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:512 #-#-# translate crowdin defeat_morpion_king_dded7152:
msgid "[_miranda_] (По сути, таким образом он эмоционально мог вновь пережить все то, о чем давно забыл.. Или пытался забыть..)"
msgstr "[_miranda_] (En esencia, de esta manera podría revivir emocionalmente todo aquello que había olvidado hacía tiempo... o había intentado olvidar.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:513 #-#-# translate crowdin defeat_morpion_king_fcb466ff:
msgid "[_cedrick_] Миранда?"
msgstr "[_cedrick_] ¿Miranda?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:514 #-#-# translate crowdin defeat_morpion_king_bbe01a74:
msgid "[_miranda_] Я с тобой, Седрик.. Я всегда буду на твоей стороне.."
msgstr "[_miranda_] Estoy contigo, Cedric. Siempre estaré a tu lado."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:516 #-#-# translate crowdin defeat_morpion_king_16f82d74:
msgid "[_Somka108_] Отношения между Седриком и Мирандой стали любовными по результатам голосования на нашем {a=https://patreon.com/lazytarts}Patreon{/a}. Миранда могла стать рабыней, но большинство проголосовало за любовный путь. Не пропустите наши следующие голосования, если хотите повлиять на дальнейший сюжет"
msgstr "[_Somka108_] La relación entre Cedric y Miranda se volvió amorosa a raíz de la votación sobre nuestro {a=https://patreon.com/lazytarts}Patreon{/a}. Miranda podría haberse convertido en esclava, pero la mayoría votó por el amor. No te pierdas nuestras próximas votaciones si quieres influir en la trama.\n"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:518 #-#-# translate crowdin defeat_morpion_king_6d25f8ca:
msgid "[_miranda_] Но как ты собираешься свергнуть Фобоса?"
msgstr "[_miranda_] Pero ¿cómo planeas derrocar a Fobos?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:519 #-#-# translate crowdin defeat_morpion_king_277780f4:
msgid "[_cedrick_] У меня есть несколько вариантов.. Но для начала надо прощупать почву"
msgstr "[_cedrick_] Tengo varias opciones. Pero primero necesito probar las aguas."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:520 #-#-# translate crowdin defeat_morpion_king_d1533118:
msgid "[_miranda_] Нет, Седрик, для начала мы разберемся с твоим состоянием. Что если у зелья есть побочный эффект?"
msgstr "[_miranda_] No, Cedric, primero tenemos que determinar tu estado. ¿Y si la poción tiene algún efecto secundario?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:521 #-#-# translate crowdin defeat_morpion_king_2da5bad7:
msgid "[_cedrick_] Да, ты права.. Но я не могу терять время. Мне нужно разобраться с проблемами на Земле"
msgstr "[_cedrick_] Sí, tienes razón... Pero no puedo perder el tiempo. Necesito resolver los problemas de la Tierra."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:522 #-#-# translate crowdin defeat_morpion_king_bebe50d0:
msgid "[_cedrick_] Есть какой-то быстрый способ определить, все ли со мной в порядке?"
msgstr "[_cedrick_] ¿Hay una forma rápida de saber si estoy bien?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:523 #-#-# translate crowdin defeat_morpion_king_21b2a3b7:
msgid "[_miranda_] Ну, один точно есть.."
msgstr "[_miranda_] Bueno, definitivamente hay uno."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:524 #-#-# translate crowdin defeat_morpion_king_c2a1efb1:
msgid "[_cedrick_] И какой же?"
msgstr "[_cedrick_] ¿Y de qué tipo?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:525 #-#-# translate crowdin defeat_morpion_king_39991117:
msgid "[_miranda_] Тебе нужно с кем-то переспать.."
msgstr "[_miranda_] Necesitas dormir con alguien."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:526 #-#-# translate crowdin defeat_morpion_king_65e17c9e:
msgid "[_cedrick_] ..Что? Опять?!"
msgstr "[_cedrick_] ¿Qué? ¡¿Otra vez?!"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:527 #-#-# translate crowdin defeat_morpion_king_7ce45291:
msgid "[_miranda_] Все биологические механизмы морпионов так или иначе направлены на спаривание. А значит, если ты что-то приобрел от Короля морпионов, то.."
msgstr "[_miranda_] Todos los mecanismos biológicos de los morpiones están orientados al apareamiento de una forma u otra. Así que, si has adquirido algo del Rey Morpión, entonces..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:528 #-#-# translate crowdin defeat_morpion_king_f3fdde20:
msgid "[_cedrick_] Я узнаю это, только если пересплю с кем-то.. Я понял.. Но я точно не хочу проверять это на тебе.. Вдруг я захочу откусить тебе голову или типо того.."
msgstr "[_cedrick_] Solo lo descubriré si me acuesto con alguien. Lo entiendo. Pero definitivamente no quiero probarlo contigo. ¿Qué pasa si quiero morderte la cabeza o algo así?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:529 #-#-# translate crowdin defeat_morpion_king_abc11eeb:
msgid "[_miranda_] Я понимаю.. Хм, ну, из имеющихся вариантов, сейчас у нас есть только.."
msgstr "[_miranda_] Entiendo... Hmm, bueno, de las opciones disponibles, ahora mismo sólo tenemos."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:530 #-#-# translate crowdin defeat_morpion_king_b03f1cc4:
msgid "[_cedrick_] ..Корнелия"
msgstr "[_cedrick_] ...Cornelia"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:531 #-#-# translate crowdin defeat_morpion_king_5c467c7d:
msgid "[_miranda_] Разберись с ней, а я пока подниму все архивы, чтобы найти еще что-то про Короля и Королеву Морпионов"
msgstr "[_miranda_] Ocúpate de ella y mientras tanto revisaré todos los archivos para encontrar algo más sobre el Rey y la Reina de Morpion."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:532 #-#-# translate crowdin defeat_morpion_king_6075baf3:
msgid "[_cedrick_] Что ж, давно стоило ее проведать"
msgstr "[_cedrick_] Bueno ya era hora de visitarla."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:534 #-#-# translate crowdin defeat_morpion_king_4389ba95:
msgid "[_miranda_] Уже можешь идти?"
msgstr "[_miranda_] ¿Ya puedes caminar?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:536 #-#-# translate crowdin defeat_morpion_king_068b1e5b:
msgid "[_cedrick_] Да, вполне. Я и вправду стал быстрее восстанавливаться"
msgstr "[_cedrick_] Sí, bastante. Realmente empecé a recuperarme más rápido."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:539 #-#-# translate crowdin defeat_morpion_king_8a969932:
msgid "[_centered_] {size=37}В ТЕМНИЦЕ КОРНЕЛИИ {/size}"
msgstr "[_centered_]  {size=37}EN LA PRISIÓN DE CORNELIA {/size}"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:546 #-#-# translate crowdin gallery_d_066_3c3f83da:
msgid "[_cedrick_] Хм, не помню, чтобы я тебя приковывал"
msgstr "[_cedrick_] Hmm, no recuerdo haberte encadenado."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:548 #-#-# translate crowdin gallery_d_066_bb83262f:
msgid "[_cornelia_] Ты! Это все твой дурацкий стражник сделал.."
msgstr "[_cornelia_] ¡Tú! Tu estúpido guardia hizo todo esto."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:549 #-#-# translate crowdin gallery_d_066_16a7c900:
msgid "[_cedrick_] Стражник? Какой из них?"
msgstr "[_cedrick_] ¿Guardia? ¿Cuál?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:551 #-#-# translate crowdin gallery_d_066_1be9c78b:
msgid "[_cornelia_] Ты что, серьезно? Эти уроды все на одно лицо"
msgstr "[_cornelia_] ¿En serio? Estos bichos raros son todos iguales."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:553 #-#-# translate crowdin gallery_d_066_91cde32f:
msgid "[_cedrick_] И то верно.. Хм.. Такой, со шрамом на носу и левом глазу?"
msgstr "[_cedrick_] Es cierto... Hmm... ¿El que tiene la cicatriz en la nariz y el ojo izquierdo?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:555 #-#-# translate crowdin gallery_d_066_19e01564:
msgid "[_cornelia_] Да, и перебинтованный весь. Такой урод.. Я уж думала он меня приковал, чтобы надругаться. Но он просто ушел, бессмыслица.."
msgstr "[_cornelia_] Sí, y todo vendado. Qué bicho raro. Pensé que me había encadenado para violarme. Pero simplemente se fue, qué inútil."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:557 #-#-# translate crowdin gallery_d_066_318dee95:
msgid "[_cedrick_] (Хм.. Интересный малый. Видимо он заковал ее на случай, если повстанцы решат воспользоваться паникой и освободить ее)"
msgstr "[_cedrick_] (Hmm... Un tipo interesante. Aparentemente la encadenó en caso de que los rebeldes decidieran aprovechar el pánico y liberarla.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:558 #-#-# translate crowdin gallery_d_066_504056d9:
msgid "[_cedrick_] Хах, но если ты все еще здесь и не знаешь, зачем тебя приковали, значит повстанцы к тебе даже не заглядывали"
msgstr "[_cedrick_] Jaja, pero si todavía estás aquí y no sabes por qué estás encadenado, entonces los rebeldes ni siquiera te han mirado."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:560 #-#-# translate crowdin gallery_d_066_2c90a3aa:
msgid "[_cornelia_] Ч-что!? Повстанцы были здесь?"
msgstr "[_cornelia_] ¿¡Q-qué!? ¿Los rebeldes estaban aquí?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:561 #-#-# translate crowdin gallery_d_066_7792213c:
msgid "[_cedrick_] (Хах, сразу оживилась. Пожалуй сыграю на этих ее эмоциях)"
msgstr "[_cedrick_] (Ja, ella se animó inmediatamente. Creo que jugaré con esas emociones suyas)."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:562 #-#-# translate crowdin gallery_d_066_d0e81b72:
msgid "[_cedrick_] Да, и Калеб был здесь. Неужели он к тебе не заглянул?"
msgstr "[_cedrick_] Sí, y Caleb estuvo aquí. ¿No pasó a verte?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:564 #-#-# translate crowdin gallery_d_066_8ef43118:
msgid "[_cornelia_] Н-нет, он.."
msgstr "[_cornelia_] N-no, él..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:566 #-#-# translate crowdin gallery_d_066_53a4a9e4:
msgid "[_cedrick_] Даже не попытался спасти свою принцессу.."
msgstr "[_cedrick_] Ni siquiera intentó salvar a su princesa."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:568 #-#-# translate crowdin gallery_d_066_7d1eb3e7:
msgid "[_cornelia_] Урод, ты лжешь!"
msgstr "[_cornelia_] Eres un mentiroso, eres un bicho raro!"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:570 #-#-# translate crowdin gallery_d_066_c3c4ee11:
msgid "[_cedrick_] Тогда зачем тебя приковали? Чтобы сложнее было вызволить. Но ты оказалась просто не нужна, это даже грустно.."
msgstr "[_cedrick_] Entonces, ¿por qué te encadenaron? Para dificultar tu liberación. Pero resultaste ser innecesario, es incluso triste."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:572 #-#-# translate crowdin gallery_d_066_13c717d6:
msgid "[_cornelia_] ..."
msgstr "[_cornelia_] ..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:574 #-#-# translate crowdin gallery_d_066_5484636a:
msgid "[_cedrick_] Впрочем ладно, я здесь не за этим. Мне нужно проверить кое-что"
msgstr "[_cedrick_] Bueno, no estoy aquí por eso. Necesito comprobar algo."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:576 #-#-# translate crowdin gallery_d_066_495d6e55:
msgid "[_cornelia_] ..и что же?"
msgstr "[_cornelia_] ¿Y qué es?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:578 #-#-# translate crowdin gallery_d_066_90dfcc85:
msgid "[_cedrick_] Не произойдет ли что-то странное, пока я буду тебя трахать"
msgstr "[_cedrick_] Si pasará algo raro mientras te estoy follando."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:580 #-#-# translate crowdin gallery_d_066_13c717d6_1:
msgid "[_cornelia_] ..."
msgstr "[_cornelia_] ..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:582 #-#-# translate crowdin gallery_d_066_3c7039a6:
msgid "[_cornelia_] Тебе уже настолько лень придумывать предлоги для того, чтобы меня трахнуть? Что за бредовый повод?"
msgstr "[_cornelia_] ¿Tan perezoso eres para inventar excusas para follarme? ¿Qué clase de razón tan ridícula es esa?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:584 #-#-# translate crowdin gallery_d_066_17f3c87b:
msgid "[_cedrick_] Ох, молись, чтобы это оказалось бредом. Лучше так, чем.."
msgstr "[_cedrick_] Oh, reza para que esto resulte ser una tontería. Mejor eso que..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:585 #-#-# translate crowdin gallery_d_066_c2efe348:
msgid "[_cedrick_] Хотя ладно, подробности тебе ни к чему"
msgstr "[_cedrick_] Bueno, está bien, no necesitas los detalles."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:587 #-#-# translate crowdin gallery_d_066_f9850bd7:
msgid "[_cornelia_] Ох, да ладно. Я уже давно раскусила тебя, Седрик. Ты просто хочешь трахать все, что движется"
msgstr "[_cornelia_] Vamos. Te descubrí hace mucho, Cedric. Solo quieres follar con todo lo que se mueve."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:589 #-#-# translate crowdin gallery_d_066_daac6619:
msgid "[_cornelia_] А с таким телом, как у меня, животному вроде тебя вообще сложно удержаться, не так ли?"
msgstr "[_cornelia_] Y con un cuerpo como el mío, es difícil para un animal como tú contenerse, ¿no?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:591 #-#-# translate crowdin gallery_d_066_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:593 #-#-# translate crowdin gallery_d_066_03ddc173:
msgid "[_cornelia_] Ну что..?"
msgstr "[_cornelia_] ¿Verdad...?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:594 #-#-# translate crowdin gallery_d_066_c10e0014:
msgid "[_cedrick_] Не спорю, раньше я был таким.."
msgstr "[_cedrick_] No discuto, yo solía ser así..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:596 #-#-# translate crowdin gallery_d_066_a65bbede:
msgid "[_cedrick_] Но сейчас уже нет. По правде говоря, мысль о прошлом образе жизни становится мне отвратительной"
msgstr "[_cedrick_] Pero ya no. Francamente, pensar en mi antigua forma de vida me resulta repulsivo."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:598 #-#-# translate crowdin gallery_d_066_96211028:
msgid "[_cornelia_] Ох, и что же произошло?"
msgstr "[_cornelia_] Ah, ¿y qué pasó?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:600 #-#-# translate crowdin gallery_d_066_3d643f65:
msgid "[_cedrick_] Скажем так, кое-кто вправил мне мозги"
msgstr "[_cedrick_] Digamos que alguien me puso las cosas en su lugar."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:602 #-#-# translate crowdin gallery_d_066_a69af2ce:
msgid "[_cornelia_] У вас что, теперь и местный психотерапевт есть?"
msgstr "[_cornelia_] ¿Tienes un psicoterapeuta local ahora?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:604 #-#-# translate crowdin gallery_d_066_70010461:
msgid "[_cedrick_] Ну, уже нет, я убил его.."
msgstr "[_cedrick_] Bueno ya no, lo maté."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:606 #-#-# translate crowdin gallery_d_066_24e17def:
msgid "[_cornelia_] Боооже, как все сложно.."
msgstr "[_cornelia_] Dios, todo es tan complicado."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:608 #-#-# translate crowdin gallery_d_066_c6c87dbd:
msgid "[_cornelia_] Хах, но ты в итоге все равно здесь, верно? Собираешься трахнуть меня. Так в чем же разница с прошлым тобой?"
msgstr "[_cornelia_] Ja, pero al final sigues aquí, ¿verdad? Me vas a follar. ¿Y qué te diferencia de tu antiguo yo?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:610 #-#-# translate crowdin gallery_d_066_06fbdec8:
msgid "[_cedrick_] (В том, что сейчас я буду надеяться на то, что не захочу вдруг откусить тебе голову в процессе или, не знаю.. Вдруг у меня отрастет хвост скорпиона между ног..)"
msgstr "[_cedrick_] (En ese momento espero no tener de repente ganas de morderte la cabeza en el proceso o, no sé... de repente me crecerá una cola de escorpión entre las piernas.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:612 #-#-# translate crowdin gallery_d_066_c71842b7:
msgid "[_cornelia_] Но ты определенно более задумчивый, чем обычно.. Не уж-то в твоей башке еще ютятся какие-то мысли?"
msgstr "[_cornelia_] Pero definitivamente estás más pensativo que de costumbre. ¿Aún tienes pensamientos rondando en tu cabeza?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:613 #-#-# translate crowdin gallery_d_066_49316299_1:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:615 #-#-# translate crowdin gallery_d_066_ac51871b:
msgid "[_cedrick_] Знаешь, это забавно. Ты говоришь про свое роскошное тело, но его даже повстанцы не захотели.. А я слышал с бабами у них туго.."
msgstr "[_cedrick_] Sabes, es curioso. Hablas de tu cuerpo precioso, pero ni siquiera los rebeldes lo querían. Y he oído que les faltan mujeres."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:617 #-#-# translate crowdin gallery_d_066_715b0793:
msgid "[_cornelia_] ..Да пошел ты!"
msgstr "[_cornelia_] ¡Que te jodan!"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:618 #-#-# translate crowdin gallery_d_066_274ded78:
msgid "[_cedrick_] Ладно, чего я тут перед тобой распинаюсь. Раздвигай ноги"
msgstr "[_cedrick_] Bueno, ¿por qué te digo esto? Abre las piernas."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:620 #-#-# translate crowdin gallery_d_066_d3a7c176:
msgid "[_cornelia_] Н-нет, постой.."
msgstr "[_cornelia_] N-no, espera..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:622 #-#-# translate crowdin gallery_d_066_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:627 #-#-# translate crowdin gallery_d_066_a826ff5a:
msgid "[_cornelia_] Грязное животное, хватит со мной так обращаться! Ты же Лорд, вроде как.. Где твои манеры!? Повалил меня на пол как какую-то уличную девку"
msgstr "[_cornelia_] ¡Animal asqueroso, deja de tratarme así! Se supone que eres un Señor... ¿Dónde están tus modales? Me tiraste al suelo como a una prostituta."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:628 #-#-# translate crowdin gallery_d_066_cc61b815:
msgid "[_cedrick_] Свои манеры я оставил для знатных особ и любимых мною дам. А ты враг моего королевства, простолюдинка и просто бесполезная девчонка"
msgstr "Reservaba mis modales para los nobles y las damas que amo. Pero tú eres una enemiga de mi reino, una plebeya y simplemente una chica inútil."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:630 #-#-# translate crowdin gallery_d_066_83db2506:
msgid "[_cornelia_] Хах, твоего королевства? Ты же просто шестерка Фобоса, разве нет?"
msgstr "Ja, ¿tu reino? Solo eres el lacayo de Fobos, ¿verdad?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:631 #-#-# translate crowdin gallery_d_066_49316299_2:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:635 #-#-# translate crowdin gallery_d_066_de51a681:
msgid "[_cornelia_] Уууф.. Кхм.. Черт, какой же ты жесткий.."
msgstr "[_cornelia_] Oooof... Eeey... Maldita sea, estas siendo duro..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:636 #-#-# translate crowdin gallery_d_066_9ed666c8:
msgid "[_cornelia_] Но что, разве я не права?"
msgstr "[_cornelia_] Pero ¿qué? ¿Me equivoco?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:637 #-#-# translate crowdin gallery_d_066_acd27219:
msgid "[_cedrick_] (..Своими жалкими провокациями она портит следственный эксперимент)"
msgstr "[_cedrick_] (Con sus patéticas provocaciones arruina el experimento de investigación.)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:638 #-#-# translate crowdin gallery_d_066_5f2bbd22:
msgid "[_cedrick_] (Мне определенно хочется ее придушить, но сейчас сложно сказать, это мое желание или все из-за того, что во мне сила Короля Морпионов?)"
msgstr "[_cedrick_] (Definitivamente quiero estrangularla, pero ahora mismo es difícil decir si es mi deseo o si es todo porque tengo el poder del Rey Morpion)"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:639 #-#-# translate crowdin gallery_d_066_0e72b9b4:
msgid "[_cedrick_] Черт, ты можешь заткнуться? Чем быстрее я закончу, тем быстрее ты будешь свободна"
msgstr "[_cedrick_] Maldita sea, ¿puedes callarte? Cuanto antes termine, antes serás libre."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:640 #-#-# translate crowdin gallery_d_066_0fe327c1:
msgid "[_cornelia_] Ахах, тебе что, ууух.. Даже ответить нечего? Значит я права"
msgstr "[_cornelia_] Jaja, ¿qué estás haciendo? ¿Ni siquiera tienes nada que decir? Eso significa que tengo razón."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:641 #-#-# translate crowdin gallery_d_066_925ec5d9:
msgid "[_cedrick_] Пффф.. Чертова девчонка.."
msgstr "[_cedrick_] Pfff... Maldita sea chica."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:642 #-#-# translate crowdin gallery_d_066_995d00d0:
msgid "[_cornelia_] Что? Тебе нечем мне ответить. Каким бы крутым ты себя не строил, ты все еще просто подчиненный Фобоса"
msgstr "[_cornelia_] ¿Qué? No tienes respuesta para mí. Por muy duro que te muestres, sigues siendo solo un subordinado de Fobos."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:643 #-#-# translate crowdin gallery_d_066_49316299_3:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:644 #-#-# translate crowdin gallery_d_066_49316299_4:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:645 #-#-# translate crowdin gallery_d_066_eaca2bbf:
msgid "[_cornelia_] ..Седрик?"
msgstr "[_cornelia_] ¿Cedric?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:646 #-#-# translate crowdin gallery_d_066_88589524:
msgid "[_cedrick_] ..Сейчас ты пожалеешь о том, что до этого жаловалась на мои манеры"
msgstr "[_cedrick_] Ahora te arrepentirás de haberte quejado de mis modales antes."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:648 #-#-# translate crowdin gallery_d_066_e0fd92eb:
msgid "[_cornelia_] С-стой, подожди.."
msgstr "[_cornelia_] Detente, espera..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:653 #-#-# translate crowdin gallery_d_066_e06a9251:
msgid "[_cornelia_] Н-нет.. Ааах, не так жестко, черт!"
msgstr "N-no... ¡Aaah, no seas tan duro, maldita sea!"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:654 #-#-# translate crowdin gallery_d_066_6190fd50:
msgid "[_cedrick_] Ох, а я думал ты напрашиваешься на жесткое обращение, разве нет?"
msgstr "[_cedrick_] Ah, y yo pensé que estabas pidiendo un trato duro, ¿no?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:655 #-#-# translate crowdin gallery_d_066_06ec91a9:
msgid "[_cornelia_] Я не, нет.. Черт, п-прости меня.. Ааах.."
msgstr "[_cornelia_] No, no... Maldita sea, p-perdóname... Aaah..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:656 #-#-# translate crowdin gallery_d_066_64442d07:
msgid "[_cedrick_] О, этот трюк не пройдет.. Уууф.. Запомни раз и навсегда, девчонка"
msgstr "Oh, ese truco no funcionará... Uuuph... Recuerda esto de una vez por todas, niña."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:657 #-#-# translate crowdin gallery_d_066_6f47266e:
msgid "[_cornelia_] ...."
msgstr "[_cornelia_] ...."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:658 #-#-# translate crowdin gallery_d_066_4817b1d4:
msgid "[_cedrick_] Я стану властителем всего Меридиана и ни ты.. Ни другие стражницы.. Ни Фобос.. Вы все не сможете меня остановить!"
msgstr "Me convertiré en el gobernante de todo Meridian y ni tú... Ni las otras guardianas... Ni Fobos... ¡Ninguno de ustedes podrá detenerme!"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:659 #-#-# translate crowdin gallery_d_066_08bd04d0:
msgid "[_cornelia_] Уууух, ч-черт, да что на тебя нашло, остановись.. ."
msgstr "[_cornelia_] Ooooh, maldita sea, ¿qué te pasa?, para..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:660 #-#-# translate crowdin gallery_d_066_08b8380a:
msgid "[_cedrick_] А ты.. Ты и есть просто уличная девка.. При чем ты вообще никому оказалась не нужна.."
msgstr "[_cedrick_] Y tú... Solo eres una prostituta callejera... Y de todas formas nadie te necesitaba."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:661 #-#-# translate crowdin gallery_d_066_d0ecf728:
msgid "[_cornelia_] Ч-что. Ааах, что ты несешь?!"
msgstr "[_cornelia_] ¿Q-qué? ¡Aaah, ¿de qué estás hablando?!"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:662 #-#-# translate crowdin gallery_d_066_4eb3dcea:
msgid "[_cedrick_] Ты строишь из себя принцессу, но правда в том, что тебе просто не хватает внимания! Потому что ты чертовски одинока"
msgstr "[_cedrick_] Actúas como una princesa, pero la verdad es que no recibes suficiente atención. Porque te sientes muy sola."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:663 #-#-# translate crowdin gallery_d_066_ef68e9b1:
msgid "[_cedrick_] Черт, да ты даже искала внимание в моем лице, когда думала, что я просто твой преподаватель"
msgstr "[_cedrick_] Diablos, incluso buscaste atención en mi cara cuando pensabas que solo era tu maestro."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:664 #-#-# translate crowdin gallery_d_066_8531c37e:
msgid "[_cornelia_] ....Э-это не"
msgstr "[_cornelia_] E-eso no es..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:665 #-#-# translate crowdin gallery_d_066_095d91fc:
msgid "[_cedrick_] Даже не пытайся отрицать. У тебя типичный синдром девочки богатых родителей. Тебе дали все, что ты хочешь, но при этом всем было на тебя плевать!"
msgstr "[_cedrick_] Ni siquiera intentes negarlo. Tienes el típico síndrome de la niña rica. Te dieron todo lo que querías, ¡pero a nadie le importabas!"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:667 #-#-# translate crowdin gallery_d_066_0211727c:
msgid "[_cornelia_] Н-нет.."
msgstr "[_cornelia_] N-no..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:668 #-#-# translate crowdin gallery_d_066_2be76c99:
msgid "[_cedrick_] Разве? Знаешь, сейчас многие обеспокоенные родители поднимают панику, касательно пропажи их детей.."
msgstr "[_cedrick_] ¿En serio? Muchos padres preocupados están entrando en pánico ahora mismo por la desaparición de sus hijos."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:669 #-#-# translate crowdin gallery_d_066_3ee8abe6:
msgid "[_cedrick_] Но за все это время я ни разу не слышал и не видел твоих родителей. Хотя сколько ты уже здесь?"
msgstr "[_cedrick_] Pero en todo este tiempo, nunca he oído ni visto a tus padres. Aunque, ¿cuánto tiempo llevas aquí?"

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:670 #-#-# translate crowdin gallery_d_066_13c717d6_2:
msgid "[_cornelia_] ..."
msgstr "[_cornelia_] ..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:671 #-#-# translate crowdin gallery_d_066_14c6755f:
msgid "[_cedrick_] Стражницы не отправились вызволять тебя из замка, они больше обеспокоены тем, как мне отомстить за свои личные травмы"
msgstr "[_cedrick_] Los guardias no fueron a rescatarte del castillo; estaban más preocupados por cómo podía vengar mis heridas personales."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:672 #-#-# translate crowdin gallery_d_066_1111eb2a:
msgid "[_cedrick_] А на тебя.. На тебя плевать даже гребаным повстанцам.. Ууух, черт, ты и вправду никому не нужная девчонка.."
msgstr "[_cedrick_] Y en cuanto a ti... Ni siquiera a los malditos rebeldes les importas un comino. Ugh, maldita sea, realmente eres una chica inútil para cualquiera."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:673 #-#-# translate crowdin gallery_d_066_b8a95bf5:
msgid "[_cornelia_] Ааах.. Х-хватит.."
msgstr "[_cornelia_] Aaah... Para..."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:674 #-#-# translate crowdin gallery_d_066_03d669dc:
msgid "[_cedrick_] Хах, если так подумать, то место, где ты больше всего нужна - это эта темница"
msgstr "[_cedrick_] Jaja, si lo piensas, el lugar donde más te necesitan es esta mazmorra."

# game/scripts/quests/questDefeatMorpionKing/defeat_morpion_king.rpy:675 #-#-# translate crowdin gallery_d_066_5290583c:
msgid "[_cornelia_] Ч-что?.."
msgstr "[_cornelia_] ¿Q-qué?.."

