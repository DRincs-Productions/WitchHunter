# TODO: Translation updated at 2023-07-25 15:55 #|#|# # game/scripts/quests/questDefeatMorpionKing/take_miranda_to_the_castle.rpy:4 #-#-# translate crowdin take_miranda_to_the_castle_64af8a0d:
msgid "[_cedrick_] Побудь пока здесь, Миранда. Не думаю, что это чудовище дойдет до глубин замка. Даже если я против него не выстою, замок сможет отстоять Фобос, так что ты в безопасности"
msgstr "[_cedrick_] Quédate aquí por ahora, Miranda. No creo que ese monstruo llegue a las profundidades del castillo. Aunque no tenga ninguna posibilidad contra él, Fobos puede defender el castillo, así que estás a salvo"

# game/scripts/quests/questDefeatMorpionKing/take_miranda_to_the_castle.rpy:5 #-#-# translate crowdin take_miranda_to_the_castle_41dea664:
msgid "[_miranda_] С-седрик.."
msgstr "[_miranda_] C-Cedric.."

# game/scripts/quests/questDefeatMorpionKing/take_miranda_to_the_castle.rpy:6 #-#-# translate crowdin take_miranda_to_the_castle_d0451b74:
msgid "[_cedrick_] Уже хватает сил, чтобы говорить? Значит атака стражниц не задела важных органов. Но лучше не напрягайся, тебе нужно восстановиться"
msgstr "¿Ya tienes fuerzas para hablar? El ataque de las guardianas no alcanzó ningún órgano vital. Pero es mejor que no te esfuerces; necesitas recuperarte"

# game/scripts/quests/questDefeatMorpionKing/take_miranda_to_the_castle.rpy:7 #-#-# translate crowdin take_miranda_to_the_castle_10242dc1:
msgid "[_miranda_] ..."
msgstr "[_miranda_] ..."

# game/scripts/quests/questDefeatMorpionKing/take_miranda_to_the_castle.rpy:8 #-#-# translate crowdin take_miranda_to_the_castle_c79a7736:
msgid "[_cedrick_] И еще кое-что. Я заберу те зелья, что у тебя остались. Сил у меня осталось немного, так что восстановиться не повредит"
msgstr "[_cedrick_] Y una cosa más. Tomaré las pociones que te queden. No me quedan muchas fuerzas, así que no me vendría mal recuperarme"

# game/scripts/quests/questDefeatMorpionKing/take_miranda_to_the_castle.rpy:12 #-#-# translate crowdin take_miranda_to_the_castle_fe71656d:
msgid "[_cedrick_] Этого должно хватить.."
msgstr "[_cedrick_] Esto debería ser suficiente.."

# game/scripts/quests/questDefeatMorpionKing/take_miranda_to_the_castle.rpy:16 #-#-# translate crowdin take_miranda_to_the_castle_78cd2daf:
msgid "[_broken_warrior_] Лорд Седрик, повстанцы во главе с Калебом прорвались внутрь и украли часть провианта! Они воспользовались положением и.."
msgstr "Señor Cedric, los rebeldes, liderados por Caleb, han irrumpido y robado algunas provisiones. Aprovecharon la situación y.."

# game/scripts/quests/questDefeatMorpionKing/take_miranda_to_the_castle.rpy:19 #-#-# translate crowdin take_miranda_to_the_castle_d08d6a69:
msgid "[_cedrick_] Это было ожидаемо, солдат. Еще повезло, что они не бьют нас в спины. Плевать на повстанцев, с ними мы разберемся позже. А пока.."
msgstr "[_cedrick_] Era de esperar, soldado. Tenemos suerte de que no nos estén apuñalando por la espalda. Olvídate de los rebeldes, ya nos ocuparemos de ellos después. Por ahora.."

