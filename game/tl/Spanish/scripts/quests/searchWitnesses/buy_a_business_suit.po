# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:707 #-#-# translate crowdin gallery_d_080_138f908b:
msgid "[_cedrick_] Вас могут услышать!?"
msgstr "[_cedrick_] Se puede escuchar!?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:709 #-#-# translate crowdin gallery_d_080_448708d9:
msgid "[_alchemy_] ..."
msgstr "[_alchemy_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:710 #-#-# translate crowdin gallery_d_080_bcd124bf:
msgid "[_will_] ..."
msgstr "[_will_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:712 #-#-# translate crowdin gallery_d_080_590d46c4:
msgid "[_alchemy_] Зато я сосу лучше. Спорим он кончит от моего рта"
