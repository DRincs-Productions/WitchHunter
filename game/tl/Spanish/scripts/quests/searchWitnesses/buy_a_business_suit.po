# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:655 #-#-# translate crowdin gallery_d_080_c9b0a8e6:
msgid "[_alchemy_] Ч-что.. Подожди, а ты кто вообще такая!?"
msgstr "[_alchemy_] ¿Qué? ¿Qué? ¡¡Espera, ¿quién eres?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:656 #-#-# translate crowdin gallery_d_080_433bb214:
msgid "[_will_] Сейчас это не важно. Важно то, что Рик собрался кончить. И раз уж это происходит у меня под боком, я не позволю чтобы он делал это в какую-то другую девчонку"
msgstr "[_will_] Eso no importa ahora. Lo importante es que Rick está por correrse. Y ya que ocurre a mi lado, no permitiré que lo haga dentro de otra chica."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:658 #-#-# translate crowdin gallery_d_080_933cc5b4:
msgid "[_cedrick_] Ч-что?"
msgstr "[_cedrick_] ¿¡Q-qué?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:662 #-#-# translate crowdin gallery_d_080_553fd89a:
msgid "[_cedrick_] Ууух, ч-черт, Вилл, ты что творишь?!"
msgstr "[_cedrick_] Wuhu, diablos, Will, ¿qué estás haciendo?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:663 #-#-# translate crowdin gallery_d_080_ec8d915e:
msgid "[_will_] А что ты творишь, Рик? Мммв.. Трахаешься тут с другими девочнками.."
