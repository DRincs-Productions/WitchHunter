# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:681 #-#-# translate crowdin gallery_d_080_7bf888e2:
msgid "[_alchemy_] Хах, а я думала это я тут фанатична по отношению к членам.. Смотрю мне еще есть куда расти"
