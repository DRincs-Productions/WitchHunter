# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:949 #-#-# translate crowdin gallery_d_081_3f140afe:
msgid "[_cedrick_] И не просто так, Ирма. Уясни раз и навсегда. Хватит своевольничать"
