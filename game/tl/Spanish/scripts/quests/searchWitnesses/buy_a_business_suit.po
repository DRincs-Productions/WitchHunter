# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:974 #-#-# translate crowdin gallery_d_081_e0f550bc:
msgid "[_cornelia_] Ну и что ты делаешь с нашей бедняжкой Ирмой, Седрик?"
