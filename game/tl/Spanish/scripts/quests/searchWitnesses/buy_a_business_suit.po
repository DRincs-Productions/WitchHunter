msgstr "[_medina_] Sobre la acusación llamada Cornelia hale"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:747 #-#-# translate crowdin gallery_d_080_0799cfb6:
msgid "[_theresa_] Мисс Хейл, представьтесь, пожалуйста"
msgstr "[_theresa_] Señorita hale, por favor preséntate"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:749 #-#-# translate crowdin gallery_d_080_0a23874e:
msgid "[_cornelia_] Тыыы, ублюдок! Думаешь тебе сойдет все это с рук!?"
msgstr "[_cornelia_] ¡Tú, bastardo! ¿Crees que te vas a salir con la tuya con todo!?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:750 #-#-# translate crowdin gallery_d_080_de77ad7d:
msgid "[_theresa_] Мисс Хейл, соблюдайте порядок.."
msgstr "[_theresa_] Señorita Hale, mantenga el orden."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:752 #-#-# translate crowdin gallery_d_080_106730a5:
msgid "[_cornelia_] После всего, что он со мной сделал? После того, как надругался надо мной столько раз, что уже и не сосчитать!"
msgstr "[_cornelia_] ¿Después de todo lo que me hizo? ¡Después de despertar sobre mí tantas veces que ya no puedo contar!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:754 #-#-# translate crowdin gallery_d_080_e0ad4430:
msgid "[_medina_] ..."
msgstr "[_medina_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:756 #-#-# translate crowdin gallery_d_080_e904dadc:
msgid "[_cornelia_] Думал что все? Что теперь я в твоей власти!? Что я послушно буду делать все, что ты мне скажешь?"
msgstr "[_cornelia_] ¿Lo pensabas todo? ¿¡Qué estoy en tu poder ahora! ¿Qué hago obedientemente lo que me digas?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:757 #-#-# translate crowdin gallery_d_080_f2f3a80e:
msgid "[_cornelia_] Что буду плясать под твою дудку? Да я просто притворялась! Все это было лишь ради того, чтобы дожить до этого дня"
msgstr "[_cornelia_] ¿Qué voy a bailar a tu ritmo? ¡Solo estaba fingiendo! Todo esto era solo para vivir hasta el día de hoy"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:759 #-#-# translate crowdin gallery_d_080_b8abfc29:
msgid "[_cornelia_] Чтобы у меня была возможность добраться до суда в целости.. Чтобы встать на трибуну и во всеуслышание сказать это!!"
msgstr "[_cornelia_] Para tener la oportunidad de llegar a la corte intacto.. Pararse en el podio y decirlo públicamente!!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:760 #-#-# translate crowdin gallery_d_080_96ddeb6e:
msgid "[_cornelia_] После всех этих унижений ты наконец получишь по заслугам, слышишь!?"
msgstr "[_cornelia_] Después de todas estas humillaciones, finalmente obtendrás lo que te mereces, ¿lo oyes?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:762 #-#-# translate crowdin gallery_d_080_49316299_4:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:763 #-#-# translate crowdin gallery_d_080_046eef7c:
msgid "[_cornelia_] Ты самый мерзкий человек из всех, кого я только встречала. Тебя даже нельзя назвать человеком!"
msgstr "[_cornelia_] Eres la persona más repugnante que he conocido. ¡Ni siquiera puedes ser llamado humano!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:764 #-#-# translate crowdin gallery_d_080_f89f7db9:
msgid "[_cedrick_] ....."
msgstr "[_cedrick_] ....."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:765 #-#-# translate crowdin gallery_d_080_6fda7d16:
msgid "[_cornelia_] Таких как ты должны сжигать на электрическом стуле за все те злодеяния, что ты совершил со мной и остальными девочками!"
msgstr "[_cornelia_] Como deberías quemarte en la silla eléctrica por todas las atrocidades que cometiste conmigo y las otras chicas!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:766 #-#-# translate crowdin gallery_d_080_ebed3d65:
msgid "[_cedrick_] ......."
msgstr "[_cedrick_] ......."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:768 #-#-# translate crowdin gallery_d_080_949cd96c:
msgid "[_cornelia_] Ты просто чудовище. Настоящий монстр!"
msgstr "[_cornelia_] Eres un monstruo. ¡Es un verdadero monstruo!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:769 #-#-# translate crowdin gallery_d_080_09ebdcbd:
msgid "[_cornelia_] Слышишь меня, Мактиннен!? Да да, я к тебе обращаюсь, ты чертов насильник"
msgstr "[_cornelia_] ¿Me oyes, Maktinen? ¡Sí, te hablo a ti, maldito violador!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:772 #-#-# translate crowdin gallery_d_080_f4470132:
msgid "Зал шумит"
msgstr "El salón es ruidoso"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:775 #-#-# translate crowdin gallery_d_080_c9c27f2a:
msgid "[_theresa_] Тишина в зале"
msgstr "[_theresa_] Silencio en el salón"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:777 #-#-# translate crowdin gallery_d_080_0c4bc6e0:
msgid "[_cedrick_] ...Фух"
msgstr "[_cedrick_] ...Fuch"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:779 #-#-# translate crowdin gallery_d_080_bbee77a8:
msgid "[_payne_] Протестую, Ваша честь! В этих словах нет ничего, кроме злобы и ненависти. Где конструктивные доводы? Где факты?"
msgstr "[_payne_] ¡Objeción, Su Señoría! En esas palabras no hay más que ira y odio. ¿Dónde están los argumentos constructivos? ¿Dónde están los hechos?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:780 #-#-# translate crowdin gallery_d_080_e2fa574b:
msgid "[_payne_] Сторона защиты требует отозвать показания свидетеля. Все это похоже на цирк"
msgstr "[_payne_] La parte de la defensa exige retirar el testimonio del testigo. Todo parece un circo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:781 #-#-# translate crowdin gallery_d_080_dbfe5a8b:
msgid "[_medina_] Протестую, Ваша часть! Подобные показания ярче всего демонстрируют состояние жертвы"
msgstr "[_medina_] ¡Objeción, Su Señoría! Este testimonio muestra con total claridad el estado de la víctima."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:782 #-#-# translate crowdin gallery_d_080_ba67f38b:
msgid "[_medina_] У бедной девочки не осталось ничего фактического.. Она не помнит конкретных событий или конкретных дат. Все, что у нее осталось, это ненависть"
msgstr "[_medina_] La pobre chica no tiene nada que ver con el... No recuerda eventos específicos ni fechas específicas. Todo lo que le queda es odio"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:783 #-#-# translate crowdin gallery_d_080_af6cba87:
msgid "[_medina_] Ненависть к своему обидчику. Может она и рада была бы вспомнить так необходимые следствию даты и места.."
msgstr "[_medina_] Odia a tu tutor. Tal vez estaría feliz de recordar las fechas y lugares necesarios para la investigación."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:784 #-#-# translate crowdin gallery_d_080_e6726e40:
msgid "[_medina_] Но разве после всего, что она пережила, это не становится очевидным?"
msgstr "[_medina_] ¿Pero no es obvio después de todo lo que experimentó?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:785 #-#-# translate crowdin gallery_d_080_69b70340:
msgid "[_medina_] Корнелия травмирована до беспамятства. Ее показания наполнены лишь эмоциями и обвинениями, потому что это единственное, что она помнит"
msgstr "[_medina_] Cornelia está traumatizada al olvido. Su testimonio está lleno de solo emociones y acusaciones, porque es lo único que recuerda"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:786 #-#-# translate crowdin gallery_d_080_b3337f2b:
msgid "[_medina_] Воспоминания могут пропасть, но не травмы, не эмоции и не тот колоссальный вред, что нанес ей Мактиннен"
msgstr "[_medina_] Los recuerdos pueden desaparecer, pero no las lesiones, no las emociones y no el daño colosal que Maktinen le infligió"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:787 #-#-# translate crowdin gallery_d_080_eeeed982:
msgid "[_medina_] Разум может забыть, но тело все помнит!"
msgstr "[_medina_] La razón puede olvidar, pero el cuerpo recuerda todo!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:789 #-#-# translate crowdin gallery_d_080_2da83e63:
msgid "[_cornelia_] (На самом деле я просто не успела выучить весь текст. Так много всего.. В этот день было то, в тот день было это.. Да кому все это надо..)"
msgstr "[_cornelia_] (De hecho, simplemente no tuve tiempo de aprender el texto completo. Tanto de todo... Ese día fue ese día que fue. Quién necesita todo esto...)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:790 #-#-# translate crowdin gallery_d_080_5628dd8e:
msgid "[_payne_] Ваша честь, я требую аннулировать показания в силу их несостоятельности и взыскать санкции с мисс Корнелии за нанесенные моему клиенту оскорбления"
msgstr "[_payne_] Su Señoría, exijo anular el testimonio por su insolvencia y cosechar sanciones con la señorita Cornelia por los insultos infligidos a mi cliente"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:792 #-#-# translate crowdin gallery_d_080_db532036:
msgid "[_cornelia_] Он меня изнасиловал, ты, старый хрен! Какие еще санкции за оскорбление!?"
msgstr "[_cornelia_] ¡Me violó, viejo cabrón! ¿Qué otras sanciones para insultar?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:793 #-#-# translate crowdin gallery_d_080_dfc2198a:
msgid "[_theresa_] Мисс Хейл, призываю к порядку!"
msgstr "[_theresa_] ¡Señorita Hale, estoy pidiendo orden!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:795 #-#-# translate crowdin gallery_d_080_e0745425:
msgid "[_theresa_] За резкие высказывания суд накладывает на вас санкции в виде штрафа на 100$"
msgstr "[_theresa_] Para declaraciones duras, el tribunal le impone sanciones en forma de una multa de $ 100"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:798 #-#-# translate crowdin gallery_d_080_e09b505d:
msgid "[_cornelia_] Пф.. И это ваше правосудие? Штрафовать жертву насильника!?"
msgstr "[_cornelia_] Pf. ¿Esa es tu justicia? ¡¿Multas a la víctima del violador?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:800 #-#-# translate crowdin gallery_d_080_0860b084:
msgid "*Зал наполняется шумом*"
msgstr "*La sala está llena de ruido*"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:804 #-#-# translate crowdin gallery_d_080_65d2dca8:
msgid "[_theresa_] Тишина в зале суда!"
msgstr "[_theresa_] ¡Silencio en la sala del tribunal!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:806 #-#-# translate crowdin gallery_d_080_c87dd930:
msgid "[_theresa_] Мистер Пейн, суд отклоняет вашу жалобу, касающуюся показаний потерпевшей"
msgstr "[_theresa_] ¿Sr. Payne, la corte rechaza su queja sobre el testimonio de la víctima"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:807 #-#-# translate crowdin gallery_d_080_5972056f:
msgid "[_theresa_] Суд наложит на Мисс Хейл санкции, но не станет отзывать ее показания"
msgstr "[_theresa_] El tribunal impondrá sanciones a la señorita Hale, pero no retirará su testimonio"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:808 #-#-# translate crowdin gallery_d_080_a7e10267:
msgid "[_payne_] Пф.."
msgstr "[_payne_] Pf."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:809 #-#-# translate crowdin gallery_d_080_7e856b21:
msgid "[_cedrick_] (Хах, надеюсь эти сто баксов сильно помогут Мактиннену в тюрячке)"
msgstr "[_cedrick_] (Hah, espero que estos cien dólares ayuden mucho a mctennen en un prisionero)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:810 #-#-# translate crowdin gallery_d_080_3a805106:
msgid "[_cedrick_] (Отлично выступила, Корнелия. После такого перформанса победа у нас в кармане. Суд присяжных просто уничтожит Мактиннена)"
msgstr "[_cedrick_] (Excelente en carácter, Cornelia. Después de tal actuación, la victoria en nuestro bolsillo. El jurado simplemente destruirá a Maktinen)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:811 #-#-# translate crowdin gallery_d_080_a2c571c2:
msgid "[_theresa_] Суд вызывает последнего пострадавшего в этом деле. Мисс Ирма Лэйр, можете войти"
msgstr "[_theresa_] El tribunal cita a la última víctima en este caso. ¡Srta. Irma Lair, puede entrar"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:815 #-#-# translate crowdin gallery_d_080_81be6361:
msgid "[_theresa_] Мисс Лэйр, представьтесь суду, пожалуйста"
msgstr "[_theresa_] Señorita Lair, preséntese a la corte, por favor"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:817 #-#-# translate crowdin gallery_d_080_d4c2dd4e:
msgid "[_irma_] Я Ирма Лэйр.. Учащаяся местной школы.."
msgstr "[_irma_] Soy Irma Lair... alumna de la escuela local..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:819 #-#-# translate crowdin gallery_d_080_b7479956:
msgid "[_medina_] И так, Мисс Лэйр, можете нам рассказать, как вы оказались на складе? Что с вами произошло?"
msgstr "[_medina_] Y así, ms. Lair, ¿puedes decirnos cómo llegaste al almacén? ¿Qué te pasó?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:821 #-#-# translate crowdin gallery_d_080_d123c005:
msgid "[_irma_] Ч-что со мной произошло? Я.. Эм, я не знаю.. Мне сейчас сложно сказать, что конкретно со мной происходит.."
msgstr "[_irma_] W-¿qué me pasó? Yo.. Uh, no lo sé. Es difícil para mí decirme exactamente qué me está pasando."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:823 #-#-# translate crowdin gallery_d_080_8992b2cf:
msgid "[_cedrick_] (Что за.. Она говорит не по тексту, этого я ей не писал)"
msgstr "[_cedrick_] (¿Y... Ella no dice el texto, yo no le escribí)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:825 #-#-# translate crowdin gallery_d_080_349b1396:
msgid "[_medina_] Вы можете описать суду, в чем конкретно для вас проявляется эта.. Сложность?"
msgstr "[_medina_] Usted puede describir a la corte lo que exactamente está en esto para usted. ¿Dificultad?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:827 #-#-# translate crowdin gallery_d_080_8f8e2292:
msgid "[_irma_] Я, эм.. Я раньше была в себе так уверена.. Мне всегда казалось, что я смогу со всем справиться.."
msgstr "[_irma_] Yo, um... Solía estar tan seguro de mí mismo. Siempre pensé que podía manejar todo."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:829 #-#-# translate crowdin gallery_d_080_fa3cf9ae:
msgid "[_irma_] Преодолеть любые трудности, снести любые препятствия на моем пути.."
msgstr "[_irma_] Supera cualquier dificultad, derriba cualquier obstáculo en mi camino."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:831 #-#-# translate crowdin gallery_d_080_b0de21ae:
msgid "[_irma_] Но потом произошло это.."
msgstr "[_irma_] Pero luego sucedió."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:833 #-#-# translate crowdin gallery_d_080_8fc5f3ff:
msgid "[_medina_] Что произошло, Мисс Лэйр?"
msgstr "[_medina_] ¿Qué pasó, señorita Lair?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:835 #-#-# translate crowdin gallery_d_080_3ee13336:
msgid "[_irma_] Я просто поняла, что во мне больше нет сил сражаться.. Что я больше не хочу всего этого.."
msgstr "[_irma_] Me acabo de dar cuenta de que ya no tengo la fuerza para luchar. Que ya no quiero todo esto."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:836 #-#-# translate crowdin gallery_d_080_d9bd6c66:
msgid "[_cedrick_] (Да что она несет..)"
msgstr "[_cedrick_] (Sí, lleva...)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:838 #-#-# translate crowdin gallery_d_080_43836083:
msgid "[_irma_] Я больше не хочу, чтобы мне что-то угрожало.."
msgstr "[_irma_] Ya no quiero estar en peligro para mí."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:840 #-#-# translate crowdin gallery_d_080_3fb1fa8e:
msgid "[_payne_] Что конкретно вам угрожает, Мисс Лэйр?"
msgstr "[_payne_] ¿Qué es exactamente lo que te está amenazando, Sra. ¿Lair?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:842 #-#-# translate crowdin gallery_d_080_3b966c83:
msgid "[_medina_] Не лезь, Пэйн"
msgstr "[_medina_] No te muevas, Payne"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:844 #-#-# translate crowdin gallery_d_080_7c29e7b8:
msgid "[_payne_] Я соблюдаю все принципы перекрестного допроса"
msgstr "[_payne_] Sigo todos los principios del interrogatorio"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:845 #-#-# translate crowdin gallery_d_080_d8891a14:
msgid "[_theresa_] Мистер Пэйн, продолжайте"
msgstr "[_theresa_] Sr. Payne, continúa"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:846 #-#-# translate crowdin gallery_d_080_532917dc:
msgid "[_payne_] Вам угрожает какой-то конкретный человек, Мисс Лэйр? Этот человек сейчас в зале суда.."
msgstr "[_payne_] ¿Una persona te amenaza con una persona en particular, ms. ¿Lair? Este hombre está en la sala del tribunal."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:848 #-#-# translate crowdin gallery_d_080_795678bb:
msgid "[_irma_] ..."
msgstr "[_irma_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:850 #-#-# translate crowdin gallery_d_080_39b476ed:
msgid "[_irma_] Этот человек просто гарантирует мою безопасность.."
msgstr "[_irma_] Esta persona solo garantiza mi seguridad.."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:852 #-#-# translate crowdin gallery_d_080_7bc07cda:
msgid "[_irma_] И со мной больше ничего страшного не произойдет, если я все буду делать правильно.."
msgstr "[_irma_] Y no me pasará nada peor si hago todo bien."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:854 #-#-# translate crowdin gallery_d_080_7cd161fa:
msgid "[_irma_] Больше мне не придется строить из себя боевую девчонку и за все бороться"
msgstr "[_irma_] Ya no tengo que apreciar una ojiva y luchar por todo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:856 #-#-# translate crowdin gallery_d_080_e0ad4430_1:
msgid "[_medina_] ..."
msgstr "[_medina_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:857 #-#-# translate crowdin gallery_d_080_b6fa3735:
msgid "[_cedrick_] (Вот черт..)"
msgstr "[_cedrick_] (Aquí el diablo.)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:858 #-#-# translate crowdin gallery_d_080_32ada61b:
msgid "[_payne_] Ваша честь, сторона защиты требует аннулировать все дальнейшие показания Мисс Лэйр, поскольку данный потерпевший находится под давлением"
msgstr "[_payne_] Su honor, la parte de la defensa exige anular a toda la Sra. El testimonio de Lair como la víctima está bajo presión"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:859 #-#-# translate crowdin gallery_d_080_8d213ef2:
msgid "[_payne_] Девушка может сказать нам что угодно, но мы более не можем быть уверены, что она не транслирует через себя чьи-то чужие мысли"
msgstr "[_payne_] la chica puede decirnos cualquier cosa, pero ya no podemos estar seguros de que no transmita a través de los pensamientos de otra persona a través de sí misma"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:860 #-#-# translate crowdin gallery_d_080_8a069208:
msgid "[_theresa_] Суд удовлетворяет прошение Мистера Пэйна. Ирма Лэйр отзывается в качестве свидетеля. Ее показания более не действительны"
msgstr "[_theresa_] El tribunal satisface al Sr. La petición de Payne. Irma Lair es sensible como testigo. Su testimonio ya no es válido"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:861 #-#-# translate crowdin gallery_d_080_a78bb2d9:
msgid "[_payne_] И учитывая, с чьей стороны был выставлен данный свидетель и чьи интересы он представлял, не сложно догадаться, кто так надавил на Мисс Лэйр"
msgstr "[_payne_] Y dado de qué lado se exhibió el testigo y cuyos intereses representó, no es difícil adivinar quién lo presionó sobre la señorita Lair"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:863 #-#-# translate crowdin gallery_d_080_f32c4efa:
msgid "[_payne_] Думаю теперь всему суду присяжных очевидно, что Рик просто заставил Ирму Лэйр выступить в суде, а возможно и всех свидетелей"
msgstr "[_payne_] Ahora es obvio para todo el jurado que Rick acaba de obligar a Irma Lair a hablar en la corte, y posiblemente todos los testigos"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:864 #-#-# translate crowdin gallery_d_080_aadd1acc:
msgid "[_medina_] Протестую, Ваша честь! Дальнейшие рассуждения стороны защиты без доказательной основы не должны выноситься в публичное поле"
msgstr "[_medina_] ¡Objeción, Su Señoría! Las afirmaciones de la defensa que carezcan de pruebas no deben exponerse ante el público."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:865 #-#-# translate crowdin gallery_d_080_a5edb000:
msgid "[_medina_] Либо предъявите доказательства, либо перестаньте бросаться ложными обвинениями в зале суда!"
msgstr "[_medina_] O bien mostrar evidencia, o dejar de lanzar acusaciones falsas en la sala del tribunal!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:866 #-#-# translate crowdin gallery_d_080_a294a1b8:
msgid "[_theresa_] Принимается, Мисс Медина"
msgstr "[_theresa_] Se acepta, señorita Medina."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:867 #-#-# translate crowdin gallery_d_080_500ec4ac:
msgid "[_payne_] Пф.. Снова здесь ни к чему.. Всем и так все очевидно.."
msgstr "[_payne_] Pf. No está bien aquí de nuevo. Es obvio para todos."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:868 #-#-# translate crowdin gallery_d_080_a1366473:
