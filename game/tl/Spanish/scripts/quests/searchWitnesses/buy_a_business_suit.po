# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:953 #-#-# translate crowdin gallery_d_081_370116a9:
msgid "[_cedrick_] (Черт, видимо это то, о чем говорила Миранда. Легкие противоречия в голове у Ирмы все же происходят)"
