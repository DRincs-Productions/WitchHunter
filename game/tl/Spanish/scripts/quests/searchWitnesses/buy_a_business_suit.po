msgstr "[_irma_] Aaa..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:898 #-#-# translate crowdin gallery_d_081_403500fb:
msgid "[_cedrick_] У тебя была одна.. Ровно одна задача! Сказать в суде то, что я написал! А это что было!?"
