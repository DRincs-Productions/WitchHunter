# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:910 #-#-# translate crowdin gallery_d_081_3a671cd9:
msgid "[_cedrick_] (Ч-черт, это еще кто..)"
msgstr "[_cedrick_] (Maldita sea, eso es lo que más...)"

