msgid "[_theresa_] Суд прерывается на запланированный перерыв, предусмотренный законодательством штата. Пока можете разойтись"
msgstr "[_theresa_] El tribunal es interrumpido por una ruptura programada prevista por la ley estatal. Mientras puedas dispersarte"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:870 #-#-# translate crowdin gallery_d_080_ab51d71d:
msgid "[_theresa_] ..."
msgstr "[_theresa_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:871 #-#-# translate crowdin gallery_d_080_49316299_5:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:874 #-#-# translate crowdin gallery_d_080_75a0eb7b:
msgid "[_centered_] {size=37}Позже в туалете{/size} [withDissolve1]"
