# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:735 #-#-# translate crowdin gallery_d_080_a5bbec5b:
msgid "[_will_] Д-да, надеюсь у тебя не будут из-за нас неприятности.."
