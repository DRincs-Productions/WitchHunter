# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:880 #-#-# translate crowdin gallery_d_081_f2530cd1:
msgid "[_cedrick_] Какого черта это было, Ирма!? Мне нужны объяснения!"
