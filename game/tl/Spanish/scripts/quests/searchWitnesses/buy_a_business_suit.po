# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:618 #-#-# translate crowdin gallery_d_080_90e6d6a3:
msgid "[_cedrick_] Тише, безумная девчонка.. Нас могут услышать.."
msgstr "[_cedrick_] Es una chica tranquila y loca. Pueden escucharnos..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:620 #-#-# translate crowdin gallery_d_080_f8611e26:
msgid "[_alchemy_] Д-да плевать"
msgstr "[_alchemy_] A D-dany no le importa"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:624 #-#-# translate crowdin gallery_d_080_db78f07a:
msgid "[_cedrick_] Ну и как же так в итоге вышло, а, Алхими?"
msgstr "[_cedrick_] Bueno, Alchemy, ¿cómo terminamos así?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:625 #-#-# translate crowdin gallery_d_080_5cc8ac43:
msgid "[_cedrick_] Ты вроде как уже с Фобосом, но занимаешься сексом ты все равно со мной"
msgstr "[_cedrick_] Estás un poco con Fobos, pero estás teniendo sexo conmigo de todos modos"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:626 #-#-# translate crowdin gallery_d_080_6aa5975d:
msgid "[_cedrick_] И часто ты так Фобосу изменяешь?"
msgstr "[_cedrick_] ¿Y a menudo engañas como Fobos?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:627 #-#-# translate crowdin gallery_d_080_f9cdd7d9:
msgid "[_alchemy_] Н-нет.. Ааах.. Т-только с тобой.."
msgstr "[_alchemy_] No. No. Aah... Solo contigo..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:628 #-#-# translate crowdin gallery_d_080_bfcd377e:
msgid "[_alchemy_] Я.. Ууух.. Не знаю.. Не знаю, как объяснить.."
msgstr "[_alchemy_] Y-yo... Uuuh... No lo sé... No sé cómo explicarlo..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:629 #-#-# translate crowdin gallery_d_080_5962d98e:
msgid "[_alchemy_] Видимо это, ааах.. По старой памяти.. Я привыкла, что меня трахаешь ты.."
msgstr "[_alchemy_] Debe ser por... aaah... la costumbre... Estoy acostumbrada a que seas tú quien me coja..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:630 #-#-# translate crowdin gallery_d_080_ecaebbde:
msgid "[_alchemy_] Б-больше такого ни с кем не было.. Фобос.. Ааах.. Фобос просто забил на меня.."
msgstr "[_alchemy_] No había tal cosa con nadie más. Fobos. Aah... Fobos acaba de anotar en Mí."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:631 #-#-# translate crowdin gallery_d_080_778fbc89:
msgid "[_alchemy_] На меня и на мои желания.."
msgstr "[_alchemy_] Sobre mí y a mis deseos."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:632 #-#-# translate crowdin gallery_d_080_dd467d0f:
msgid "[_cedrick_] (Хм.. Звучит странно, кажется не таким должен был быть итоговый эффект от зелья. Либо я что-то путаю.. Нужно будет уточнить у Миранды)"
msgstr "[_cedrick_] (Hmm.. Suena extraño, parece que no debería haber sido el efecto final de la poción. O estoy confundiendo algo. Será necesario aclarar con Miranda)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:633 #-#-# translate crowdin gallery_d_080_d6ae344d:
msgid "[_alchemy_] Д-да, Седрик, продолжай... Я уже почти.. Почти.."
msgstr "[_alchemy_] S-sí, Cedric, sigue... Ya casi... casi..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:634 #-#-# translate crowdin gallery_d_080_160dfe84:
msgid "[_cedrick_] С-сейчас кончу в тебя.."
msgstr "[_cedrick_] Voy a terminar contigo ahora mismo."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:635 #-#-# translate crowdin gallery_d_080_d31b5275:
msgid "[_will_] А ну стоять!"
msgstr "[_will_] ¡Oh, bueno, ponte de pie!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:638 #-#-# translate crowdin gallery_d_080_9443def3:
msgid "[_alchemy_] Ч-что!?"
msgstr "[_alchemy_] ¿¡Qué!?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:639 #-#-# translate crowdin gallery_d_080_961fbd83:
msgid "[_cedrick_] Черт, нас кто-то застукал? Плохо дело.."
msgstr "[_cedrick_] Maldita sea, ¿nos ha atrapado alguien? Es malo."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:646 #-#-# translate crowdin gallery_d_080_f1ac7eab:
msgid "[_will_] Рик, какого черта тут происходит? Почему ты трахаешься с этой девчонкой в туалете?"
msgstr "[_will_] Rick, ¿qué diablos está pasando aquí? ¿Por qué estás jodiendo con esta chica en el baño?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:647 #-#-# translate crowdin gallery_d_080_3715bfa5:
msgid "[_cedrick_] Ну, я.. Эм.. Меня заставили"
msgstr "[_cedrick_] Bueno, Yo... Um. ¡Me obligaron"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:648 #-#-# translate crowdin gallery_d_080_25bda596:
msgid "[_alchemy_] Ох, да, это правда. Я его заставила"
msgstr "[_alchemy_] Oh, sí, eso es verdad. Yo lo forcé"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:652 #-#-# translate crowdin gallery_d_080_9fc56718:
msgid "[_will_] А тебя никто не спрашивал, рыжая потаскуха"
msgstr "[_will_] Y nadie te preguntó, zorra rojiza"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:653 #-#-# translate crowdin gallery_d_080_bfca6030:
msgid "[_alchemy_] Что, простите?!"
