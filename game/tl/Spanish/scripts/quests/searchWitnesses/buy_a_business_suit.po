# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:672 #-#-# translate crowdin gallery_d_080_ff963c24:
msgid "[_will_] Ааахх.. Ну же, Рик.. Д-давай..."
msgstr "[_will_] Aahh... Vamos, Rick... - Vamos..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:673 #-#-# translate crowdin gallery_d_080_4eb0869b:
msgid "[_will_] Мммв.. Давай.. Кончи в меня так, как собирался кончить в нее.."
