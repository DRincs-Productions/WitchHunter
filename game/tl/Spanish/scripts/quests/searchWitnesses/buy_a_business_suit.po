# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:957 #-#-# translate crowdin gallery_d_081_3a52bc2e:
msgid "[_irma_] Ааахх.. Жестче.. Ты стал еще жестче, Рик.."
