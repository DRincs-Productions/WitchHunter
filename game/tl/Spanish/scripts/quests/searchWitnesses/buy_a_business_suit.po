# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:715 #-#-# translate crowdin gallery_d_080_49316299_3:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:717 #-#-# translate crowdin gallery_d_080_b337e2e3:
msgid "[_alchemy_] Н-ну что, Седрик, тебе приятно?"
