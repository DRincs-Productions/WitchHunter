# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:617 #-#-# translate crowdin gallery_d_080_e413eb22:
msgid "[_alchemy_] Д-да.. Мммх.. Жестче! Трахай меня жестче!"
