# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:3 #-#-# translate crowdin buy_a_business_suit_cdeda416:
msgid "У меня сейчас не хватает денег на деловой костюм"
msgstr "No tengo suficiente dinero para un traje de negocios ahora mismo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:8 #-#-# translate crowdin buy_a_business_suit_397c72f0:
msgid "[_cedrick_] (Какого черта!? Самый дешевый костюм стоит 1000$? Что за обдираловка..)"
msgstr "[_cedrick_] (¿¡Qué demonios!? ¿El traje más barato cuesta $1000? ¡Qué robo...!)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:11 #-#-# translate crowdin buy_a_business_suit_adddbe49:
msgid "[_cedrick_] (Хм.. А вот неплохой галстук ценой всего 50$..)"
msgstr "[_cedrick_] (Hmm.. Pero no es un mal precio de lazo de solo $ 50.)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:14 #-#-# translate crowdin buy_a_business_suit_2ef90216:
msgid "[_cedrick_] (...)"
msgstr "[_cedrick_] (...)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:15 #-#-# translate crowdin buy_a_business_suit_6f46825b:
msgid "[_cedrick_] (В принципе, я и так достаточно презентабельно выгляжу. Думаю галстука должно хватить, чтобы придать официальности моему образу)"
msgstr "[_cedrick_] (En principio, me veo bastante presentable. Creo que la corbata debería ser suficiente para dar mi imagen oficial)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:20 #-#-# translate crowdin buy_a_business_suit_cf1ebb18:
msgid "[_centered_] {size=37}День суда{/size} [withDissolve1]"
msgstr "[_centered_] {size=37}Día del Juicio{/size} [withDissolve1]"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:28 #-#-# translate crowdin buy_a_business_suit_ecf3b4e4:
msgid "[_cedrick_] (Хах, кто бы мог подумать, что судить это дело возьмется сама Тереза Кук)"
msgstr "[_cedrick_] (Hah, ¿quién hubiera pensado que la propia cocina teresa intentaría este caso)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:29 #-#-# translate crowdin buy_a_business_suit_dc21c3b1:
msgid "[_cedrick_] (Это может сыграть мне на руку. Хотя, учитывая характер ее дочери, это также может вызвать массу проблем..)"
msgstr "[_cedrick_] (Puede jugar en mis manos. Aunque, dado el carácter de su hija, también puede causar muchos problemas.)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:33 #-#-# translate crowdin buy_a_business_suit_a6a5d120:
msgid "[_medina_] Ох, Рик.. Эм.. Во что ты одет?"
msgstr "[_medina_] Oh, Rick. Um. ¿Qué llevas puesto?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:34 #-#-# translate crowdin buy_a_business_suit_1f244944:
msgid "[_cedrick_] А что, не нравится? По моему хороший галстук.."
msgstr "[_cedrick_] ¿Qué te gusta? Soy una buena corbata..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:38 #-#-# translate crowdin buy_a_business_suit_1b99d2ba:
msgid "[_medina_] Ты должен был купить костюм, Рик, костюм!"
msgstr "[_medina_] ¡Tenías que comprarte un traje, Rick, disfraz!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:42 #-#-# translate crowdin buy_a_business_suit_b9951417:
msgid "[_medina_] Ты.. Ты теперь похож на правительственного агента-распиздяя. Знаешь, которые вечно ходят вокруг и говорят, что это мой первый день"
msgstr "[_medina_] Tú... Ahora pareces un agente que pega al gobierno. ¿Sabes quién siempre camina y dices que es mi primer día"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:43 #-#-# translate crowdin buy_a_business_suit_41e1c382:
msgid "[_cedrick_] (Ну, справедливости ради, это мой первый день, когда я хожу в галстуке..)"
msgstr "[_cedrick_] (Bueno, para ser justos, este es mi primer día cuando camino en una corbata.)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:44 #-#-# translate crowdin buy_a_business_suit_b4ed9cf2:
msgid "[_cedrick_] Чтобы купить костюм - его нужно примерить, а значит раздеться. Я не хотел привлекать лишнего внимания, учитывая все обстоятельства.."
msgstr "[_cedrick_] Para comprar un traje - necesita ser probado, y para que pueda desvestirse. No quería recibir demasiada atención, dadas todas las circunstancias."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:48 #-#-# translate crowdin buy_a_business_suit_d697504f:
msgid "[_medina_] Тоже верно.. Моя вина, нужно было помочь тебе с подбором костюма"
msgstr "[_medina_] también es cierto. Mi vino, tuve que ayudarte con la selección de un traje"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:52 #-#-# translate crowdin buy_a_business_suit_15f17c4c:
msgid "[_cedrick_] Может еще представится возможность"
msgstr "[_cedrick_] Puede ser posible"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:56 #-#-# translate crowdin buy_a_business_suit_17eeab59:
msgid "[_medina_] Хах.. Готов к сегодняшнему дню?"
msgstr "[_medina_] H. H.. ¿Preparado para hoy?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:57 #-#-# translate crowdin buy_a_business_suit_451613d6:
msgid "[_cedrick_] Честно говоря, все это уже начинает меня утомлять.."
msgstr "[_cedrick_] Honestamente, todo esto ya está empezando a aburrirse de Mí."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:58 #-#-# translate crowdin buy_a_business_suit_eeef970a:
msgid "[_medina_] Ну же, где твой боевой дух? Все практически в точности согласно моему плану"
msgstr "[_medina_] ¿Está, dónde está tu moral? Todo está casi exactamente de acuerdo a mi plan"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:62 #-#-# translate crowdin buy_a_business_suit_886861a5:
msgid "[_cedrick_] (Да неужели?)"
msgstr "[_cedrick_] (¿Es posible?)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:63 #-#-# translate crowdin buy_a_business_suit_240be006:
msgid "[_cedrick_] Кстати говоря, кто будет моим адвокатом? Ты сказала, что все устроишь, поэтому я не спрашивал до последнего, но все же.."
msgstr "[_cedrick_] Para cuando, ¿quién será mi abogado? Dijiste que lo harías, así que no pregunté hasta el último, pero aún así..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:67 #-#-# translate crowdin buy_a_business_suit_d8429d23:
msgid "[_medina_] Хах, у меня все схвачено, Рик. Я буду твоим адвокатом сегодня"
msgstr "[_medina_] Hah, estoy atrapado, Rick. Hoy seré tu abogado"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:68 #-#-# translate crowdin buy_a_business_suit_0d0288fc:
msgid "[_cedrick_] Ч-что!?"
msgstr "[_cedrick_] ¿¡Q-qué!?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:69 #-#-# translate crowdin buy_a_business_suit_701a6c43:
msgid "[_medina_] А ты не знал? По законодательству нашего штата детектив, участвующий в деле, может быть адвокатом одной из сторон"
msgstr "[_medina_] ¿No lo sabías? Bajo las leyes de nuestro estado, un detective involucrado en el caso puede ser un abogado de una de las partes"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:73 #-#-# translate crowdin buy_a_business_suit_12814d69:
msgid "[_medina_] Правда, только в случае должного образования и пятилетнего стажа в качестве адвоката"
msgstr "[_medina_] True, solo en el caso de una educación adecuada y cinco años de experiencia como abogado"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:77 #-#-# translate crowdin buy_a_business_suit_9f374ad5:
msgid "[_medina_] Хах, иначе у нас каждый второй детектив был бы адвокатом и в судебной системе настал бы бардак.."
msgstr "[_medina_] Hah, de lo contrario tenemos cada segundo detective que sería un abogado y en el sistema judicial sería un desastre."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:81 #-#-# translate crowdin buy_a_business_suit_0608bba4:
msgid "[_medina_] К твоему счастью, у меня как раз есть и образование, и необходимый стаж"
msgstr "[_medina_] Afortunadamente, solo tengo una educación y una experiencia necesaria"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:85 #-#-# translate crowdin buy_a_business_suit_6a668fd7:
msgid "[_cedrick_] Ты полна сюрпризов.. Как и ваша местная судебная система.."
msgstr "[_cedrick_] Estás lleno de sorpresas.. Como su sistema judicial local."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:89 #-#-# translate crowdin buy_a_business_suit_87ecc1ba:
msgid "[_medina_] Ох, еще у нас есть обязательные перерывы в туалет каждый час. Данную возможность ввели по принципу прецедентного права"
msgstr "[_medina_] Oh, también tenemos descansos obligatorios en el baño cada hora. Esta posibilidad se introdujo sobre el principio de jurisprudencia"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:93 #-#-# translate crowdin buy_a_business_suit_9a9c6849:
msgid "[_cedrick_] То есть ты хочешь сказать, что были прецеденты, когда кто-то в суде, кхм, не сдержался и справил нужду?"
msgstr "[_cedrick_] ¿Quieres decir que estás diciendo que había precedentes cuando alguien en la corte, uh, no podía resistir y aliviarlo?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:97 #-#-# translate crowdin buy_a_business_suit_a95fdfce:
msgid "[_medina_] И не раз.."
msgstr "[_medina_] Y más de una vez."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:98 #-#-# translate crowdin buy_a_business_suit_e248ad0e:
msgid "[_cedrick_] (Потрясающе. Человеческие суды нравятся мне все больше и больше..)"
msgstr "[_cedrick_] (Abundante. Cada vez me gustan más los tribunales humanos.)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:102 #-#-# translate crowdin buy_a_business_suit_15512410:
msgid "[_cedrick_] Хах, ну, если мой адвокат это ты, тогда мне не о чем беспокоиться"
msgstr "[_cedrick_] Hah, bueno, si mi abogado eres tú, entonces no tengo nada de qué preocuparme"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:106 #-#-# translate crowdin buy_a_business_suit_87fe5bc2:
msgid "[_medina_] Рик несмотря на то, что положение Мактиннена выглядит довольно печальным, все же не стоит расслабляться"
msgstr "[_medina_] Rick a pesar del hecho de que la posición de Maktinen parece bastante triste, todavía no se relaja"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:107 #-#-# translate crowdin buy_a_business_suit_baddcb1f:
msgid "[_medina_] У Мактиннена сторона защиты, а у нас сторона обвинения. Нам еще предстоит доказать его виновность"
msgstr "[_medina_] U Maktinen es una parte de defensa, y tenemos un enjuiciamiento. Aún tenemos que probar su culpabilidad"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:111 #-#-# translate crowdin buy_a_business_suit_98e7d034:
msgid "[_medina_] По сути сегодня все решат показания потерпевших. Их ведь тоже могут аннулировать или посчитать ложными"
msgstr "[_medina_] De hecho, hoy todo decidirá el testimonio de las víctimas. También pueden ser anulados o considerados falsos"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:112 #-#-# translate crowdin buy_a_business_suit_16ae4403:
msgid "[_cedrick_] (Да уж.. На Меридиане все решается куда проще. Тот, кто отдал Фобосу меньше золота, лишается головы. Тот, кто заплатил достаточно - оправдан)"
msgstr "[_cedrick_] (Sí. En Meridian, todo es mucho más fácil de decidir. El que le dio a Fobos menos oro se le priva de la cabeza. El que pagó lo suficiente es absuelto)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:116 #-#-# translate crowdin buy_a_business_suit_a24caeaf:
msgid "[_cedrick_] (Хотя, если у обеих сторон конфликта недостаточно денег, тогда все лишаются головы)"
msgstr "[_cedrick_] (Aunque si ambos lados del conflicto no tienen suficiente dinero, entonces todos pierden la cabeza)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:117 #-#-# translate crowdin buy_a_business_suit_0464f338:
msgid "[_cedrick_] (Наверное поэтому никто уже давно не обращался в наш суд..)"
msgstr "[_cedrick_] (Probablemente, nadie ha solicitado a nuestra corte durante mucho tiempo.)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:121 #-#-# translate crowdin buy_a_business_suit_064b5bbb:
msgid "[_medina_] Ну что, наше время заходить. Судья Кук уже подошла"
msgstr "[_medina_] Bueno, es hora de entrar. El juez de cocina ya ha llegado"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:126 #-#-# translate crowdin buy_a_business_suit_c0430a41:
msgid "[_centered_] {size=37}Окружной суд. Зал суда номер 2{/size} [withDissolve1]"
msgstr "[_centered_] {size=37}El Tribunal de Distrito. Sala de audiencias número 2{/size} [withDissolve1]"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:130 #-#-# translate crowdin buy_a_business_suit_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:135 #-#-# translate crowdin buy_a_business_suit_a20cefa7_1:
msgid "..."
msgstr "..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:136 #-#-# translate crowdin buy_a_business_suit_c70c4d5b:
msgid "[_theresa_] Заседание по делу о похищении объявляется открытым"
msgstr "[_theresa_] La audiencia de secuestro se declara abierta"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:139 #-#-# translate crowdin buy_a_business_suit_8f63191c:
msgid "[_medina_] Сторона обвинения готова, Ваша честь"
msgstr "[_medina_] La fiscalía está lista, su señoría"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:140 #-#-# translate crowdin buy_a_business_suit_46624d7f:
msgid "[_payne_] Сторона защиты готова, Ваша честь"
msgstr "[_payne_] Partido de protección listo, su señoría"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:141 #-#-# translate crowdin buy_a_business_suit_3217cfd3:
msgid "[_theresa_] Мисс Медина, пожалуйста, изложите суть дела"
msgstr "[_theresa_] Miss Medina, por favor indique el punto del caso"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:142 #-#-# translate crowdin buy_a_business_suit_0a2e202a:
msgid "[_medina_] Да, Ваша честь. Подсудимый Джоэль Мактиннен подозревается в похищении и удержании группы лиц"
msgstr "[_medina_] Sí, su señoría. Dive Joel Maktinen sospecha de secuestrar y retener a un grupo de personas"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:143 #-#-# translate crowdin buy_a_business_suit_4a07afa4:
msgid "[_medina_] Сторона обвинения располагает доказательствами того, что похищения совершил именно он"
msgstr "[_medina_] La fiscalía tiene pruebas de que cometió el secuestro"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:144 #-#-# translate crowdin buy_a_business_suit_b96df9ca:
msgid "[_medina_] Так же у нас есть показания со стороны потерпевших, подтверждающие действия насильственного характера со стороны Мистера Мактиннена"
msgstr "[_medina_] También tenemos testimonios de las víctimas, confirmando las acciones de carácter violento por parte del Sr. ¿Maktinen"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:145 #-#-# translate crowdin buy_a_business_suit_71ff95b0:
msgid "[_medina_] Сторона обвинения не видит причин сомневаться в фактах этого дела, Ваша честь"
msgstr "[_medina_] La fiscalía no ve ninguna razón para dudar de los hechos de este caso, su señoría"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:146 #-#-# translate crowdin buy_a_business_suit_da477e6d:
msgid "[_theresa_] Хорошо"
msgstr "[_theresa_] Es bueno"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:147 #-#-# translate crowdin buy_a_business_suit_84ea7885:
msgid "[_theresa_] Спасибо, Мисс Медина. Давайте же начнем"
msgstr "[_theresa_] Gracias, señorita Medina. Empecemos"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:148 #-#-# translate crowdin buy_a_business_suit_f91690ea:
msgid "[_medina_] Ваша честь, я бы хотела вызвать нашего первого свидетеля"
msgstr "[_medina_] Su Señoría, me gustaría llamar a nuestro primer testigo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:149 #-#-# translate crowdin buy_a_business_suit_19dae9fe:
msgid "[_medina_] Сторона обвинения вызывает первого пропавшего, учащегося Шеффилдской школы, Брайана"
msgstr "[_medina_] El partido llama al primer desaparecido estudiante de la escuela Sheffield, Brian"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:153 #-#-# translate crowdin buy_a_business_suit_09bedf33:
msgid "[_medina_] Свидетель, назовите нам свое имя и род занятий"
msgstr "[_medina_] Testigo, llámenos su nombre y ocupación"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:155 #-#-# translate crowdin buy_a_business_suit_2035787f:
msgid "[_brayan_] Мэм, меня зовут Брайан.. Эм.. Я школьник.. Просто школьник, учащийся в местной школе.."
msgstr "[_brayan_] Mamá, mi nombre es Brian... Um. Soy estudiante... Sólo un estudiante, un estudiante en una escuela local."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:157 #-#-# translate crowdin buy_a_business_suit_92aa0640:
msgid "[_medina_] Брайан, опишите вашу первую встречу с Мистером Мактинненом"
msgstr "[_medina_] Brian, describa su primer encuentro con el señor Maktinen."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:159 #-#-# translate crowdin buy_a_business_suit_2152b206:
msgid "[_brayan_] Ну, эм.. Это было в парке, посреди ночи.. Как давно это было, я уже и не помню.. Мактиннен просто напал на меня в парке посреди ночи"
msgstr "[_brayan_] Bueno, um... Estaba en el parque, en medio de la noche. Hace cuánto tiempo fue, no recuerdo. Maktinen me atacó en medio de la noche"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:161 #-#-# translate crowdin buy_a_business_suit_3e8cedb1:
msgid "[_brayan_] Этот монстр избил меня и связал.. После я уже ничего не помню"
msgstr "[_brayan_] Este monstruo me golpeó y me ató. Después de que no recuerdo nada"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:164 #-#-# translate crowdin buy_a_business_suit_43f6c74a:
msgid "[_theresa_] Хм.. Говорите, что Мистер Мактиннен похитил вас.. Что ж, Мистер Пэйн, вы можете начать перекрестный допрос"
msgstr "[_theresa_] Hmm.. Di que el señor. Maktinen te secuestró... Bien, Sr. Payne, puedes comenzar un interrogatorio"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:165 #-#-# translate crowdin buy_a_business_suit_4773e361:
msgid "[_payne_] Д-да, Ваша честь"
msgstr "[_payne_] D-da, su señoría"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:170 #-#-# translate crowdin buy_a_business_suit_72321de2:
msgid "[_brayan_] Эм.. Да я даже не знаю, что еще сказать.. Про парк сказал.. Про похищение сказал.. Все.."
msgstr "[_brayan_] Mm. Ni siquiera sé qué más decir. Dijo sobre el parque. Dijo sobre el secuestro... Todo..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:172 #-#-# translate crowdin buy_a_business_suit_d19146a8:
msgid "[_payne_] Мистер Брайан, вы утверждаете, что впервые встретились с подсудимым Мактинненом в парке, верно?"
msgstr "[_payne_] Sr. Brian, estás diciendo que te conociste la primera vez con el acusado Maktinen en el parque, ¿verdad?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:174 #-#-# translate crowdin buy_a_business_suit_1b364dcc:
msgid "[_brayan_] Верно.."
msgstr "[_brayan_] es cierto."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:175 #-#-# translate crowdin buy_a_business_suit_b6cb06d4:
msgid "[_payne_] Можете описать, в какое примерно время это было?"
msgstr "[_payne_] ¿Puedes describir qué hora fue?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:176 #-#-# translate crowdin buy_a_business_suit_293ebe1f:
msgid "[_brayan_] Ну, эм.. Была ночь.."
msgstr "[_brayan_] Bueno, um... Era una noche..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:178 #-#-# translate crowdin buy_a_business_suit_5073708d:
msgid "[_payne_] Исходя из записей, предоставленных полицейским участком, в то время, когда вас похитили, Мистер Мактиннен был на задании"
msgstr "[_payne_] Según los registros proporcionados por la estación de policía, mientras usted fue secuestrado, el Sr. Maktinen estaba en la misión"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:179 #-#-# translate crowdin buy_a_business_suit_16239c7e:
msgid "[_theresa_] Вы можете предоставить следствию необходимые бумаги?"
msgstr "[_theresa_] ¿Puede proporcionar la investigación los documentos necesarios?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:180 #-#-# translate crowdin buy_a_business_suit_42dc3a7f:
msgid "[_payne_] Да, ваша честь. Вот выписка из полицейского участка. Тогда Мактиннен задерживал двух грабителей магазина"
msgstr "[_payne_] Sí, su señoría. Aquí hay un extracto de la estación de policía. Maktinen detiene a dos comerciantes"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:181 #-#-# translate crowdin buy_a_business_suit_d9bf6966:
msgid "[_brayan_] Эмм.."
msgstr "[_brayan_] Em."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:182 #-#-# translate crowdin buy_a_business_suit_c31743e9:
msgid "[_medina_] (Черт, видимо Мактиннен подделал документы..)"
msgstr "[_medina_] (Maldito, aparentemente Maktinen falsificó documentos.)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:184 #-#-# translate crowdin buy_a_business_suit_abdad1d3:
msgid "[_brayan_] Слушайте, я помню блондина с длинными волосами и в плаще, который меня вырубил. После чего я оказался на складе Мактиннена. Это все"
msgstr "[_brayan_] Escucha, recuerdo a la rubia con el pelo largo y en la capa que me noqueó. Entonces estaba en el almacén de Maktinen. Eso es todo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:186 #-#-# translate crowdin buy_a_business_suit_8bad62ab:
msgid "[_payne_] То есть теперь вы утверждаете, что не видели лица мистера Мактиннена?"
msgstr "[_payne_] Así que ahora afirma que no ha visto al Sr. ¿La cara de Maktinen?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:187 #-#-# translate crowdin buy_a_business_suit_2958d589:
msgid "[_payne_] Исходя из вашего же описания, это мог быть Рик, снявший очки и надевший плащ"
msgstr "[_payne_] Según tu propia descripción, podría ser Rick, quien tomó las gafas y se puso una capa"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:189 #-#-# translate crowdin buy_a_business_suit_6927b94c:
msgid "[_brayan_] Эм.. Ну, я.."
msgstr "[_brayan_] Mm. Bueno, yo..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:190 #-#-# translate crowdin buy_a_business_suit_d05cfa5d:
msgid "[_medina_] Протестую, Ваша честь. Независимо от того, кем был нападавший на Мистера Брайана, как факт, в итоге он оказался на складе Миактиннена"
msgstr "[_medina_] está protestando, su señoría. No importa quién fuera el atacante, el Sr. Brian, de hecho, terminó en el almacén de miactinen"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:192 #-#-# translate crowdin buy_a_business_suit_a5974246:
msgid "[_medina_] Сам этот факт является неопровержимым доказательством его вины"
msgstr "[_medina_] El hecho mismo es una prueba irrefutable de su culpabilidad"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:193 #-#-# translate crowdin buy_a_business_suit_ded71a13:
msgid "[_theresa_] Сторона защиты утверждает, что Мактиннена подставили, используя несколько ячеек на складе, находящихся в его собственности"
msgstr "[_theresa_] El lado de la defensa afirma que Maktinen fue enmarcado usando varias celdas en el almacén propiedad de él"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:195 #-#-# translate crowdin buy_a_business_suit_2c8f694b:
msgid "[_theresa_] Личность нападавшего — это самое важное, что мы должны здесь установить, Мисс Медина"
msgstr "[_theresa_] La identidad del agresor es lo más importante que tenemos que instalar aquí, señorita Medina"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:196 #-#-# translate crowdin buy_a_business_suit_3014219f:
msgid "[_medina_] Да, ваша честь"
msgstr "[_medina_] Sí, su señoría"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:197 #-#-# translate crowdin buy_a_business_suit_0b3f9faa:
msgid "[_payne_] И так, Ваша честь, Мистер Брайан располагает только косвенными уликами, основанными на предположении"
msgstr "[_payne_] Y así, su señor honor, señor. Brian solo tiene evidencia indirecta basada en la suposición"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:199 #-#-# translate crowdin buy_a_business_suit_4748ed3e:
msgid "[_payne_] К тому же, судя по всему, Брайан впервые встречает мистера Мактиннена лицом к лицу"
msgstr "[_payne_] Además, al parecer, Brian por primera vez se encuentra con el Sr. Maktinen cara a cara"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:201 #-#-# translate crowdin buy_a_business_suit_785227d1:
msgid "[_payne_] Все указывает на то, что похитителем Брайана мог быть буквально кто угодно"
msgstr "[_payne_] Todo indica que el secuestrador de Brian podría ser literalmente cualquiera"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:202 #-#-# translate crowdin buy_a_business_suit_8081eccd:
msgid "[_theresa_] Полагаю, что это так"
msgstr "[_theresa_] Creo que esto es así"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:204 #-#-# translate crowdin buy_a_business_suit_e84728c7:
msgid "[_cedrick_] (Черт, наш первый свидетель просто никчемен.. Видимо в шахтах у него совсем мозги поплавились)"
msgstr "[_cedrick_] (Maldito, nuestro primer testigo es inútil. Aparentemente, sus cerebros se derritieron en las minas)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:205 #-#-# translate crowdin buy_a_business_suit_c2269da3:
msgid "[_payne_] Сторона защиты желает вызвать на допрос Мисс Элион Браун"
msgstr "[_payne_] El partido de defensa quiere llamar a la pregunta señorita Elyon marrón"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:206 #-#-# translate crowdin buy_a_business_suit_a8199a84:
msgid "[_theresa_] Хорошо. Вызовите Элион Браун в качестве свидетеля"
msgstr "[_theresa_] es bueno. Llama a Elyon Brown como testigo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:210 #-#-# translate crowdin buy_a_business_suit_7b705432:
msgid "[_cedrick_] (Как и думал, они приплели сюда Элион, чтобы узнать, что я делал в то же время. Благо, я к этому подготовился)"
msgstr "[_cedrick_] (Como se pensaba que estaban tejidas aquí por Elyon para averiguar lo que estaba haciendo al mismo tiempo. Gracias, me he preparado para esto)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:212 #-#-# translate crowdin buy_a_business_suit_b712be06:
msgid "[_elion_] З-здравствуйте. Я Элион Брайан, учащаяся школы и работница в книжной лавке Мистера Рика"
msgstr "[_elion_] H-hola. Soy Elyon Brian, estudiante y empleada de la librería del señor Rick."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:214 #-#-# translate crowdin buy_a_business_suit_c9bb2401:
msgid "[_theresa_] Сторона защиты может начать перекрестный допрос"
msgstr "[_theresa_] El lado de la defensa puede comenzar a ser interrogado"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:215 #-#-# translate crowdin buy_a_business_suit_b6f841d5:
msgid "[_payne_] Хорошо, Мэм"
msgstr "[_payne_] Bien, señora"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:216 #-#-# translate crowdin buy_a_business_suit_3d8b28c6:
msgid "[_payne_] Вы можете сказать, что в то же время делал Мистер Рик?"
msgstr "[_payne_] Puede decirle lo que el Sr. ¿Rick lo hizo al mismo tiempo?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:218 #-#-# translate crowdin buy_a_business_suit_1e0d8934:
msgid "[_elion_] Да, конечно. В то время Рик планировал устроиться учителем истории в нашу школу и усердно готовился к собеседованию"
msgstr "[_elion_] Sí, por supuesto. En ese momento, Rick planeó conseguir un profesor de historia en nuestra escuela y se preparó con entusiasmo para la entrevista"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:220 #-#-# translate crowdin buy_a_business_suit_9b5b3dcf:
msgid "[_elion_] На сколько я помню, все свободное от работы время он уделял книгам и конспектам. А ближе к вечеру он всегда отправлялся ко сну в одно и то же время"
msgstr "[_elion_] Durante el tiempo que recuerdo, todo mi tiempo libre dedicó a los libros y notas. Y más cerca de la noche, siempre se iba a la cama al mismo tiempo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:222 #-#-# translate crowdin buy_a_business_suit_bd93caad:
msgid "[_payne_] Вы можете подтвердить или опровергнуть тот факт, что в ночь пропажи Брайана Рик ночью был у себя в магазине?"
msgstr "[_payne_] ¿Puede confirmar o negar el hecho de que la noche de la desaparición de Brian Rick estaba en su tienda?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:224 #-#-# translate crowdin buy_a_business_suit_6a2400aa:
msgid "[_elion_] Эм.. Д-да, я могу.. Кажется, в тот вечер я забыла свой телефон и вернулась за ним в магазин. Рик еще не спал, но был в магазине"
msgstr "[_elion_] Mm. Sí, puedo hacerlo. Creo que olvidé mi teléfono esa noche y volví a la tienda. Rick no ha dormido todavía, pero estaba en la tienda"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:226 #-#-# translate crowdin buy_a_business_suit_7159cb64:
msgid "[_cedrick_] (Отлично. Пусть и ложные, но это показания в мою пользу. Элион молодец)"
msgstr "[_cedrick_] (Excelente. Aunque sea falso, pero está a mi favor. Elyon bien hecho)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:228 #-#-# translate crowdin buy_a_business_suit_6e2e570e:
msgid "[_payne_] Вы можете точно сказать, чем занимался Мистер Рик в магазине?"
msgstr "[_payne_] Puede decir exactamente lo que el Sr. ¿Rick lo hizo en la tienda?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:230 #-#-# translate crowdin buy_a_business_suit_37b64ea0:
msgid "[_elion_] Эм, да, он.. Он листал местные журналы с картинками. Думаю это помогало ему, кхм, расслабиться перед сном"
msgstr "[_elion_] Mm, sí, él... Coqueteó revistas locales con fotos. Creo que le ayudó, km, relajarse antes de ir a la cama"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:231 #-#-# translate crowdin buy_a_business_suit_91868ca5:
msgid "[_cedrick_] (А вот эта ремарка была лишней..)"
msgstr "[_cedrick_] (Esta observación fue superflua.)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:233 #-#-# translate crowdin buy_a_business_suit_805121b0:
msgid "[_payne_] У стороны защиты больше нет вопросов"
msgstr "[_payne_] La defensa ya no tiene preguntas"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:234 #-#-# translate crowdin buy_a_business_suit_04b381af:
msgid "[_medina_] Думаю теперь очевидно, что в день пропажи Брайана Рик не мог его похитить, исходя из показаний Мисс Элион"
msgstr "[_medina_] Creo que ahora es obvio que el día de la desaparición de Brian Rick no pudo secuestrarlo en base al testimonio de la señorita Elyon"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:235 #-#-# translate crowdin buy_a_business_suit_69a987ed:
msgid "[_theresa_] Да, все верно"
msgstr "[_theresa_]Y Sí, así es"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:237 #-#-# translate crowdin buy_a_business_suit_2f9620d9:
msgid "[_cedrick_] (Отлично. Брайан облажался, но Элион меня прикрыла)"
msgstr "[_cedrick_] (Excelente. Brian la cagó, pero Elyon me cerró."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:238 #-#-# translate crowdin buy_a_business_suit_632ad564:
msgid "[_theresa_] Суд прерывается на запланированный перерыв, предусмотренный законодательством штата. Пока можете разойтись"
msgstr "[_theresa_] El tribunal es interrumpido por una ruptura programada prevista por la ley estatal. Mientras puedas dispersarte"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:240 #-#-# translate crowdin buy_a_business_suit_2617aaa4:
msgid "[_centered_] {size=37}В УБОРНОЙ{/size} [withDissolve1]"
msgstr "[_centered_] {size=37}EN LA FECHA LÍMITE{/size} [withDissolve1]"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:244 #-#-# translate crowdin gallery_d_076_9b16b258:
msgid "[_cedrick_] (Чертов Брайан.. Этому говнюку лучше не попадаться мне на глаза. Если из-за его вялых показаний меня в итоге признают виновным..)"
msgstr "[_cedrick_] (Maldito Brian.) Es mejor no coger esta mierda. Si debido a su lento testimonio, finalmente fui declarado culpable.)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:245 #-#-# translate crowdin gallery_d_076_c15b94be:
msgid "[_cedrick_] (Хм? Что это за шум там?.. Похоже на..)"
msgstr "[_cedrick_] (¿Hmm? ¿Qué es este ruido allí? Parece que...)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:247 #-#-# translate crowdin gallery_d_076_2a890b45:
msgid "[_unknown_girl_] Ааххх.. Ууухх.."
msgstr "[_unknown_girl_] Aahhh... ¿Por qué..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:248 #-#-# translate crowdin gallery_d_076_9f5b06be:
msgid "[_cedrick_] (Ага, женские стоны, как я и думал..)"
msgstr "[_cedrick_] (Ajá, gemidos de mujer, justo como pensaba...)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:249 #-#-# translate crowdin gallery_d_076_fa1e33f7:
msgid "[_unknown_man_] Эй, будь потише. Нас могут услышать"
msgstr "[_unknown_man_] Oye, quédate callado. Podemos ser escuchados"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:250 #-#-# translate crowdin gallery_d_076_1fd243a5:
msgid "[_unknown_girl_] Ахх.. Х-хорошо.."
msgstr "[_unknown_girl_] Ahh... Es bueno..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:252 #-#-# translate crowdin gallery_d_076_e298d60f:
msgid "[_unknown_man_] Ч-чего.. Телефон звонит, в такой-то момент.."
msgstr "[_unknown_man_] El teléfono está sonando, en ese momento."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:253 #-#-# translate crowdin gallery_d_076_d80ff2b1:
msgid "[_cedrick_] (Черт, ладно.. Я должен это увидеть.. Вдруг эта информация пригодится мне в дальнейшем)"
msgstr "[_cedrick_] (Maldita sea, está bien. Tengo que verlo. De repente esta información me será útil en el futuro)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:258 #-#-# translate crowdin gallery_d_076_665d79dd:
msgid "[_unknown_man_] Да, босс, я все уладил, не беспокойтесь. Об этом никто не узнает"
msgstr "[_unknown_man_] Sí, jefe, lo he arreglado todo, no se preocupe. Nadie lo sabrá"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:259 #-#-# translate crowdin gallery_d_076_f0fbfa0e:
msgid "[_unknown_girl_] Ааавв.."
msgstr "[_unknown_girl_] Aav."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:260 #-#-# translate crowdin gallery_d_076_dd8ceb9d:
msgid "[_unknown_man_] Ваша дочь теперь в полном порядке, полицейские не стали ее доправшивать. Это было всего лишь мелкое хулиганство"
msgstr "[_unknown_man_] Su hija está ahora en perfecto orden, la policía no lo arregló. Era sólo un pequeño vandalismo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:261 #-#-# translate crowdin gallery_d_076_56d22679:
msgid "[_unknown_girl_] Ооххх.. Аааххх.."
msgstr "[_unknown_girl_] Oooh... Aaaah..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:262 #-#-# translate crowdin gallery_d_076_878f57c4:
msgid "[_unknown_man_] Что? А, звуки? Я сейчас в туалете местного суда. Как раз зашел оплатить штраф за вашу дочь"
msgstr "[_unknown_man_] ¿Qué? Ah, ¿los ruidos? Ahora mismo estoy en el baño del tribunal local. Vine a pagar la multa de su hija."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:263 #-#-# translate crowdin gallery_d_076_51c50a84:
msgid "[_unknown_man_] Не знаю, видимо это шум из соседней кабинки. Всякое бывает, сами понимаете"
msgstr "[_unknown_man_] No sé, aparentemente es un ruido de la siguiente cabina. Todo pasa, ¿sabes"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:264 #-#-# translate crowdin gallery_d_076_d83afd23:
msgid "[_unknown_girl_] Ммммвв.."
msgstr "[_unknown_girl_] Mmm.."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:265 #-#-# translate crowdin gallery_d_076_e1df0167:
msgid "[_unknown_man_] Да.. Да, сэр, всегда рад помочь. Если вдруг что-то подобное случится в следующий раз - смело обращайтесь за помощью ко мне"
msgstr "[_unknown_man_] Sí.. Sí, señor, siempre feliz de ayudar. Si algo como esto sucede la próxima vez, no dude en ponerse en contacto conmigo para obtener ayuda"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:266 #-#-# translate crowdin gallery_d_076_36227f0c:
msgid "[_unknown_man_] Я всегда буду рад помочь вашей семье и в особенности вашей дочьке. Ведь я верю, что несмотря подобные провинности, у нее большое будущее"
msgstr "[_unknown_man_] Siempre estaré encantado de ayudar a su familia y especialmente a su hija. Después de todo, creo que a pesar de tales muelles, ella tiene un gran futuro"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:267 #-#-# translate crowdin gallery_d_076_8d7e8aa4:
msgid "[_unknown_man_] А подростки есть подростки, не держите на нее.. Уухх.. Большого зла"
msgstr "[_unknown_man_] Y los adolescentes son adolescentes, no la aferren. Uh... Gran tristeza"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:268 #-#-# translate crowdin gallery_d_076_99281262:
msgid "[_unknown_man_] Ну все, сэр, еще созвонимся. Я тут близок к завершению, если вы понимаете, о чем я"
msgstr "[_unknown_man_] Bueno, señor, llamemos de nuevo. Estoy cerca del final, si sabes lo que quiero decir"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:269 #-#-# translate crowdin gallery_d_076_0b095247:
msgid "[_unknown_man_] Да.. Да. Все, на связи. Всего хорошего, сэр!"
msgstr "[_unknown_man_] Sí.. Sí. Muy bien, en contacto. ¡Buena suerte, señor!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:270 #-#-# translate crowdin gallery_d_076_98223e2e:
msgid "[_unknown_girl_] Аааххх.. ААавв..."
msgstr "[_unknown_girl_] Aahhh... Aavv..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:271 #-#-# translate crowdin gallery_d_076_d067346e:
msgid "[_unknown_man_] Ну что за дрянная девчонка.. Мы вообще-то в общественном месте, к тому же я говорю по телефону с твоим отцом. А ты даже не пытаешься сдерживаться.."
msgstr "[_unknown_man_] Bueno, qué chica tan mierda... En realidad estamos en un lugar público, y estoy hablando por teléfono con tu padre. Y ni siquiera tratas de contenerte..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:272 #-#-# translate crowdin gallery_d_076_537a525c:
msgid "[_unknown_man_] Хотела, чтобы он тебя услышал, да, долбаная ты извращенка?"
msgstr "[_unknown_man_] Quería que te escuchara, ¿te jodió pervertido?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:273 #-#-# translate crowdin gallery_d_076_11ceca92:
msgid "[_unknown_girl_] Аааввв.. Ооохх.. П-простите, сэр.."
msgstr "[_unknown_girl_] Aaav... Oh, oh... Lo siento, señor..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:274 #-#-# translate crowdin gallery_d_076_a656a039:
msgid "[_unknown_man_] Да ты еще и мазохистка, черт.. у нынешнего поколения нет никакого чувства меры.."
msgstr "[_unknown_man_] También eres masoquista, maldita sea. La generación actual no tiene sentido de la acción."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:275 #-#-# translate crowdin gallery_d_076_20759d6b:
msgid "[_unknown_girl_] Ааахх.. Оооввв... Х-хорошоо.."
msgstr "[_unknown_girl_] Aahh... Oviv... Es bueno."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:276 #-#-# translate crowdin gallery_d_076_c6b59e7a:
msgid "[_unknown_man_] Ну прикарманила ты пару вещей в продуктовом.. Ну украла ты одежду из магазина.. Но в ювелирку-то зачем надо было лезть, а?"
msgstr "[_unknown_man_] Bueno, te embolsaste un par de cosas en el supermercado... Le robaste la ropa a la tienda. Pero en la joyería por qué tenías que ir, ¿eh?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:277 #-#-# translate crowdin gallery_d_076_39b1b8fb:
msgid "[_unknown_girl_] ММммм..."
msgstr "[_unknown_girl_] Mmmm..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:278 #-#-# translate crowdin gallery_d_076_202e20fd:
msgid "[_unknown_man_] Еще и охраннику магазина лицо исцарапала, когда он тебя задерживал. Ну что за манеры.."
msgstr "[_unknown_man_] También al guardia de la tienda rascó la cara cuando te detuvo. ¿Qué tipo de modales..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:279 #-#-# translate crowdin gallery_d_076_db572d92:
msgid "[_unknown_man_] Мне пришлось немало заплатить полиции, чтобы они закрыли на все глаза. И даже так, пришлось тащиться в суд.."
msgstr "[_unknown_man_] Tuve que pagar mucho a la policía para cerrar los ojos. Y aun así, tuve que ir a la corte."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:280 #-#-# translate crowdin gallery_d_076_447731dc:
msgid "[_unknown_man_] Ведь даже за ту кругленькую сумму они смогли все опустить до уровня мелкого хулиганства. Черт, и почему я должен с тобой носиться, а?"
msgstr "[_unknown_man_] Después de todo, incluso por esa suma ordenada, fueron capaces de reducir todo al nivel del vandalismo mezquino. Maldita sea, ¿por qué debería correr contigo?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:281 #-#-# translate crowdin gallery_d_076_54d6009d:
msgid "[_unknown_girl_] Аааахх.. П-потому что за то, что вы меня прикрываете, я позволяю... Ааахх.. Позволяю вам делать со мной всякие грязные вещи"
msgstr "[_unknown_girl_] Aahh... Porque por estar cubierto, me estoy dejando... Aahh... Permitiéndote hacer todas las cosas sucias conmigo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:282 #-#-# translate crowdin gallery_d_076_ad381c26:
msgid "[_unknown_man_] Черт, и то верно, не поспоришь. А может ты все это делаешь специально, чтобы твой папаша в очередной раз вызвал меня для разбирательства?"
msgstr "[_unknown_man_] Maldita sea, y así es, no se puede discutir. ¿O tal vez estás haciendo todo esto a propósito a tu padre una vez más llámame para el juicio?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:283 #-#-# translate crowdin gallery_d_076_5b7b947c:
msgid "[_unknown_girl_] Ммммвв..."
msgstr "[_unknown_girl_] Mmmv..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:284 #-#-# translate crowdin gallery_d_076_8ebf782d:
msgid "[_unknown_man_] Отвечай, извращенка"
msgstr "[_unknown_man_] Responder, pervertido"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:285 #-#-# translate crowdin gallery_d_076_ac50f554:
msgid "[_unknown_girl_] Яя.. Ааааххх.. Я сейчас кончу.. Совсем скоро..."
msgstr "[_unknown_girl_] Y-yo... Aaaah... Me voy a correr... Muy pronto..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:286 #-#-# translate crowdin gallery_d_076_808ab48f:
msgid "[_unknown_man_] Уф, отлично, продолжая елозить бедрами на моем члене, я тоже уже почти все.."
msgstr "[_unknown_man_] Uv, genial, seguir subiendo mis caderas en mi pene, estoy casi todo."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:287 #-#-# translate crowdin gallery_d_076_e6f3fc41:
msgid "[_unknown_girl_] Мммммввв..."
msgstr "[_unknown_girl_] Mmmvv..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:288 #-#-# translate crowdin gallery_d_076_1bc41b98:
msgid "[_elion_] Ох, Рик, ты тоже здесь!?"
msgstr "[_elion_] Oh, Rick, ¿también estás aquí?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:290 #-#-# translate crowdin gallery_d_076_0d0288fc:
msgid "[_cedrick_] Ч-что!?"
msgstr "[_cedrick_] ¿¡Q-qué!?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:297 #-#-# translate crowdin gallery_d_076_3c9d6979:
msgid "[_elion_] Р-рик, ты что, подг.."
msgstr "[_elion_] R-rh, ¿qué, por...?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:298 #-#-# translate crowdin gallery_d_076_28024cf7:
msgid "[_cedrick_] Н-нет! Это совсем не то, о чем ты подумала. Я просто.. Просто жду, пока кабинка освободится.."
msgstr "[_cedrick_] ¡N-No! No es para nada lo que has estado pensando. Solo estoy... Estoy esperando a que la cabina se libere..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:301 #-#-# translate crowdin gallery_d_076_9de0434d:
msgid "[_elion_] Но соседняя же свободна.."
msgstr "[_elion_] Pero el siguiente es gratis.."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:302 #-#-# translate crowdin gallery_d_076_1aefb21e:
msgid "[_cedrick_] Ч-черт, какой же я невнимательный, ахахах.. Видимо совсем мозги набекрень из-за этого суда.."
msgstr "[_cedrick_] Ch-h-h-h-kh-h-h-wh, lo desatento que soy, ahah. Aparentemente, los cerebros están en las bombillas debido a este ensayo."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:305 #-#-# translate crowdin gallery_d_076_89f679c3:
msgid "[_elion_] Мв.. П-понимаю.."
msgstr "[_elion_] Mw. Lo entiendo."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:307 #-#-# translate crowdin gallery_d_076_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:308 #-#-# translate crowdin gallery_d_076_1493464c:
msgid "[_cedrick_] (А ведь точно.. Она не видела Брайана с тех самых пор, как..)"
msgstr "[_cedrick_] (Pero seguro. No ha visto a Brian desde que estaba...)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:309 #-#-# translate crowdin gallery_d_076_ce17610b:
msgid "[_cedrick_] Как ты? Думаю, после встречи с Брайаном.."
msgstr "[_cedrick_] ¿Cómo estás? Creo que después de conocer a Brian..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:312 #-#-# translate crowdin gallery_d_076_0423a5e5:
msgid "[_elion_] Это на самом деле уже не важно. Странно, но теперь я совсем ничего не чувствую, глядя на него"
msgstr "[_elion_] En realidad no importa. Extraño, pero ahora no siento nada en absoluto mirándolo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:315 #-#-# translate crowdin gallery_d_076_4abf1ece:
msgid "[_elion_] Раньше он мне так нравился, но теперь для меня он просто запутавшийся мальчишка"
msgstr "[_elion_] Me gustaba mucho, pero ahora para mí es solo un chico enredado"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:318 #-#-# translate crowdin gallery_d_076_943be0ef:
msgid "[_elion_] Мне жаль, что что-то подобное с ним произошло, но не более"
msgstr "[_elion_] Siento que algo así le haya pasado, pero no más"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:321 #-#-# translate crowdin gallery_d_076_6e3c50d3:
msgid "[_elion_] Наверное, прозвучит ужасно, но если бы ничего этого не произошло, то я так и продолжила бы с ним встречаться.."
msgstr "[_elion_] probablemente sonará terrible, pero si nada de esto sucediera, seguiría conociéndolo."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:322 #-#-# translate crowdin gallery_d_076_047930a4:
msgid "[_elion_] И смотря на все с такой стороны, в какой-то степени я даже рада тому, что произошло.."
msgstr "[_elion_] Y, viéndolo desde ese punto de vista, hasta cierto punto me alegra lo que pasó..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:325 #-#-# translate crowdin gallery_d_076_bb42f76d:
msgid "[_elion_] Брайан сейчас совсем не тот человек, за которого я беспокоюсь в этом суде, Рик"
msgstr "[_elion_] Brian no es la persona que me preocupa esta corte, Rick"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:326 #-#-# translate crowdin gallery_d_076_d3923cfe:
msgid "[_cedrick_] (Воу, звучало.. Довольно жестоко по отношению к Брайану.. Мне теперь его даже немного жаль)"
msgstr "[_cedrick_] (Wow, sonaba.. Muy cruel con Brian. Incluso lo siento por él ahora)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:329 #-#-# translate crowdin gallery_d_076_4851e488:
msgid "[_cedrick_] (Хах, и все же есть у нее с Фобосом что-то неуловимо общее. В такие моменты оно проявляется)"
msgstr "[_cedrick_] (Hah, y sin embargo tiene algo esquivo en común con Fobos. En momentos como este, se manifiesta)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:334 #-#-# translate crowdin gallery_d_077_4bd956c3:
msgid "[_cedrick_] Ох, кстати, Элион. Прости, что тебе приходится лгать в суде, я прос.."
msgstr "[_cedrick_] Oh, por cierto, Elyon. Perdona que tengas que mentir ante el tribunal, yo solo..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:337 #-#-# translate crowdin gallery_d_077_545eb366:
msgid "[_elion_] Я уверена, что ты ничего этого не делал, Рик. Порой факты не на стороне хороших людей, я это знаю"
msgstr "[_elion_] Estoy seguro de que no hiciste nada de esto, Rick. A veces los hechos no están del lado de la gente buena, lo sé"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:340 #-#-# translate crowdin gallery_d_077_d335cb3b:
msgid "[_elion_] Поэтому я просто делаю все, чтобы тебя оправдали.. Я не хочу, чтобы тебя посадили, ведь ты мой самый близкий человек.."
msgstr "[_elion_] Así que estoy haciendo todo lo posible para que te absuelvas. No quiero que te encarcelen, porque eres mi hombre más cercano."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:341 #-#-# translate crowdin gallery_d_077_3aeebb77:
msgid "[_cedrick_] Элион.."
msgstr "[_cedrick_] Elyon..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:344 #-#-# translate crowdin gallery_d_077_9b555502:
msgid "[_elion_] С-слушай, Рик.. Весь этот стресс из-за суда.. Я видела, какой ты стал напряженный, когда Брайана допрашивали"
msgstr "[_elion_] E-escucha, Rick... Todo este estrés por el juicio... Vi lo tenso que te pusiste cuando interrogaron a Brian."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:345 #-#-# translate crowdin gallery_d_077_c989c199:
msgid "[_cedrick_] Хах, ну, я.. На самом деле да, меня довольно сильно напрягло то, как он не смог внятно объяснить произошедшее"
msgstr "[_cedrick_] Hah, bueno, yo... De hecho, sí, estaba bastante tenso por la forma en que no podía explicar claramente lo que sucedió"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:346 #-#-# translate crowdin gallery_d_077_d8f27d53:
msgid "[_cedrick_] Он первый свидетель, а его показания уже по факту не действительны.."
msgstr "[_cedrick_] Él es el primer testigo, y su testimonio ya no es válido."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:348 #-#-# translate crowdin gallery_d_077_b087a98e:
msgid "[_elion_] Не переживай, Рик.. Все будет хорошо.. Не хочешь, эм.. Не хочешь, чтобы я помогла тебе расслабиться?"
msgstr "[_elion_] No te preocupes, Rick... Estará bien. No quieres, um. ¿No quieres que te ayude a relajarte?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:351 #-#-# translate crowdin gallery_d_077_5a835a40:
msgid "[_elion_] Ну.. Пока есть время до начала слушания.."
msgstr "[_elion_] Bueno... Mientras haya un tiempo antes de la audiencia..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:352 #-#-# translate crowdin gallery_d_077_91bf7ff4:
msgid "[_cedrick_] Ты имеешь ввиду то, о чем я подумал?"
msgstr "[_cedrick_] ¿Estás pensando en lo que yo pensaba?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:355 #-#-# translate crowdin gallery_d_077_39743f4d:
msgid "[_elion_] Пойдем в соседнюю кабинку.."
msgstr "[_elion_] Vayamos a la siguiente cabaña.."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:360 #-#-# translate crowdin gallery_d_077_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:364 #-#-# translate crowdin gallery_d_077_82b9e4f5:
msgid "[_cedrick_] Ммм, да, Элион, вот так, отлично.."
msgstr "[_cedrick_] Mmm, sí, Elyon, claro, eso es todo, genial.."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:365 #-#-# translate crowdin gallery_d_077_7e8c01af:
msgid "[_elion_] Т-тебе нравится, Рик?"
msgstr "[_elion_] ¿Te gusta, Rick?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:366 #-#-# translate crowdin gallery_d_077_03b973e7:
msgid "[_cedrick_] Твои бедра просто потрясающие.."
msgstr "[_cedrick_] Tus caderas son increíbles.."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:367 #-#-# translate crowdin gallery_d_077_aef1df69:
msgid "[_elion_] Хах, с-спасибо.."
msgstr "[_elion_] Hah, gracias."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:368 #-#-# translate crowdin gallery_d_077_5a585127:
msgid "[_cedrick_] Д-да, это явно то, что мне было нужно.. Ууух"
msgstr "[_cedrick_] S-sí, esto es justo lo que necesitaba... Uuuh..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:369 #-#-# translate crowdin gallery_d_077_600d0911:
msgid "[_elion_] П-продолжай.. Мне нравится чувствовать, как твой твердый член упирается в меня сзади"
msgstr "[_elion_] Sigue adelante. Me gusta sentir que tu verga dura descansa sobre mí por detrás"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:370 #-#-# translate crowdin gallery_d_077_ae25a8d2:
msgid "[_cedrick_] О да.. Элион, несмотря на твою кажущуюся зажатость, ты стала куда более уверена в себе.."
msgstr "[_cedrick_] Oh sí. Elyon, a pesar de tu aparente concha, tienes mucha más confianza en ti mismo."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:371 #-#-# translate crowdin gallery_d_077_2c286a6f:
msgid "[_cedrick_] Смотри ка.. Сама предложила подрочить мне, да еще и в общественном месте, во время суда.."
msgstr "[_cedrick_] Ver... Se ofreció a fusionarme, e incluso en un lugar público, durante el juicio."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:372 #-#-# translate crowdin gallery_d_077_92a4d36e:
msgid "[_elion_] Я, эм.. На самом деле это все так непристойно.. И так возбуждающе.."
msgstr "[_elion_] Yo, um... Es realmente tan obsceno... Y tan emocionante..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:373 #-#-# translate crowdin gallery_d_077_84480440:
msgid "[_elion_] К-к тому же, я правда хочу тебе помочь, Рик.. Это очень важно для меня.."
msgstr "[_elion_] A-además, de verdad quiero ayudarte, Rick... Esto es muy importante para mí..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:374 #-#-# translate crowdin gallery_d_077_ac9d8599:
msgid "[_cedrick_] Элион, ты просто умница.. Ууууфф.."
msgstr "[_cedrick_] Elyon, eres inteligente. Wowuff..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:375 #-#-# translate crowdin gallery_d_077_d244915e:
msgid "[_elion_] Д-да, Рик.. Двигайся быстрее, ну же.. Мне нравится, когда ты меня хвалишь"
msgstr "[_elion_] Sí, Rick. Muévete más rápido, vamos. Me gusta cuando me elogias"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:376 #-#-# translate crowdin gallery_d_077_201e367c:
msgid "[_cedrick_] Хах.. Маленькая распутная девчонка.."
msgstr "[_cedrick_] H. H.. Una niña zorra."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:377 #-#-# translate crowdin gallery_d_077_c2e4b6db:
msgid "[_elion_] Д-да.. Ммм..."
msgstr "[_elion_] D-Da... Mm..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:378 #-#-# translate crowdin gallery_d_077_a9580126:
msgid "[_cedrick_] Элион, я уже близко.."
msgstr "[_cedrick_] Elyon, estoy cerca."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:379 #-#-# translate crowdin gallery_d_077_56bd4dd5:
msgid "[_elion_] Давай, Рик, кончи на меня.."
msgstr "[_elion_] Vamos, Rick, he terminado."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:385 #-#-# translate crowdin gallery_d_077_03d97117:
msgid "[_cedrick_] Уууууух!!"
msgstr "[_cedrick_] Uuuhuh!!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:387 #-#-# translate crowdin gallery_d_077_88863f2e:
msgid "[_elion_] Хорошо, что меня уже не вызовут в качестве свидетеля.. А то вся моя одежда в сперме.."
msgstr "[_elion_] Es bueno que no me llamen como testigo. Toda mi ropa en mi esperma."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:388 #-#-# translate crowdin gallery_d_077_0054027a:
msgid "[_cedrick_] Хах, ну уж прости"
msgstr "[_cedrick_] Hach, lo siento"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:389 #-#-# translate crowdin gallery_d_077_989ca4b2:
msgid "[_elion_] Ничего, Рик.."
msgstr "[_elion_] No es nada, Rick."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:390 #-#-# translate crowdin gallery_d_077_067f9b34:
msgid "[_elion_] Надеюсь ты выиграешь этот суд"
msgstr "[_elion_] Espero que gane esta cancha"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:391 #-#-# translate crowdin gallery_d_077_2e911069:
msgid "[_cedrick_] Будем надеяться, Элион. Сделаю для этого все возможное"
msgstr "[_cedrick_] Esperemos, Elyon. Voy a hacer todo lo posible por esto"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:395 #-#-# translate crowdin gallery_d_077_61d714aa:
msgid "[_centered_] {size=37}Запланированный перерыв окончен. Заседание продолжается{/size} [withDissolve1]"
msgstr "[_centered_] {size=37} El descanso programado ha terminado. La reunión continúa {/size} [withDissolve1]"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:399 #-#-# translate crowdin gallery_d_077_556341c1:
msgid "[_medina_] В качестве следующего свидетеля сторона обвинения вызывает Алхими"
msgstr "[_medina_] Como el próximo testigo, la fiscalía es citada por Alchemy"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:401 #-#-# translate crowdin gallery_d_077_8cb3591c:
msgid "[_theresa_] Потерпевшая, представьтесь"
msgstr "[_theresa_] La víctima, preséntate"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:403 #-#-# translate crowdin gallery_d_077_70a6202e:
msgid "[_alchemy_] Я Алхими.. Учащаяся школы Шеффилда.. В свободное время занимаюсь спортом.. Эм, вернее занималась.."
msgstr "[_alchemy_] Soy Alchemy... Un estudiante de la escuela Sheffield... En mi tiempo libre hago deporte. Um, prefiero hacerlo..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:405 #-#-# translate crowdin gallery_d_077_42a83fb3:
msgid "[_medina_] Мисс Алхими, можете описать суду день своего похищения?"
msgstr "[_medina_] La señorita Alchemy, ¿puede describir el día de su secuestro a la corte?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:407 #-#-# translate crowdin gallery_d_077_9e6a6f56:
msgid "[_alchemy_] В тот день я пыталась найти Брайана. Думаю, вы понимаете. Мой родной брат пропал, следствие зашло в тупик"
msgstr "[_alchemy_] Ese día, intenté encontrar a Brian. Creo que entiendes. Mi hermano está desaparecido, la investigación ha llegado a un callejón sin salida"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:409 #-#-# translate crowdin gallery_d_077_a5a3e39a:
msgid "[_alchemy_] Я считала своим долгом что-то сделать!.."
msgstr "[_alchemy_] ¡Pensé que era mi deber hacer algo!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:411 #-#-# translate crowdin gallery_d_077_9f304b2d:
msgid "[_alchemy_] В итоге я набрела на склад. Брайан оказался внутри. Но когда я пыталась пробраться внутрь, кто-то ударил меня по голове"
msgstr "[_alchemy_] Al final, lo encontré en el almacén. Brian estaba adentro. Pero cuando intenté entrar, alguien me golpeó en la cabeza"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:413 #-#-# translate crowdin gallery_d_077_f2211987:
msgid "[_alchemy_] Очнулась я уже связанная в подвале.."
msgstr "[_alchemy_] Ya estoy conectado en el sótano."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:415 #-#-# translate crowdin gallery_d_077_6349c97b:
msgid "[_medina_] Мисс Алхими, вы можете описать, что было дальше? Как проходило ваше заключение?"
msgstr "[_medina_] Señorita Alchemy, ¿puede describir lo que pasó después? ¿Cómo fue tu conclusión?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:417 #-#-# translate crowdin gallery_d_077_66fa032e:
msgid "[_alchemy_] Я.. Эм.. Мне сложно об этом говорить.. Это был бесконечный круг насилия и унижения.."
msgstr "[_alchemy_] Yo... Um. Es difícil para mí hablar de ello. Fue un ciclo interminable de violencia y humillación."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:418 #-#-# translate crowdin gallery_d_077_d2fd1b31:
msgid "[_alchemy_] Я потеряла счет дням, все дни слились в один.. Мактиннен просто приходил, издевался надо мной и уходил.. Потом приходил вновь.."
msgstr "[_alchemy_] Perdí la cuenta de los días, todos los días se fusionaron en uno.. Maktinen acaba de venir, se burló de mí y se fue. Luego volvió de nuevo..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:419 #-#-# translate crowdin gallery_d_077_c1832f4b:
msgid "[_alchemy_] Так я провела в темнице все время, пока меня не нашли.."
msgstr "[_alchemy_] Pasé en la prisión todo el tiempo hasta que me encontraron.."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:421 #-#-# translate crowdin gallery_d_077_9a9de08c:
msgid "[_theresa_] В темнице, Мисс Алхими?"
msgstr "[_theresa_] ¿En la mazmorra, señorita Alchemy?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:423 #-#-# translate crowdin gallery_d_077_960286a6:
msgid "[_alchemy_] Эмм.. То есть на складе.. Но ощущалось все словно в темнице, понимаете!?"
msgstr "[_alchemy_] Em. Quiero decir, en un almacén... Pero se sentía como si estuviera en la cárcel, ¿sabes?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:424 #-#-# translate crowdin gallery_d_077_54fd864c:
msgid "[_alchemy_] Все эти бесконечные надругательства.. Раз за разом.. И момент ожидания, когда же твой похититель придет.. Что он выдумает в этот раз.."
msgstr "[_alchemy_] Todos estos interminables abusos. Una y otra vez.. Y llega el momento de esperar a tu secuestrador. Lo que se le ocurrirá esta vez..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:425 #-#-# translate crowdin gallery_d_077_3ae98d3d:
msgid "[_alchemy_] И так каждый день.. Ты гадаешь, что произойдет с тобой.. Чувствуешь себя абсолютно обессиленным.."
msgstr "[_alchemy_] Y así todos los días.. Te estás preguntando qué te va a pasar. Te sientes absolutamente agotado."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:427 #-#-# translate crowdin gallery_d_077_fa56a3ad:
msgid "[_alchemy_] На тебя давит осознание того, что ты полностью находишься во власти чужого человека.."
msgstr "[_alchemy_] está siendo presionado por la comprensión de que usted está completamente a merced de un extraño."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:429 #-#-# translate crowdin gallery_d_077_62297f16:
msgid "[_alchemy_] И все это так.. Так.. Так возбуж.."
msgstr "[_alchemy_] Y todo es así. Está bien. Tan excitada..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:430 #-#-# translate crowdin gallery_d_077_69ef927d:
msgid "[_payne_] Протестую, ваша честь! Мой клиент утверждает, что впервые в жизни видит эту девушку"
msgstr "[_payne_] está protestando, su señoría! Mi cliente afirma que por primera vez en su vida ve a esta chica"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:432 #-#-# translate crowdin gallery_d_077_a3c4a7b2:
msgid "[_payne_] Все это недоразумение. Уверен, эта девушка просто запуталась в происходящем.."
msgstr "[_payne_] es un malentendido. Estoy seguro de que esta chica estaba enredada en lo que está pasando."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:434 #-#-# translate crowdin gallery_d_077_f09e5c7c:
msgid "[_medina_] При всем уважении, Мистер Пэйн, но где ваши доказательства? Все ваши слова направлены лишь на защиту вашего клиента"
msgstr "[_medina_], Con todo respeto, señor. Payne, pero ¿dónde está tu evidencia? Todas tus palabras están dirigidas solo a proteger a tu cliente"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:436 #-#-# translate crowdin gallery_d_077_e6e42aea:
msgid "[_medina_] Приведите следствию улики, указывающие на то, что жертва лжет. Иначе ваши слова можно будет интерпретировать как оправдание насилия"
msgstr "[_medina_] Dar evidencia de efecto que indique que la víctima está mintiendo. De lo contrario, tus palabras pueden ser interpretadas como una excusa para la violencia"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:438 #-#-# translate crowdin gallery_d_077_8273c9d8:
msgid "*Шум в зале*"
msgstr "♪ Ruido en la habitación ♪"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:442 #-#-# translate crowdin gallery_d_077_cb0cde53:
msgid "[_theresa_] Тишина в суде"
msgstr "[_theresa_] Silencio en el tribunal"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:445 #-#-# translate crowdin gallery_d_077_3c12f3bb:
msgid "[_theresa_] Мистер Пэйн, вам есть что предоставить следствию в качестве опровержения слов Мисс Алхими?"
msgstr "[_theresa_] ¿Sr. Payne, ¿tienes algo que proporcione la investigación como una refutación de las palabras de la señorita Alchemy?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:446 #-#-# translate crowdin gallery_d_077_ce8eae2f:
msgid "[_payne_] Н-нет, Ваша честь.."
msgstr "[_payne_] N-no, su señoría..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:451 #-#-# translate crowdin gallery_d_078_fb7678ee:
msgid "[_cedrick_] (Отлично сработано, Медина. Ты так быстро заткнула этого адвоката, что он аж поперхнулся)"
msgstr "[_cedrick_] (Trabajaba mucho, Medina. Cierras al abogado tan rápido que se estaba volviendo loco."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:454 #-#-# translate crowdin gallery_d_078_3d91bdc4:
msgid "*шлепок*"
msgstr "*Parche*"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:456 #-#-# translate crowdin gallery_d_078_a56b3f1e:
msgid "[_cedrick_] (Отличная работа женщины с отличной задницей)"
msgstr "[_cedrick_] (Gran trabajo de una mujer con un gran culo)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:458 #-#-# translate crowdin gallery_d_078_f2a58387:
msgid "[_medina_] Р-рик.. Ч-что ты?"
msgstr "[_medina_] Rick. ¿Qué eres tú?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:459 #-#-# translate crowdin gallery_d_078_f3fdd395:
msgid "[_theresa_] Что это был за звук?"
msgstr "[_theresa_] ¿Cuál era el sonido de Él?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:460 #-#-# translate crowdin gallery_d_078_498a65ce:
msgid "[_medina_] Н-ничего, Ваша честь"
msgstr "[_medina_] N-nada, su señoría"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:462 #-#-# translate crowdin gallery_d_078_5f472397:
msgid "[_theresa_] В таком случае суд вызывает следующего свидетеля. Мисс Вилл Вандом"
msgstr "[_theresa_] En este caso, el tribunal resume al siguiente testigo. La señorita Will vara"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:466 #-#-# translate crowdin gallery_d_078_c1dbf140:
msgid "[_cedrick_] (Пф.. Еще и Вилл в это все втянули. Ну, это тоже было в какой-то мере ожидаемо. Так что Вилл я тоже предупредил и выдал ей инструкции)"
msgstr "[_cedrick_] (Pf.. Y toda la Will se metió en él. Bueno, eso también se esperaba en cierta medida. Así que, ¿advertiré y le di instrucciones)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:467 #-#-# translate crowdin gallery_d_078_076bad09:
msgid "[_theresa_] Представьтесь пожалуйста"
msgstr "[_theresa_] Introducción"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:469 #-#-# translate crowdin gallery_d_078_e7ed9987:
msgid "[_will_] Я Вилл Вандом. Недавно переехала в этот город со своей мамой. Являюсь учащийся школы Шеффилда. Спортсменка, золотая медалистка по плаванию"
msgstr "[_will_] Soy Will Vandom. Hace poco me mudé a esta ciudad con mi madre. Estudio en la escuela Sheffield. Soy atleta y medallista de oro en natación."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:471 #-#-# translate crowdin gallery_d_078_11dd744a:
msgid "[_medina_] Мисс Вилл, вы можете вспомнить то время, когда пропали Брайан и Алхими?"
msgstr "[_medina_] Miss Will, ¿puede recordar el momento en que Brian y Alcheim estaban desaparecidos?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:473 #-#-# translate crowdin gallery_d_078_172de9b1:
msgid "[_will_] Да. Я в городе новенькая, но даже я поняла, что для этого небольшого городка подобные события были в новинку"
msgstr "[_will_] Sí. Soy nuevo en la ciudad, pero incluso me di cuenta de que para esta pequeña ciudad tales eventos eran nuevos"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:475 #-#-# translate crowdin gallery_d_078_7c47889c:
msgid "[_will_] Горожане явно были обеспокоены. В школе начало появляться все больше слухов об этом"
msgstr "[_will_] La gente del pueblo estaba claramente preocupada. Cada vez más rumores sobre esto comenzaron a aparecer en la escuela"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:476 #-#-# translate crowdin gallery_d_078_3aeeb463:
msgid "[_will_] Некоторых учащихся перестали пускать гулять после школы и говорили сразу возвращаться домой, как только закончатся уроки"
msgstr "[_will_] Algunos estudiantes dejaron de dejar ir después de la escuela y les dijeron que regresaran a casa tan pronto como las lecciones terminaran"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:478 #-#-# translate crowdin gallery_d_078_ad5b3c9c:
msgid "[_medina_] Вы помните, чем занимался Мистер Рик в то же время?"
msgstr "[_medina_] ¿Recuerda lo que el señor. ¿Rick lo hizo al mismo tiempo?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:480 #-#-# translate crowdin gallery_d_078_c9004763:
msgid "[_will_] Ох, он преподавал в нашей школе и параллельно был моим репетитором по истории"
msgstr "[_will_] Oh, enseñó en nuestra escuela y en paralelo fue mi tutor de historia"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:482 #-#-# translate crowdin gallery_d_078_8f1cc020:
msgid "[_will_] Успехи в спорте ведут к снижению успеваемости в школьных дисциплинах, как всегда подмечала мама"
msgstr "[_will_]S Los logros en el deporte conducen a una disminución del rendimiento académico en las disciplinas escolares, como mi madre siempre notó"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:484 #-#-# translate crowdin gallery_d_078_437b1bf9:
msgid "[_will_] По сути почти каждый вечер после школы Рик приходил к нам домой и подтягивал меня в знаниях истории"
msgstr "[_will_] De hecho, casi todas las noches después de la escuela, Rick venía a nuestra casa y me detuvo en el conocimiento de la historia"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:486 #-#-# translate crowdin gallery_d_078_75ae70a5:
msgid "[_will_] В те дни, когда он не занимался репетиторством, обычно он работал в книжном магазине"
msgstr "[_will_] En los días en que no estaba involucrado en la tutoría, por lo general trabajaba en una librería"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:488 #-#-# translate crowdin gallery_d_078_a1485a07:
msgid "[_payne_] Протестую, Ваша честь. Свидетель не может знать, чем занимался подсудимый в то время, когда не давал уроки по истории"
msgstr "[_payne_] está protestando, su señoría. El testigo no puede saber lo que el acusado estaba haciendo en un momento en que no dio lecciones sobre la historia"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:490 #-#-# translate crowdin gallery_d_078_8f011533:
msgid "[_theresa_] Верное замечание"
msgstr "[_theresa_] El comentario correcto"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:492 #-#-# translate crowdin gallery_d_078_74462075:
msgid "[_will_] Ну, эм, вообще-то всякий раз, когда он не преподавал в школе или же не читал лекции у меня дома, мы старались навестить его в книжном магазине"
msgstr "[_will_] Bueno, en realidad, cada vez que no enseñaba en la escuela o daba una conferencia en mi casa, intentábamos visitarlo en una librería"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:493 #-#-# translate crowdin gallery_d_078_3e63a45e:
msgid "[_will_] И когда бы мы не приходили - он был там. Поймите, Рик - работяга. В свои относительно юные годы он фактически работает на трех работах"
msgstr "[_will_] Y cada vez que veníamos, estaba allí. Entienda, Rick es un trabajador. En sus años relativamente jóvenes, en realidad trabaja en tres trabajos"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:495 #-#-# translate crowdin gallery_d_078_ebe17e61:
msgid "[_will_] Он и преподаватель в школе, и репетитор, и владелец книжного магазина. Неужели вы думаете, что такой человек стал бы кого-то похищать!?"
msgstr "[_will_] Es profesor en la escuela, y tutor, y el dueño de la librería. ¿De verdad crees que una persona así sería secuestrada por alguien?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:497 #-#-# translate crowdin gallery_d_078_9bddc664:
msgid "[_payne_] Протестую, Ваша честь! Это эмоциональная манипуляция залом присяжных"
msgstr "[_payne_] ¡Objeción, Su Señoría! Esto es manipulación emocional del jurado."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:498 #-#-# translate crowdin gallery_d_078_132968ec:
msgid "[_payne_] Свидетель начинает делиться не фактами, а своими эмоциональными привязанностями и симпатией. Это не относится к делу"
msgstr "[_payne_] El testigo comienza a compartir no los hechos, sino sus apegos emocionales y su simpatía. Esto no está relacionado con el caso"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:499 #-#-# translate crowdin gallery_d_078_4e811355:
msgid "[_payne_] Подобные заявления можно расценивать как предвзятые. Я требую отозвать свидетеля вследствие его тесной связи с подсудимым"
msgstr "[_payne_] Tales declaraciones pueden considerarse como sesgadas. Exijo que se recuerde al testigo debido a su estrecha relación con el acusado"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:500 #-#-# translate crowdin gallery_d_078_6b643fd6:
msgid "[_cedrick_] (Вот же ж черт, этот мужик цепляется за формулировки при любой возможности..)"
msgstr "[_cedrick_] (Aquí el infierno, este hombre se aferra a la redacción en cualquier oportunidad.)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:501 #-#-# translate crowdin gallery_d_078_5ca268fc:
msgid "[_medina_] Протестую, Ваша честь! В словах свидетеля не было приведено предвзятых высказываний"
msgstr "[_medina_] ¡Objeción, Su Señoría! El testigo no hizo ninguna declaración sesgada."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:502 #-#-# translate crowdin gallery_d_078_4e0c8d16:
msgid "[_medina_] Вилл руководствуется фактами и делает из них объективные выводы"
msgstr "[_medina_] Will se guía por los hechos y saca conclusiones objetivas de los mismos"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:503 #-#-# translate crowdin gallery_d_078_67799eaa:
msgid "[_medina_] Человеку, находящемуся на трех работах, куда сложнее совершать регулярные похищения, к тому же такого количества людей"
msgstr "[_medina_] Una persona en tres trabajos, es mucho más difícil cometer secuestros regulares, además, tanta gente"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:504 #-#-# translate crowdin gallery_d_078_3b9bd2fe:
msgid "[_medina_] Думаю свидетель имел ввиду, что не стал бы кого-то похищать тот человек, который постоянно находится на виду в трех разных местах"
msgstr "[_medina_] ¿Cree que el testigo significaba que no secuestraría a alguien que está constantemente a la vista en tres lugares diferentes"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:505 #-#-# translate crowdin gallery_d_078_5fa9ccb4:
msgid "[_medina_] Верно, Мисс Вандом?"
msgstr "[_medina_] ¿No es así, señorita Vandom?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:507 #-#-# translate crowdin gallery_d_078_073acd04:
msgid "[_will_] Д-да.. Именно это я и имела ввиду"
msgstr "[_will_] D-Da... Eso es lo que quise decir"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:509 #-#-# translate crowdin gallery_d_078_cb159867:
