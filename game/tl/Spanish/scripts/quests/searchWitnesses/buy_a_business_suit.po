# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:924 #-#-# translate crowdin gallery_d_081_3c2da5b4:
msgid "[_security_] Я провожу обход, поскольку суд скоро начнется. Не задерживайтесь"
