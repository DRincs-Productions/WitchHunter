# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:665 #-#-# translate crowdin gallery_d_080_0b2d060b:
msgid "[_will_] А я должна что.. Ааах.. Просто слушать все это за соседней стенкой!?"
msgstr "[_will_] Y tengo que... Aah... ¡Escucha todo esto detrás de la próxima pared!?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:666 #-#-# translate crowdin gallery_d_080_5fc0817b:
msgid "[_will_] Н-нет уж, спасибо, наслушалась уже тебя со Сьюзан.. Теперь настал мой черед.."
msgstr "[_will_] N-no, gracias, ya te he oído con Susan... Ahora es mi turno."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:668 #-#-# translate crowdin gallery_d_080_ad7e8300:
msgid "[_alchemy_] Хах, смотрю рыжая потаскуха здесь далеко не только я"
