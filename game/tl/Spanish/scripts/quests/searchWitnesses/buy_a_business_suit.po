# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:696 #-#-# translate crowdin gallery_d_080_558fda64:
msgid "[_cedrick_] Уууф.. Ч-черт, суд скоро начнется.. Что вы тут устроили.."
