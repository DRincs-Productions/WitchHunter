# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:943 #-#-# translate crowdin gallery_d_081_14ff2fb2:
msgid "[_cedrick_] Окей, нужно это разъяснить здесь, раз и навсегда"
