# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:908 #-#-# translate crowdin gallery_d_081_9752ab7b:
msgid "[_irma_] Ууух.."
msgstr "[_irma_] Wuh..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:909 #-#-# translate crowdin gallery_d_081_de68e8ae:
