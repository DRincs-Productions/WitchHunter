msgid "[_security_] Что-то заблокировало дверь.."
msgstr "[_security_] Algo ha bloqueado la puerta."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:921 #-#-# translate crowdin gallery_d_081_1e971879:
