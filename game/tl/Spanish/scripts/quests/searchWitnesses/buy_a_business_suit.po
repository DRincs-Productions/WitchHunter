# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:959 #-#-# translate crowdin gallery_d_081_d96b0005:
msgid "[_cedrick_] Да. И я буду жестким всегда до тех пор, пока ты не уяснишь одну простую вещь"
msgstr "[_cedrick_] Sí. Y siempre seré duro hasta que entiendas una cosa simple"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:961 #-#-# translate crowdin gallery_d_081_62447347:
msgid "[_irma_] К-какую?"
msgstr "[_irma_] ¿Qué es también?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:962 #-#-# translate crowdin gallery_d_081_7247feb9:
msgid "[_cedrick_] До тех пор, пока ты не бросаешь попытки мне перечить. До тех пор, пока ты своевольничаешь.."
msgstr "[_cedrick_] Hasta que intentes cruzarme. Mientras estés siendo sergey..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:963 #-#-# translate crowdin gallery_d_081_9752ab7b_1:
msgid "[_irma_] Ууух.."
msgstr "[_irma_] Wuh..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:964 #-#-# translate crowdin gallery_d_081_ce846f51:
msgid "[_cedrick_] Мы каждый раз будем возвращаться к этому моменту. И каждый раз твои подобные просчеты будут приводить к тому, что ты будешь лежать на полу, а я буду тебя ебать"
msgstr "[_cedrick_] Volveremos a este momento cada vez. Y cada vez que tus errores te lleven al hecho de que te acostarás en el suelo, y te cogeré"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:966 #-#-# translate crowdin gallery_d_081_795678bb_1:
msgid "[_irma_] ..."
msgstr "[_irma_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:967 #-#-# translate crowdin gallery_d_081_6fb73e96:
msgid "[_cedrick_] Это то отсутствие борьбы в твоей жизни, которого ты хотела?"
msgstr "[_cedrick_] ¿Es esta la falta de lucha en tu vida que querías?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:969 #-#-# translate crowdin gallery_d_081_2b26a23f:
msgid "[_irma_] Н-нет.."
