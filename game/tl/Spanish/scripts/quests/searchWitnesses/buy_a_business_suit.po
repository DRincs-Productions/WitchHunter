# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:988 #-#-# translate crowdin gallery_d_081_35dfdeca:
msgid "[_cedrick_] Что, нравится подобное?"
msgstr "[_cedrick_] ¿Qué, así?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:990 #-#-# translate crowdin gallery_d_081_0dac4c1b:
msgid "[_cornelia_] Когда меня трахают в суде? Черт, да, это очень заводит.."
msgstr "[_cornelia_] ¿Cuándo me cogen en la corte? Maldita sea, sí, es realmente..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:992 #-#-# translate crowdin gallery_d_081_44b41074:
msgid "[_cornelia_] Да еще и когда моя подруга держит меня.."
msgstr "[_cornelia_] Y cuando mi amigo me está sosteniendo.."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:994 #-#-# translate crowdin gallery_d_081_d9e4bb51:
msgid "[_cornelia_] Ууух, это стоило всех моих усилий.. Мммм.."
msgstr "[_cornelia_] Wuhu, me costó todos mis esfuerzos. Mmm..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:995 #-#-# translate crowdin gallery_d_081_c8a4b100:
msgid "[_cedrick_] Уф, черт, ты так сжимаешь меня от напряжения..."
msgstr "[_cedrick_] Uv, maldita sea, me estás apretando tanto de la tensión..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:997 #-#-# translate crowdin gallery_d_081_c3b59ed9:
msgid "[_cornelia_] О да.. Продолжай.. Ирма, держи меня крепче, ммм.."
msgstr "[_cornelia_] Oh sí. Sigue adelante. Irma, mantenme más fuerte, mmm..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:999 #-#-# translate crowdin gallery_d_081_231c9201:
msgid "[_cornelia_] Давай, трахни меня, чертов змей-похититель"
msgstr "[_cornelia_] Vamos, cógeme, maldita serpiente secuestradora."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1001 #-#-# translate crowdin gallery_d_081_8a76bf46:
msgid "[_cedrick_] (Хах, да уж, вот кто точно получает удовольствие от своего положения)"
msgstr "[_cedrick_] (Hah, sí, eso es quien disfruta exactamente de tu posición)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1003 #-#-# translate crowdin gallery_d_081_a6a2cb66:
msgid "[_cedrick_] (Вот у нее в голове нет абсолютно никаких противоречий после того, как я слегка подкорректировал ее восприятие)"
msgstr "[_cedrick_] (Aquí no hay completamente en su cabeza ninguna contradicción después de que corrigí ligeramente su percepción)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1004 #-#-# translate crowdin gallery_d_081_706f127a:
msgid "[_cedrick_] (Мда, что-то идет как надо, а что-то не очень, в случае с Ирмой.. Интересно, как с Тарани пойдет)"
msgstr "[_cedrick_] (Entonces, algo va bien, y algo no es tan bueno, en el caso de Irma. Me pregunto cómo irá Taranee)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1005 #-#-# translate crowdin gallery_d_081_6c2b619c:
msgid "[_cornelia_] Аааах.. Дааа.. Продолжай.."
msgstr "[_cornelia_] Aaaah... Sííí... Continúa..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1007 #-#-# translate crowdin gallery_d_081_e0da05bd:
msgid "[_cedrick_] Ч-черт! Суд же начался. Какого черта я тут задерживаюсь.."
msgstr "[_cedrick_] Ch-h-h-h-h-h- el juicio ha comenzado. ¿Qué diablos estoy tarde...?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1009 #-#-# translate crowdin gallery_d_081_963fec54:
msgid "[_cornelia_] С-седрик, нет, подожди.."
msgstr "[_cornelia_] Cedric, no, espera."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1010 #-#-# translate crowdin gallery_d_081_aaf6a30a:
msgid "[_cedrick_] Корнелия, если я не приду, то меня посадят, то мы точно еще долго не сможет трахаться"
msgstr "[_cedrick_] Cornelia, si no vengo, me encarcelarán, no podremos coger mucho tiempo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1011 #-#-# translate crowdin gallery_d_081_9f4e6b72:
msgid "[_cedrick_] Но если уйду, то есть шанс того, что мы сможем продолжить с тобой очень скоро"
msgstr "[_cedrick_] Pero si me voy, entonces hay una posibilidad de que podamos continuar con ustedes muy pronto"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1012 #-#-# translate crowdin gallery_d_081_4d271419:
msgid "[_cornelia_] Да, резонно.. Ну тогда ладно, беги и выиграй этот суд!"
msgstr "[_cornelia_] Sí, razonable. ¡Bueno, entonces, corre y gana esta prueba!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1013 #-#-# translate crowdin gallery_d_081_bdb859a5:
msgid "[_cedrick_] Хах, обязательно"
msgstr "[_cedrick_] Hah, obligatorio"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1016 #-#-# translate crowdin gallery_d_081_bc17dbe3:
msgid "[_centered_] {size=37}В ЗАЛЕ СУДА{/size} [withDissolve1]"
msgstr "[_centered_] {size=37}EN LA SALA DEL TRIBUNAL{/size} [withDissolve1]"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1019 #-#-# translate crowdin gallery_d_081_d1f3f43d:
msgid "[_theresa_] Вы снова опоздали, Мистер Рик!"
msgstr "[_theresa_] Llegas tarde otra vez, Sr. ¡Rick!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1020 #-#-# translate crowdin gallery_d_081_8b00c777:
msgid "[_cedrick_] Прошу простить, Ваша честь, там в туалете.."
msgstr "[_cedrick_] Por favor, perdona, señoría, está en el baño."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1021 #-#-# translate crowdin gallery_d_081_67b8861f:
msgid "[_theresa_] Прекратите посвещать зал суда в подробности того, что вы делаете в туалете. Еще одно опоздание и вас оштрафуют"
msgstr "[_theresa_] Deje de dilatar la sala del tribunal en los detalles de lo que hace en el baño. Otro retraso y serás multado"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1022 #-#-# translate crowdin gallery_d_081_b92184b7:
msgid "[_cedrick_] Понял вас, Ваша честь, этого больше не повторится.."
msgstr "[_cedrick_] Te entendió, señoría, no volverá a suceder."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1023 #-#-# translate crowdin gallery_d_081_cf5ab99a:
msgid "[_cedrick_] (Мда, Терезу тоже стоит приструнить за длинный язык.. Но еще не время)"
msgstr "[_cedrick_] (Sí, la teresa también debe ser señalada por una lengua larga. Pero todavía no es tiempo)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1024 #-#-# translate crowdin gallery_d_081_f9750894:
msgid "[_theresa_] Начинается заключительная часть выступления обеих сторон, после которой суд присяжный отправится на рассмотрение дела и вынесение своего решения"
msgstr "[_theresa_] Inicia la parte final del discurso de ambas partes, tras lo cual el jurado acudirá al caso y tomará su decisión"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1025 #-#-# translate crowdin gallery_d_081_9ad747c7:
msgid "[_theresa_] Начнем со стороны обвинения. Вы готовы выступить?"
msgstr "[_theresa_] Empecemos con la fiscalía. ¿Estás listo para hablar?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1026 #-#-# translate crowdin gallery_d_081_32da5f39:
msgid "[_cedrick_] (Черт, еще и не самая выгодная позиция при выступлении. Получается, заключительное слово будет за Мактинненом?)"
msgstr "[_cedrick_] (Maldita sea, no la mejor posición al realizar. ¿Será la última palabra para Maktinen?)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1027 #-#-# translate crowdin gallery_d_081_99eb0770:
msgid "[_cedrick_] (Что ж.. Выступлю так, чтобы не оставить ему и шанса!)"
msgstr "[_cedrick_] (Bueno. ¡Lo haré para no dejarle una oportunidad!)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1028 #-#-# translate crowdin gallery_d_081_8f63191c:
msgid "[_medina_] Сторона обвинения готова, Ваша честь"
msgstr "[_medina_] La fiscalía está lista, su señoría"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1029 #-#-# translate crowdin gallery_d_081_f9a51634:
msgid "[_theresa_] Сторона защиты, вы готовы?"
msgstr "[_theresa_] El lado de la defensa, ¿estás listo?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1030 #-#-# translate crowdin gallery_d_081_43087b32:
msgid "[_payne_] Да, Ваша честь"
msgstr "[_payne_] Sí, su señoría"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1034 #-#-# translate crowdin gallery_d_081_14c7e729:
msgid "[_theresa_] И так, Рик Хоффман, представитель со стороны защиты, Мистер Пэйн, задаст Вам несколько вопросов"
msgstr "[_theresa_] Y así, Rick Hoffman, representante de la defensa, Sr. Payne, te hará algunas preguntas"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1036 #-#-# translate crowdin gallery_d_081_dc073eb0:
msgid "[_cedrick_] Да, Ваша честь, я готов ответить на любые вопро.."
msgstr "[_cedrick_] Sí, señoría, estoy listo para responder a cualquier pregunta."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1037 #-#-# translate crowdin gallery_d_081_90911297:
msgid "[_theresa_] Сначала представьтесь, Мистер Рик"
msgstr "[_theresa_] Primero preséntate, Sr. ¿Rick"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1039 #-#-# translate crowdin gallery_d_081_01926a61:
msgid "[_cedrick_] (Пф..)"
msgstr "[_cedrick_] (Pf..)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1041 #-#-# translate crowdin gallery_d_081_16dc3cb2:
msgid "[_cedrick_] Рик Хоффман.. Владелец книжного магазина. Учитель истории в Шеффилдской школе"
msgstr "[_cedrick_] Rick Hoffman. Propietario de la librería. Profesor de historia en la escuela Sheffield"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1043 #-#-# translate crowdin gallery_d_081_2f6b0850:
msgid "[_payne_] Мистер Рик, начнем с простого. Правда ли, что все потерпевшие учились в одной школе, в которой вы, по стечению обстоятельств, работали учителем?"
msgstr "[_payne_] Sr. Rick, empecemos con lo simple. ¿Es cierto que todas las víctimas estudiaron en la misma escuela, en la que usted, por casualidad, trabajó como maestro?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1045 #-#-# translate crowdin gallery_d_081_a3836826:
msgid "[_cedrick_] Да, это буквально то, что я и сказал"
msgstr "[_cedrick_] Sí, esto es literalmente lo que dije"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1047 #-#-# translate crowdin gallery_d_081_4ef60001:
msgid "[_payne_] Получается, в отличие от Мистера Мак-Тиннена, вы лично были знакомы с каждым потерпевшим еще до их похищения, верно?"
msgstr "[_payne_] Resulta, a diferencia del Sr. Maktinen, conocías personalmente a cada víctima antes de que fueran secuestrados, ¿verdad?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1049 #-#-# translate crowdin gallery_d_081_35d5e156:
msgid "[_cedrick_] Да, это верно, но к чему вы клоните?"
msgstr "[_cedrick_] Sí, eso es cierto, pero ¿cómo estás llamando?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1051 #-#-# translate crowdin gallery_d_081_9d8624d3:
msgid "[_payne_] Сейчас я задаю вопросы, Мистер Рик"
msgstr "[_payne_] Ahora hago preguntas, Sr. ¿Rick"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1052 #-#-# translate crowdin gallery_d_081_f54b093d:
msgid "[_payne_] Правда ли, что несколько пропавших последний раз видели возле вашей библиотеки?"
msgstr "[_payne_] ¿Es cierto que varios desaparecidos fueron vistos por última vez cerca de su biblioteca?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1054 #-#-# translate crowdin gallery_d_081_a28a2354:
msgid "[_cedrick_] Да, это правда, но.."
msgstr "[_cedrick_] Sí, es verdad, pero..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1056 #-#-# translate crowdin gallery_d_081_eb7b06b5:
msgid "[_payne_] Является ли также верным тот факт, Мистер Хоффман, что в нашем городе вы относительно недавно и что пропажи начались незадолго после того, как вы приехали в Шеффилд?"
msgstr "[_payne_] ¿Es también cierto, señor. Hoffman, ¿qué es lo que hace relativamente poco en nuestra ciudad y que las desapariciones comenzaron poco después de que vinieras a Sheffield?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1058 #-#-# translate crowdin gallery_d_081_9352ffa9:
msgid "[_medina_] Протестую, Ваша честь! Это манипуляция фактами"
msgstr "[_medina_] ¡Objeción, Su Señoría! Está tergiversando los hechos."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1059 #-#-# translate crowdin gallery_d_081_d3c8df48:
msgid "[_theresa_] Отклоняется. Сторона защиты лишь уточняет фактологию. Мистер Пейн, продолжайте"
msgstr "[_theresa_] se desvía. La defensa sólo aclara la factología. ¿Sr. Payne, vamos"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1060 #-#-# translate crowdin gallery_d_081_2756b026:
msgid "[_payne_] Мы так и не услышали ответа на свой вопрос, Мистер Рик"
msgstr "[_payne_] Nunca escuchamos la respuesta a nuestra pregunta, Sr. ¿Rick"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1062 #-#-# translate crowdin gallery_d_081_0ec5a93b:
msgid "[_cedrick_] Да, это верно"
msgstr "[_cedrick_] Sí, eso es cierto"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1064 #-#-# translate crowdin gallery_d_081_61dd7e26:
msgid "[_payne_] Получается, что вы, Мистер Хоффман, приезжаете в город, сразу же приобретаете книжный магазин и устраиваетесь учителем в школу, что дает вам широкий охват потенциальных жертв.."
msgstr "[_payne_] Resulta que usted, Sr. Hoffman, ven a la ciudad, compra inmediatamente una librería y consigue un maestro en la escuela, lo que te da un amplio alcance de las víctimas potenciales."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1065 #-#-# translate crowdin gallery_d_081_2159ce0c:
msgid "[_medina_] Я протестую!"
msgstr "[_medina_] ¡Estoy protestando!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1066 #-#-# translate crowdin gallery_d_081_d32fc5a9:
msgid "[_theresa_] Отклоняется. Мистер Пейн, продолжайте"
msgstr "[_theresa_] se desvía. ¿Sr. Payne, vamos"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1067 #-#-# translate crowdin gallery_d_081_ed4e1225:
msgid "[_payne_] ..после чего молодые парни и девушки начинают пропадать и все они были вашими учениками и так же заходили к вам в книжный хотя бы раз?"
msgstr "[_payne_] .. Después de eso los jóvenes y las chicas comienzan a desaparecer y todos ellos eran sus estudiantes y también vinieron a su libro al menos una vez?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1069 #-#-# translate crowdin gallery_d_081_1b6eb9d1:
msgid "[_payne_] Честно говоря, для меня здесь все кристально ясно. Надеюсь суду присяжных также не составит большого труда понять, что моего подсудимого просто оболгали, а настоящий злодей и похититель здесь.."
msgstr "[_payne_] Honestamente, es muy claro para mí aquí. Espero que el jurado tampoco sea difícil de entender que a mi acusado simplemente se le mintió, sino a un verdadero villano y secuestrador aquí."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1071 #-#-# translate crowdin gallery_d_081_a0904bc6:
msgid "[_cedrick_] Я так и не услышал доказательств!"
msgstr "[_cedrick_] ¡Nunca escuché la evidencia!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1072 #-#-# translate crowdin gallery_d_081_1d1f0861:
msgid "[_payne_] Ч-что?!"
msgstr "[_payne_] ¿¡Qué!!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1073 #-#-# translate crowdin gallery_d_081_836a3d9d:
msgid "[_cedrick_] Хотите задавать вопросы - задавайте, но не делайте вид, что пытаетесь докопаться до правды!"
msgstr "[_cedrick_] ¿Quieres hacer preguntas? ¡Pregúntate, pero no pretendas que estás tratando de llegar a la verdad!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1074 #-#-# translate crowdin gallery_d_081_91d6cee7:
msgid "[_payne_] Простите?"
msgstr "[_payne_] ¿Disculpe?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1075 #-#-# translate crowdin gallery_d_081_a65bc7f1:
msgid "[_cedrick_] Вы задаете вопросы так, как вам удобно, указывая на те факты, которые выставляют злодеем меня, откровенно игнорируя те факты, что выставляют в невыгодном свете вашего подсудимого"
msgstr "[_cedrick_] Formula las preguntas a su conveniencia: señala los hechos que me presentan como el villano e ignora descaradamente los que dejan mal parado a su acusado."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1076 #-#-# translate crowdin gallery_d_081_2f8f0eba:
msgid "[_payne_] Что вы себе позволяете. Госпожа судья, что это за фамильярность?"
msgstr "[_payne_] ¿Qué te permites? Señora jueza, ¿qué es este desnombre?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1077 #-#-# translate crowdin gallery_d_081_19c99d6a:
msgid "[_cedrick_] Мне казалось это моя часть выступлений и я также имею право здесь высказаться, разве нет?"
msgstr "[_cedrick_] Pensé que era mi parte de mis actuaciones y también tengo derecho a hablar aquí, ¿no?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1078 #-#-# translate crowdin gallery_d_081_6954a525:
msgid "[_theresa_] Все так, Мистер Рик, продолжайте"
msgstr "[_theresa_] Todo es así, Sr. Rick, continúa"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1079 #-#-# translate crowdin gallery_d_081_e8130364:
msgid "[_cedrick_] Суть в том, что в этой ситуации я довольно удобный козел отпущения"
msgstr "[_cedrick_] La esencia es que en esta situación soy un chivo expiatorio bastante cómodo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1080 #-#-# translate crowdin gallery_d_081_92380ac1:
msgid "[_theresa_] Мистер Рик, попрошу не выражаться, проявите уважение к суду"
msgstr "[_theresa_] Sr. Rick, por favor, no lo expreses, muestra respeto por la corte"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1082 #-#-# translate crowdin gallery_d_081_eb78ec5e:
msgid "[_cedrick_] Прошу прощения.."
msgstr "[_cedrick_] Disculpas."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1084 #-#-# translate crowdin gallery_d_081_aa4c06ff:
msgid "[_cedrick_] Я лишь хочу сказать, что я выгоден Мак-тиннену. Его профессия и связи позволяют ему узнать о каждом жителе этого города и о том, насколько уязвимо его положение"
msgstr "[_cedrick_] Solo quiero decir que soy un beneficio de Maktinen. Su profesión y conexiones le permiten aprender sobre cada residente de esta ciudad y lo vulnerable que es su posición"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1085 #-#-# translate crowdin gallery_d_081_5b2c1d97:
msgid "[_cedrick_] Есть мужчины, у которых есть своя семья, жена и дети, стабильная работа. Есть те, кто в этом городе всю свою жизнь и все их знают. Есть граждане, чья работа и образ жизни обеспечивают им кристально чистое алиби"
msgstr "[_cedrick_] Hay hombres que tienen su propia familia, esposa e hijos, trabajo estable. Hay quienes han estado en esta ciudad toda su vida y todos los conocen. Hay ciudadanos cuyo trabajo y estilo de vida les proporcionan una coartada cristalina"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1086 #-#-# translate crowdin gallery_d_081_a2abe954:
msgid "[_cedrick_] Все они неудобны, на таких людей не скинешь преступлений. А есть категория людей вроде меня"
msgstr "[_cedrick_] Todos ellos son inconvenientes, no deshacerás a tales personas. Y hay una categoría de gente como yo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1088 #-#-# translate crowdin gallery_d_081_7e58163b:
msgid "[_cedrick_] Те, кто здесь недавно, новенькие, этакие белые вороны. Те, у кого нет семьи или детей, нет людей, которые подтвердят их алиби"
msgstr "[_cedrick_] Los que están aquí recientemente, nuevos, tales cuervos blancos. Aquellos que no tienen familias o niños no tienen personas que confirmen su coartada"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1089 #-#-# translate crowdin gallery_d_081_90f9e97b:
msgid "[_cedrick_] Нет стабильной работы в большом коллективе, нет особых друзей и знакомых"
msgstr "[_cedrick_] No hay trabajo estable en un equipo grande, no hay amigos y conocidos especiales"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1090 #-#-# translate crowdin gallery_d_081_40cbcd5f:
msgid "[_cedrick_] В этом городе есть и такие люди и все они уязвимы перед судом, перед такими происшествиями. На них довольно легко скинуть любое преступление"
msgstr "[_cedrick_] En esta ciudad hay tales personas y todas ellas son vulnerables a la corte, antes de tales incidentes. Es muy fácil tirar cualquier crimen sobre ellos"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1092 #-#-# translate crowdin gallery_d_081_d5d54e0e:
msgid "[_cedrick_] Особенно, если второй подозреваемый - это государственный служащий. Да, шансов у меня тут не много"
msgstr "[_cedrick_], especialmente si el segundo sospechoso es un funcionario. Sí, no tengo muchas oportunidades aquí"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1093 #-#-# translate crowdin gallery_d_081_620e2500:
msgid "[_cedrick_] Даже со всеми подозреваемыми и уликами, я могу здесь проиграть. И явно больше шансов выиграть было бы у семьянина, живущего в городе 30 лет и работающего копом"
msgstr "[_cedrick_] Incluso con todos los sospechosos y la evidencia, puedo perder aquí. Y claramente más posibilidades de ganar sería de un hombre de familia que ha vivido en la ciudad durante 30 años y trabajando como policía"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1095 #-#-# translate crowdin gallery_d_081_f4d22686:
msgid "[_cedrick_] Это истинная причина, по которой я здесь. Это то, о чем вы молчите, Мистер Пейн, то, о чем вы никогда не спросите. Я легкая мишень для нападок"
msgstr "[_cedrick_] Es la verdadera razón por la que estoy aquí. De esto está en silencio, Sr. Payne, algo que nunca pedirás. Soy un blanco fácil para los ataques"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1096 #-#-# translate crowdin gallery_d_081_9435d72a:
msgid "[_cedrick_] На меня в этом городе легче всего свалить обвинение, это правда. Но разве это причина молчать об истинном положении вещей, Мистер Пейн"
msgstr "[_cedrick_] Sobre mí en esta ciudad es la más fácil de culpar, es verdad. Pero, ¿es esta una razón para guardar silencio sobre el verdadero estado de las cosas, señor. ¿Payne"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1098 #-#-# translate crowdin gallery_d_081_3d4a4430:
msgid "[_payne_] Я протестую, Ваша честь!!"
msgstr "[_payne_] Protesto, su señoría!!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1099 #-#-# translate crowdin gallery_d_081_e024531e:
msgid "[_theresa_] Отклоняется. Мистер Рик, продолжайте"
msgstr "[_theresa_] se desvía. ¿Sr. Rick, adelante"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1101 #-#-# translate crowdin gallery_d_081_f6b99adb:
msgid "[_cedrick_] У меня только начало все налаживаться в этом городе. Только начали появляться друзья, только начали складываться отношения.."
msgstr "[_cedrick_] Acabo de empezar a mejorar en esta ciudad. Solo los amigos comenzaron a aparecer, solo comenzaron a desarrollar una relación."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1103 #-#-# translate crowdin gallery_d_081_bc48ff26:
msgid "[_cedrick_] Но одному федеральному маньяку захотелось поиграть и скинуть с себя все обвинения, поэтому вся моя жизнь может разрушиться прямо сейчас.."
msgstr "[_cedrick_] Pero un maníaco federal quería jugar y quitarme todas las acusaciones, para que toda mi vida pudiera arruinarse ahora mismo."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1104 #-#-# translate crowdin gallery_d_081_331f0c43:
msgid "[_cedrick_] И это та справедливость, за которую выступает сторона защиты и Мистер Пейн в частности"
msgstr "[_cedrick_] Y esta es la justicia que la defensa y el señor. Payne en particular"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1106 #-#-# translate crowdin gallery_d_081_1e77e407:
msgid "[_payne_] Протестую! Переход на личности и манипуляция присяжными"
msgstr "[_payne_] ¡Estoy protestando! Transición a la personalidad y manipulación de los jurados"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1107 #-#-# translate crowdin gallery_d_081_c130ebe8:
msgid "[_theresa_] Вы закончили, Мистер Рик?"
msgstr "[_theresa_] ¿Ha terminado, señor. ¿Rick?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1109 #-#-# translate crowdin gallery_d_081_3415e66e:
msgid "[_cedrick_] Да, это все"
msgstr "[_cedrick_] Sí, eso es todo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1111 #-#-# translate crowdin gallery_d_081_7814057e:
msgid "[_theresa_] Можете возвращаться на свое место. Очередь опроса стороны защиты. Мистер Джоэль, представьтесь"
msgstr "[_theresa_] Puede estar de vuelta en su lugar. Otra encuesta de la defensa. ¿Sr. Joel, preséntate"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1113 #-#-# translate crowdin gallery_d_081_d9227291:
msgid "[_maktinen_] Джоэль Мактиннен, агент Интерпола"
msgstr "[_maktinen_] Joel Maktinen, agente de Interpol."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1114 #-#-# translate crowdin gallery_d_081_a67a65d1:
msgid "[_theresa_] И так, сторона обвинения может задать вам несколько вопросов, если таковые остались"
msgstr "[_theresa_] Y así, la fiscalía puede hacerle algunas preguntas si permanecen"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1115 #-#-# translate crowdin gallery_d_081_fec0f81a:
msgid "[_medina_] Честно говоря, Ваша честь, у стороны обвинения не осталось вопросов"
msgstr "[_medina_] Honestamente, su señoría, la fiscalía no tiene preguntas"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1116 #-#-# translate crowdin gallery_d_081_021b1ef4:
msgid "[_medina_] Очевидно, подсудимый будет отрицать все до последнего, сколько бы доказательств мы не предъявляли"
msgstr "[_medina_] Obviamente, el acusado lo negará todo hasta el final, sin importar cuánta evidencia no presentemos"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1117 #-#-# translate crowdin gallery_d_081_8650e483:
msgid "[_medina_] Нам не нужны слова маньяка и насильника. На нашей стороне слова потерпевших"
msgstr "[_medina_] No necesitamos las palabras de un maníaco y un violador. De nuestro lado las palabras de las víctimas"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1118 #-#-# translate crowdin gallery_d_081_716b5210:
msgid "[_cedrick_] (Хах, отличный ход, чтобы не дать Мактиннену высказаться. А ты хороша, Медина)"
msgstr "[_cedrick_] (Hah, gran movimiento para mantener a mctundy no hablar. Y tú eres bueno, Medina)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1119 #-#-# translate crowdin gallery_d_081_bb016bc1:
msgid "[_maktinen_] Ч-что!? Но.."
msgstr "[_maktinen_] ¿¡Qué!? Pero..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1120 #-#-# translate crowdin gallery_d_081_13b049eb:
msgid "[_theresa_] Я поняла вас, Мисс Медина. Мистер МакТиннен, у вас есть что сказать? Это ваша последняя возможность выступить"
msgstr "[_theresa_] Te entiendo, señorita Medina. ¿Sr. Maktinen, ¿tienes algo que decir? Esta es tu última oportunidad de hablar"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1121 #-#-# translate crowdin gallery_d_081_4debe015:
msgid "[_maktinen_] Я.. Я.."
msgstr "[_maktinen_] Yo... Yo.."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1122 #-#-# translate crowdin gallery_d_081_066adc82:
msgid "[_maktinen_] Ч-черт, да какой же это все фарс! Медина, что ты творишь!? Ты что не видишь, что выступаешь на стороне ублюдка и убийцы!? Да он всеми вами манипулирует!"
msgstr "[_maktinen_] ¡M-mierda, qué farsa! Medina, ¿qué estás haciendo? ¿No ves que estás del lado de un bastardo y un asesino? ¡Los está manipulando a todos!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1123 #-#-# translate crowdin gallery_d_081_0fec315c:
msgid "[_maktinen_] Не знаю как, но он заставил лгать в суде всех, кто выступал с его стороны! Это просто нереально, за всю свою карьеру я не видел более форменного бреда.."
msgstr "[_maktinen_] No sé cómo, pero lo obligó a mentir en la corte a todos los que hablaron de su parte. Es poco realista, no he visto tonterías más uniformes en toda mi carrera."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1124 #-#-# translate crowdin gallery_d_081_79c86386:
msgid "[_maktinen_] Все происходящее полнейший фарс, неужели всем здесь присутствующим это не очевидно!?"
msgstr "[_maktinen_] Todo lo que sucede es una farsa completa, ¿no es obvio para todos aquí?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1125 #-#-# translate crowdin gallery_d_081_e91665e9:
msgid "[_theresa_] Мистер Мактиннен, я слышала достаточно! Это неуважение к суду и всему судебному процессу. Продолжите в том же духе и получите штраф"
msgstr "[_theresa_] Sr. ¡Maktinen, ya he oído suficiente! Esto es una falta de respeto para el tribunal y todo el juicio. Continúe con el mismo espíritu y obtenga una multa"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1126 #-#-# translate crowdin gallery_d_081_14f430da:
msgid "[_cedrick_] (Тереза не протестовала против его слов, чтобы позволить ему высказаться и закопать себя еще глубже? Да еще и судье в итоге пришлось его заткнуть, сурово)"
msgstr "[_cedrick_] (Teresa no protestó contra sus palabras para permitirle hablar y enterrarse aún más profundo? E incluso el juez al final tuvo que callarlo, severamente)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1127 #-#-# translate crowdin gallery_d_081_185427f9:
msgid "[_maktinen_] Я.. Я.. Я что, остался единственным нормальным человеком в этом суде?.. Что вообще происходит.. Боже.."
msgstr "[_maktinen_] Yo... Yo.. ¿Soy la única persona normal en este tribunal? ¿Qué está pasando en absoluto... Dios."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1128 #-#-# translate crowdin gallery_d_081_3f84675e:
msgid "[_maktinen_] Мы подозревали Рика с самого начала. И все улики указывали на него. Да, ответ прост - парень приехал в городок и начал учинять беспредел, но оттого ответ и правильный"
msgstr "[_maktinen_] Sospechábamos de Rick desde el principio. Todas las pruebas lo señalaban. Sí, la respuesta es simple: el tipo vino a la ciudad y comenzó a aprender anarquía, pero por lo tanto la respuesta es correcta"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1129 #-#-# translate crowdin gallery_d_081_bbaf0d0a:
msgid "[_maktinen_] Неужели все верят в то, что это просто совпадение, а тот, кто изначально и подозревал Рика, в итоге виновен?"
msgstr "[_maktinen_] ¿Todo el mundo cree que esto es solo una coincidencia, y el que inicialmente sospechaba de Rick es finalmente culpable?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1130 #-#-# translate crowdin gallery_d_081_45a2fe97:
msgid "[_maktinen_] Поймите, на меня просто хотят свалить свою вину и удобно избавиться, чтобы дело не получило дальнейший ход.."
msgstr "[_maktinen_] Entiendan, solo quieren culparme y deshacerse de él cómodamente para que el caso no obtenga más progreso."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1131 #-#-# translate crowdin gallery_d_081_2de8ee13:
msgid "[_maktinen_] Потерпевшие в своих показаниях противоречат сами себе, кто-то путается, а кто-то явно здесь против своей воли.."
msgstr "[_maktinen_] Las víctimas en su testimonio se contradicen a sí mismas, alguien está confundido, y alguien está claramente aquí en contra de su voluntad."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1132 #-#-# translate crowdin gallery_d_081_70de1fdd:
msgid "[_maktinen_] Это же так очевидно.. Вы что, не видете.. Просто взгляните на все это терзвым взглядом.. Я прошу вас.. Он не может просто так остаться безнаказанным.."
msgstr "[_maktinen_] Es muy obvio. No ves... Eche un vistazo con un torze. Te lo estoy pidiendo... No puede quedar impune."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1133 #-#-# translate crowdin gallery_d_081_5c45cd8f:
msgid "[_payne_] Ваша честь, моему подсудимому больше нечего сказать. Мы закончили"
msgstr "[_payne_] Su Señoría, mi acusado no tiene nada que decir. Hemos terminado"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1134 #-#-# translate crowdin gallery_d_081_550a7f0d:
msgid "[_maktinen_] ..."
msgstr "[_maktinen_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1135 #-#-# translate crowdin gallery_d_081_3487baba:
msgid "[_theresa_] Хорошо, Мистер Пейн. В таком случае суд присяжных удаляется для вынесения приговора. У вас есть пол часа"
msgstr "[_theresa_] Es bueno, Sr. Payne. En este caso, el jurado es retirado para la sentencia. Tienes media hora"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1137 #-#-# translate crowdin gallery_d_081_a20cefa7_1:
msgid "..."
msgstr "..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1141 #-#-# translate crowdin gallery_d_081_74de104a:
msgid "[_cedrick_] Что ж, вроде все прошло хорошо. Что думаешь?"
msgstr "[_cedrick_], Bueno, parece que ha ido bien. ¿Qué opinas?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1145 #-#-# translate crowdin gallery_d_081_b04ccec3:
msgid "[_medina_] С одной стороны да, доказательства на твоей стороне. Но с другой.."
msgstr "[_medina_] Por un lado, sí, la evidencia está de tu lado. Pero en el otro..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1149 #-#-# translate crowdin gallery_d_081_ff707ed6:
msgid "[_medina_] Честно говоря, в этом городе ни в чем нельзя быть до конца уверенным, Рик"
msgstr "[_medina_] Honestamente, en esta ciudad no puedes estar completamente seguro, Rick"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1150 #-#-# translate crowdin gallery_d_081_88e7aa65:
msgid "[_medina_] Я читала итоги разных дел в этом суде. Какие-то откровенно куплены, в каких-то приговор был вынесен как будто бы случайно, а не исходя из улик и фактов"
msgstr "[_medina_] He leído los resultados de los diferentes casos en este tribunal. Algunos son comprados francamente, en alguna sentencia se dictaron como por casualidad, y no sobre la base de pruebas y hechos"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1154 #-#-# translate crowdin gallery_d_081_a9726725:
msgid "[_cedrick_] Серьезно? Чего ж мы с тобой тогда так старались?"
msgstr "[_cedrick_] ¿En serio? Entonces, ¿para qué nos esforzamos tanto?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1158 #-#-# translate crowdin gallery_d_081_97c2d6c8:
msgid "[_medina_] Ну, если все пойдет не по плану, то итог суда можно будет обжаловать и выйти на федеральный уровень"
msgstr "[_medina_] Bueno, si todo no va de acuerdo con el plan, el resultado de la corte puede ser apelado y alcanzado el nivel federal"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1159 #-#-# translate crowdin gallery_d_081_a38cee00:
msgid "[_medina_] Мы стараемся здесь для того, чтобы в случае проигрыша у нас были все доказательства, говорящие о том, что этот суд не компетентен"
msgstr "[_medina_] Intentamos aquí asegurar que en caso de pérdida tengamos todas las pruebas de que este tribunal no es competente"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1163 #-#-# translate crowdin gallery_d_081_7076d2b3:
msgid "[_cedrick_] (Что!? Федеральный уровень? Это же еще на несколько месяцев может затянуться.. Какого черта!?)"
msgstr "[_cedrick_] (¿Qué!? ¿El nivel federal? Podría retrasarse unos meses más. ¿¡Qué diablos!?)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1164 #-#-# translate crowdin gallery_d_081_720eff57:
msgid "[_cedrick_] (Да мне проще будет избавиться от всех, кто хоть как-то причастен к этому делу!)"
msgstr "[_cedrick_] (¡Sí, será más fácil para mí deshacerme de todos los que tienen alguna participación en este asunto!)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1165 #-#-# translate crowdin gallery_d_081_5d6db3a1:
msgid "[_cedrick_] (В шахтах каждый день кто-то умирает под обломками, так что мест для новых рабов будет предостаточно!)"
msgstr "[_cedrick_] (¡En las minas todos los días alguien muere bajo los escombros, por lo que habrá mucho para los nuevos esclavos!)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1166 #-#-# translate crowdin gallery_d_081_2ef90216:
msgid "[_cedrick_] (...)"
msgstr "[_cedrick_] (...)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1167 #-#-# translate crowdin gallery_d_081_dadf39ba:
msgid "[_cedrick_] (Так, нужно успокоиться, Седрик.. Смотри на ситуацию разумно, оцени все возможные варианты..)"
msgstr "[_cedrick_] (Entonces, tienes que calmarte, Cedric.. Mire la situación sabiamente, evalúe todas las opciones posibles.)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1168 #-#-# translate crowdin gallery_d_081_f4e4243e:
msgid "[_cedrick_] Как думаешь, в чем причина того, что итоги суда такие непредсказуемые?"
msgstr "[_cedrick_] ¿Cuál cree que es la razón por la que los resultados de la corte son tan impredecibles?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1172 #-#-# translate crowdin gallery_d_081_14bf516b:
msgid "[_medina_] Честно? Мне кажется дело в суде присяжных. В этом маленьком городке на удивление много судебных разбирательств"
msgstr "[_medina_] ¿Sinceramente? Creo que se debe al juicio con jurado. Hay una cantidad sorprendente de procesos judiciales en esta pequeña ciudad."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1176 #-#-# translate crowdin gallery_d_081_672397a3:
msgid "[_medina_] По сути в качестве суда присяжных участвует куда больше людей, чем в принципе есть в этом городе"
msgstr "[_medina_] De hecho, como juicio con jurado involucra a mucha más gente que en principio en esta ciudad"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1180 #-#-# translate crowdin gallery_d_081_9684f419:
msgid "[_medina_] Думаю даже сейчас в числе присяжных есть люди, которым выпадает эта роль уже десятый раз"
msgstr "[_medina_] Piense incluso ahora entre el jurado que hay personas que caen en este papel por décima vez"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1184 #-#-# translate crowdin gallery_d_081_7df32c0a:
msgid "[_cedrick_] Десятый раз, серьезно!? А я все гадал, почему в таком серьезном деле, как похищение учащихся школы, у суда присяжных лица такие безразличные.."
msgstr "[_cedrick_] Décima vez, en serio!? Y me pregunté por qué en un caso tan grave como el secuestro de estudiantes escolares, el jurado tiene tanta indiferencia."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1188 #-#-# translate crowdin gallery_d_081_9440ee90:
msgid "[_medina_] Верно, все решают люди, которым все это осточертело. Кто-то хочет успеть на любимое шоу по телеку, кому-то нужно выгулять собаку, а кто-то надеется раньше освободиться и заглянуть к любовнице"
msgstr "[_medina_] Es cierto, todo lo decide la gente que está cansada de Él. Alguien quiere tener tiempo para un programa favorito en la televisión, alguien necesita pasear al perro, y alguien espera liberarse antes y mirar a la amante"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1192 #-#-# translate crowdin gallery_d_081_2509d016:
msgid "[_medina_] Мактиннен в чем-то прав, по итогу это и вправду фарс. Итоговое решение ложится на плечи тех, кому вообще плевать и на наше дело и на правосудие"
msgstr "[_medina_] Maktinen tiene razón en algo, como resultado, es realmente una farsa. La decisión final recae sobre los hombros de aquellos que generalmente no se preocupan por nuestra causa y justicia"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1196 #-#-# translate crowdin gallery_d_081_d8ae4a82:
msgid "[_cedrick_] (Да уж, этого я не предвидел.. В этом городке очень мало жителей и довольно много преступлений, логично, что каждый из них как минимум пару раз да был присяжным..)"
msgstr "[_cedrick_] (Sí, no lo preveí. Hay muy pocos residentes en esta ciudad y bastantes crímenes, es lógico que cada uno de ellos fuera un jurado al menos un par de veces.)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1197 #-#-# translate crowdin gallery_d_081_43860502:
msgid "[_cedrick_] (Черт, да я же буквально видел среди присяжных учителя физкультуры из нашей школы.. К слову, как всегда пьянющего. Но, как минимум один голос в мою пользу есть)"
msgstr "[_cedrick_] (Maldita sea, sí, literalmente vi entre los jurados de la educación física de nuestra escuela. Por cierto, como siempre borracho. Pero al menos un voto a mi favor es)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1198 #-#-# translate crowdin gallery_d_081_9910f23d:
msgid "[_cedrick_] (Думай, Седрик.. Должен быть способ хоть как-то на это повлиять.. Подкуп присяжных? Запугивание Пэйна? Давление на судью?)"
msgstr "[_cedrick_] (Piensa, Cedric.. Debe haber una manera de influir en él de alguna manera. ¿Bribal del jurado? ¿Intimidación de Payne? ¿Presión sobre el juez?)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1199 #-#-# translate crowdin gallery_d_081_2ef90216_1:
msgid "[_cedrick_] (...)"
msgstr "[_cedrick_] (...)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1200 #-#-# translate crowdin gallery_d_081_c831707c:
msgid "[_cedrick_] (Погодите ка..)"
msgstr "[_cedrick_] (Espera A..)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1201 #-#-# translate crowdin gallery_d_081_05d1772a:
msgid "[_cedrick_] Медина, но за кем тогда финальное решение? Если суду присяжный по сути плевать на итоги суда, то кто направляет это безмозглое стадо?"
msgstr "[_cedrick_] Medina, pero ¿quién es la solución final? Si al jurado realmente no le importan los resultados de la corte, entonces, ¿quién dirige esta manada descerebrada?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1205 #-#-# translate crowdin gallery_d_081_014bfe1a:
msgid "[_medina_] Хм, думаю это судья"
msgstr "[_medina_] Hmm, creo que es el juez"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1206 #-#-# translate crowdin gallery_d_081_0b6d5111:
msgid "[_cedrick_] (Как я и думал. Значит, все мои предыдущие старания в суде ничего не стоили и итоговое решение на судье? Хах..)"
msgstr "[_cedrick_] (Como pensaba. Entonces, ¿todos mis esfuerzos anteriores en la corte no costaron nada y la decisión final sobre el juez? Hach..)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1210 #-#-# translate crowdin gallery_d_081_efdab6e0:
msgid "[_cedrick_] (К счастью для меня, мне есть, чем на нее повлиять. Хм..)"
msgstr "[_cedrick_] (Afortunadamente, tengo algo que influir en ella. Hmm.)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1211 #-#-# translate crowdin gallery_d_081_eb0117d5:
msgid "[_cedrick_] Медина, а не подскажешь, где именно здесь кабинет судьи? Где она может быть до заседания с присяжными?"
msgstr "[_cedrick_] Medina, ¿y no puede decirme dónde está la oficina del juez? ¿Dónde puede estar ante el jurado?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1215 #-#-# translate crowdin gallery_d_081_1d54f18a:
msgid "[_medina_] Рик.. Ты же не хочешь.."
msgstr "[_medina_] Rick. No quieres..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1216 #-#-# translate crowdin gallery_d_081_f5800758:
msgid "[_cedrick_] Ты же сама сказала, что этот суд не справедлив. Так как еще нам бороться с этой несправедливостью?"
msgstr "[_cedrick_] Dijiste que este tribunal no era justo. Entonces, ¿de qué otra manera podemos luchar contra esta injusticia?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1217 #-#-# translate crowdin gallery_d_081_c84dde68:
msgid "[_medina_] Ты хочешь бороться с ней еще большей несправедливостью.. Я поддерживаю твое стремление отстоять справедливость, но только когда это происходит в рамках правового поля"
msgstr "[_medina_] Quieres luchar contra ella aún más injusticia. Apoyo su deseo de defender la justicia, pero sólo cuando sucede dentro del marco legal"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1218 #-#-# translate crowdin gallery_d_081_7db0bd64:
msgid "[_cedrick_] (Точно же.. Я убедил Медину встать на мою сторону, поработав над ее сознанием, но ее личность при этом не поменялась)"
msgstr "[_cedrick_] (Solo... Convencí a Medina de ponerse de mi lado, trabajando en su conciencia, pero su personalidad no cambió)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1219 #-#-# translate crowdin gallery_d_081_93112e59:
msgid "[_cedrick_] (Она на моей стороне, потому что она верит, что я невиновен, а не потому что она решила переметнуться на темную сторону.. Не стоит об этом забывать)"
msgstr "[_cedrick_] (Ella está de mi lado porque cree que soy inocente, no porque decida cambiar al lado oscuro. No te olvides de esto)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1223 #-#-# translate crowdin gallery_d_081_264cdb56:
msgid "[_cedrick_] Да, прости, ты права, что-то меня понесло.."
msgstr "[_cedrick_] Sí, lo siento, tienes razón, algo me ha jodido..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1227 #-#-# translate crowdin gallery_d_081_57ff66c7:
msgid "[_medina_] Я понимаю. Иногда хочется перейти черту, но то, что мир несправедлив не дает нам права также переходить черту закона. Иначе мы станет ничем не лучше.."
msgstr "[_medina_] Lo entiendo. A veces quieres cruzar la línea, pero el hecho de que el mundo sea injusto no nos da el derecho de cruzar la línea de la ley también. De lo contrario, no estaremos mejor..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1228 #-#-# translate crowdin gallery_d_081_805095fc:
msgid "[_cedrick_] (Говорит практически как супергероиня, надо же. Она и вправду пример для подражания тем, кто верит в добро и справедливость)"
msgstr "[_cedrick_] (Habla casi como un superhéroe, quiero decir. Es realmente un ejemplo para seguir a aquellos que creen en el bien y la justicia)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1229 #-#-# translate crowdin gallery_d_081_ec0972e9:
msgid "[_cedrick_] (На Меридиане людей таких же, как она, выступающих моральными камертонами, я первым делом публично казнил на площади, чтобы другие знали, что с ними станет, если последуют такому примеру)"
msgstr "[_cedrick_] (En el meridiano, personas como ella actuando en la sintonía moral, primero ejecuté públicamente en la plaza para que otros supieran lo que les pasaría si siguen su ejemplo)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1233 #-#-# translate crowdin gallery_d_081_61675bbd:
msgid "[_cedrick_] (А теперь такой же человек защищает меня в суде, хах, иронично..)"
msgstr "[_cedrick_] (Y ahora la misma persona me protege en la corte, ja, irónicamente.)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1234 #-#-# translate crowdin gallery_d_081_0fa97652:
msgid "[_cedrick_] (Что ж, за сотни лет я достаточно часто сталкивался с такими людьми, чтобы понять принцип их мышления)"
msgstr "[_cedrick_] (Bueno, en cientos de años me he encontrado con tales personas lo suficiente como para entender el principio de su pensamiento)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1235 #-#-# translate crowdin gallery_d_081_4b00044a:
msgid "[_cedrick_] (На сколько морально нравственными они бы ни были, даже они не могут отрицать испорченность этого мира и того, что поступая всегда правильно ты мало чего добьешься)"
msgstr "[_cedrick_] (Cuánto moralmente morales son, incluso ellos no pueden negar la depravación de este mundo y que al hacer siempre lo correcto se logra poco)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1236 #-#-# translate crowdin gallery_d_081_51c7cdff:
msgid "[_cedrick_] (У всех грань дозволенного разная. Я просто должен нащупать ее грань, чтобы найти к ней подход)"
msgstr "[_cedrick_] (Todos tienen límites diferentes. Solo tengo que encontrar su cara para encontrar su enfoque."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1240 #-#-# translate crowdin gallery_d_081_a5c987ea:
msgid "[_medina_] Рик? Все хорошо? Ты вдруг просто погрузился в себя"
msgstr "[_medina_] ¿Rick? ¿Está bien? De repente te sumergiste"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1244 #-#-# translate crowdin gallery_d_081_df90ed52:
msgid "[_cedrick_] Эм, да.. Все хорошо, я просто.. Просто засмотрелся на твою грудь"
msgstr "[_cedrick_] Mm, sí. Está bien, solo... Solo mirando tus pechos"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1248 #-#-# translate crowdin gallery_d_081_184072b2:
msgid "[_medina_] Ахах, ах ты проказник..."
msgstr "[_medina_] Ahhhhhhhh"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1252 #-#-# translate crowdin gallery_d_081_3b091406:
msgid "[_medina_] Знаешь, смотря на то, как жестко и мужественно ты отстаиваешь свои права в суде, ух, так и хотелось, чтобы ты так же жестко и мужественно меня трахнул.."
msgstr "[_medina_] Sabes lo duro y valiente que defiendes tus derechos en la corte, así que querías que me cogieras igual de duro y valientemente."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1256 #-#-# translate crowdin gallery_d_081_286e3a80:
msgid "[_cedrick_] Ммммм, а ты не такая уж и святая"
msgstr "[_cedrick_] Mmmmm, y no eres tan sagrado"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1260 #-#-# translate crowdin gallery_d_081_d4a01cb5:
msgid "[_medina_] Н-но, мы в суде.. Пока что нужно заняться делом, потом будем думать о подобном разврате"
msgstr "[_medina_] N-no, estamos en la corte .. Si bien necesita hacer negocios, pensaremos en tal depravación"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1264 #-#-# translate crowdin gallery_d_081_1593ec29:
msgid "[_cedrick_] Хах, верно. Медина, я хочу попасть к Терезе"
msgstr "[_cedrick_] Hach, cierto. Medina, quiero llegar a Teresa"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1268 #-#-# translate crowdin gallery_d_081_f55446bd:
msgid "[_medina_] Рик, мы же только что обсуждали.."
msgstr "[_medina_] Rick, acabamos de hablar..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1272 #-#-# translate crowdin gallery_d_081_3e2f7eaf:
msgid "[_cedrick_] Я просто хочу с ней поговорить. Без давления и шантажа. Хочу убедиться в том, что раз судебная система так прогнила, то она хотя бы понимает, какая на ее плечах ответственность"
msgstr "[_cedrick_] Solo quiero hablar con ella. Sin presión ni chantaje. Quiero asegurarme de que, dado que el sistema judicial está tan podrido, al menos entienda lo que la responsabilidad tiene sobre sus hombros"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1273 #-#-# translate crowdin gallery_d_081_8e9eedde:
msgid "[_cedrick_] Она одна выносит решение за весь суд присяжных. Я хочу лично убедиться, что такая ответственность в руках правильного человека"
msgstr "[_cedrick_] Ella uno toma una decisión para todo el juicio con jurado. Quiero asegurarme personalmente de que tal responsabilidad esté en manos de la persona adecuada"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1277 #-#-# translate crowdin gallery_d_081_068fbc10:
msgid "[_medina_] Хах, поняла тебя, Рик.. Да, от этого решения будет зависеть твоя дальнейшая жизнь. Вполне естественно, что ты хочешь лучше узнать того, кто решит твою судьбу"
msgstr "[_medina_] Hach, te atrapo, Rick... Sí, tu vida futura dependerá de esta decisión. Es bastante natural que quieras saber mejor quién decide tu destino"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1278 #-#-# translate crowdin gallery_d_081_001fadd9:
msgid "[_cedrick_] Верно. Поможешь мне в этом? Я хочу узнать, в каком она кабинете"
msgstr "[_cedrick_] es cierto. ¿Me ayudarás con eso? Quiero saber en qué oficina está"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1282 #-#-# translate crowdin gallery_d_081_659887ce:
msgid "[_medina_] Да, конечно. Есть 3 главных судебных кабинета, по одному на каждое крыло в здании. Но перед собранием с судом присяжных все эти кабинеты пустуют"
msgstr "[_medina_] Sí, por supuesto. Hay 3 oficinas principales de la corte, una por cada ala en el edificio. Pero antes de la reunión con el jurado, todas estas oficinas están vacías"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1286 #-#-# translate crowdin gallery_d_081_8583f226:
msgid "[_medina_] Вернее они нужны для отвлечения внимания. Хоть система суда уже не работает, но старые протоколы безопасности все еще четко соблюдаются"
msgstr "[_medina_] O mejor dicho, son necesarios para distraer la atención. Aunque el sistema judicial ya no funciona, pero los viejos protocolos de seguridad todavía se observan claramente"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1287 #-#-# translate crowdin gallery_d_081_6fd4ccf2:
msgid "[_medina_] Сама судья же это время находится в неприметном кабинете, коих в этом здании множество. Кабинет 69, на сколько я могу судить"
msgstr "[_medina_] La propia jueza está en una oficina discreta, que hay muchas en este edificio. Oficina 69, por lo que puedo juzgar"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1291 #-#-# translate crowdin gallery_d_081_49316299_1:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1292 #-#-# translate crowdin gallery_d_081_f09adb0a:
msgid "[_cedrick_] И откуда у тебя вся эта информация, позволь поинтересоваться? Ты же сама сказала, что протоколы безопасности соблюдаются"
msgstr "[_cedrick_] ¿Y de dónde sacas toda esta información, déjame preguntar? Usted mismo ha dicho que se observan los protocolos de seguridad"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1296 #-#-# translate crowdin gallery_d_081_cb0f5516:
msgid "[_medina_] Все просто. Я соотнесла расположение охраны, просматриваемые камерами углы, доступность к безопасным коридорам выхода на экстренный случай.."
msgstr "[_medina_] Es fácil. Correlacioné la ubicación de la seguridad, los ángulos vistos por las cámaras, la accesibilidad a los corredores seguros de emergencia."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1301 #-#-# translate crowdin gallery_d_081_e66c02fa:
msgid "[_medina_] И поняла, что самые подходящие кабинеты - это 42 и 69. У многих дверей в здании стоит охрана, но из двух этих кабинетов охрана только у номера 69. Так что..."
msgstr "[_medina_] Y se dio cuenta de que las oficinas más adecuadas son 42 y 69. Muchas puertas en el edificio están vigiladas, pero de estas dos oficinas, la seguridad solo en el número 69. Así que..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1305 #-#-# translate crowdin gallery_d_081_624102c0:
msgid "[_cedrick_] (Вот это да.. Иногда я забываю о том, что она одна из самых успешных правительственных агентов и детективов.. Ее навыки реально внушают страх"
msgstr "[_cedrick_] (Aquí está el día. A veces olvido que ella es uno de los agentes y detectives del gobierno más exitosos. Sus habilidades realmente inspiran miedo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1306 #-#-# translate crowdin gallery_d_081_e55d47da:
msgid "[_cedrick_] Черт.. Мастерство не пропьешь, да?"
msgstr "[_cedrick_] Maldita Sea. No puedes beber habilidad, ¿verdad?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1310 #-#-# translate crowdin gallery_d_081_73fa2fda:
msgid "[_medina_] Хах, типо того.."
msgstr "[_medina_] Hach, así."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1312 #-#-# translate crowdin gallery_d_081_b76892db:
msgid "[_cedrick_] Что ж, тогда отправлюсь к кабинету 69"
msgstr "[_cedrick_] Bueno, entonces iré a la oficina 69"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1316 #-#-# translate crowdin gallery_d_081_38993681:
msgid "[_medina_] Да, удачи там"
msgstr "[_medina_] Sí, buena suerte allí"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1324 #-#-# translate crowdin gallery_d_081_bea78604:
msgid "[_cedrick_] (Так, как Медина и говорила, два охранника у двери. Что ж, самое время использовать мой дар красноречия)"
msgstr "[_cedrick_] (Así como dijo Medina, dos guardias en la puerta. Bueno, es hora de usar mi don de elocuencia)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1330 #-#-# translate crowdin gallery_d_081_0bea0951:
msgid "[_cedrick_] Здравствуйте, господа. Не подскажете ли.."
msgstr "[_cedrick_] Hola, señores. ¿Podría decirme...?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1334 #-#-# translate crowdin gallery_d_081_02e755f8:
msgid "[_security_guard_1_] Так, мужик, два шага назад от двери"
msgstr "[_security_guard_1_] Así que, hombre, a dos pasos de la puerta"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1338 #-#-# translate crowdin gallery_d_081_92c7b40e:
msgid "[_cedrick_] Ч-что, простите? Я просто хотел спросить"
msgstr "[_cedrick_] Ch-qué, lo siento. Solo quería preguntar"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1344 #-#-# translate crowdin gallery_d_081_68d7cb2a:
msgid "[_security_guard_2_] Роб, мужик не понял. Он походу хочет сказать, что ты плохо дносишь свою мысль"
msgstr "[_security_guard_2_] Rob, el hombre no lo entendía. Él quiere decir que no estás trayendo mal tu pensamiento"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1350 #-#-# translate crowdin gallery_d_081_edb06ae4:
msgid "[_rob_] Ты так думаешь, Боб?"
msgstr "[_rob_] ¿Estás pensando, Bob?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1356 #-#-# translate crowdin gallery_d_081_bec4e763:
msgid "[_rob_] Эй, мужик, ты чо, хочешь сказать, что я тупой?"
msgstr "[_rob_] Oye, tío, ¿qué estás diciendo que soy estúpido?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1360 #-#-# translate crowdin gallery_d_081_7ff2cb2b:
msgid "[_cedrick_] Эм.. Господа, можно быть немного спокойнее, я же просто хотел.."
msgstr "[_cedrick_] Mm. Caballeros, pueden estar un poco más tranquilos, solo quería..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1366 #-#-# translate crowdin gallery_d_081_a1e7857f:
msgid "[_bob_] Роб, он сначала назвал тебя тупым, а теперь еще и говорит, что мы буйные. Ну-ка втащи ему"
msgstr "[_bob_] Rob, primero te llamó estúpido, y ahora también dice que somos violentos. Bueno, arrástralo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1372 #-#-# translate crowdin gallery_d_081_fdb24f4b:
msgid "[_rob_] И то верно, Боб. За такие слова и по морда дать можно. Эй, мужик. Два шага вперед, чтобы я мог тебе втащить не сходя с места"
msgstr "[_rob_] Y así es, Bob. Para tales palabras y en la cara se puede dar. Oye, hombre. Dos pasos adelante para que pueda arrastrarte sin bajar"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1373 #-#-# translate crowdin gallery_d_081_85dfb8f1:
msgid "[_cedrick_] (Я понял.. Таких гениев мысли я вряд ли смогу в чем-то убедить. Черепушки этих ребят не прошибаемы до любых аргументов. Уверен их и удар биты по голове не с первого раза прошибет)"
msgstr "[_cedrick_] (Entiendo... Difícilmente puedo convencer a esos genios del pensamiento. Las tortugas de estos tipos no están insinuadas en ningún argumento. Estoy seguro de ellos y el golpe del bate en la cabeza no será la primera vez)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1379 #-#-# translate crowdin gallery_d_081_07d845bc:
msgid "[_cedrick_] (В любой другой ситуации я мог бы их просто сожрать, но сейчас..)"
msgstr "[_cedrick_] (En cualquier otra situación, solo podía comerlos, pero ahora.)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1380 #-#-# translate crowdin gallery_d_081_10920807:
msgid "[_cedrick_] (Надо придумать новый план..)"
msgstr "[_cedrick_] (Tenemos que idear un nuevo plan.)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1386 #-#-# translate crowdin gallery_d_081_d424f5d5:
msgid "[_bob_] Эй, мужик, ты куда пошел? А ну вернись сюда. Чо, зассал!? Роб, видал, он зассал!"
msgstr "[_bob_] Oye, hombre, ¿a dónde vas? Vuelve aquí. ¿¡Qué, apestó!? ¡Rob, lo vio!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1390 #-#-# translate crowdin gallery_d_081_8d7a2a0f:
msgid "[_rob_] Да, Боб, бежит от нас как маленькая напуганная девочка. Иди поплачь, сыкло!"
msgstr "[_rob_] Sí, Bob, está huyendo de nosotros como una niña asustada. ¡Ven a llorar, es un idiota!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1391 #-#-# translate crowdin gallery_d_081_c9b78037:
msgid "[_cedrick_] (Ну и что мне делать с этими полудурком.. У них мозгов не больше, чем у стражников на Меридиане.. С такими я привык всегда разговаривать с помощью грубой силы)"
msgstr "[_cedrick_] (Bueno, ¿qué puedo hacer con estos semi-tontos .. No tienen más cerebro que los guardias de Meridian. Con esto estoy acostumbrado a hablar siempre con fuerza bruta)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1393 #-#-# translate crowdin gallery_d_081_a98f9e7e:
msgid "[_cedrick_] (Хм, подожди, Седрик.. Хватит работать в одиночку, ты больше не один. У тебя напарники, используй их)"
msgstr "[_cedrick_] (Hmm, espera, Cedric.. Deja de trabajar sola, ya no estás sola. Tienes a tu pareja, úsalos)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1394 #-#-# translate crowdin gallery_d_081_07f5d605:
msgid "[_cedrick_] (Уговоры на них вряд ли сработают. Но это значит, что сработает кое-что другое)"
msgstr "[_cedrick_] (Es poco probable que las perceses sobre ellos funcionen. Pero eso significa que algo más funcionará.)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1397 #-#-# translate crowdin gallery_d_081_3aeb8b02:
msgid "[_centered_] {size=37}СПУСТЯ НЕКОТОРОЕ ВРЕМЯ{/size} [withDissolve1]"
msgstr "[_centered_] {size=37}DESPUÉS DE UN TIEMPO{/size} [withDissolve1]"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1402 #-#-# translate crowdin gallery_d_081_8d3dfc28:
msgid "[_medina_] Охрана, срочно, нужно ваше вмешательство"
msgstr "[_medina_] Seguridad, urgentemente, necesita su intervención"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1406 #-#-# translate crowdin gallery_d_081_5b91ed65:
msgid "[_bob_] О, женщина"
msgstr "[_bob_] Oh, mujer"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1412 #-#-# translate crowdin gallery_d_081_121ba8b4:
msgid "[_rob_] Что тебе нужно, женщина? Мы на работе"
msgstr "[_rob_] ¿Qué quieres, mujer? Estamos en el trabajo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1416 #-#-# translate crowdin gallery_d_081_8f5b4dbd:
msgid "[_medina_] Подсудимые начали драку в туалете в соседнем крыле. Весь туалет уже в крови, никто не может их остановить. Из ближайших охранников только вы"
msgstr "[_medina_] Los acusados comenzaron una pelea en el baño en el siguiente ala. Todo el inodoro ya está en la sangre, nadie puede detenerlos. De los guardias más cercanos, solo tú"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1422 #-#-# translate crowdin gallery_d_081_f93d0dc2:
msgid "[_bob_] Не наше дело. Пусть цыплята участвуют в своих цыплячих бегах, волков это не касается, да, Роб?"
msgstr "[_bob_] no es asunto nuestro. Deja que los pollos participen en su carrera de pollos, los lobos no se preocupan, ¿no robas?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1426 #-#-# translate crowdin gallery_d_081_7a2a97ec:
msgid "[_rob_] Верно, Боб. Как там говорила мама? Волк пусть и слабее льва и тигра, но в цирке не выступает. Вот и мы не будем участвовать в этом туалетном цирке. У нас своя работа"
msgstr "[_rob_] es cierto, Bob. ¿Cómo lo dijo mamá? El lobo es más débil que un león y un tigre, pero no actúa en el circo. No vamos a estar en este circo de baño. Tenemos nuestro propio trabajo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1430 #-#-# translate crowdin gallery_d_081_e8e1f0cc:
msgid "[_bob_] Точно, Роб"
msgstr "[_bob_] Exactamente, robo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1437 #-#-# translate crowdin gallery_d_081_e0ad4430:
msgid "[_medina_] ..."
msgstr "[_medina_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1438 #-#-# translate crowdin gallery_d_081_e0ad4430_1:
msgid "[_medina_] ..."
msgstr "[_medina_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1439 #-#-# translate crowdin gallery_d_081_cf44e150:
msgid "[_medina_] Еще в том же туалете кто-то написал маркером, что Роб и Боб после работы, кхм, долбят друг друга в жопы"
msgstr "[_medina_] Incluso en el mismo inodoro, alguien escribió un marcador que roba y Bob después del trabajo, hmm, se golpearán entre sí en el culo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1445 #-#-# translate crowdin gallery_d_081_0c17fa85:
msgid "[_rob_] ..."
msgstr "[_rob_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1451 #-#-# translate crowdin gallery_d_081_45015009:
msgid "[_bob_] ..."
msgstr "[_bob_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1455 #-#-# translate crowdin gallery_d_081_4f444cad:
msgid "[_rob_] Боб, пойди разберись"
msgstr "[_rob_] Bob, ve a averiguarlo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1461 #-#-# translate crowdin gallery_d_081_9c784e47:
msgid "[_bob_] А почему я?"
msgstr "[_bob_] ¿Por qué yo?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1465 #-#-# translate crowdin gallery_d_081_f6c1744a:
msgid "[_rob_] Я в прошлый раз разбирался, твоя очередь"
msgstr "[_rob_] Lo estaba mirando la última vez, tu turno"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1469 #-#-# translate crowdin gallery_d_081_f54d0b9b:
msgid "[_bob_] Ух, ладно, пойду разберусь. Заодно унему цыплят. Ты оставайся тут, Роб"
msgstr "[_bob_] Uh, está bien, iré a averiguarlo. Voy a comer pollos al mismo tiempo. Quédate aquí, Rob"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1474 #-#-# translate crowdin gallery_d_081_acea9252:
msgid "[_rob_] Да, Боб"
msgstr "[_rob_] Sí, Bob"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1477 #-#-# translate crowdin gallery_d_081_39ba4e36:
msgid "[_centered_] {size=37}СПУСТЯ 5 МИНУТ{/size} [withDissolve1]"
msgstr "[_centered_] {size=37}DESPUÉS DE 5 MINUTOS{/size} [withDissolve1]"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1482 #-#-# translate crowdin gallery_d_082_318a6a90:
msgid "[_cornelia_] Дядя охранник, вы мне не поможете?"
msgstr "[_cornelia_] Señor guardia, ¿podría ayudarme?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1486 #-#-# translate crowdin gallery_d_082_faaae709:
msgid "[_rob_] Что? Девушка? Уходи отсюда, я работаю"
msgstr "[_rob_] ¿Qué? ¿Una chica? Sal de aquí, estoy trabajando."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1490 #-#-# translate crowdin gallery_d_082_f038cadf:
msgid "[_cornelia_] Но мне очень нужна ваша помощь в одном деле.."
msgstr "[_cornelia_] Pero realmente necesito tu ayuda en un solo negocio."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1494 #-#-# translate crowdin gallery_d_082_547ca58f:
msgid "[_rob_] Я. Работаю. Ничто не сдвинет меня с этого места, пока Боб не вернется"
msgstr "[_rob_] Yo. Estoy trabajando. Nada me sacará de este lugar hasta que Bob regrese"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1498 #-#-# translate crowdin gallery_d_082_60d720e3:
msgid "[_cornelia_] Пф.. А если я тебе заплачу"
msgstr "[_cornelia_] Pf. Y si te pago"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1502 #-#-# translate crowdin gallery_d_082_6d3648b4:
msgid "[_rob_] Деньги не интересуют Роба. Деньги - это социальный конструкт, ценность которого навязана капиталистическим государственным строем"
msgstr "[_rob_] El dinero no está interesado en robar. El dinero es una construcción social, cuyo valor es impuesto por el sistema estatal capitalista"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1506 #-#-# translate crowdin gallery_d_082_715de0c2:
msgid "[_rob_] Роб против денежной эксплуатации. Роб выступает за коммунизм и общее равенство"
msgstr "[_rob_] Rob vs explotación de efectivo. Rob representa el comunismo y la igualdad común"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1510 #-#-# translate crowdin gallery_d_082_13c717d6:
msgid "[_cornelia_] ..."
msgstr "[_cornelia_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1511 #-#-# translate crowdin gallery_d_082_13c717d6_1:
msgid "[_cornelia_] ..."
msgstr "[_cornelia_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1515 #-#-# translate crowdin gallery_d_082_28a8c6cc:
msgid "[_cornelia_] Хорошо, а будешь ли ты против такого?"
msgstr "[_cornelia_] Es bueno, ¿estarás en contra?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1519 #-#-# translate crowdin gallery_d_082_0c17fa85:
msgid "[_rob_] ..."
msgstr "[_rob_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1521 #-#-# translate crowdin gallery_d_082_7f88f8d3:
msgid "[_rob_] Роб не против."
msgstr "[_rob_] A Rob no le importa."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1523 #-#-# translate crowdin gallery_d_082_e7d3449a:
msgid "[_cornelia_] Тогда может найдем какое-нибудь укромное местечко и я покажу тебе больше?"
msgstr "[_cornelia_] Entonces tal vez podamos encontrar un lugar aislado y te mostraré más."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1525 #-#-# translate crowdin gallery_d_082_ca5fa364:
msgid "[_cornelia_] Что скажешь, здоровяк"
msgstr "[_cornelia_] Qué dices, grandío"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1526 #-#-# translate crowdin gallery_d_082_f1c9e886:
msgid "[_rob_] Роб.. не против."
msgstr "[_rob_] Rob... No en contra de ella."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1527 #-#-# translate crowdin gallery_d_082_3677c886:
msgid "[_cornelia_] (Ну еще бы.. Что ж, теперь главное отвести его как можно дальше и сбежать)"
msgstr "[_cornelia_] (Bueno, más... Bueno, ahora lo principal es llevarlo lo más lejos posible y escapar)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1529 #-#-# translate crowdin gallery_d_082_3086b4d4:
msgid "[_cornelia_] (Если начнет приставать, просто вдарю по нему как следует водой. Хотя нет.. Нападу еще до того, как он начнет приставать, чтобы наверняка)"
msgstr "[_cornelia_] (Si empiezas a molestar, solo le daré el agua. Aunque No. El ataque incluso antes de que comience a molestar, sin duda)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1532 #-#-# translate crowdin gallery_d_082_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1535 #-#-# translate crowdin gallery_d_082_4a522c8a:
msgid "[_cedrick_] (Хах, девочки отлично справились со своей задачей, даже несмотря на то, что обеим пришлось импровизировать, молодцы)"
msgstr "[_cedrick_] (Hach, las chicas hicieron un gran trabajo, a pesar de que ambas tuvieron que improvisar, bien hechas)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1536 #-#-# translate crowdin gallery_d_082_fc25a2e6:
msgid "[_cedrick_] (От Медины я этого и ожидал, но вот Корнелия. Да, показывает себя все лучше и лучше)"
msgstr "[_cedrick_] (Esperaba eso de Medina, pero aquí está Cornelia. Sí, se muestra mejor y mejor)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1539 #-#-# translate crowdin gallery_d_083_45641f05:
msgid "[_cedrick_] (Что ж, самое время мне навестить нашу дорогую судью и решить наконец это дело)"
msgstr "[_cedrick_] (Bueno, es hora de que visite a nuestro querido juez y finalmente decida este caso)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1540 #-#-# translate crowdin gallery_d_083_1084fcd1:
msgid "[_cedrick_] (Хах, ну и кабинет она конечно выбрала.. 69.. В таком можно и развлечься в соответствующей позе)"
msgstr "[_cedrick_] (Ja, bueno, eligió la oficina, por supuesto. 69.. En esto puedes divertirte en la posición apropiada)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1547 #-#-# translate crowdin gallery_d_083_dbf988ca:
msgid "[_theresa_] Что? Рик, что вы здесь делаете? Вам нельзя здесь находиться, вы один из подсудимых в деле, которое я веду"
msgstr "[_theresa_] ¿Qué? Rick, ¿qué hace aquí? No puede estar aquí; es uno de los acusados en el caso que presido."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1548 #-#-# translate crowdin gallery_d_083_063e1cd5:
msgid "[_cedrick_] Ох, простите, Тереза, я просто.."
msgstr "[_cedrick_] Oh, lo siento, Teresa, solo..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1552 #-#-# translate crowdin gallery_d_083_0482966c:
msgid "[_theresa_] Меня не интересует причина, Рик, покиньте помещение"
msgstr "[_theresa_] No estoy interesado en la razón, Rick, salir de la habitación"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1556 #-#-# translate crowdin gallery_d_083_ccbc3172:
msgid "[_cedrick_] Я хотел поговорить об обвинениях в адрес вашего мужа"
msgstr "[_cedrick_] Quería hablar de acusaciones contra su marido"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1560 #-#-# translate crowdin gallery_d_083_889b1371:
msgid "[_theresa_] Ч-что, простите? Это угроза. Рик, если ты здесь для того, чтобы как-то повлиять на ход дела, я вызову охрану"
msgstr "[_theresa_] Ch-qué, lo siento. Es una amenaza. Rick, si estás aquí para influir en el progreso del caso, llamaré a los guardias"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1564 #-#-# translate crowdin gallery_d_083_42eb6661:
msgid "[_cedrick_] Охрана не придет, Тереза. По крайней мере в следующие 15 минут. Тревожной кнопки в этом кабинете, я уверен, нет, ведь не стали бы вы переоборудовать обычный кабинет на такой случай"
msgstr "[_cedrick_] Los guardias no vendrán, Theresa. Al menos en los próximos 15 minutos. Un botón alarmante en esta oficina, estoy seguro que no, porque no renovaría la oficina habitual para tal caso"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1565 #-#-# translate crowdin gallery_d_083_ece13ac5:
msgid "[_cedrick_] Все потому что в вашем суде работают кретины и жулики, что проявляется даже в таких мелочах, не говоря уже о пересмотре системы суда присяжных"
msgstr "[_cedrick_] Todo porque en su corte hay cretino y ladrones, que se manifiesta incluso en tales tonterías, por no hablar de la revisión del sistema de jurados"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1569 #-#-# translate crowdin gallery_d_083_eb569c58:
msgid "[_cedrick_] А это значит, Тереза, что следующие 15 минут я могу делать с тобой все, что захочу. И это в первую очередь результат твоей собственной некомпетенции"
msgstr "[_cedrick_] Y eso significa, Theresa, que durante los próximos quince minutos puedo hacer contigo lo que quiera. Todo esto es, ante todo, consecuencia de tu propia incompetencia."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1573 #-#-# translate crowdin gallery_d_083_c7cada68:
msgid "[_theresa_] ...Я буду кричать"
msgstr "[_theresa_] ... Voy a gritar"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1575 #-#-# translate crowdin gallery_d_083_75f461d6:
msgid "[_cedrick_] Не будешь, если не хочешь, чтобы на следующий же день все газеты кричали о том, что твой муж шарлатан, а ты судья, подкупающий полицию"
msgstr "[_cedrick_] No lo estarás, si no quieres que todos los periódicos griten que tu marido está charlatán al día siguiente, y eres un juez que soborna a la policía"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1579 #-#-# translate crowdin gallery_d_083_04b5f457:
msgid "[_theresa_] У тебя нет доказательств.."
msgstr "[_theresa_] No tienes pruebas."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1580 #-#-# translate crowdin gallery_d_083_31085271:
msgid "[_cedrick_] Хах, ты думаешь я пришел бы сюда, будь у меня на руках лишь пустые слова? Вот, смотри"
msgstr "[_cedrick_] Hah, ¿crees que vendría aquí si solo tuviera palabras vacías en mis manos? Aquí, mira"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1585 #-#-# translate crowdin gallery_d_083_8c1e4214:
msgid "[_gordon_on_the_phone_] Да уж, Тереза, и как только ты до этого докатилась? Делаешь мне минет на рабочем месте, прямо под столом. Как не стыдно?"
msgstr "[_gordon_on_the_phone_] Vaya, Theresa, ¿cómo llegaste a esto? Me haces una mamada en el trabajo, justo debajo del escritorio. ¿No te da vergüenza?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1586 #-#-# translate crowdin gallery_d_083_10d3ae28:
msgid "[_theresa_] Ч-что!? Откуда у тебя эта запись!?.."
msgstr "[_theresa_] ¿¡Qué!? ¿De dónde sacaste este disco?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1588 #-#-# translate crowdin gallery_d_083_e1a08dea:
msgid "[_theresa_] Гордон, ублюдок, это он отдал ее.."
msgstr "[_theresa_] Gordon, bastardo, se lo dio a..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1590 #-#-# translate crowdin gallery_d_083_21e6451b:
msgid "[_cedrick_] Не так важно, откуда у меня эта запись. Важно то, что ты, Тереза, по сути такая же преступница, как и те, кого ты судишь"
msgstr "[_cedrick_] No le importa de dónde saqué este disco. Lo importante es que tú, Theresa, eres esencialmente la misma criminal que los que estás en juicio"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1591 #-#-# translate crowdin gallery_d_083_9528c724:
msgid "[_gordon_on_the_phone_] Если хочешь на кого-то злиться, то злись на своего непутевого мужа.."
msgstr "[_gordon_on_the_phone_] Si quieres enojarte con alguien, enójate con ese marido inútil que tienes..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1593 #-#-# translate crowdin gallery_d_083_a8d2ea78:
msgid "[_theresa_] Ублюдок.. Так ты и вправду это сделал, поэтому пришел ко мне.. А я тебе верила, думала ты хороший челове.."
msgstr "[_theresa_] El bastardo... Eso es lo que realmente hiciste, así que viniste a Mí. Y te creí, pensé que eras un buen hombre."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1595 #-#-# translate crowdin gallery_d_083_f2b3efbc:
msgid "[_cedrick_] Дело не в том, виновен я или нет, Тереза, а в том, что ваша судебная система настолько прогнила, что мне приходится решать проблемы подобным образом"
msgstr "[_cedrick_] El caso no es si soy culpable o no, Theresa, sino que su sistema judicial está tan podrido que tengo que resolver problemas de esta manera"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1597 #-#-# translate crowdin gallery_d_083_f40641dd:
msgid "[_cedrick_] Если бы все решение не сводилось к одному человеку, меня бы здесь не было. Не важно виновен я или нет. Мне просто нужны гарантии"
msgstr "[_cedrick_] Si la solución entera no fuera a una persona, no estaría aquí. No importa si soy culpable o no. Solo necesito garantías"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1599 #-#-# translate crowdin gallery_d_083_070c7e93:
msgid "[_theresa_on_the_phone_] .. Я фделаю все, лиф бы он не фел в тюрьму.."
msgstr "[_theresa_on_the_phone_] .. Estoy haciendo todo, no estaría en la cárcel."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1601 #-#-# translate crowdin gallery_d_083_c043db66:
msgid "[_theresa_] Х-хватит мне это показывать, ты, моральный урод.. В-выключи.."
msgstr "[_theresa_] Deja de mostrarme eso, eres un bicho raro moral... Apague..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1602 #-#-# translate crowdin gallery_d_083_bb0bff90:
msgid "[_cedrick_] А что такое? Не нравится смотреть на себя в таком положении? Как по мне вполне себе красиво, тебе подходит"
msgstr "[_cedrick_] ¿Qué es? ¿No te gusta mirarte a ti mismo en esta posición? Tan bien como soy bonita, te queda bien"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1604 #-#-# translate crowdin gallery_d_083_a1366473:
msgid "[_theresa_] Ах ты.."
msgstr "[_theresa_] Ah..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1606 #-#-# translate crowdin gallery_d_083_5057c899:
msgid "[_gordon_on_the_phone_] За такую услугу тебе бы пришлось отдать мне все свое тело на неограниченный срок, дорогая Тереза"
msgstr "[_gordon_on_the_phone_] Para tal favor, tendrías que darme todo tu cuerpo por un período ilimitado, querida Teresa"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1608 #-#-# translate crowdin gallery_d_083_ab51d71d:
msgid "[_theresa_] ..."
msgstr "[_theresa_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1610 #-#-# translate crowdin gallery_d_083_19c09d6e:
msgid "[_cedrick_] Хах, не думала, что будет, если эта запись попадет к журналистам? Я уверен, что у Гордона газетчики тоже под сапогом, он мужик грамотный, тихонько подмял под себя город"
msgstr "[_cedrick_] Hach, ¿creías que sería si este registro llegara al informe? Estoy seguro de que los periódicos de Gordon también están bajo una bota, es un hombre alfabetizado, sacudiendo silenciosamente la ciudad por sí mismo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1611 #-#-# translate crowdin gallery_d_083_a7299ee1:
msgid "[_cedrick_] Но ты не Гордон, ты не выкрутишься. Ты с мужем пойдешь под суд. И вас посадят. А уж там ты и вправду попадешь к Гордону в неограниченное пользование"
msgstr "[_cedrick_] Pero tú no eres Gordon, no vas a salir. Tú y tu marido van a juicio. Y serás encarcelado. Y allí realmente llegarás a Gordon en uso ilimitado"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1613 #-#-# translate crowdin gallery_d_083_e3428efd:
msgid "[_cedrick_] Уж поверь, я видел"
msgstr "[_cedrick_] Créeme, lo he visto"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1614 #-#-# translate crowdin gallery_d_083_c0255dbd:
msgid "[_gordon_on_the_phone_] Решишь вдруг отказать мне в помощи за мою услугу и твоей карьере конец"
msgstr "[_gordon_on_the_phone_] Si después de este favor se te ocurre negarte a ayudarme, tu carrera se acabará."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1615 #-#-# translate crowdin gallery_d_083_ab51d71d_1:
msgid "[_theresa_] ..."
msgstr "[_theresa_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1621 #-#-# translate crowdin gallery_d_083_5e90355d:
msgid "[_theresa_] Д-да кем ты себя возомнил!? Думаешь Гордон единственный, у кого в этом городе есть связи?"
msgstr "[_theresa_] ¿¡Quién crees que eras!? ¿Crees que Gordon es el único que tiene conexiones en esta ciudad?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1622 #-#-# translate crowdin gallery_d_083_dfab34cd:
msgid "[_theresa_] Я нужна Гордону ровно так же, как и он мне. Без меня некому будет отмазывать его в суде"
msgstr "[_theresa_] Necesito a Gordon tanto como para mí. Sin mí, nadie lo manchará en la corte"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1623 #-#-# translate crowdin gallery_d_083_70458ec3:
msgid "[_theresa_] Да, у тебя есть запись и что дальше? Она имеет силу только в руках Гордона. Попади она в руки журналистов просто так и Гордон сам скажет им замять дело"
msgstr "[_theresa_] Sí, tienes una grabación y ¿qué sigue? Sólo tiene poder en manos de Gordon. Ponte en manos de periodistas así y el propio Gordon les dirá que encierren el caso"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1624 #-#-# translate crowdin gallery_d_083_a9f5946c:
msgid "[_theresa_] Потому что без записи у него пропадет рычаг давления на меня. Я нужна ему, я, черт возьми, главный судья в этом городе!"
msgstr "[_theresa_] Porque sin un registro, perderá la palanca de presión sobre Mí. ¡Lo necesito, me estoy cogiendo con el juez principal de esta ciudad!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1625 #-#-# translate crowdin gallery_d_083_8c67005b:
msgid "[_theresa_] А кто ты? Ты просто мальчишка, недавно появившийся в этом городе."
msgstr "[_theresa_] ¿Y tú quién eres? Solo eres un chico que apareció recientemente en esta ciudad."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1626 #-#-# translate crowdin gallery_d_083_977fd3db:
msgid "[_cedrick_] (Как я и думал, расколоть судью не так просто. Она не просто девчонка, как остальные, Тереза прекрасно знает свое положение и на сколько оно устойчиво"
msgstr "[_cedrick_] (Como pensé, dividir al juez no es tan fácil. Ella no es solo una chica como el resto, Teresa conoce bien su posición y lo estable que es"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1630 #-#-# translate crowdin gallery_d_083_a4e3e578:
msgid "[_cedrick_] (В конце концов это часть ее работы. Но, хах, я тоже не так прост)"
msgstr "[_cedrick_] (Después de todo, es parte de su trabajo. Pero, oh, tampoco soy tan simple)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1631 #-#-# translate crowdin gallery_d_083_43ccbddb:
msgid "[_cedrick_] (Было бы глупо надеяться лишь на свой опыт в переговорах, поэтому я прочитал немало книг и прекрасно знаю, по каким законам этот мир работает)"
msgstr "[_cedrick_] (Sería una tontería confiar solo en su experiencia en las negociaciones, así que he leído muchos libros y sé exactamente en qué leyes funciona este mundo)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1632 #-#-# translate crowdin gallery_d_083_27463061:
msgid "[_cedrick_] Тереза, дорогуша, твоя проблема в том, что ты изначально неправильно оценила свое положение"
msgstr "[_cedrick_] Teresa, cariño, tu problema es que inicialmente juzgaste mal tu situación"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1636 #-#-# translate crowdin gallery_d_083_05b35a72:
msgid "[_theresa_] Ч-что!?"
msgstr "[_theresa_] ¿¡Qué!?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1637 #-#-# translate crowdin gallery_d_083_88237afb:
msgid "[_cedrick_] Подумай-ка еще раз, взвесь все как следует. Что, нет никаких идей?"
msgstr "[_cedrick_] Piénsalo de nuevo, nos pondremos de la manera correcta. ¿Qué, no hay idea?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1641 #-#-# translate crowdin gallery_d_083_4e9bc8a2:
msgid "[_theresa_] Пф, я не собираюсь играть в твои игры, ты уже проиграл"
msgstr "[_theresa_] Pf, no voy a jugar a tus juegos, ya has perdido"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1642 #-#-# translate crowdin gallery_d_083_6d337535:
msgid "[_cedrick_] Хорошо, давай я тебе подскажу. Каков процент обвинительных приговоров на судах федерального уровня?"
msgstr "[_cedrick_] Es bueno, déjame decirte. ¿Cuál es el porcentaje de condenas en los tribunales federales?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1646 #-#-# translate crowdin gallery_d_083_aa0465a5:
msgid "[_theresa_] При чем тут это.."
msgstr "[_theresa_] Qué es hacer con él."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1650 #-#-# translate crowdin gallery_d_083_40404661:
msgid "[_cedrick_] 93 процента, Тереза. 93.. Но это ведь говорит не о том, что если ты попал в суд, то тебя посадят с вероятностью 93 процента"
msgstr "[_cedrick_] 93%, Theresa. 93. Pero no es que si vas a la corte, serás encarcelado con una probabilidad del 93%"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1654 #-#-# translate crowdin gallery_d_083_c0e5aa17:
msgid "[_theresa_] Ты решил прочитать мне лекцию о праве, серьезно"
msgstr "[_theresa_] Usted ha decidido darme una conferencia sobre la derecha, en serio"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1655 #-#-# translate crowdin gallery_d_083_5af7915f:
msgid "[_cedrick_] Это значит, что большинство дел решаются в досудебном порядке. Понимаешь о чем я?"
msgstr "[_cedrick_] Esto significa que la mayoría de los casos se resuelven antes del juicio. ¿Sabes de lo que hablo?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1659 #-#-# translate crowdin gallery_d_083_ab51d71d_2:
msgid "[_theresa_] ..."
msgstr "[_theresa_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1660 #-#-# translate crowdin gallery_d_083_337d6222:
msgid "[_cedrick_] Ты нужна Гордону, но не в той форме, в которой тебе кажется. Если большинство дел решаются в досудебном порядке, то это значит только одно"
msgstr "[_cedrick_] Necesitas a Gordon, pero no en la forma en la que piensas. Si la mayoría de los casos se resuelven en el juicio previo, significa solo una cosa"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1661 #-#-# translate crowdin gallery_d_083_5d0c3009:
msgid "[_cedrick_] Судья в такой системе не нужен, если ты не доведешь дело до суда. И как ты думаешь, Тереза, Гордон тот человек, который стал бы рисковать, доводя дело до суда?"
msgstr "[_cedrick_] Un juez en un sistema de este tipo no es necesario si no lleva el caso a los tribunales. ¿Y qué crees, Teresa, Gordon, es el hombre que se arriesgaría a llevar el caso a los tribunales?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1665 #-#-# translate crowdin gallery_d_083_9d672f2e:
msgid "[_theresa_] ....."
msgstr "[_theresa_] ....."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1666 #-#-# translate crowdin gallery_d_083_aaafeb9f:
msgid "[_cedrick_] Нет, все свои проблемы Гордон решает задолго до того, как дело пойдет в суд. А значит нужна ты ему на самом деле не для этого"
msgstr "[_cedrick_] No, Gordon resuelve todos sus problemas mucho antes de que el caso vaya a la corte. Así que realmente no te necesita para eso"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1670 #-#-# translate crowdin gallery_d_083_3d408dd3:
msgid "[_theresa_] ..А для чего же?"
msgstr "[_theresa_] ..¿Y para qué?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1671 #-#-# translate crowdin gallery_d_083_c8a54658:
msgid "[_cedrick_] Хах, сейчас объясню"
msgstr "[_cedrick_] Hach, te lo explicaré ahora"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1675 #-#-# translate crowdin gallery_d_083_6df37934:
msgid "[_cedrick_] Вот для этого!"
msgstr "[_cedrick_] ¡Aquí está el punto!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1677 #-#-# translate crowdin gallery_d_083_bb18498d:
msgid "[_theresa_] Ч-что ты себе позволяешь, ублюдок!?"
msgstr "[_theresa_] Ch-¿qué estás haciendo, bastardo!?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1679 #-#-# translate crowdin gallery_d_083_4c5f5e05:
msgid "[_cedrick_] Ему нужно было твое тело, Тереза, может поймешь уже наконец?"
msgstr "[_cedrick_] Él necesitaba tu cuerpo, Theresa, ¿tal vez podrías por fin?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1681 #-#-# translate crowdin gallery_d_083_41979929:
msgid "[_theresa_] Ч-что.."
msgstr "[_theresa_] ¿Qué? ¿Qué?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1682 #-#-# translate crowdin gallery_d_083_ec5414a7:
msgid "[_cedrick_] Ему не нужна твоя помощь. Сколько раз он вообще к тебе обращался с того момента, как у него есть на тебя компромат? Ты хоть думала над этим.."
msgstr "[_cedrick_] Él no necesita tu ayuda. ¿Cuántas veces ha hablado contigo desde que te comprometió? Alguna vez lo has pensado."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1684 #-#-# translate crowdin gallery_d_083_ab51d71d_3:
msgid "[_theresa_] ..."
msgstr "[_theresa_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1685 #-#-# translate crowdin gallery_d_083_4839630f:
msgid "[_cedrick_] Уверен, что ни разу. Это значит, что твоя помощь в суда для него была лишь приятным бонусом. А на самом деле ему нужен был минет от кого-то вроде тебя"
msgstr "[_cedrick_] Estoy seguro de que ni una vez. Eso significa que tu ayuda en el tribunal solo fue una ventaja adicional para él. En realidad quería que alguien como tú se la chupara."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1687 #-#-# translate crowdin gallery_d_083_c2c96dcf:
msgid "[_cedrick_] Потому что в этом чертовом городе с прогнившей насквозь судебной системой тебе не нужна помощь судьи"
msgstr "[_cedrick_] Porque en esta maldita ciudad con un sistema judicial podrido no necesitas la ayuda de un juez"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1688 #-#-# translate crowdin gallery_d_083_04ea80d0:
msgid "[_cedrick_] Тебе нужно разве что его тело, если судья - это горячая красотка, вроде тебя"
msgstr "[_cedrick_] Necesitas su cuerpo si el juez es una belleza caliente como tú"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1690 #-#-# translate crowdin gallery_d_083_72165113:
msgid "[_theresa_] Ч-черт.."
msgstr "[_theresa_] Ch-Dr.."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1692 #-#-# translate crowdin gallery_d_083_1c7b2872:
msgid "[_cedrick_] Так что никакой власти у тебя нет. У тебя есть лишь сочные формы, за которые хочется хвататься"
msgstr "[_cedrick_] Así que no tienes poder. Solo tienes formas jugosas que quieres agarrar"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1694 #-#-# translate crowdin gallery_d_083_63d9eaa0:
msgid "[_cedrick_] Кого бы ты из себя не строила, но на деле ты просто женщина, чье тело хотят использовать. Никакая твоя власть не нужна кому-то вроде Гордона"
msgstr "[_cedrick_] A quien no construiste, pero de hecho, solo eres una mujer cuyo cuerpo quiere usar. Nadie de tu poder es necesario para alguien como Gordon"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1695 #-#-# translate crowdin gallery_d_083_04329498:
msgid "[_theresa_] ...."
msgstr "[_theresa_] ...."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1697 #-#-# translate crowdin gallery_d_083_49ab47df:
msgid "[_theresa_] Какой же ты засранец..Знаешь об этом?"
msgstr "[_theresa_] ¿Qué clase de imbécil eres?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1698 #-#-# translate crowdin gallery_d_083_2cf0baaa:
msgid "[_cedrick_] Ох, прекрасно знаю, ведь я тот, кто в этой ситуации победил тебя и унизил. И знаешь что? Пожалуй в качестве награды я возьму то единственное, на что ты годишься"
msgstr "[_cedrick_] Oh, lo sé, porque soy yo quien te golpeó en esta situación y te humilló. ¿Y sabes qué? Tal vez como recompensa me lleve lo único que está dispuesto a"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1700 #-#-# translate crowdin gallery_d_083_05b35a72_1:
msgid "[_theresa_] Ч-что!?"
msgstr "[_theresa_] ¿¡Qué!?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1704 #-#-# translate crowdin gallery_d_083_8d3f50a0:
msgid "[_theresa_] Мфмм!!"
msgstr "[_theresa_] Mfm!!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1705 #-#-# translate crowdin gallery_d_083_dee99035:
msgid "[_cedrick_] (Ммм, черт, я снова дал себе волю..)"
msgstr "[_cedrick_] (Mmm, maldita sea, me di la voluntad de nuevo.)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1706 #-#-# translate crowdin gallery_d_083_adf9ad08:
msgid "[_cedrick_] (Нужно было остановиться на прикосновении к груди, это был достаточно весомый прием, чтобы переубедить ее)"
msgstr "[_cedrick_] (Era necesario detenerse en el tacto en el pecho, era una recepción lo suficientemente pesada como para convencerla)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1708 #-#-# translate crowdin gallery_d_083_3193ff3d:
msgid "[_theresa_] Ммм!! Ммвввмм!!"
msgstr "[_theresa_] Mmm!! Mww!!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1709 #-#-# translate crowdin gallery_d_083_5362cf55:
msgid "[_cedrick_] (Но, черт, грудь у нее что надо.. А еще, хах, она намокла за то время, что я трогал ее за грудь)"
msgstr "[_cedrick_] (Pero, mierda, tiene unos pechos increíbles... Y, ja, se mojó mientras se los tocaba.)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1711 #-#-# translate crowdin gallery_d_083_c216326b:
msgid "[_cedrick_] (Черт, неужели в этом городе все женщины за 30 извращенки? Как этим не воспользоваться?)"
msgstr "[_cedrick_] (Mierda, ¿todas las mujeres mayores de treinta de esta ciudad son unas pervertidas? ¿Cómo no voy a aprovecharlo?)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1713 #-#-# translate crowdin gallery_d_083_1d215d2b:
msgid "[_theresa_] Ммммм..."
msgstr "[_theresa_] Mmmm..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1714 #-#-# translate crowdin gallery_d_083_751e233b:
msgid "[_cedrick_] (Хах, ее хватка слабеет, она все менее охотно отталкивает меня.. Интересно, может это можно будет использовать в будущем)"
msgstr "[_cedrick_] (Ja, su resistencia se debilita y cada vez intenta apartarme con menos ganas... Quizá pueda aprovechar esto en el futuro.)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1716 #-#-# translate crowdin gallery_d_083_81cd66a8:
msgid "[_theresa_] (У-ублюдок, что он себе позволяет.. Я.. Я судья, я.. ааахх..)"
msgstr "[_theresa_] (B-bastardo, ¿cómo se atreve...? Y-yo... soy jueza... aaah...)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1718 #-#-# translate crowdin gallery_d_083_bdb9de4a:
msgid "[_theresa_] (Черт, как же умело он управляется с моей киской своими пальцами.. И где только такой пацан мог научиться такому..)"
msgstr "[_theresa_] (Mierda, qué bien sabe manejar mi coño con los dedos... ¿Dónde habrá aprendido algo así un tipo como él...?)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1719 #-#-# translate crowdin gallery_d_083_a3e1788b:
msgid "[_theresa_] (Аааххх.. Я судья этого города.. А меня лапает.. И целует.. Тот, кого я должна судить..)"
msgstr "[_theresa_] (Aaah... Soy la jueza de esta ciudad... y quien me manosea... y me besa... es el hombre al que debo juzgar...)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1721 #-#-# translate crowdin gallery_d_083_72d8fe24:
msgid "[_theresa_] (А его пальцы в моей киске.. Оооххх.. Неужели мне это нравится? Ууууффф..)"
msgstr "[_theresa_] (Y sus dedos están dentro de mi coño... Oooh... ¿De verdad me gusta esto? Ufff...)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1722 #-#-# translate crowdin gallery_d_083_af319284:
msgid "[_theresa_] (Со мной ведь это не в первый раз.. Ааааххх.. Я представитель власти.. И когда меня таких гадким образом используют..)"
msgstr "[_theresa_] (No es la primera vez que me pasa... Aaah... Soy una representante de la autoridad... Y cuando me usan de una forma tan repugnante...)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1723 #-#-# translate crowdin gallery_d_083_e88c7f52:
msgid "[_theresa_] (Плевав на мое положение и статус.. Ууууухххх.. Меня и вправду это возбуждает..)"
msgstr "[_theresa_] (Sin importarles mi cargo ni mi posición... Uuuh... De verdad me excita...)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1724 #-#-# translate crowdin gallery_d_083_f1c0a634:
msgid "[_cedrick_] Тереза, ты стала сильнее сжимать мои пальцы своей киской. Не уж то тебе это нравится?"
msgstr "[_cedrick_] Theresa, ahora aprietas mis dedos con más fuerza dentro de tu coño. ¿Acaso te gusta?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1726 #-#-# translate crowdin gallery_d_083_7fc27091:
msgid "[_theresa_] Ч-что!? Я не.. Да как будто мне может нравится что-то подобное от кого-то вроде тебя"
msgstr "[_theresa_] ¿¡Q-qué!? Y-yo no... Como si pudiera gustarme algo así viniendo de alguien como tú."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1727 #-#-# translate crowdin gallery_d_083_516eed74:
msgid "[_cedrick_] Хах. Тогда думаю ты будешь не против, если мы поменяем позу"
msgstr "[_cedrick_] Ja. Entonces supongo que no te molestará que cambiemos de posición."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1730 #-#-# translate crowdin gallery_d_083_f256a50b:
msgid "[_theresa_] Ах, я-я не.. Ч-что ты делаешь"
msgstr "[_theresa_] Ah, y-yo no... ¿Q-qué estás haciendo?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1734 #-#-# translate crowdin gallery_d_083_8a2c0d6e:
msgid "[_theresa_] З-зачем ты раздеваешься.. Неужели ты..?"
msgstr "[_theresa_] ¿P-por qué te estás desnudando...? ¿Acaso vas a...?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1738 #-#-# translate crowdin gallery_d_083_a32e21d0:
msgid "[_cedrick_] Вот, так-то лучше. За то время, что у нас осталось, вряд ли я успею трахнуть тебя так, чтобы нам обоим понравилось"
msgstr "[_cedrick_] Eso está mejor. Con el poco tiempo que nos queda, no alcanzaría a cogerte de una forma que ambos disfrutáramos."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1740 #-#-# translate crowdin gallery_d_083_57afdf70:
msgid "[_cedrick_] Да и заставлять тебя сосать мне не хотелось, все же я не так жесток, как Гордон"
msgstr "[_cedrick_] Y tampoco quería obligarte a chupármela; después de todo, no soy tan cruel como Gordon."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1742 #-#-# translate crowdin gallery_d_083_95062644:
msgid "[_theresa_] Д-да неужели?"
msgstr "[_theresa_] ¿D-de veras?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1743 #-#-# translate crowdin gallery_d_083_1515a143:
msgid "[_cedrick_] Несмотря на жестокие слова, Тереза, как я и сказал в начале, мне нужны гарантии. Только и всего"
msgstr "[_cedrick_] A pesar de mis duras palabras, Theresa, como dije al principio, necesito garantías. Eso es todo."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1745 #-#-# translate crowdin gallery_d_083_ba6b894f:
msgid "[_theresa_] К-как твой член между моих бедер относится к этим гарантиям?"
msgstr "[_theresa_] ¿Q-qué tiene que ver tu verga entre mis muslos con esas garantías?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1747 #-#-# translate crowdin gallery_d_083_776b75d3:
msgid "[_cedrick_] Никак. Абсолютно. Я потерял контроль. А потом понял, что тебе тоже это нравится. И решил воспользоваться возможностью"
msgstr "[_cedrick_] Nada. Absolutamente nada. Perdí el control. Luego comprendí que tú también lo disfrutabas y decidí aprovechar la oportunidad."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1749 #-#-# translate crowdin gallery_d_083_c812c73c:
msgid "[_theresa_] Вечно вы молодые стараетесь ухватить возможность за хвост, да?"
msgstr "[_theresa_] Los jóvenes siempre intentan aprovechar cualquier oportunidad, ¿verdad?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1751 #-#-# translate crowdin gallery_d_083_cd795b41:
msgid "[_cedrick_] Хах, я далеко не так молод, как тебе кажется, но я не мог не ухватиться за такую пикантную возможность"
msgstr "[_cedrick_] Ja, no soy ni de lejos tan joven como crees, pero no podía dejar pasar una oportunidad tan provocativa."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1753 #-#-# translate crowdin gallery_d_083_51ec00de:
msgid "[_theresa_] П-понятно.. Т-ты извращенец.."
msgstr "[_theresa_] Ya veo. Eres un pervertido..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1755 #-#-# translate crowdin gallery_d_083_44941167:
msgid "[_cedrick_] Я извращенец? Это не я подыгрываю бедрами, массируя член того, кто изначально склонял меня к этому против моей воли. Это все твоя работа"
msgstr "[_cedrick_] ¿Yo soy el pervertido? No soy quien mueve las caderas para masajear la verga de alguien que al principio me llevó a esto contra mi voluntad. Todo esto lo haces tú."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1756 #-#-# translate crowdin gallery_d_083_404f9cd1:
msgid "[_cedrick_] Так что если тут и есть извращенцы, то их двое, Тереза"
msgstr "[_cedrick_] Así que, si aquí hay pervertidos, somos dos, Theresa."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1758 #-#-# translate crowdin gallery_d_083_d22d1d9f:
msgid "[_theresa_] У-уххх.."
msgstr "[_theresa_] U-uhhh..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1760 #-#-# translate crowdin gallery_d_083_d65fa7dc:
msgid "[_cedrick_] Хах, ты так легко это принимаешь? А до этого так сильно сопротивлялась. Что случилось"
msgstr "[_cedrick_] Ja, ¿ahora lo aceptas con tanta facilidad? Hace un momento te resistías con todas tus fuerzas. ¿Qué cambió?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1762 #-#-# translate crowdin gallery_d_083_939cd617:
msgid "[_theresa_] М-мне хватает ума не строить из себя святую перед тем, кто был пальцами в моей киске и понял, что мне это нравится"
msgstr "[_theresa_] Tengo suficiente sentido común para no fingir que soy una santa ante alguien que metió los dedos en mi coño y descubrió que me gusta."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1763 #-#-# translate crowdin gallery_d_083_917209f4:
msgid "[_theresa_] Если уж меня раскрыли, то я не собираюсь тратить силы на ложь. Ведь я прекрасно знаю кто я. И теперь ты это знаешь, ч-черт.."
msgstr "[_theresa_] Ya que me descubriste, no desperdiciaré fuerzas mintiendo. Sé perfectamente quién soy. Y ahora tú también lo sabes, m-mierda..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1765 #-#-# translate crowdin gallery_d_083_bc2c1fbe:
msgid "[_cedrick_] Хах, слова по-настоящему мудрой женщины.."
msgstr "[_cedrick_] Ja, palabras de una mujer verdaderamente sabia..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1766 #-#-# translate crowdin gallery_d_083_936ba370:
msgid "[_cedrick_] И извращенки"
msgstr "[_cedrick_] Y pervertida."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1768 #-#-# translate crowdin gallery_d_083_3cfa3cac:
msgid "[_theresa_] Ох, к-кто бы говори.."
msgstr "[_theresa_] Oh, m-mira quién habla..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1769 #-#-# translate crowdin gallery_d_083_dda55f16:
msgid "[_bob_] Госпожа Тереза, вы в порядке?"
msgstr "[_bob_] Señora Theresa, ¿se encuentra bien?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1771 #-#-# translate crowdin gallery_d_083_12318620:
msgid "[_cedrick_] В-вот черт!"
msgstr "[_cedrick_] ¡M-mierda!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1773 #-#-# translate crowdin gallery_d_083_dad47176:
msgid "[_theresa_] Так, быстро, подтягивай свои штаны"
msgstr "[_theresa_] Rápido, súbete los pantalones."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1774 #-#-# translate crowdin gallery_d_083_7a24ac8f:
msgid "[_bob_] Я вхожу"
msgstr "[_bob_] Voy a entrar."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1776 #-#-# translate crowdin gallery_d_083_7e80aedd:
msgid "[_cedrick_] (Я не успею..)"
msgstr "[_cedrick_] (No alcanzaré...)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1778 #-#-# translate crowdin gallery_d_083_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1783 #-#-# translate crowdin gallery_d_083_abbe6972:
msgid "[_bob_] Э-эй, а ты что здесь делаешь!?"
msgstr "[_bob_] O-oye, ¿qué haces aquí?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1785 #-#-# translate crowdin gallery_d_083_4a070cbd:
msgid "[_theresa_] Все хорошо, Боб, это я его сюда позвала"
msgstr "[_theresa_] Todo está bien, Bob. Yo le pedí que viniera."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1786 #-#-# translate crowdin gallery_d_083_fc702c84:
msgid "[_cedrick_] (Ч-черт, она так сильно сжимает мой член сейчас.. Видимо от стресса)"
msgstr "[_cedrick_] (Maldita sea, ella está apretando tan fuerte mi verga ahora mismo... Probablemente por estrés)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1788 #-#-# translate crowdin gallery_d_083_bba619f2:
msgid "[_theresa_] Нам нужно было уладить кое-какие вопросы. Рик скоро уходит"
msgstr "[_theresa_] Teníamos que resolver unos asuntos. Rick está a punto de irse."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1790 #-#-# translate crowdin gallery_d_083_6c5fad30:
msgid "[_bob_] А, ясно. Просто это. Я нашел Роба без сознания и всего мокрого. Подумал, вдруг и с вами что-то случилось"
msgstr "[_bob_] Ah, entiendo. Encontré a Rob inconsciente y empapado. Pensé que quizá a usted también le había ocurrido algo."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1792 #-#-# translate crowdin gallery_d_083_a8dd8004:
msgid "[_theresa_] Н-нет, все хорошо, спасибо за заботу"
msgstr "[_theresa_] N-no, todo está bien. Gracias por preocuparte."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1794 #-#-# translate crowdin gallery_d_083_b8ce7dd3:
msgid "[_bob_] Ну, если хорошо, тогда хорошо"
msgstr "[_bob_] Bueno, si todo está bien, me alegro."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1796 #-#-# translate crowdin gallery_d_083_57015940:
msgid "[_theresa_] Д-да.. Можешь идти"
msgstr "[_theresa_] S-sí... Puedes irte."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1798 #-#-# translate crowdin gallery_d_083_da1ea7c4:
msgid "[_theresa_] (Рик, черт.. Я чувствую как он пульсирует..)"
msgstr "[_theresa_] (Rick, mierda... Siento cómo palpita...)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1799 #-#-# translate crowdin gallery_d_083_5d84903d:
msgid "[_bob_] Ох, кстати говоря. Я хотел обсудить с вами повышение зарплаты, но вас не было на месте"
msgstr "[_bob_] Oh, por cierto: quería hablar con usted sobre un aumento, pero no estaba en su oficina."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1801 #-#-# translate crowdin gallery_d_083_eb9e36fd:
msgid "[_theresa_] Б-боб, сейчас не самое подходящее время"
msgstr "[_theresa_] B-Bob, ahora no es un buen momento."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1803 #-#-# translate crowdin gallery_d_083_38c8512a:
msgid "[_bob_] Но вы же на месте. Так что с зарплатой"
msgstr "[_bob_] Pero ahora sí está aquí. Entonces, ¿qué hay del aumento?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1805 #-#-# translate crowdin gallery_d_083_7afa4a5c:
msgid "[_theresa_] Я-я.. Ууххх.. Я обсужу это с окружным прокурором, а теперь можешь уйти?"
msgstr "[_theresa_] Y-yo... Uuuh... Lo hablaré con el fiscal de distrito. Ahora, ¿puedes irte?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1807 #-#-# translate crowdin gallery_d_083_0270575b:
msgid "[_bob_] Хорошо"
msgstr "[_bob_] De acuerdo."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1809 #-#-# translate crowdin gallery_d_083_791ba98c:
msgid "[_theresa_] Фух.."
msgstr "[_theresa_] Uf..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1810 #-#-# translate crowdin gallery_d_083_18ea1d88:
msgid "[_cedrick_] Фух..."
msgstr "[_cedrick_] Uf..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1812 #-#-# translate crowdin gallery_d_083_07620ebb:
msgid "[_bob_] И еще, госпожа судья"
msgstr "[_bob_] Una cosa más, señora jueza."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1814 #-#-# translate crowdin gallery_d_083_8cab03c3:
msgid "[_theresa_] Ч-что еще, Боб!?"
msgstr "[_theresa_] ¿Q-qué más, Bob?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1815 #-#-# translate crowdin gallery_d_083_fcbeb4e6:
msgid "[_bob_] Вы бы проверили здоровье, а то лицо красное как помидор"
msgstr "[_bob_] Usted revisaría su salud, o entonces la cara está roja como un tomate"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1817 #-#-# translate crowdin gallery_d_083_8d22c947:
msgid "[_theresa_] Спасибо, Боб, я разберусь! А теперь уходи!!"
msgstr "[_theresa_] ¡Gracias, Bob, lo averiguaré! Ahora, vete!!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1818 #-#-# translate crowdin gallery_d_083_f9e0de96:
msgid "[_bob_] Есть."
msgstr "[_bob_] Sí."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1822 #-#-# translate crowdin gallery_d_083_a20cefa7_1:
msgid "..."
msgstr "..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1828 #-#-# translate crowdin gallery_d_083_ab51d71d_4:
msgid "[_theresa_] ..."
msgstr "[_theresa_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1829 #-#-# translate crowdin gallery_d_083_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1830 #-#-# translate crowdin gallery_d_083_1e7b503e:
msgid "[_cedrick_] Хах, нас чуть не поймали"
msgstr "[_cedrick_] Hach, casi nos atrapan"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1834 #-#-# translate crowdin gallery_d_083_68d0c20f:
msgid "[_theresa_] ..Это не смешно! Он мог увидеть твой здоровенный член из под моей робы"
msgstr "[_theresa_] .. ¡No es gracioso! Él podía ver tu fuerte verga de debajo de mi túnica"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1835 #-#-# translate crowdin gallery_d_083_5022c670:
msgid "[_cedrick_] Но ведь не увидел"
msgstr "[_cedrick_] Pero no lo vi"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1836 #-#-# translate crowdin gallery_d_083_c80dd7e2:
msgid "[_theresa_] Не увидел.. Нам повезло. Это был очень необдуманный шаг"
msgstr "[_theresa_] No vio... Tenemos suerte. Fue un paso muy precipitado"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1837 #-#-# translate crowdin gallery_d_083_36818e79:
msgid "[_cedrick_] Хах, но ведь это же не я прикрылся тобой. Ты сама это сделала"
msgstr "[_cedrick_] Hah, pero no soy yo cubierta por ti. Lo hiciste tú mismo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1841 #-#-# translate crowdin gallery_d_083_077cf3cd:
msgid "[_theresa_] Я знаю.. Это был необдуманный шаг с моей стороны"
msgstr "[_theresa_] Lo sé... Fue una decisión impulsiva de mi parte."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1846 #-#-# translate crowdin gallery_d_083_6349c2a4:
msgid "[_cedrick_] Ну, думаю ты поддалась инстинктам"
msgstr "[_cedrick_] Bueno, creo que estás en el instinto"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1850 #-#-# translate crowdin gallery_d_083_fe9646d1:
msgid "[_theresa_] Ох, да иди ты. Насильник, удерживающий учеников"
msgstr "[_theresa_] Oh, ve. Violador que tiene estudiantes"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1852 #-#-# translate crowdin gallery_d_083_61558c45:
msgid "[_cedrick_] Хах, слышу от самой бесполезной судьи в округе"
msgstr "[_cedrick_] Hach, escucho del juez más inútil del distrito"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1856 #-#-# translate crowdin gallery_d_083_c8fa2863:
msgid "[_theresa_] Хах.."
msgstr "[_theresa_] H. H.."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1857 #-#-# translate crowdin gallery_d_083_bdbe51e2:
msgid "[_cedrick_] Ну так что, Тереза. Суд присяжный вынесет правильный вердикт?"
msgstr "[_cedrick_] Entonces, Theresa, ¿el jurado emitirá el veredicto correcto?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1861 #-#-# translate crowdin gallery_d_083_033451af:
msgid "[_theresa_] Да, Мактиннена посадят, можешь не беспокоиться"
msgstr "[_theresa_] Sí, Maktinen será encarcelado, no tiene que preocuparse"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1862 #-#-# translate crowdin gallery_d_083_a4551539:
msgid "[_cedrick_] Хорошо. И еще. Ты ведь не веришь, что я сам удерживал этих учеников?"
msgstr "[_cedrick_] es bueno. Y una cosa más. No crees que sostuve a estos estudiantes, ¿verdad?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1863 #-#-# translate crowdin gallery_d_083_d39be269:
msgid "[_theresa_] Хах, ну, учитывая, что ты сделал со мной.."
msgstr "[_theresa_] Hach, bueno, considerando lo que me hiciste..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1867 #-#-# translate crowdin gallery_d_083_0d4c2a58:
msgid "[_theresa_] Но..Как ни странно, я понимаю. В стрессовой ситуации люди и ни такое вытворяют, а тут твоя жизнь буквально на волоске из-за того, что решение в моих руках"
msgstr "[_theresa_] Pero... Por extraño que parezca, lo entiendo. En una situación estresante, la gente no hace esto, y entonces tu vida está literalmente en el equilibrio debido al hecho de que la solución está en mis manos"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1868 #-#-# translate crowdin gallery_d_083_349a99ba:
msgid "[_theresa_] А то, что было на складе Мактиннена. Это что-то спланированное, жестокое и.. необдуманное. Не похоже на тебя. По крайней мере на ту сторону тебя, которую я сегодня узнала"
msgstr "[_theresa_] Y lo que estaba en el almacén de Maktinen. Es algo planeado, cruel y... Loco. No suena como tú. Al menos a tu lado que aprendí hoy"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1872 #-#-# translate crowdin gallery_d_083_6b806b65:
msgid "[_cedrick_] Хах.. Рад это слышать.."
msgstr "[_cedrick_] H. H.. Me alegra oírlo."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1876 #-#-# translate crowdin gallery_d_083_701e29f8:
msgid "[_theresa_] Что ж.. Пойдем. Посижу немного с этими идиотами в суде присяжных и вынесу приговор. Увидимся через пару часов"
msgstr "[_theresa_] Bueno... Vamos. Me sentaré un poco con estos idiotas en el juicio por jurado y voy a sentenciar. Nos vemos en un par de horas"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1877 #-#-# translate crowdin gallery_d_083_0d870184:
msgid "[_cedrick_] Да, до скорого"
msgstr "[_cedrick_] Sí, hasta lo inminente"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1881 #-#-# translate crowdin gallery_d_083_c79b69df:
msgid "[_centered_] {size=37}Через пару часов в зале суда{/size} [withDissolve1]"
msgstr "[_centered_] {size=37}Un par de horas después, en la sala del tribunal{/size} [withDissolve1]"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1885 #-#-# translate crowdin gallery_d_083_cbacbf4d:
msgid "[_theresa_] После долгих часов разбирательств, анализа фактов и соотнесение событий со всеми данными, предоставленными суду, присяжные вынесли свое решение"
msgstr "[_theresa_] Después de muchas horas de audiencia, análisis fatarítico y correlación con todos los datos proporcionados al tribunal, el jurado tomó su decisión"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1886 #-#-# translate crowdin gallery_d_083_1da2b70e:
msgid "[_theresa_] Суд заявляет, что подозреваемый Рик Хоффман..."
msgstr "[_theresa_] El tribunal declara que el acusado Rick Hoffman..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1887 #-#-# translate crowdin gallery_d_083_ccc5a5ee:
msgid "[_theresa_] Невиновен"
msgstr "[_theresa_] Es inocente."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1888 #-#-# translate crowdin gallery_d_083_6c3f4438:
msgid "[_theresa_] В свою очередь подсудимый Джоэль Мактиннен судом присяжных города Шеффилд признается виновным и приговаривается к 5 пожизненным заключениям"
msgstr "[_theresa_] A su vez, el acusado Joel Maktinen es declarado culpable por el jurado de la ciudad de Sheffield es sentenciado a 5 cadenas perpetuas"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1889 #-#-# translate crowdin gallery_d_083_ba41c12e:
msgid "[_maktinen_] П-пять.. Пять п-пожизненных.. Это невозможно.."
msgstr "[_maktinen_] Cinco... Cinco vidas... Es imposible."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1890 #-#-# translate crowdin gallery_d_083_2410a8bd:
msgid "[_maktinen_] С-скажите, что это просто дурной сон.. Не может это.. Быть правдой.."
msgstr "[_maktinen_] Dime que es solo un mal sueño. No puedo hacer eso... Para ser verdad."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1891 #-#-# translate crowdin gallery_d_083_9c5b2f1f:
msgid "[_payne_] ..."
msgstr "[_payne_] ..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1892 #-#-# translate crowdin gallery_d_083_7a9d34ef:
msgid "[_payne_] Прости, дружище, мы сделали все, что могли.."
msgstr "[_payne_] Perdona, amigo, hicimos todo lo que pudimos."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1893 #-#-# translate crowdin gallery_d_083_e70565f5:
msgid "[_maktinen_] Я.. Я невиновен!! Это же очевидно.. Вы что, слепые.."
msgstr "[_maktinen_] Yo... ¡¡Soy inocente!! Es obvio... Estás ciego, ciego."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1894 #-#-# translate crowdin gallery_d_083_300a0cfd:
msgid "[_theresa_] На этом судебное заседание объявляется закрытым!"
msgstr "[_theresa_] ¡Se levanta la sesión!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1896 #-#-# translate crowdin gallery_d_083_6996771d:
msgid "[_maktinen_] Рик.. Рик Хоффман!! Ублюдок, я доберусь до тебя, слышишь меня!?"
msgstr "[_maktinen_] Rick. ¡¡Rick Hoffman!! Bastardo, voy a llegar a ti, ¿me oyes?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1897 #-#-# translate crowdin gallery_d_083_2118c59e:
msgid "[_theresa_] Полиция, выведите его из зала суда!"
msgstr "[_theresa_] ¡La policía, sáquenlo de la sala del tribunal!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1898 #-#-# translate crowdin gallery_d_083_c992cedc:
msgid "[_maktinen_] Ты поплатишься за все, ублюдок! Поплатишься, чего бы мне это ни стоило!!"
msgstr "[_maktinen_] ¡Pagarás por todo, bastardo! ¡¡Págate, lo que me cueste!!"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1899 #-#-# translate crowdin gallery_d_083_55e2d9a3:
msgid "[_cedrick_] (Что ж, еще один заклятый враг. И сразу же присоединяется к категории заклятых врагов, которых я навечно посадил за решетку)"
msgstr "[_cedrick_] (Bueno, otro enemigo jurado. E inmediatamente se une a la categoría de enemigos jurados, a quienes puse en la cárcel para siempre)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1903 #-#-# translate crowdin gallery_d_083_8e01860b:
msgid "[_medina_] Рик, мы победили! Справедливость наконец восторжествовала, мы посадили Мактиннена"
msgstr "[_medina_] ¡Rick, ganamos! La justicia finalmente triunfó, plantamos Maktinen"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1907 #-#-# translate crowdin gallery_d_083_367f789f:
msgid "[_cedrick_] Хах, никогда не видел тебя такой довольной. Неужели закрытые дела тебя так радуют"
msgstr "[_cedrick_] Hah, nunca te he visto tan feliz. ¿Te alegran tanto las cosas cerradas"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1911 #-#-# translate crowdin gallery_d_083_1f87438a:
msgid "[_medina_] Конечно, ведь эта работа - это то, чем я живу"
msgstr "[_medina_] De siempre, porque este trabajo es lo que vivo"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1915 #-#-# translate crowdin gallery_d_083_99884701:
msgid "[_cedrick_] Да, имеет смысл. Что ж, мы не добились бы этого без твоей помощи"
msgstr "[_cedrick_] Sí, tiene sentido. Bueno, no lo habríamos hecho sin tu ayuda"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1919 #-#-# translate crowdin gallery_d_083_173d471d:
msgid "[_medina_] Нет нет, каждый внес свой вклад. Как прошел разговор с Терезой?"
msgstr "[_medina_] No no, todo el mundo ha contribuido. ¿Cómo fue la conversación con Theresa?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1923 #-#-# translate crowdin gallery_d_083_7bd5f0c4:
msgid "[_cedrick_] Ну, скажем так, мы друг друга поняли. С ней все не так плохо, как мне казалось"
msgstr "[_cedrick_] Bueno, digamos que nos entendimos. No es tan malo con ella como pensaba"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1927 #-#-# translate crowdin gallery_d_083_96c376b2:
msgid "[_medina_] Да, ведь она оправдала тебя. Все, ты наконец-то невиновен, Рик! Можно возвращаться домой"
msgstr "[_medina_] Sí, porque te ha absuelto. ¡Por fin eres inocente, Rick! Puede ser devuelto a casa"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1928 #-#-# translate crowdin gallery_d_083_72adf615:
msgid "[_cedrick_] Да.. Домой.."
msgstr "[_cedrick_] Sí.. A casa."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1930 #-#-# translate crowdin gallery_d_083_d99f2e4d:
msgid "[_cedrick_] (Что ж, теперь, когда эта проблема решена, я могу сосредоточиться на своей основной задаче)"
msgstr "[_cedrick_] (Bueno, ahora que este problema está resuelto, puedo centrarme en mi tarea principal)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1931 #-#-# translate crowdin gallery_d_083_607b7094:
msgid "[_cedrick_] (Свержении Фобоса. И для этого я должен поработать со стражницами)"
msgstr "[_cedrick_] (Persecución de Fobos. Y para eso, tengo que trabajar con los guardianas)"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:1932 #-#-# translate crowdin gallery_d_083_f590ec32:
msgid "[_cedrick_] (Но для начала.. Я должен вернуться в магазинчик и отдохнуть.. Эта судебная рутина чертовски выматывающая..)"
msgstr "[_cedrick_] (Pero para empezar.. Tengo que volver a la tienda y descansar. Esta rutina judicial es muy agotadora.)"

