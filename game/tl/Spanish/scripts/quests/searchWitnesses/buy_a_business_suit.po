# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:903 #-#-# translate crowdin gallery_d_081_3ad9e44c:
msgid "[_cedrick_] Жестко теперь могут драть меня! Ты вообще знаешь, что делают в тюрячке? Смотрела фильмы Кевина Смита?"
msgstr "[_cedrick_] ¡Ahora sí podrán cogerme duro! ¿Sabes lo que hacen en la cárcel? ¿Has visto las películas de Kevin Smith?"

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:904 #-#-# translate crowdin gallery_d_081_8c4dfc7b:
msgid "[_irma_] Я.. Оооов.. Я не хотела.."
msgstr "[_irma_] Yo... Ohs... No quería..."

# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:905 #-#-# translate crowdin gallery_d_081_7c4324c1:
