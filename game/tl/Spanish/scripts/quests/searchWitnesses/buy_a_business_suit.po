# game/scripts/quests/searchWitnesses/buy_a_business_suit.rpy:670 #-#-# translate crowdin gallery_d_080_504478b5:
msgid "[_cedrick_] (Хм.. Вилл становится собственницей, интересно.. Пожалуй, это не лучшая для нее черта..)"
