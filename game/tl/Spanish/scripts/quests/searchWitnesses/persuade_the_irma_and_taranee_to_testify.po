# TODO: Translation updated at 2023-07-25 15:55 #|#|# # game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:5 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_6bff2d15:
msgid "[_cedrick_] Ну как вы тут, девочки? Смотрю отдельные спальные номера вам еще не выделили. Да, с бюджетом у нас нынче туго"
msgstr "[_cedrick_] ¿Es como si estuvieras aquí, chicas? Estoy viendo los números individuales de la habitación que no te han dado. Sí, con el presupuesto tenemos mucho tiempo"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:7 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_68a75fd3:
msgid "[_irma_] С-седрик.. Зачем ты здесь?"
msgstr "[_irma_] Cedric... ¿Por qué estás aquí?"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:9 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_efc0f4e3:
msgid "[_tarani_] Ты, урод! Думаешь ты сможешь долго нас здесь удерживать!?"
msgstr "[_tarani_] ¡Tú, cariño! ¿Crees que puedes mantenernos aquí por mucho tiempo!?"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:11 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_49c11d38:
msgid "[_cedrick_] Ох, еще как смогу"
msgstr "[_cedrick_] Oh, ¿de qué otra manera puedo"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:17 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_d12b975c:
msgid "[_cedrick_] Но сейчас не об этом. Мне нужна ваша помощь"
msgstr "[_cedrick_] Pero no es eso ahora. Necesito tu ayuda"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:22 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_6fde83fb:
msgid "[_tarani_] Еще чего, фрик!"
msgstr "[_tarani_] ¡Cualquier otra cosa, monstruo!"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:26 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_795678bb:
msgid "[_irma_] ..."
msgstr "[_irma_] ..."

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:27 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_4e890cc7:
msgid "[_cedrick_] Ирма?"
msgstr "[_cedrick_] ¿Irma?"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:31 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_0b2acb2c:
msgid "[_irma_] С чем нужно помочь?"
msgstr "[_irma_] ¿En qué debería ayudar?"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:37 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_617e9e10:
msgid "[_tarani_] Ирма! Да как ты.. Как ты только можешь.."
msgstr "[_tarani_] ¡Irma! Cómo tú... En la medida de lo posible..."

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:38 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_448c5693:
msgid "[_cedrick_] Вот это правильный ответ, Ирма"
msgstr "[_cedrick_] Aquí está la respuesta correcta, Irma"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:39 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_795678bb_1:
msgid "[_irma_] ..."
msgstr "[_irma_] ..."

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:44 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_fecc7909:
msgid "[_cedrick_] Мне нужно, чтобы вы выступили в суде в качестве жертв и способствовали тому, чтобы меня оправдали"
msgstr "[_cedrick_] Necesito que comparezcas en la corte como víctimas y que me ayudes a ser absuelto"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:48 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_888ed507:
msgid "[_cedrick_] А посадить должны того выскочку-детектива Мактиннена, которого вы сами на меня натравили"
msgstr "[_cedrick_] A debe plantar la mctintenna superstitium, que tú mismo me incitaste"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:49 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_9835c08c:
msgid "[_cedrick_] Пора вам с этим разобраться, ведь без вашей помощи все не стало бы настолько запущено"
msgstr "[_cedrick_] Es hora de que lidies con esto, porque sin tu ayuda todo no estaría tan corriendo"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:53 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_acc74898:
msgid "[_irma_] Я-я понимаю.."
msgstr "[_irma_] Lo entiendo.."

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:57 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_46557263:
msgid "[_tarani_] Ирма, да что с тобой!? Хватит вести себя как тряпка! Борись!!"
msgstr "[_tarani_] Irma, ¿qué te pasa? ¡Deja de comportarte como un trapo! ¡¡¡Lucha!!"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:61 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_f99733ed:
msgid "[_cedrick_] Ты видимо так и не поняла сути происходящего, Тарани"
msgstr "[_cedrick_] Al parecer, nunca entendiste la esencia de lo que está sucediendo, Taranee"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:65 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_ebde59ff:
msgid "[_cedrick_] Ты взываешь к человеку, который уже давно сдался и выбрал для себя самую комфортную позицию"
msgstr "[_cedrick_] Apela a una persona que ha pasado mucho tiempo y ha elegido para sí la posición más cómoda"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:66 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_795678bb_2:
msgid "[_irma_] ..."
msgstr "[_irma_] ..."

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:67 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_a7ec1d19:
msgid "[_cedrick_] И тебе стоило бы взять с нее пример. Ты в безвыходном положении, девочка"
msgstr "[_cedrick_] Y deberías tener un ejemplo. Estás en una posición sin esperanza, niña"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:68 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_eb1c723a:
msgid "[_cedrick_] Все стражницы уже так или иначе под моим контролем, понимаешь? Ты осталась одна"
msgstr "[_cedrick_] Todos los guardianas ya están bajo mi control, ¿sabes? Te quedas solo"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:72 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_7d080646:
msgid "[_tarani_] Именно! И пока я все еще борюсь, ты не победил!"
msgstr "[_tarani_] ¡Exactamente! ¡Y mientras todavía estoy luchando, no has ganado!"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:76 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:81 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_46fb8218:
msgid "[_cedrick_] (Хах, а она права. Отдаю должное ее упорству. Сейчас я даже не знаю, как к ней подобраться)"
msgstr "[_cedrick_] (Ja, y ella tiene razón. Rindo homenaje a su perseverancia. Ni siquiera sé cómo llegar a ella ahora)"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:82 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_bb966689:
msgid "[_cedrick_] (Я даже не могу подкорректировать ее сознание своей способностью, потому что попросту не знаю, на что давить)"
msgstr "[_cedrick_] (ni siquiera puedo ajustar su conciencia con mi capacidad porque simplemente no sé qué poner)"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:83 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_ce623da9:
msgid "[_cedrick_] (Эта девчонка неожиданным для меня образом превратилась в неприступную крепость)"
msgstr "[_cedrick_] (Esta chica inesperadamente se convirtió en una fortaleza inexpugnable para mí)"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:84 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_d05f9b1a:
msgid "[_cedrick_] (Видимо, это очередной результат моих старых просчетов. Я думал, что с Вилл будет сложнее, чем с Тарани)"
msgstr "[_cedrick_] (Aparentemente, este es otro resultado de mis viejos errores de cálculo. Pensé que sería más difícil con Will que con Taranee."

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:85 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_77b614e0:
msgid "[_cedrick_] (В итоге теперь я не могу ее сломать, потому что слишком мало уделял ей времени)"
msgstr "[_cedrick_] (Al final, ahora no puedo romperlo porque pasé muy poco tiempo en ella)"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:87 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_b4f96dc9:
msgid "[_cedrick_] Хм.."
msgstr "[_cedrick_] Mmmm..."

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:91 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_280ee35b:
msgid "[_tarani_] Ну что, змей, язык проглотил?"
msgstr "[_tarani_] Entonces, ¿la serpiente, se tragó la lengua?"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:95 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_4d107a8e:
msgid "[_cedrick_] Ирма, я приду за тобой, как только все подготовлю. Тарани остается здесь"
msgstr "[_cedrick_] Irma, iré a buscarte tan pronto como esté listo. Taranee se queda aquí"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:99 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_541ea7a9:
msgid "[_tarani_] Ч-что!?"
msgstr "[_tarani_] ¿Q-qué!?"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:100 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_5fc0b6cf:
msgid "[_cedrick_] Ты права, девчонка. Я признаю за тобой победу в этой битве"
msgstr "[_cedrick_] Tienes razón, niña. Te reconozco la victoria en esta batalla"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:101 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_a3d940a8:
msgid "[_cedrick_] Я не знаю, что с тобой делать. Поэтому ты остаешься здесь"
msgstr "[_cedrick_] No sé qué hacer contigo. ¿Así que te quedas aquí"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:102 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_14f3037b:
msgid "[_tarani_] К-какого..."
msgstr "[_tarani_] ¿Qué..."

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:106 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_a20d2c2d:
msgid "[_cedrick_] Остаться в камере в одиночестве, когда как Ирма сможет, хоть и ненадолго, но вернуться на землю"
msgstr "[_cedrick_] Quédate solo cuando Irma pueda, aunque sea por un tiempo, pero vuelve al suelo"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:107 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_1132dc60:
msgid "[_cedrick_] Достойная победа для тебя? Как считаешь, Тарани?"
msgstr "[_cedrick_] ¿Una victoria digna para ti? ¿Qué opinas, Taranee?"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:111 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_e9ed610f:
msgid "[_tarani_] Пф.. Это не важно. Не важно где я. Пока ты меня не сломил, стражницы еще не проиграли"
msgstr "[_tarani_] Pf. No importa. No importa donde esté. Hasta que me rompas, los guardianas aún no han perdido"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:115 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_1e459619:
msgid "[_cedrick_] Это правда. Но ты проиграешь мне со временем, Тарани. Будь уверена"
msgstr "[_cedrick_] es cierto. Pero me perderás con el tiempo, Taranee. ¡Asegúrese"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:119 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_2430b728:
msgid "[_tarani_] Этому.. Этому никогда не бывать.."
msgstr "[_tarani_] Este... Nunca será..."

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:123 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_ee7e6af0:
msgid "[_cedrick_] Вот увидишь"
msgstr "[_cedrick_] Verás"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:124 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_d72215e3:
msgid "[_cedrick_] Ирма, до скорого"
msgstr "[_cedrick_] Irma, hasta lo inminente"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:128 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_97ea51b6:
msgid "[_irma_] До скорого, Седрик.."
msgstr "[_irma_] Hasta el rápido, Cedric.."

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:132 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_71a484e5:
msgid "[_cedrick_] (Что ж, не все так гладко, но в целом у меня есть все, что нужно)"
msgstr "[_cedrick_] (Bueno, no todo es tan suave, pero en general tengo todo lo que necesitas)"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:133 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_68b54df1:
msgid "[_cedrick_] (Осталось собрать всех в одном месте и сделать так, чтобы Медина их нашла)"
msgstr "[_cedrick_] (Queda reunir a todos en un solo lugar y hacer que Medina los encuentre)"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:134 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_d664403a:
msgid "[_cedrick_] (Хм.. Адрес склада хранения, принадлежащего Мактиннену, у меня есть.. Но как мне дать на нее нужную наводку)"
msgstr "[_cedrick_] (Hmm.. Tengo una dirección de almacén propiedad de Maktinen. Pero, ¿cómo te doy la propina correcta)"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:135 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_89b3143e:
msgid "[_cedrick_] (Если я просто выложу Медине все как есть, она может меня заподозрить. Это должен сделать кто-то другой..)"
msgstr "[_cedrick_] (Si acabo de sacar a Medina como está, ella podría sospechar de Mí. Alguien tiene que hacer eso.)"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:136 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_913240dd:
msgid "[_cedrick_] (Кто мог бы раскопать такую сенсацию..)"
msgstr "[_cedrick_] (¿Quién podría excavar tal sensación.)"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:137 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_79618398:
msgid "[_cedrick_] (Точно..)"
msgstr "[_cedrick_] (Exactamente.)"

# game/scripts/quests/searchWitnesses/persuade_the_irma_and_taranee_to_testify.rpy:138 #-#-# translate crowdin persuade_the_irma_and_taranee_to_testify_f61aa893:
msgid "[_cedrick_] (Сестры Грампер, вот кто мне нужен. Я должен отправиться в школу)"
msgstr "[_cedrick_] (Sisters gramper, eso es lo que necesito. Tengo que ir a la escuela)"

