# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:10 #-#-# translate crowdin trying_to_sleep_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:14 #-#-# translate crowdin trying_to_sleep_a20cefa7_1:
msgid "..."
msgstr "..."

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:16 #-#-# translate crowdin trying_to_sleep_1ec885fa:
msgid "[_cedrick_] (Хм.. Вроде немного получше. Но все еще чувствую себя утомленным)"
msgstr "[_cedrick_] (Hmm.. Es un poco mejor. Todavía me siento cansado."

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:17 #-#-# translate crowdin trying_to_sleep_818d0631:
msgid "[_cedrick_] (Да уж, спать в спальном мешке под прилавком - это мягко говоря не способствует хорошему сну)"
msgstr "[_cedrick_] (Sí, dormir en un saco de dormir debajo del mostrador - no te ayuda a decir un buen sueño)"

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:19 #-#-# translate crowdin trying_to_sleep_dffd1032:
msgid "[_cedrick_] (Хах, раньше я мог спать и в полевых условиях во время войны, но сейчас я правда жалею о том, что у меня нет нормальной кровати)"
msgstr "[_cedrick_] (Ja, solía dormir en el campo durante la guerra, pero ahora realmente lamento no tener una cama normal)"

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:20 #-#-# translate crowdin trying_to_sleep_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:26 #-#-# translate crowdin trying_to_sleep_d33a6427:
msgid "[_elion_] Р-рик, не поможешь мне?"
msgstr "[_elion_] R-r-rh, ¿no puedes ayudarme?"

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:28 #-#-# translate crowdin trying_to_sleep_0c9fca75:
msgid "[_cedrick_] Элион!? Откуда ты взяла эту рухлядь?"
msgstr "[_cedrick_] ¡Elyon!? ¿De dónde sacaste esa mandíbula?"

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:30 #-#-# translate crowdin trying_to_sleep_aac2d3d8:
msgid "[_elion_] Это наш старый телевизор. Я притащила его из моего дома. В магазинчике стало скучно, вот я и решила, что телевизор поможет скоротать время"
msgstr "[_elion_] es nuestra vieja TV. Lo traje de mi casa. La tienda se volvió aburrida, así que decidí que la televisión ayudará a pasar el tiempo"

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:31 #-#-# translate crowdin trying_to_sleep_7601297f:
msgid "[_cedrick_] И ты тащила его сама от своего дома? Попросила бы меня помочь"
msgstr "[_cedrick_] ¿Y lo arrastraste de tu casa? Pídeme que te ayude"

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:33 #-#-# translate crowdin trying_to_sleep_1961d122:
msgid "[_elion_] Тебя почти не бывает в магазине последнее время, вот я и подумала, что проще самой..."
msgstr "[_elion_] Casi nunca le pasas a la tienda últimamente, así que pensé que era más fácil..."

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:35 #-#-# translate crowdin trying_to_sleep_49316299_1:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:36 #-#-# translate crowdin trying_to_sleep_43b921e8:
msgid "[_cedrick_] (Черт, об отношениях с Элион тоже не стоит забывать... Последнее время я и вправду уделял ей слишком много внимания)"
msgstr "[_cedrick_] (Maldito, sobre la relación con Elyon, tampoco debe olvidarse... Realmente le he prestado demasiada atención últimamente.)"

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:37 #-#-# translate crowdin trying_to_sleep_dddfc9b7:
msgid "[_cedrick_] Эм, Элион... Хочешь, проведем как-нибудь время вместе?"
msgstr "[_cedrick_] M, Elyon... ¿Quieres pasar un tiempo juntos?"

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:39 #-#-# translate crowdin trying_to_sleep_8e112cb4:
msgid "[_elion_] Даже не знаю, Рик. Ты так занят последнее время, что тебе явно не до меня"
msgstr "[_elion_] No lo sé, Rick. Últimamente estás tan ocupado que claramente no dependes de mí"

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:41 #-#-# translate crowdin trying_to_sleep_49316299_2:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:44 #-#-# translate crowdin trying_to_sleep_53a42ae7:
msgid "[_elion_] Вечером я всегда свободна, так что если захочешь провести время - приходи в мою комнату"
msgstr "[_elion_] Por la noche siempre estoy libre, así que si quieres pasar tiempo - ven a mi habitación"

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:46 #-#-# translate crowdin trying_to_sleep_d6af590a:
msgid "[_cedrick_] Хорошо, Элион"
msgstr "[_cedrick_] Bien, Elyon"

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:47 #-#-# translate crowdin trying_to_sleep_262e6229:
msgid "[_cedrick_] (Нужно будет придумать, как загладить свою вину перед ней... Думаю в этот раз всякие эротические штучки или шоколадки не подойдут...)"
msgstr "[_cedrick_] (Usted tendrá que averiguar cómo hacer las paces frente a ella... Creo que esta vez todo tipo de cosas eróticas o chocolates no encajarán...)"

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:48 #-#-# translate crowdin trying_to_sleep_501c692d:
msgid "[_cedrick_] Элион. Давай следующей ночью посмотрим что-нибудь на этом твоем телевизоре? Проведем время вместе"
msgstr "[_cedrick_] Elyon. ¿Vemos algo en tu televisor la noche siguiente? Pasemos tiempo juntos"

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:50 #-#-# translate crowdin trying_to_sleep_f1e5c5f5:
msgid "[_elion_] Даже не знаю, Рик... Если ты снова пропадешь..."
msgstr "[_elion_] No lo sé, Rick... Si estás desaparecido de nuevo..."

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:52 #-#-# translate crowdin trying_to_sleep_8bd4cf42:
msgid "[_cedrick_] Не пропаду. Следующим вечером. За телевизором. Договорились?"
msgstr "[_cedrick_] no está perdido. La noche siguiente. Detrás de la televisión. ¿Está de acuerdo?"

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:54 #-#-# translate crowdin trying_to_sleep_89c59728:
msgid "[_elion_] ..."
msgstr "[_elion_] ..."

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:56 #-#-# translate crowdin trying_to_sleep_31bc6ec5:
msgid "[_elion_] Эх..."
msgstr "[_elion_] E..."

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:58 #-#-# translate crowdin trying_to_sleep_db1e73a6:
msgid "[_elion_] Хорошо, Рик"
msgstr "[_elion_] Bien, Rick"

# game/scripts/quests/questSleeplessNight/trying_to_sleep.rpy:59 #-#-# translate crowdin trying_to_sleep_d94b29ec:
msgid "[_cedrick_] (Что ж, сейчас мне и вправду пора закончить другие дела. Нужно отправиться на Меридиан. Стоит узнать у Миранды, как дела в замке)"
msgstr "[_cedrick_] (Bueno, es hora de que termine otras cosas. Tenemos que ir a Meridian. Vale la pena señalar a Miranda cómo están las cosas en el castillo)"

