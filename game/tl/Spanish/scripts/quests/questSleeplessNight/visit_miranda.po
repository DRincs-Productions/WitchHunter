# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/questSleeplessNight/visit_miranda.rpy:7 #-#-# translate crowdin visit_miranda_5ce6eb98:
msgid "[_miranda_] Седрик, а вот и ты. Я как раз хотела сообщить тебе пару новостей"
msgstr "[_miranda_] Cedric, aquí estás. Solo quería decirte un par de noticias"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:11 #-#-# translate crowdin visit_miranda_513d93db:
msgid "[_cedrick_] Что такое, Миранда? Снова Фобос?"
msgstr "[_cedrick_] ¿Qué pasa, Miranda? ¿Fobos otra vez?"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:15 #-#-# translate crowdin visit_miranda_5d85246a:
msgid "[_miranda_] Нет, он как раз таки сейчас спокоен. Видимо пребывание стражниц на Меридиане все же осталось для него незамеченным"
msgstr "[_miranda_] Es no, es solo calma ahora mismo. Al parecer, la estancia de los guardianas en el meridiano seguía siendo desapercibida para él"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:19 #-#-# translate crowdin visit_miranda_5149d71e:
msgid "[_cedrick_] Отлично. Тогда в чем дело?"
msgstr "[_cedrick_] es genial. ¿Entonces cuál es el asunto?"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:23 #-#-# translate crowdin visit_miranda_1ee94613:
msgid "[_miranda_] Охотник. Тот, кого Фобос послал найти новую базу Повстанцев и найти беглеца Райтера. Я слышала он делает успехи"
msgstr "[_miranda_] El Cazador. Aquel a quien Fobos envió a buscar la nueva base de los Rebeldes y al fugitivo Reiter. Oí que está progresando."

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:27 #-#-# translate crowdin visit_miranda_3101a4b5:
msgid "[_cedrick_] В каком плане?"
msgstr "[_cedrick_] ¿En qué sentido?"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:31 #-#-# translate crowdin visit_miranda_4d7feb93:
msgid "[_miranda_] Несколько промежуточных баз повстанцев он уже разгромил. В одиночку"
msgstr "[_miranda_] Unas pocas bases intermedias de los rebeldes ya han destruido. ¿Solo"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:35 #-#-# translate crowdin visit_miranda_db18798e:
msgid "[_cedrick_] Черт... Нельзя дать ему разгромить повстанцев. И тем более найти Райтера. Ведь после этого он возьмется за стражниц. А они не готовы..."
msgstr "[_cedrick_] Maldición... No se puede permitir que derrote a los rebeldes. Y aún más para encontrar a Reiter. Después de eso, se casará con los guardianas. Y no están listos..."

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:36 #-#-# translate crowdin visit_miranda_2d54a087:
msgid "[_cedrick_] Хм, кстати об этом. Пожалуй внесу уровень их общей подготовки в блокнот, чтобы отслеживать прогресс."
msgstr "[_cedrick_] Hmm, por cierto. Probablemente contribuiré al nivel de su preparación general en el cuaderno para monitorear el progreso."

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:40 #-#-# translate crowdin visit_miranda_93c4add6:
msgid "[_cedrick_] Хм... Если подумать... Сейчас уровень сил Стражниц можно оценить в 1/10 от того уровня, что им необходим для победы над Фобосом"
msgstr "[_cedrick_] Hmm... Si piensas en ello... Ahora el nivel de las fuerzas de los guardianas se puede estimar en 1/10 del nivel que necesitan para derrotar a Fobos"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:45 #-#-# translate crowdin visit_miranda_af8deee8:
msgid "[_miranda_] О, теперь ты ведешь записи их прогресса?"
msgstr "[_miranda_] O, ¿ahora estás haciendo registros de su progreso?"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:49 #-#-# translate crowdin visit_miranda_330a00c1:
msgid "[_cedrick_] Да, мне ведь теперь нужно считаться с тем, что они мои товарищи, а не просто марионетки"
msgstr "[_cedrick_] Sí, ahora necesito tener en cuenta el hecho de que son mis camaradas, no solo títeres"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:53 #-#-# translate crowdin visit_miranda_1b74cc76:
msgid "[_miranda_] Хах, надо же"
msgstr "[_miranda_] Hah, bueno"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:57 #-#-# translate crowdin visit_miranda_51f2c269:
msgid "[_miranda_] К слову об этом, Седрик. Возможно мои слова сейчас прозвучат очень некстати, но..."
msgstr "[_miranda_] Hablando de esto, Cedric. Tal vez mis palabras sean muy inapropiadas ahora, pero..."

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:61 #-#-# translate crowdin visit_miranda_9f59a467:
msgid "[_cedrick_] Но... Что?"
msgstr "[_cedrick_] Pero... ¿Qué? ¿Qué?"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:65 #-#-# translate crowdin visit_miranda_b8b4fbb5:
msgid "[_miranda_] Ты неважно выглядишь... Мне кажется тебе нужен небольшой отдых. Ты хорошо поработал со стражницами, но не изводи себя"
msgstr "[_miranda_] No te ves bien... Creo que necesitas descansar un poco. Hiciste un buen trabajo con los guardianas, pero no te acoses"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:69 #-#-# translate crowdin visit_miranda_fcfcb1b4:
msgid "[_cedrick_] Серьезно? Отдыхать, пока Охотник наступает нам на пятки?"
msgstr "[_cedrick_] ¿En serio? ¿Descansar mientras el Cazador nos pisa los talones?"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:73 #-#-# translate crowdin visit_miranda_42614f1d:
msgid "[_miranda_] Один день не станет катастрофой. К тому же, Седрик, сила короля морпионов не дает лишь плюсы плюсы, есть и побочные эффекты"
msgstr "[_miranda_] Un día no será un desastre. Además, Cedric, la fuerza del rey de los independentistas no solo da ventajas, hay efectos secundarios"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:77 #-#-# translate crowdin visit_miranda_33f64a44:
msgid "[_miranda_] Чем слабее ты ментально, тем сложнее тебе контролировать свою силу монстра"
msgstr "[_miranda_] Cuanto más débil eres mentalmente, más difícil es para ti controlar tu poder monstruo"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:78 #-#-# translate crowdin visit_miranda_73fd5d04:
msgid "[_miranda_] В прошлом с тобой такого не было, но теперь, когда в тебе часть короля морпионов, твоя сущность монстра может стать более неконтролируемой"
msgstr "[_miranda_] En el pasado, esto no te ha sucedido en el pasado, pero ahora que tienes parte del rey de la monarquía, tu esencia del monstruo puede volverse más incontrolable"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:82 #-#-# translate crowdin visit_miranda_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:86 #-#-# translate crowdin visit_miranda_03339204:
msgid "[_miranda_] Когда ты последний раз вообще нормально спал?"
msgstr "[_miranda_] ¿Cuándo fue la última vez que dormiste normalmente?"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:90 #-#-# translate crowdin visit_miranda_49316299_1:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:91 #-#-# translate crowdin visit_miranda_6ff9f90c:
msgid "[_cedrick_] Вчера в спальном мешке"
msgstr "[_cedrick_] Ayer en un saco de dormir"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:95 #-#-# translate crowdin visit_miranda_58c5b903:
msgid "[_miranda_] Боже, Седрик. Тебе нужна нормальная кровать"
msgstr "[_miranda_] Oh, Dios, Cedric. Necesitas una cama normal"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:99 #-#-# translate crowdin visit_miranda_19faacdf:
msgid "[_cedrick_] Эх, ты права. Один день отдыха мне не повредит"
msgstr "[_cedrick_] Eh, tienes razón. Un día de descanso no me hará daño"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:103 #-#-# translate crowdin visit_miranda_ba9fc622:
msgid "[_cedrick_] Хм, Вилл как раз звала к себе домой сегодня"
msgstr "[_cedrick_] Hmm, Will acaba de llamarla casa hoy"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:107 #-#-# translate crowdin visit_miranda_19fcbf50:
msgid "[_miranda_] Вилл? Та маленькая стерва?"
msgstr "[_miranda_] ¿Will? ¿Esa pequeña perra?"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:111 #-#-# translate crowdin visit_miranda_3fc9066e:
msgid "[_cedrick_] Хах, она теперь наш союзник, Миранда. К тому же у них есть нормальная кровать"
msgstr "[_cedrick_] Hah, ahora es nuestra aliada, Miranda. Además, tienen una cama normal"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:115 #-#-# translate crowdin visit_miranda_10242dc1:
msgid "[_miranda_] ..."
msgstr "[_miranda_] ..."

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:119 #-#-# translate crowdin visit_miranda_9154be05:
msgid "[_miranda_] Ладно, думаю тебе не повредит провести день-другой в спокойном человеческом обществе"
msgstr "[_miranda_] De acuerdo, no creo que estés sufriendo de pasar un día o dos en una sociedad humana tranquila"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:123 #-#-# translate crowdin visit_miranda_0daafd39:
msgid "[_cedrick_] Ох, раз даже ты меня отпускаешь"
msgstr "[_cedrick_] Oh, si me dejas ir"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:127 #-#-# translate crowdin visit_miranda_b95404c3:
msgid "[_miranda_] Не издевайся. Знаешь же, что я ревную"
msgstr "[_miranda_] No te lastimes. Sabes que estoy celoso"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:131 #-#-# translate crowdin visit_miranda_10242dc1_1:
msgid "[_miranda_] ..."
msgstr "[_miranda_] ..."

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:135 #-#-# translate crowdin visit_miranda_ae22afb7:
msgid "[_cedrick_] Хах, можешь не переживать. Что ж, я пойду"
msgstr "[_cedrick_] Hah, no tienes que preocuparte. Bueno, yo me voy"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:139 #-#-# translate crowdin visit_miranda_a8a61ac8:
msgid "[_miranda_] Удачи, Седрик"
msgstr "[_miranda_] Buena suerte, Cedric"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:143 #-#-# translate crowdin visit_miranda_b928202a:
msgid "[_cedrick_] (Думаю стоит отправиться домой к Вилл прямо сейчас)"
msgstr "[_cedrick_] (creo que vale la pena ir a casa a Will ahora)"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:145 #-#-# translate crowdin visit_miranda_8a2e09a2:
msgid "[_cedrick_] (Я мог бы поспать в кровати вместе с Элион. Но что-то мне подсказывает, что сейчас она не особо рада моей компании)"
msgstr "[_cedrick_] (Podría dormir en la cama con Elyon. Pero algo me dice que ahora no está particularmente contenta con mi empresa)"

# game/scripts/quests/questSleeplessNight/visit_miranda.rpy:146 #-#-# translate crowdin visit_miranda_bac72b04:
msgid "[_cedrick_] (С другой стороны, если бы она была мне рада, то я тем более не смог бы с ней спокойно заснуть)"
msgstr "[_cedrick_] (Por otro lado, si ella estuviera feliz conmigo, no podría dormir con ella con calma)"

