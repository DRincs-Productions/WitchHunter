# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:405 #-#-# translate crowdin gallery_d_037_a9a1b6c9:
msgid "[_alchemy_] (Кончить.. Я просто хочу кончить.. Кончить, глядя на вас, мой князь, пожалуйста..)"
