msgstr "[_cedrick_] ¿Ni siquiera después de semejante maratón quieres mi verga?"

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:264 #-#-# translate crowdin gallery_d_036_b795905f:
