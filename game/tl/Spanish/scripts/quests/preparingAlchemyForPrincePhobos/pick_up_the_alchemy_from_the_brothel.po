msgstr "[_phobos_] Sí, ¿qué le pasará? No puedes salvarlo si decides jurarme lealtad"

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:415 #-#-# translate crowdin gallery_d_037_3e007bab:
