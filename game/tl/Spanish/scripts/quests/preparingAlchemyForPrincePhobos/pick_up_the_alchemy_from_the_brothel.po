# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:406 #-#-# translate crowdin gallery_d_037_cfc8cdbb:
msgid "[_phobos_] Хм, ты продолжаешь яростно мастурбировать, полностью погрузившись в свои мысли... А как же твой брат?"
