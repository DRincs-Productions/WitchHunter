# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:246 #-#-# translate crowdin gallery_d_036_d478271c:
msgid "[_miranda_] У нас во всем замке только одна девушка-оборотень, Седрик! Поэтому я так напряглась, когда узнала, что Фобос поручил это мне.."
msgstr "[_miranda_] ¡Solo hay una chica lobo en todo el castillo, Cedric! Por eso me puse tan tensa cuando supe que Fobos me lo había asignado.."

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:250 #-#-# translate crowdin gallery_d_036_26a97159:
msgid "[_cedrick_] Так вот куда ты все это время пропадала"
msgstr "[_cedrick_] Así que ahí es donde has estado todo este tiempo"

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:251 #-#-# translate crowdin gallery_d_036_07bdde05:
msgid "....."
msgstr "....."

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:252 #-#-# translate crowdin gallery_d_036_93391e44:
msgid "[_cedrick_] Мда, нелегко тебе пришлось.."
msgstr "[_cedrick_] Sí, lo has pasado mal.."

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:256 #-#-# translate crowdin gallery_d_036_e3e6237b:
