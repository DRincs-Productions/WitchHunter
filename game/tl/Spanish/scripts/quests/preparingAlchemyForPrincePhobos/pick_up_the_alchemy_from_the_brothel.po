# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:418 #-#-# translate crowdin gallery_d_037_262a9b73:
msgid "[_phobos_] Да, верно. После этого, ты уже не сможешь вернуться домой"
