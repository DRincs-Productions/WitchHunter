# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:398 #-#-# translate crowdin gallery_d_037_fd61c9b0:
msgid "[_phobos_] Ух, не уж то эти слова впервые прозвучали искренне из твоих уст?"
