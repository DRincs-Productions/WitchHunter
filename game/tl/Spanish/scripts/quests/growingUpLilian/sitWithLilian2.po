# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:727 #-#-# translate crowdin lilith_no_2ba90603:
msgid "[_cornelia_] (Хорошо что хоть того змея не было. Напади он вместе с той парочкой, мы бы скорее всего проиграли..)"
msgstr "[_cornelia_] (Qué bueno que al menos esa serpiente no estaba allí. Si hubiera atacado junto con esa pareja, lo más probable es que hubiéramos perdido...)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:731 #-#-# translate crowdin lilith_no_488bc3d0:
msgid "[_cornelia_] (Ладно, хватит забивать этим голову.. Кое-как, но мы победили..)"
msgstr "[_cornelia_] (Bueno, ya basta de molestarme con esto... De alguna manera, pero ganamos...)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:732 #-#-# translate crowdin lilith_no_b3ab34fc:
msgid "[_cornelia_] (Эх, пора возвращаться к домашней рутине.. Это тоже своего рода поле боя)"
msgstr "[_cornelia_] (Oh, es hora de volver a la rutina casera... Esto también es una especie de campo de batalla)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:736 #-#-# translate crowdin lilith_no_0647d814:
msgid "[_cornelia_] (Но и тут у меня есть помощь)"
msgstr "[_cornelia_] (Pero aquí también tengo ayuda)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:737 #-#-# translate crowdin lilith_no_84f43859:
msgid "[_cornelia_] (Ах, Рик, что бы я без тебя делала..)"
msgstr "[_cornelia_] (Oh, Rick, ¿qué haría sin ti?)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:741 #-#-# translate crowdin lilith_no_28fcf1ef:
msgid "[_cornelia_] (Честно говоря, сейчас так и хочется просто упасть в его объятия..)"
