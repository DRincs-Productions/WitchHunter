msgstr "[_cedrick_] (Mhhh, sí, eso es...)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:421 #-#-# translate crowdin gallery_d_039_4d0b11e8:
msgid "[_cedrick_] (Хах, ее грудь идеально.. Так и хочется забить на все и забрать ее на Меридиан, только чтобы наслаждаться ее формами днями напролет)"
msgstr "[_cedrick_] (Ja, sus pechos son perfectos... Solo quiero renunciar a todo y llevarla a Meridian, solo para admirar sus curvas todo el día)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:422 #-#-# translate crowdin gallery_d_039_f40eff98:
msgid "[_cedrick_] (И как только она отрастила такие бидоны)"
msgstr "[_cedrick_] (¿Y cómo logró cultivar esas tetas?)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:423 #-#-# translate crowdin gallery_d_039_e915212f:
msgid "[_cedrick_] (Хм.. Насколько помню из научной литературы, шведские ученые обнаружили параллель между потреблением кофе и ростом женской груди в момент ее формирования)"
msgstr "[_cedrick_] (Hmm... Hasta donde recuerdo de la literatura científica, los científicos suecos descubrieron un paralelismo entre el consumo de café y el crecimiento de los pechos femeninos durante su formación)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:424 #-#-# translate crowdin gallery_d_039_ea775f01:
msgid "[_cedrick_] (Чем больше кофе девушка пьет до полного формирования своих женских прелестей, тем меньшего размера они будут)"
msgstr "[_cedrick_] (Cuanto más café beba una chica antes de que sus encantos femeninos estén completamente formados, más pequeños serán)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:425 #-#-# translate crowdin gallery_d_039_08da73e1:
