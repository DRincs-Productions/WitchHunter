# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:708 #-#-# translate crowdin lilith_no_70782636:
msgid "[_cedrick_] (Что ж.. Ее спонтанный побег поможет мне разыграть небольшой спектакль.. И, возможно, захватить одну из стражниц прямо сейчас..)"
msgstr "[_cedrick_] (Bueno... Su escape espontáneo me ayudará a realizar una pequeña actuación... Y tal vez capturar a uno de los guardias ahora mismo...)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:709 #-#-# translate crowdin lilith_no_712e492a:
msgid "[_cedrick_] (Осталось только дождаться ее)"
msgstr "[_cedrick_] (Solo queda esperarla)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:713 #-#-# translate crowdin lilith_no_5e6330ce:
msgid "[_centered_] {size=37}СПУСТЯ КАКОЕ-ТО ВРЕМЯ, У ВХОДА В КВАРТИРУ{/size}"
msgstr "[_centered_] {size=37}UN TIEMPO DESPUÉS, A LA ENTRADA DEL APARTAMENTO{/size}"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:720 #-#-# translate crowdin lilith_no_303b5b6a:
msgid "[_cornelia_] (Боже, это был сущий ад..)"
msgstr "[_cornelia_] (Dios, fue un infierno...)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:721 #-#-# translate crowdin lilith_no_fa2ae1d5:
msgid "[_cornelia_] (Ладно еще гаргойл.. но песчаный демон.. и причем вдвоем..)"
msgstr "[_cornelia_] (Bueno, una gárgola... pero un demonio de arena... y dos de ellos además...)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:722 #-#-# translate crowdin lilith_no_54ef671b:
msgid "[_cornelia_] (Фобос явно укрепляет позиции и набирает мощь.. Интересно, почему)"
msgstr "[_cornelia_] (Fobos claramente está fortaleciendo su posición y ganando poder... Me pregunto por qué)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:726 #-#-# translate crowdin lilith_no_8e3fac5f:
msgid "[_cornelia_] (Ох, пожалуй, это было самое сложное наше сражение)"
