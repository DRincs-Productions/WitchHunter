# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:706 #-#-# translate crowdin lilith_no_49316299_4:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:707 #-#-# translate crowdin lilith_no_11b6595a:
msgid "[_cedrick_] И все, убежала.."
