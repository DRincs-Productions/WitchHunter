# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:4 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_2_a9395fd6:
msgid "[_centered_] {size=37}НА СЛЕДУЮЩИЙ ДЕНЬ, УТРОМ{/size}"
msgstr "[_centered_] {size=37}AL DÍA SIGUIENTE, POR LA MAÑANA{/size}"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:9 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_2_5b016cc1:
msgid "[_cedrick_] Ну что, Вилл. Как видишь, кхм, сегодня я остался у вас на ночь.."
msgstr "[_cedrick_] Bueno, Will. Como ves, hoy me quedé contigo por la noche."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:14 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_2_3b02605e:
msgid "[_will_] А-ага.. я заметила.."
msgstr "[_will_] Ajá… Me di cuenta…"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:15 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_2_ac69f907:
msgid "[_cedrick_] Но, зато мы сможем заняться подготовкой с самого утра и тогда весь остальной день у тебя будет свободен. Круто?"
msgstr "[_cedrick_] Pero, pero seremos capaces de hacer los preparativos por la mañana y luego el resto del día serás libre. ¿Genial?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:19 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_2_79c1c96b:
msgid "[_will_] Д-да, круто.."
msgstr "[_will_] D-da, genial…"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:23 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_2_e462caaa:
msgid "[_will_] (Черт, да я даже нормально в глаза ему теперь смотреть не могу. А когда пытаюсь, сразу после этого хочется бросить взгляд на его член.. Так себя чувствуют парни, когда рядом женское декольте?)"
msgstr "[_will_] (Maldita sea, no puedo ni mirarlo a los ojos ahora. Y cuando lo intento, inmediatamente después de eso quiero mirar su verga. ¿Así se sienten los chicos cuando hay un escote de mujer?)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:24 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_2_4cdb2dc5:
msgid "[_cedrick_] Окей, я тогда принесу воды и мы начнем"
msgstr "[_cedrick_] Bien, entonces traeré el agua y comenzaremos"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:25 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_2_c7042aa2:
msgid "[_will_] А-ага.."
msgstr "[_will_] Ajá…"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:29 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_2_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:32 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_2_1bf8ee04:
msgid "[_cedrick_]  В 1440 году османы потерпели неудачу при попытке захвата Белграда, что породило в Европе надежду..."
msgstr "[_cedrick_] En 1440, los otomanos fracasaron al intentar tomar Belgrado, lo que despertó esperanzas en Europa."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:33 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_2_77654944:
msgid "[_cedrick_] Папа объявил новый крестовый поход под командованием Владислава III, короля Польши и Венгрии..."
msgstr "[_cedrick_] El papa declaró una nueva cruzada bajo el mando de Vladislao III, rey de Polonia y Hungría…"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:34 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_2_3ea2438f:
msgid "[_cedrick_] После нескольких поражений в 1443—1444 годах Мурад II подписал с Владиславом Сегедский мирный договор на 10 лет и отбыл с армией в Анатолию..."
msgstr "[_cedrick_] Tras varias derrotas entre 1443 y 1444, Murad II firmó con Vladislao el tratado de paz de Szeged por 10 años y partió con su ejército hacia Anatolia."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:35 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_2_9647ec95:
msgid "[_cedrick_] Где покорил бейлик Караман и отрекся от власти в пользу сына-подростка"
msgstr "[_cedrick_] Allí conquistó el beylicato de Karaman y abdicó en favor de su hijo adolescente."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:36 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_2_1e94d755:
msgid "[_cedrick_]  Так в 1444 году в 12 лет Мехмед II в первый раз стал султаном Османской империи"
msgstr "[_cedrick_] Así, en 1444, Mehmed II se convirtió por primera vez en sultán del Imperio otomano a los 12 años."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:39 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_2_f2768d86:
msgid "[_centered_] {size=37}ПОСЛЕ ДОЛГИХ ЗАНУДНЫХ РЕЧЕЙ{/size}"
msgstr "[_centered_] {size=37}DESPUÉS DE LARGAS EXPRESIONES ABURRIDAS{/size}"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:45 #-#-# translate crowdin gallery_d_055_fd6da3dd:
msgid "[_will_] Ам, Р-рик.."
msgstr "[_will_] Eh, R-Rick…"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:46 #-#-# translate crowdin gallery_d_055_951f75a8:
msgid "[_cedrick_] Что такое, Вилл?"
msgstr "[_cedrick_] ¿Qué pasa, Will?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:47 #-#-# translate crowdin gallery_d_055_c10b1669:
msgid "[_will_] Я.. Я, пожалуй, пойду.. мне что-то не хорошо.."
msgstr "[_will_] Yo… Creo que será mejor que me vaya… No me siento bien…"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:48 #-#-# translate crowdin gallery_d_055_33a91e11:
msgid "[_cedrick_] Эм, но как же.."
msgstr "[_cedrick_] Eh, pero ¿qué hay de…?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:52 #-#-# translate crowdin gallery_d_055_f923796a:
msgid "[_will_] Мне нужно отдохнуть, Рик.."
msgstr "[_will_] Necesito descansar, Rick."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:53 #-#-# translate crowdin gallery_d_055_33f93ae9:
msgid "[_cedrick_] Хорошо, Вилл, я тебя понял"
msgstr "[_cedrick_] Bien, Will, entiendo."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:56 #-#-# translate crowdin gallery_d_055_e7fbae29:
msgid "[_will_] (Ч-черт, этот жар.. он стал только сильнее.. я не могу с ним справиться, я должна что-то с эти сделать..)"
msgstr "[_will_] (Maldita sea, este calor… Sólo se hizo más fuerte. No puedo manejarlo, tengo que hacer algo al respecto.)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:57 #-#-# translate crowdin gallery_d_055_d0bff4c2:
msgid "[_will_] (Это чувство в животе.. я должна как-то его унять.. может, пойти поесть и просто лечь спать...)"
msgstr "[_will_] (Esta sensación en el vientre… Tengo que calmarla como sea… Quizá debería comer algo e irme a dormir.)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:60 #-#-# translate crowdin gallery_d_055_0f8a9103:
msgid "[_cedrick_] (Черт, она так быстро убежала, что я не успел закрепить эффект эссенции прикосновением.. Так не пойдет, из-за этого весь план может рухнуть..)"
msgstr "[_cedrick_] (Maldita sea, ella huyó tan rápido que no tuve tiempo de arreglar el efecto de la esencia con el tacto. Eso no va, debido a esto, todo el plan puede colapsar.)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:63 #-#-# translate crowdin gallery_d_055_4ec9bbe2:
msgid "[_centered_] {size=37}Позже на кухне{/size}"
msgstr "[_centered_] {size=37}Más tarde en la cocina{/size}"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:67 #-#-# translate crowdin gallery_d_055_c9023d23:
msgid "[_cedrick_] (Отлично, она меня не заметила. Змеиная проворность дает о себе знать. Но что же я с ней сделаю)"
msgstr "[_cedrick_] (Originalmente, ella no me notó. La agilidad de la serpiente se hace sentir. Pero, ¿qué le voy a hacer)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:68 #-#-# translate crowdin gallery_d_055_3c901131:
msgid "[_cedrick_] (Кажется, у меня есть идея)"
msgstr "[_cedrick_] (creo que tengo una idea)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:78 #-#-# translate crowdin gallery_d_055_c81f5419:
msgid "[_will_] А-ах.. С-стоп, что!?"
msgstr "[_will_] Ah… Espera, ¿qué?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:79 #-#-# translate crowdin gallery_d_055_dc7497ab:
msgid "[_cedrick_] Ох, Вилл!? Это ты?! П-прости, я-я перепутал тебя с твоей мамой.."
msgstr "[_cedrick_] Oh, Will!? ¡¿Eres tú?! Por favor, estoy confundido con tu madre."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:80 #-#-# translate crowdin gallery_d_055_32c55d1e:
msgid "[_will_] Ч-что.. т-ты.. ты не можешь так просто.. ахххх"
msgstr "[_will_] ¿Qué? ¿Qué? Tú eres… No puedes hacerlo. Akh"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:81 #-#-# translate crowdin gallery_d_055_630f402f:
msgid "[_cedrick_] Прости, вы с ней сзади так похожи.."
msgstr "[_cedrick_] Perdón, vistas desde atrás se parecen mucho…"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:82 #-#-# translate crowdin gallery_d_055_e0fb0c79:
msgid "[_will_] П-похожи сзади, да.."
msgstr "[_will_] Es como la espalda, sí."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:83 #-#-# translate crowdin gallery_d_055_3421d114:
msgid "[_will_] (А он явно знает, о чем говорит.. Но для меня интересно другое - если он нас перепутал, значит сейчас он и на мою попку заглядывался.. В-вот значит как...)"
msgstr "[_will_] (Y claramente sabe de lo que está hablando. Pero para mí, otra cosa es interesante: si nos confundió, entonces ahora me miró el trasero. Así es como…)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:84 #-#-# translate crowdin gallery_d_055_5bb1bead:
msgid "[_will_] Р-рик.. Не мог бы ты.."
msgstr "[_will_] R-Rick… ¿Podrías…?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:85 #-#-# translate crowdin gallery_d_055_73a16893:
msgid "[_cedrick_] Что такое?"
msgstr "[_cedrick_] ¿Qué pasa?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:86 #-#-# translate crowdin gallery_d_055_1b36e3c5:
msgid "[_will_] Т-твоя рука.. она все еще.. трогает меня.."
msgstr "[_will_] T-t-tu mano. Ella sigue… Me Toca…"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:87 #-#-# translate crowdin gallery_d_055_af2ad1dd:
msgid "[_cedrick_] Ох, черт.. Прости, так удивился, что даже забыл ее убрать, так глупо, ахах.."
msgstr "[_cedrick_] Oh, demonios. Lo siento, estaba tan sorprendido de que incluso me olvidara de eliminarlo, es tan estúpido, ah…"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:88 #-#-# translate crowdin gallery_d_055_ba4f2f3b:
msgid "[_will_] Н-ничего страшного..."
msgstr "[_will_] N-nada terrible…"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:96 #-#-# translate crowdin gallery_d_055_587ba09a:
msgid "[_will_] Р-рик.. Ч-что ты себе позволяешь!? отпусти.."
msgstr "[_will_] R-Rick… ¿Qué quieres?? Suéltame."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:97 #-#-# translate crowdin gallery_d_055_90677df2:
msgid "[_cedrick_] Ох, Вилл, это ты.. Прости, сзади показалось, что это Сьюзан"
msgstr "[_cedrick_] Oh, Will, eres tú… Lo siento, parecía en la parte de atrás que era Susan"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:99 #-#-# translate crowdin gallery_d_055_eaba960e:
msgid "[_will_] А-ахах.. Б-бывает, ошибся.. Н-но, может, ты меня отпустишь?"
msgstr "[_will_] Ahhhhhhhh a veces estoy equivocado. ¿Pero tal vez me dejarás ir?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:100 #-#-# translate crowdin gallery_d_055_baa69915:
msgid "[_cedrick_] А что не так?"
msgstr "[_cedrick_] ¿Qué pasa?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:103 #-#-# translate crowdin gallery_d_055_6406ebe5:
msgid "[_will_] Ч-что!? Т-ты же схватил меня за шею.. и.. з-за гру.."
msgstr "[_will_] ¡¿Q-qué?! M-me agarraste por el cuello y… p-por el pe…"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:104 #-#-# translate crowdin gallery_d_055_dbd6305b:
msgid "[_cedrick_] А ты и не сопротивляешься, так зачем мне тогда останавливаться?"
msgstr "[_cedrick_] Y no te resistes, ¿por qué debería parar?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:106 #-#-# translate crowdin gallery_d_055_5420499a:
msgid "[_will_] Ч-что.. Что!? А ну прекрати это сейчас же, Рик!! Я буду кричать"
msgstr "[_will_] ¿Qué? ¿Qué? ¿¡Qué!? ¡Para ahora, Rick! Voy a gritar"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:107 #-#-# translate crowdin gallery_d_055_9a80a4af:
msgid "[_cedrick_] Очень много слов и полное отсутствие действий. Я сразу бы отпустил тебя, Вилл, если бы ты не начала таять в моих руках"
msgstr "[_cedrick_] Hay muchas palabras y una completa falta de acción. Te habría dejado ir de inmediato, Will, si no hubieras empezado en mis manos"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:108 #-#-# translate crowdin gallery_d_055_2216fae3:
msgid "[_will_] Э-эй! Н-не говори такие вещи.."
msgstr "[_will_] ¡Eh, hey! No digas cosas así."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:109 #-#-# translate crowdin gallery_d_055_8ddac100:
msgid "[_cedrick_] Знаешь, ты сейчас на столько мягкая и беспомощная, что если бы не мои руки, ты бы тут же упала с ног. Почему твои коленки так трясутся, Вилл?"
msgstr "[_cedrick_] Sabes, eres tan amable e indefenso ahora mismo que si no fuera por mis manos, inmediatamente te caerías de pie. ¿Por qué tus rodillas tiemblan así, Will?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:111 #-#-# translate crowdin gallery_d_055_c686d8e5:
msgid "[_will_] Рик! Э-это переходит все границы!"
msgstr "[_will_] ¡Rick! ¡Está cruzando todos los límites!"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:112 #-#-# translate crowdin gallery_d_055_aa4675b1:
msgid "[_will_] (Ч-черт, что со мной.. он перешел черту дозволенного.. но вместо того, чтобы оттолкнуть его, я не хочу, чтобы он меня отпускал..)"
msgstr "[_will_] (Pecho, ¿qué pasa conmigo? Cruzó la línea de lo que era permisible… Pero en lugar de alejarlo, no quiero que me deje ir.)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:113 #-#-# translate crowdin gallery_d_055_486a7bdf:
msgid "[_will_] (Вместо того, чтобы кричать, мне хочется лишь издавать стон.. Н-нет, это слишком...)"
msgstr "[_will_] (En vez de gritar, solo quiero publicar un gemido. N-no, eso es demasiado…)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:124 #-#-# translate crowdin gallery_d_055_cfc05854:
msgid "[_will_] Р-рик, я больше так не могу.. мне нужно уйти.. срочно.."
msgstr "[_will_] R-Rick, ya no puedo seguir así… Necesito irme… ahora mismo…"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:125 #-#-# translate crowdin gallery_d_055_c1114554:
msgid "[_will_] (Если я ничего не сделаю с возникшим прямо сейчас жаром, я просто взорвусь..)"
msgstr "[_will_] (Si no hago nada con el calor que ha surgido en este momento, simplemente explotaré.)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:128 #-#-# translate crowdin gallery_d_055_22285fb5:
msgid "[_cedrick_] (Хах, она отреагировала куда мягче, чем я рассчитывал. Буквально пару дней назад такие мои действия не прошли бы без последствий и так просто я бы не отделался)"
msgstr "[_cedrick_] (Ja, reaccionó mucho más suave de lo que esperaba. Hace solo un par de días, tales acciones no habrían pasado sin consecuencias y así que no habría bajado)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:129 #-#-# translate crowdin gallery_d_055_bb65eaac:
msgid "[_cedrick_] (Отлично, вода начала точить камень. Интересно, как далеко я смогу зайти)"
msgstr "[_cedrick_] (Grande, el agua comenzó a afilar la piedra. Me pregunto hasta dónde puedo llegar)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:135 #-#-# translate crowdin gallery_d_055_c51ab26f:
msgid "[_will_] (Ч-черт, как же жарко.. Этот жар просто разрывает меня изнутри.. Это что, какая-то магия.. Н-нет, не может быть..)"
msgstr "[_will_] (Maldita sea, hace calor. Este calor me rompe desde dentro. Es una especie de magia. No, no puede ser…)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:136 #-#-# translate crowdin gallery_d_055_312edef3:
msgid "[_will_] (Глядя на мою мать несколько дней назад.. Неудивительно, что я выросла такой же развратницей.. Ааааах, как же горячо..)"
msgstr "[_will_] (Al ver a mi madre hace unos días… No sorprende que haya crecido igual de pervertida… Aaaah, qué excitante…)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_2.rpy:137 #-#-# translate crowdin gallery_d_055_e12a2fc9:
