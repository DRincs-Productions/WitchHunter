# TODO: Translation updated at 2023-07-25 15:56 #|#|# # §translate crowdin strings: #|#|# # game/scripts/quests/willCrystalEssence/crystal_essence_write_message_to_susan.rpy:4
msgid "Хей, Сьюзан, я сегодня загляну к вам, Вилл нужно помочь с подготовкой к экзаменам"
msgstr "Oye, Susan, me encontraré contigo hoy, necesitaré ayuda con la preparación del examen"

# game/scripts/quests/willCrystalEssence/crystal_essence_write_message_to_susan.rpy:9
msgid "Ох, Рик, как мило с твоей стороны, ты такой заботливый"
msgstr "Oh, Rick, tan amable de tu parte, eres tan cariñoso"

# game/scripts/quests/willCrystalEssence/crystal_essence_write_message_to_susan.rpy:14
msgid "Но, я надеюсь, что ты и ко мне заглянешь на огонёк.. Знаешь, я последнее время много думала о тебе"
msgstr "Pero espero que mires la luz de mí. Sabes, últimamente he estado pensando en ti"

# game/scripts/quests/willCrystalEssence/crystal_essence_write_message_to_susan.rpy:20
msgid "Хммм..."
msgstr "Hmm…"

# game/scripts/quests/willCrystalEssence/crystal_essence_write_message_to_susan.rpy:22
msgid "Хммм, и что же пришло тебе в голову?"
msgstr "Hmm, ¿y qué te vino a la mente?"

# game/scripts/quests/willCrystalEssence/crystal_essence_write_message_to_susan.rpy:27
msgid "Подожди минутку"
msgstr "Espera un minuto"

# game/scripts/quests/willCrystalEssence/crystal_essence_write_message_to_susan.rpy:39
msgid "Купила это бельё специально для нашей следующей ночи"
msgstr "Compré esta ropa específicamente para nuestra próxima noche"

# game/scripts/quests/willCrystalEssence/crystal_essence_write_message_to_susan.rpy:45
msgid "Думаю, я готова для следующего этапа наших отношений, Рик"
msgstr "Creo que estoy listo para la siguiente fase de nuestra relación, Rick"

# game/scripts/quests/willCrystalEssence/crystal_essence_write_message_to_susan.rpy:51
msgid "Приезжай сегодня, устроим ночной просмотр сериалов"
msgstr "Ven hoy, organiza la noche viendo la serie"

# game/scripts/quests/willCrystalEssence/crystal_essence_write_message_to_susan.rpy:57
msgid "Ммм, а Вилл?"
msgstr "Mmm, ¿qué hay de Will?"

# game/scripts/quests/willCrystalEssence/crystal_essence_write_message_to_susan.rpy:59
msgid "Ммм, надеюсь Вилл нас не застукает"
msgstr "Mmm, espero que Will no nos atrape"

# game/scripts/quests/willCrystalEssence/crystal_essence_write_message_to_susan.rpy:64
msgid "Мы будем аккуратны"
msgstr "Tendremos cuidado"

