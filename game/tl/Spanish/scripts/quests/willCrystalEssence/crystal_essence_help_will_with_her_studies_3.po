# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:4 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_228026ca:
msgid "[_centered_] {size=37}На следующий день{/size}"
msgstr "[_centered_] {size=37}Al día siguiente{/size}"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:9 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_b4e4bd4c:
msgid "[_cedrick_] Вилл, ну как ты? Мама сказала, что тебе вчера нездоровилось"
msgstr "[_cedrick_] Will, ¿cómo estás? Mamá dijo que ayer no estabas bien"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:13 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_eded9888:
msgid "[_will_] Я.. кхм.. я в норме, Рик, спасибо.."
msgstr "[_will_] Yo... Khmm .. Estoy bien, Rick, gracias."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:14 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_69562566:
msgid "[_cedrick_] Готова продолжить подготовку?"
msgstr "[_cedrick_] ¿Preparado para continuar el entrenamiento?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:16 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_02169cec:
msgid "[_will_] Я.. я не.."
msgstr "[_will_] Yo... No estoy..."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:20 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_9b70a837:
msgid "[_will_] (у меня все плывет в голове.. я словно в тумане, не до конца понимаю, что вокруг происходит..)"
msgstr "[_will_] (Estoy flotando en mi cabeza. Estoy como en la niebla, no entiendo completamente lo que está pasando...)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:21 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_0a0f2c8b:
msgid "[_will_] (хочу ли я дальше заниматься учебой.. нет.. мне плевать.. н-но.. учиться с Риком.. ммм, учиться с Риком, кажется, весело..)"
msgstr "[_will_] (Quiero seguir estudiando.. No. No. No me importa... N-No. Estudiando con Rick.. Um, estudiar con Rick parece divertido.)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:22 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_d8031b30:
msgid "[_will_] (Черт, нет! Возьми себя в руки.. Тебе не нужен Рик, тебе нужно закончить школу.. Нужно быстрее закончить эту подготовку, иначе я..)"
msgstr "[_will_] (¡Maldita sea, no! Manténganse juntos... No necesitas a Rick, tienes que terminar la escuela. Tienes que terminar este entrenamiento más rápido, de lo contrario yo...)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:23 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_d2ce1552:
msgid "[_will_] (Иначе я рискую стать зависимой от него, ооооохх... Да какого черта!)"
msgstr "[_will_] (De lo contrario, me arriesgo a volverme adicto a ella, ohooh... ¡Qué maldita cosa!)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:24 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_feffd31f:
msgid "[_cedrick_] Ну что, Вилл?"
msgstr "[_cedrick_], Cariño, ¿Vala?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:28 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_3314422c:
msgid "[_will_] Я готова.."
msgstr "[_will_] Estoy listo."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:29 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_38df8849:
msgid "[_cedrick_] Хорошо, только воды принесу, так тебе точно станет лучше"
msgstr "[_cedrick_]H Bueno, solo que traigo agua, así que definitivamente mejorarás"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:30 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_16bf45b4:
msgid "[_will_] Д-да, давай"
msgstr "[_will_] D-da, vamos"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:35 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:39 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_257e7986:
msgid "[_cedrick_] Ну что, продолжим обучение?"
msgstr "[_cedrick_] Bueno, ¿continuaremos el entrenamiento?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:43 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_f9d8d2a3:
msgid "[_will_] Угу.. Ура, учеба, ахах.. учеба с Риком.."
msgstr "[_will_] Ug... Ura, estudia, ahhhhhhhh estudiar con Rick."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:47 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:48 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_aaff0257:
msgid "[_cedrick_] (...хм, ей и вправду как будто нехорошо. Делаю ли я все правильно? Вилл как будто не здесь. Может, это такой промежуточный этап? Проверим)"
msgstr "[_cedrick_] (...Hmm, ella realmente parece estar mal. ¿Estoy haciendo lo correcto? Will es como no aquí. ¿Tal vez esta es una etapa tan intermedia? Comprueba)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:49 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_484c43d1:
msgid "[_cedrick_] Что ж, начнем"
msgstr "[_cedrick_] Bueno, empecemos"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:53 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_cf7fe15e:
msgid "[_cedrick_]  Османская империя, слабея, попыталась опереться на помощь Германии, при этом сохраняя нейтралитет и, в особенности, избегая конфликта с Россией"
msgstr "[_cedrick_] El imperio otomano, más débil, trató de confiar en la ayuda de Alemania, manteniendo la neutralidad y, en particular, evitando el conflicto con Rusia"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:54 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_b16ab9db:
msgid "[_cedrick_] Пытаясь устранить российскую угрозу, они предложили заключить тайный союз самой России"
msgstr "[_cedrick_] Tratando de eliminar la amenaza rusa, propusieron concluir una alianza secreta de la propia Rusia"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:55 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_5956cf8d:
msgid "[_cedrick_]  Первым, кто заговорил о возможности альянса с Российской империей, стал не кто иной, как Энвер-паша, самый рьяный сторонник союза с Германией"
msgstr "[_cedrick_] La primera persona que habló sobre la posibilidad de una alianza con el imperio ruso no fue otra que nunca pasha, el partidario más celoso de la alianza con Alemania"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:56 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_9f0c5563:
msgid "[_cedrick_] 5 августа 1914 года Энвер обратился к российскому военному атташе в Стамбуле, генералу М. Н. Леонтьеву..."
msgstr "[_cedrick_] El 5 de agosto de 1914, se dirigió al agregado militar ruso en Estambul, general M. N. Leontyev..."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:57 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_63f81fb1:
msgid "[_cedrick_] ...с предложением заключить российско-турецкий оборонительный союз"
msgstr "[_cedrick_]... Con una propuesta para concluir una alianza defensiva ruso-turca"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:60 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_f2768d86:
msgid "[_centered_] {size=37}ПОСЛЕ ДОЛГИХ ЗАНУДНЫХ РЕЧЕЙ{/size}"
msgstr "[_centered_] {size=37}DESPUÉS DE LARGAS EXPRESIONES ABURRIDAS{/size}"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:61 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_3_a20cefa7_1:
msgid "..."
msgstr "..."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:66 #-#-# translate crowdin gallery_d_056_6e8a1bae:
msgid "[_cedrick_] (Хм, и снова эта закрытая отстраненная поза.. Что ж мне с тобой делать)"
msgstr "[_cedrick_] (Hmm, y de nuevo esta pose suspendida cerrada.. ¿Qué debo hacer contigo?)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:73 #-#-# translate crowdin gallery_d_056_5675802c:
msgid "[_cedrick_] Вилл, ты выглядишь очень зажато. С тобой точно все в порядке?"
msgstr "[_cedrick_] Will, te ves muy sujetado. ¿Definitivamente estás bien contigo?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:75 #-#-# translate crowdin gallery_d_056_80f3d02b:
msgid "[_will_] Я.. м, да, все хорошо, просто мне.. мне сложно себя контролировать.."
msgstr "[_will_] Yo... Um, sí, está bien, solo yo. Es difícil para mí controlarme."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:76 #-#-# translate crowdin gallery_d_056_7b0d15d2:
msgid "[_cedrick_] В каком смысле?"
msgstr "[_cedrick_] ¿En qué sentido?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:79 #-#-# translate crowdin gallery_d_056_1a5fb3be:
msgid "[_will_] Ну, эм.. Не важно, просто поверь мне"
msgstr "[_will_] Bueno, um... No importa, solo confía en mí"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:80 #-#-# translate crowdin gallery_d_056_6e924b7e:
msgid "[_cedrick_] Со мной ты можешь открыться, ты же знаешь. Просто расслабься, будь собой. Сядь так, как тебе удобно"
msgstr "[_cedrick_] Puedes abrirme, ¿sabes? Relájate, sé tú mismo. Siéntate como quieras"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:81 #-#-# translate crowdin gallery_d_056_ba434641:
msgid "[_will_] Эм.. я.."
msgstr "[_will_] Mm. Estoy..."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:82 #-#-# translate crowdin gallery_d_056_379dea17:
msgid "[_will_] Хорошо, Рик, я попробую.."
msgstr "[_will_] De acuerdo, Rick, lo intentaré..."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:86 #-#-# translate crowdin gallery_d_056_1e14b535:
msgid "[_cedrick_] Вот и славно. Так же удобнее, правда?"
msgstr "[_cedrick_] es bueno. Es igual de conveniente, ¿no?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:89 #-#-# translate crowdin gallery_d_056_2ef4c8bd:
msgid "[_will_] А-агам.."
msgstr "[_will_] A-agham.."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:90 #-#-# translate crowdin gallery_d_056_503f36bc:
msgid "[_cedrick_] Вилл?"
msgstr "[_cedrick_] ¿Will?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:93 #-#-# translate crowdin gallery_d_056_736673b6:
msgid "[_will_] Да.. Рик.."
msgstr "[_will_] Sí.. Rick."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:94 #-#-# translate crowdin gallery_d_056_eda8b8b2:
msgid "[_cedrick_] (Черт, девчонка похоже совсем на грани. Я должен попробовать зайти дальше)"
msgstr "[_cedrick_] (Maldita sea, la chica está al borde. Tengo que intentar ir más allá)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:95 #-#-# translate crowdin gallery_d_056_40ab0bcb:
msgid "[_cedrick_] Вилл.. А может, тебе будет удобнее, сидя у меня на коленях?"
msgstr "[_cedrick_] Will. ¿O tal vez te sientas más cómodo sentado en mi regazo?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:98 #-#-# translate crowdin gallery_d_056_6275a51b:
msgid "[_will_] Это.. Странно.."
msgstr "[_will_] Es... Es raro."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:99 #-#-# translate crowdin gallery_d_056_afcf3568:
msgid "[_cedrick_] Ничего странного. Я ведь встречаюсь с Сьюзан, я тебе почти как отец. У отца можно посидеть на коленях"
msgstr "[_cedrick_] No es nada extraño. Estoy saliendo con Susan, soy más o menos como un padre. El padre puede sentarse de rodillas"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:100 #-#-# translate crowdin gallery_d_056_a7e20fbb:
msgid "[_will_] Да.. возможно.. ты прав"
msgstr "[_will_] Sí.. Posiblemente... Tienes razón"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:101 #-#-# translate crowdin gallery_d_056_6550b2f8:
msgid "[_cedrick_] (Мда, то, что на нее подействовал такой хуевый аргумент, говорит о том, что девочка сейчас не в себе. Ну, мне это только на руку)"
msgstr "[_cedrick_] (Yecom, el hecho de que tal maldita discusión haya actuado en ella sugiere que la chica no es ella misma ahora. Bueno, sólo estoy en la mano."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:105 #-#-# translate crowdin gallery_d_056_893e0443:
msgid "[_cedrick_] Удобно?"
msgstr "[_cedrick_] ¿Cómodo?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:106 #-#-# translate crowdin gallery_d_056_eb64a1c9:
msgid "[_will_] Ммм.. да, так удобнее.. сразу стало комфортнее.. так приятно"
msgstr "[_will_] Mmm... Sí, es más cómodo. Inmediatamente se volvió más cómodo. Tan agradable"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:107 #-#-# translate crowdin gallery_d_056_4378db30:
msgid "[_cedrick_] Вот и хорошо.. А знаешь, от чего еще может быть приятно?"
msgstr "[_cedrick_] es bueno. ¿Sabes qué más podría ser agradable?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:112 #-#-# translate crowdin gallery_d_056_5b0e7bad:
msgid "[_will_] Р-рик.. Что ты.."
msgstr "[_will_] R-Rick... ¿Qué eres tú...?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:113 #-#-# translate crowdin gallery_d_056_a8aaceb9:
msgid "[_cedrick_] Ты явно плохо себя чувствуешь.. Я просто помогаю тебе расслабиться.."
msgstr "[_cedrick_] Claramente no te sientes bien. Solo te estoy ayudando a relajarte..."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:114 #-#-# translate crowdin gallery_d_056_c0699508:
msgid "[_will_] Расслабиться.. Х-хорошо.."
msgstr "[_will_] Relájate. Es bueno..."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:115 #-#-# translate crowdin gallery_d_056_4f473edd:
msgid "[_cedrick_] Да, хорошо.."
msgstr "[_cedrick_] Sí, bien."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:120 #-#-# translate crowdin gallery_d_056_9aab9961:
msgid "[_will_] Рик.. Это.. Ааахххх... Я... Мммммвв.."
msgstr "[_will_] Rick. Eso es... Aahhhhhhhh... Mmmmv..."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:121 #-#-# translate crowdin gallery_d_056_6c837568:
msgid "[_cedrick_] Так ведь становится лучше?"
msgstr "[_cedrick_] ¿Está mejorando?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:125 #-#-# translate crowdin gallery_d_056_273fb9ca:
msgid "[_will_] Д-да... ммммм.."
msgstr "[_will_] D-Da... Mmm mmm..."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:126 #-#-# translate crowdin gallery_d_056_6e6c27cd:
msgid "[_will_] Ах.. Р-рик, я..."
msgstr "[_will_] Ah... R-rh, yo..."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:131 #-#-# translate crowdin gallery_d_056_6c5c4412:
msgid "[_cedrick_] Вилл, как тебе не стыдно"
msgstr "[_cedrick_] Will, ¿cómo no te avergüenzas"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:134 #-#-# translate crowdin gallery_d_056_18deef11:
msgid "[_will_] Ч-что? Что не так, Рик?"
msgstr "[_will_] ¿Qué carajo es? ¿Qué pasa, Rick?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:135 #-#-# translate crowdin gallery_d_056_a8b80d47:
msgid "[_cedrick_] Ты сидишь и выставляешь напоказ свою промежность, пока мы тут пытаемся подготовить тебя к итоговому экзамену"
msgstr "[_cedrick_] Usted está sentado y haciendo alarde de su entrepierna mientras estamos tratando de prepararlo para el examen final"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:138 #-#-# translate crowdin gallery_d_056_8b07fb41:
msgid "[_will_] Ч-что.. я не.."
msgstr "[_will_] ¿Qué? ¿Qué? No estoy..."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:139 #-#-# translate crowdin gallery_d_056_6fd45417:
msgid "[_cedrick_] Посмотри на себя, ноги кверху, бедра вместе. Ты хоть знаешь, что делают с девушками, вроде тебя, когда они встают в такую позу?"
msgstr "[_cedrick_] Mírate a ti mismo, a tus pies en alto, con las caderas juntas. ¿Sabes lo que le están haciendo a chicas como tú cuando entran en esa posición?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:142 #-#-# translate crowdin gallery_d_056_40b3f020:
msgid "[_will_] Я.. Я не знаю.."
msgstr "[_will_] Yo... No sé..."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:143 #-#-# translate crowdin gallery_d_056_2a857831:
msgid "[_cedrick_] Давай, Вилл, теперь это часть твоего теста. Отвечай на вопрос. Что делают с девушками, которые встают в такую позу, в которую встала ты?"
msgstr "[_cedrick_] Vamos, Will, ahora es parte de tu prueba. Responda la pregunta. ¿Qué haces con las chicas que se levantan en la posición en la que te paraste?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:146 #-#-# translate crowdin gallery_d_056_a1556bb7:
msgid "[_will_] Я не собираюсь.."
msgstr "[_will_] No voy a..."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:147 #-#-# translate crowdin gallery_d_056_e9971f74:
msgid "[_cedrick_] Отвечай, Вилл! Если ты в тестах негодна, может хоть в этом хороша"
msgstr "[_cedrick_] ¡Responde, Will! Si no sirves para los exámenes, quizá al menos sirvas para esto."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:148 #-#-# translate crowdin gallery_d_056_db67d3c5:
msgid "[_will_] ...."
msgstr "[_will_] ...."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:149 #-#-# translate crowdin gallery_d_056_c0d7ddfe:
msgid "[_will_] Их трахают.."
msgstr "[_will_] Se los cogen."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:150 #-#-# translate crowdin gallery_d_056_ef9acee1:
msgid "[_cedrick_] Что? Я не расслышал. Отвечай четко"
msgstr "[_cedrick_] ¿Qué? No te oí. Responde con claridad."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:153 #-#-# translate crowdin gallery_d_056_fa226024:
msgid "[_will_] Их трахают! Девчонок, сидящих в такой позе, обычно трахают, доволен!?"
msgstr "[_will_] ¡Están jodidos por ellos! Las chicas sentadas en tal pose suelen ser cogidas, felices!?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:154 #-#-# translate crowdin gallery_d_056_7b949964:
msgid "[_cedrick_] Отлично! Можешь же, когда захочешь, Вилл"
msgstr "[_cedrick_] ¡Eso es genial! Puedes, cuando quieras, Will"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:157 #-#-# translate crowdin gallery_d_056_0f278d59:
msgid "[_will_] (Не могу поверить, что сказала это.. Как он только себе позволил..)"
msgstr "[_will_] (No puedo creer que lo dije. Como él solo se permitió...)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:158 #-#-# translate crowdin gallery_d_056_1c45ffc0:
msgid "[_cedrick_] Так, а теперь вопрос - ты хочешь, чтобы и тебя трахнули?"
msgstr "[_cedrick_] Bien, y ahora la pregunta es, ¿quieres estar jodido?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:161 #-#-# translate crowdin gallery_d_056_75a4278e:
msgid "[_will_] Ч-что!? Рик, ты охренел!?"
msgstr "[_will_] ¿¡Qué!? Rick, ¿¡jodido!?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:162 #-#-# translate crowdin gallery_d_056_e6c3fac2:
msgid "[_cedrick_] Отвечай на вопрос так, как будто ты на тесте, Вилл. Это лишь часть тренировки, ты должна отвечать четко и ясно на любые вопросы"
msgstr "[_cedrick_] Responde a la pregunta como si estuvieras en la masa, Will. Esto es solo una parte del entrenamiento, tienes que responder clara y claramente cualquier pregunta"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:163 #-#-# translate crowdin gallery_d_056_bcd124bf:
msgid "[_will_] ..."
msgstr "[_will_] ..."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:166 #-#-# translate crowdin gallery_d_056_09ff6ff0:
msgid "[_will_] Нет. Я не хочу"
msgstr "[_will_] no lo es. No quiero hacerlo"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:167 #-#-# translate crowdin gallery_d_056_d477c6de:
msgid "[_cedrick_] (Так и знал.. Либо я перегнул, либо она еще не готова. В любом случае, уже нет смысла останавливаться)"
msgstr "[_cedrick_] (Así que él sabía. O estoy exagerado o no está lista todavía. En cualquier caso, no tiene sentido parar)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:168 #-#-# translate crowdin gallery_d_056_4bab7ff2:
msgid "[_cedrick_] И так, раз ты не хочешь, чтобы тебя трахнули, значит ты хочешь просто продемонстрировать свою киску, подразнить"
msgstr "[_cedrick_] Y así, ya que no quieres ser cogida, así que solo quieres lucir tu coño, burla"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:171 #-#-# translate crowdin gallery_d_056_dac2cb75:
msgid "[_will_] Что!? Рик! Это переходит все границы!"
msgstr "[_will_] ¿¡Qué!? ¡Rick! ¡Cruza todas las fronteras!"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:172 #-#-# translate crowdin gallery_d_056_0cc24fe6:
msgid "[_cedrick_] Мы здесь не только правильно отвечаем на вопросы, но и учимся новому. И сейчас я научу тебя кое-чему новому, раз ты стремишься к подобному, Вилл"
msgstr "[_cedrick_] No solo estamos respondiendo correctamente a las preguntas, sino que también aprendemos cosas nuevas. Y ahora voy a enseñarte algo nuevo, si estás luchando por algo así, Will"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:175 #-#-# translate crowdin gallery_d_056_aeaf35a0:
