# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:176 #-#-# translate crowdin gallery_d_056_d3f03296:
msgid "[_cedrick_] Хочешь показать мне свою киску - упор на носки и раздвинула бедра"
msgstr "[_cedrick_] ¿Quieres mostrarme tu coño - el énfasis en los calcetines y la extensión de las caderas"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_3.rpy:179 #-#-# translate crowdin gallery_d_056_da06972c:
msgid "[_will_] Ч-что.."
msgstr "[_will_] ¿Qué? ¿Qué?"

