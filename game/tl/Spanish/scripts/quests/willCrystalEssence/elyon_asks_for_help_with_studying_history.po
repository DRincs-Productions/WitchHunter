# TODO: Translation updated at 2023-07-25 15:55 #|#|# # game/scripts/quests/willCrystalEssence/elyon_asks_for_help_with_studying_history.rpy:4 #-#-# translate crowdin elyon_asks_for_help_with_studying_history_a236c3e0:
msgid "[_cedrick_] (Что ж, для начала, нужна причина для того, чтобы регулярно появляться рядом с Вилл у нее дома. Уверен, Сьюзан будет не против моих постоянных визитов, но для постоянного присутствия наедине с Вилл нужна достойная причина..)"
msgstr "[_cedrick_] (Bueno, para empezar, se necesita una razón para aparecer regularmente al lado de la Will en su casa. Estoy seguro de que a Susan no le importarán mis visitas constantes, pero para una presencia permanente a solas con Will necesita una causa digna.)"

# game/scripts/quests/willCrystalEssence/elyon_asks_for_help_with_studying_history.rpy:12 #-#-# translate crowdin elyon_asks_for_help_with_studying_history_d53dc83f:
msgid "[_elion_] Рик, у нас скоро итоговые экзамены в школе. Поможешь подготовиться, ты же как-никак один из преподавателей"
msgstr "[_elion_] Rick, pronto tenemos los exámenes finales en la escuela. Te ayudarás a prepararte, eres uno de los profesores."

# game/scripts/quests/willCrystalEssence/elyon_asks_for_help_with_studying_history.rpy:13 #-#-# translate crowdin elyon_asks_for_help_with_studying_history_a440134a:
msgid "[_cedrick_] (О, точно, подготовка к итоговым экзаменам - то, что надо)"
msgstr "[_cedrick_] (Oh, exactamente, preparación para los exámenes finales - lo que necesita)"

# game/scripts/quests/willCrystalEssence/elyon_asks_for_help_with_studying_history.rpy:14 #-#-# translate crowdin elyon_asks_for_help_with_studying_history_584b52b2:
msgid "[_cedrick_] Эм, да, Элион, обязательно помогу, как будет время. Займемся с тобой подготовкой.. наедине"
msgstr "[_cedrick_] Mm, sí, Elyon, definitivamente te ayudaré a ser el momento. Vamos a entrenar un poco contigo. ¿Solo"

# game/scripts/quests/willCrystalEssence/elyon_asks_for_help_with_studying_history.rpy:17 #-#-# translate crowdin elyon_asks_for_help_with_studying_history_babaf568:
msgid "[_elion_] А-ам.. Я не совсем это имела ввиду, но.. это меня тоже вполне устроит"
msgstr "[_elion_] A-Am... No quise decir eso, pero... También me conviene"

# game/scripts/quests/willCrystalEssence/elyon_asks_for_help_with_studying_history.rpy:20 #-#-# translate crowdin elyon_asks_for_help_with_studying_history_e95696ae:
msgid "[_cedrick_] (Хах, а она уже вполне легко подыгрывает моим намекам, хоть и не готова пока к полноценному сексу. Ну ничего, доведем до этой стадии Вилл, а потом возьмемся как следует за Элион)"
msgstr "[_cedrick_] (Hah, y ella ya es bastante fácil de jugar junto con mis pistas, aunque todavía no está lista para el sexo completo. Bueno, nada, vamos a llevar a esta etapa de la Voluntad, y luego tomamos lo siguiente para Elyon)"

# game/scripts/quests/willCrystalEssence/elyon_asks_for_help_with_studying_history.rpy:23 #-#-# translate crowdin elyon_asks_for_help_with_studying_history_4efdef0a:
msgid "[_elion_] Н-ну я пойду? В книжном еще надо полки протереть"
msgstr "[_elion_] Me voy, ¿de acuerdo? En el libro todavía necesitas limpiar los estantes"

# game/scripts/quests/willCrystalEssence/elyon_asks_for_help_with_studying_history.rpy:24 #-#-# translate crowdin elyon_asks_for_help_with_studying_history_edab646c:
msgid "[_cedrick_] Да, конечно, спасибо, Элион"
msgstr "[_cedrick_] Sí, por supuesto, gracias, Elyon"

# game/scripts/quests/willCrystalEssence/elyon_asks_for_help_with_studying_history.rpy:30 #-#-# translate crowdin elyon_asks_for_help_with_studying_history_9b34a759:
msgid "[_elion_] (Ох.. Я думала в этот раз он пойдет вместе со мной, чтобы, как обычно, уххх.. Ладно, видимо, в следующий раз)"
msgstr "[_elion_] (Oh.. Pensé que esta vez iría conmigo a, como de costumbre, uh... Muy bien, aparentemente la próxima vez)"

# game/scripts/quests/willCrystalEssence/elyon_asks_for_help_with_studying_history.rpy:31 #-#-# translate crowdin elyon_asks_for_help_with_studying_history_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/willCrystalEssence/elyon_asks_for_help_with_studying_history.rpy:32 #-#-# translate crowdin elyon_asks_for_help_with_studying_history_57224c01:
msgid "[_cedrick_] (Так, для начала, нужно написать Вилл и Сьюзан о том, что я скоро к ним наведаюсь)"
msgstr "[_cedrick_] (Así que, primero, tienes que escribir Will y Susan que los visitaré pronto)"

# §translate crowdin strings: #|#|# # game/scripts/quests/willCrystalEssence/elyon_asks_for_help_with_studying_history.rpy:44
msgid "Вилл, привет..."
msgstr "Will, oye..."

