# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:6 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_1_7db1050a:
msgid "[_cedrick_] Сьюзан, привет, ну как ты?"
msgstr "[_cedrick_] Susan, hola, ¿cómo estás?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:10 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_1_35347334:
msgid "[_susan_] Отлично, Рик. Готов к сегодняшнему вечеру?"
msgstr "[_susan_] Muy bien, Rick. ¿Estás listo para esta noche?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:11 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_1_a4bd666d:
msgid "[_cedrick_] Более чем. Но сначала, нужно помочь Вилл с подготовкой"
msgstr "[_cedrick_] Más que. Pero primero, debe ayudar a la Will con la preparación"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:15 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_1_7ded810a:
msgid "[_susan_] Ах, да, точно.. Она у себя в комнате, если что. Сильно там не задерживайтесь"
msgstr "[_susan_] Ah, sí, claro. Está en su habitación, en todo caso. No te quedes ahí"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:16 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_1_91d5a55e:
msgid "[_cedrick_] Хорошо"
msgstr "[_cedrick_] Está bien"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:18 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_1_2a3769d6:
msgid "[_centered_] {size=37}В КОМНАТЕ ВИЛЛ{/size}"
msgstr "[_centered_] {size=37}EN LA HABITACIÓN DE WILL{/size}"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:24 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_1_fabc31f8:
msgid "[_will_] Рик, привет! А я как раз тебя ждала. Ну что, приступим к подготовке? Давай начнем быстрее, не хочу пропустить сериал сегодня вечером"
msgstr "[_will_] ¡Rick, oye! Solo te estaba esperando. Entonces, ¿nos preparamos? Empecemos más rápido, no quiero perderme la serie esta noche"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:25 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_1_7bbac209:
msgid "[_cedrick_] Ох, ценю твое рвение, хоть что-то мотивирует тебя быстрее усваивать материал, хах. Но не стоит так спешить, у нас еще полно времени"
msgstr "[_cedrick_] Oh, aprecio tu celo, al menos algo te motiva a asimilar material, ja. Pero no tenemos que apresurarte, todavía tenemos mucho tiempo"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:26 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_1_6d109fc8:
msgid "[_cedrick_] Для начала, схожу налью нам воды. Сохранение водно-щелочного баланса важно для лучшей усваиваемой материала"
msgstr "[_cedrick_] Para empezar, nos daré el agua. Salvar el equilibrio agua-base es importante para el mejor material digerible"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:30 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_1_9a409365:
msgid "[_will_] О, ты разбираешься в таких тонкостях, сразу видно - профессионал своего дела"
msgstr "[_will_] Oh, conoces tales complejidades, puedes ver - un profesional en su campo"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:31 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_1_2e30366b:
msgid "[_cedrick_] Ну еще бы"
msgstr "[_cedrick_] Ya lo creo"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:33 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_1_69a9563f:
msgid "[_cedrick_] (Самое время для первой дозы кристаллической эссенции. Главное помнить, что мое взаимодействие с ней сформирует ее предпочтения в дальнейшем)"
msgstr "[_cedrick_] (El tiempo para la primera dosis de esencia cristalina. Lo principal que hay que recordar es que mi interacción con ella formará sus preferencias en el futuro)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:34 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_1_5a03f3fe:
msgid "[_cedrick_] (То, как я сейчас к ней буду относиться, определит ее собственные желания в дальнейшем. Эссенция выработает привыкание к любым касаниям, будь то нежные или жесткие. Главное не перегнуть палку)"
msgstr "[_cedrick_] (La forma en que la trato ahora determinará sus propios deseos en el futuro. La esencia desarrollará adicción a cualquier toque, ya sea tierno o rígido. Lo principal es no doblar el palo)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:35 #-#-# translate crowdin crystal_essence_help_will_with_her_studies_1_21dacb0b:
msgid "[_Somka108_] ДАЛЬНЕЙШИЙ ВЫБОР СФОРМИРУЕТ ПРЕДПОЧТЕНИЯ ВИЛЛ В БУДУЩИХ ОБНОВЛЕНИЯХ"
msgstr "[_Somka108_] Más opciones Formará preferencias de Will en futuras actualizaciones"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:40 #-#-# translate crowdin gallery_d_053_57f476c5:
msgid "[_cedrick_] Ну что, приступим к обучению?"
msgstr "[_cedrick_] Bueno, ¿empecemos a aprender?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:44 #-#-# translate crowdin gallery_d_053_cbf56a8c:
msgid "[_will_] Ура, учеба, хахах!! Сарказм.."
msgstr "[_will_] ¡Hurra, estudiar, ja, ja! Sarcasmo…"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:48 #-#-# translate crowdin gallery_d_053_197a2825:
msgid "[_cedrick_] Хах, меня тоже это не радует, но это необходимо для твоего успешного будущего"
msgstr "[_cedrick_] Ja, yo tampoco estoy contento, pero es necesario para tu futuro exitoso"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:53 #-#-# translate crowdin gallery_d_053_476ddc69:
msgid "[_will_] Ох, спасибо, Рик, а вот это и вправду немного мотивирует"
msgstr "[_will_] Oh, gracias, Rick, eso es realmente un poco motivador"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:55 #-#-# translate crowdin gallery_d_053_bec3c2f0:
msgid "[_cedrick_] (...для твоего успешного будущего, в качестве моей рабыни)"
msgstr "[_cedrick_] (…Para tu futuro exitoso, como mi esclavo)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:57 #-#-# translate crowdin gallery_d_053_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:61 #-#-# translate crowdin gallery_d_053_4d781cae:
msgid "[_cedrick_] Затянувшейся агонии Западной Римской империи положил конец скир Одоакр в 476 году он сверг последнего западно-римского императора Ромула Августа..."
msgstr "[_cedrick_] La prolongada agonía del Imperio romano de Occidente terminó en 476, cuando el hérulo Odoacro depuso a Rómulo Augústulo, el último emperador romano de Occidente."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:62 #-#-# translate crowdin gallery_d_053_8cb54dff:
msgid "[_cedrick_] ...Отослал знаки высшей власти византийскому императору Зенону и основал на территории Италии собственное варварское королевство..."
msgstr "[_cedrick_]… Describió los signos del poder más alto al emperador bizantino zeno y fundó su propio reino bárbaro en el territorio de Italia."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:63 #-#-# translate crowdin gallery_d_053_7f75ddc2:
msgid "[_cedrick_] Восточно-римский император Зенон возвел Одоакра в патриции и признал римским наместником..."
msgstr "[_cedrick_] El emperador romano oriental zeno erigió odoacre al patricio y reconoció al gobernador romano."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:64 #-#-# translate crowdin gallery_d_053_094c70e8:
msgid "[_cedrick_] Хотя де факто тот являлся независимым правителем.."
msgstr "[_cedrick_] Aunque de facto era un gobernante independiente."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:65 #-#-# translate crowdin gallery_d_053_420a20bf:
msgid "[_cedrick_]  Говоря о факторах, приведших к утрате величия и мощи Римской империи, современные историки указывают на неэффективность ее армии в поздний период..."
msgstr "[_cedrick_] Hablando de los factores que llevaron a la pérdida de la grandeza y el poder del imperio romano, los historiadores modernos apuntan a la ineficiencia de su ejército en el período tardío."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:67 #-#-# translate crowdin gallery_d_053_33c515cb:
msgid "[_cedrick_] Несмотря на рост списочной численности, состояние здоровья и относительную малочисленность населения Рима..."
msgstr "[_cedrick_] A pesar del crecimiento de la lista, el estado de salud y la población relativamente pequeña de Roma."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:70 #-#-# translate crowdin gallery_d_053_f2768d86:
msgid "[_centered_] {size=37}ПОСЛЕ ДОЛГИХ ЗАНУДНЫХ РЕЧЕЙ{/size}"
msgstr "[_centered_] {size=37}DESPUÉS DE LARGAS EXPRESIONES ABURRIDAS{/size}"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:75 #-#-# translate crowdin gallery_d_053_a20cefa7_1:
msgid "..."
msgstr "..."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:76 #-#-# translate crowdin gallery_d_053_6ff8038c:
msgid "[_cedrick_] (Что ж, прошло уже какое-то время, думаю стоит закрепить эффект эссенции физическим взаимодействием. Черт, она почти уснула, это мой шанс)"
msgstr "[_cedrick_] (Bueno, ha pasado un tiempo, creo que vale la pena arreglar el efecto de la esencia con la interacción física. Diablos, casi se quedó dormida, esta es mi oportunidad)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:77 #-#-# translate crowdin gallery_d_053_9ac0af82:
msgid "[_cedrick_] Подробнее о том, что я говорил, можно узнать на странице 34"
msgstr "[_cedrick_] Más información sobre lo que he dicho, se puede encontrar en la página 34"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:80 #-#-# translate crowdin gallery_d_053_2c939d73:
msgid "[_will_] М.. а, что? где"
msgstr "[_will_] M… Ah, ¿qué? ¿Dónde"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:92 #-#-# translate crowdin gallery_d_053_051ad814:
msgid "[_cedrick_] Вот здесь, Вилл, ну же. Страница ведь прямо перед тобой"
msgstr "[_cedrick_] Aquí, Will, vamos. La página está justo frente a ti."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:93 #-#-# translate crowdin gallery_d_053_3136eb3c:
msgid "[_will_] А-ааа.. Р-рик?"
msgstr "[_will_] A-aaah… ¿R-Rick?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:94 #-#-# translate crowdin gallery_d_053_0a7d8bdc:
msgid "[_cedrick_] Что такое? Вот же она, страница, ты не видишь"
msgstr "[_cedrick_] ¿Qué es? Aquí está, página, no se puede ver"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:95 #-#-# translate crowdin gallery_d_053_b6430682:
msgid "[_will_] Э-эм, нет, п-просто, твоя рука.. уф.. н-не важно, я поняла, спасибо"
msgstr "[_will_] Um, no, es solo, tu mano… Uf. No importa, lo entiendo, gracias."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:96 #-#-# translate crowdin gallery_d_053_51740487:
msgid "[_cedrick_] Ох, прости, я случайно тебя задел"
msgstr "[_cedrick_] Oh, lo siento, accidentalmente te toco"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:99 #-#-# translate crowdin gallery_d_053_ee72c001:
msgid "[_will_] Н-ничего, бывает. Спасибо, что подсказал страницу"
msgstr "[_will_] N-nada, sucede. Gracias por contar la página"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:100 #-#-# translate crowdin gallery_d_053_b3259fcb:
msgid "[_will_] (Черт, он всего лишь случайно коснулся моей груди, но это было так.. так чувственно. Я, ммммв, видимо слишком сильно восприняла это из-за того, что уснула..)"
msgstr "[_will_] (Maldita sea, él accidentalmente me tocó los pechos, pero fue Tan… Tan sensual. Yo, mmmv, aparentemente lo tomé demasiado debido a quedarse dormido.)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:101 #-#-# translate crowdin gallery_d_053_a87bef8d:
msgid "[_will_] (Но, при этом это чувство было на редкость приятным.. раньше я такого не ощущала, что со мной.. Дело во мне или.. Или это Рик так на меня влияет?)"
msgstr "[_will_] (Pero, esta sensación era extremadamente agradable. Nunca me había sentido así antes de que eso fuera con lo que estoy. Es sobre mí O… ¿O Rick realmente me afecta?)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:109 #-#-# translate crowdin gallery_d_053_761ced48:
msgid "[_will_] Р-Рик! Что ты делаешь!? Н-не хватай меня так, ты сдурел!?"
msgstr "[_will_] ¡R-Rick! ¿¡Qué estás haciendo!? ¡No me agarres así, estás corriendo!?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:110 #-#-# translate crowdin gallery_d_053_82dfe2d2:
msgid "[_cedrick_] Что такого, я просто тебя подвинул от учебников. Нужная страница была прямо у тебя перед носом, но из-за своей груди ты ее не заметила"
msgstr "[_cedrick_] ¿Qué pasa? Te acabo de sacar de los libros de texto. La página correcta estaba justo en frente de tu nariz, pero debido a tus pechos no lo notaste"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:111 #-#-# translate crowdin gallery_d_053_c0a1d232:
msgid "[_will_] Н-но это не повод.. Не повод хватать меня за грудь!"
msgstr "[_will_] Pero esa no es una razón… ¡No hay razón para agarrar mi pecho!"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:112 #-#-# translate crowdin gallery_d_053_a7b7aa2d:
msgid "[_cedrick_] Моя первостепенная задача - сделать так, чтобы ты сдала экзамен. У меня нет времени отодвигать тебя от учебного материала так, чтобы тебе было комфортно"
msgstr "[_cedrick_] Mi primera tarea es hacerte pasar el examen. No tengo tiempo para alejarte del material de entrenamiento para que te sientas cómodo"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:113 #-#-# translate crowdin gallery_d_053_dcbed698:
msgid "[_cedrick_] Да и какая разница, хватаю я тебя за грудь или за что-то еще, если в итоге ты увидела то, что нужно было увидеть"
msgstr "[_cedrick_] Sí, y lo que hace, te agarro por el pecho o por otra cosa, si al final viste lo que necesitabas ver"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:116 #-#-# translate crowdin gallery_d_053_d94e761b:
msgid "[_will_] Т-ты что, совсем.. уффф.."
msgstr "[_will_] T-¿qué eres, completamente? Ufff…"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:117 #-#-# translate crowdin gallery_d_053_e0fbe8a2:
msgid "[_will_] (Он абсолютно бесцеремонно схватил меня и передвинул, словно я какая-то мебель..)"
msgstr "[_will_] (Él absolutamente sin ceremonias me agarró y me conmovió, como si fuera una especie de muebles.)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:118 #-#-# translate crowdin gallery_d_053_14f6ec3f:
msgid "[_will_] (Да и к тому же еще и сказал, какая разница, за что меня хватать.. он вдруг резко начал относиться ко мне как к куску мяса, который надо во что бы то ни стало научить..)"
msgstr "[_will_] (Sí, y también dijo cuál es la diferencia que quiero agarrar. De repente comenzó a tratarme como un trozo de carne que debe ser enseñado a toda costa.)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:119 #-#-# translate crowdin gallery_d_053_37cdf232:
msgid "[_will_] (Ааааахх... Это так ужасно.. Бесцеремонно и непростительно грубо.. Никто никогда со мной так не обращался.. Я.. Оххх..)"
msgstr "[_will_] (Aaaah… Esto es terrible… Tan descarado e imperdonablemente grosero… Nadie me había tratado así… Yo… Ohhh…)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:121 #-#-# translate crowdin gallery_d_053_71871923:
msgid "[_will_] (Спокойно, Вилл, тебе не может это настолько нравиться.. Но, с другой стороны, его стремление сделать все для моей учебы, тоже, как ни странно, заводит...)"
msgstr "[_will_] (En voz baja, Will, no te puede gustar tanto… Pero, por otro lado, su deseo de hacer todo por mis estudios, también, curiosamente, se vuelve…)"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:122 #-#-# translate crowdin gallery_d_053_153e9230:
msgid "[_cedrick_] Вилл? Ты что, летаешь в облаках во время урока?"
msgstr "[_cedrick_] ¿Will? ¿Vuelas en las nubes durante la lección?"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:123 #-#-# translate crowdin gallery_d_053_1998c2bf:
msgid "[_will_] Н-нет, Рик.. Т-ты прав, я очень сильно отвлекаюсь.. С-спасибо, что указал мне на нужную страницу"
msgstr "[_will_] N-n-no, Rick. Tienes razón, estoy muy distraída. Gracias por apuntarme en la página correcta"

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:124 #-#-# translate crowdin gallery_d_053_1d401b67:
msgid "[_cedrick_] Рад, что ты понимаешь всю важность подготовки к итоговым экзаменам"
msgstr "[_cedrick_] Me alegra que entiendas la importancia de prepararte para los exámenes finales."

# game/scripts/quests/willCrystalEssence/crystal_essence_help_will_with_her_studies_1.rpy:125 #-#-# translate crowdin gallery_d_053_7569a286:
msgid "[_will_] А-агам..."
msgstr "[_will_] A-agham…"

