# game/scripts/quests/see_the_magazine/see_the_magazine.rpy:226 #-#-# translate crowdin journal_sletty_sluts2_3a3cbda4:
msgid "[_cedrick_] Она одновременно смущена происходящим и наслаждается этим, горячо!"
