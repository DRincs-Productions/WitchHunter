# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:5 #-#-# translate crowdin will_crystal_essence_final_gentle_f319f51e:
msgid "Принятые ранее Седриком решения сформировали к Вилл более нежное отношение"
msgstr "Las decisiones que Cedric tomó antes formaron una actitud más tierna hacia Will"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:9 #-#-# translate crowdin will_crystal_essence_final_gentle_54a4bf53:
msgid "[_cedrick_] Вилл, признаюсь честно, я и вправду довольно вымотался. Этот день был чертовски утомительным"
msgstr "[_cedrick_] Will, seré honesto, en realidad estoy bastante agotado. Este día fue muy agotador."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:10 #-#-# translate crowdin will_crystal_essence_final_gentle_4f9baa18:
msgid "[_cedrick_] Вообще не припомню, чтобы за всю мою жизнь у меня был на столько выматывающий день"
msgstr "[_cedrick_] No recuerdo haber tenido un día tan agotador en toda mi vida."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:11 #-#-# translate crowdin will_crystal_essence_final_gentle_a1a0b7c7:
msgid "[_cedrick_] Был бы рад с тобой еще поразвлечься, но я должен восстановиться. Думаю, тебе тоже не помешал бы отдых"
msgstr "[_cedrick_] Me encantaría divertirme más contigo, pero necesito recuperarme. Creo que a ti también te vendría bien descansar."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:15 #-#-# translate crowdin will_crystal_essence_final_gentle_88a5c4ec:
msgid "[_will_] Д-да, Рик, я тебя понимаю.. Конечно, отдыхай столько, сколько нужно.."
msgstr "[_will_] Sí, Rick, sé lo que quieres decir. Claro, descansa todo lo que necesites."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:16 #-#-# translate crowdin will_crystal_essence_final_gentle_173f4256:
msgid "[_cedrick_] Вот и отлично. Увидимся позже, Вилл"
msgstr "[_cedrick_] Genial. Hasta luego, Will."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:20 #-#-# translate crowdin will_crystal_essence_final_gentle_57083ab0:
msgid "[_will_] Ага, до скорого.."
msgstr "[_will_] Sí, hasta pronto..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:21 #-#-# translate crowdin will_crystal_essence_final_gentle_52f8b5dc:
msgid "[_cedrick_] (Черт, наконец-то я нормально отдохну.. Этот день был чертовски длинным)"
msgstr "[_cedrick_] (Joder, por fin estoy descansando como es debido. Ha sido un día larguísimo)."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:22 #-#-# translate crowdin will_crystal_essence_final_gentle_a7991ea8:
msgid "[_will_] (Он что, серьезно просто уйдет и вот так меня оставит? После того, как я призналась, что почти на все готова?! Да как он.. Черт..)"
msgstr "[_will_] (¿En serio se va a ir y dejarme así? ¡¿Después de admitir que estoy casi lista para cualquier cosa?! ¿Cómo ha podido...? Maldita sea.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:27 #-#-# translate crowdin gallery_d_074_91a3d91a:
msgid "ТОЙ ЖЕ НОЧЬЮ В СПАЛЬНЕ СЬЮЗАН"
msgstr "ESA MISMA NOCHE EN EL DORMITORIO DE SUSAN"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:28 #-#-# translate crowdin gallery_d_074_838d0cd0:
msgid "[_will_] Рик.."
msgstr "[_will_] Rick..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:29 #-#-# translate crowdin gallery_d_074_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:30 #-#-# translate crowdin gallery_d_074_bcd124bf:
msgid "[_will_] ..."
msgstr "[_will_] ..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:31 #-#-# translate crowdin gallery_d_074_b308b998:
msgid "[_will_] Рик, проснись.."
msgstr "[_will_] Rick, despierta..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:32 #-#-# translate crowdin gallery_d_074_0d0288fc:
msgid "[_cedrick_] Ч-что!?"
msgstr "[_cedrick_] ¿¡Q-qué!?"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:37 #-#-# translate crowdin gallery_d_074_9efcae9e:
msgid "[_will_] Т-тише, ты можешь разбудить маму"
msgstr "[_will_] Silencio, puedes despertar a mamá."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:38 #-#-# translate crowdin gallery_d_074_8f52ac0f:
msgid "[_cedrick_] В-вилл, что ты здесь делаешь? Который час?"
msgstr "[_cedrick_] W-Will, ¿qué estás haciendo aquí? ¿Qué hora es?"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:40 #-#-# translate crowdin gallery_d_074_1e2a3464:
msgid "[_will_] Сейчас поздняя ночь. Я дождалась, пока мама окончательно уснет, чтобы она точно не могла нам помешать"
msgstr "[_will_]Es tarde en la noche. Esperé hasta que mi madre finalmente se durmiera para que definitivamente no pudiera molestarnos."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:41 #-#-# translate crowdin gallery_d_074_04e8169c:
msgid "[_cedrick_] (Ох, кажется, я понял, для чего она здесь. Эффект эссенции не позволяет ей больше терпеть)"
msgstr "[_cedrick_] (Oh, creo que entiendo por qué ella está aquí. El efecto de la esencia no le permite aguantar más.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:43 #-#-# translate crowdin gallery_d_074_a11786d2:
msgid "[_will_] Я больше не могу держать себя в руках, Рик.. Игрушки уже не помогают.. Совсем не помогают.."
msgstr "[_will_] No puedo aguantar más, Rick. Los juguetes no funcionan. Para nada."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:44 #-#-# translate crowdin gallery_d_074_c7721755:
msgid "[_will_] Я пробовала много разных.. Но я не могу от них кончить.. Мне нужен настоящий член.. Т-твой член, Рик"
msgstr "[_will_] He probado muchos diferentes. Pero no puedo venirme de ellos. Necesito una polla de verdad. T-tu polla, Rick."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:46 #-#-# translate crowdin gallery_d_074_a9a8edb6:
msgid "[_will_] Только от одной мысли о нем я уже готова кончить.. П-помоги мне"
msgstr "[_will_] Sólo de pensar en él me dan ganas de correrme. Ayúdame."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:48 #-#-# translate crowdin gallery_d_074_7b085deb:
msgid "[_will_] Посмотри, я уже вся насквозь мокрая.."
msgstr "[_will_] Mírame, estoy empapada."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:49 #-#-# translate crowdin gallery_d_074_c5f85631:
msgid "[_cedrick_] Вилл, не уверен, что сейчас у меня достаточно сил, чтобы.."
msgstr "[_cedrick_] Will, no estoy seguro de tener suficiente fuerza para..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:51 #-#-# translate crowdin gallery_d_074_5d023864:
msgid "[_will_] Н-ничего, я сделаю все сама.. Расслабься и получай удовольствие"
msgstr "[_will_] Lo haré todo yo sola. Relájate y disfruta."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:53 #-#-# translate crowdin gallery_d_074_214fead4:
msgid "[_will_] Я постараюсь сделать все правильно.."
msgstr "[_will_] Intentaré hacerlo lo mejor posible."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:54 #-#-# translate crowdin gallery_d_074_b539417a:
msgid "[_cedrick_] Вилл, здесь же Сьюзан.."
msgstr "[_cedrick_] Will, Susan está aquí."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:56 #-#-# translate crowdin gallery_d_074_13325513:
msgid "[_will_] Мне плевать.. Я так больше не могу.."
msgstr "[_will_] No me importa... ya no puedo hacer esto..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:57 #-#-# translate crowdin gallery_d_074_49316299_1:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:58 #-#-# translate crowdin gallery_d_074_e8efd9d3:
msgid "[_cedrick_] Тогда постараемся не разбудить ее, хорошо?"
msgstr "[_cedrick_] Entonces vamos a tratar de no despertarla, ¿de acuerdo?"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:60 #-#-# translate crowdin gallery_d_074_dca11e96:
msgid "[_will_] Сделаю все, что в моих силах"
msgstr "[_will_] Haré lo que pueda."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:62 #-#-# translate crowdin gallery_d_074_1cb8ceeb:
msgid "[_cedrick_] Хорошо, я тоже помогу тебе с твоей проблемой"
msgstr "[_cedrick_] Muy bien, te ayudaré con tu problema también."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:66 #-#-# translate crowdin gallery_d_074_deaaf71b:
msgid "[_will_] Ммммввв.. Н-наконец-то.."
msgstr "[_will_] Mmmmwww. Finalmente."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:67 #-#-# translate crowdin gallery_d_074_2857a125:
msgid "[_cedrick_] Уххх, Вилл, ты отлично взяла его в рот"
msgstr "[_cedrick_] Uhhh, Will, lo tomaste perfectamente en tu boca."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:69 #-#-# translate crowdin gallery_d_074_2548a2d8:
msgid "[_will_] А ты.. Аааххх.. Мне так нравится, как ты ласкаешь мою киску ртом.."
msgstr "[_will_] Y tú... Aaahhhh. Me encanta la forma en que acaricias mi coño con tu boca."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:70 #-#-# translate crowdin gallery_d_074_aea19757:
msgid "[_will_] Мммввв, я.. я так довольно быстро кончу.."
msgstr "[_will_] Mmmwww, voy... voy a correrme tan rápido."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:71 #-#-# translate crowdin gallery_d_074_4f5166e6:
msgid "[_cedrick_] Только не разбуди Сьюзан.."
msgstr "[_cedrick_] No despiertes a Susan."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:72 #-#-# translate crowdin gallery_d_074_217d410c:
msgid "[_will_] Мммвв.. Ч-черт, неужели она регулярно получала такое наслаждение.. Пока я довольствовалась игрушками.. Н-не честно.."
msgstr "[_will_] Maldita sea, ella realmente obtenía tanto placer con regularidad... Mientras yo me conformaba con juguetes... N-no es justo..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:73 #-#-# translate crowdin gallery_d_074_f9bdba87:
msgid "[_cedrick_] Хах, если так подумать, я никогда не делал Сьюзан куни"
msgstr "[_cedrick_] Ja, ahora que lo pienso, nunca le hice un cunnilingus a Susan."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:75 #-#-# translate crowdin gallery_d_074_3e2a9010:
msgid "[_will_] Ч-что, правда? Оооххх, н-неужели ко мне на столько особенное отношение?"
msgstr "[_will_] ¿En serio? Oohhhh, ¿realmente soy tan especial?"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:76 #-#-# translate crowdin gallery_d_074_d2d931d8:
msgid "[_cedrick_] (Нет, скорее дело в том, что ты сама выбрала эту позу и мне ничего другого не остается, кроме как использовать это положение)"
msgstr "[_cedrick_] (No, es más el hecho de que usted mismo eligió esta pose y no tengo más remedio que usar esta posición.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:77 #-#-# translate crowdin gallery_d_074_bfead733:
msgid "[_cedrick_] За особое отношение нужно будет заплатить особенную цену, понимаешь?"
msgstr "[_cedrick_] Tendrás que pagar un precio especial por un trato especial, ¿sabes?"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:78 #-#-# translate crowdin gallery_d_074_467ad4c3:
msgid "[_will_] Ммммвввв, о-о чем ты, Рик?"
msgstr "[_will_] Mmmm, ¿de qué estás hablando, Rick?"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:79 #-#-# translate crowdin gallery_d_074_c61b6b19:
msgid "[_cedrick_] Сегодня я буду с тобой нежен, думаю, ты заслужила за свою инициативность"
msgstr "[_cedrick_] Hoy seré suave contigo, creo que te lo mereces por tu iniciativa."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:80 #-#-# translate crowdin gallery_d_074_565535cd:
msgid "[_cedrick_] Но в следующий раз не думай, что я буду настолько снисходителен. Тебя еще стоит научить манерам и правильному поведению, стражница"
msgstr "[_cedrick_] Pero la próxima vez no creas que seré tan indulgente. Todavía necesitas que te enseñen modales y comportamiento adecuado, guardiana."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:81 #-#-# translate crowdin gallery_d_074_509da050:
msgid "[_will_] Ох.. Я поняла, Рик.. С-спасибо тебе.. Я так рада, что наш первый секс будет таким"
msgstr "[_will_] Oh... lo tengo, Rick... G-gracias... Me alegra mucho que nuestro primer sexo sea así."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:82 #-#-# translate crowdin gallery_d_074_c71f955d:
msgid "[_cedrick_] Девочка, не забывайся, ты еще должна как следует обслужить мой член"
msgstr "[_cedrick_] Chica, no te olvides, todavía tienes que servir a mi polla correctamente."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:84 #-#-# translate crowdin gallery_d_074_bced73ff:
msgid "[_will_] Ахах, к-конечно, как я могу о нем забыть.. Аааааммввв"
msgstr "[_will_] Ahah, por supuesto, ¿cómo podría olvidarme de él? Aaaaaaammmwwwww."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:85 #-#-# translate crowdin gallery_d_074_07d0c85a:
msgid "[_cedrick_] Уууух, отлично.. С каждым разом сосешь все лучше"
msgstr "[_cedrick_] Ooh, eso es bueno. Cada vez chupas mejor."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:87 #-#-# translate crowdin gallery_d_074_dae3eb1d:
msgid "[_will_] Ммммввв, твой язык так извивается во мне, я.. Ааааахх, я скоро кончу"
msgstr "[_will_] Mmmmwww, tu lengua se retuerce tanto dentro de mí, yo. Aaaahh, me correré pronto."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:88 #-#-# translate crowdin gallery_d_074_b4987dc5:
msgid "[_cedrick_] Аккуратнее с голосом, ты можешь разбудить свою мать"
msgstr "[_cedrick_] Cuidado con tu voz, podrías despertar a tu madre."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:90 #-#-# translate crowdin gallery_d_074_7e9a9578:
msgid "[_will_] Хах, это было бы очень досадно, ведь ты пока так и не успел меня трахнуть"
msgstr "[_will_] Sería una pena, porque aún no has tenido la oportunidad de follarme."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:91 #-#-# translate crowdin gallery_d_074_99c0ec38:
msgid "[_cedrick_] Тогда думаю самое время начать"
msgstr "[_cedrick_] Entonces creo que es hora de que empecemos."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:92 #-#-# translate crowdin gallery_d_074_77bdf428:
msgid "[_will_] Х-хорошо.. Дай мне минутку, я поменяю позу"
msgstr "[_will_] Muy bien. Dame un minuto, voy a cambiar mi pose."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:96 #-#-# translate crowdin gallery_d_074_f3a1b725:
msgid "[_will_] Ох, вот так, да, так отлично.. Ммм, он почти во мне, хочу сделать это аккуратно.. Дай мне немного времени"
msgstr "[_will_] Oh, eso es, sí, eso es bueno. Mmm, está casi dentro de mí, quiero hacerlo suavemente. Dame un poco de tiempo."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:97 #-#-# translate crowdin gallery_d_074_858e2964:
msgid "[_cedrick_] Ну же, Вилл, будь чуть смелее"
msgstr "[_cedrick_] Vamos, Will, sé un poco más valiente."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:98 #-#-# translate crowdin gallery_d_074_714dfcea:
msgid "[_will_] Я.. Ааахх.. Как только я прикасаюсь к твоему члену своей киской, все тело начинает дрожать.. Это сложно сделать самой"
msgstr "[_will_] Yo... Aahhh... Tan pronto como toco tu polla con mi coño, todo mi cuerpo comienza a temblar... Es difícil hacerlo yo misma."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:99 #-#-# translate crowdin gallery_d_074_1f45e0b6:
msgid "[_cedrick_] Тогда давай я тебе помогу"
msgstr "[_cedrick_] Entonces déjame ayudarte."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:100 #-#-# translate crowdin gallery_d_074_b85ad860:
msgid "[_will_] Ч-что!? Аааааахххх"
msgstr "[_will_] ¿Q-qué!? Aaaaahhh"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:104 #-#-# translate crowdin gallery_d_074_74b3d65a:
msgid "[_will_] Уууууувввв.. Р-рик, так сразу взять меня за талию и насадить на свой член.. Это.."
msgstr "[_will_] Uuuuuuhhhh... R-Rick, solo tómame por la cintura y ponme en tu polla... Esto..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:105 #-#-# translate crowdin gallery_d_074_c455344c:
msgid "[_will_] К-кажется я кончила.. Это было так резко.. И так приятно.. Аааахх.. Я таю.."
msgstr "[_will_] Creo que me corrí... Fue tan fuerte... Y tan agradable... Aaaahh... Me estoy derritiendo..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:106 #-#-# translate crowdin gallery_d_074_b5503234:
msgid "[_cedrick_] Черт, надеюсь Сьюзан не услышала твои стоны. Будь тише, Вилл.."
msgstr "[_cedrick_] Maldita sea, espero que Susan no te haya oído gemir. Cállate, Will..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:107 #-#-# translate crowdin gallery_d_074_cdd17d39:
msgid "[_will_] К-как тут быть тише, когда во мне такой член.. Боже, как же долго я этого ждала.. Как сильно этого хотела"
msgstr "[_will_] C-cómo puedo estar más tranquila aquí cuando hay tal polla dentro de mí... Dios, cuánto tiempo he estado esperando por esto... ¿Cuánto deseaba esto?"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:108 #-#-# translate crowdin gallery_d_074_37aaf406:
msgid "[_cedrick_] Хах, не самый достойные слова для стражницы завесы - признание в том, что быть насаженной на член это предел твоих мечтаний"
msgstr "[_cedrick_] Ja, no son las palabras más dignas para un guardián del velo: admitir que ser empalado en un pene es el límite de tus sueños."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:109 #-#-# translate crowdin gallery_d_074_db006ab5:
msgid "[_will_] Д-да мне плевать.. Ааааххх.. Вся эта ответственность, все эти чертовы обязательства.."
msgstr "[_will_] S-sí, no me importa... Aaaahhh... Toda esta responsabilidad, todas estas malditas obligaciones..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:110 #-#-# translate crowdin gallery_d_074_a69da162:
msgid "[_will_] Может я и не хотела вовсе становиться стражницей? Уууууввв.. М-может меня сделали ею насильно.."
msgstr "[_will_] ¿Quizás no quería ser guardia en absoluto? Uuuuuuhh... T-tal vez me hicieron una a la fuerza..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:111 #-#-# translate crowdin gallery_d_074_159f220f:
msgid "[_will_] А на деле все, что мне на самом деле было нужно — это крепкий здоровый член.. Именно твой член, Рик.."
msgstr "[_will_] Pero en realidad, todo lo que realmente necesitaba era una polla fuerte y saludable... Era tu polla, Rick..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:112 #-#-# translate crowdin gallery_d_074_0b447689:
msgid "[_will_] Вот чего я на самом деле хочу, вот чего жаждет мое тело.. А не эта бесконечная беготня за монстрами и порталами.."
msgstr "[_will_] Esto es lo que realmente quiero, esto es lo que mi cuerpo anhela... Y no esta carrera interminable detrás de monstruos y portales..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:113 #-#-# translate crowdin gallery_d_074_da5e9ef2:
msgid "[_will_] В этом нет совершенно никакого удовольствия.. Оооооххх.."
msgstr "[_will_] No hay absolutamente ningún placer en eso... Oooohhhh..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:114 #-#-# translate crowdin gallery_d_074_1e30cd51:
msgid "[_cedrick_] Надо же, какая откровенность. А ведь я монстр, Вилл, ваш враг. По сути твоя обязанность - это победить меня"
msgstr "[_cedrick_] Vaya, que franqueza. Pero soy un monstruo, Will, tu enemigo. Esencialmente tu deber es derrotarme."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:115 #-#-# translate crowdin gallery_d_074_09f97153:
msgid "[_cedrick_] А вместо этого ты сейчас скачешь на моем члене и изо всех сил пытаешься сдержать голос, чтобы не разбудить спящую рядом мать. Что с тобой стало?"
msgstr "[_cedrick_] Pero en cambio, ahora estás montando mi polla y haciendo todo lo posible por contener la voz para no despertar a tu madre que duerme a tu lado. ¿Qué te pasó?"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:116 #-#-# translate crowdin gallery_d_074_38a4c138:
msgid "[_will_] Я.. Я-я... Аааахххх... Да мне все равно... В-все, что я знаю — это то, что хочу этого и то, что происходит сейчас, доставляет мне удовольствие. Остальное не важно.."
msgstr "[_will_] Yo... Yo-yo... Aaaahhhh... No me importa... L-lo único que sé es que lo quiero y lo que está pasando ahora me da placer. Nada más importa..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:117 #-#-# translate crowdin gallery_d_074_8dfdcb9c:
msgid "[_cedrick_] Хах, отлично сказано, Вилл. Дай-ка раздвину твои ноги, попробуем слегка другую позицию"
msgstr "[_cedrick_] Ja, bien dicho, Will. Déjame abrir las piernas, probemos una posición ligeramente diferente."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:119 #-#-# translate crowdin gallery_d_074_fa36177f:
msgid "[_will_] С-стой.. Оооохх.. Ч-что ты.."
msgstr "[_will_] E-espera... Ooohhh... ¿Q-qué estás..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:123 #-#-# translate crowdin gallery_d_074_fc592a82:
msgid "[_cedrick_] Вот так-то лучше. Теперь я могу полностью вогнать в тебя свой член"
msgstr "[_cedrick_] Eso es mejor. Ahora puedo empujar mi polla hasta el fondo de ti."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:124 #-#-# translate crowdin gallery_d_074_7bfc9fe6:
msgid "[_will_] Ааахх.. Ааааахх.. Я только что кончила.. И не раз.. Боже, как же хорошо.. Я не могу сдержать голос"
msgstr "[_will_] Aaahh... Aaaaahh... Acabo de llegar... Y más de una vez... Dios, es tan bueno... No puedo contener mi voz."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:126 #-#-# translate crowdin gallery_d_074_2942dffb:
msgid "[_cedrick_] Придется, Вилл, иначе это будет последний раз, когда мы с тобой занимаемся этим. Ты ведь не хочешь, чтобы это прекращалось?"
msgstr "[_cedrick_] Tendrás que hacerlo, Will, o será la última vez que tú y yo hagamos esto. No quieres que esto termine, ¿verdad?"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:127 #-#-# translate crowdin gallery_d_074_fcf02df6:
msgid "[_will_] Н-нет.. Т-только не это.. Я постараюсь быть тише, просто... Ууууввв, твой член так хорош.. Это чувство.. Ни с чем не сравнится.."
msgstr "[_will_]  N-no. Tú... eso no. Intentaré no hacer ruido, sólo... Ooh, tu polla se siente tan bien. Se siente... No hay nada como eso."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:128 #-#-# translate crowdin gallery_d_074_bcb52502:
msgid "[_cedrick_] Хах, Вилл, посмотри на себя. Что бы сказали твои дорогие подруги, увидев тебя такой?"
msgstr "[_cedrick_] Eh, Will, mírate. ¿Qué dirían tus queridos amigas si te vieran así?"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:130 #-#-# translate crowdin gallery_d_074_3e67423b:
msgid "[_cedrick_] Ты получаешь такое наслаждение от члена монстра, который буквально запер твоих подруг в темнице"
msgstr "[_cedrick_] Obtienes mucho placer con la polla del monstruo que literalmente encerró a tus amigas en un calabozo."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:131 #-#-# translate crowdin gallery_d_074_7b7fdfc1:
msgid "[_cedrick_] Они сейчас там закованы в кандалы, и стражники насилуют их взглядом, а ты скачешь на члене их захватчика и просишь еще"
msgstr "[_cedrick_] Ahora están encadenados allí, y los guardias los violan con la mirada, y tú cabalgas la polla de su captor y le pides más."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:132 #-#-# translate crowdin gallery_d_074_dc5ad615:
msgid "[_will_] Оооххх.. Ааааххх.. Ч-что ж, значит вот такая я конченая тварь.. Потому что пока во мне находится твой член, мне на все это плевать.."
msgstr "[_will_] Oooohhh... Aaaahhh... B-bueno, eso significa que soy una criatura tan completa... Porque mientras tu polla esté dentro de mí, no me importa todo esto..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:133 #-#-# translate crowdin gallery_d_074_86ee5588:
msgid "[_will_] Плевать на подруг, плевать на маму, на спасение мира.. На все плевать.. Я чувствую, как во мне пульсирует твой член и понимаю, что это все, что мне нужно.."
msgstr "[_will_] No me importan mis amigas, no me importa mi madre, no me importa salvar el mundo... No me importa todo... Siento tu pene pulsando dentro de mí y entiendo que esto es todo lo que necesito..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:134 #-#-# translate crowdin gallery_d_074_cf1ab708:
msgid "[_will_] Это все, чего я действительно когда-либо хотела.. То, что делает меня по настоящему счастливой.."
msgstr "[_will_] Esto es todo lo que siempre he querido... Lo que me hace realmente feliz..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:135 #-#-# translate crowdin gallery_d_074_71d36635:
msgid "[_will_] Ни подруги, ни что либо еще не может дать мне этого, дать такого наслаждения.. Поэтому.. Поэтому я так спокойно предаю их.."
msgstr "[_will_] Ni novias ni nada puede darme esto, darme tanto placer... Por eso... Por eso los traiciono con tanta calma..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:136 #-#-# translate crowdin gallery_d_074_f5de138d:
msgid "[_cedrick_] Хах, вот ты и сама признала то, кем на самом деле являешься. Получай, дрянная девчонка!"
msgstr "[_cedrick_] Ja, entonces tú mismo admitiste quién eres realmente. ¡Toma eso, chica mala!"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:139 #-#-# translate crowdin gallery_d_074_f7410e3b:
msgid "[_will_] Ааааххх.. Оооввввв.. Я-я заполняюсь.. Т-так горячо.."
msgstr "[_will_] Aaaahhh.. Ooohhh... Me-me estoy llenando... Q-qué calor..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:143 #-#-# translate crowdin gallery_d_074_97e0e4f7:
msgid "[_cedrick_] Что ж, рад, что ты полностью осознала свое положение. Надо же, даже не пришлось на тебя давить и как-то манипулировать"
msgstr "[_cedrick_] Bueno, me alegra que estés plenamente consciente de tu situación. Vaya, ni siquiera tuve que presionarte ni manipularte de ninguna manera."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:144 #-#-# translate crowdin gallery_d_074_4f042b44:
msgid "[_cedrick_] Ты сама пришла к нужному выводу. Все верно, ты предательница, жаждущая члена. Тебя никто не простит за это и теперь у тебя нет пути назад"
msgstr "[_cedrick_] Usted misma llegó a la conclusión correcta. Así es, eres una traidora hambrienta de pollas. Nadie te perdonará por esto y ahora no hay vuelta atrás."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:145 #-#-# translate crowdin gallery_d_074_1b826885:
msgid "[_will_] Ааааххх... Аааааххх.. Я кончила.."
msgstr "[_will_] Aaahhhh. Aaahhhh. He terminado."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:146 #-#-# translate crowdin gallery_d_074_7415a8cd:
msgid "[_cedrick_] Все, что теперь у тебя есть, твой единственный путь — это быть моей, подчиниться моему члену и получать удовольствие"
msgstr "[_cedrick_] Todo lo que tienes ahora, tu única manera es ser mía, someterte a mi polla y divertirte."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:148 #-#-# translate crowdin gallery_d_074_953f219b:
msgid "[_will_] Я... Оооввв.. Да, это то, чего я хочу, Рик.. Звучит как сказка.."
msgstr "[_will_] Yo... Oooohhh... Sí, eso es lo que quiero, Rick... Suena como un cuento de hadas..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:149 #-#-# translate crowdin gallery_d_074_c891e0dd:
msgid "[_cedrick_] Вот и отлично. Приведи себя в порядок и уходи, пока Сьюзан не проснулась"
msgstr "[_cedrick_] Genial. Límpiate y vete antes de que Susan se despierte."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:150 #-#-# translate crowdin gallery_d_074_d71a1e54:
msgid "[_cedrick_] И запомни, в следующий раз я уже не буду к тебе столь снисходителен. Не забывай свое место"
msgstr "[_cedrick_] Y recuerda, la próxima vez no seré tan indulgente contigo. No olvides tu lugar."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:151 #-#-# translate crowdin gallery_d_074_79c16881:
msgid "[_will_] Х-хорошо, Рик, я тебя поняла.."
msgstr "[_will_] E-está bien, Rick, te entiendo..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:153 #-#-# translate crowdin gallery_d_074_a291a1cf:
msgid "[_will_] (Ах.. Вот он, мой первый секс.. Так волнительно.. Но так приятно.. Мое тело хочет еще и еще..)"
msgstr "[_will_] (Ah... Aquí está, mi primera relación sexual... Tan excitante... Pero tan agradable... Mi cuerpo quiere más y más...)"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:154 #-#-# translate crowdin gallery_d_074_3707cd86:
msgid "[_will_] (Моя жажда настолько сильна, что она заглушает все разумные доводы.. Подруги, спасение мира.. Все это уже не важно для меня.. Я просто хочу всегда быть с Риком..)"
msgstr "[_will_] (Mi sed es tan fuerte que ahoga todos los argumentos razonables... Amigas, salvar el mundo... Todo esto ya no es importante para mí... Sólo quiero estar siempre con Rick...)"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_gentle.rpy:155 #-#-# translate crowdin gallery_d_074_d1a10e96:
msgid "[_will_] (Я больше не стражница завесы, я не лидер.. Я лишь его женщина, которую он только что наполнил своей спермой.. И это то, кем я хочу быть..)"
msgstr "[_will_] (Ya no soy el guardián del velo, no soy un líder. Solo soy su mujer que acaba de llenar con su esperma. Y eso es lo que quiero ser.)"

