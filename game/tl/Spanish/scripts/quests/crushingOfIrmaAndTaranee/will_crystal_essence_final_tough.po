# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:4 #-#-# translate crowdin will_crystal_essence_final_tough_069152b1:
msgid "Принятые ранее Седриком решения сформировали к Вилл жесткое отношение"
msgstr "Las decisiones que Cedric tomó antes formaron una actitud dura hacia Will."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:8 #-#-# translate crowdin will_crystal_essence_final_tough_b93db20c:
msgid "[_cedrick_] И так, Сьюзан ушла на кухню и нас не услышит. Вилл, ты же понимаешь, что произойдет сегодня ночью?"
msgstr "[_cedrick_] Entonces Susan fue a la cocina y no nos escuchó. Will, entiendes lo que va a pasar esta noche, ¿verdad?"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:12 #-#-# translate crowdin will_crystal_essence_final_tough_bcd124bf:
msgid "[_will_] ..."
msgstr "[_will_] …"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:13 #-#-# translate crowdin will_crystal_essence_final_tough_8b7cf4a0:
msgid "[_cedrick_] Я приду к тебе в комнату, когда Сьюзан будет спать. Будь готова к этому времени"
msgstr "[_cedrick_] Iré a tu habitación cuando Susan esté dormida. Prepárate para este momento."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:17 #-#-# translate crowdin will_crystal_essence_final_tough_7e8b557e:
msgid "[_will_] Мммв.. И как ты хочешь, чтобы я подготовилась?"
msgstr "[_will_] Hmmm… ¿Y cómo quieres que me prepare?"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:18 #-#-# translate crowdin will_crystal_essence_final_tough_63a2ea9d:
msgid "[_cedrick_] Раз уж в бассейне не получилось заняться тобой всерьез, хочу, чтобы в эту ночь ты была в спортивном купальнике. И еще, чтобы на тебе были чулки. Поняла?"
msgstr "[_cedrick_] Como no podía tomarte en serio en la piscina, quiero que esta noche uses un traje de baño deportivo. Y además, que tengas medias puestas. ¿Comprendido?"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:22 #-#-# translate crowdin will_crystal_essence_final_tough_ceab2205:
msgid "[_will_] Эмм.. Но у меня нет чулок, есть только домашние гольфы.."
msgstr "[_will_] Um… Pero no tengo medias, solo tengo calcetines hasta la rodilla…"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:23 #-#-# translate crowdin will_crystal_essence_final_tough_1b8db356:
msgid "[_cedrick_] А мне плевать. Они должны быть на тебе сегодня ночью. Так что советую поторапливаться, Вилл, к вечеру магазин обычно закрывается"
msgstr "[_cedrick_] No me importa. Deberías ponértelos esta noche. Así que te aconsejo que te des prisa, Will, la tienda suele cerrar por la noche."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:27 #-#-# translate crowdin will_crystal_essence_final_tough_59a4b405:
msgid "[_will_] Эм, в каком смысле?"
msgstr "[_will_] ¿Qué quieres decir?"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:28 #-#-# translate crowdin will_crystal_essence_final_tough_3a595201:
msgid "[_cedrick_] Уж я точно не собираюсь бежать в магазин и покупать тебе что-то за свои деньги, у меня есть более важные дела"
msgstr "[_cedrick_] Definitivamente no voy a correr a la tienda y comprarte algo con mi propio dinero, tengo cosas más importantes que hacer."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:29 #-#-# translate crowdin will_crystal_essence_final_tough_9cec86c9:
msgid "[_cedrick_] Но если ты не сделаешь то, о чем я тебя прошу, тогда гарантирую, что сегодня ты потеряешь исключительно анальную девственность"
msgstr "[_cedrick_] Pero si no haces lo que te pido, te garantizo que hoy solo perderás tu virginidad anal."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:33 #-#-# translate crowdin will_crystal_essence_final_tough_bcd124bf_1:
msgid "[_will_] ..."
msgstr "[_will_] …"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:37 #-#-# translate crowdin will_crystal_essence_final_tough_b1d18612:
msgid "[_will_] К-когда ты успел стать настолько жестоким, не понимаю.."
msgstr "[_will_] ¿C-cuándo te volviste tan cruel? No lo entiendo…"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:41 #-#-# translate crowdin will_crystal_essence_final_tough_727e08f1:
msgid "[_cedrick_] Миранда была права, сказав, что, не смотря на наши отношения, мы с тобой все еще враги"
msgstr "[_cedrick_] Miranda tenía razón cuando dijo que, a pesar de nuestra relación, tú y yo seguimos siendo enemigos."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:42 #-#-# translate crowdin will_crystal_essence_final_tough_6897fb6f:
msgid "[_cedrick_] Я - Лорд Седрик, а ты - Стражница завесы. Тебе придется постараться, чтобы доказать свою преданность. Понимаешь, о чем я?"
msgstr "[_cedrick_] Soy Lord Cedric y tú eres el Guardián del Velo. Tendrás que trabajar duro para demostrar tu lealtad. ¿Sabes a qué me refiero?"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:46 #-#-# translate crowdin will_crystal_essence_final_tough_eae3024b:
msgid "[_will_] Д-да.. Я поняла тебя, Седрик.."
msgstr "[_will_] S-sí… te entendí, Cedric…"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:50 #-#-# translate crowdin will_crystal_essence_final_tough_a9b6bae0:
msgid "[_cedrick_] Хорошая девочка. Тогда до вечера. И не зови меня Седрик в этом доме, Сьюзан может услышать"
msgstr "[_cedrick_] Buena chica. Entonces nos vemos por la noche. Y no me llames Cedric en esta casa, Susan podría oír."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:54 #-#-# translate crowdin will_crystal_essence_final_tough_75379283:
msgid "[_will_] Я-я поняла, Рик"
msgstr "[_will_] Lo entiendo, Rick."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:58 #-#-# translate crowdin will_crystal_essence_final_tough_0d96e007:
msgid "[_centered_] {size=37} НОЧЬЮ В КОМНАТЕ ВИЛЛ{/size}"
msgstr "[_centered_] {size=37} DE NOCHE EN LA HABITACIÓN DE WILL{/size}"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:61 #-#-# translate crowdin will_crystal_essence_final_tough_94366180:
msgid "[_will_] Ммм, я купила все, что ты просил. Тебе нравится?"
msgstr "[_will_] Mmm, compré todo lo que pediste. ¿Te gusta?"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:62 #-#-# translate crowdin will_crystal_essence_final_tough_ef944f38:
msgid "[_cedrick_] Отлично в этом смотришься, Вилл. Хорошая работа"
msgstr "[_cedrick_] Te ves genial con esto, Will. Buen trabajo."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:64 #-#-# translate crowdin will_crystal_essence_final_tough_168f33b9:
msgid "[_will_] C-спасибо, Рик"
msgstr "[_will_] G-gracias, Rick."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:65 #-#-# translate crowdin will_crystal_essence_final_tough_6f34a6ca:
msgid "[_cedrick_] (Не стоит забывать про принцип кнута и пряника. Ругать ее за просчеты и неповиновение и хвалить за послушность)"
msgstr "[_cedrick_] (No te olvides del principio del palo y la zanahoria. Regáñala por sus errores de cálculo y desobediencia y elógiala por su obediencia.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:67 #-#-# translate crowdin will_crystal_essence_final_tough_5aa6a119:
msgid "[_will_] М, а почему ты попросил надеть меня именно этот костюм?"
msgstr "[_will_] Mm, ¿por qué me pediste que usara este traje en particular?"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:68 #-#-# translate crowdin will_crystal_essence_final_tough_89a722bd:
msgid "[_cedrick_] Во-первых, чтобы проверить, на сколько ты послушна сейчас. Момент с магазином был не только прихотью, но и проверкой"
msgstr "[_cedrick_] En primer lugar, comprobar qué tan obediente eres ahora. El momento con la tienda no fue sólo un capricho, sino también una prueba."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:70 #-#-# translate crowdin will_crystal_essence_final_tough_34c7f7f3:
msgid "[_will_] П-понятно.."
msgstr "[_will_] Ya veo…"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:71 #-#-# translate crowdin will_crystal_essence_final_tough_242d7301:
msgid "[_cedrick_] Советую привыкнуть, таких проверок будет еще много"
msgstr "[_cedrick_] Te aconsejo que te acostumbres, habrá muchos más controles de este tipo."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:72 #-#-# translate crowdin will_crystal_essence_final_tough_bcd124bf_2:
msgid "[_will_] ..."
msgstr "[_will_] …"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:74 #-#-# translate crowdin will_crystal_essence_final_tough_f6be724c:
msgid "[_will_] А во-вторых?"
msgstr "[_will_] ¿Y qué sigue?"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:76 #-#-# translate crowdin will_crystal_essence_final_tough_9aee07be:
msgid "[_cedrick_] Твоя грудь слегка выходит за рамки купальника"
msgstr "[_cedrick_] Tus senos se extienden ligeramente más allá de tu traje de baño."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:77 #-#-# translate crowdin will_crystal_essence_final_tough_8c961c94:
msgid "[_cedrick_] Бедра полностью обнажены, а купальник плотно прилегает к твоей фигуре"
msgstr "[_cedrick_] Los muslos quedan completamente al descubierto y el bañador se ajusta perfectamente a tu figura."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:78 #-#-# translate crowdin will_crystal_essence_final_tough_17ed797c:
msgid "[_cedrick_] На Меридиане в таких костюмах никто не ходит, для меня это все еще в новинку"
msgstr "[_cedrick_] Nadie usa esos trajes en Meridian, todavía es nuevo para mí."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:79 #-#-# translate crowdin will_crystal_essence_final_tough_440bfcae:
msgid "[_cedrick_] Так что может вы, земляне, к подобному привыкли, но лично я считаю довольно сексуальным"
msgstr "[_cedrick_] Quizás ustedes, terrícolas, estén acostumbrados a esto, pero personalmente lo encuentro bastante sexy."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:80 #-#-# translate crowdin will_crystal_essence_final_tough_27a51c51:
msgid "[_cedrick_] Кто вообще додумался сделать подобную одежду частью нормы?"
msgstr "[_cedrick_] ¿A quién se le ocurrió siquiera hacer que esa ropa fuera parte de la norma?"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:82 #-#-# translate crowdin will_crystal_essence_final_tough_59d7c592:
msgid "[_will_] Кажется, подобные плавательные костюмы считаются частью формы в японских школах"
msgstr "[_will_] Parece que trajes de baño como este se consideran parte del uniforme en las escuelas japonesas."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:84 #-#-# translate crowdin will_crystal_essence_final_tough_d5bb1976:
msgid "[_will_] Как раз таки там девушки порой ходят в таком купальнике и черных чулках. Правда купальник под школьной формой. Но, да, это считается нормой"
msgstr "[_will_] Es allí donde las chicas a veces usan traje de baño y medias negras. Verdadero traje de baño debajo del uniforme escolar. Pero sí, esto se considera la norma."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:85 #-#-# translate crowdin will_crystal_essence_final_tough_2c438a2a:
msgid "[_cedrick_] Тот, кто это придумал - долбанный гений и тот еще скрытный извращенец. По сути, он нормировал развратный наряд"
msgstr "[_cedrick_] A quien se le ocurrió esto es un puto genio y también un pervertido reservado. Esencialmente, normalizó la vestimenta de zorra."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:87 #-#-# translate crowdin will_crystal_essence_final_tough_f23cca7f:
msgid "[_will_] Хах, типо того.."
msgstr "[_will_] Jaja, algo así…"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:88 #-#-# translate crowdin will_crystal_essence_final_tough_de7dbd71:
msgid "[_cedrick_] Что ж, я вдоволь насмотрелся. Самое время заняться делом, Вилл"
msgstr "[_cedrick_] Bueno, ya he visto suficiente. Es hora de ponerse manos a la obra, Will."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:90 #-#-# translate crowdin will_crystal_essence_final_tough_2885241c:
msgid "[_will_] Ммм, да, Рик, наконец-то мы займемся самым интересным! Я так этого ждала. Трахни меня наконец"
msgstr "[_will_] Mmm, sí, Rick, ¡finalmente llegamos a la parte divertida! Tenía muchas ganas de esto. Fóllame finalmente."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:91 #-#-# translate crowdin will_crystal_essence_final_tough_30db11d1:
msgid "[_cedrick_] (Хах, энтузиазма ей не занимать, эссенция работает как надо. И даже не плавит ей мозги, как Алхими. Но она все еще своевольна, надо постепенно это пресечь)"
msgstr "[_cedrick_] (Ja, a ella no le falta entusiasmo, la esencia funciona como debería. Y ni siquiera derrite su cerebro, como a Alchemy. Pero todavía es obstinada, debemos detener esto gradualmente.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:92 #-#-# translate crowdin will_crystal_essence_final_tough_3d1d77d2:
msgid "[_cedrick_] Хех, нет уж, девочка, здесь я говорю, что тебе делать. Повернись ко мне лицом и вставай на колени"
msgstr "[_cedrick_] Je, no niña, aquí te digo lo que tienes que hacer. Voltéate hacia mí y ponte de rodillas."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:96 #-#-# translate crowdin will_crystal_essence_final_tough_76c2a442:
msgid "[_will_] Ууух, хоть я еще до конца и не определилась, как отношусь к подобного рода прямым приказам, но мне нравится, когда ты такой напористый.."
msgstr "[_will_] Uuuh, aunque no he decidido completamente cómo me siento acerca de este tipo de órdenes directas, me gusta cuando eres tan asertivo…"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:97 #-#-# translate crowdin will_crystal_essence_final_tough_3d20fc5b:
msgid "[_cedrick_] Хах, я не спрашивал твоего мнения, но, да, нужно же учить предводительницу стражниц хорошим манерам"
msgstr "[_cedrick_] Ja, no te pedí tu opinión, pero sí, tenemos que enseñarle buenos modales a la líder de las Guardianas."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:99 #-#-# translate crowdin will_crystal_essence_final_tough_ffdbe006:
msgid "[_will_] Ммм, да, я готова учиться! К тому же, технически ты все еще мой учитель и репетитор, хах.."
msgstr "[_will_] Mmm, sí, ¡estoy lista para aprender! Además, técnicamente sigues siendo mi profesor y tutor, ja…"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:101 #-#-# translate crowdin will_crystal_essence_final_tough_bd89b789:
msgid "[_cedrick_] Меньше слов и больше дела, девочка"
msgstr "[_cedrick_] Menos palabras y más acción, chica."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:102 #-#-# translate crowdin will_crystal_essence_final_tough_d8c46e28:
msgid "[_cedrick_] Для начала запомни, что, прежде чем просить о том, чтобы тебя трахнули, ты должна как следует отсосать мой член"
msgstr "[_cedrick_] Primero, recuerda que antes de pedir que te cojan, debes chuparme la verga como es debido."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:104 #-#-# translate crowdin will_crystal_essence_final_tough_e3c02770:
msgid "[_will_] Ммммв, хорошо.. Мне еще столькому предстоит научиться. Хорошо, что у меня есть такой строгий учитель"
msgstr "[_will_] Mmmm, está bien… todavía tengo mucho que aprender. Es bueno que tenga un maestro tan estricto."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:108 #-#-# translate crowdin will_crystal_essence_final_tough_fe409c8b:
msgid "[_cedrick_] Ух, ты справляешься все лучше, Вилл"
msgstr "[_cedrick_] Vaya, estás mejorando, Will."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:110 #-#-# translate crowdin will_crystal_essence_final_tough_ee75b3a4:
msgid "[_will_] Ааафа"
msgstr "[_will_] Aaaaah."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:111 #-#-# translate crowdin will_crystal_essence_final_tough_806f30af:
msgid "[_cedrick_] Продолжай в том же духе и вскоре сможешь делать первоклассный минет"
msgstr "[_cedrick_] Sigue con el buen trabajo y pronto estarás haciendo una mamada de primera."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:113 #-#-# translate crowdin will_crystal_essence_final_tough_e15fc684:
msgid "[_will_] Ммммв.. Я фтараюф.."
msgstr "[_will_] Mm-hmm. Con suerte."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:114 #-#-# translate crowdin will_crystal_essence_final_tough_e460b5e9:
msgid "[_will_] (Главное не уступить этой гребаной паучихе.. Я хочу быть лучшей для Рика в этом деле.. Во всем..)"
msgstr "[_will_] (Lo principal es no ceder ante esa maldita araña… Quiero ser la mejor para Rick en este asunto… En todo…)"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:116 #-#-# translate crowdin will_crystal_essence_final_tough_9c626efc:
msgid "[_cedrick_] Уууф, стараешься с полной отдачей, Вилл.. Отличная работа языком.."
msgstr "[_cedrick_] Uuuff, haz lo mejor que puedas, Will… Gran trabajo con la lengua…"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:118 #-#-# translate crowdin will_crystal_essence_final_tough_792b7069:
msgid "[_will_] Мммгмм.."
msgstr "[_will_] Mmmmm…"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_tough.rpy:119 #-#-# translate crowdin will_crystal_essence_final_tough_3a4f50f5:
