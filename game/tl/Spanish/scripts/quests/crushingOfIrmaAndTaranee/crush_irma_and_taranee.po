# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:9 #-#-# translate crowdin gallery_d_072_96c6aca9:
msgid "[_tarani_] Н-нет, стой.. Как же.. Я не могла проиграть.. Ч-черт, ноги не слушаются.. Я слишком слаба.."
msgstr "[_tarani_] N-no, espera. De ninguna manera. No puedo perder. Maldita sea, no puedo controlar mis piernas. Estoy demasiado débil."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:10 #-#-# translate crowdin gallery_d_072_d34a09bc:
msgid "[_cedrick_] И все же проиграла. Ты держалась достойно, стоит признать. Из всех стражниц только твой дух я все еще но смог сломить"
msgstr "[_cedrick_] Y aun así perdiste. Te mantuviste firme, debo admitirlo. De todos los guardianes, tu espíritu fue el único que no pude quebrar."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:11 #-#-# translate crowdin gallery_d_072_533082e8:
msgid "[_tarani_] Т-только мой? Ты все еще самоуверен.. Есть еще Ирма.. И Вилл.."
msgstr "[_tarani_] ¿Solo yo? Todavía tienes confianza en ti mismo... También están Irma... y Will..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:12 #-#-# translate crowdin gallery_d_072_92edc05d:
msgid "[_cedrick_] Хах, Вилл? Ты явно всего не знаешь. Что же касается Ирмы, то давай посмотрим как она там"
msgstr "[_cedrick_] ¿Eh, Will? Está claro que no lo sabes todo. En cuanto a Irma, vamos a ver cómo lo está haciendo."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:16 #-#-# translate crowdin gallery_d_072_a432e95d:
msgid "[_irma_] Ах.. Ах.. Ч-чертов тарантул.. Моя вода не действует против паутины.. Не честно.."
msgstr "[_irma_] Ah.. Ahh. Maldita tarantula. Mi agua no funciona contra las telarañas. No es justo."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:17 #-#-# translate crowdin gallery_d_072_2cfad58f:
msgid "[_cedrick_] Что ж, думаю пока Тарани там отдыхает, самое время наконец заняться тобой"
msgstr "[_cedrick_] Bueno, creo que mientras Tarani descansa allí, es hora de finalmente cuidar de ti."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:19 #-#-# translate crowdin gallery_d_072_c8d566e6:
msgid "[_irma_] Ч-черт, нет, только не снова.. Не сейчас.."
msgstr "[_irma_] Maldita sea, no, otra vez no... Ahora no..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:20 #-#-# translate crowdin gallery_d_072_26ad33f0:
msgid "[_cedrick_] Миранда, поможешь мне?"
msgstr "[_cedrick_] Miranda, ¿puedes ayudarme?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:22 #-#-# translate crowdin gallery_d_072_1c3e8727:
msgid "[_miranda_] Без проблем. Свяжу ее и оставлю вас наедине. Присмотрю пока, чтобы Тарани тебе не мешала"
msgstr "[_miranda_] Ningún problema. La ataré y los dejaré a solas. Por ahora, me encargaré de que Tarani no te moleste."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:23 #-#-# translate crowdin gallery_d_072_3d4d3f2a:
msgid "[_cedrick_] Отличный план"
msgstr "[_cedrick_] Excelente."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:25 #-#-# translate crowdin gallery_d_072_3617bd3b:
msgid "[_irma_] С-стойте.. Хватит.. Я уже не могу.."
msgstr "[_irma_] Espera... Para. No puedo soportarlo más."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:29 #-#-# translate crowdin gallery_d_072_d46c57b8:
msgid "[_irma_] Стой.. Рик, прошу, не нужно.. Если хочешь, я пообещаю, что больше никогда не нападу на вас с Мирандой.. Дай мне просто уйти.."
msgstr "[_irma_] Para. Rick, por favor, no. Si quieres que te prometa que nunca volveré a atacarte a ti y a Miranda. Solo déjame ir."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:30 #-#-# translate crowdin gallery_d_072_ccd0d0e1:
msgid "[_cedrick_] Ох ты ж.. Не ожидал от тебя такого. А Тарани еще считала, что я тебя еще не сломил.."
msgstr "[_cedrick_] Oh, hombre. No me esperaba eso de ti. Y Tarani todavía pensaba que no te había roto todavía."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:32 #-#-# translate crowdin gallery_d_072_795678bb:
msgid "[_irma_] ..."
msgstr "[_irma_] ..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:33 #-#-# translate crowdin gallery_d_072_bd720cb0:
msgid "[_cedrick_] Бедная девочка, смотрю ты совсем уже выбилась из сил.."
msgstr "[_cedrick_] Pobre chica, veo que estás completamente agotada..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:35 #-#-# translate crowdin gallery_d_072_87144e8c:
msgid "[_irma_] Я.. Я не такой боец, как Тарани.. Я очень хотела быть такой.. Но я так устала.. Устала сражаться.."
msgstr "[_irma_] Yo... No soy un luchador como Tarani... Realmente quería serlo... Pero estoy tan cansada... Cansada de luchar..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:37 #-#-# translate crowdin gallery_d_072_4d2873fe:
msgid "[_cedrick_] (Ооо, все даже хуже, чем я думал.. смотрю ее совсем накрыло. Кажется, в психологии это называется отложенной депрессией)"
msgstr "[_cedrick_] (Ooh, es incluso peor de lo que pensaba. Veo que está por todas partes. Creo que se llama depresión retardada en psicología)."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:38 #-#-# translate crowdin gallery_d_072_47dfdada:
msgid "[_cedrick_] (Видимо она уже давно была на пределе и у нее оставались силы сражаться вплоть до первого проигрыша)"
msgstr "[_cedrick_] (Al parecer había estado al límite durante mucho tiempo y tuvo fuerzas para luchar hasta la primera derrota.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:39 #-#-# translate crowdin gallery_d_072_c0f419b5:
msgid "[_cedrick_] (Как боксер на ринге, который все еще стоит на ногах и машинально машет руками, но которому до отключки остался один небольшой толчок)"
msgstr "[_cedrick_] (Como un boxeador en el ring que todavía está de pie y agitando los brazos, pero que está a un pequeño empujón de desmayarse.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:41 #-#-# translate crowdin gallery_d_072_afb684c8:
msgid "[_irma_] Тарани движет месть за своего парня, за свое унижения, она готова рвать и метать.. А я, а что я.."
msgstr "[_irma_] A Tarani la mueve la venganza por su novio, por su humillación, está dispuesta a desgarrar y tirar... Y yo, ¿qué hay de mí?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:42 #-#-# translate crowdin gallery_d_072_70c54cac:
msgid "[_irma_] Я ничего этого уже не хочу.. Ты меня шантажировал, унижал, манипулировал мной.. А мне уже плевать.."
msgstr "[_irma_] Ya no quiero nada de esto. Me chantajeaste, me humillaste, me manipulaste. Y ya no me importa."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:43 #-#-# translate crowdin gallery_d_072_cc5f69bc:
msgid "[_irma_] Я просто хочу перестать жить постоянной борьбой с чем-то.. Если для этого придется позволить тебе меня трахнуть - так тому и быть.. Только не заставляй меня снова сражаться.."
msgstr "[_irma_] Solo quiero dejar de vivir una vida de lucha constante con algo... Si eso significa dejar que me folles, que así sea... Simplemente no me hagas pelear de nuevo..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:45 #-#-# translate crowdin gallery_d_072_da6a45bb:
msgid "[_cedrick_] Ох, я понимаю, Ирма.. Ты на пределе, я совсем недавно был в твоем положении"
msgstr "[_cedrick_] Oh, lo entiendo, Irma.. Estás al límite, yo estuve en tu posición hace poco."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:50 #-#-# translate crowdin gallery_d_072_795678bb_1:
msgid "[_irma_] ..."
msgstr "[_irma_] ..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:52 #-#-# translate crowdin gallery_d_072_757e7ee2:
msgid "[_cedrick_] Но знаешь, в такой ситуации есть два выхода. Ты либо сражаешься до последнего, готовый умереть, но не смириться с судьбой.. Либо ты принимаешь ситуацию"
msgstr "[_cedrick_] Pero ya sabes, en una situación como esta, hay dos opciones. O luchas hasta el último aliento, dispuesto a morir pero sin aceptar tu destino. O aceptas la situación."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:54 #-#-# translate crowdin gallery_d_072_6b47be27:
msgid "[_cedrick_] И что же сделаешь ты?"
msgstr "[_cedrick_] ¿Y qué vas a hacer?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:56 #-#-# translate crowdin gallery_d_072_67eee041:
msgid "[_irma_] Я принимаю! Принимаю.. Если принять твой член означает закончить все это, если после этого мне дадут просто уйти, я готова.."
msgstr "[_irma_] ¡Acepto! Acepto. Si aceptar tu polla significa acabar con esto, si me dejan irme, estoy lista."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:58 #-#-# translate crowdin gallery_d_072_29bc1983:
msgid "[_cedrick_] Хах.."
msgstr "[_cedrick_] Je."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:61 #-#-# translate crowdin gallery_d_072_6d7789d7:
msgid "[_irma_] Аааах.."
msgstr "[_irma_] ¡Aaah!"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:63 #-#-# translate crowdin gallery_d_072_3f9ad437:
msgid "[_cedrick_] Но, знаешь что, Ирма.. Я не говорил, что отпущу тебя, если ты примешь мой член"
msgstr "[_cedrick_] ¿Pero sabes qué, Irma? No dije que te dejaría ir si me cogías la polla."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:65 #-#-# translate crowdin gallery_d_072_dba70129:
msgid "[_irma_] Ч-что?.. Н-нет же, подожди.."
msgstr "[_irma_] ¿Qué? N-no, espera."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:67 #-#-# translate crowdin gallery_d_072_6f3c67b7:
msgid "[_cedrick_] Смотри как получается.. Ты готова сдаться, но.."
msgstr "[_cedrick_] Mira cómo resulta... Estás lista para rendirte, pero..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:69 #-#-# translate crowdin gallery_d_072_4d4ba5c2:
msgid "[_irma_] Аааххх.. Н-но?"
msgstr "[_irma_] Aaahhhh. ¿Q-qué?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:71 #-#-# translate crowdin gallery_d_072_4b5bfc22:
msgid "[_cedrick_] Но ты все еще стражница.. Ты все еще угроза, ты все еще мой враг.."
msgstr "[_cedrick_] Pero sigues siendo un guardián. Sigues siendo una amenaza, sigues siendo mi enemiga."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:73 #-#-# translate crowdin gallery_d_072_9e922c45:
msgid "[_irma_] Н-нет, я же.. Я больше не буду... ааах.."
msgstr "[_irma_] N-no, yo... No lo haré más. ¡Aah!"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:75 #-#-# translate crowdin gallery_d_072_6b32b4d3:
msgid "[_cedrick_] Ууух.. И, помимо всего прочего.. Ты навредила Миранде.. Ты попыталась убить единственного человека, который действительно для меня важен, понимаешь?"
msgstr "[_cedrick_] Ooh. Y encima de todo lo demás. Le hiciste daño a Miranda. Trataste de matar a la única persona que realmente me importa, ¿sabes?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:77 #-#-# translate crowdin gallery_d_072_cc2a0ebb:
msgid "[_irma_] П-прости.. Прости меня, Рик.. Я больше никогда не перейду тебе дорогу.."
msgstr "[_irma_] L-lo siento... Perdóname, Rick... Nunca volveré a cruzarme en tu camino..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:79 #-#-# translate crowdin gallery_d_072_3caa8409:
msgid "[_cedrick_] Ох, точно не перейдешь? А знаешь почему? Потому что у тебя не хватит на это сил"
msgstr "[_cedrick_] Oh, ¿estás seguro de que no te cruzarás? ¿Sabes por qué? Porque no tienes fuerzas para ello."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:80 #-#-# translate crowdin gallery_d_072_795678bb_2:
msgid "[_irma_] ..."
msgstr "[_irma_] ..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:81 #-#-# translate crowdin gallery_d_072_84afacad:
msgid "[_cedrick_] Как и у любой из вас. Какую бы силу не дало вам сердце кондракара, воина определяет не сила, а его дух, его готовность сражаться"
msgstr "[_cedrick_] Como cualquiera de ustedes. Cualquiera que sea la fuerza que te dé el corazón de un Kandrakar, un guerrero no está determinado por la fuerza, sino por su espíritu, su voluntad de luchar."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:82 #-#-# translate crowdin gallery_d_072_c95875dc:
msgid "[_cedrick_] У вас же.. У вас дух самых обычных девчонок.. Вы не воины и вы не созданы, чтобы сражаться. Ты не создана"
msgstr "[_cedrick_] Ustedes... Tienen el espíritu de las chicas más comunes... No son guerreras y no fueron creadas para luchar. No están hechas para esto."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:84 #-#-# translate crowdin gallery_d_072_d7f4a0fc:
msgid "[_irma_] Аааав.. Я-я знаю.. Я не боец.."
msgstr "[_irma_] Aaaawww. Lo sé. No soy una luchadora."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:86 #-#-# translate crowdin gallery_d_072_c0a06cb5:
msgid "[_cedrick_] Ты не боец, но ты все еще опасна, и ты все еще наш враг. Знаешь, что делают со слабыми врагами, готовыми сдаться?"
msgstr "[_cedrick_] No eres una luchadora, pero sigues siendo peligrosa, y sigues siendo nuestro enemiga. ¿Sabes lo que les hacen a los enemigos débiles que están dispuestos a rendirse?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:88 #-#-# translate crowdin gallery_d_072_7d39e348:
msgid "[_irma_] Н-не надо.."
msgstr "[_irma_] N-no..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:90 #-#-# translate crowdin gallery_d_072_e4833161:
msgid "[_cedrick_] Хах, ты понимаешь.. Твои бедра начинают сильнее дрожать.."
msgstr "[_cedrick_] Huh, ya sabes. Tus caderas empiezan a temblar más."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:92 #-#-# translate crowdin gallery_d_072_98097936:
msgid "[_cedrick_] А теперь, Ирма.. Тебе пора усвоить кое что раз и навсегда. Одну простую мысль. Ты готова?"
msgstr "[_cedrick_] Ahora, Irma. Es hora de que aprendas algo de una vez por todas. Un simple pensamiento. ¿Estás preparada?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:94 #-#-# translate crowdin gallery_d_072_d6ac1e91:
msgid "[_irma_] Д-да.."
msgstr "[_irma_] ¡Aaah!"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:96 #-#-# translate crowdin gallery_d_072_1793af14:
msgid "[_cedrick_] Твой единственный выход, при котором ты остаешься в живых. Единственный выход, при котором ты не будешь вынуждена вечно сражаться и в страхе оглядываться по сторонам"
msgstr "[_cedrick_] Tu única opción para seguir con vida. La única salida en la que no te verás obligado a luchar eternamente y mirar a tu alrededor con miedo."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:99 #-#-# translate crowdin gallery_d_072_a751618d:
msgid "[_irma_] Е-единственный выход.."
msgstr "[_irma_] La única salida..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:101 #-#-# translate crowdin gallery_d_072_c1809038:
msgid "[_cedrick_] Это присоединиться ко мне, Ирма. Ты перестанешь быть моим врагом, я перестану желать тебе мести и тебе больше ничего не будет угрожать.."
msgstr "[_cedrick_] Esto es para unirte a mí, Irma. Dejarás de ser mi enemiga, dejaré de querer vengarme de ti y ya no te sentirás amenazada."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:102 #-#-# translate crowdin gallery_d_072_e157def8:
msgid "[_cedrick_] Только если ты больше никогда не будешь мне перечить"
msgstr "[_cedrick_] Solo si nunca me vuelves a traicionar."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:103 #-#-# translate crowdin gallery_d_072_795678bb_3:
msgid "[_irma_] ..."
msgstr "[_irma_] ..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:104 #-#-# translate crowdin gallery_d_072_bcfdb974:
msgid "[_cedrick_] А иначе.. Иначе на тебя обрушится вся сила и весь ужас Меридиана. Ты поняла?"
msgstr "[_cedrick_] O si no... De lo contrario, todo el poder y el terror de Meridian caerá sobre ti. ¿Comprendes?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:106 #-#-# translate crowdin gallery_d_072_4f59974d:
msgid "[_irma_] Ааах.. Д-да.. Я поняла.."
msgstr "[_irma_] Ahh. S-sí. Lo entiendo."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:108 #-#-# translate crowdin gallery_d_072_4c974d93:
msgid "[_cedrick_] Повтори, что ты поняла! Что ты решила, девчонка!?"
msgstr "[_cedrick_] ¡Dilo otra vez! ¿¡Qué has decidido, chica!?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:110 #-#-# translate crowdin gallery_d_072_6d64e024:
msgid "[_irma_] Я.. Я больше никогда не буду тебе перечить.. Никогда.. Если так я буду в безопасности.. Если так я перестану жить постоянной борьбой.. Я согласна.. Это.. Это.."
msgstr "[_irma_] Yo... Nunca volveré a cruzarme contigo. Nunca más. Si es así, estaré a salvo. Si es así, no tendré que vivir una vida de lucha constante. Estoy de acuerdo. Esto... Esto..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:112 #-#-# translate crowdin gallery_d_072_63a46d7b:
msgid "[_cedrick_] Это твой единственный выход, Ирма"
msgstr "[_cedrick_] Es tu única salida, Irma."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:114 #-#-# translate crowdin gallery_d_072_ebdceab5:
msgid "[_irma_] Ммммв.. Д-да.. Мой единственный... Ааах... Я, я кончаю..."
msgstr "[_irma_] Mm-hmm. S-sí. Mi único. ¡Aah! Estoy, estoy llegando."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:116 #-#-# translate crowdin gallery_d_072_575a58d5:
msgid "[_cedrick_] И я.. Получай, Ирма. Навсегда запомни этот момент!"
msgstr "[_cedrick_] Y yo. Toma eso, Irma. ¡Recuerda este momento para siempre!"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:118 #-#-# translate crowdin gallery_d_072_80a5e90d:
msgid "[_irma_] Аааааааххх..."
msgstr "[_irma_] Aaaaaaahhhh."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:119 #-#-# translate crowdin gallery_d_072_5e63c793:
msgid "[_cedrick_] Ч-черт.. Нужны зелья.."
msgstr "[_cedrick_] Maldición. Necesito pociones."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:122 #-#-# translate crowdin gallery_d_072_42c7c647:
msgid "[_centered_] {size=37}Рик принимает 5 зелий восстановления магической силы{/size}"
msgstr "[_centered_] {size=37}Rick toma 5 pociones de restauración de poder mágico{/size}"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:126 #-#-# translate crowdin gallery_d_072_99cf4cf0:
msgid "[_cedrick_] Миранда, не поможешь избавиться от паутины?"
msgstr "[_cedrick_] Miranda, ¿puedes ayudarme a quitar las telarañas?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:127 #-#-# translate crowdin gallery_d_072_54267892:
msgid "[_miranda_] Конечно. Вы закончили?"
msgstr "[_miranda_] Por supuesto. ¿Has terminado?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:128 #-#-# translate crowdin gallery_d_072_f56c10f1:
msgid "[_cedrick_] Да, она готова. Как там Тарани?"
msgstr "[_cedrick_] Sí, está lista. ¿Cómo está Tarani?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:129 #-#-# translate crowdin gallery_d_072_5c324d0f:
msgid "[_miranda_] Пока в отключке"
msgstr "[_miranda_] Todavía fuera."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:130 #-#-# translate crowdin gallery_d_072_fe662f75:
msgid "[_cedrick_] Ирма тоже.. Хах, подождем ка, пока они обе очнутся"
msgstr "[_cedrick_] Irma, también. Esperemos a que ambos despierten."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:131 #-#-# translate crowdin gallery_d_072_23654efb:
msgid "[_miranda_] Ох, Седрик, что ты задумал?"
msgstr "[_miranda_] Oh, Cedric, ¿qué estás tramando?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:132 #-#-# translate crowdin gallery_d_072_b54a7a27:
msgid "[_cedrick_] Хах, скоро увидишь"
msgstr "[_cedrick_]  Lo verás muy pronto."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:133 #-#-# translate crowdin gallery_d_072_6a1543f7:
msgid "Тарани просыпается.."
msgstr "Tarani se despierta."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:134 #-#-# translate crowdin gallery_d_072_3bc36509:
msgid "[_tarani_] Мхх.. Ч-что.. Моя голова.. Что случилось.."
msgstr "[_tarani_] Mm-hmm. Wha... Mi cabeza.  Qué ha pasado..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:138 #-#-# translate crowdin gallery_d_072_7cfb00e1:
msgid "[_tarani_] Ах!? Ч-что!?"
msgstr "[_tarani_] ¿Q-qué!?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:139 #-#-# translate crowdin gallery_d_072_89e0bc95:
msgid "[_irma_] Прости, Тарани.."
msgstr "[_irma_] Lo siento, Tarani."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:140 #-#-# translate crowdin gallery_d_072_1089930a:
msgid "[_tarani_] Ирма.. Ч-что ты делаешь.. Отпусти меня!? Что на тебя нашло!?"
msgstr "[_tarani_] Irma... ¿Qué estás haciendo? ¿¡Déjame ir!? ¿¡Qué te pasa!?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:141 #-#-# translate crowdin gallery_d_072_1999e42f:
msgid "[_irma_] Я больше не могу ему перечить.. Это единственный способ перестать бороться.. Теперь я просто делаю то, что мне скажут.. Это успокаивает.."
msgstr "[_irma_] Ya no puedo luchar contra él... Es la única manera en que puedo dejar de luchar. Ahora sólo hago lo que me dicen. Es relajante."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:143 #-#-# translate crowdin gallery_d_072_89a782ba:
msgid "[_tarani_] Ирма, чтоб тебя, очнись! Т-тебе промыли мозги.."
msgstr "[_tarani_] ¡Irma, despierta de una puta vez! Te han lavado el cerebro."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:144 #-#-# translate crowdin gallery_d_072_aa201b78:
msgid "[_cedrick_] Хах, может так показаться, но нет, она в полном сознании и отдает себе отчет о своих действиях. Просто ты ошибалась, Тарани"
msgstr "[_cedrick_] Huh, puede parecer de esa manera, pero no, ella es plenamente consciente y consciente de sus acciones. Estabas equivocada, Tarani."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:146 #-#-# translate crowdin gallery_d_072_e40e1218:
msgid "[_tarani_] Ч-что.. Ааахх.. Что ты несешь.."
msgstr "[_tarani_] Q-que-- Aaahhh... ¿De qué estás hablando?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:147 #-#-# translate crowdin gallery_d_072_766efe0d:
msgid "[_cedrick_] Я говорю о том, что Ирма никакой не боец.. Она старалась казаться очень сильной, но в итоге вся эта борьба ей осточертела"
msgstr "[_cedrick_] Lo que digo es que Irma no es una luchadora. Intentó parecer fuerte, pero al final se cansó de luchar."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:149 #-#-# translate crowdin gallery_d_072_f7d2657f:
msgid "[_tarani_] Э-это ложь.. Уууух.. Черт, хватит так грубо долбить меня, чертов змей! Я никогда не приму то, что Ирма сдалась.."
msgstr "[_tarani_] Eso es mentira. Ooh. ¡Maldita sea, deja de golpearme tan fuerte, maldita serpiente! Nunca aceptaré que Irma se rinda."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:151 #-#-# translate crowdin gallery_d_072_915e83a1:
msgid "[_cedrick_] Ууух, можешь думать что хочешь, но это так.. Она выбрала самый безопасный путь для себя и сохранения своей безопасности"
msgstr "[_cedrick_] Ooh, piensa lo que quieras, pero es verdad. Ella eligió el camino más seguro para sí misma y mantenerse a salvo."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:153 #-#-# translate crowdin gallery_d_072_717f24bf:
msgid "[_irma_] Все так, Тарани.. Он не принуждал меня, просто.. Просто это единственный выход, при котором я останусь жива и меня больше не будет беспокоить эта вся беготня за справедливостью.."
msgstr "[_irma_] Así es, Tarani. No me obligó, es sólo que... Es la única forma de seguir viva y no tener que preocuparme más por todo esto de la justicia."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:156 #-#-# translate crowdin gallery_d_072_78b84f1b:
msgid "[_tarani_] И-ирма.. Ааах, ч-черт, как грубо.. Мммв.."
msgstr "[_tarani_] I-Irma-- Aah, m-m-mierda, eso es duro. Mm-hmm."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:158 #-#-# translate crowdin gallery_d_072_ffd922af:
msgid "[_cedrick_] А ты хорошо ее держишь, Ирма, у нее и вправду не получается вырваться"
msgstr "[_cedrick_] Y la estás sujetando bien, Irma, ella realmente no puede liberarse."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:159 #-#-# translate crowdin gallery_d_072_bd52a8fa:
msgid "[_irma_] Ты попросил держать ее изо всех сил - это я и делаю"
msgstr "[_irma_] Me pediste que la abrazara tan fuerte como pudiera, así que lo estoy haciendo."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:161 #-#-# translate crowdin gallery_d_072_5f08f6a8:
msgid "[_tarani_] Ч-чееерт.. Ааах.. Аааааах..."
msgstr "Ch-cheeeert.. Aaah.. Aaaaaah.."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:162 #-#-# translate crowdin gallery_d_072_ae15d951:
msgid "[_cedrick_] Ахаха, Тарани! Да ты та еще извращенка, сама во всю сопротивляешься, но при этом твоя киска все сильнее сжимает меня"
msgstr "[_cedrick_] ¡Jajaja, Tarani! Sí, eres una pervertida, te resistes con todas tus fuerzas, pero al mismo tiempo tu coño me aprieta cada vez más."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:165 #-#-# translate crowdin gallery_d_072_11f55de3:
msgid "[_cedrick_] Я наверное не смогу вытащить даже если захочу, настолько ты в меня вцепилась"
msgstr "[_cedrick_] Probablemente no podría sacarlo aunque quisiera, estás tan atrapado en mí."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:167 #-#-# translate crowdin gallery_d_072_9d8500dc:
msgid "[_tarani_] Аааахх.. П-пошел ты.. Это просто естественная реакция организма.."
msgstr "[_tarani_] Aaahhhh. Vete a la mierda. Es sólo una reacción natural del cuerpo."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:168 #-#-# translate crowdin gallery_d_072_20abd6e4:
msgid "[_cedrick_] О, уж я то знаю.. И это точно не естественная реакция, это реакция долбаной извращенки"
msgstr "[_cedrick_] Lo sé. Y definitivamente no es una reacción natural, es una jodida reacción pervertida."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:170 #-#-# translate crowdin gallery_d_072_f8c8d5f0:
msgid "[_tarani_] Ммммв.. Ч-черт, я кончаю.. Н-нет.. Аааааах.."
msgstr "[_tarani_] Mm-hmm. Mierda, ya voy. N-no. Aaahhhh."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:173 #-#-# translate crowdin gallery_d_072_15b21867:
msgid "[_cedrick_] Ууух, т-ты так сжимаешь меня, что я уже и сам не могу сдержаться.. К-кончаю"
msgstr "[_cedrick_] Ooh, me estás apretando tanto que no puedo evitarlo... Ya voy."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:181 #-#-# translate crowdin gallery_d_072_20b6c81a:
msgid "[_will_] Ч-что здесь происходит!?"
msgstr "[_will_] ¿Qué está pasando aquí?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:188 #-#-# translate crowdin gallery_d_073_b60211d8:
msgid "[_cedrick_] В-вилл!? Что.. Что ты здесь делаешь?"
msgstr "[_cedrick_] ¿¡W-Will!? ¿Qué...? ¿Qué estás haciendo aquí?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:192 #-#-# translate crowdin gallery_d_073_615e6976:
msgid "[_will_] Девочки уже второй раз долбились ко мне в дверь со словами о том, что ты Лорд Седрик и что им нужна сила сердца кондракара.."
msgstr "[_will_] Es la segunda vez que las chicas golpean mi puerta diciendo que eres Lord Cedric y que necesitan la fuerza del corazón de un condrakar...."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:193 #-#-# translate crowdin gallery_d_073_062196a8:
msgid "[_will_] В этот раз я решила убедиться лично..."
msgstr "[_will_] Esta vez, decidí ver por mí misma...."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:197 #-#-# translate crowdin gallery_d_073_340392bf:
msgid "[_will_] Рик.. Это правда? Ты — это Седрик?"
msgstr "[_will_] Rick-- ¿Es verdad? ¿Eres Cedric?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:198 #-#-# translate crowdin gallery_d_073_b22180a1:
msgid "[_tarani_] В-вилл, давай! Наподдай ему, ты наша последняя надежда!"
msgstr "[_tarani_] ¡W-Will, vamos! ¡Patéale el culo, eres nuestra última esperanza!"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:199 #-#-# translate crowdin gallery_d_073_ee352811:
msgid "[_cedrick_] (Черт, меня зажали в угол.. Тут уже никак не отвертишься, и никакая магия не поможет..)"
msgstr "[_cedrick_] (Maldición, estoy acorralado. No hay manera de salir de esto, y ninguna magia puede ayudar)."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:200 #-#-# translate crowdin gallery_d_073_835b63bc:
msgid "[_cedrick_] Ну, я.."
msgstr "[_cedrick_] Bueno, yo..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:201 #-#-# translate crowdin gallery_d_073_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:202 #-#-# translate crowdin gallery_d_073_52a1e641:
msgid "[_cedrick_] (Стоп.. А чего это я.. Пытаюсь тут выкрутиться.. Юлю и оправдываюсь.. Черт, в прошлом я бы так и поступил, но сейчас.. Хватит с меня.)"
msgstr "[_cedrick_] (Whoa. ¿Por qué estoy - Estoy tratando de salir de esto. Yulu y poner excusas. Diablos, yo habría hecho eso en el pasado, pero ahora. He terminado.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:204 #-#-# translate crowdin gallery_d_073_9d7042e0:
msgid "[_cedrick_] Да, это я. Я - это Лорд Седрик. И что с того?"
msgstr "[_cedrick_] Sí, soy yo. Soy Lord Cedric. ¿Y qué?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:208 #-#-# translate crowdin gallery_d_073_bcd124bf:
msgid "[_will_] ..."
msgstr "[_will_] ..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:210 #-#-# translate crowdin gallery_d_073_71d4fcfa:
msgid "[_cedrick_] Что ты мне сделаешь, девчонка? Я уже одолел всех твоих подруг. Я практически подчинил себе твою мать"
msgstr "[_cedrick_] ¿Qué me harás, niña? Ya he derrotado a todas tus amigas. Prácticamente subyugué a tu madre."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:214 #-#-# translate crowdin gallery_d_073_bcd124bf_1:
msgid "[_will_] ..."
msgstr "[_will_] ..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:215 #-#-# translate crowdin gallery_d_073_9d557287:
msgid "[_cedrick_] По сути я уже давно буквально трахнул всех, кого ты знаешь и хоть как-то любишь. И знаешь что? Теперь все это просто мелочи по сравнению с тем, что я собираюсь устроить"
msgstr "[_cedrick_] De hecho, desde hace mucho tiempo me he follado literalmente a todos los que conoces y al menos de alguna manera amas. ¿Y adivina qué? Ahora bien, estas son todas pequeñas cosas comparadas con lo que estoy a punto de hacer."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:219 #-#-# translate crowdin gallery_d_073_8fba1ecf:
msgid "[_will_] ....."
msgstr "[_will_] ..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:220 #-#-# translate crowdin gallery_d_073_9692191b:
msgid "[_cedrick_] Так что давай. Делай свой ход, мне все равно. Не важно, что ты сделаешь - я справлюсь и с этим. Если придется, возьму тебя силой и сделаю своей"
msgstr "[_cedrick_] Así que vamos. Haz tu movimiento, no me importa. No importa lo que hagas, puedo manejar esto. Si es necesario te tomaré por la fuerza y ​​te haré mía."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:221 #-#-# translate crowdin gallery_d_073_63100c30:
msgid "[_will_] ......."
msgstr "[_will_] ......"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:222 #-#-# translate crowdin gallery_d_073_db9b49d3:
msgid "[_cedrick_] Черт, да ты уже практически моя. Сидела в туалете и чуть ли не умоляла вставить мой член себе в рот. И что теперь? Нападешь на меня!? Ну так давай же, не тяни!"
msgstr "[_cedrick_] Maldita sea, ya eres prácticamente mía. Te sentaste en el baño y casi me rogaste que te metiera la polla en la boca. ¿Y ahora qué? ¿Me atacarás? ¡Pues vamos, no tardes!"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:223 #-#-# translate crowdin gallery_d_073_915953e0:
msgid "[_will_] ........."
msgstr "[_will_] ........."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:224 #-#-# translate crowdin gallery_d_073_7025b4a2:
msgid "[_tarani_] Вилл, ну же, давай!"
msgstr "[_tarani_] ¡Will, vamos, vamos!"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:226 #-#-# translate crowdin gallery_d_073_b29a3134:
msgid "[_will_] ............"
msgstr "[_will_] ............"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:231 #-#-# translate crowdin gallery_d_073_ddc72c45:
msgid "[_will_] Н-нет.. Я.. я не могу.."
msgstr "[_will_] N-no... yo... no puedo."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:233 #-#-# translate crowdin gallery_d_073_541ea7a9:
msgid "[_tarani_] Ч-что!?"
msgstr "[_tarani_] ¿Q-qué!?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:234 #-#-# translate crowdin gallery_d_073_49316299_1:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:236 #-#-# translate crowdin gallery_d_073_83e74c79:
msgid "[_will_] Это уже слишком давно сидит в моей голове.. Я.. я слишком долго хочу этого.."
msgstr "[_will_] Esto ha estado en mi cabeza durante demasiado tiempo... Yo... he deseado esto durante demasiado tiempo."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:237 #-#-# translate crowdin gallery_d_073_7a412101:
msgid "[_will_] На меня возложили ответственность быть лидером стражниц, защитницей завесы.. Но.. Я не просила об этом!"
msgstr "[_will_] Me dieron la responsabilidad de ser el líder de los guardias, el protector del velo... Pero... ¡Yo no pedí esto!"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:239 #-#-# translate crowdin gallery_d_073_88c30d14:
msgid "[_will_] Все это так мне осточертело.. Я не предводитель и не защитница.. Я всего лишь девушка.."
msgstr "[_will_] Estoy tan cansada de todo esto. No soy una líder ni una protectora. Solo soy una niña."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:240 #-#-# translate crowdin gallery_d_073_5680ebf9:
msgid "[_will_] Девушка, которая уже слишком давно мечтает о том, чтобы ты ее трахнул.."
msgstr "[_will_] Una chica que lleva demasiado tiempo soñando con que te la folles."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:242 #-#-# translate crowdin gallery_d_073_2c6b5cf2:
msgid "[_will_] Мне уже плевать, Лорд Седрик ты или же сам Князь Фобос.. Я знаю лишь то, что ты мужчина, которого я жажду каждой клеткой своего тела.."
msgstr "[_will_] Ya no me importa si eres Lord Cedrick o el mismísimo Príncipe Fobos... Solo sé que eres el hombre que anhelo con cada célula de mi cuerpo..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:244 #-#-# translate crowdin gallery_d_073_0f596e8e:
msgid "[_will_] Просто.. Просто хватит уже дразнить меня.. Сделай это.."
msgstr "[_will_] Solo... Deja de burlarte de mí. Hazlo."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:246 #-#-# translate crowdin gallery_d_073_281c5a31:
msgid "[_will_] Со всем остальным мы разберемся позже... Просто возьми меня наконец.. Я твоя.."
msgstr "[_will_] Nos ocuparemos del resto más tarde. Tómame por fin. Soy tuya."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:250 #-#-# translate crowdin gallery_d_073_b8bc7fbd:
msgid "[_tarani_] Вилл.. Нет.. Только не ты.."
msgstr "[_tarani_] Will... No. Tú no."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:251 #-#-# translate crowdin gallery_d_073_f89f7db9:
msgid "[_cedrick_] ....."
msgstr "[_cedrick_] ....."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:253 #-#-# translate crowdin gallery_d_073_6f0d939f:
msgid "[_will_] Ну же, не молчи... Дай мне свой ответ.. Что ты сделаешь?"
msgstr "[_will_] Vamos, no te quedes callado. Dame tu respuesta. ¿Qué harás?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:254 #-#-# translate crowdin gallery_d_073_a6dc67b9:
msgid "[_will_] Переспишь со мной? Сделаешь своей пленницей? Мне все равно, просто дай мне наконец то, чего я так долго жажду.."
msgstr "[_will_] ¿Dormirás conmigo? ¿Me harás tu prisionera? No me importa, solo dame lo que tanto he deseado."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:255 #-#-# translate crowdin gallery_d_073_29bc1983:
msgid "[_cedrick_] Хах.."
msgstr "[_cedrick_] Je."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:258 #-#-# translate crowdin gallery_d_073_935424f0:
msgid "Звонок от Медины"
msgstr "Una llamada de Medina"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:260 #-#-# translate crowdin gallery_d_073_d410a072:
msgid "[_medina_] Рик, я все уладила, сегодня можешь вернуться к Сьюзан и Вилл"
msgstr "[_medina_] Rick, lo he solucionado, puedes volver con Susan y Will hoy."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:262 #-#-# translate crowdin gallery_d_073_066e61c7:
msgid "[_medina_] Сьюзан я все объяснила, а вот Вилл не было дома. Но думаю, как только она вернется, Сьюзан ей все расскажет"
msgstr "[_medina_] Se lo expliqué todo a Susan, pero Will no estaba en casa. Pero creo que en cuanto vuelva, Susan se lo contará todo."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:263 #-#-# translate crowdin gallery_d_073_e824fc85:
msgid "[_cedrick_] В этом уже нет нужды. Но спасибо. Мы скоро будем дома. Я и Вилл"
msgstr "[_cedrick_] Ya no hay necesidad de eso. Pero gracias. Pronto estaremos en casa. Will y yo."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:264 #-#-# translate crowdin gallery_d_073_7fefb024:
msgid "[_medina_] Ох, ты ей все рассказал? Тогда хорошо"
msgstr "[_medina_] ¿Le contaste todo? Entonces bien."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:265 #-#-# translate crowdin gallery_d_073_d7029cf7:
msgid "[_cedrick_] Да.. Хорошо.."
msgstr "[_cedrick_] Sí, está bien."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:266 #-#-# translate crowdin gallery_d_073_8d5a8d2a:
msgid "Седрик кладет трубку"
msgstr "Cedric cuelga el teléfono"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:268 #-#-# translate crowdin gallery_d_073_19f8ec29:
msgid "[_will_] Ну же, Рик.. Я знаю, что все эти приставания были не просто так. Ты ведь и сам меня хочешь"
msgstr "[_will_] Vamos, Rick... Sé que toda esta molestia fue por una razón. Tú también me quieres."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:269 #-#-# translate crowdin gallery_d_073_bd98b8f1:
msgid "[_will_] Ну же, давай наконец займемся тем, чего мы оба так долго хотели!"
msgstr "[_will_] ¡Vamos, hagamos por fin lo que ambos hemos querido hacer durante tanto tiempo!"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:270 #-#-# translate crowdin gallery_d_073_49316299_2:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:271 #-#-# translate crowdin gallery_d_073_ef4f57f7:
msgid "[_cedrick_] (Интересно, до каких признаний она еще дойдет, если я продолжу давить на нее молчанием?)"
msgstr "[_cedrick_] (Me pregunto a qué confesiones llegará si sigo presionándola para que guarde silencio)."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:273 #-#-# translate crowdin gallery_d_073_50bd09b4:
msgid "[_miranda_] Хей, девчонка, куда это ты лезешь, знай свое место"
msgstr "[_miranda_] Hey, chica, donde vas, ya sabes tu lugar."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:275 #-#-# translate crowdin gallery_d_073_3cc42ae9:
msgid "[_cedrick_] (Черт, Миранда тут не вовремя)"
msgstr "[_cedrick_] (Maldita sea, Miranda está aquí en un mal momento.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:282 #-#-# translate crowdin gallery_d_073_6bddf678:
msgid "[_will_] Ч-что!? Ты еще кто такая!?"
msgstr "[_will_] ¿¡Qu-qué!? ¿¡Quién demonios eres!?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:287 #-#-# translate crowdin gallery_d_073_a8ba928f:
msgid "[_miranda_] Я Миранда, его любимая. А ты всего лишь стражница, все еще наш враг, не забывайся!"
msgstr "[_miranda_] Soy Miranda, su amada. Y tú eres solo un guardián, sigues siendo nuestra enemiga, ¡no lo olvides!"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:293 #-#-# translate crowdin gallery_d_073_71e05a0e:
msgid "[_will_] А, так ты та самая мерзкая паучиха? Какой кошмар, и Седрику приходится терпеть ласки от такого монстра?"
msgstr "[_will_] ¿Así que tú eres la araña asquerosa? Qué pesadilla, ¿y Cedric tiene que soportar las caricias de semejante monstruo?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:294 #-#-# translate crowdin gallery_d_073_81268c12:
msgid "[_cedrick_] (Хооо, Миранда стала ревновать? Раньше она проявляла свою ревность не так активно)"
msgstr "[_cedrick_] (Ooh, ¿Miranda se puso celosa? Antes no mostraba tanto sus celos.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:295 #-#-# translate crowdin gallery_d_073_39fdc52b:
msgid "[_cedrick_] (А Вилл ей не уступает, огрызается даже сильнее. Из этого все же может получится что-то интересное)"
msgstr "[_cedrick_] (Y Will es tan buena como ella, chasqueando aún más fuerte. Esto todavía podría hacer algo interesante)."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:296 #-#-# translate crowdin gallery_d_073_cd846fb4:
msgid "[_cedrick_] (Позволю Миранде спровоцировать Вилл. Пусть девочка поймет, что у нее есть конкуренция)"
msgstr "[_cedrick_] (Dejaré que Miranda provoque a Will. Que la chica se dé cuenta de que tiene competencia.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:297 #-#-# translate crowdin gallery_d_073_ea7a4f82:
msgid "[_cedrick_] (Так, вместо того чтобы пытаться разобраться в своих чувствах и начать сомневаться в своих действиях, Вилл начнет стараться обойти конкурентку)"
msgstr "[_cedrick_] (Así que, en lugar de tratar de ordenar sus sentimientos y empezar a cuestionar sus acciones, Will empezará a tratar de superar a la competencia.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:298 #-#-# translate crowdin gallery_d_073_d79600f2:
msgid "[_cedrick_] (Посмотрим, как далеко она сможет в этом зайти)"
msgstr "[_cedrick_] (Vamos a ver hasta dónde puede llevar esto.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:304 #-#-# translate crowdin gallery_d_073_c03c0204:
msgid "[_miranda_] Хах, Седрик и сам монстр, такой же, как и я. Мы с ним практически одной крови, в отличии от тебя"
msgstr "[_miranda_] Huh, Cedric es un monstruo, como yo. Él y yo somos prácticamente de la misma sangre, a diferencia de ti."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:305 #-#-# translate crowdin gallery_d_073_0de65554:
msgid "[_miranda_] Ты всего лишь жалкий человек и не годишься ему в партнеры, разве что в рабыни"
msgstr "[_miranda_] No eres más que un miserable y no apto para ser su compañera, salvo como esclava."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:309 #-#-# translate crowdin gallery_d_073_62ed65a7:
msgid "[_will_] Уж точно не тебе решать, стану я рабыней или нет. Только я и Рик имеем голос в подобном решении и обсуждать это я буду только с ним. Ясно, паучиха?"
msgstr "[_will_] Ciertamente no depende de ti decidir si me convierto o no en esclava. Solo Rick y yo tenemos voz en tal decisión y lo discutiré con él a solas. ¿De acuerdo, mujer araña?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:310 #-#-# translate crowdin gallery_d_073_60e7ecf4:
msgid "[_cedrick_] (Ого, как Вилл заговорила. Эссенция дает свой эффект. Или же это ее искреннее желание не уступать Миранде?)"
msgstr "[_cedrick_] (Vaya, Will está hablando. La esencia está surtiendo efecto. ¿O es su sincero deseo de no diferir de Miranda?)"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:314 #-#-# translate crowdin gallery_d_073_d8bbcb86:
msgid "[_miranda_] В этом вся суть, девчонка. Ты готова быть для него подстилкой, когда как мы с Седриком равны"
msgstr "[_miranda_] Ese es el punto, niña. ¿Estás listo para ser su lecho cuando Cedric y yo seamos iguales?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:318 #-#-# translate crowdin gallery_d_073_980c747d:
msgid "[_will_] Это лишь демонстрирует мою готовность сделать для него все! В рамках разумного, конечно.."
msgstr "[_will_] ¡Sólo demuestra mi disposición a hacer cualquier cosa por él! Dentro de lo razonable, por supuesto."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:322 #-#-# translate crowdin gallery_d_073_99c9f442:
msgid "[_will_] К тому же, хм.. к тому же я привлекательнее и быстро учусь! Уж поверь, вскоре я буду делать ему минет куда лучше тебя"
msgstr "[_will_] Además, soy más atractiva y aprendo rápido. Créeme, pronto le haré una mamada mejor que tú."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:323 #-#-# translate crowdin gallery_d_073_10e0e10d:
msgid "[_miranda_] Ахах, девочка, я сосу его член уже более 100 лет, думаешь у тебя выйдет лучше?"
msgstr "[_miranda_] Ahhh chica, he estado chupando su polla durante más de 100 años, ¿crees que puedes hacerlo mejor?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:327 #-#-# translate crowdin gallery_d_073_191b21a9:
msgid "[_will_] А вот и посмотрим!"
msgstr "[_will_] ¡Ya lo veremos!"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:329 #-#-# translate crowdin gallery_d_073_e0f865d4:
msgid "[_miranda_] Э-эй, к-куда ты лезешь!? Думаешь я просто позволю тебе отсасывать Седрику в моем присутствии? А ну подвинься!"
msgstr "[_miranda_] O-oye, ¿¡a dónde vas!? ¿Crees que dejaré que se la chupes a Cedric delante de mí? ¡Vamos, muévete!"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:333 #-#-# translate crowdin gallery_d_073_5bc1722c:
msgid "[_cedrick_] (Ого, эта манипуляция приобрела неожиданный поворот. Надо же, иногда молчание работает лучше любых слов)"
msgstr "[_cedrick_] (Vaya, esta manipulación ha dado un giro inesperado. Vaya, a veces el silencio funciona mejor que cualquier palabra.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:335 #-#-# translate crowdin gallery_d_073_e3e628c5:
msgid "[_miranda_] Не важно, сколько ты будешь ему служить. Ты человек, а значит со временем ты постареешь"
msgstr "[_miranda_] No importa cuánto tiempo le sirvas. Eres humana, lo que significa que envejecerás eventualmente."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:337 #-#-# translate crowdin gallery_d_073_daaf8981:
msgid "[_miranda_] Твои формы обвиснут, кожа станет морщинистой, а тело слабым и не выносливым"
msgstr "[_miranda_] Tu forma se hundirá, tu piel se arrugará y tu cuerpo se volverá débil e insoportable."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:338 #-#-# translate crowdin gallery_d_073_c53143f2:
msgid "[_cedrick_] (Черт, Миранда, этот образ не идет на пользу моему стояку..)"
msgstr "[_cedrick_] (Maldita sea, Miranda, esa imagen no es buena para mi erección...)"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:339 #-#-# translate crowdin gallery_d_073_b660046c:
msgid "[_will_] Это правда, но, хм.. Уверена, на Меридиане есть средство, с помощью которого мою жизнь можно продлить"
msgstr "[_will_] Eso es cierto, pero, hmm. Estoy seguro de que hay un medio de prolongar mi vida en Meridian."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:341 #-#-# translate crowdin gallery_d_073_0a6f9849:
msgid "[_will_] Если Рик захочет сделать меня вечно молодой, ты ведь ему не откажешь, верно, паучиха?"
msgstr "[_will_] Si Rick quiere hacerme eternamente joven, no dirías que no, ¿verdad, araña?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:343 #-#-# translate crowdin gallery_d_073_c27e4a66:
msgid "[_miranda_] Пф, ах ты дрянь.."
msgstr "[_miranda_] Pfft, puta."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:344 #-#-# translate crowdin gallery_d_073_10242dc1:
msgid "[_miranda_] ..."
msgstr "[_miranda_] ..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:345 #-#-# translate crowdin gallery_d_073_7b0aa9e6:
msgid "[_miranda_] Нет, я не откажу Седрику. Но не думай, что это даст тебе какое-то преимущество, я все еще на сотню лет опытнее тебя"
msgstr "[_miranda_] No, no me negaré Cedric. Pero no creas que te dará ninguna ventaja, aún tengo cien años más de experiencia que tú."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:346 #-#-# translate crowdin gallery_d_073_42e64769:
msgid "[_will_] Мммв.. Пока ты болтаешь о своей долгой жизни я успеваю полировать член Рика, так что продолжай в том же духе.."
msgstr "[_will_] Mm-hmm. Mientras hablas de tu larga vida, yo estoy puliendo la polla de Rick, así que sigue así."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:347 #-#-# translate crowdin gallery_d_073_8fb0ab56:
msgid "[_will_] Болтай без умолку о своем превосходстве, пока я набираюсь опыта в том, как сделать Рику приятно.. Ааааам"
msgstr "[_will_] Habla sin parar de tu superioridad mientras yo adquiero experiencia sobre cómo hacer sentir bien a Rick. Aaaaam"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:348 #-#-# translate crowdin gallery_d_073_e668d04a:
msgid "[_miranda_] Э-эй, девчонка!! Хватит так напирать. Если Седрик и кончит, то только на меня"
msgstr "[_miranda_] ¡Oye, chica! Deja de presionar tanto. Si Cedric se va a correr, va a ser conmigo."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:349 #-#-# translate crowdin gallery_d_073_e7960c51:
msgid "[_cedrick_] (Хах, Вилл даже умудрилась вывести Миранду из себя, интересно. Видимо указав Вилл на ее слабое место, Миранда лишь заставила ее сильнее стараться)"
msgstr "[_cedrick_] (Huh, Will incluso consiguió cabrear a Miranda, curiosamente. Al parecer, al señalar la debilidad de Will, Miranda sólo hizo que se esforzara más.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:350 #-#-# translate crowdin gallery_d_073_5893cea3:
msgid "[_will_] Я не уступлю! Рик кончит именно от моих стараний!"
msgstr "[_will_] ¡No cederé! ¡Rick se correrá sólo con mi esfuerzo!"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:351 #-#-# translate crowdin gallery_d_073_db6e1f27:
msgid "[_miranda_] Нет от моих! Именно мой рот заставит его кончить!!"
msgstr "[_will_] ¡No, de la mía! ¡¡¡Es mi boca la que le hará correrse!!!"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:352 #-#-# translate crowdin gallery_d_073_d00f4a1c:
msgid "[_will_] Н-нет, мой!"
msgstr "[_will_] ¡No, mío!"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:353 #-#-# translate crowdin gallery_d_073_7e852728:
msgid "[_cedrick_] Эй-эй, девчонки, вы.. Ухх, черт.."
msgstr "[_cedrick_] Hey, hey, chicas, ustedes-- Ugh, maldita sea."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:356 #-#-# translate crowdin gallery_d_073_3f0f2c87:
msgid "[_cedrick_] К-кончаю.."
msgstr "[_cedrick_] Me corro..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:359 #-#-# translate crowdin gallery_d_073_0b76b0e6:
msgid "[_miranda_] Вот черт, из-за этой дрянной девчонки Седрик не смог кончить мне в рот"
msgstr "[_miranda_] Oh mierda, por culpa de esa chica de pacotilla, Cedric no pudo correrse en mi boca."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:360 #-#-# translate crowdin gallery_d_073_44d09528:
msgid "[_will_] Пф, это из-за тебя он не смог кончить в меня"
msgstr "[_will_] Tú eres la razón por la que no pudo correrse en mí."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:361 #-#-# translate crowdin gallery_d_073_f55ef7c2:
msgid "[_cedrick_] Так, а ну прекратили этот балаган!"
msgstr "[_cedrick_] ¡Muy bien, basta!"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:363 #-#-# translate crowdin gallery_d_073_10242dc1_1:
msgid "[_miranda_] ..."
msgstr "[_miranda_] ..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:364 #-#-# translate crowdin gallery_d_073_bcd124bf_2:
msgid "[_will_] ..."
msgstr "[_will_] ..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:365 #-#-# translate crowdin gallery_d_073_fd7203c3:
msgid "[_cedrick_] Здесь я решаю, в кого и когда кончать, вам ясно?"
msgstr "[_cedrick_] Yo decido en quién me corro y cuándo, ¿entienden?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:366 #-#-# translate crowdin gallery_d_073_2a109969:
msgid "[_miranda_] Конечно, Седрик"
msgstr "[_miranda_] Por supuesto, Cedric."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:367 #-#-# translate crowdin gallery_d_073_20d497de:
msgid "[_will_] Д-да, Рик"
msgstr "[_will_] Sí, Rick."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:368 #-#-# translate crowdin gallery_d_073_b4f484a5:
msgid "[_cedrick_] (Мда, переборщил с отсутствием инициативы и в итоге спустил в холостую. В следующий раз нужно держать их под контролем)"
msgstr "[_cedrick_] (Sí, me pasé con mi falta de iniciativa y acabé desperdiciándolo. Necesidad de mantenerlos bajo control la próxima vez.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:369 #-#-# translate crowdin gallery_d_073_d320d42e:
msgid "[_cedrick_] (Но их взаимодействие довольно интересное. Нужно будет проверить, как Вилл реагирует на других девушек. Все же к предводительнице стражниц особое внимание)"
msgstr "[_cedrick_] (Pero sus interacciones son bastante interesantes. Habrá que ver cómo reacciona Will con las otras chicas. Aún así, la líder de los guardianes recibe una atención especial.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:370 #-#-# translate crowdin gallery_d_073_bf3da54e:
msgid "[_cedrick_] Вилл, нам пора возвращаться домой. Миранда, забери девчонок с собой и запри пока в подвале"
msgstr "[_cedrick_] Will, tenemos que ir a casa. Miranda, llévate a las chicas contigo y enciérralas en el sótano."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:371 #-#-# translate crowdin gallery_d_073_fd115a09:
msgid "[_cedrick_] Можешь передать их Булджу, он присмотрит за тем, чтобы они не буянили"
msgstr "[_cedrick_] Puedes dárselos a Bulge, él se asegurará de que no se alboroten."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:372 #-#-# translate crowdin gallery_d_073_d1f110cc:
msgid "[_cedrick_] Особое внимание удели Тарани. Ирма не будет сопротивляться, а вот Тарани начнет вырываться при любой возможности"
msgstr "[_cedrick_] Preste especial atención a Tarani. Irma no se defenderá, pero Tarani empezará a arremeter en cada oportunidad."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:373 #-#-# translate crowdin gallery_d_073_df90b19a:
msgid "[_miranda_] Поняла тебя, Седрик. Я все сделаю. Увидимся в замке"
msgstr "[_cedrick_] Entendido, Cedric. Lo haré. Te veré en el castillo"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:374 #-#-# translate crowdin gallery_d_073_ea11beac:
msgid "[_will_] Хах, до скорого паучиха!"
msgstr "[_will_] ¡Huh, nos vemos pronto Spiderwoman!"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:375 #-#-# translate crowdin gallery_d_073_a615c0b5:
msgid "[_miranda_] Пф.."
msgstr "[_miranda_] Ugg..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:376 #-#-# translate crowdin gallery_d_073_e25b2bb4:
msgid "[_cedrick_] Идем, Вилл"
msgstr "[_cedrick_] Vamos, Will."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:377 #-#-# translate crowdin gallery_d_073_5a70d2c0:
msgid "[_will_] Д-да.."
msgstr "[_elion_] S-Sí..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:381 #-#-# translate crowdin gallery_d_073_8af61553:
msgid "[_cedrick_] Кстати говоря, твоя мама, очевидно, не знает, кто я. Я устроил все так, что теперь она думает, якобы я работаю под прикрытием в качестве подставного подозреваемого"
msgstr "[_cedrick_] Hablando de eso, tu madre obviamente no sabe quién soy. Lo arreglé para que ahora piense que estoy trabajando encubierto como un falso sospechoso."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:382 #-#-# translate crowdin gallery_d_073_68209636:
msgid "[_will_] Ого, а ты я смотрю везде поспел"
msgstr ""

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:383 #-#-# translate crowdin gallery_d_073_0bc57fea:
msgid "[_cedrick_] Даже не представляешь, каких усилий мне это стоило. В общем, просто подыграй мне"
msgstr ""

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:384 #-#-# translate crowdin gallery_d_073_dbef4e9d:
msgid "[_will_] Хорошо, Рик.. Эм.. Вернее Седрик"
msgstr ""

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:385 #-#-# translate crowdin gallery_d_073_9650b29b:
msgid "[_cedrick_] При маме меня так лучше не называть"
msgstr ""

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:386 #-#-# translate crowdin gallery_d_073_14b28d45:
msgid "[_will_] Хах, само собой.."
msgstr ""

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:391 #-#-# translate crowdin gallery_d_073_5b7de272:
msgid "[_cedrick_] Мы дома"
msgstr ""

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:394 #-#-# translate crowdin gallery_d_073_2e8dcbe4:
msgid "[_susan_] О боже, Рик, ты цел.. Вилл, и ты здесь?"
msgstr ""

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:398 #-#-# translate crowdin gallery_d_073_a8e7292a:
msgid "[_will_] Д-да, мам, мы встретились по пути.."
msgstr ""

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:399 #-#-# translate crowdin gallery_d_073_0d6d64f6:
msgid "[_cedrick_] Вилл уже в курсе, я ей все рассказал по дороге домой"
msgstr ""

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:403 #-#-# translate crowdin gallery_d_073_3b9269df:
msgid "[_susan_] Р-рик, так значит.. Все это время ты работал под прикрытием? Был подставным подозреваемым?"
msgstr ""

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:407 #-#-# translate crowdin gallery_d_073_e2659c2e:
msgid "[_cedrick_] Да.. Я не говорил вам, потому что не хотел, чтобы вы волновались, к тому же.."
msgstr ""

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:408 #-#-# translate crowdin gallery_d_073_bf71d053:
msgid "[_cedrick_] Понимаешь, я начал участвовать в этом, когда у меня никого не было, я только осваивался в этом городе и своей легенде.."
msgstr ""

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:409 #-#-# translate crowdin gallery_d_073_dd91eb58:
msgid "[_cedrick_] Но потом у меня появилась ты и Вилл.. Я, я просто не мог позволить себе подвергать вас опасности, поэтому молчал об этом до последнего.."
msgstr ""

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:410 #-#-# translate crowdin gallery_d_073_6eff4c38:
msgid "[_cedrick_] Я очень не хочу вас терять и ту жизнь, что у нас образовалась за это короткое время. Сделаю для этого все, что только в моих силах"
msgstr "[_cedrick_] Realmente no quiero perderte a ti y la vida que hemos construido en este corto tiempo. Haré todo lo que esté en mi mano para que así sea."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:414 #-#-# translate crowdin gallery_d_073_6bd14209:
msgid "[_susan_] Ох, Рик, это.. У меня нет слов, я так тебя люблю.. Конечно, я все прекрасно понимаю.."
msgstr "[_susan_] Rick, es... No puedo decirte cuánto te quiero. Por supuesto, lo entiendo completamente."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:415 #-#-# translate crowdin gallery_d_073_279da829:
msgid "[_will_] (Ого, как сладко поет.. Даже меня это тронуло, учитывая, что я знаю, что он лжет..)"
msgstr "[_will_] (Wow, qué dulce canta... Incluso a mí me conmovió esto, considerando que sé que está mintiendo.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:420 #-#-# translate crowdin gallery_d_073_af4b18fc:
msgid "[_susan_] Я не знала, что и думать, когда в первый раз Медина пришла со словами о том, что ты преступник и у них на тебя ордер.."
msgstr "[_susan_] No sabía qué pensar cuando Medina llegó diciendo que eras un criminal y que tenían una orden contra ti."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:422 #-#-# translate crowdin gallery_d_073_acf8908c:
msgid "[_cedrick_] Хах, да уж, от такого у кого угодно голова пойдет кругом.. Прости, эта процедура была необходима, чтобы обвести Мактиннена вокруг пальца"
msgstr "[_cedrick_] Ja, sí, esto haría que a cualquiera le diera vueltas la cabeza... Lo siento, este procedimiento fue necesario para engañar a McTinnen."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:426 #-#-# translate crowdin gallery_d_073_41d0cf70:
msgid "[_cedrick_] Теперь он уверен в том, что сам вне подозрений. Но наша работа еще не окончена.."
msgstr "[_cedrick_] Ahora está seguro de que él mismo está fuera de toda sospecha. Pero nuestro trabajo aún no ha terminado."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:430 #-#-# translate crowdin gallery_d_073_3d28e87e:
msgid "[_susan_] Н-нет, все хорошо.. Ты наверное так много всего пережил за это время.."
msgstr "[_susan_] No, está bien. Debes haber pasado por mucho en ese tiempo."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:434 #-#-# translate crowdin gallery_d_073_bd919bb2:
msgid "[_cedrick_] (Ооо, поверь, я пережил за это время куда больше, чем хотел бы)"
msgstr "[_cedrick_] (Ooh, créeme, he pasado por mucho más de lo que me gustaría.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:438 #-#-# translate crowdin gallery_d_073_33a49644:
msgid "[_susan_] Наверное сейчас ты больше всего хотел бы просто отдохнуть?"
msgstr "[_susan_] ¿Probablemente lo que más te gustaría hacer ahora es descansar?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:442 #-#-# translate crowdin gallery_d_073_41c8341f:
msgid "[_cedrick_] Да.. Я пока побуду в вашем доме, здесь меня не будут искать. Нужно переждать, пока Медина не устроит все должным образом"
msgstr "[_cedrick_] Sí. Me quedaré un tiempo en tu casa, aquí no me buscarán. Tenemos que esperar a que Medina arregle las cosas como es debido."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:448 #-#-# translate crowdin gallery_d_073_24390d70:
msgid "[_susan_] Она уже рассказала мне об этом. Конечно, будь здесь столько, сколько хочешь, Рик. Ты для нас теперь полноправный член семьи. Верно, Вилл?"
msgstr "[_susan_] Ya me lo contó. Claro, quédate todo el tiempo que quieras, Rick. Ahora eres un miembro pleno y derecho de la familia. ¿Verdad, Will?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:449 #-#-# translate crowdin gallery_d_073_adbfa1f4:
msgid "[_will_] Ох, да, верно. Как за это время можно было тебя не полюбить, Рик.."
msgstr "[_will_] Sí, claro. ¿Cómo podría no quererte en este momento, Rick?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:450 #-#-# translate crowdin gallery_d_073_e6c76abd:
msgid "[_cedrick_] (Хах, эти ее слова теперь звучат слишком многозначительно)"
msgstr "[_cedrick_] (Huh, esas palabras suyas ahora suenan demasiado significativas.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:455 #-#-# translate crowdin gallery_d_073_8fa08be4:
msgid "[_susan_] Рада, что ты будешь спать у нас в теплой постели, а не в каком-нибудь секретном подвале"
msgstr "[_susan_] Me alegro de que duermas en nuestra cama caliente y no en un sótano secreto."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:459 #-#-# translate crowdin gallery_d_073_16b7d140:
msgid "[_cedrick_] Хах.. Хорошо сказано, я как раз уже без сил, пожалуй пойду вздремну"
msgstr "[_cedrick_] Huh. Bien dicho, estoy casi sin energía, creo que voy a tomar una siesta."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:463 #-#-# translate crowdin gallery_d_073_928d5f29:
msgid "[_susan_] Конечно, Рик, отдыхай.. Я пока пойду на кухню, приготовлю ужин. Вилл, ты голодна?"
msgstr "[_susan_] Claro, Rick, descansa un poco. Voy a la cocina a preparar la cena. Will, ¿tienes hambre?"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:464 #-#-# translate crowdin gallery_d_073_fb2e2d83:
msgid "[_will_] Н-нет.. Не особо.."
msgstr "[_will_] N-no. No realmente."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:467 #-#-# translate crowdin gallery_d_073_0db8a95a:
msgid "Сьюзан уходит на кухню"
msgstr "Susan va a la cocina"

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:468 #-#-# translate crowdin gallery_d_073_49316299_3:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:469 #-#-# translate crowdin gallery_d_073_bcd124bf_3:
msgid "[_will_] ..."
msgstr "[_will_] ..."

