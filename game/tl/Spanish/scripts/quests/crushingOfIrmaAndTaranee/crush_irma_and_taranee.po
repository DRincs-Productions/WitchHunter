# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:403 #-#-# translate crowdin gallery_d_073_3b9269df:
msgid "[_susan_] Р-рик, так значит.. Все это время ты работал под прикрытием? Был подставным подозреваемым?"
