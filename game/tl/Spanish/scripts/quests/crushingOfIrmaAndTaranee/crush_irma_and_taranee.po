# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:374 #-#-# translate crowdin gallery_d_073_ea11beac:
msgid "[_will_] Хах, до скорого паучиха!"
msgstr ""

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:375 #-#-# translate crowdin gallery_d_073_a615c0b5:
msgid "[_miranda_] Пф.."
msgstr ""

# game/scripts/quests/crushingOfIrmaAndTaranee/crush_irma_and_taranee.rpy:376 #-#-# translate crowdin gallery_d_073_e25b2bb4:
