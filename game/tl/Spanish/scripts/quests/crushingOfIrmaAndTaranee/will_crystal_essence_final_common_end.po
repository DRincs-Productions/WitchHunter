msgid "..."
msgstr "..."

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_common_end.rpy:5 #-#-# translate crowdin will_crystal_essence_final_common_end_9b8bc859:
msgid "[_centered_] {size=37}Утром в доме Вендомов{/size} [withDissolve1]"
msgstr "[_centered_] {size=37}Por la mañana, en casa de los Vandom{/size} [withDissolve1]"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_common_end.rpy:8 #-#-# translate crowdin will_crystal_essence_final_common_end_b0393b4f:
msgid "[_cedrick_] (Что ж, с Вилл я разобрался, теперь нужно разобраться с моей невиновностью)"
msgstr "[_cedrick_] (Bueno, ya he lidiado con Will, ahora tengo que lidiar con mi inocencia.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_common_end.rpy:9 #-#-# translate crowdin will_crystal_essence_final_common_end_6c0c47cc:
msgid "[_cedrick_] (Для начала определимся с вводными данными)"
msgstr "[_cedrick_] (Primero, decidamos los datos de entrada.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_common_end.rpy:10 #-#-# translate crowdin will_crystal_essence_final_common_end_c7563f4a:
msgid "[_cedrick_] (Медина ищет улики, указывающие на Мактиннена. Но, думаю ей довольно сложно искать то, чего нет. На этом этапе сложно на нее рассчитывать)"
msgstr "[_cedrick_] (Medina está buscando pruebas que apunten a Maktinen. Pero creo que es bastante difícil para ella buscar algo que no está ahí. Es difícil contar con ella en este momento.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_common_end.rpy:11 #-#-# translate crowdin will_crystal_essence_final_common_end_0f55a66e:
msgid "[_cedrick_] (Из имеющегося у меня арсенала, есть новоприобретенная способность изменения сознания. Но она слишком специфическая для частого использования..)"
msgstr "[_cedrick_] (De mi arsenal existente, hay una capacidad recién adquirida para cambiar la conciencia. Pero es demasiado específica para un uso frecuente…)"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_common_end.rpy:12 #-#-# translate crowdin will_crystal_essence_final_common_end_6083fbf9:
msgid "[_cedrick_] (Я должен хорошо знать цель, чтобы понять, что ей можно внушить, а что нет, ведь если я начну внушать то, что противоречит основам ее личности, то в лучшем случае это просто не сработает..)"
msgstr "[_cedrick_] (Tengo que conocer bien al objetivo para entender qué se le puede inculcar y qué no, porque si empiezo a inculcarle algo que contradice los fundamentos básicos de su personalidad, entonces, en el mejor de los casos, simplemente no funcionará…)"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_common_end.rpy:13 #-#-# translate crowdin will_crystal_essence_final_common_end_d4021991:
msgid "[_cedrick_] (А в худшем у бедняжки начнут мозги плавиться.. К тому же на эту способность уходит много зелий, а новых Миранда еще не сделала)"
msgstr "[_cedrick_] (Y en el peor de los casos, el cerebro de la pobre comenzará a derretirse… Además, esta habilidad requiere muchas pociones, y Miranda aún no ha hecho ninguna nueva)"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_common_end.rpy:14 #-#-# translate crowdin will_crystal_essence_final_common_end_c12b2625:
msgid "[_cedrick_] (Хм.. Значит, остаются старые добрые манипуляции и интриги..)"
msgstr "[_cedrick_] (Hmm… Entonces solo quedan las viejas y confiables manipulaciones e intrigas…)"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_common_end.rpy:15 #-#-# translate crowdin will_crystal_essence_final_common_end_380ec5be:
msgid "[_cedrick_] Видимо самое время помочь нашему детективу в этом нелегком деле. Для начала мне нужны свидетели и пострадавшие)"
msgstr "[_cedrick_] (Al parecer es hora de ayudar a nuestro detective en este difícil asunto. Primero necesito testigos y víctimas.)"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_common_end.rpy:18 #-#-# translate crowdin will_crystal_essence_final_common_end_ef782473:
msgid "[_centered_] {size=37}СЕДРИК НАХОДИТ КЕПКУ И ТЕМНЫЕ ОЧКИ{/size} [withDissolve1]"
msgstr "[_centered_] {size=37}CEDRIC ENCUENTRA GORRA Y GAFAS DE SOL{/size} [withDissolve1]"

# game/scripts/quests/crushingOfIrmaAndTaranee/will_crystal_essence_final_common_end.rpy:20 #-#-# translate crowdin will_crystal_essence_final_common_end_28265236:
msgid "[_cedrick_] (Ну.. По крайней мере в фильмах это всегда работает..)"
msgstr "[_cedrick_] (Bueno, al menos en las películas siempre funciona.)"

