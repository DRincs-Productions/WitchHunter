# TODO: Translation updated at 2023-07-25 15:55 #|#|# # game/scripts/quests/newspaperSection/newspaper_section_elyon_talk_about_reading_evening.rpy:3 #-#-# translate crowdin newspaper_section_elyon_talk_about_reading_evening_15da6b72:
msgid "[_cedrick_] (Нужно сходить в школу, проверить, все ли в порядке. Надеюсь они сумели закрыть портал и избавится от вепря Герментуия. Из учителей я был в школе последним, и если там что-то произошло - меня могут обвинить в этом)"
msgstr "[_cedrick_] (Necesito ir a la escuela, comprobar que todo esté bien. Espero que hayan podido cerrar el portal y deshacerse del jabalí Hermentuia. De los maestros, fui el último en la escuela, y si ocurrió algo allí, podrían culparme de ello)"

# game/scripts/quests/newspaperSection/newspaper_section_elyon_talk_about_reading_evening.rpy:4 #-#-# translate crowdin newspaper_section_elyon_talk_about_reading_evening_09aa1fc0:
msgid "[_cedrick_] Элион, мне нужно идти. Оставляю магазин на тебя"
msgstr "[_cedrick_] Elyon, necesito irme. Te dejo la tienda a ti"

# game/scripts/quests/newspaperSection/newspaper_section_elyon_talk_about_reading_evening.rpy:13 #-#-# translate crowdin newspaper_section_elyon_talk_about_reading_evening_d1e07a29:
msgid "[_elion_] Рик, подожди..."
msgstr "[_elion_] Rick, espera..."

# game/scripts/quests/newspaperSection/newspaper_section_elyon_talk_about_reading_evening.rpy:14 #-#-# translate crowdin newspaper_section_elyon_talk_about_reading_evening_86fb0aaf:
msgid "[_cedrick_] Мм??"
msgstr "[_cedrick_] ¿¿Hmm??"

# game/scripts/quests/newspaperSection/newspaper_section_elyon_talk_about_reading_evening.rpy:17 #-#-# translate crowdin newspaper_section_elyon_talk_about_reading_evening_41d24078:
msgid "[_elion_] Сегодня вечером должен пройти вечер чтений, и он будет не совсем обычный…"
msgstr "[_elion_] Esta noche debe haber una lectura de la tarde, y no será del todo normal..."

# game/scripts/quests/newspaperSection/newspaper_section_elyon_talk_about_reading_evening.rpy:20 #-#-# translate crowdin newspaper_section_elyon_talk_about_reading_evening_3358bb5a:
msgid "[_cedrick_] Что же в нем необычного?"
msgstr "[_cedrick_] ¿Qué hay de inusual en él?"

# game/scripts/quests/newspaperSection/newspaper_section_elyon_talk_about_reading_evening.rpy:23 #-#-# translate crowdin newspaper_section_elyon_talk_about_reading_evening_df08f1ab:
msgid "[_elion_] Должны прийти несколько начинающих писателей, которые довольно популярны в некоторых кругах"
msgstr "[_elion_] Deben venir algunos escritores principiantes que son bastante populares en ciertos círculos."

# game/scripts/quests/newspaperSection/newspaper_section_elyon_talk_about_reading_evening.rpy:26 #-#-# translate crowdin newspaper_section_elyon_talk_about_reading_evening_3a1776ad:
msgid "[_elion_] И скорее всего это привлечет много народу… Так что лучше, чтобы ты не задерживался, одна я не справлюсь"
msgstr "[_elion_] Y probablemente todo esto atraerá a mucha gente... Así que es mejor que no te retrases, no podré manejarlo sola."

# game/scripts/quests/newspaperSection/newspaper_section_elyon_talk_about_reading_evening.rpy:29 #-#-# translate crowdin newspaper_section_elyon_talk_about_reading_evening_89e3213f:
msgid "[_cedrick_] Пожалуй это поможет нам неплохо заработать"
msgstr "[_cedrick_] Quizás esto nos ayude a ganar un buen dinero."

# game/scripts/quests/newspaperSection/newspaper_section_elyon_talk_about_reading_evening.rpy:30 #-#-# translate crowdin newspaper_section_elyon_talk_about_reading_evening_3e67203f:
msgid "[_cedrick_] Хорошо, я приду "
msgstr "[_cedrick_] Está bien, iré."

