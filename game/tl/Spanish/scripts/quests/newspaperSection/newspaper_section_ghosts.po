# TODO: Translation updated at 2023-07-25 15:55 #|#|# # game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:5 #-#-# translate crowdin newspaper_section_ghosts_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:6 #-#-# translate crowdin newspaper_section_ghosts_15908222:
msgid "[_cedrick_] (Хм.. Вроде все идет своим чередом)"
msgstr "[_cedrick_] (Hmm... Todo parece ir como siempre.)"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:9 #-#-# translate crowdin newspaper_section_ghosts_de841977:
msgid "[_directris_] Здравствуйте, мистер Хоффман. А вы молодец, газета получилась неплохо..."
msgstr "[_directris_] Hola, Sr. Hoffman. Está haciendo un gran trabajo; el trabajo quedó muy bien."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:13 #-#-# translate crowdin newspaper_section_ghosts_7126ec15:
msgid "[_cedrick_] Спасибо"
msgstr "[_cedrick_] Gracias."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:17 #-#-# translate crowdin newspaper_section_ghosts_c9883784:
msgid "[_directris_] Надеюсь вам не пришлось засиживаться до ночи, и все ученики пришли домой вовремя?"
msgstr "[_directris_] ¿Espero que no hayas tenido que quedarte despierto hasta tarde en la noche y que todos los estudiantes hayan llegado a casa a tiempo?"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:18 #-#-# translate crowdin newspaper_section_ghosts_c8a64b38:
msgid "[_cedrick_] Да, конечно "
msgstr "[_cedrick_] Sí, claro."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:22 #-#-# translate crowdin newspaper_section_ghosts_d906b742:
msgid "[_directris_] Ладно, мне пора заняться делами. А у вас сейчас должен быть урок, если я не ошибаюсь"
msgstr "[_directris_] Bueno, tengo que irme a trabajar. Y deberías estar teniendo una clase ahora, si no me equivoco."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:26 #-#-# translate crowdin newspaper_section_ghosts_1c193ac6:
msgid "[_cedrick_] Да, я уже иду"
msgstr "[_cedrick_] Sí, ya estoy en camino."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:29 #-#-# translate crowdin newspaper_section_ghosts_8663cba0:
msgid "[_cedrick_] (ну.. Похоже, что все в порядке, пора на урок)"
msgstr "[_cedrick_] (Bueno... Parece que todo está bien, hora de clase)"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:31 #-#-# translate crowdin newspaper_section_ghosts_3fa7d135:
msgid "[_centered_] {size=36}Через несколько минут на уроке{/size}"
msgstr "[_centered_] {size=36}Unos minutos después, durante la clase{/size}"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:34 #-#-# translate crowdin newspaper_section_ghosts_8e4c008d:
msgid "[_cedrick_] Всем здравствуйте. Сегодня у нас новая тема. Мы начнем изучать события, которые происходили в Бронзовом Веке в Европе."
msgstr "[_cedrick_] Hola a todos. Hoy tenemos un tema nuevo. Comenzaremos explorando los eventos que tuvieron lugar en la Edad de Bronce en Europa."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:37 #-#-# translate crowdin newspaper_section_ghosts_721a889b:
msgid "[_cedrick_] Бронзовый век на территории Европы последовал за Европейским медн..."
msgstr "[_cedrick_] La Edad del Bronce en Europa siguió a la Edad del Cobre europea."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:38 #-#-# translate crowdin newspaper_section_ghosts_70201cf5:
msgid "[_martin_] Профессор Хоффман!!"
msgstr "[_martin_] ¡¡Profesor Hoffman!!"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:39 #-#-# translate crowdin newspaper_section_ghosts_18a7b77c:
msgid "[_cedrick_] (ох..)"
msgstr "[_cedrick_] (Oh..)"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:42 #-#-# translate crowdin newspaper_section_ghosts_4ac6e6ee:
msgid "[_cedrick_] Да Мартин?"
msgstr "[_cedrick_] ¿Si, Martin?"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:43 #-#-# translate crowdin newspaper_section_ghosts_a64a67c5:
msgid "[_martin_] А можно мне выступить с докладом?"
msgstr "[_martin_] ¿Puedo hacer una presentación?"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:44 #-#-# translate crowdin newspaper_section_ghosts_1b400ce7:
msgid "[_cedrick_] Ну.. Мы опережаем график.. Почему бы и нет?"
msgstr "[_cedrick_] Bueno... Vamos adelantados en lo previsto... ¿Por qué no?"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:45 #-#-# translate crowdin newspaper_section_ghosts_5bf2668d:
msgid "[_martin_] Спасибо! Вы не пожалеете..."
msgstr "[_martin_] ¡Gracias! No te arrepentirás."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:46 #-#-# translate crowdin newspaper_section_ghosts_5f9b772e:
msgid "...."
msgstr "...."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:49 #-#-# translate crowdin newspaper_section_ghosts_039487a0:
msgid "[_martin_] В общем дело было вчера вечером... Мы с клубом журналистики решили найти сенсацию, и я отправился на ее поиски"
msgstr "[_martin_] En fin, pasó anoche... Mi club de periodismo y yo decidimos buscar una pista, y fui a buscarla."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:50 #-#-# translate crowdin newspaper_section_ghosts_b2b00de9:
msgid "[_cedrick_] (Уже жалею..)"
msgstr "[_cedrick_] (Ya me arrepiento.)"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:51 #-#-# translate crowdin newspaper_section_ghosts_765441f7:
msgid "[_martin_]  И я ее обнаружил! Не поверите, прямо в школьной столовой!"
msgstr "[_martin_] ¡Y lo encontré! ¡No se lo van a creer! ¡Justo en la cafetería del colegio!"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:52 #-#-# translate crowdin newspaper_section_ghosts_7cc3d785:
msgid "[_pupils_] То что в нашей столовой котлеты делают из собак и так все знают.."
msgstr "[_pupils_] Todo el mundo sabe que en nuestra cafetería hacen croquetas de perro."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:54 #-#-# translate crowdin newspaper_section_ghosts_79ef0561:
msgid "смешки в классе"
msgstr "Risas en el aula"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:55 #-#-# translate crowdin newspaper_section_ghosts_9fa8f4af:
msgid "[_martin_] Нет, вовсе нет! Когда я зашел в школьную столовую, я услышал какой-то шум..."
msgstr "[_martin_] ¡Para nada! Al entrar a la cafetería, oí un ruido..."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:56 #-#-# translate crowdin newspaper_section_ghosts_42241d4b:
msgid "[_martin_] Внезапно затряслись столы, взлетели подносы..."
msgstr "[_martin_] De repente las mesas se sacudieron y las bandejas volaron."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:57 #-#-# translate crowdin newspaper_section_ghosts_c1e4a0c5:
msgid "[_martin_] И я увидел призрака!"
msgstr "[_martin_] ¡Y vi un fantasma!"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:59 #-#-# translate crowdin newspaper_section_ghosts_f7a8d2cf:
msgid "[_centered_] {size=36}Спустя некоторое время{/size}"
msgstr "[_centered_] {size=36}Después de un tiempo{/size}"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:62 #-#-# translate crowdin newspaper_section_ghosts_021571a6:
msgid "[_martin_] Приведения слева, призраки справа! Я дрался! Но их было слишком много..."
msgstr "[_martin_] ¡Fantasmas a la izquierda, espectros a la derecha! ¡Luché! Pero eran demasiados."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:63 #-#-# translate crowdin newspaper_section_ghosts_67a606c0:
msgid "[_pupils_] У Мартина совсем крыша поехала.."
msgstr "[_pupils_] Martín ha perdido completamente la cabeza."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:64 #-#-# translate crowdin newspaper_section_ghosts_3db65c91:
msgid "[_martin_] Один из них поднял парту!"
msgstr "[_martin_] ¡Uno de ellos levantó el escritorio!"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:65 #-#-# translate crowdin newspaper_section_ghosts_63c69899:
msgid "[_pupils_] Эй, Раньше ты говорил про стул!"
msgstr "[_pupils_] Oye, ¡antes estabas hablando de una silla!"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:66 #-#-# translate crowdin newspaper_section_ghosts_88cb9cd9:
msgid "[_martin_] Парта в сборе со стулом. Такие бывают! Ясно?"
msgstr "[_martin_] Es un pupitre con silla incorporada. ¡Sí existen! ¿Está claro?"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:67 #-#-# translate crowdin newspaper_section_ghosts_e90b47f8:
msgid "[_martin_] Кстати попрошу не перебивать"
msgstr "[_martin_] Por cierto, por favor no interrumpas."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:68 #-#-# translate crowdin newspaper_section_ghosts_718f3bfe:
msgid "[_cedrick_] Мартин, это конечно все замечательно, но мой предмет - история"
msgstr "[_cedrick_] Martín, todo esto es genial, por supuesto, pero mi tema es la historia."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:69 #-#-# translate crowdin newspaper_section_ghosts_b927f669:
msgid "[_martin_] Так я и рассказываю историю! Историю, которая произошла со мной вчера!"
msgstr "[_martin_] ¡Así que les voy a contar una historia! ¡Una historia que me pasó ayer!"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:70 #-#-# translate crowdin newspaper_section_ghosts_88163559:
msgid "[_cedrick_] Ох..."
msgstr "[_cedrick_] Oh..."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:71 #-#-# translate crowdin newspaper_section_ghosts_56137bbf:
msgid "[_girl_] Мистер Хоффман!"
msgstr "[_girl_] ¡Señor Hoffman!"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:72 #-#-# translate crowdin newspaper_section_ghosts_edbdb30a:
msgid "[_cedrick_] Да, Венди?"
msgstr "[_cedrick_] ¿Sí, Wendy?"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:75 #-#-# translate crowdin newspaper_section_ghosts_4f8f31fb:
msgid "[_girl_] Кажется у меня тут что-то на парте... Я сразу не обратила внимание.."
msgstr "[_girl_] Creo que tengo algo en mi escritorio. No me había dado cuenta al principio."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:76 #-#-# translate crowdin newspaper_section_ghosts_e2c7cd01:
msgid "[_girl_] Оно жидкое и странно пахнет... Можно мне пересесть?"
msgstr "[_girl_] Es líquido y huele raro. ¿Puedo cambiar de lugar?"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:79 #-#-# translate crowdin newspaper_section_ghosts_616ffffe:
msgid "[_martin_] АГА!!"
msgstr "[_martin_] ¡¡AHA!!"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:82 #-#-# translate crowdin newspaper_section_ghosts_72641305:
msgid "[_martin_] Это должно быть Эктооо..плазма!! А я говорил вам!!"
msgstr "[_martin_] ¡¡Esto debe ser Ectooo...plasma!! ¡¡Se los dije!!"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:83 #-#-# translate crowdin newspaper_section_ghosts_6425e587:
msgid "[_martin_] Такое жидкое... густое, это определенно эктоплазма! Нужно отправить ее на исследование в лабораторию!"
msgstr "[_martin_] ¡Es tan líquido... tan espeso, definitivamente es ectoplasma! ¡Tenemos que enviarlo al laboratorio para que lo analicen!"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:84 #-#-# translate crowdin newspaper_section_ghosts_91960384:
msgid "[_girl2_] Мартин... Жаль тебя разочаровывать... но поверь, это сперма"
msgstr "[_girl2_] Martin... Siento decepcionarte... pero créeme, es esperma."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:88 #-#-# translate crowdin newspaper_section_ghosts_1a71e0b7:
msgid "Класс заливается смехом"
msgstr "La clase estalla en carcajadas"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:89 #-#-# translate crowdin newspaper_section_ghosts_3fa7d16d:
msgid "[_cedrick_] (Неужели я попал на парту...)"
msgstr "[_cedrick_] (¿De verdad terminé en el escritorio?)"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:90 #-#-# translate crowdin newspaper_section_ghosts_f09f60d9:
msgid "[_cedrick_] Думаю уборщик займется этим позже... А пока ты можешь пересесть ..."
msgstr "[_cedrick_] Creo que la persona encargada de la limpieza se ocupará de esto más tarde... Mientras tanto, puedes cambiarte."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:93 #-#-# translate crowdin newspaper_section_ghosts_d5978f6b:
msgid "Громкие Звуки стуков в коридоре... что-то грохочет и падает"
msgstr "Se oyen golpes en el pasillo... algo se estrella y cae"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:94 #-#-# translate crowdin newspaper_section_ghosts_f62d7085:
msgid "[_girl3_] Что это за звуки?!"
msgstr "[_girl3_] ¿Qué son esos sonidos?"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:95 #-#-# translate crowdin newspaper_section_ghosts_b82cff08:
msgid "[_cedrick_] Сидите на своих местах, я гляну что там происходит"
msgstr "[_cedrick_] Quédense en sus asientos, voy a ver qué pasa."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:96 #-#-# translate crowdin newspaper_section_ghosts_a20cefa7_1:
msgid "..."
msgstr "..."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:98 #-#-# translate crowdin newspaper_section_ghosts_c74a6fe6:
msgid "[_cedrick_] (охх..)"
msgstr "[_cedrick_] (ohh...)"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:101 #-#-# translate crowdin newspaper_section_ghosts_c3f53360:
msgid "[_pupils_] О боже что это.."
msgstr "[_pupils_] ¡Dios mío, qué es esto!"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:103 #-#-# translate crowdin newspaper_section_ghosts_99e9be4b:
msgid "[_pupils_] Мой шкафчик!"
msgstr "[_pupils_] ¡Mi taquilla!"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:104 #-#-# translate crowdin newspaper_section_ghosts_b18e300e:
msgid "[_cedrick_] (похоже им не удалось избавится от вепря..)"
msgstr "[_cedrick_] (Parece que no lograron deshacerse del jabalí...)"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:105 #-#-# translate crowdin newspaper_section_ghosts_503fa0ff:
msgid "[_pupils_] Это сделал призрак??"
msgstr "[_pupils_] (Parece que no pudieron deshacerse del jabalí.)"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:106 #-#-# translate crowdin newspaper_section_ghosts_2038dc19:
msgid "[_martin_] А я говорил!! "
msgstr "[_martin_] ¡¡Te lo dije!!"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:107 #-#-# translate crowdin newspaper_section_ghosts_c49ace62:
msgid "[_martin_]  Что тоже скажете сперма??? Это точно эктоплазма!!! "
msgstr "[_martin_]  ¿Qué dices también sobre el esperma? ¡Definitivamente es ectoplasma!"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:108 #-#-# translate crowdin newspaper_section_ghosts_a20cefa7_2:
msgid "..."
msgstr "..."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:111 #-#-# translate crowdin newspaper_section_ghosts_5d1bc9c9:
msgid "[_directris_] Что здесь произошло??? Кто это сделал??"
msgstr "[_directris_] ¿Qué pasó aquí? ¿Quién hizo esto?"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:112 #-#-# translate crowdin newspaper_section_ghosts_4b9f8ebf:
msgid "[_cedrick_] Мы не знаем, мисс.."
msgstr "[_cedrick_] No lo sabemos, señorita..."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:116 #-#-# translate crowdin newspaper_section_ghosts_1148b3e3:
msgid "[_martin_] Это призрак!! Это будет сенсация!!"
msgstr "[_martin_] ¡Es un fantasma! ¡Será toda una sensación!"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:120 #-#-# translate crowdin newspaper_section_ghosts_f6bf0ff3:
msgid "[_martin_] Я буду следить день и ночь!! Но я сделаю снимки с ним, я даже захватил с собой спальник!"
msgstr "[_martin_] ¡Estaré pendiente día y noche! ¡Pero me sacaré fotos con él, incluso traje un saco de dormir!"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:121 #-#-# translate crowdin newspaper_section_ghosts_7e9fbe12:
msgid "[_pupils_] Кажется Мартин не соврал.."
msgstr "[_pupils_] Parece que Martin no mintió."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:125 #-#-# translate crowdin newspaper_section_ghosts_8a74fcfd:
msgid "[_martin_] Я сфоткаю приведение и прославлюсь! "
msgstr "[_martin_] ¡Le sacaré una foto al fantasma y me haré famoso!"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:129 #-#-# translate crowdin newspaper_section_ghosts_f6b4bcbf:
msgid "[_tarani_] Ирма, давай отойдем на минутку..."
msgstr "[_tarani_] Irma, vamos a alejarnos un minuto."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:133 #-#-# translate crowdin newspaper_section_ghosts_b11cfbe6:
msgid "[_irma_] Да.. конечно..."
msgstr "[_irma_] Sí, claro..."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:137 #-#-# translate crowdin newspaper_section_ghosts_484e3172:
msgid "[_directris_] Мы обязательно найдем того, кто совершил этот акт вандализма.. И я даже догадываюсь, кто бы это мог быть..."
msgstr "[_directris_] Sin duda encontraremos a quien haya cometido este acto de vandalismo... E incluso puedo adivinar quién podría ser..."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:138 #-#-# translate crowdin newspaper_section_ghosts_0a3b4646:
msgid "[_directris_] А теперь все возвращайтесь на урок! Быстро!"
msgstr "[_directris_] ¡Ahora, todos, vuelvan a clase! ¡Rápido!"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:142 #-#-# translate crowdin newspaper_section_ghosts_053517dc:
msgid "[_pupils_] Я с детства боюсь призраков"
msgstr "[_pupils_] He tenido miedo a los fantasmas desde la infancia."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:144 #-#-# translate crowdin newspaper_section_ghosts_a0e7e6df:
msgid "[_pupils_] Боже я хочу домой"
msgstr "[_pupils_] Dios, quiero irme a casa."

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:146 #-#-# translate crowdin newspaper_section_ghosts_00ea4449:
msgid "[_cedrick_] ( Похоже, что уже нет смысла продолжать вести урок..)"
msgstr "[_cedrick_] (Parece que no tiene sentido continuar con la lección.)"

# game/scripts/quests/newspaperSection/newspaper_section_ghosts.rpy:148 #-#-# translate crowdin newspaper_section_ghosts_a20cefa7_3:
msgid "..."
msgstr "..."

