# TODO: Translation updated at 2023-07-25 15:55 #|#|# # game/scripts/quests/questNewPajamasForElyon/dialogue_about_pajams_for_elyon.rpy:4 #-#-# translate crowdin dialogue_about_pajams_for_elyon_420c9d30:
msgid "[_cedrick_] Элион, подойдешь на минутку?"
msgstr "[_cedrick_] Elyon, ¿serás un momento?"

# game/scripts/quests/questNewPajamasForElyon/dialogue_about_pajams_for_elyon.rpy:10 #-#-# translate crowdin dialogue_about_pajams_for_elyon_91e57f3a:
msgid "[_elion_] Да, что такое, Рик?"
msgstr "[_elion_] Sí, ¿qué pasa, Rick?"

# game/scripts/quests/questNewPajamasForElyon/dialogue_about_pajams_for_elyon.rpy:11 #-#-# translate crowdin dialogue_about_pajams_for_elyon_2d795d8f:
msgid "[_cedrick_] Ты уже какое-то время живешь у меня. Как тебе условия, все нравится?"
msgstr "[_cedrick_] Llevas un tiempo viviendo conmigo. ¿Cómo te gusta todo, te gusta todo?"

# game/scripts/quests/questNewPajamasForElyon/dialogue_about_pajams_for_elyon.rpy:14 #-#-# translate crowdin dialogue_about_pajams_for_elyon_3037c7c5:
msgid "[_elion_] Да, в целом все хорошо.. Только вот.."
msgstr "[_elion_] Sí, en general todo es bueno.. Sólo aquí."

# game/scripts/quests/questNewPajamasForElyon/dialogue_about_pajams_for_elyon.rpy:15 #-#-# translate crowdin dialogue_about_pajams_for_elyon_1fc079b7:
msgid "[_cedrick_] Хм, что такое?"
msgstr "[_cedrick_] Hmm, ¿qué es?"

# game/scripts/quests/questNewPajamasForElyon/dialogue_about_pajams_for_elyon.rpy:18 #-#-# translate crowdin dialogue_about_pajams_for_elyon_bb522d6a:
msgid "[_elion_] Ну, ты же понимаешь.. Все же это не полноценный дом, а только комната.."
msgstr "[_elion_] Bueno, ya sabes. No es una casa llena, sino solo una habitación."

# game/scripts/quests/questNewPajamasForElyon/dialogue_about_pajams_for_elyon.rpy:21 #-#-# translate crowdin dialogue_about_pajams_for_elyon_ec1b9f3b:
msgid "[_elion_] Н-не подумай, я не жалуюсь, просто.. Иногда сложно чувствовать себя в ней, как дома.. Порой в ней немного неуютно.."
msgstr "[_elion_] No lo pienses, no me quejo, sólo... A veces es difícil sentirse como en casa. A veces es un poco incómodo."

# game/scripts/quests/questNewPajamasForElyon/dialogue_about_pajams_for_elyon.rpy:24 #-#-# translate crowdin dialogue_about_pajams_for_elyon_392e85de:
msgid "[_cedrick_] Понятно.. Может, можно как-то повысить чувство уюта в комнате? Новые обои? Может кровать?"
msgstr "[_cedrick_] es claro. ¿Tal vez puedas de alguna manera aumentar la sensación de comodidad en la habitación? ¿Un nuevo fondo de pantalla? ¿Puede la cama?"

# game/scripts/quests/questNewPajamasForElyon/dialogue_about_pajams_for_elyon.rpy:27 #-#-# translate crowdin dialogue_about_pajams_for_elyon_a4e04920:
msgid "[_elion_] Эм, нет, ты не совсем понимаешь, это чувство.. Оно скорее тактильного характера"
msgstr "[_elion_] Um, no, no lo entiendes, es un sentimiento. Es más bien una naturaleza táctil"

# game/scripts/quests/questNewPajamasForElyon/dialogue_about_pajams_for_elyon.rpy:30 #-#-# translate crowdin dialogue_about_pajams_for_elyon_2f13c631:
msgid "[_cedrick_] Хм, тактильного.. Тогда, что на счет хорошей пижамы?"
msgstr "[_cedrick_] Hmm, táctil.. ¿Y qué hay de un buen pijama?"

# game/scripts/quests/questNewPajamasForElyon/dialogue_about_pajams_for_elyon.rpy:33 #-#-# translate crowdin dialogue_about_pajams_for_elyon_206f90c5:
msgid "[_elion_] П-пижамы?"
msgstr "[_elion_] ¿P-p-pjamas?"

# game/scripts/quests/questNewPajamasForElyon/dialogue_about_pajams_for_elyon.rpy:36 #-#-# translate crowdin dialogue_about_pajams_for_elyon_83c02e27:
msgid "[_cedrick_] Ага, теплая домашняя пижама, как тебе?"
msgstr "[_cedrick_] Ajá, un pijama abrigado para estar en casa. ¿Qué te parece?"

# game/scripts/quests/questNewPajamasForElyon/dialogue_about_pajams_for_elyon.rpy:39 #-#-# translate crowdin dialogue_about_pajams_for_elyon_14baaf80:
msgid "[_elion_] Было бы отлично, а то моя совсем уже старая.."
msgstr "[_elion_] Sería genial, o la mía es demasiado vieja."

# game/scripts/quests/questNewPajamasForElyon/dialogue_about_pajams_for_elyon.rpy:40 #-#-# translate crowdin dialogue_about_pajams_for_elyon_c75f4eef:
msgid "[_cedrick_] Отлично, тогда вскоре я ее закажу"
msgstr "[_cedrick_] Genial, pronto lo pediré"

# game/scripts/quests/questNewPajamasForElyon/dialogue_about_pajams_for_elyon.rpy:43 #-#-# translate crowdin dialogue_about_pajams_for_elyon_dfad9ead:
msgid "[_elion_] С-спасибо, Рик!"
msgstr "[_elion_] Gracias, Rick!"

