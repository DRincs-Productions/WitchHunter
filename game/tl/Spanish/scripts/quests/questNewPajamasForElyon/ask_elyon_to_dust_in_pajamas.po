# TODO: Translation updated at 2023-07-25 15:55 #|#|# # game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:5 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_1f8fc468:
msgid "[_cedrick_] Элион, настало время для рутинной работы в библиотеке"
msgstr "[_cedrick_] Elyon, llegó la hora del trabajo rutinario en la biblioteca."

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:8 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_511d7439:
msgid "[_elion_] Я готова, Рик, что нужно сделать?"
msgstr "[_elion_] Estoy lista, Rick. ¿Qué hay que hacer?"

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:9 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_5cad637a:
msgid "[_cedrick_] (Еще бы ты не была готова, я тебе за это плачу)"
msgstr "[_cedrick_] (Si no estabas listo, te lo pago)"

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:10 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_ff235867:
msgid "[_cedrick_] Нужно протереть пыль с верхних полок. Займешься этим?"
msgstr "[_cedrick_] Necesitas limpiar el polvo de los estantes superiores. ¿Vas a hacer esto?"

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:13 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_6106c255:
msgid "[_elion_] Хорошо, сейчас, только стремянку возьму"
msgstr "[_elion_]H Bueno, ahora, solo escalera"

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:15 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:18 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_0860d85f:
msgid "[_cedrick_] (Ее зад выглядит просто роскошно с этого ракурса..)"
msgstr "[_cedrick_] (Su culo se ve simplemente lujoso desde este ángulo.)"

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:19 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_1d0a3799:
msgid "[_cedrick_] (Черт, эти сочные формы так и напрашиваются на сочный шлепок..)"
msgstr "[_cedrick_] (Maldita sea, estas formas jugosas y suplican una bofetada jugosa)."

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:25 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_0adfbcfb:
msgid "[_cedrick_] (Ладно, не буду лишний раз ее беспокоить, пока она в таком шатком положении, а то упадет еще)"
msgstr "[_cedrick_] (Está bien, no la molestaré una vez más mientras esté en una posición tan precaria, o volverá a caer)"

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:26 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_95f64253:
msgid "[_cedrick_] (Было бы довольно глупо запороть задание Фобоса, из-за того, что его сестра свернет шею после шлепка по заднице)"
msgstr "[_cedrick_] (Sería bastante tonto fandom la tarea de Fobos, debido al hecho de que su hermana girará el cuello después de la bofetada en el culo)"

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:28 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_c1740e85:
msgid "[_elion_] Рик, я закончила!"
msgstr "[_elion_] ¡Rick, ya terminé!"

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:30 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_d09b18b8:
msgid "[_cedrick_] Отлично, Элион. Вот, держи твои 10$"
msgstr "[_cedrick_] Es genial, Elyon. Aquí, mantenga su $ 10"

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:31 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_e7d61630:
msgid "[_elion_] Спасибо, Рик! Рада стараться!"
msgstr "[_elion_] Gracias, Rick! ¡Me alegro de intentarlo!"

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:37 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_0d8c71a3:
msgid "[_cedrick_] (А, какого черта, я уже слишком далеко зашел с ней, чтобы сейчас сдерживаться)"
msgstr "[_cedrick_] (Oh, qué diablos, ya he ido demasiado lejos con ella para aferrarme a ella ahora)"

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:39 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_3d91bdc4:
msgid "*шлепок*"
msgstr "*Parche*"

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:41 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_d2e7f275:
msgid "[_elion_] Р-Рик!.. Ч-что ты делаешь?"
msgstr "[_elion_] ¡R-Rick! ¿Qué estás haciendo?"

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:42 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_451a208e:
msgid "[_cedrick_] Подгоняю тебя, чтобы ты быстрее протерла полки, хехе"
msgstr "[_cedrick_] Te estoy cortando a tus estantes más rápido, jeje"

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:43 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_9397a2db:
msgid "[_elion_] Н-не смешно, я же могу упасть"
msgstr "[_elion_] N-no gracioso, puedo caer"

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:44 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_1b12a834:
msgid "[_cedrick_] Ничего, если что, я тебя поймаю"
msgstr "[_cedrick_] Nada, en todo caso, te atraparé"

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:46 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_3d91bdc4_1:
msgid "*шлепок*"
msgstr "*Parche*"

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:48 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_bbf66e5c:
msgid "[_elion_] Рик!"
msgstr "[_elion_] ¡Rick!"

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:49 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_e08263b7:
msgid "[_cedrick_] Прости, но когда ты так стоишь, чертовски сложно отказаться от того, чтобы шлепнуть такую упругую попку"
msgstr "[_cedrick_] Lo siento, pero cuando estás así es muy difícil resistirse a darle una palmada a un trasero tan firme."

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:50 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_0afa95a0:
msgid "[_elion_] Р-рик, не говори такие вещи.. Ты меня смущаешь.."
msgstr "[_elion_] R-rh, no digas cosas así. Me estás avergonzando."

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:51 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_b814e31a:
msgid "[_cedrick_] Ну тогда еще разок и можешь слезать"
msgstr "[_cedrick_] Bien, una vez más y puedes bajarte."

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:53 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_3d91bdc4_2:
msgid "*шлепок*"
msgstr "*Parche*"

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:54 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_a559eab5:
msgid "[_elion_] Ах.."
msgstr "[_elion_] Ah..."

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:56 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_7c6434a6:
msgid "[_cedrick_] Отличная работа, Элион, что бы я без тебя делал. Вот, держи за это 10$"
msgstr "[_cedrick_] Gran trabajo, Elyon, ¿qué haría sin ti? Aquí, espera $10 por eso"

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:57 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_aaa81704:
msgid "[_elion_] С-спасибо, Рик.."
msgstr "[_elion_] Gracias, Rick."

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:58 #-#-# translate crowdin ask_elyon_to_dust_in_pajamas_5d3237f9:
msgid "[_elion_] (Моя попка горит…)"
msgstr "[_elion_] (Mi culo quema...)"

# §translate crowdin strings: #|#|# # game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:22
msgid "Шлепнуть Элион?"
msgstr "¿Bofetear con Elyon?"

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:22
msgid "Не стоит"
msgstr "No merece la pena"

# game/scripts/quests/questNewPajamasForElyon/ask_elyon_to_dust_in_pajamas.rpy:22
msgid "Шлепнуть"
msgstr "Lapso"

