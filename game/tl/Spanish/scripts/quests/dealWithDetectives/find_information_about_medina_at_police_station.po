# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:108 #-#-# translate crowdin gallery_d_069_e0ad4430_1:
msgid "[_medina_] ..."
msgstr "[_medina_] …"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:109 #-#-# translate crowdin gallery_d_069_e7f641c5:
msgid "[_cedrick_] Черт, надеюсь она не умерла.."
msgstr "[_cedrick_] Mierda, espero que no esté muerta…"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:111 #-#-# translate crowdin gallery_d_069_28cc7300:
msgid "[_cedrick_] Нет, вроде дышит.."
msgstr "[_cedrick_] No, parece estar respirando…"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:112 #-#-# translate crowdin gallery_d_069_e0ad4430_2:
msgid "[_medina_] ..."
msgstr "[_medina_] …"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:113 #-#-# translate crowdin gallery_d_069_e162b1b4:
msgid "[_cedrick_] (Окей, проблема решилась сама собой. По-хорошему нужно донести ее до дома и трахнуть там, но я не знаю, когда она проснется, может и через 5 минут)"
msgstr "[_cedrick_] (Bien, el problema se solucionó solo. Lo mejor que puedo hacer es llevarla a casa y cogerla allí, pero no sé cuando despertará, tal vez en 5 minutos.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:114 #-#-# translate crowdin gallery_d_069_864658b0:
msgid "[_cedrick_] (Видимо придется прямо на машине.. Хм, кстати, она оставила дверь в машину открытой)"
msgstr "[_cedrick_] (Aparentemente tendrá que ir directamente al auto. Hmm, por cierto, dejó la puerta del auto abierta.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:115 #-#-# translate crowdin gallery_d_069_ab549fbc:
msgid "[_centered_] {size=37}СЕДРИК ИССЛЕДУЕТ БАРДАЧОК В МАШИНЕ И НАХОДИТ БАЛАКЛАВУ, ВИКОДИН И НАРУЧНИКИ{/size}"
msgstr "[_centered_] {size=37}CEDRIC EXAMINA LA GUANTERA DEL COCHE Y ENCUENTRA UN PASAMONTAÑAS, VICODIN Y ESPOSAS{/size}"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:117 #-#-# translate crowdin gallery_d_069_f19c3934:
msgid "[_cedrick_] (Наручники - часть полицейского снаряжения. Хм, к тому же под плащом у нее полицейская форма, интересно. Видимо оделась так, чтобы не выделяться в участке)"
msgstr "[_cedrick_] (Las esposas son parte del equipamiento policial. Hmm, además, debajo de la gabardina tiene un uniforme de policía, interesante. Al parecer se vistió para no destacar en la comisaría.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:118 #-#-# translate crowdin gallery_d_069_c5200411:
msgid "[_cedrick_] (Балаклава, видимо, победный трофей.. Или для ролевых игр, кто ее знает..)"
msgstr "[_cedrick_] (El pasamontañas es aparentemente un trofeo de victoria… O para juegos de rol, quién sabe…)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:119 #-#-# translate crowdin gallery_d_069_15a93e1e:
msgid "[_cedrick_] (И самое интересное - викодин.. Полу наркотическое средство от мышечных и головных болей)"
msgstr "[_cedrick_] (Y lo más interesante es el vicodin. Un fármaco semi-narcótico para dolores musculares y de cabeza)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:120 #-#-# translate crowdin gallery_d_069_0b58177a:
msgid "[_cedrick_] (Видимо ей прописали этот препарат после того, как на задании под прикрытием ей прострелили икроножную мышцу)"
msgstr "[_cedrick_] (Aparentemente le recetaron este medicamento después de que le dispararan en el músculo de la pantorrilla durante una misión encubierta.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:121 #-#-# translate crowdin gallery_d_069_d89f178b:
msgid "[_cedrick_] (Хм, но я кажется знаю, что со всем этим делать)"
msgstr "[_cedrick_] (Hmm, pero creo que sé qué hacer con todo esto.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:125 #-#-# translate crowdin gallery_d_069_0d34675b:
msgid "[_cedrick_] (Раз она сама оправдывала огромного змея бессонницей и галлюцинациями, видимо с препаратами она перебарщивает.. Это тоже можно использовать)"
msgstr "[_cedrick_] (Como ella misma atribuyó la enorme serpiente al insomnio y las alucinaciones, parece que se está pasando con las drogas… También puedo aprovecharlo.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:126 #-#-# translate crowdin gallery_d_069_fd747487:
msgid "[_cedrick_] (Хах, надеюсь у викодина нет противопоказаний по смешиванию с магической спермой..)"
msgstr "[_cedrick_] (Ja, espero que el Vicodin no tenga contraindicaciones para mezclar con esperma mágico…)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:133 #-#-# translate crowdin gallery_d_069_e19fddb3:
msgid "[_medina_] Ч-что.. Что происходит!? П-преступник!? Меня что, поймали.."
msgstr "[_medina_] Q-qué… ¿¡Qué está pasando!? ¿¡C-criminal!? ¿Me atraparon…?"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:134 #-#-# translate crowdin gallery_d_069_8aeed126:
msgid "[_medina_] Н-нет.. О боги, меня имеют прямо возле полицейского участка.. Ты что, совсем идиот?"
msgstr "[_medina_] N-no… Oh dioses, me tienen retenido justo al lado de la estación de policía… ¿Eres un completo idiota?"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:135 #-#-# translate crowdin gallery_d_069_bff46f9b:
msgid "[_cedrick_] Хах, что-то не вижу, чтобы нам кто-то мешал"
msgstr "[_cedrick_] Jaja no veo a nadie molestándonos."

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:136 #-#-# translate crowdin gallery_d_069_710f5208:
msgid "[_medina_] К-кто ты!? Ты из синдиката!? Или тебя послала мафия?"
msgstr "[_medina_] ¿¡Q-quién eres tú!? ¿¡Eres del sindicato!? ¿O te envió la mafia?"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:137 #-#-# translate crowdin gallery_d_069_325919bb:
msgid "[_cedrick_] (Боже, у этой женщины столько врагов? Это в какой-то степени даже вызывает уважение..)"
msgstr "[_cedrick_] (Dios, ¿esta mujer tiene tantos enemigos? Incluso inspira respeto hasta cierto punto…)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:138 #-#-# translate crowdin gallery_d_069_68b42e44:
msgid "[_medina_] Д-думаешь, раз сковал меня, значит можешь делать все, что хочешь!?"
msgstr "[_medina_] ¿¡Crees que sólo porque me encadenaste significa que puedes hacer lo que quieras!?"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:139 #-#-# translate crowdin gallery_d_069_8fba72e2:
msgid "[_cedrick_] Именно. Не то что бы ты в состоянии сопротивляться.."
msgstr "[_cedrick_] Exactamente. No es que puedas resistirte…"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:140 #-#-# translate crowdin gallery_d_069_ac38117a:
msgid "[_medina_] (Ч-черт.. Этот засранец прав, у меня слишком мало сил.. Мое тело ослабло, сейчас я уязвима..)"
msgstr "[_medina_] (M-Maldita sea… Este imbécil tiene razón, tengo muy poca fuerza… Mi cuerpo está debilitado, ahora soy vulnerable…)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:141 #-#-# translate crowdin gallery_d_069_768e7073:
msgid "[_medina_] К-кто ты такой?!"
msgstr "[_medina_] ¡¿Q-quién eres tú?!"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:142 #-#-# translate crowdin gallery_d_069_7d6a3226:
msgid "[_cedrick_] Ахах, а сама-то как думаешь? Ты угодила прямо в мою ловушку. Стоило сбросить всех псов на Рика, как город сразу успокоился"
msgstr "[_cedrick_] Ah, ¿qué opinas? Entraste directo a mi trampa. Tan pronto como le arrojaste todos los perros a Rick, la ciudad se calmó inmediatamente."

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:143 #-#-# translate crowdin gallery_d_069_19d9c4dd:
msgid "[_medina_] Ч-что? Что ты несешь.. Рик серийный маньяк.."
msgstr "[_medina_] ¿Q-qué? ¿De qué estás hablando? Rick es un asesino en serie."

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:144 #-#-# translate crowdin gallery_d_069_14fdd35f:
msgid "[_cedrick_] Именно именно.. Продолжай так думать, пока я трахаю тебя и продолжаю терроризировать весь город"
msgstr "[_cedrick_] Exacto… Sigue pensando así mientras te cojo y sigo aterrorizando a toda la ciudad."

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:145 #-#-# translate crowdin gallery_d_069_a5fa5ca2:
msgid "[_medina_] Н-нет.. О чем ты говоришь?"
msgstr "[_medina_] N-no… ¿De qué estás hablando?"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:146 #-#-# translate crowdin gallery_d_069_0bb4e2c7:
msgid "[_cedrick_] Брайан, Алхими, Корнелия.. А теперь и ты в моих руках.. Черт, как же долго я держался.. Хочу прижать тебя к лобовому стеклу"
msgstr "[_cedrick_] Brian, Alchemy, Cornelia… Y ahora tú también estás en mis manos… Maldición, cuánto tiempo me contuve… Quiero apretarte contra el parabrisas."

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:149 #-#-# translate crowdin gallery_d_069_620ff6ce:
msgid "[_cedrick_] Мы так долго вели это дело и ты маячила своей роскошной фигурой от свидетеля к свидетелю. Как же я хотел тебя трахнуть, но не мог.. Пока не нашел того, на кого скинуть обвинения"
msgstr "[_cedrick_] Hemos estado llevando este caso durante tanto tiempo y usted, con su lujosa figura, pasó de testigo en testigo. Cómo quería cogerte, pero no podía… Hasta que encontré a alguien a quien culpar."

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:150 #-#-# translate crowdin gallery_d_069_a7fe03ef:
msgid "[_medina_] Н-нет.. Ааах... н-не может быть.. Ты..."
msgstr "[_medina_] N-no… Aaah… n-no puede ser… Tú…"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:151 #-#-# translate crowdin gallery_d_069_ed230644:
msgid "[_cedrick_] Ну же, давай.. Может хоть сейчас догадаешься?"
msgstr "[_cedrick_] Vamos, vamos… ¿Tal vez puedas adivinarlo ahora?"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:153 #-#-# translate crowdin gallery_d_069_7463eedf:
msgid "[_medina_] М-мактиннен!?"
msgstr "[_medina_] ¿¡M-Maktinen!?"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:154 #-#-# translate crowdin gallery_d_069_0b81fee8:
msgid "[_cedrick_] В точку, дорогуша! Ахах, так было забавно смотреть, как ты ходишь вокруг да около и ищешь маньяка, когда он прямо у тебя перед носом"
msgstr "[_cedrick_] ¡Acertado, cariño! Ahah, fue muy divertido verte andarte por las ramas y buscar a un asesino cuando está justo frente a tus narices."

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:156 #-#-# translate crowdin gallery_d_069_d34ed8dd:
msgid "[_medina_] Ах ты.. Ты... Как ты мог.. Я не верю.."
msgstr "[_medina_] Oh tú… Tú… Cómo pudiste… No lo creo…"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:157 #-#-# translate crowdin gallery_d_069_ee6d5a84:
msgid "[_cedrick_] Веришь или нет - мне плевать. Теперь ты попалась и станешь моей очередной жертвой.."
msgstr "[_cedrick_] Me da igual si me crees. Ahora estás atrapada y serás mi próxima víctima…"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:159 #-#-# translate crowdin gallery_d_069_77d8c9e1:
msgid "[_medina_] Н-нет.. Ааах.. П-прошу, постой.. Мактиннен!"
msgstr "[_medina_] N-no… Aaah… P-por favor espera… ¡Maktinen!"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:161 #-#-# translate crowdin gallery_d_069_f88685ee:
msgid "[_cedrick_] Я кончаю!"
msgstr "[_cedrick_] ¡Me estoy acabando!"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:163 #-#-# translate crowdin gallery_d_069_79a4e600:
msgid "[_medina_] Н-неееет.. Боже.. Я.. я тоже.."
msgstr "[_medina_] N-noooo… Dios… Yo… yo también…"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:164 #-#-# translate crowdin gallery_d_069_afe770d8:
msgid "[_medina_] Я.. Я отключаюсь.."
msgstr "[_medina_] Yo… me estoy desconectando…"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:169 #-#-# translate crowdin gallery_d_069_5ef42803:
msgid "[_cedrick_] (ч-черт, я тоже.. Пора восстановиться с помощью зелья, пока я не отрубился прямо возле полицейского участка)"
msgstr "[_cedrick_] (Maldita sea, yo también… Es hora de recuperarme con una poción antes de desmayarme justo afuera de la estación de policía.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:182 #-#-# translate crowdin gallery_d_069_8a46efbb:
msgid "[_cedrick_] (П-порядок.. Вроде.. Ух.. Для следующего раза надо будет заскочить к Миранде..)"
msgstr "[_cedrick_] (E-está bien… como… Uh… La próxima vez tendré que pasar por casa de Miranda…)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:183 #-#-# translate crowdin gallery_d_069_e0ad4430_3:
msgid "[_medina_] ..."
msgstr "[_medina_] …"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:184 #-#-# translate crowdin gallery_d_069_577eda50:
msgid "[_cedrick_] (Так.. Я сделал что мог.. Вроде бы она теперь будет верить в то, что Мактиннен - это настоящий маньяк. Но что теперь..)"
msgstr "[_cedrick_] (Entonces… hice lo que pude… Parece que ahora ella creerá que Maktinen es el verdadero asesino. Pero, ¿ahora qué?)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:185 #-#-# translate crowdin gallery_d_069_9a64f219:
msgid "[_cedrick_] (Хм.. Надо отнести ее домой и использовать все мое обаяние и актерское мастерство, чтобы убедить ее в том, что я - это подставной подозреваемый. И что мы, очевидно, спим вместе)"
msgstr "[_cedrick_] (Hmm… necesito llevarla a casa y usar todo mi encanto y mis habilidades de actuación para convencerla de que soy un falso sospechoso. Y que obviamente estamos durmiendo juntos.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:186 #-#-# translate crowdin gallery_d_069_f9370546:
msgid "[_cedrick_] (Благо, часть всего можно списать на таблетки.. Кстати, оставлю ка я их при себе на всякий случай)"
msgstr "[_cedrick_] (Afortunadamente, parte de todo se puede atribuir a las pastillas… Por cierto, las llevaré conmigo por si acaso.)"

