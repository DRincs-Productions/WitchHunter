# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:6 #-#-# translate crowdin find_information_about_medina_at_police_station_64ccdda3:
msgid "[_cedrick_] (Есть. Детектив Медина.. Ого, на нее здесь целый архив — это как раз то, что мне нужно)"
msgstr "[_cedrick_] (Sí. Detective Medina… Vaya, hay un archivo completo sobre ella; esto es justo lo que necesito.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:7 #-#-# translate crowdin find_information_about_medina_at_police_station_f906ad1d:
msgid "[_cedrick_] (Так.. Отец был частным детективом.. С отличием закончила полицейскую академию.. Раскрываемость 99%%.. Черт, она крепкий орешек.. Мне нужно копать глубже, чтобы найти ее слабые места)"
msgstr "[_cedrick_] (Entonces… Su padre era detective privado… Se graduó con honores de la academia de policía… Tasa de aprobación del 99%… Maldita sea, es un hueso duro de roer… Necesito profundizar más para encontrar sus puntos débiles.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:8 #-#-# translate crowdin find_information_about_medina_at_police_station_636e318b:
msgid "[_cedrick_] (Участвовала в секретных операциях под прикрытием.. Была подстрелена в икроножную мышцу, но успешно выполнила операцию)"
msgstr "[_cedrick_] (Participó en operaciones secretas encubiertas. Recibió un disparo en el músculo de la pantorrilla, pero completó con éxito la operación.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:9 #-#-# translate crowdin find_information_about_medina_at_police_station_b54e5555:
msgid "[_cedrick_] (Выступала в качестве гаранта безопасности семьи, попавшей под программу защиты свидетелей..)"
msgstr "[_cedrick_] (Actuó como tutor de la seguridad de una familia incluida en el programa de protección de testigos.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:10 #-#-# translate crowdin find_information_about_medina_at_police_station_c84881d5:
msgid "[_cedrick_] (Разработала успешный план по поимке преступника через поимку ложного обвиняемого.. Так, это интересно..)"
msgstr "[_cedrick_] (Desarrolló un plan exitoso para atrapar a un criminal capturando a un acusado falso… Entonces, esto es interesante…)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:11 #-#-# translate crowdin find_information_about_medina_at_police_station_0324ee6d:
msgid "[_cedrick_] (Операция по поимке Убийца оригами. Медина навела полицию на ложный след, чтобы следствие думало, якобы убийца - это один из родителей жертв маньяка)"
msgstr "[_cedrick_] (Operación para capturar al Asesino de Origami. Medina llevó a la policía a seguir una pista falsa para que la investigación pensara que el asesino era uno de los padres de las víctimas del maníaco.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:12 #-#-# translate crowdin find_information_about_medina_at_police_station_384fabc9:
msgid "[_cedrick_] (Этот ход был необходим, поскольку настоящим убийцей был детектив Скотт Шелби, имеющий доступ к ходу расследования полиции)"
msgstr "[_cedrick_] (Este movimiento fue necesario porque el verdadero asesino era el detective Scott Shelby, quien tuvo acceso a la investigación policial.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:13 #-#-# translate crowdin find_information_about_medina_at_police_station_5e8e3dc6:
msgid "[_cedrick_] (Только благодаря ложному обвиняемому, Шелби стал менее осторожен и удалось получить прямые улики его виновности в будущем)"
msgstr "[_cedrick_] (Solo gracias al falso acusado, Shelby se volvió menos cauteloso y fue posible obtener evidencia directa de su culpabilidad en el futuro.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:14 #-#-# translate crowdin find_information_about_medina_at_police_station_6a15afff:
msgid "[_cedrick_] (Ложный обвиняемый.. Настоящий маньяк - это детектив.. Точно.. Я могу убедить ее в том, что все завязанные на мне обвинения - это ее план по ложному обвинению)"
msgstr "[_cedrick_] (Falso acusado… El verdadero maníaco es el detective… Exacto… Puedo convencerla de que todos los cargos relacionados conmigo son su plan para una acusación falsa.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:15 #-#-# translate crowdin find_information_about_medina_at_police_station_dfd7dc5a:
msgid "[_cedrick_] (А настоящим маньяком является Мактиннен.. Поэтому она так осторожна, потому что маньяком является ее же напарник и она должна не подавать виду, что это он)"
msgstr "[_cedrick_] (Y el verdadero maníaco es Maktinen… Por eso tiene tanto cuidado, porque su compañero es el maníaco y no debe dejar ver que es él.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:16 #-#-# translate crowdin find_information_about_medina_at_police_station_84238101:
msgid "[_cedrick_] (Это может сработать, но нужно будет серьезно поработать над следствием. В любом случае других вариантов у меня нет. Осталось лишь узнать ее адрес и наведаться в гости)"
msgstr "[_cedrick_] (Esto puede funcionar, pero será necesario trabajar seriamente en la investigación. En cualquier caso, no tengo otras opciones. Solo queda averiguar su dirección y hacerle una visita.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:17 #-#-# translate crowdin find_information_about_medina_at_police_station_ea462259:
msgid "[_cedrick_] (Хм, та же элитная высотка, в которой живет Корления? Хотя, учитывая успешные дела Медины, это и не удивительно. Номер квартиры есть)"
msgstr "[_cedrick_] (Hmm, ¿el mismo rascacielos de élite en el que vive Cornelia? Aunque, dado el exitoso negocio de Medina, esto no es sorprendente. Hay un número de apartamento.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:19 #-#-# translate crowdin find_information_about_medina_at_police_station_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] …"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:20 #-#-# translate crowdin find_information_about_medina_at_police_station_2a1c82c6:
msgid "[_cedrick_] На всякий случай заодно посмотрю, что есть на Мактиннена.."
msgstr "[_cedrick_] Por si acaso, también miraré lo que tiene Maktinen…"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:25 #-#-# translate crowdin find_information_about_medina_at_police_station_49316299_1:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] …"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:26 #-#-# translate crowdin find_information_about_medina_at_police_station_49316299_2:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] …"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:27 #-#-# translate crowdin find_information_about_medina_at_police_station_49316299_3:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] …"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:28 #-#-# translate crowdin find_information_about_medina_at_police_station_9b170e61:
msgid "[_cedrick_] Хм, в целом ничего особенного.."
msgstr "[_cedrick_] Mmmm, en general nada especial…"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:29 #-#-# translate crowdin find_information_about_medina_at_police_station_33d29b9c:
msgid "[_cedrick_] Хотя вот.."
msgstr "[_cedrick_] Oh, mierda…"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:30 #-#-# translate crowdin find_information_about_medina_at_police_station_f96584f0:
msgid "[_cedrick_] У него есть своя камера хранения? Вернее, целый склад хранения. Зачем он ему?"
msgstr "[_cedrick_] ¿Tiene su propio trastero? O mejor dicho, todo un almacén de almacenamiento. ¿Por qué lo necesita?"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:31 #-#-# translate crowdin find_information_about_medina_at_police_station_8f02bb52:
msgid "[_cedrick_] Тут есть точный адрес. Хм, это может мне пригодиться в будущем, пожалуй запишу"
msgstr "[_cedrick_] Aquí está la dirección exacta. Hmm, esto podría serme útil en el futuro, probablemente lo escribiré."

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:34 #-#-# translate crowdin find_information_about_medina_at_police_station_49316299_4:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] …"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:36 #-#-# translate crowdin find_information_about_medina_at_police_station_5269c57a:
msgid "[_cedrick_] (А это что за папка?)"
msgstr "[_cedrick_] (¿Qué es esa carpeta?)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:43 #-#-# translate crowdin find_information_about_medina_at_police_station_c9a4dfd6:
msgid "[_cedrick_] (Воу, личная папка Гордона с компроматом?)"
msgstr "[_cedrick_] (Vaya, ¿la carpeta incriminatoria personal de Gordon?)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:44 #-#-# translate crowdin find_information_about_medina_at_police_station_0373e8e4:
msgid "[_cedrick_] (С-стоп.. Это что, мать Тарани на фото? Она же, вроде как, главный судья в этом городе..)"
msgstr "[_cedrick_] (E-espera… ¿Es la madre de Taranee la de la foto? Ella es como la jueza principal de esta ciudad…)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:48 #-#-# translate crowdin find_information_about_medina_at_police_station_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:56 #-#-# translate crowdin gallery_d_068_df7812f3:
msgid "[_cedrick_] (Так так так.. Закрытие дела о махинациях ее мужа.. Хах, стопка заявлений на ее мужа была прямо у Гордона на столе в момент, когда она ему сосала)"
msgstr "[_cedrick_] (Muy bien… Cerrando el caso del fraude de su marido… Ja, un montón de declaraciones contra su marido estaba justo en el escritorio de Gordon en el momento en que ella se la estaba mamando.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:57 #-#-# translate crowdin gallery_d_068_00a9375a:
msgid "[_cedrick_] (Черт, а судья то со скелетами в шкафу. Ну, она хотя бы не брезгует сосать под столом, в отличие от своей дочурки. Та была согласна только на работу грудью)"
msgstr "[_cedrick_] (Maldita sea, la jueza tiene esqueletos en su armario. Bueno, al menos ella no desdeña chupar debajo de la mesa, a diferencia de su hija. Ella solo aceptó trabajar los senos.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:58 #-#-# translate crowdin gallery_d_068_277eb69d:
msgid "[_cedrick_] (Интересно, кто сосет лучше мама Вилл, мама Хай Лин или же мама Тарани? Возможно, мне еще удастся проверить. Но я здесь не за этим. Дела прежде всего)"
msgstr "[_cedrick_] (Me pregunto quién la chupa mejor: la mamá de Will, la mamá de Hay Lin o la de Taranee. Tal vez aún pueda comprobarlo. Pero no vine por eso. El trabajo es lo primero.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:59 #-#-# translate crowdin gallery_d_068_d42ae797:
msgid "[_cedrick_] (Думаю мне это тоже пригодится, сохраню себе на телефон. Я бы еще покопался в его папках, уверен там много интересного, но я уже играюсь с огнем, пора уходить)"
msgstr "[_cedrick_] (Creo que esto también me servirá; lo guardaré en el teléfono. Seguiría hurgando en sus carpetas, seguro que hay muchas cosas interesantes, pero ya estoy jugando con fuego. Es hora de irme.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:64 #-#-# translate crowdin gallery_d_068_ddb35c30:
msgid "[_centered_] {size=37}СЕДРИК УХОДИТ ИЗ ПОЛИЦЕЙСКОГО УЧАСТКА{/size}"
msgstr "[_centered_] {size=37}CEDRIC SALE DE LA COMISARÍA{/size}"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:68 #-#-# translate crowdin gallery_d_069_ad12e0c3:
msgid "[_cedrick_] (Стоп, кто это там идет к машине на парковке.. Это что.. Медина!?)"
msgstr "[_cedrick_] (Espera, ¿quién es ese que va hacia el auto en el estacionamiento? ¿¡Esa es… Medina!?)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:69 #-#-# translate crowdin gallery_d_069_4b66f2d7:
msgid "[_cedrick_] (Какого черта она тут делает.. Хотя, с другой стороны, учитывая ее профессионализм и раскрываемость, не удивительно, что она работает до поздней ночи)"
msgstr "[_cedrick_] (¿Qué carajos hace aquí? Aunque, por otro lado, dada su profesionalidad y apertura, no es de extrañar que trabaje hasta altas horas de la noche.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:70 #-#-# translate crowdin gallery_d_069_5c15a6af:
msgid "[_cedrick_] (Хах, уверен, Медина работала за десятерых, пока Гордон трахал заключенную в костюме, хорошо старик устроился)"
msgstr "[_cedrick_] (Ja, estoy seguro de que Medina trabajó el doble mientras Gordon se cogía a una prisionera disfrazada, al viejo le fue bien.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:71 #-#-# translate crowdin gallery_d_069_05a703ca:
msgid "[_cedrick_] (Что ж, мне это только на руку. Учитывая, сколько она работала, вряд ли она окажет мне особое сопротивление)"
msgstr "[_cedrick_] (Bueno, eso es bueno para mí. Teniendo en cuenta lo duro que ha trabajado, no creo que me ofrezca mucha resistencia)."

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:72 #-#-# translate crowdin gallery_d_069_cd2e7280:
msgid "[_cedrick_] (Хм, нет, Седрик, нет.. Ты уже достаточное время был самоуверенным. Настало время делать все быстро и четко)"
msgstr "[_cedrick_] (Hmm, no, Cedric, no… Has estado demasiado confiado durante bastante tiempo. Es hora de hacer todo de forma rápida y clara.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:73 #-#-# translate crowdin gallery_d_069_188251a1:
msgid "[_cedrick_] (Ее машина в слепой зоне камер.. Приму форму змея и нападу на нее сзади, схватив своим хвостом. Это самый правильный вариант)"
msgstr "[_cedrick_] (Su auto está en el punto ciego de las cámaras. Tomaré la forma de una serpiente y la atacaré por detrás, agarrándola con mi cola. Esta es la opción más correcta.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:74 #-#-# translate crowdin gallery_d_069_2116cd50:
msgid "[_cedrick_] (Главное не переломать ее всю, я не так уж и часто хватаю людей хвостом так, чтобы они оставались живы, практики у меня не много)"
msgstr "[_cedrick_] (Lo principal es no romperlo todo, no suelo agarrar a la gente con la cola para que sigan con vida, no tengo mucha práctica.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:75 #-#-# translate crowdin gallery_d_069_0aa4ff75:
msgid "[_cedrick_] (Но, в любом случае..)"
msgstr "[_cedrick_] (Pero, de todos modos…)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:80 #-#-# translate crowdin gallery_d_069_951a6c19:
msgid "[_centered_] {size=37}Седрик принимает форму змея и быстро хватает Медину{/size}"
msgstr "[_centered_] {size=37}Cedric adopta la forma de una serpiente y rápidamente agarra a Medina{/size}"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:85 #-#-# translate crowdin gallery_d_069_3dd3f618:
msgid "[_medina_] Ч-что!? Оооо боже, нет нет нет... ч-что ты за чудовище!?"
msgstr "[_medina_] ¿¡Q-qué!? Ooooh Dios, no, no, no… ¿¡Q-qué clase de monstruo eres!?"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:86 #-#-# translate crowdin gallery_d_069_553e534d:
msgid "[_medina_] Я-я что, так мало спала, что у меня начались галлюцинации.. Иии все тело немеет.. Черт.."
msgstr "[_medina_]Dormí tan poco que comencé a alucinar… Y todo mi cuerpo se está entumeciendo… Maldita sea…"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:89 #-#-# translate crowdin gallery_d_069_f83e24e7:
msgid "[_cedrick_] Хватит орать, женщина. Нам ведь ни к чему свидетели"
msgstr "[_cedrick_] Deja de gritar, mujer. No necesitamos testigos."

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:90 #-#-# translate crowdin gallery_d_069_36cb8105:
msgid "[_medina_] (Г-говорящий.. Говорящий монстр.. Черт, он слишком реален.. Я чувствую его своим телом и.. боже, у меня во рту)"
msgstr "[_medina_] (H-habla… Un monstruo parlante… Mierda, es demasiado real… Lo siento con todo el cuerpo y… Dios, lo tengo en la boca.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:91 #-#-# translate crowdin gallery_d_069_1d46a941:
msgid "[_cedrick_] (Так, окей, связать то я ее связал, но что дальше делать то.. Не могу же я ее прямо в форме змея трахать..)"
msgstr "[_cedrick_] (Entonces, está bien, la até, pero qué hacer a continuación… No puedo cogerla directamente en forma de serpiente…)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:92 #-#-# translate crowdin gallery_d_069_e9b61d59:
msgid "[_cedrick_] Змеиным членом я ее просто порву.. Такие размеры в человеческой форме способна выдерживать только Миранда и то она не человек"
msgstr "[_cedrick_] Simplemente la destrozaré con una verga de serpiente… Sólo Miranda puede soportar tales dimensiones en forma humana, y aun así no es humana."

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:94 #-#-# translate crowdin gallery_d_069_5680b44e:
msgid "[_medina_] (Нет, я не могу просто так сдаваться. Будь это галлюцинация или нет, он явно перекрывает мои дыхательные пути.. Я должна что-то сделать!)"
msgstr "[_medina_] (No, no puedo simplemente rendirme. Ya sea que sea una alucinación o no, claramente está bloqueando mis vías respiratorias… ¡Tengo que hacer algo!)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:95 #-#-# translate crowdin gallery_d_069_0908557b:
msgid "[_cedrick_] (Хм, но если я прямо сейчас приму человеческую форму, она меня увидит и тогда я буду в ее сознании уже не просто преступником, а еще и монстром. С этим уже не разберешься..)"
msgstr "[_cedrick_] (Hmm, pero si tomo una forma humana ahora mismo, ella me verá y entonces en su mente ya no seré solo un criminal, sino también un monstruo. No puedes entenderlo…)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:97 #-#-# translate crowdin gallery_d_069_c1e00b2e:
msgid "[_medina_] (Получай, чертов змей)"
msgstr "[_medina_] (Tómalo, maldita serpiente.)"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:99 #-#-# translate crowdin gallery_d_069_35162a68:
msgid "[_cedrick_] Ауч! Ах ты.."
msgstr "[_cedrick_] ¡Ay! Serás…"

# game/scripts/quests/dealWithDetectives/find_information_about_medina_at_police_station.rpy:101 #-#-# translate crowdin gallery_d_069_cc5bccc3:
msgid "[_medina_] Ммвввмм..."
msgstr "[_medina_] Mmmmm…"

