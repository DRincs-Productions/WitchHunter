# game/scripts/quests/irma/fuckIrma.rpy:123 #-#-# translate crowdin gallery_d_007_63168503:
msgid "[_cedrick_] Ну как вы тут? Все сделали?"
msgstr "[_cedrick_] ¿Cómo van por aquí? ¿Ya hicieron todo?"

# game/scripts/quests/irma/fuckIrma.rpy:126 #-#-# translate crowdin gallery_d_007_0bff6308:
msgid "[_irma_] Я как раз закончила свою часть! Можно мне уже пойти домой?"
msgstr "[_irma_] ¡Ya terminé mi parte! ¿Puedo irme ya a casa?"

# game/scripts/quests/irma/fuckIrma.rpy:130 #-#-# translate crowdin gallery_d_007_89734f8f:
msgid "[_cedrick_] Так, посмотрим... Адам де ла Аль.. Вершинин.. Шекспир.."
