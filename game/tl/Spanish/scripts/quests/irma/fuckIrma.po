# game/scripts/quests/irma/fuckIrma.rpy:161 #-#-# translate crowdin gallery_d_007_52680fbe:
msgid "[_cedrick_] Я знаю, что не твое, это ограниченное издание.. Я приобрел эту статуэтку неделю назад!"
msgstr "[_cedrick_] Sé que no es tuyo, es una edición limitada… ¡Conseguí esta estatua hace una semana!"

# game/scripts/quests/irma/fuckIrma.rpy:162 #-#-# translate crowdin gallery_d_007_a98b1c6c:
msgid "[_cedrick_] Значит, моя интуиция не подвела меня.. Ты решила обокрасть меня..."
