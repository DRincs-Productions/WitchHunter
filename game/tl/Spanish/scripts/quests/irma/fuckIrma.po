msgstr "[_elion_] ¿Qué está haciendo ella aquí?"

# game/scripts/quests/irma/fuckIrma.rpy:21 #-#-# translate crowdin fuckIrma_386c7c61:
msgid "[_cedrick_sprite_] Сегодня Ирма с Мартином будут помогать нам по магазину в рамках школьной программы день служения обществу."
msgstr "[_cedrick_sprite_] Hoy Irma y Martin nos ayudarán en la tienda como parte del programa del día de servicio comunitario de la escuela."

# game/scripts/quests/irma/fuckIrma.rpy:24 #-#-# translate crowdin fuckIrma_4400bc3a:
msgid "[_elion_] Почему именно она!!? Пришла, чтобы еще надо мной поиздеваться?? Посплетничать за спиной?"
msgstr "[_elion_] ¡¿Por qué ella?! ¿Vino a burlarse de mí otra vez? ¿A chismear a mis espaldas?"

# game/scripts/quests/irma/fuckIrma.rpy:30 #-#-# translate crowdin fuckIrma_8530c36e:
msgid "[_irma_] Я же не виновата, что ты пытаешься переспать с каждым вторым парнем в школе..."
