# game/scripts/quests/irma/fuckIrma.rpy:49 #-#-# translate crowdin fuckIrma_ef611bf4:
msgid "[_martin_] Оу это правда? Может мы с тобой как нибудь..."
msgstr "[_martin_] Ah, ¿es cierto? Quizás tú y yo podríamos…"

# game/scripts/quests/irma/fuckIrma.rpy:53 #-#-# translate crowdin fuckIrma_7710797f:
