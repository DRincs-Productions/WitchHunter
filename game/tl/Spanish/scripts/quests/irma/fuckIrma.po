msgstr "[_elion_] ¡Esto no es verdad!!…"

# game/scripts/quests/irma/fuckIrma.rpy:39 #-#-# translate crowdin fuckIrma_0e8e5db0:
msgid "[_martin_] Остыыыньте, девчооонки.. Нам нужно сделать глубокий вдох и успокоиться..."
