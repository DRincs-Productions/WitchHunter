msgid "Подготовка стражниц завесы"
msgstr "Preparando a las Guardianas del Velo"

# game/scripts/core/quests/QuestTrainingOfGuards.rpy:26
msgid "Обсудить план с Мирандой и Булджем в лаборатории Миранды"
msgstr "Discute el plan con Miranda y Bulj en el laboratorio de Miranda"

# game/scripts/core/quests/QuestTrainingOfGuards.rpy:26
msgid "Отправится к Фобосу в тронный зал"
msgstr "Ve con Fobos en la sala del trono"

# game/scripts/core/quests/QuestTrainingOfGuards.rpy:26
msgid "Проверить Вилл в темнице"
msgstr "Echa un vistazo a Will en el calabozo"

# game/scripts/core/quests/QuestTrainingOfGuards.rpy:26
msgid "Вернуться к Миранде"
msgstr "Regresa con Miranda"

# game/scripts/core/quests/QuestTrainingOfGuards.rpy:26
msgid "Заглянуть в темницу к Ирме"
msgstr "Mira dentro del calabozo de Irma"

# game/scripts/core/quests/QuestTrainingOfGuards.rpy:26
msgid "Снова отправится к Фобосу в тронный зал"
msgstr "Ve con Fobos nuevamente en la sala del trono"

# game/scripts/core/quests/QuestTrainingOfGuards.rpy:26
msgid "Проверить Ирму и Тарани в казармах"
msgstr "Mira a Irma y Taranee en el calabozo"

# game/scripts/core/quests/QuestTrainingOfGuards.rpy:26
msgid "Навестить Корнелию и Хай Лин в борделе"
msgstr "Visita a Cornelia y Hay Lin en el burdel"

# game/scripts/core/quests/QuestTrainingOfGuards.rpy:26
msgid "Явиться к Фобосу"
msgstr "Ve con Fobos"

# game/scripts/core/quests/QuestTrainingOfGuards.rpy:26
msgid "Вернуться в бордель"
msgstr "Regresa al burdel"

# game/scripts/core/quests/QuestTrainingOfGuards.rpy:26
msgid "Собрать стражниц в борделе"
msgstr "Reúne a las Guardianas en el burdel"

