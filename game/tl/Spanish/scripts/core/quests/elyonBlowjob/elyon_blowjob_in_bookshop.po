# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:77 #-#-# translate crowdin gallery_d_052_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:81 #-#-# translate crowdin gallery_d_052_a5edb1e0:
msgid "[_cedrick_] Уффф, да, Элион, отлично.."
msgstr "[_cedrick_] Ufff, sí, Elyon, muy bien..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:82 #-#-# translate crowdin gallery_d_052_b3c5af5c:
msgid "[_elion_] Р-рик, тебе нравится? Я все правильно делаю?"
msgstr "[_elion_] ¿T-te gusta, Rick? ¿Lo estoy haciendo bien?"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:83 #-#-# translate crowdin gallery_d_052_fca8030a:
msgid "[_cedrick_] Д-да, продолжай. Ты хорошо работаешь губками.."
msgstr "[_cedrick_] S-sí, continúa. Sabes usar muy bien esos labios..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:84 #-#-# translate crowdin gallery_d_052_3a3ede1a:
msgid "[_elion_] В-вдруг нас кто-то увидит.."
