# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:96 #-#-# translate crowdin gallery_d_052_d0d60e84:
msgid "[_cedrick_] Оооххх, как тепло.."
msgstr "[_cedrick_] Ooohhhhh, que caliente.."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:97 #-#-# translate crowdin gallery_d_052_cb98770b:
msgid "[_elion_] (Не могу поверить, Рик практически трахает меня в рот..)"
