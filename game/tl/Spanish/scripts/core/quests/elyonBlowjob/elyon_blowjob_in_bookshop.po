# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:63 #-#-# translate crowdin gallery_d_052_0b79aaff:
msgid "[_cedrick_] Прямо сейчас"
msgstr "[_cedrick_] Ahora"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:66 #-#-# translate crowdin gallery_d_052_63aa7bcb:
msgid "[_elion_] Ч-что? Прямо посреди дня, когда в любой момент могут зайти посетители?"
msgstr "[_elion_] ¿Q-qué? ¿A mitad del día, cuando los visitantes podrían llegar en cualquier momento?"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:67 #-#-# translate crowdin gallery_d_052_1a2d26e2:
msgid "[_cedrick_] Именно так. Тебя что-то смущает, ты же минуту назад выражала полную готовность"
msgstr "[_cedrick_] Así es ¿Qué pasa? ¿No estabas tan ansiosa hace apenas un minuto?"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:70 #-#-# translate crowdin gallery_d_052_b22659f0:
msgid "[_elion_] Эм, н-ну.."
