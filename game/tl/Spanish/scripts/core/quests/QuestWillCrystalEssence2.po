msgid "Кристаллическая эссенция для Вилл. Часть II"
msgstr "Esencia de cristal para Villas. Parte II"

# game/scripts/core/quests/QuestWillCrystalEssence2.rpy:23
msgid "Проведать Элион в книжном магазине"
msgstr "Visita a Elyon en la librería"

# game/scripts/core/quests/QuestWillCrystalEssence2.rpy:23
msgid "Прийти к Сьюзан на особый завтрак"
msgstr "Ve con Susan a disfrutar de un desayuno especial"

# game/scripts/core/quests/QuestWillCrystalEssence2.rpy:23
msgid "Купить купальные костюмы себе и Сьюзан"
msgstr "Compra trajes de baño para ti y para Susan"

# game/scripts/core/quests/QuestWillCrystalEssence2.rpy:23
msgid "Прийти домой к семье Вендомов с купальными костюмами"
msgstr "Llega a la casa de la familia Vendome en traje de baño"

# game/scripts/core/quests/QuestWillCrystalEssence2.rpy:23
msgid "Ответить на сообщение Сьюзан в телефоне"
msgstr "Responde al mensaje telefónico de Susan"

# game/scripts/core/quests/QuestWillCrystalEssence2.rpy:23
msgid "Купить ингредиенты для грудки с вишневым соусом"
msgstr "Comprar ingredientes para la pechuga con salsa de cerezas"

# game/scripts/core/quests/QuestWillCrystalEssence2.rpy:23
msgid "Принести продукты для ужина"
msgstr "Lleva comida para la cena"

