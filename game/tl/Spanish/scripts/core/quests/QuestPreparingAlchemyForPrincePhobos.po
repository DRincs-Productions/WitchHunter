msgid "Подготовка Алхими для князя Фобоса"
msgstr "Preparación de Alchemy para el Príncipe Fobos"

# game/scripts/core/quests/QuestPreparingAlchemyForPrincePhobos.rpy:24
msgid "Проверить Алхими в темнице"
msgstr "Echa un vistazo a la Alchemy en la mazmorra"

# game/scripts/core/quests/QuestPreparingAlchemyForPrincePhobos.rpy:24
msgid "Сообщить Миранде о поручении князя Фобоса"
msgstr "Informar a Miranda sobre la orden del Príncipe Fobos"

# game/scripts/core/quests/QuestPreparingAlchemyForPrincePhobos.rpy:24
msgid "Добыть 10 желез морпионов"
msgstr "Consigue 10 glándulas de Morpiones"

# game/scripts/core/quests/QuestPreparingAlchemyForPrincePhobos.rpy:24
msgid "Отдать 10 желез морпионов миранде"
msgstr "Dale 10 glándulas de Morpiones a Miranda"

# game/scripts/core/quests/QuestPreparingAlchemyForPrincePhobos.rpy:24
msgid "Проверить как там Алхими в борделе"
msgstr "Mira cómo le va a Alchemy en el burdel"

# game/scripts/core/quests/QuestPreparingAlchemyForPrincePhobos.rpy:24
msgid "Проверить готов ли сок из желез морпионов у миранды"
msgstr "Comprueba si el jugo de la glándula Morpiones de Miranda está listo"

# game/scripts/core/quests/QuestPreparingAlchemyForPrincePhobos.rpy:24
msgid "Убить королеву морпионов и добыть с нее кристаллическую эссенцию"
msgstr "Mata a la Reina Morpiones y consigue su Esencia de Cristal"

# game/scripts/core/quests/QuestPreparingAlchemyForPrincePhobos.rpy:24
msgid "Принести Кристаллическую эссенцию королевы морпионов Миранде"
msgstr "Llévale la esencia cristalina de la Reina Morpiones a Miranda"

# game/scripts/core/quests/QuestPreparingAlchemyForPrincePhobos.rpy:24
msgid "Забрать Алхими из борделя"
msgstr "Recoge a Alchemy del burdel"

