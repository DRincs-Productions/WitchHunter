msgid "Форма служанки для Элион"
msgstr "Uniforme de sirvienta para Elyon"

# game/scripts/core/quests/QuestTheMaidsUniformForEyion.rpy:16
msgid "Заказать форму служанки для Элион с помощью телефона"
msgstr "Solicite un uniforme de sirvienta para Elyon por teléfono"

# game/scripts/core/quests/QuestTheMaidsUniformForEyion.rpy:16
msgid "Дождаться посылки с формой служанки"
msgstr "Espera el paquete con el uniforme de sirvienta"

# game/scripts/core/quests/QuestTheMaidsUniformForEyion.rpy:16
msgid "Попросить Элион протереть пыль в форме служанки"
msgstr "Pídele a Elyon que limpie el polvo con uniforme de sirvienta"

# game/scripts/core/quests/QuestTheMaidsUniformForEyion.rpy:16
msgid "Попросить Элион провести публичные чтения в форме служанки"
msgstr "Pídale a Elyon que realice lecturas públicas con el uniforme de sirvienta"

