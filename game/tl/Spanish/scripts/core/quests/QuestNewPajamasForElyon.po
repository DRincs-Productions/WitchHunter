msgid "Пижама для Элион"
msgstr "Pijamas para Elián"

# game/scripts/core/quests/QuestNewPajamasForElyon.rpy:16
msgid "Заказать пижаму для Элион с помощью телефона"
msgstr "Encargar pijamas para Elián por teléfono"

# game/scripts/core/quests/QuestNewPajamasForElyon.rpy:16
msgid "Дождаться посылки с пижамой"
msgstr "Espera el paquete con pijama"

# game/scripts/core/quests/QuestNewPajamasForElyon.rpy:16
msgid "Попросить Элион протереть пыль в пижаме"
msgstr "Pídele a Elián que limpie el polvo en pijama"

# game/scripts/core/quests/QuestNewPajamasForElyon.rpy:16
msgid "Попросить Элион провести публичные чтения в пижаме"
msgstr "Pide a Elián que realice lecturas públicas en pijamas"

