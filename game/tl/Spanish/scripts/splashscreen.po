# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/splashscreen.rpy:85 #-#-# translate crowdin splashscreen_f3db2f9c:
msgid "[_attention_] {size=80}{color=#f00}ВНИМАНИЕ!{/color}{/size}\n"
"{size=40}ЭТА ВИДЕОИГРА СОДЕРЖИТ КОНТЕНТ ДЛЯ ВЗРОСЛЫХ.\n"
"ИГРА СДЕЛАНА ДЛЯ СОВЕРШЕННОЛЕТНИХ\n"
"И СОДЕРЖИТ В СЕБЕ ИЗОБРАЖЕНИЯ И МАТЕРИАЛЫ,\n"
"КОТОРЫЕ НЕКОТОРЫЕ МОГУТ СЧЕСТЬ ОСКОРБИТЕЛЬНЫМИ.\n"
"ЕСЛИ ВАМ НЕ ИСПОЛНИЛОСЬ 18 ЛЕТ,\n"
"ЕСЛИ ТАКОЙ МАТЕРИАЛ ОСКОРБЛЯЕТ ВАС,\n"
"ИЛИ ЕСЛИ ОН ЯВЛЯЕТСЯ НЕЗАКОННЫМ В ВАШЕЙ СТРАНЕ,\n"
"ТО ПОЖАЛУЙСТА, ЗАКРОЙТЕ ИГРУ.\n"
"ИМЕНА, ПЕРСОНАЖИ, МЕСТА И СОБЫТИЯ ЯВЛЯЮТСЯ\n"
"ЛИБО ПЛОДОМ ВООБРОЖЕНИЯ АВТОРА,\n"
"ЛИБО ИСПОЛЬЗУЮТСЯ В ВЫМЫШЛЕННОМ ВИДЕ.\n"
"ЛЮБОЕ СХОДСТВО С РЕАЛЬНЫМИ ЛЮДЬМИ, ЖИВЫМИ ИЛИ МЕРТВЫМИ,\n"
"ИЛИ РЕАЛЬНЫМИ СОБЫТИЯМИ — ЧИСТОЕ СОВПАДЕНИЕ.\n"
"ВСЕМ ПЕРСОНАЖАМ В ИГРЕ НЕ МЕНЕЕ 18 ЛЕТ.\n"
"ВАМ УЖЕ ИСПОЛНИЛОСЬ 18 ЛЕТ?\n"
"{/size}"
msgstr "[_attention_] {size=80}{color=#f00}¡ATENCIÓN!{/color}{/size}\n"
"{size=40}ESTE VÍDEO CONTIENE CONTENIDO PARA ADULTOS.\n"
"EL JUEGO ESTÁ HECHO PARA ADULTOS\n"
"Y CONTIENE IMÁGENES Y MATERIALES,\n"
"QUE PUEDE SER CONSIDERADO INSUFICIENTE.\n"
"SI NO TIENES 18 AÑOS,\n"
"SI TAL MATERIAL TE INSULTA,\n"
"O SI ES ILEGAL EN SU PAÍS,\n"
"POR FAVOR, CIERRA EL JUEGO.\n"
"LOS NOMBRES, PERSONAJES, LUGARES Y EVENTOS SON\n"
"O EL FRUTO DEL FRUTO DEL AUTOR,\n"
"O UTILIZADO EN LA FICCIÓN.\n"
"CUALQUIER SIMILITUD CON LA GENTE REAL, VIVA O MUERTA,\n"
"O LOS EVENTOS REALES SON UNA PURA COINCIDENCIA.\n"
"TODOS LOS PERSONAJES DEL JUEGO TIENEN AL MENOS 18 AÑOS.\n"
"¿HAS TENIDO 18 AÑOS?{/size}"

