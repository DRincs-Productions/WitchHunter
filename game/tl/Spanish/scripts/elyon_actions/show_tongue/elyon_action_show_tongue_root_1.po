# TODO: Translation updated at 2023-07-25 15:55 #|#|# # game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:5 #-#-# translate crowdin elyon_action_show_tongue_root_1_4a6d3f35:
msgid "[_cedrick_] Отлично, тогда начнем с малого. Покажи мне свой язык"
msgstr "[_cedrick_] Genial, entonces comencemos poco a poco. Muéstrame tu lengua."

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:8 #-#-# translate crowdin elyon_action_show_tongue_root_1_434ca684:
msgid "[_elion_] Ч-что?"
msgstr "[_elion_] ¿Q-qué?"

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:9 #-#-# translate crowdin elyon_action_show_tongue_root_1_1e745308:
msgid "[_cedrick_] Просто открой рот и высуни его. Ты же знаешь, как это делается, давай"
msgstr "[_cedrick_] Simplemente abre la boca y sácala. Ya sabes cómo se hace, vamos."

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:13 #-#-# translate crowdin elyon_action_show_tongue_root_1_cd881c16:
msgid "[_elion_] Ф-фот тах?"
msgstr "[_elion_] ¿Así?"

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:14 #-#-# translate crowdin elyon_action_show_tongue_root_1_e4579c01:
msgid "[_cedrick_] Ага, именно так, отлично"
msgstr "[_cedrick_] Sí, así es, genial."

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:15 #-#-# translate crowdin elyon_action_show_tongue_root_1_d456f576:
msgid "[_cedrick_] (Хм, какой маленький все же у нее ротик. Даже не уверен, что мой член в нем полностью поместится)"
msgstr "[_cedrick_] (Hmm, qué boca tan pequeña tiene. Ni siquiera estoy seguro de que mi pene quepa completamente en ella.)"

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:16 #-#-# translate crowdin elyon_action_show_tongue_root_1_a5708f78:
msgid "[_elion_] К-кхак долхо мне это делать?"
msgstr "[_elion_] ¿Cuánto tiempo me llevará hacer esto?"

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:21 #-#-# translate crowdin elyon_action_open_her_mouth_wider_1_e3df0545:
msgid "[_cedrick_] Хорошо выходит для первого раза, но давай я тебе помогу"
msgstr "[_cedrick_] Eso está bien para una primera vez, pero déjame ayudarte."

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:24 #-#-# translate crowdin elyon_action_open_her_mouth_wider_1_f869d0f2:
msgid "[_elion_] Ф-фто ты делаешь, Рик..."
msgstr "[_elion_] ¿Q-qué estás haciendo, Rick...?"

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:25 #-#-# translate crowdin elyon_action_open_her_mouth_wider_1_3871f881:
msgid "[_cedrick_] Просто немного помогаю тебе"
msgstr "[_cedrick_] Solo te ayudo un poco."

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:28 #-#-# translate crowdin elyon_action_open_her_mouth_wider_1_f2052b7d:
msgid "[_elion_] (Э-то так смущающе.. Он без спросу просто вторгся в мой рот своими руками...)"
msgstr "[_elion_] (Esto es tan vergonzoso... Simplemente invadió mi boca con sus manos sin preguntar...)"

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:29 #-#-# translate crowdin elyon_action_open_her_mouth_wider_1_e6213cc5:
msgid "[_cedrick_] Знаешь, на самом деле многих мужчин возбуждает, когда девушки таким образом высовывают язык"
msgstr "[_cedrick_] Sabes, de hecho, muchos hombres se excitan cuando las chicas sacan la lengua así."

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:32 #-#-# translate crowdin elyon_action_open_her_mouth_wider_1_ea17943e:
msgid "[_elion_] П-прафда?"
msgstr "[_elion_] ¿D-de verdad?"

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:33 #-#-# translate crowdin elyon_action_open_her_mouth_wider_1_764e5c50:
msgid "[_cedrick_] Ага, кажется в японских черно-белых комиксах это называется ахегао"
msgstr "[_cedrick_] Sí, creo que en los cómics japoneses en blanco y negro se llama ahegao."

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:34 #-#-# translate crowdin elyon_action_open_her_mouth_wider_1_18b5721e:
msgid "[_elion_] Как интерефно..."
msgstr "[_elion_] Qué interesante..."

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:40 #-#-# translate crowdin elyon_action_show_tongue_enough_1_b67c885d:
msgid "[_cedrick_] Что ж, думаю для первого раза достаточно"
msgstr "[_cedrick_] Bueno, creo que es suficiente para tu primera vez."

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:43 #-#-# translate crowdin elyon_action_show_tongue_enough_1_fb0fb4e0:
msgid "[_elion_] Ф-фух.."
msgstr "[_elion_] Uf..."

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:44 #-#-# translate crowdin elyon_action_show_tongue_enough_1_df2fcabe:
msgid "[_cedrick_] Как ощущение?"
msgstr "[_cedrick_] ¿Cómo te sientes?"

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:47 #-#-# translate crowdin elyon_action_show_tongue_enough_1_4d076862:
msgid "[_elion_] Это было очень смущающе, Рик.."
msgstr ""

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:48 #-#-# translate crowdin elyon_action_show_tongue_enough_1_ca3e767d:
msgid "[_cedrick_] Но тебе ведь стало легче? Как себя чувствуешь?"
msgstr ""

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:51 #-#-# translate crowdin elyon_action_show_tongue_enough_1_0d8dced8:
msgid "[_elion_] Я, мм.. Думаю да, кажется.. Кажется мне стало чуточку лучше"
msgstr ""

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:52 #-#-# translate crowdin elyon_action_show_tongue_enough_1_f73211da:
msgid "[_elion_] (Кажется от этого я только больше возбудилась.. Но, вдруг в этом и заключается часть помощи Рика. Пожалуй, просто ему доверюсь)"
msgstr ""

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:53 #-#-# translate crowdin elyon_action_show_tongue_enough_1_36c05596:
msgid "[_cedrick_] Отлично, рад, что помог"
msgstr ""

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_1.rpy:54 #-#-# translate crowdin elyon_action_show_tongue_enough_1_d231aab0:
msgid "[_elion_] И-и я, Рик, спасибо"
msgstr ""

