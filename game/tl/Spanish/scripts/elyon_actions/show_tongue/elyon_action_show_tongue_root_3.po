# TODO: Translation updated at 2023-07-25 15:55 #|#|# # game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_3.rpy:5 #-#-# translate crowdin elyon_action_show_tongue_root_3_443fd13f:
msgid "[_cedrick_] Элион, не покажешь мне свой язычок?"
msgstr "[_cedrick_] Elyon, ¿no me mostrarás tu lengua?"

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_3.rpy:8 #-#-# translate crowdin elyon_action_show_tongue_root_3_781728d3:
msgid "[_elion_] Ох, Рик, конечно. "
msgstr "[_elion_] Ah, Rick, por supuesto."

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_3.rpy:12 #-#-# translate crowdin elyon_action_show_tongue_root_3_09d5fccb:
msgid "[_elion_] В-вот.."
msgstr "[_elion_] A-aquí…"

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_3.rpy:13 #-#-# translate crowdin elyon_action_show_tongue_root_3_ea344ce6:
msgid "[_cedrick_] Прелестно"
msgstr "[_cedrick_] Lindo."

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_3.rpy:14 #-#-# translate crowdin elyon_action_show_tongue_root_3_ea6c7389:
msgid "[_cedrick_] (Она уже начинает напоминать дрессированного питомца)"
msgstr "[_cedrick_] (Ella empieza a parecerse a una mascota entrenada.)"

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_3.rpy:17 #-#-# translate crowdin elyon_action_show_tongue_root_3_434c3184:
msgid "[_elion_] Н-ну фто?"
msgstr "[_elion_] ¿Q-qué?"

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_3.rpy:23 #-#-# translate crowdin elyon_action_open_her_mouth_wider_3_f799f2fc:
msgid "[_cedrick_] Все же, лучше открыть его слегка по шире"
msgstr "[_cedrick_] Aún así, es mejor abrirlo un poco más."

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_3.rpy:27 #-#-# translate crowdin elyon_action_open_her_mouth_wider_3_e940261a:
msgid "[_elion_] Ф-фот так?"
msgstr "[_elion_] ¿Así?"

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_3.rpy:28 #-#-# translate crowdin elyon_action_open_her_mouth_wider_3_abcdb328:
msgid "[_cedrick_] Что, нравится?"
msgstr "[_cedrick_] ¿Qué, te gusta?"

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_3.rpy:30 #-#-# translate crowdin elyon_action_open_her_mouth_wider_3_7f25fb43:
msgid "[_elion_] А-агаф.. Это интерефно, чувствовать во рту фто-то столь вфердое.."
msgstr "[_elion_] Ah aah… Es interesante sentir algo tan delicioso en la boca…"

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_3.rpy:31 #-#-# translate crowdin elyon_action_open_her_mouth_wider_3_7358c8b1:
msgid "[_cedrick_] О, думаю это не последний мой твердый предмет, который побывает у тебя во рту"
msgstr "[_cedrick_] Oh, creo que este no es el último de mis objetos duros que estará en tu boca."

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_3.rpy:34 #-#-# translate crowdin elyon_action_open_her_mouth_wider_3_14c164ef:
msgid "[_elion_] Р-рих.. Ты меня смуфаешь.."
msgstr "[_elion_] R-Rick… Me estás avergonzando…"

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_3.rpy:37 #-#-# translate crowdin elyon_action_open_her_mouth_wider_3_7e80a310:
msgid "[_cedrick_] Хахах, ладно, думаю, хватит на сегодня"
msgstr "[_cedrick_] Jajaja, Bien, creo que es suficiente por hoy."

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_3.rpy:40 #-#-# translate crowdin elyon_action_open_her_mouth_wider_3_7b5bc50d:
msgid "[_elion_] Х-хорошо.."
msgstr "[_elion_] E-está bien…"

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_3.rpy:43 #-#-# translate crowdin elyon_action_open_her_mouth_wider_3_22c88599:
msgid "[_elion_] (О-он ведь имел ввиду свой член, да? Его член.. у меня во рту..)"
msgstr "[_elion_] (S-se refería a su verga, ¿verdad? Su verga… en mi boca…)"

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_3.rpy:47 #-#-# translate crowdin elyon_action_show_tongue_enough_3_38560d8c:
msgid "[_cedrick_] Думаю, с твоего рта на сегодня хватит"
msgstr "[_cedrick_] Creo que es suficiente de tu boca por hoy."

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_3.rpy:50 #-#-# translate crowdin elyon_action_show_tongue_enough_3_e861c520:
msgid "[_elion_] Ох, н-ну хорошо, Рик.. Как скажешь.."
msgstr "[_elion_] Oh, está bien, Rick… lo que digas…"

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_3.rpy:51 #-#-# translate crowdin elyon_action_show_tongue_enough_3_a4aa7411:
msgid "[_cedrick_] Хах, не переживай, я еще успею похозяйничать у тебя во рту"
msgstr "[_cedrick_] Ja, no te preocupes, todavía tendré tiempo de jugar con tu boca."

# game/scripts/elyon_actions/show_tongue/elyon_action_show_tongue_root_3.rpy:54 #-#-# translate crowdin elyon_action_show_tongue_enough_3_33681bf3:
msgid "[_elion_] Я-я поняла, Рик.. Хорошо.."
msgstr "[_elion_] E-entiendo, Rick… Está bien…"

