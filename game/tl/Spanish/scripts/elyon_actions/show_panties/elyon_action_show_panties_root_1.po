# TODO: Translation updated at 2023-07-25 15:55 #|#|# # game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_1.rpy:5 #-#-# translate crowdin elyon_action_show_panties_root_1_6c481af3:
msgid "[_cedrick_] Элион, я хочу, чтобы ты показала мне свои трусики"
msgstr "[_cedrick_] Elyon, quiero que me muestres tus panties."

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_1.rpy:8 #-#-# translate crowdin elyon_action_show_panties_root_1_1cc65aa9:
msgid "[_elion_] Р-Рик! Н-не думала, что ты будешь просить о подобном"
msgstr "[_elion_] ¡R-Rick! N-No pensé que pedirías algo así."

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_1.rpy:9 #-#-# translate crowdin elyon_action_show_panties_root_1_b7196b9f:
msgid "[_cedrick_] Это все для того, чтобы утолить твою развратную натуру. Ты ведь покраснела от одной только просьбы, а значит это работает"
msgstr "[_cedrick_] Es todo para apaciguar tu naturaleza depravada. Te sonrojas ante la mera petición, así que está funcionando."

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_1.rpy:12 #-#-# translate crowdin elyon_action_show_panties_root_1_5c7682ff:
msgid "[_elion_] Я.. Я.. Черт, ты прав.. Хорошо, я покажу их!"
msgstr "[_elion_] Yo... Yo... Maldita sea, tienes razón... Está bien, ¡te las mostraré!"

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_1.rpy:16 #-#-# translate crowdin elyon_action_show_panties_root_1_52793c7f:
msgid "[_cedrick_] Ооо, в цвет лифчика. Приятный комплект белья"
msgstr "[_cedrick_] Ooh, sujetador de color. Bonito conjunto de lencería."

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_1.rpy:19 #-#-# translate crowdin elyon_action_show_panties_root_1_5523be0e:
msgid "[_elion_] Так неловко.. Никогда не думала, что решусь показать тебе трусики"
msgstr "[_elion_] Qué incómodo... Nunca pensé que me atrevería a mostrarte mis panties."

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_1.rpy:20 #-#-# translate crowdin elyon_action_show_panties_root_1_840aa0e8:
msgid "[_cedrick_] Никогда? Это точно?"
msgstr "[_cedrick_] ¿Nunca? ¿Estás segura?"

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_1.rpy:23 #-#-# translate crowdin elyon_action_show_panties_root_1_3b41a168:
msgid "[_elion_] Н-ну.."
msgstr "[_elion_] B-bueno..."

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_1.rpy:24 #-#-# translate crowdin elyon_action_show_panties_root_1_ce7f5f52:
msgid "[_elion_] (Может быть, пару раз я это и представляла...)"
msgstr "[_elion_] (Tal vez lo imaginé un par de veces...)"

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_1.rpy:25 #-#-# translate crowdin elyon_action_show_panties_root_1_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_1.rpy:26 #-#-# translate crowdin elyon_action_show_panties_root_1_a20cefa7_1:
msgid "..."
msgstr "..."

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_1.rpy:32 #-#-# translate crowdin elyon_action_remove_panties_1_9287558c:
msgid "[_cedrick_] Хммм... А что, если.."
msgstr "[_cedrick_] Mmmm... ¿Y si...?"

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_1.rpy:36 #-#-# translate crowdin elyon_action_remove_panties_1_4969de78:
msgid "[_elion_] Р-рик! Что ты делаешь!? Не смотри!!"
msgstr "[_elion_] ¡R-Rick! ¿¡Qué estás haciendo!? ¡¡No mires!!"

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_1.rpy:37 #-#-# translate crowdin elyon_action_remove_panties_1_459eac11:
msgid "[_cedrick_] Надо же, какая гладкая.."
msgstr "[_cedrick_] Vaya, que suave..."

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_1.rpy:40 #-#-# translate crowdin elyon_action_remove_panties_1_805721a7:
msgid "[_elion_] Я ухожу!!"
msgstr "[_elion_] ¡¡Me voy!!"

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_1.rpy:43 #-#-# translate crowdin elyon_action_remove_panties_1_79201473:
msgid "[_cedrick_] (Хах... Ну, с другой стороны, а чего я еще ожидал?)"
msgstr "[_cedrick_] (Ja... Bueno, por otro lado, ¿qué más esperaba?)"

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_1.rpy:52 #-#-# translate crowdin elyon_action_show_panties_enough_1_eb1507a7:
msgid "[_cedrick_] Что ж, этого пока достаточно"
msgstr "[_cedrick_] Bueno, eso es suficiente por ahora."

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_1.rpy:55 #-#-# translate crowdin elyon_action_show_panties_enough_1_79dc37bc:
msgid "[_elion_] П-пока?"
msgstr "[_elion_] ¿Adiós?"

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_1.rpy:56 #-#-# translate crowdin elyon_action_show_panties_enough_1_7d6cf060:
msgid "[_cedrick_] Да. Ты же понимаешь, что на этом мы не остановимся. Рано или поздно ты сама захочешь, чтобы я зашел дальше"
msgstr "[_cedrick_] Sí. Entiendes que no nos detendremos ahí. Tarde o temprano tú mismo querrás que llegue más lejos."

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_1.rpy:59 #-#-# translate crowdin elyon_action_show_panties_enough_1_0c6e5e47:
msgid "[_elion_] Уф..."
msgstr "[_elion_] Puaj..."

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_1.rpy:60 #-#-# translate crowdin elyon_action_show_panties_enough_1_4ed7077e:
msgid "[_cedrick_] Но, пока что, это все, Элион, можешь идти. Думаю этой помощи тебе хватит"
msgstr "[_cedrick_] Pero eso es todo por ahora, Elyon, puedes irte. Creo que esta ayuda será suficiente para ti."

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_1.rpy:63 #-#-# translate crowdin elyon_action_show_panties_enough_1_1c644f46:
msgid "[_elion_] С-спасибо, Рик"
msgstr "[_elion_] G-gracias, Rick."

