# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_2.rpy:8 #-#-# translate crowdin elyon_action_show_panties_root_2_1112d5e2:
msgid "[_elion_] Снова, Рик? Н-ну хорошо"
msgstr "[_elion_] ¿Otra vez, Rick? E-está bien"

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_2.rpy:11 #-#-# translate crowdin elyon_action_show_panties_root_2_c472b426:
msgid "[_elion_] В-вот"
msgstr "[_elion_] Aquí."

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_2.rpy:14 #-#-# translate crowdin elyon_action_show_panties_root_2_dcd26e45:
msgid "[_cedrick_] Отлично.."
msgstr "[_cedrick_] Excelente…"

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_2.rpy:15 #-#-# translate crowdin elyon_action_show_panties_root_2_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_2.rpy:16 #-#-# translate crowdin elyon_action_show_panties_root_2_a20cefa7_1:
msgid "..."
msgstr "..."

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_2.rpy:23 #-#-# translate crowdin elyon_action_remove_panties_2_8c8affd9:
msgid "[_elion_] Н-нет, Рик, стой.. Я не готова.."
msgstr "[_elion_] N-no, Rick, detente… No estoy lista…"

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_2.rpy:27 #-#-# translate crowdin elyon_action_remove_panties_2_4270a8f9:
msgid "[_cedrick_] Хммм? Ну разве ты сама этого не хочешь?"
msgstr "[_cedrick_] ¿Mmm? Bueno, ¿no quieres esto tú misma?"

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_2.rpy:30 #-#-# translate crowdin elyon_action_remove_panties_2_e529cb66:
msgid "[_elion_] Я.. Может быть.. Но не сейчас"
msgstr "[_elion_] Yo… tal vez… pero no ahora."

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_2.rpy:31 #-#-# translate crowdin elyon_action_remove_panties_2_6f363b45:
msgid "[_cedrick_] Ну хорошо, Элион. Мне достаточно того, что ты все больше признаешь свою развратную натуру. Так будет проще помогать тебе в будущем"
msgstr "[_cedrick_] Muy bien, Elyon. Me basta con que reconozcas cada vez más tu naturaleza depravada. Así será más fácil ayudarte en el futuro."

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_2.rpy:32 #-#-# translate crowdin elyon_action_remove_panties_2_1c644f46:
msgid "[_elion_] С-спасибо, Рик"
msgstr "[_elion_] G-gracias, Rick."

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_2.rpy:38 #-#-# translate crowdin elyon_action_show_panties_enough_2_742915c6:
msgid "[_cedrick_] Хорошо, Элион, этого пока достаточно. Но вижу, что тебя уже не так сильно смущает происходящее. А значит, скоро нам придется зайти дальше"
msgstr "[_cedrick_] Bien, Elyon, eso es suficiente por ahora. Pero veo que ya no te da tanta vergüenza lo que está pasando. Lo que significa que pronto tendremos que ir más lejos."

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_2.rpy:41 #-#-# translate crowdin elyon_action_show_panties_enough_2_dbd531c7:
msgid "[_elion_] Я.. я понимаю, Рик"
msgstr "[_elion_] Yo… lo entiendo, Rick."

# game/scripts/elyon_actions/show_panties/elyon_action_show_panties_root_2.rpy:42 #-#-# translate crowdin elyon_action_show_panties_enough_2_0ef3f768:
msgid "[_cedrick_] Хорошо, можешь идти"
msgstr "[_cedrick_] Está bien, puedes irte."

