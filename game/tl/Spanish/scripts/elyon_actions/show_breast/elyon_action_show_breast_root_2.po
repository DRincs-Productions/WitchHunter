# TODO: Translation updated at 2023-07-25 15:55 #|#|# # game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:5 #-#-# translate crowdin elyon_action_show_breast_root_2_aebed1e4:
msgid "[_cedrick_] Элион, не покажешь мне свою грудь?"
msgstr "[_cedrick_] Elyon, ¿me mostrarás tus pechos?"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:8 #-#-# translate crowdin elyon_action_show_breast_root_2_588c189b:
msgid "[_elion_] Р-рик, так сразу?"
msgstr "[_elion_] R-Rick, ¿es en serio?"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:9 #-#-# translate crowdin elyon_action_show_breast_root_2_87cdad4e:
msgid "[_cedrick_] А почему нет? Считай это частью работы по утолению твоей развратности"
msgstr "[_cedrick_] ¿Por qué no? Considéralo parte del trabajo para satisfacer tu depravación."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:12 #-#-# translate crowdin elyon_action_show_breast_root_2_8d527e37:
msgid "[_elion_] Н-ну хорошо.. Только без фокусов, Рик"
msgstr "[_elion_] B-bueno… pero sin trucos, Rick."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:13 #-#-# translate crowdin elyon_action_show_breast_root_2_8225f9f0:
msgid "[_cedrick_] Конечно"
msgstr "[_cedrick_] Correcto, bien."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:18 #-#-# translate crowdin elyon_action_show_breast_root_2_09d5fccb:
msgid "[_elion_] В-вот.."
msgstr "[_elion_] A-aquí…"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:19 #-#-# translate crowdin elyon_action_show_breast_root_2_5383e09a:
msgid "[_cedrick_] Отлично. Приятный цвет и форма"
msgstr "[_cedrick_] Excelente. Lindo color y forma."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:22 #-#-# translate crowdin elyon_action_show_breast_root_2_085752b0:
msgid "[_elion_] С-спасибо.."
msgstr "[_elion_] G-gracias…"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:25 #-#-# translate crowdin elyon_action_show_breast_root_2_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:26 #-#-# translate crowdin elyon_action_show_breast_root_2_a20cefa7_1:
msgid "..."
msgstr "..."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:34 #-#-# translate crowdin elyon_action_remove_bra_2_b226707f:
msgid "[_cedrick_] И все же, мне хочется их увидеть.."
msgstr "[_cedrick_] Y aún así, quiero verlos…"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:38 #-#-# translate crowdin elyon_action_remove_bra_2_bfd9021c:
msgid "[_elion_] Р-Рик!"
msgstr "[_elion_] ¡R-Rick!"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:39 #-#-# translate crowdin elyon_action_remove_bra_2_e1f8389a:
msgid "[_cedrick_] Хе-хе, они прекрасны"
msgstr "[_cedrick_] Jeje, son hermosos."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:43 #-#-# translate crowdin elyon_action_remove_bra_2_6d8a2af7:
msgid "[_elion_] Этот фокус не пройдет.. Н-не все сразу, Рик.."
msgstr "[_elion_] Este truco no funcionará… N-no todo de una vez, Rick…"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:44 #-#-# translate crowdin elyon_action_remove_bra_2_7ca135b9:
msgid "[_cedrick_] Ох, значит ты понимаешь, что рано или поздно мы к этому придем?"
msgstr "[_cedrick_] Oh, ¿entonces entiendes que tarde o temprano llegaremos a esto?"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:47 #-#-# translate crowdin elyon_action_remove_bra_2_983d0973:
msgid "[_elion_] Я.. Я просто не готова к этому сейчас.. Их ведь даже Брайан не видел"
msgstr "[_elion_] Yo… simplemente no estoy preparado para esto ahora… Ni siquiera Brian los ha visto."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:48 #-#-# translate crowdin elyon_action_remove_bra_2_ebc4ad01:
msgid "[_cedrick_] (Хах, вот он неудачник. А мне даже не нужно быть ее парнем, чтобы увидеть ее грудь)"
msgstr "[_cedrick_] (Eh, es un perdedor. Y ni siquiera tengo que ser su novio para ver sus pechos)"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:49 #-#-# translate crowdin elyon_action_remove_bra_2_7ce2cf7c:
msgid "[_cedrick_] К-хм.. Хорошо, Элион, я тебя понял. Закончим на этом.. Пока что"
msgstr "[_cedrick_] Hmm… Está bien, Elyon, te entiendo. Terminemos esto aquí… Por ahora."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:52 #-#-# translate crowdin elyon_action_remove_bra_2_4ae9fcf3:
msgid "[_elion_] Х-хорошо, Рик.. Тогда, я пойду"
msgstr "[_elion_] Está bien, Rick… Entonces me iré."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:55 #-#-# translate crowdin elyon_action_remove_bra_2_8729b7a5:
msgid "[_cedrick_] Да, давай, увидимся позже"
msgstr "[_cedrick_] Sí, vamos, nos vemos luego."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:62 #-#-# translate crowdin elyon_action_show_breast_enough_2_9865da69:
msgid "[_cedrick_] Думаю, на сегодня этого хватит, Элион. Я достаточно налюбовался твоими формами"
msgstr "[_cedrick_] Creo que es suficiente por hoy, Elyon. Ya tuve suficiente de tus curvas."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:65 #-#-# translate crowdin elyon_action_show_breast_enough_2_d462872c:
msgid "[_elion_] Э-эм, а разве смысл был в этом?"
msgstr "[_elion_] Um, ¿tenía algún sentido eso?"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:67 #-#-# translate crowdin elyon_action_show_breast_enough_2_7c2f0b36:
msgid "[_cedrick_] Смысл был в том, чтобы помочь справиться тебе с твоей развратностью, утолить ее. Разве тебе самой не нравится, когда я на тебя так смотрю"
msgstr "[_cedrick_] El objetivo era ayudarte a afrontar tu depravación, satisfacerla. ¿No te gusta cuando te miro así?"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:70 #-#-# translate crowdin elyon_action_show_breast_enough_2_931a8581:
msgid "[_elion_] Ммм.. Н-немного.."
msgstr "[_elion_] Mmm… U-un poco…"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:71 #-#-# translate crowdin elyon_action_show_breast_enough_2_ddd9724d:
msgid "[_cedrick_] Вот видишь. А значит, в итоге это помогает и тебе"
msgstr "[_cedrick_] Verás. Esto significa que al final también te ayuda a ti."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:74 #-#-# translate crowdin elyon_action_show_breast_enough_2_a661b79e:
msgid "[_elion_] Я-я поняла"
msgstr "[_elion_] Yo-yo entiendo."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_2.rpy:75 #-#-# translate crowdin elyon_action_show_breast_enough_2_304782a2:
msgid "[_cedrick_] Хорошо. Тогда мы закончили"
msgstr "[_cedrick_] Bien. Entonces terminamos."

