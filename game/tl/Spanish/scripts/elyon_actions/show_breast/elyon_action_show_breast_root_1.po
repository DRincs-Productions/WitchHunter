# TODO: Translation updated at 2023-07-25 15:55 #|#|# # game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:5 #-#-# translate crowdin elyon_action_show_breast_root_1_52b54768:
msgid "[_cedrick_] Отлично. Тогда, покажи мне свою грудь"
msgstr "[_cedrick_] Excelente. Entonces muéstrame tus pechos"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:8 #-#-# translate crowdin elyon_action_show_breast_root_1_47200599:
msgid "[_elion_] Ч-Что!? Рик!"
msgstr "[_elion_] ¿¡Q-Qué!? ¡Rick!"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:9 #-#-# translate crowdin elyon_action_show_breast_root_1_e1734570:
msgid "[_cedrick_] А что такого? Я ее уже видел, когда спас тебя в туалете от Урии"
msgstr "[_cedrick_] ¿Qué ocurre? Ya los vi cuando te salvé de Urías en el baño"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:12 #-#-# translate crowdin elyon_action_show_breast_root_1_b64cec0c:
msgid "[_elion_] Н-но... Я так не могу, это как-то..."
msgstr "[_elion_] P-pero... no puedo hacer esto, es de alguna manera..."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:13 #-#-# translate crowdin elyon_action_show_breast_root_1_2228630f:
msgid "[_cedrick_] Элион, ты сказала, что полностью доверишься мне в этом деле"
msgstr "[_cedrick_] Elyon, dijiste que confiarías completamente en mí en este asunto"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:16 #-#-# translate crowdin elyon_action_show_breast_root_1_a39339ed:
msgid "[_elion_] Н-ну, я.. Хорошо, если ты считаешь, что это поможет"
msgstr "[_elion_] B-bueno, yo... Está bien, si crees que te ayudará"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:20 #-#-# translate crowdin elyon_action_show_breast_root_1_699409c1:
msgid "[_cedrick_] Мммм, даже через лифчик можно проследить приятные формы"
msgstr "[_cedrick_] Мммм, Incluso a través del sujetador se puede admirar la agradable forma"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:23 #-#-# translate crowdin elyon_action_show_breast_root_1_45b45fac:
msgid "[_elion_] Р-рик, это.. Это очень смущает"
msgstr "[_elion_] R-rick, esto... Esto es muy vergonzoso"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:24 #-#-# translate crowdin elyon_action_show_breast_root_1_41e6b97b:
msgid "[_cedrick_] Черт, я что, это вслух сказал.."
msgstr "[_cedrick_] Maldita sea, acabo de decir eso en voz alta..."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:27 #-#-# translate crowdin elyon_action_show_breast_root_1_88dc6656:
msgid "[_elion_] (Уф, не думала, что Рик скажет мне такое.. Но, с другой стороны, это значит, что ему нравится моя фигура..)"
msgstr "[_elion_] (Uf, no pensé que Rick me diría eso... Pero, por otro lado, significa que le gusta mi figura...)"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:30 #-#-# translate crowdin elyon_action_show_breast_root_1_3199768b:
msgid "[_elion_] Эм.. Рик, может достаточно?"
msgstr "[_elion_] Um... Rick, ¿tal vez eso sea suficiente?"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:35 #-#-# translate crowdin elyon_action_remove_bra_1_373f4779:
msgid "[_cedrick_] Знаешь, пожалуй, я хочу увидеть немного больше"
msgstr "[_cedrick_] Sabes, supongo que quiero ver un poco más"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:38 #-#-# translate crowdin elyon_action_remove_bra_1_d043bf37:
msgid "[_elion_] Ч-что!?"
msgstr "[_elion_] ¿¡Q-qué!?"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:40 #-#-# translate crowdin elyon_action_remove_bra_1_1e123844:
msgid "[_cedrick_] Уф, какие аккуратные у тебя..."
msgstr "[_cedrick_] Vaya, que linda eres..."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:43 #-#-# translate crowdin elyon_action_remove_bra_1_25981e24:
msgid "[_elion_] Рик! Это чересчур! Я... Я... Я ухожу!"
msgstr "[_elion_] ¡Rick! ¡Esto es demasiado! Yo... yo... ¡Me voy!"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:46 #-#-# translate crowdin elyon_action_remove_bra_1_0da44429:
msgid "[_cedrick_] Черт, тут я перегнул.."
msgstr "[_cedrick_] Maldita sea, fui demasiado lejos aquí..."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:53 #-#-# translate crowdin elyon_action_show_breast_enough_1_37325428:
msgid "[_cedrick_] Что ж, для первого раза думаю хватит. Как ощущения?"
msgstr "[_cedrick_] Bueno, creo que es suficiente por primera vez. ¿Cómo se siente?"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:56 #-#-# translate crowdin elyon_action_show_breast_enough_1_81011f06:
msgid "[_elion_] Н-не думала, что ты так сразу попросишь показать меня грудь"
msgstr "[_elion_] N-No pensé que me pedirías mostrar mis senos tan rápido."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:57 #-#-# translate crowdin elyon_action_show_breast_enough_1_5c39fb09:
msgid "[_cedrick_] Так сразу? А чего же ты тогда от меня ожидала"
msgstr "[_cedrick_] ¿Es en serio? ¿Qué esperabas de mí entonces?"

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:58 #-#-# translate crowdin elyon_action_show_breast_enough_1_5b6a549f:
msgid "[_elion_] Э-эм.. ну.. не знаю.."
msgstr "[_elion_] Um... bueno... no lo sé..."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:59 #-#-# translate crowdin elyon_action_show_breast_enough_1_b4bfb422:
msgid "[_cedrick_] Думаю, ты хотела больше прелюдий"
msgstr "[_cedrick_] Creo que querías más juegos previos."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:62 #-#-# translate crowdin elyon_action_show_breast_enough_1_8a9f5e55:
msgid "[_elion_] Ч-что!? Я-я не это имела ввиду.. Рик.."
msgstr "[_elion_] ¿¡Q-qué!? N-no quise decir eso... Rick..."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:64 #-#-# translate crowdin elyon_action_show_breast_enough_1_94944589:
msgid "[_cedrick_] Что ж, тогда до следующего раза, Элион. Надеюсь, тебе стало лучше"
msgstr "[_cedrick_] Bueno, hasta la próxima, Elyon. espero que te sientas mejor."

# game/scripts/elyon_actions/show_breast/elyon_action_show_breast_root_1.rpy:67 #-#-# translate crowdin elyon_action_show_breast_enough_1_ae587a8c:
msgid "[_elion_] Д-до следующего раза, агам.."
msgstr "[_elion_] H-hasta la próxima, de nuevo..."

