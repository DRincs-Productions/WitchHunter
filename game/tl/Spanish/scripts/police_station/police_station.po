# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/police_station/police_station.rpy:13 #-#-# translate crowdin police_station_inaccessible_door_ae1873e0:
msgid "[_cedrick_] Заперто.. К тому же это явно не та дверь"
msgstr "[_cedrick_] Cerrado... Además, esta es claramente la puerta equivocada."

# game/scripts/police_station/police_station.rpy:21 #-#-# translate crowdin police_station_lose_23632d6b:
msgid "[_centered_] {size=37}В полицейском участке сработала сигнальная сирена, все выходы из здания перекрыты. Седрик в ловушке{/size}"
msgstr "[_centered_] {size=37}En la comisaría sonó la sirena de alarma y se bloquearon todas las salidas del edificio. Cedric está atrapado{/size}"

# game/scripts/police_station/police_station.rpy:24 #-#-# translate crowdin police_station_lose_8d084e2b:
msgid "[_cedrick_] (Черт, и угораздило же меня так попасться..)"
msgstr "[_cedrick_] (Maldita sea, logré que me atraparan así...)"

# game/scripts/police_station/police_station.rpy:25 #-#-# translate crowdin police_station_lose_4142f222:
msgid "[_cedrick_] (Я мог сожрать дежурного, но это не имело бы никакого смысла. Полиция окружила здание чертовски быстро, скрытно сбежать бы мне не удалось)"
msgstr "[_cedrick_] (Podría haberme comido al oficial de guardia, pero eso no habría tenido ningún sentido. La policía rodeó el edificio muy rápido y no habría podido escaparme.)"

# game/scripts/police_station/police_station.rpy:26 #-#-# translate crowdin police_station_lose_dd46036a:
msgid "[_cedrick_] (Форма змея доставил бы только больше проблем)"
msgstr "[_cedrick_] (La forma de serpiente solo causaría más problemas.)"

# game/scripts/police_station/police_station.rpy:27 #-#-# translate crowdin police_station_lose_8a04e49b:
msgid "[_cedrick_] (Как бы то ни было — это моя очередная ошибка. Пора научиться за них платить. Посмотрим, что со мной будет дальше, эти вшивые детективы скоро придут для допроса)"
msgstr "[_cedrick_] (Sea como sea, este es mi próximo error. Es hora de aprender a pagar por ellos. Veamos qué me pasa después, estos pésimos detectives pronto vendrán a interrogarnos.)"

# game/scripts/police_station/police_station.rpy:28 #-#-# translate crowdin police_station_lose_5ca38870:
msgid "[_cedrick_] (Но даже если мне удастся сбежать, свой единственный шанс я уже потерял. План с Мединой провалился)"
msgstr "[_cedrick_] (Pero incluso si logro escapar, ya perdí mi única oportunidad. El plan con Medina falló.)"

# game/scripts/police_station/police_station.rpy:30 #-#-# translate crowdin police_station_lose_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/police_station/police_station.rpy:40 #-#-# translate crowdin police_station_guard1_lose_757efc14:
msgid "[_sergeant_] Что вы здесь делаете!? Вы не должны находиться в участке в такое время. Прием-прием, у меня здесь посторонний"
msgstr "[_sergeant_] ¿¡Qué estás haciendo aquí!? No deberías estar en la estación en este momento. Me copian, Me copian, tengo un extraño aquí."

# game/scripts/police_station/police_station.rpy:41 #-#-# translate crowdin police_station_guard1_lose_7aceab69:
msgid "[_cedrick_] Черт, это был не тот коридор"
msgstr "[_cedrick_] Maldita sea, ese era el pasillo equivocado."

# game/scripts/police_station/police_station.rpy:50 #-#-# translate crowdin police_station_guard2_lose_549e211f:
msgid "sergeant [special_delimiter] Руки вверх, не двигаться!? У нас нарушитель, прием! Повторяю, у нас нарушитель!"
msgstr "sergeant [special_delimiter] ¡¿Manos arriba, no te muevas?! Tenemos un intruso, ¡Me copian! Repito, ¡tenemos un intruso!"

# game/scripts/police_station/police_station.rpy:51 #-#-# translate crowdin police_station_guard2_lose_fa4902d0:
msgid "[_cedrick_] Вот же ж черт, меня поймали.."
msgstr "[_cedrick_] Maldita sea, me atraparon..."

# game/scripts/police_station/police_station.rpy:64 #-#-# translate crowdin police_station_street_9a257e45:
msgid "[_cedrick_] (Снаружи никого нет. Лучше не идти через заднюю дверь, обычно в полиции все запасные ходы охраняются лучше центрального. Тихо взломаю его и попаду внутрь)"
msgstr "[_cedrick_] (No hay nadie afuera. Es mejor no pasar por la puerta trasera; normalmente la policía vigila todos los pasillos libres mejor que el central. La romperé silenciosamente y entraré.)"

# game/scripts/police_station/police_station.rpy:71 #-#-# translate crowdin police_station_main_hall_ae82c23a:
msgid "[_cedrick_] (Открыта? Видимо кто-то недавно зашел. Нужно быть начеку)"
msgstr "[_cedrick_] (¿Está abierto? Al parecer alguien entró hace poco. Necesitas estar en guardia.)"

# game/scripts/police_station/police_station.rpy:75 #-#-# translate crowdin police_station_main_hall_076e0cad:
msgid "(Хм, на проходной никого.. Вот же любители отлынивать от работы. Ну да ладно, мне же лучше. Так, первым делом стоит свериться с чертежом здания)"
msgstr "(Hmm, no hay nadie en el puesto de control... Son personas a las que les gusta tomarse un tiempo libre en el trabajo. Oh, bueno, es lo mejor. Entonces, lo primero que debes hacer es revisar el plano del edificio.)"

# game/scripts/police_station/police_station.rpy:89 #-#-# translate crowdin police_station_map_00b0fb3a:
msgid "[_cedrick_] (А вот и карта. Дежурство в западном и северо-восточном крыле. Вот почему здесь никого нет, понятно. Что ж, теперь знаю, куда соваться не стоит)"
msgstr "[_cedrick_] (Y aquí está el mapa. Deber en las alas oeste y noreste. Por eso no hay nadie aquí, está claro. Bueno, ahora sé dónde no meter la nariz.)"

# game/scripts/police_station/police_station.rpy:90 #-#-# translate crowdin police_station_map_66f294ec:
msgid "[_cedrick_] (Мне нужен кабинет комиссара, дверь под номером 38)"
msgstr "[_cedrick_] (Necesito la oficina del comisionado, puerta número 38.)"

# game/scripts/police_station/police_station.rpy:108 #-#-# translate crowdin police_station_main_guards_1_df8958e7:
msgid "[_cedrick_] Хм, кажется я вижу кого-то вдалеке"
msgstr "[_cedrick_] Hmm, creo que veo a alguien a lo lejos."

# game/scripts/police_station/police_station.rpy:121 #-#-# translate crowdin police_station_main_guards_1_354f327d:
msgid "[_centered_] {size=37}Седрик сумел вырубить сержанта до того, как он успел поднять тревогу {/size}"
msgstr "[_centered_] {size=37}Cedric logró noquear al sargento antes de que pudiera dar la alarma {/size}"

# game/scripts/police_station/police_station.rpy:123 #-#-# translate crowdin police_station_main_guards_1_eb1f036e:
msgid "[_cedrick_] (Фух, успел вырубить его.. Но в это крыло мне лучше не соваться...)"
msgstr "[_cedrick_] (Uf, logré noquearlo... Pero es mejor para mí no entrometerme en esta ala...)"

# game/scripts/police_station/police_station.rpy:125 #-#-# translate crowdin police_station_main_guards_1_cd56832b:
msgid "[_cedrick_] (Мне нечего там делать)"
msgstr "[_cedrick_] (No tengo nada que hacer ahí.)"

# game/scripts/police_station/police_station.rpy:141 #-#-# translate crowdin police_station_room2_guards_8e20521b:
msgid "[_cedrick_] Хм, вдали виднеется чей-то силует"
msgstr "[_cedrick_] Hmm, la silueta de alguien es visible a lo lejos."

# game/scripts/police_station/police_station.rpy:156 #-#-# translate crowdin police_station_room2_guards_59bb471b:
msgid "Седрик сумел вырубить детектива до того, как она успела поднять тревогу"
msgstr "Cedric logró noquear a la detective antes de que pudiera dar la alarma."

# game/scripts/police_station/police_station.rpy:157 #-#-# translate crowdin police_station_room2_guards_bffc177f:
msgid "[_cedrick_] (Успел.. Но в это крыло мне лучше не соваться...)"
msgstr "[_cedrick_] (Lo logré... Pero es mejor para mí no entrometerme en esta ala...)"

# game/scripts/police_station/police_station.rpy:159 #-#-# translate crowdin police_station_room2_guards_cd56832b:
msgid "[_cedrick_] (Мне нечего там делать)"
msgstr "[_cedrick_] (No tengo nada que hacer ahí.)"

# game/scripts/police_station/police_station.rpy:165 #-#-# translate crowdin police_room_30_8af13c67:
msgid "30 кабинет"
msgstr "Habitación 30"

# game/scripts/police_station/police_station.rpy:180 #-#-# translate crowdin police_station_room33_guards_13f460ad:
msgid "Патруль 3"
msgstr "Patrulla 3"

# game/scripts/police_station/police_station.rpy:190 #-#-# translate crowdin gallery_d_067_51b93eeb:
msgid "[_woman_prisoner_] Ч-что это вообще за костюм.. Любишь ролевые игры, извращенец?"
msgstr "[_woman_prisoner_] ¿Q-qué tipo de disfraz es este? ¿Te gustan los juegos de rol, pervertido?"

# game/scripts/police_station/police_station.rpy:192 #-#-# translate crowdin gallery_d_067_37886181:
msgid "[_gordon_] Меньше болтовни, заключенная. Забыла с кем разговариваешь? Или хочешь торчать здесь следующие 20 лет?"
msgstr "[_gordon_] Menos charla, prisionera. ¿Olvidaste con quién estás hablando? ¿O quieres quedarte atrapado aquí durante los próximos 20 años?"

# game/scripts/police_station/police_station.rpy:193 #-#-# translate crowdin gallery_d_067_dd82b993:
msgid "[_woman_prisoner_] П-простите, комиссар"
msgstr "[_woman_prisoner_] Lo siento, comisionado."

# game/scripts/police_station/police_station.rpy:194 #-#-# translate crowdin gallery_d_067_15237153:
msgid "[_gordon_] Так-то лучше. Давай, девчонка, скачи на моем члене"
msgstr "[_gordon_] Eso es mejor. Vamos chica, monta mi verga."

# game/scripts/police_station/police_station.rpy:195 #-#-# translate crowdin gallery_d_067_bc47c6ee:
msgid "[_woman_prisoner_] Х-хорошо.."
msgstr "[_woman_prisoner_] Muy bien."

# game/scripts/police_station/police_station.rpy:196 #-#-# translate crowdin gallery_d_067_ea2f84ca:
msgid "[_gordon_] Не понял?"
msgstr "[_gordon_] ¿No entendiste?"

# game/scripts/police_station/police_station.rpy:197 #-#-# translate crowdin gallery_d_067_cf75aaeb:
msgid "[_woman_prisoner_] То есть.. Е-есть, комиссар Гордон"
msgstr "[_woman_prisoner_] Eso es... E-eso es, Comisionado Gordon."

# game/scripts/police_station/police_station.rpy:198 #-#-# translate crowdin gallery_d_067_a6d2fe44:
msgid "[_gordon_] Опять неверно.."
msgstr "[_gordon_] Te equivocas de nuevo."

# game/scripts/police_station/police_station.rpy:199 #-#-# translate crowdin gallery_d_067_5abba122:
msgid "[_woman_prisoner_] Эм.. Как скажешь, папочка?"
msgstr "[_woman_prisoner_] Um... ¿Qué dices, papá?"

# game/scripts/police_station/police_station.rpy:200 #-#-# translate crowdin gallery_d_067_06f32c69:
msgid "[_gordon_] Вот, теперь угадала. Не выбивайся из образа.."
msgstr "[_gordon_] Ya lo tienes. No te salgas del personaje."

# game/scripts/police_station/police_station.rpy:201 #-#-# translate crowdin gallery_d_067_2d2facf4:
msgid "[_woman_prisoner_] Х-хорошо.. Мммм.."
msgstr "[_woman_prisoner_] O-ok... Mmmm..."

# game/scripts/police_station/police_station.rpy:202 #-#-# translate crowdin gallery_d_067_ff454efa:
msgid "[_gordon_] О да, ты такая горячая.. Молодая рыжеволосая девчонка, черт, ты так похожа на.."
msgstr "[_gordon_] Oh, sí, eres tan sexy... Joven pelirroja, maldita sea, te pareces mucho a..."

# game/scripts/police_station/police_station.rpy:203 #-#-# translate crowdin gallery_d_067_666da3ee:
msgid "[_woman_prisoner_] Ааааах.. Н-на кого?"
msgstr "[_woman_prisoner_] Aaaah.. ¿A-a quién?"

# game/scripts/police_station/police_station.rpy:204 #-#-# translate crowdin gallery_d_067_83491cf6:
msgid "[_gordon_] А, впрочем тебе этого знать не стоит.. Просто продолжай.."
msgstr "[_gordon_] Oh, pero no necesitas saber eso... Sólo continúa..."

# game/scripts/police_station/police_station.rpy:205 #-#-# translate crowdin gallery_d_067_7d6bd053:
msgid "[_woman_prisoner_] Х-хорошо, папочка.."
msgstr "[_woman_prisoner_] Está bien, papi..."

# game/scripts/police_station/police_station.rpy:206 #-#-# translate crowdin gallery_d_067_02603164:
msgid "[_gordon_] Оооо даааа.. Барбара, да!"
msgstr "[_gordon_] Ohhhhhhh... ¡Bárbara, sí!"

# game/scripts/police_station/police_station.rpy:207 #-#-# translate crowdin gallery_d_067_22440fde:
msgid "[_cedrick_] (Какого черта..)"
msgstr "[_cedrick_] (Qué demonios...)"

# game/scripts/police_station/police_station.rpy:208 #-#-# translate crowdin gallery_d_067_3949b495:
msgid "[_cedrick_] (Ну, зато теперь я знаю, что Гордон мне не помешает.. Стоп.. Кажется я понял, какой пароль)"
msgstr "[_cedrick_] (Bueno, pero ahora sé que Gordon no me molestará... Espera... Creo que entiendo cuál es la contraseña)"

# game/scripts/police_station/police_station.rpy:215 #-#-# translate crowdin gallery_d_067_cd56832b:
msgid "[_cedrick_] (Мне нечего там делать)"
msgstr "[_cedrick_] (No tengo nada que hacer ahí.)"

# game/scripts/police_station/police_station.rpy:511 #-#-# translate crowdin police_sheff_office_056f5798:
msgid "[_cedrick_] (Что ж, и наш пароль это..)"
msgstr "[_cedrick_] (Bueno, nuestra contraseña es...)"

# game/scripts/police_station/police_station.rpy:520 #-#-# translate crowdin police_sheff_office_989212d7:
msgid "[_cedrick_] (Я на месте. Нужно зайти в компьютер, пока меня не обнаружили)"
msgstr "[_cedrick_] (Ya estoy allí. Necesito iniciar sesión en la computadora antes de que me descubran.)"

# game/scripts/police_station/police_station.rpy:523 #-#-# translate crowdin police_sheff_office_96cf48ee:
msgid "[_cedrick_] (Черт..)"
msgstr "[_cedrick_] (Tonterías...)"

# game/scripts/police_station/police_station.rpy:524 #-#-# translate crowdin police_sheff_office_b2c6f693:
msgid "[_cedrick_] (Ну конечно же он заблокирован, это же главный компьютер в полицейском участке.. Мне нужен пароль..)"
msgstr "[_cedrick_] (Bueno, por supuesto que está bloqueado, es la computadora principal de la estación de policía... necesito la contraseña...)"

# game/scripts/police_station/police_station.rpy:525 #-#-# translate crowdin police_sheff_office_0e153a3c:
msgid "[_cedrick_] (Хм.. Может в участке я смогу найти подсказку? Нужно проверить другие комнаты и не попасться полиции в западном и северо-восточном крыле)"
msgstr "[_cedrick_] (Hmm... ¿Tal vez pueda encontrar una pista en la estación? Necesito revisar otras habitaciones y evitar ser atrapado por la policía en el ala oeste y noreste.)"

# game/scripts/police_station/police_station.rpy:530 #-#-# translate crowdin police_sheff_office_9cdcaeb5:
msgid "[_cedrick_] (Я все еще не знаю пароль, мне нечего там делать)"
msgstr "[_cedrick_] (Aún no sé la contraseña, no tengo nada que hacer ahí.)"

# game/scripts/police_station/police_station.rpy:562 #-#-# translate crowdin police_computer_input_password_7b15bff1:
msgid "system [special_delimiter] Принято"
msgstr "system [special_delimiter] Aceptado"

# game/scripts/police_station/police_station.rpy:564 #-#-# translate crowdin police_computer_input_password_be1b8ff2:
msgid "[_cedrick_] (Старый извращенец.. Ладно, я вошел в систему, теперь нужно найти информацию о Медине)"
msgstr "[_cedrick_] (Viejo pervertido... Está bien, ya he iniciado sesión, ahora necesito encontrar información sobre Medina.)"

# game/scripts/police_station/police_station.rpy:573 #-#-# translate crowdin police_computer_input_password_89e4f7e2:
msgid "system [special_delimiter] Отказано"
msgstr "system [special_delimiter] Aceptado"

# game/scripts/police_station/police_station.rpy:574 #-#-# translate crowdin police_computer_input_password_9201bf31:
msgid "[_cedrick_] Черт.."
msgstr "[_cedrick_] (Tonterías...)"

# game/scripts/police_station/police_station.rpy:583 #-#-# translate crowdin police_computer_folders_4b6a12e6:
msgid "[_cedrick_] (Это явно не та папка, что мне нужна..)"
msgstr "[_cedrick_] (Obviamente no es la carpeta que quiero...)"

