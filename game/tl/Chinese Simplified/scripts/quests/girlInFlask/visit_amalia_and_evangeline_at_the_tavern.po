# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:4 #-#-# translate crowdin visit_amalia_and_evangeline_at_the_tavern_bf69d8dd:
msgid "Седрик подходит к двери комнаты и слышит разговор на повышенных тонах"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:5 #-#-# translate crowdin visit_amalia_and_evangeline_at_the_tavern_d94c25af:
msgid "[_evangelin_] Я не останусь с ним!"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:6 #-#-# translate crowdin visit_amalia_and_evangeline_at_the_tavern_67ecac73:
msgid "[_amalia_] Почему?"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:7 #-#-# translate crowdin visit_amalia_and_evangeline_at_the_tavern_f177e5b9:
msgid "[_evangelin_] Не глупи! Мы в неизвестном где, а ты доверяешь незнакомому человеку!"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:8 #-#-# translate crowdin visit_amalia_and_evangeline_at_the_tavern_85d3d96e:
msgid "[_amalia_] Но он нам помог..."
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:9 #-#-# translate crowdin visit_amalia_and_evangeline_at_the_tavern_db3ac788:
msgid "[_evangelin_] Это не означает, что он не захочет нас использовать!"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:12 #-#-# translate crowdin gallery_d_026_d01dac39:
msgid "[_cedrick_] Евангелина, Амалия... что-то случилось?"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:15 #-#-# translate crowdin gallery_d_026_1a885548:
msgid "[_amalia_] Седрик, я как раз тебя ждала. Можешь еще раз мне помочь?"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:20 #-#-# translate crowdin gallery_d_026_23825d8a:
msgid "[_evangelin_] Амалия, даже не думай."
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:26 #-#-# translate crowdin gallery_d_026_8b90a44e:
msgid "[_amalia_] Присмотри за Евангелиной, пожалуйста. Она слаба, а мне нужно найти Капли и портал, чтобы попасть в свой мир. Поэтому я и хочу попросить тебя оказать нам еще одну услугу. Не мог бы ты..."
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:30 #-#-# translate crowdin gallery_d_026_7ab1c212:
msgid "[_cedrick_] Да. Можешь быть спокойна - с Евангелиной все будет хорошо"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:36 #-#-# translate crowdin gallery_d_026_4745e712:
msgid "[_evangelin_] А моего мнения никто не забыл спросить? Я не хочу с ним оставаться, я пойду с тобой и помогу тебе!"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:42 #-#-# translate crowdin gallery_d_026_827af96b:
msgid "[_amalia_] Нет. Я буду переживать, ты останешься с Седриком"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:48 #-#-# translate crowdin gallery_d_026_5a6bf679:
msgid "[_evangelin_] Ладно. Хорошо. Отлично"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:52 #-#-# translate crowdin gallery_d_026_f0b04165:
msgid "Амалия уходит"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:55 #-#-# translate crowdin gallery_d_026_9e192bf3:
msgid "[_cedrick_] Она тебе не безразлична, так?"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:59 #-#-# translate crowdin gallery_d_026_2fd4d3d1:
msgid "[_evangelin_] А тебе какое дело?"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:63 #-#-# translate crowdin gallery_d_026_a7bd4d7a:
msgid "[_cedrick_] Мне больно видеть, как тебе трудно признаться в чувствах Амалии. Вот я и захотел помочь"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:67 #-#-# translate crowdin gallery_d_026_2bac3fc6:
msgid "[_evangelin_] О чем ты? Мы... Друзья, к тому же я ее телохранитель."
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:71 #-#-# translate crowdin gallery_d_026_ad91425e:
msgid "[_cedrick_] Поверь, я смогу различить дружескую симпатию и нечто большее"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:75 #-#-# translate crowdin gallery_d_026_65f8f649:
msgid "[_evangelin_] О чем ты?"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:79 #-#-# translate crowdin gallery_d_026_bfa35cfa:
msgid "[_cedrick_] Вы отсюда никуда не уйдете, пока ты не сделаешь то, о чем прошу"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:84 #-#-# translate crowdin gallery_d_026_bff80c72:
msgid "[_evangelin_] Что?!"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:88 #-#-# translate crowdin gallery_d_026_8b340a78:
msgid "[_cedrick_] Те Капли, что вы ищете - они у меня. И вы просто так отсюда не уйдете"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:92 #-#-# translate crowdin gallery_d_026_6770218a:
msgid "[_evangelin_] Ты смеешь угрожать мне?! Ты?!"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:93 #-#-# translate crowdin gallery_d_026_07727b41:
msgid "[_cedrick_] Смею. Вы не уйдете отсюда, пока ты не сделаешь то, чего я хочу"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:97 #-#-# translate crowdin gallery_d_026_bff80c72_1:
msgid "[_evangelin_] Что?!"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:101 #-#-# translate crowdin gallery_d_026_ffc56f4e:
msgid "[_cedrick_] Представь, как себя будет чувствовать бедняжка Амалия, когда узнает, что из-за тебя вы не смогли телепортироваться..."
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:105 #-#-# translate crowdin gallery_d_026_44822fc5:
msgid "[_evangelin_] Я..."
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:106 #-#-# translate crowdin gallery_d_026_c5379a22:
msgid "[_cedrick_] У тебя нет других вариантов, пойми"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:110 #-#-# translate crowdin gallery_d_026_a4bde335:
msgid "[_evangelin_] Есть. Я могу прикончить тебя прямо здесь"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:111 #-#-# translate crowdin gallery_d_026_b4f3a947:
msgid "[_cedrick_] И что? Вы без меня никуда не уйдете, а буквально каждый здешний воин будет охотиться на вас. И они менее благоразумные, чем я"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:112 #-#-# translate crowdin gallery_d_026_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:114 #-#-# translate crowdin gallery_d_026_988d0c8b:
msgid "[_centered_] {size=37} Спустя несколько минут Евангелина поддается вашим уговорам... {/size}"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:117 #-#-# translate crowdin gallery_d_026_53959500:
msgid "[_evangelin_] Какая гадость"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:118 #-#-# translate crowdin gallery_d_026_89764829:
msgid "[_cedrick_] Амалия подобного о моем члене не говорила"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:121 #-#-# translate crowdin gallery_d_026_da445c97:
msgid "[_evangelin_] О-о чем ты?"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:122 #-#-# translate crowdin gallery_d_026_532f0fe1:
msgid "[_cedrick_] Амалия отсасывала мне под столом, пока ты сидела без сознания. Но не вини ее. Странный цветок заставил ее сделать это"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:125 #-#-# translate crowdin gallery_d_026_34a89f11:
msgid "[_evangelin_] Что?"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:126 #-#-# translate crowdin gallery_d_026_da7673a1:
msgid "[_cedrick_] Молчать. Продолжай делать то, что делала"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:129 #-#-# translate crowdin gallery_d_026_c04d209d:
msgid "[_evangelin_] Но..."
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:130 #-#-# translate crowdin gallery_d_026_e312668e:
msgid "[_cedrick_] Молчать!.. Амалия так страстно игралась с моим членом, словно всю жизнь только его и ждала. Каждый толчок, каждое движение языка заставляло дрожать как меня, так и ее"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:133 #-#-# translate crowdin gallery_d_026_87d62a03:
msgid "[_evangelin_] Ах..."
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:134 #-#-# translate crowdin gallery_d_026_9d12e3f2:
msgid "[_cedrick_] Что и требовалось доказать. Ты хочешь Амалию и никакие отговорки тебе не помогут. Знаешь, я ведь могу помочь, Евангелина"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:137 #-#-# translate crowdin gallery_d_026_796828ec:
msgid "[_evangelin_] Как?"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:138 #-#-# translate crowdin gallery_d_026_3b1532d1:
msgid "[_cedrick_] Я могу сделать так, чтобы Амалия захотела и тебя. Но, ты должна подыграть мне"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:141 #-#-# translate crowdin gallery_d_026_c7b5b063:
msgid "[_evangelin_] Я не собираюсь тебе помогать в чем-либо"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:142 #-#-# translate crowdin gallery_d_026_39317915:
msgid "[_cedrick_] Зря. Очень зря"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:144 #-#-# translate crowdin gallery_d_026_b9b685bd:
msgid "[_evangelin_] Когда ты уже кончишь!"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:146 #-#-# translate crowdin gallery_d_026_7258fdde:
msgid "Евангелина ускоряется"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:149 #-#-# translate crowdin gallery_d_026_aec9b0f4:
msgid "[_cedrick_] Почти... Кончаю!"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:153 #-#-# translate crowdin gallery_d_026_bc5b46a8:
msgid "Сперма Седрика заливает всю грудь и лицо Евангелины"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:155 #-#-# translate crowdin gallery_d_026_f6898a54:
msgid "[_evangelin_] Всю меня залил!"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:156 #-#-# translate crowdin gallery_d_026_91a5e3d9:
msgid "Амалия входит в комнату"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:159 #-#-# translate crowdin gallery_d_026_36f1161e:
msgid "[_amalia_] Евангелина, я нашла портал! Осталось найти капли и..."
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:165 #-#-# translate crowdin gallery_d_026_22db93d8:
msgid "Амалия замечает голую Евангелину"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:169 #-#-# translate crowdin gallery_d_026_c78ea191:
msgid "[_amalia_] Почему.."
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:173 #-#-# translate crowdin gallery_d_026_54af8b7b:
msgid "Амалия убегает"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:176 #-#-# translate crowdin gallery_d_026_943f1692:
msgid "[_evangelin_] Что мы наделали, Седрик?"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:177 #-#-# translate crowdin gallery_d_026_4b3a3866:
msgid "[_cedrick_] Ничего плохого"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:181 #-#-# translate crowdin gallery_d_026_0f3ada89:
msgid "[_evangelin_] Ты идиот?! У меня ведь теперь нет шансов! И где нам ее искать?"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:182 #-#-# translate crowdin gallery_d_026_229cc380:
msgid "[_cedrick_] Точно не знаю, но у меня есть предположение.."
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:187 #-#-# translate crowdin gallery_d_026_05cdc11f:
msgid "[_evangelin_] Тогда веди. Надеюсь, что мы найдем ее"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:189 #-#-# translate crowdin gallery_d_026_ac07cbd7:
msgid "[_centered_] {size=37}Некоторое время вы с Евангелиной занимаетесь поисками Амалии.. {/size}"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:193 #-#-# translate crowdin gallery_d_026_4b8d6f3c:
msgid "[_cedrick_] Знаешь, а так даже лучше. Тебе так будет легче"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:194 #-#-# translate crowdin gallery_d_026_65f8f649_1:
msgid "[_evangelin_] О чем ты?"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:195 #-#-# translate crowdin gallery_d_026_ab5f72e8:
msgid "[_cedrick_] Не глупи, ты сама понимаешь. Тебе же хочется быть с Амалией"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:196 #-#-# translate crowdin gallery_d_026_95d571ef:
msgid "[_evangelin_] Даже если и так, то ты как поможешь?"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:197 #-#-# translate crowdin gallery_d_026_df8fdf03:
msgid "[_cedrick_] Буду использовать наивность Амалии. Если ты ее хочешь, то пообещай подыграть мне"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:198 #-#-# translate crowdin gallery_d_026_e9615cdc:
msgid "[_evangelin_] Но... Это плохо. Очень плохо. Я не могу так поступить"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:199 #-#-# translate crowdin gallery_d_026_37fdd110:
msgid "[_cedrick_] Все это нелепые отговорки, Евангелина. Соглашайся, и я сделаю то, на что ты сама не могла решиться"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:200 #-#-# translate crowdin gallery_d_026_bca0e490:
msgid "[_evangelin_] Хорошо, но... Обещай, что отпустишь нас."
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:201 #-#-# translate crowdin gallery_d_026_5624dab5:
msgid "[_cedrick_] Обещаю"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:205 #-#-# translate crowdin gallery_d_027_8e156a47:
msgid "[_evangelin_] Где же ты, Амалия..."
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:206 #-#-# translate crowdin gallery_d_027_6b087891:
msgid "Евангелина и Седрик замечают Амалию, сидящую на поляне"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:210 #-#-# translate crowdin gallery_d_027_00aec173:
msgid "[_amalia_] Закончили?"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:214 #-#-# translate crowdin gallery_d_027_0c68497a:
msgid "[_evangelin_] Амалия, прости, я не знаю, что на меня нашло..."
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:218 #-#-# translate crowdin gallery_d_027_3dc7789e:
msgid "[_amalia_] Не извиняйся, я тебя понимаю. Седрик, а ты... Как ты мог воспользоваться нашей слабостью?"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:222 #-#-# translate crowdin gallery_d_027_c8a86ccc:
msgid "[_cedrick_] Простите меня, но я не смог устоять"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:226 #-#-# translate crowdin gallery_d_027_da19384e:
msgid "[_amalia_] Это все не важно, на самом деле. Мы так и не нашли Капли, так что теперь не сможем покинуть это место"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:230 #-#-# translate crowdin gallery_d_027_eb8ce2e3:
msgid "[_evangelin_] Они у Седрика. Но Капли он не отдаст просто так"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:231 #-#-# translate crowdin gallery_d_027_db5304eb:
msgid "[_cedrick_] Верно, я не могу отпустить вас просто так"
msgstr ""

# game/scripts/quests/girlInFlask/visit_amalia_and_evangeline_at_the_tavern.rpy:235 #-#-# translate crowdin gallery_d_027_7eb917b5:
msgid "[_amalia_] И что тебе нужно?"
msgstr ""

