# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:6 #-#-# translate crowdin gallery_d_042_8d7672ed:
msgid "[_cedrick_] Ну как ты здесь? Нравится новая квартира?"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:10 #-#-# translate crowdin gallery_d_042_be3557b7:
msgid "[_cornelia_] П-пошел ты! Думаешь я прощу тебя после всего, что ты сделал. Особенно после того, как отдал меня той твари с щупальцами"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:14 #-#-# translate crowdin gallery_d_042_602ef0a6:
msgid "[_cedrick_] Ох, все еще не можешь забыть? Но ты немного ошиблась, дорогая. Я сюда не за прощением пришел"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:15 #-#-# translate crowdin gallery_d_042_f73921d2:
msgid "[_cedrick_] Ты моя пленница, я теперь могу делать с тобой все, что захочу, ты понимаешь?"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:19 #-#-# translate crowdin gallery_d_042_066d016f:
msgid "[_cornelia_] Пошел ты!"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:23 #-#-# translate crowdin gallery_d_042_0ac4a668:
msgid "[_cedrick_] ..В том числе могу отдать той сундучной твари на съедение"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:27 #-#-# translate crowdin gallery_d_042_cf290901:
msgid "[_cornelia_] ......."
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:28 #-#-# translate crowdin gallery_d_042_f927d798:
msgid "[_cedrick_] Еще раз. Ты теперь моя пленница и я буду делать с тобой все, что захочу, ты меня поняла?"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:32 #-#-# translate crowdin gallery_d_042_fd1e04c9:
msgid "[_cornelia_] Я... Я тебя поняла"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:36 #-#-# translate crowdin gallery_d_042_7424b3cd:
msgid "[_cedrick_] Что за фамильярность? Пойми наконец, в каком ты положении, я ведь могу и к твоей сестре наведываться"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:40 #-#-# translate crowdin gallery_d_042_24f393cb:
msgid "[_cornelia_] ...Я поняла, Лорд Седрик"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:44 #-#-# translate crowdin gallery_d_042_c005b354:
msgid "[_cedrick_] То-то же. А теперь вставай на колени, будешь привыкать к новой роли рабыни"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:46 #-#-# translate crowdin gallery_d_042_cedb97c6:
msgid "[_cornelia_] ......"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:49 #-#-# translate crowdin gallery_d_042_ca83f8c8:
msgid "[_cedrick_] Оххх, черт, а ты довольно хороша в этом деле. Смотрю, было много опыта?"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:51 #-#-# translate crowdin gallery_d_042_19c1e662:
msgid "[_cornelia_] Мммв!"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:52 #-#-# translate crowdin gallery_d_042_a1a80f45:
msgid "[_cedrick_] Ах, точно, у тебя занят рот. Ну, если хочешь мне что-то сказать, тогда тебе лучше поскорее сделать так, чтобы я кончил"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:54 #-#-# translate crowdin gallery_d_042_cedb97c6_1:
msgid "[_cornelia_] ......"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:55 #-#-# translate crowdin gallery_d_042_e9606201:
msgid "[_cedrick_] Хооо? И вправду ускорила темп. Послушная девочка, я думаю ты быстро всему научишься"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:57 #-#-# translate crowdin gallery_d_042_9cc78f09:
msgid "[_cornelia_] Вввмв!!"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:58 #-#-# translate crowdin gallery_d_042_020a4a71:
msgid "[_cornelia_] (Его член даже толще, чем щупальца того чудовища.. Как же тяжело управляться с этой штукой..)"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:59 #-#-# translate crowdin gallery_d_042_bc827f5a:
msgid "[_cedrick_] Тааак... Я близок.."
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:61 #-#-# translate crowdin gallery_d_042_9d40362e:
msgid "[_cornelia_] Ммммм.."
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:62 #-#-# translate crowdin gallery_d_042_4e299f3a:
msgid "[_cedrick_] Получай!"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:63 #-#-# translate crowdin gallery_d_042_a62dcc06:
msgid "[_cornelia_] Ввввввммм!"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:65 #-#-# translate crowdin gallery_d_042_8b1d69f0:
msgid "[_cornelia_] Ч-черт, почему так много..."
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:68 #-#-# translate crowdin gallery_d_042_3827f30e:
msgid "[_cedrick_] Хорошая девочка. Ну так, что ты хотела мне сказать?"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:72 #-#-# translate crowdin gallery_d_042_56fd6af7:
msgid "[_cornelia_] ...Они тебя остановят"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:76 #-#-# translate crowdin gallery_d_042_5d442675:
msgid "[_cedrick_] Кто, стражницы-то?"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:80 #-#-# translate crowdin gallery_d_042_bae08c7e:
msgid "[_cornelia_] Ты еще получишь по заслугам, ублюдок!"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:84 #-#-# translate crowdin gallery_d_042_c8114a1f:
msgid "[_cedrick_] Ох, все еще сопротивляешься. Это заводит. Посмотрим, как ты запоешь, когда пустые камеры начнут пополняться твоими подругами"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon.rpy:88 #-#-# translate crowdin gallery_d_042_593b948f:
msgid "[_cornelia_] ........"
msgstr ""

