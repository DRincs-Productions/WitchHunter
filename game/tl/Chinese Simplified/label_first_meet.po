# TODO: Translation updated at 2023-07-25 15:55 #|#|# # game/label_first_meet.rpy:4 #-#-# translate crowdin first_meet_8bd86d07:
msgid "[_cedrick_] Что-ж, пока никто сюда не явился, самое время начать изучать местные книги"
msgstr "[_cedrick_] 好了，在其他人到达之前，是时候开始查看本地书籍了。"

# game/label_first_meet.rpy:6 #-#-# translate crowdin first_meet_70cfdf98:
msgid "[_centered_] {size=37}СПУСТЯ КАКОЕ-ТО ВРЕМЯ{/size}"
msgstr "[_centered_] {size=37}稍后{/size}。"

# game/label_first_meet.rpy:10 #-#-# translate crowdin first_meet_7d5cbc05:
msgid "[_cedrick_] Хм, в целом, как я и предполагал, здешняя речь построена куда проще нашей, но при этом имеет куда больше простолюдинских слов и выражений"
msgstr "[_cedrick_] 嗯，总的来说，正如我所猜测的那样，这里的语言比我们的简单得多，但有更多的常用词和表达方式"

# game/label_first_meet.rpy:11 #-#-# translate crowdin first_meet_4056e326:
msgid "[_cedrick_] Мудак. Гандон. Еблан. Столько одинаковых по смыслу, но разных по значению нецензурных слов… Интересно"
msgstr "[_塞德里克_] Asshole. Prick. Dickhead. 这么多意思相近但意义不同的粗话… 有意思"

# game/label_first_meet.rpy:14 #-#-# translate crowdin first_meet_cec43db9:
msgid "[_cedrick_] Хах, а для здешнего мира Гитлер был тот еще мудак. На Меридиане его бы сделали одним из главных ораторов или полководцев.. Хотя в конечном итоге все равно повесили бы. Фобос бы его казнил только за одни эти усишки"
msgstr "[_塞德里克_] 在这个世界里，希特勒是个混蛋。在子午湾，人们会让他成为顶级演说家或将军之一。但最终，他还是会被绞死。光是那一撮小胡子，佛博斯就会处死他。"

# game/label_first_meet.rpy:17 #-#-# translate crowdin first_meet_f225dd23:
msgid "[_cedrick_] Хм, рабство отменено практически во всем мире, но при этом разделение на богатых и бедных столь колоссально, что многие люди сами бы не отказались стать рабами, если бы у них взамен была еда и крыша над головой"
msgstr "[_塞德里克_] 嗯，世界上大部分地方都废除了奴隶制，但贫富差距依旧如此严重，许多人宁愿成为奴隶，只为了吃的上饭和有个睡觉的地方"

# game/label_first_meet.rpy:18 #-#-# translate crowdin first_meet_a4891000:
msgid "[_cedrick_] В основном же люди просто бесконечно работают за мировую валюту 80 процентов времени, чтобы оставались в тепле и сытости остальные 20 процентов"
msgstr "[_塞德里克_] 人们基本上80%的时间都在上班赚钱，这样他们才能够在剩下20%的时间里吃饱穿暖。"

# game/label_first_meet.rpy:19 #-#-# translate crowdin first_meet_d3b1fe87:
msgid "[_cedrick_] И при этом никто не считает себя рабом, забавно. На Меридиане все куда честнее, ты либо властвуешь над всеми, либо о тебя вытирают ноги"
msgstr "[_塞德里克_] 有趣的是，大家都不觉得自己是奴隶。而在子午湾上，情况要简单得多，要么你凌驾于所有人之上，要么你就是跪着要饭的。"

# game/label_first_meet.rpy:22 #-#-# translate crowdin first_meet_fcdbc8c1:
msgid "[_cedrick_] Закон о нравственности, закон об оскорблениях, закон о домогательствах, закон об избиении.. Тут можно спокойно угодить под стражу за то, что на Меридиане считается абсолютной нормой, нужно быть осторожнее"
msgstr "[_塞德里克_] 各式的法律条文规章制度，例如殴打，侮辱，骚扰等行为... 在子午湾，这些是被认为绝对合理合法的行为。但在这个世界很容易被关进监狱，你必须小心谨慎。"

# game/label_first_meet.rpy:25 #-#-# translate crowdin first_meet_32e969f8:
msgid "[_cedrick_] Хм, обходить закон путем манипуляции и лжи, очень похоже на наши дворцовые интриги. А этот Мориарти интересный персонаж, есть чему поучиться"
msgstr "[_塞德里克_] 嗯，通过语言和技巧钻法律的空子，和我们的宫斗手段很像。这个莫里亚蒂是个有趣的人物，值得我们学习。"

# game/label_first_meet.rpy:28 #-#-# translate crowdin first_meet_5f4309e4:
msgid "[_cedrick_] О, а вот это интересно. Теперь я понимаю, почему у них так много законов, защищающих нравственность. Местным людям так легко нанести психологический или моральный вред."
msgstr "[_塞德里克_] 哦，真有意思。现在我明白为什么他们有那么多保护道德的法律了。当地人很容易受到心理或道德上的伤害。"

# game/label_first_meet.rpy:29 #-#-# translate crowdin first_meet_6f6377bc:
msgid "[_cedrick_] Фобос говорил, что эмоциональная нестабильность и подавленность влияют на использование магических сил. Значит, я могу использовать это на стражницах"
msgstr "[_塞德里克_] 菲比斯说，情绪不稳定和抑郁会影响魔力的施法效果。所以我可以把它用在守卫身上。"

# game/label_first_meet.rpy:30 #-#-# translate crowdin first_meet_3afae274:
msgid "[_cedrick_] Так-так-так, видим одним из самых сильных эмоциональных потрясений для здешних представительниц женского пола – это сексуальное домогательство и психологическое насилие"
msgstr "[_塞德里克_] 好好好，我们看到这里的妇女受到最大的痛苦就是性骚扰和精神打击"

# game/label_first_meet.rpy:31 #-#-# translate crowdin first_meet_12757212:
msgid "[_cedrick_] Да уж.. Для большинства женщин Меридиана это обычный вторник, их бы подобные вещи ни капли бы не задели"
msgstr "[_塞德里克_] 是啊... 对大多数女人来说，这只是个普通的周二，她们丝毫不会受到这种事情的影响"

# game/label_first_meet.rpy:32 #-#-# translate crowdin first_meet_87bdfb72:
msgid "[_cedrick_] Значит, мне не нужно использовать форму змея, чтобы победить стражниц. Я могу просто психологически ломать их и сексуально домогаться, так их магия станет слабее и они станут легкими жертвами"
msgstr " [_塞德里克_] 所以，我不需要用蛇形态来打败守卫。我只需从心理上击垮他们，对他们进行性骚扰，这样他们的魔法就会变弱，我就可以控制她们了"

# game/label_first_meet.rpy:33 #-#-# translate crowdin first_meet_814956f4:
msgid "[_cedrick_] Что ж, таким и будет мой план действий. Нужно напасть на каждую из стражниц, но калеча не их тело, а их дух, так они со временем станут слабее и не смогут дать мне отпор"
msgstr "[_塞德里克_] 这就是我的行动计划。我必须攻击每一个守卫，但不是伤害他们的身体，而是摧毁他们的意志，最终他们会变得虚弱，无法对我进行反制"

# game/label_first_meet.rpy:42 #-#-# translate crowdin first_meet_bcbbf6e5:
msgid "[_cedrick_] ({i}Кажется кто-то идет..{/i})"
msgstr "[_塞德里克_] ({i}我察觉到有人来了...{/i})"

# game/label_first_meet.rpy:55 #-#-# translate crowdin first_meet_f8211dbf:
msgid "[_girl_] Здравствуйте."
msgstr "[_女生_] 你好"

# game/label_first_meet.rpy:63 #-#-# translate crowdin first_meet_f51b30ca:
msgid "[_girl_] Эм, Где я смогу найти учебники для старшей школы?"
msgstr "[_女生_] 请问在哪里可以找到高中教科书？"

# game/label_first_meet.rpy:64 #-#-# translate crowdin first_meet_80b8cbbe:
msgid "[_cedrick_sprite_] Скорее всего они в задней части магазина, но я в этом не уверен..."
msgstr "[_塞德里克_] 它们很可能在书架后面，但我不敢确定....."

# game/label_first_meet.rpy:65 #-#-# translate crowdin first_meet_45a1c8cb:
msgid "[_cedrick_sprite_] Я все еще пытаюсь организоваться здесь..."
msgstr "[_塞德里克_] 我还在努力整理整个书店..."

# game/label_first_meet.rpy:72 #-#-# translate crowdin first_meet_6e216229:
msgid "[_girl_] Ох да? Похоже на меня. Пытаться все организовать.."
msgstr "[_女生_] 哦，是吗？我也是一个完美主义者，想把一切都安排好"

# game/label_first_meet.rpy:79 #-#-# translate crowdin first_meet_38a2a005:
msgid "[_cornelia_] Кстати, меня зовут Корнелия..."
msgstr "[_康妮莉娅_] 哦对了，我的名字是康妮莉娅..."

# game/label_first_meet.rpy:85 #-#-# translate crowdin first_meet_d0567760:
msgid "[_elion_] Элион Браун. Привет."
msgstr "[_艾莉恩_] 你好，我是艾莉恩-布朗。"

# game/label_first_meet.rpy:91 #-#-# translate crowdin first_meet_702f0926:
msgid "[_cedrick_sprite_] (Корнелия? Кажется я уже видел ее, эта одна из Стражниц, что она здесь делает?)"
msgstr "[_塞德里克_] (康妮莉娅？我好像见过她，是守卫之一，她在这里做什么?）"

# game/label_first_meet.rpy:92 #-#-# translate crowdin first_meet_3fc2be54:
msgid "[_cedrick_sprite_] Кхм.. Рик Хофман."
msgstr "[_塞德里克_] 里克-霍夫曼"

# game/label_first_meet.rpy:93 #-#-# translate crowdin first_meet_1977ebce:
msgid "[_cedrick_sprite_] Простите за бардак."
msgstr "[_塞德里克_] 很抱歉这里乱糟糟的。"

# game/label_first_meet.rpy:94 #-#-# translate crowdin first_meet_d32e0525:
msgid "[_cedrick_sprite_] Мне нужно время, чтобы разобраться во всем.."
msgstr "[_塞德里克_] 我需要一点时间去整理。"

# game/label_first_meet.rpy:100 #-#-# translate crowdin first_meet_9af8a627:
msgid "[_elion_] Ох, я прекрасно понимаю каково это"
msgstr "[_艾莉恩_] 哦，我懂你"

# game/label_first_meet.rpy:106 #-#-# translate crowdin first_meet_b29fa0ea:
msgid "[_cornelia_] Ну, я пойду, поищу нужную мне книгу истории. Как будто это мне пригодится... Средневековье и прочая ерунда.."
msgstr "[_康妮莉娅_] 我去找我需要的历史书... 中世纪相关的"

# game/label_first_meet.rpy:117 #-#-# translate crowdin first_meet_8612af30:
msgid "[_elion_] Хех, Корнелия моя лучшая подруга."
msgstr "[_艾莉恩_] 康妮莉娅是我最好的朋友"

# game/label_first_meet.rpy:119 #-#-# translate crowdin first_meet_f6845a2a:
msgid "[_cedrick_sprite_] ({i}.....{/i})"
msgstr "[_塞德里克_] ({i}.....{/i}))"

# game/label_first_meet.rpy:126 #-#-# translate crowdin first_meet_e785f61d:
msgid "[_elion_] Кстати, что эта за штуковина?"
msgstr "[_艾莉恩_] 对了，这是什么？"

# game/label_first_meet.rpy:131 #-#-# translate crowdin first_meet_9f574676:
msgid "[_elion_] Мне кажется, словно она притягивает меня, хех... Глупо, не правда ли?"
msgstr "[_艾莉恩_] 它在发光欸，是因为我吗？"

# game/label_first_meet.rpy:132 #-#-# translate crowdin first_meet_20d88b75:
msgid "[_cedrick_sprite_] ({i}Хм ...И это наследница Меридиана? И похоже, что она подруга одной из стражниц завесы... Интересно..{/i})"
msgstr "[_塞德里克_] ({i}嗯......这就是子午湾的继承人？她和一个守卫是朋友....。有意思)"

# game/label_first_meet.rpy:133 #-#-# translate crowdin first_meet_573ef631:
msgid "[_cedrick_sprite_] Обычная безделушка, можешь оставить ее себе, если она тебе так приглянулась."
msgstr "[_塞德里克_] 这只是个小挂饰，如果你很喜欢，可以拿着。"

# game/label_first_meet.rpy:139 #-#-# translate crowdin first_meet_6518514d:
msgid "[_elion_] Нет! Спасибо за щедрость, но эта штука меня пугает..."
msgstr "[_艾莉恩_] 不！谢谢你，但这东西让我感到害怕.....。"

# game/label_first_meet.rpy:154 #-#-# translate crowdin first_meet_bbddcdfd:
msgid "[_cornelia_] К сожалению, Я не нашла нужную книгу... Элион, пошли посмотрим в другом месте.."
msgstr "[_康妮莉娅_] 可惜了，我没有找到我想要的书....。艾莉恩，我们去别的地方找找吧。"

# game/label_first_meet.rpy:155 #-#-# translate crowdin first_meet_37db0a62:
msgid "[_cedrick_sprite_] Простите, я еще не успел все выставить... Вполне вероятно, что нужная вам книга находится где-то в коробках..."
msgstr "[_塞德里克_] 抱歉，我还没来得及把所有的书籍都放上书架.... 您需要的书很可能就在某个箱子里...."

# game/label_first_meet.rpy:156 #-#-# translate crowdin first_meet_fad3e6b3:
msgid "[_cedrick_sprite_] Вы можете оставить свои адреса и я доставлю эти книги прямо вам домой."
msgstr "[_塞德里克_] 您可以留下住址，我可以直接把这些书送到您家。"

# game/label_first_meet.rpy:159 #-#-# translate crowdin first_meet_38164c3e:
msgid "[_cornelia_] А может мы просто дадим вам наши мобильные номера и вы сообщите когда найдете книги?"
msgstr "[_康妮莉娅_] 要不我们把手机号码给你，你找到书后告诉我们？"

# game/label_first_meet.rpy:160 #-#-# translate crowdin first_meet_e00b6067:
msgid "[_cedrick_]  Эм... К сожалению, я недавно потерял свой телефон..."
msgstr "[_塞德里克_]  嗯... 不幸的是，手机被我弄丢了...."

# game/label_first_meet.rpy:166 #-#-# translate crowdin first_meet_d6a93290:
msgid "[_cornelia_] Вы потеряли свой мобильник? Ну вы даете..."
msgstr "[_cornelia_] 你的手机丢了？得了吧"

# game/label_first_meet.rpy:172 #-#-# translate crowdin first_meet_6c6af52e:
msgid "[_cornelia_] Похоже, что вы слишком сильно отвлекаетесь на книги..."
msgstr "[_cornelia_] 听起来你被书本分散了太多注意力...."

# game/label_first_meet.rpy:176 #-#-# translate crowdin first_meet_ccf65cb3:
msgid "[_elion_] Корнелия... это не очень вежливо..."
msgstr "[_elion_] 科妮莉亚... 这可不太礼貌"

# game/label_first_meet.rpy:180 #-#-# translate crowdin first_meet_055d661a:
msgid "[_cornelia_] Ой, простите..."
msgstr "[_cornelia_] 哦，对不起..."

# game/label_first_meet.rpy:184 #-#-# translate crowdin first_meet_54b90254:
msgid "[_cedrick_] Хах, ничего страшного. Похоже я и вправду провожу слишком много времени с книгами..."
msgstr "[_cedrick_] 没什么大不了的。我想我确实花了太多时间在书本上.....。"

# game/label_first_meet.rpy:189 #-#-# translate crowdin first_meet_dcd3b9b7:
msgid "[_cedrick_] Думаю, мне стоит купить новый телефон..."
msgstr "[_cedrick_] 我想我应该换一部新手机....."

# game/label_first_meet.rpy:192 #-#-# translate crowdin first_meet_13734343:
msgid "[_cornelia_] Ну, раз так... Мы оставим вам свои адреса..."
msgstr "[_cornelia_] 如果是这样的话我们会把地址留给你"

# game/label_first_meet.rpy:193 #-#-# translate crowdin first_meet_dcd297c6:
msgid "[_cedrick_] Хорошо "
msgstr "[_cedrick_] 好的 "

# game/label_first_meet.rpy:194 #-#-# translate crowdin first_meet_a20cefa7:
msgid "..."
msgstr "..."

# game/label_first_meet.rpy:197 #-#-# translate crowdin first_meet_35266b84:
msgid "[_elion_] Была рада познакомиться с тобой, Рик. Нам нужно идти..."
msgstr "[_elion_] 很高兴见到你，里克我们该走了"

# game/label_first_meet.rpy:198 #-#-# translate crowdin first_meet_64f29f0b:
msgid "[_elion_] Пока!"
msgstr "[_elion_] 再见！"

# game/label_first_meet.rpy:204 #-#-# translate crowdin first_meet_590b16b1:
msgid "Вы получили адрес Корнелии."
msgstr "你有科妮莉亚的地址"

# game/label_first_meet.rpy:205 #-#-# translate crowdin first_meet_2fad7b0a:
msgid "Вы получили адрес Элион."
msgstr "你有伊利昂的地址"

# game/label_first_meet.rpy:213 #-#-# translate crowdin first_meet_5e6a07aa:
msgid "[_cedrick_] ({i}Похоже, что Звезда Трибы и вправду сработала... Нужно сообщить об этом принцу Фобосу.{/i})"
msgstr "[_cedrick_] ({i}看来部落之星真的起作用了....。我们必须通知火卫一王子。)"

