# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:146 #-#-# translate crowdin gallery_d_089_a246ed11:
msgid "[_cedrick_] (Это... Это полнейший провал... Я только что потерпел полный крах, потеряв не только лидера стражниц, но, что еще хуже, я потерял Миранду...)"
