# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:140 #-#-# translate crowdin gallery_d_089_daaff678:
msgid "[_cedrick_] (Эта тварь... Мимик... Видимо он способен воздействовать на сознание, добравшись щупальцами до мозга... Черт черт черт...)"
msgstr "[_cedrick_] (Эта тварь... Мимик... Видимо он способен воздействовать на сознание, добравшись щупальцами до мозга... Черт черт черт...)"

# game/scripts/quests/questTrainingOfGuards/check_out_will_in_the_dungeon.rpy:142 #-#-# translate crowdin gallery_d_089_3c4673cb:
