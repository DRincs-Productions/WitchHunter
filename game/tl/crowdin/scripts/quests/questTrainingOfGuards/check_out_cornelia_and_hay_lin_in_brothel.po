msgstr "[_cedrick_] Эм..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:325 #-#-# translate crowdin gallery_d_095_e97df5aa:
msgid "[_cornelia_] А чего ты удивляешься? Ты довольно давно не трахал меня. Мое тело изголодалось. Или же ты забыл о том, что говорил мне?"
msgstr "[_cornelia_] А чего ты удивляешься? Ты довольно давно не трахал меня. Мое тело изголодалось. Или же ты забыл о том, что говорил мне?"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:329 #-#-# translate crowdin gallery_d_095_d577744a:
msgid "[_cornelia_] Я же все еще нужна тебе, верно?"
msgstr "[_cornelia_] Я же все еще нужна тебе, верно?"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:333 #-#-# translate crowdin gallery_d_095_cff4d6b7:
msgid "[_cedrick_] (Хах, что ж... В случае с ней сила короля морпионов все же сослужила мне какую-то службу. В ее симпатии сомневаться не приходится)"
msgstr "[_cedrick_] (Хах, что ж... В случае с ней сила короля морпионов все же сослужила мне какую-то службу. В ее симпатии сомневаться не приходится)"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:334 #-#-# translate crowdin gallery_d_095_01dc0a53:
