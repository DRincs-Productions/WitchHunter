msgstr "[_cornelia_] Да и мы, если бы могли освободить Меридиан от гнета Фобоса, то давно бы уже сделали это"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:388 #-#-# translate crowdin gallery_d_095_b1ebf931:
