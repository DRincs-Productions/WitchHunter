msgstr "[_cedrick_] (Интересно, на столько же ли это очевидно для самого Фобоса?)"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:384 #-#-# translate crowdin gallery_d_095_4e4b0052:
