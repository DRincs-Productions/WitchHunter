msgstr "[_cornelia_] Седрик, я почти что начала встречаться с Калебом, буквально командиром повстанцев"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:364 #-#-# translate crowdin gallery_d_095_49b97496:
msgid "[_cornelia_] За это время я начала кое-что понимать. Как минимум человека, который желает свергнуть Фобоса, я сразу смогу распознать"
msgstr "[_cornelia_] За это время я начала кое-что понимать. Как минимум человека, который желает свергнуть Фобоса, я сразу смогу распознать"

