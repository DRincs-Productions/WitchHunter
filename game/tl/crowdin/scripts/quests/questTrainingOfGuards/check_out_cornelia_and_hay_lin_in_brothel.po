msgstr "[_cedrick_] Боже, Хай Лин, что они с тобой сделали"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:226 #-#-# translate crowdin gallery_d_095_fb98f518:
msgid "[_haylin_] Р-рик!? Фто значит они со мной сделали? Это ты сделал это со мной!"
msgstr "[_haylin_] Р-рик!? Фто значит они со мной сделали? Это ты сделал это со мной!"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:227 #-#-# translate crowdin gallery_d_095_48fed7dc:
msgid "[_cedrick_] Н-но не я же связал тебя..."
msgstr "[_cedrick_] Н-но не я же связал тебя..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:228 #-#-# translate crowdin gallery_d_095_7aaa836d:
msgid "[_haylin_] Но это тфоими силами я оказалась фдесь... Если бы не ты, всего бы этого не произошло... Бофе, как я от всего этого уфтала..."
msgstr "[_haylin_] Но это тфоими силами я оказалась фдесь... Если бы не ты, всего бы этого не произошло... Бофе, как я от всего этого уфтала..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:229 #-#-# translate crowdin gallery_d_095_9a2b4629:
msgid "[_cedrick_] (Мда, ее здесь продержали явно дольше, чем следовало... Хм, ладно, нужно придерживаться сценария...)"
msgstr "[_cedrick_] (Мда, ее здесь продержали явно дольше, чем следовало... Хм, ладно, нужно придерживаться сценария...)"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:230 #-#-# translate crowdin gallery_d_095_fd3d6ed7:
msgid "[_cedrick_] Хай Лин, прости, но в первую очередь я выполнял приказ от Фобоса"
msgstr "[_cedrick_] Хай Лин, прости, но в первую очередь я выполнял приказ от Фобоса"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:232 #-#-# translate crowdin gallery_d_095_ca7f7dc5:
msgid "[_haylin_] Так шначит это Фобос зафтавил тебя заняться сексом с моей мамой!? Боже, бедный папа... Ефли он узнает..."
msgstr "[_haylin_] Так шначит это Фобос зафтавил тебя заняться сексом с моей мамой!? Боже, бедный папа... Ефли он узнает..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:233 #-#-# translate crowdin gallery_d_095_ded2ae53:
msgid "[_cedrick_] Так, давай-ка я освобожу тебя для начала. Хотя бы сниму кляп и повязку"
msgstr "[_cedrick_] Так, давай-ка я освобожу тебя для начала. Хотя бы сниму кляп и повязку"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:238 #-#-# translate crowdin gallery_d_095_22c03a20:
msgid "[_haylin_] Аххх... Боже... Теперь даже свет тусклой комнаты кажется таким ярким..."
msgstr "[_haylin_] Аххх... Боже... Теперь даже свет тусклой комнаты кажется таким ярким..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:239 #-#-# translate crowdin gallery_d_095_554bb58d:
msgid "[_cedrick_] Хай Лин, я бы освободил твои руки, но тогда это вызовет подозрения у смотрящей за тобой девушки"
msgstr "[_cedrick_] Хай Лин, я бы освободил твои руки, но тогда это вызовет подозрения у смотрящей за тобой девушки"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:241 #-#-# translate crowdin gallery_d_095_619cda06:
msgid "[_haylin_] Ч-что?... О чем ты вообще"
msgstr "[_haylin_] Ч-что?... О чем ты вообще"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:242 #-#-# translate crowdin gallery_d_095_c103fcd0:
msgid "[_cedrick_] Я введу тебя в курс дела, но перед этим... Кхм, мне придется трахнуть тебя"
msgstr "[_cedrick_] Я введу тебя в курс дела, но перед этим... Кхм, мне придется трахнуть тебя"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:244 #-#-# translate crowdin gallery_d_095_7aa27891:
msgid "[_haylin_] Серьезно... Да как ты только..."
msgstr "[_haylin_] Серьезно... Да как ты только..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:249 #-#-# translate crowdin gallery_d_095_9c126dc4:
msgid "[_haylin_] Аааахххх..."
msgstr "[_haylin_] Аааахххх..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:250 #-#-# translate crowdin gallery_d_095_a6e2aaf1:
msgid "[_cedrick_] Хай Лин, выслушай меня... Все серьезнее, чем кажется..."
msgstr "[_cedrick_] Хай Лин, выслушай меня... Все серьезнее, чем кажется..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:252 #-#-# translate crowdin gallery_d_095_914bf3a7:
msgid "[_haylin_] Ах, значит теперь ты трахаешь меня серьезно? Мммхх... Ч-черт, почему же он так туго ощущается во мне..."
msgstr "[_haylin_] Ах, значит теперь ты трахаешь меня серьезно? Мммхх... Ч-черт, почему же он так туго ощущается во мне..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:254 #-#-# translate crowdin gallery_d_095_b47aaa68:
msgid "[_cedrick_] Хай Лин... Из-за того, что я собрал вас всех вместе, поймал всех стражниц, как мне и было приказано... Из-за этого Фобос перешел к следующей части своего плана"
msgstr "[_cedrick_] Хай Лин... Из-за того, что я собрал вас всех вместе, поймал всех стражниц, как мне и было приказано... Из-за этого Фобос перешел к следующей части своего плана"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:256 #-#-# translate crowdin gallery_d_095_e33e6e4c:
msgid "[_haylin_] Аааххх... И... И что это значит?"
msgstr "[_haylin_] Аааххх... И... И что это значит?"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:258 #-#-# translate crowdin gallery_d_095_6b78e5d1:
msgid "[_cedrick_] Это значит, что теперь всем, что с вами связано, больше занимаюсь не я. Теперь всем этим занимается Фобос и его прихвостни"
msgstr "[_cedrick_] Это значит, что теперь всем, что с вами связано, больше занимаюсь не я. Теперь всем этим занимается Фобос и его прихвостни"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:260 #-#-# translate crowdin gallery_d_095_ebf0fa7f:
msgid "[_haylin_] Н-не думаю, что ситуация станет сильно хуже... Ммммвв... Н-нужно еще постараться поискать кого-то хуже тебя..."
msgstr "[_haylin_] Н-не думаю, что ситуация станет сильно хуже... Ммммвв... Н-нужно еще постараться поискать кого-то хуже тебя..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:262 #-#-# translate crowdin gallery_d_095_18209e3b:
msgid "[_cedrick_] Ты в этом уверена? Ты хоть представляешь, на что способен Фобос?"
msgstr "[_cedrick_] Ты в этом уверена? Ты хоть представляешь, на что способен Фобос?"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:263 #-#-# translate crowdin gallery_d_095_09f4a177:
msgid "[_haylin_] ....."
msgstr "[_haylin_] ....."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:265 #-#-# translate crowdin gallery_d_095_678429c7:
msgid "[_haylin_] Аааххх... Я... Я так устала, Рик... Всем нужно меня пленить и манипулировать мной... А я просто хотела спасти свою бабушку..."
msgstr "[_haylin_] Аааххх... Я... Я так устала, Рик... Всем нужно меня пленить и манипулировать мной... А я просто хотела спасти свою бабушку..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:267 #-#-# translate crowdin gallery_d_095_e23ed2df:
msgid "[_cedrick_] (Черт, она явно не в том расположении духа... Даже с Тарани было проще)"
msgstr "[_cedrick_] (Черт, она явно не в том расположении духа... Даже с Тарани было проще)"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:268 #-#-# translate crowdin gallery_d_095_1878e0ef:
msgid "[_cedrick_] Хай Лин, я..."
msgstr "[_cedrick_] Хай Лин, я..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:270 #-#-# translate crowdin gallery_d_095_10baf0b4:
msgid "[_cedrick_] Я обещаю, что буду регулярно приносить твоей бабушке воду из источника"
msgstr "[_cedrick_] Я обещаю, что буду регулярно приносить твоей бабушке воду из источника"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:272 #-#-# translate crowdin gallery_d_095_e9a7e648:
msgid "[_haylin_] А-ага... Будешь заносить ей воду, а после приходить к моей маме, чтобы в очередной раз трахнуть ее... Ммммввв..."
msgstr "[_haylin_] А-ага... Будешь заносить ей воду, а после приходить к моей маме, чтобы в очередной раз трахнуть ее... Ммммввв..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:274 #-#-# translate crowdin gallery_d_095_3b6d181d:
msgid "[_cedrick_] Я понял... Сейчас ты не настроена на разговор... Я понимаю. Просто знай, что... Что я не хотел, чтобы все до этого дошло..."
msgstr "[_cedrick_] Я понял... Сейчас ты не настроена на разговор... Я понимаю. Просто знай, что... Что я не хотел, чтобы все до этого дошло..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:276 #-#-# translate crowdin gallery_d_095_6dd040e8:
msgid "[_haylin_] Д-да неужели... Мммххх... П-просто заканчивай уже с этим... Аааххх... Аааахххх..."
msgstr "[_haylin_] Д-да неужели... Мммххх... П-просто заканчивай уже с этим... Аааххх... Аааахххх..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:278 #-#-# translate crowdin gallery_d_095_ef8375e6:
msgid "[_cedrick_] (Черт, несмотря на ее отстраненность, ее киска чертовски сильно меня сжимает... Видимо это от накопившегося напряжения, возникшего пока она сидела здесь закованная)"
msgstr "[_cedrick_] (Черт, несмотря на ее отстраненность, ее киска чертовски сильно меня сжимает... Видимо это от накопившегося напряжения, возникшего пока она сидела здесь закованная)"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:279 #-#-# translate crowdin gallery_d_095_e334b4bf:
msgid "[_cedrick_] Уххх, я скоро кончу..."
msgstr "[_cedrick_] Уххх, я скоро кончу..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:281 #-#-# translate crowdin gallery_d_095_2f7ad2cb:
msgid "[_haylin_] Ммммхххх..."
msgstr "[_haylin_] Ммммхххх..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:285 #-#-# translate crowdin gallery_d_095_95144c27:
msgid "[_cedrick_] (Так... Мне явно нужно поменять подход... Возможно, лучшим решением было бы начать с Корнелии... Хай Лин сейчас слишком отстранилась)"
msgstr "[_cedrick_] (Так... Мне явно нужно поменять подход... Возможно, лучшим решением было бы начать с Корнелии... Хай Лин сейчас слишком отстранилась)"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:286 #-#-# translate crowdin gallery_d_095_e350fbe3:
msgid "[_cedrick_] (Что, впрочем, не удивительно. Я совсем недавно манипулировал ей в ресторане и открыто заявил, что трахаю ее мать)"
msgstr "[_cedrick_] (Что, впрочем, не удивительно. Я совсем недавно манипулировал ей в ресторане и открыто заявил, что трахаю ее мать)"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:288 #-#-# translate crowdin gallery_d_095_c921b9f7:
msgid "[_cedrick_] (После такого было бы глупо ожидать, что она хоть как-то прислушается ко мне... Осадок от этого явно пройдет не скоро)"
msgstr "[_cedrick_] (После такого было бы глупо ожидать, что она хоть как-то прислушается ко мне... Осадок от этого явно пройдет не скоро)"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:289 #-#-# translate crowdin gallery_d_095_2dbc74fe:
msgid "[_cedrick_] Хай Лин, мне... Мне нужно отлучиться..."
