# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:10 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_8c11ca4d:
msgid "[_cedrick_] К-какого... Ванесса, ты еще громче этого сказать не могла!? Нас же обоих могут казнить..."
msgstr "[_cedrick_] К-какого... Ванесса, ты еще громче этого сказать не могла!? Нас же обоих могут казнить..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:14 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_9f7cc0e8:
msgid "[_vanessa_] Да расслабься ты. В этом баре одни пьянчуги, они либо нас не слышат, либо им никто не поверит"
msgstr "[_vanessa_] Да расслабься ты. В этом баре одни пьянчуги, они либо нас не слышат, либо им никто не поверит"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:18 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_88a0b2d4:
msgid "[_vanessa_] Даже если я скажу, что сегодня ты пойдешь убивать их жен и детей - они не отреагируют. Единственное слово, на которое у них есть реакция как у собак - это слово выпивка"
msgstr "[_vanessa_] Даже если я скажу, что сегодня ты пойдешь убивать их жен и детей - они не отреагируют. Единственное слово, на которое у них есть реакция как у собак - это слово выпивка"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:22 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_2bf959a0:
msgid "[_drunkard_] Кто-то сказал выпивка!?"
msgstr "[_drunkard_] Кто-то сказал выпивка!?"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:26 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_5671b88f:
msgid "[_vanessa_] Тебе показалось, дорогуша..."
msgstr "[_vanessa_] Тебе показалось, дорогуша..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:30 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_a0ced0d6:
msgid "[_drunkard_] Да мне похер, тащите выпивку"
msgstr "[_drunkard_] Да мне похер, тащите выпивку"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:34 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_715e0050:
msgid "[_vanessa_] Можете обратиться за этим к бармену"
msgstr "[_vanessa_] Можете обратиться за этим к бармену"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:38 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_ae5748f0:
msgid "[_vanessa_] Ох, о чем это мы... Твои девочки у меня, уверена готовятся к встречи с тобой в томном ожидании"
msgstr "[_vanessa_] Ох, о чем это мы... Твои девочки у меня, уверена готовятся к встречи с тобой в томном ожидании"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:42 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_1c5180e4:
msgid "[_cedrick_] Хах, не уверен..."
msgstr "[_cedrick_] Хах, не уверен..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:46 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_3d6186ee:
msgid "[_vanessa_] Объяснишь еще раз, почему ты выбрал именно это место?"
msgstr "[_vanessa_] Объяснишь еще раз, почему ты выбрал именно это место?"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:50 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_5006f528:
msgid "[_cedrick_] Потому что, как ни странно, но я знаю, что могу тебе доверять. На меридиане для меня сейчас три ключевые фигуры - это Миранда, Булдж и ты"
msgstr "[_cedrick_] Потому что, как ни странно, но я знаю, что могу тебе доверять. На меридиане для меня сейчас три ключевые фигуры - это Миранда, Булдж и ты"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:51 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_487e7cc7:
msgid "[_cedrick_] В какой-то степени я разделил стражниц между тремя вашими зонами влияния"
msgstr "[_cedrick_] В какой-то степени я разделил стражниц между тремя вашими зонами влияния"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:55 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_71e02a4e:
msgid "[_vanessa_] Не клади яйца в одну корзину, да? Ты как всегда предусмотрителен. Есть в нашей профессии тоже одна поговорка, связанная с яйцами"
msgstr "[_vanessa_] Не клади яйца в одну корзину, да? Ты как всегда предусмотрителен. Есть в нашей профессии тоже одна поговорка, связанная с яйцами"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:59 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_be5e2fc4:
msgid "[_cedrick_] Даже слышать не хочу..."
msgstr "[_cedrick_] Даже слышать не хочу..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:63 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_9774bacd:
msgid "[_vanessa_] Ох, как грубо..."
msgstr "[_vanessa_] Ох, как грубо..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:67 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_37ec92d1:
msgid "[_cedrick_] И так. Я уверен, что посреди подготовки Корнелии и Хай Лин, Фобос вызовет меня. Поэтому проговорю все еще раз"
msgstr "[_cedrick_] И так. Я уверен, что посреди подготовки Корнелии и Хай Лин, Фобос вызовет меня. Поэтому проговорю все еще раз"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:68 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_8f332963:
msgid "[_cedrick_] По сути происходящее - это устроенный мною спектакль"
msgstr "[_cedrick_] По сути происходящее - это устроенный мною спектакль"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:72 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_4d1f9afe:
msgid "[_vanessa_] О, ролевая игра?"
msgstr "[_vanessa_] О, ролевая игра?"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:76 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_3dbdb8e5:
msgid "[_cedrick_] Эм... Можно и так сказать..."
msgstr "[_cedrick_] Эм... Можно и так сказать..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:77 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_8df911ed:
msgid "[_cedrick_] В любом случае, моя задача сейчас - убедить стражниц в том, что все, что с ними будет происходить дальше является приказом Фобоса"
msgstr "[_cedrick_] В любом случае, моя задача сейчас - убедить стражниц в том, что все, что с ними будет происходить дальше является приказом Фобоса"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:78 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_1f9a037f:
msgid "[_cedrick_] А я в свою очередь не только являюсь жертвой обстоятельств, но и не в восторге от происходящего в целом и в принципе готов сотрудничать с ними"
msgstr "[_cedrick_] А я в свою очередь не только являюсь жертвой обстоятельств, но и не в восторге от происходящего в целом и в принципе готов сотрудничать с ними"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:79 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_e0937662:
msgid "[_cedrick_] Главное чтобы они поверили в то, что если не попросят меня о помощи, то после этого вся их жизнь бесповоротно разрушится"
msgstr "[_cedrick_] Главное чтобы они поверили в то, что если не попросят меня о помощи, то после этого вся их жизнь бесповоротно разрушится"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:83 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_b50f14a7:
msgid "[_vanessa_] Жестокую однако игру ты затеял. Но звучит вполне эффективно"
msgstr "[_vanessa_] Жестокую однако игру ты затеял. Но звучит вполне эффективно"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:87 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_a402ffe7:
msgid "[_cedrick_] Сейчас я не могу попросить о помощи Миранду или Булджа. Если кто-то из них задержится здесь, то это будет подозрительно"
msgstr "[_cedrick_] Сейчас я не могу попросить о помощи Миранду или Булджа. Если кто-то из них задержится здесь, то это будет подозрительно"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:88 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_d3820d7a:
msgid "[_cedrick_] К тому же я не хочу привлекать к борделю особое внимания. Поэтому Корнелию и Хай Лин я оставлю на тебя, если Фобос вызовет меня"
msgstr "[_cedrick_] К тому же я не хочу привлекать к борделю особое внимания. Поэтому Корнелию и Хай Лин я оставлю на тебя, если Фобос вызовет меня"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:89 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_767617c7:
msgid "[_cedrick_] Главное помни, что ты должна делать вид, что являешься прихвостнем Фобоса и выполняешь его приказы"
msgstr "[_cedrick_] Главное помни, что ты должна делать вид, что являешься прихвостнем Фобоса и выполняешь его приказы"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:90 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_a9c1eef8:
msgid "[_cedrick_] А задача, которую тебе дал Фобос - это сделать из этих девушек идеальных наложниц. Так что по сути они отданы тебе для тренировки"
msgstr "[_cedrick_] А задача, которую тебе дал Фобос - это сделать из этих девушек идеальных наложниц. Так что по сути они отданы тебе для тренировки"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:94 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_6f0af511:
msgid "[_vanessa_] Будет сделано, мой капитан!"
msgstr "[_vanessa_] Будет сделано, мой капитан!"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:98 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_af66603e:
msgid "[_vanessa_] ..."
msgstr "[_vanessa_] ..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:102 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_7afd6243:
msgid "[_vanessa_] Ох, кстати о тренировках! Ко мне тут недавно приехала старая подруга, она ооочень хороша в тренировках"
msgstr "[_vanessa_] Ох, кстати о тренировках! Ко мне тут недавно приехала старая подруга, она ооочень хороша в тренировках"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:106 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_114c219f:
msgid "[_vanessa_] В свое время могла обучить самым сложным техникам, на освоение которых уходят десятилетия, всего за три дня!"
msgstr "[_vanessa_] В свое время могла обучить самым сложным техникам, на освоение которых уходят десятилетия, всего за три дня!"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:110 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_3ec7ce2e:
msgid "[_cedrick_] Что? И кто это?"
msgstr "[_cedrick_] Что? И кто это?"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:114 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_acae6c97:
msgid "[_vanessa_] Хах. Джулия! Подойдешь?"
msgstr "[_vanessa_] Хах. Джулия! Подойдешь?"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:115 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_2445eb85:
msgid "[_cedrick_] (Джулия? Получается, здесь работают Ванесса, Хлоя и Джулия? Да это точно не настоящие их имена. Больше похоже на псевдоним порно-актрис...)"
msgstr "[_cedrick_] (Джулия? Получается, здесь работают Ванесса, Хлоя и Джулия? Да это точно не настоящие их имена. Больше похоже на псевдоним порно-актрис...)"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:120 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_e268188f:
msgid "[_julia_] Вызывала меня, Ран... Кхм, Ванесса?"
msgstr "[_julia_] Вызывала меня, Ран... Кхм, Ванесса?"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:124 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_a7baf6b6:
msgid "[_cedrick_] (Ого, темненькая? А она довольно горяча)"
msgstr "[_cedrick_] (Ого, темненькая? А она довольно горяча)"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:128 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_721b73ec:
msgid "[_vanessa_] Да, вот тот самый мужчина, о котором я тебе рассказывала"
msgstr "[_vanessa_] Да, вот тот самый мужчина, о котором я тебе рассказывала"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:134 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_ab58ac57:
msgid "[_julia_] Хооо? Выглядит сильным. Эй, парниша, не хочешь устроить спарринг?"
msgstr "[_julia_] Хооо? Выглядит сильным. Эй, парниша, не хочешь устроить спарринг?"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:135 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_99de6a8a:
msgid "[_cedrick_] (Парниша? Говорит так, словно она старше меня...)"
msgstr "[_cedrick_] (Парниша? Говорит так, словно она старше меня...)"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:139 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_fbc706b6:
msgid "[_cedrick_] Хах, на развлечения в постели с тобой у меня сегодня нет времени"
msgstr "[_cedrick_] Хах, на развлечения в постели с тобой у меня сегодня нет времени"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:143 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_505d674b:
msgid "[_julia_] Я имею в виду не секс, малыш. Я говорю о реальном сражении. Хочу попробовать тебя в деле, так сказать. А там может и до интима дойдет"
msgstr "[_julia_] Я имею в виду не секс, малыш. Я говорю о реальном сражении. Хочу попробовать тебя в деле, так сказать. А там может и до интима дойдет"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:147 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_481f784a:
msgid "[_cedrick_] Сражение, да? Хм, если так подумать, то я вряд ли смогу сейчас дать тебе бой в полную силу"
msgstr "[_cedrick_] Сражение, да? Хм, если так подумать, то я вряд ли смогу сейчас дать тебе бой в полную силу"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:151 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_e9269956:
msgid "[_julia_] Ясно. Тогда вернемся к этому, когда будешь на пике своей прежней формы"
msgstr "[_julia_] Ясно. Тогда вернемся к этому, когда будешь на пике своей прежней формы"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:155 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_7c0bb146:
msgid "[_cedrick_] Эм... Ладно..."
msgstr "[_cedrick_] Эм... Ладно..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:161 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_c7c91156:
msgid "[_vanessa_] Седрик, я позвала сюда Джулию, поскольку в тренировке девочек, да и не только их, она на самом деле куда опытнее меня"
msgstr "[_vanessa_] Седрик, я позвала сюда Джулию, поскольку в тренировке девочек, да и не только их, она на самом деле куда опытнее меня"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:167 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_f7dd227a:
msgid "[_julia_] Хах, да, уж этого у меня не отнять"
msgstr "[_julia_] Хах, да, уж этого у меня не отнять"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:168 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_67d55de1:
msgid "[_cedrick_] (Хм... Должен ли я довериться Джулии и ее опыту? Или может выбрать проверенную Ванессу?)"
msgstr "[_cedrick_] (Хм... Должен ли я довериться Джулии и ее опыту? Или может выбрать проверенную Ванессу?)"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:169 #-#-# translate crowdin check_out_cornelia_and_hay_lin_in_brothel_8908c170:
msgid "[_cedrick_] (Опыт против лояльности... Если так подумать, на поле боя мне часто встречалась похожая дилемма. Эффективнее тот, кто более опытен в бою или тот, чья лояльность не подвергается сомнению?)"
