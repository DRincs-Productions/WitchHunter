msgstr "[_cornelia_] Как минимум, если он будет со мной достаточно откровенен"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:372 #-#-# translate crowdin gallery_d_095_c424ac3c:
msgid "[_cedrick_] И ты... Кхм... Ты понимаешь, чему это грозит для нас? И что мы не справимся друг без друга?"
msgstr "[_cedrick_] И ты... Кхм... Ты понимаешь, чему это грозит для нас? И что мы не справимся друг без друга?"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:376 #-#-# translate crowdin gallery_d_095_838281e1:
msgid "[_cornelia_] Хах, само собой. Думаю, если бы ты мог справиться с Фобосом в одиночку, то давно бы уже это сделал"
msgstr "[_cornelia_] Хах, само собой. Думаю, если бы ты мог справиться с Фобосом в одиночку, то давно бы уже это сделал"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:380 #-#-# translate crowdin gallery_d_095_474eede0:
