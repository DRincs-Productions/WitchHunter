msgstr "[_cedrick_] Корнелия, ты..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:401 #-#-# translate crowdin gallery_d_095_c66df519:
msgid "[_cornelia_] Но сначала, Седрик. Ты трахнешь меня. Все разговоры потом. Покажи мне, насколько сильно я тебе нужна"
msgstr "[_cornelia_] Но сначала, Седрик. Ты трахнешь меня. Все разговоры потом. Покажи мне, насколько сильно я тебе нужна"

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:402 #-#-# translate crowdin gallery_d_095_e4ccebd8:
