# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:291 #-#-# translate crowdin gallery_d_095_81f6e830:
msgid "[_haylin_] Иди уже..."
msgstr "[_haylin_] Иди уже..."

# game/scripts/quests/questTrainingOfGuards/check_out_cornelia_and_hay_lin_in_brothel.rpy:292 #-#-# translate crowdin gallery_d_095_a6ecfb8e:
msgid "[_cedrick_] (Хм, а когда-то она казалась самой невинной из всех стражниц. Если подумать, то это даже интересно)"
msgstr "[_cedrick_] (Хм, а когда-то она казалась самой невинной из всех стражниц. Если подумать, то это даже интересно)"

