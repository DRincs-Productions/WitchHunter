# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:7 #-#-# translate crowdin talk_with_phobos_3_9da5787d:
msgid "[_phobos_] Ты вовремя, Седрик. Я даже удивлен"
msgstr "[_phobos_] Ты вовремя, Седрик. Я даже удивлен"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:11 #-#-# translate crowdin talk_with_phobos_3_a5113d46:
msgid "[_cedrick_] Вовремя, мой князь? Вовремя для чего?"
msgstr "[_cedrick_] Вовремя, мой князь? Вовремя для чего?"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:15 #-#-# translate crowdin talk_with_phobos_3_183af995:
msgid "[_phobos_] Для моего ответа"
msgstr "[_phobos_] Для моего ответа"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:19 #-#-# translate crowdin talk_with_phobos_3_24d1ac3e:
msgid "[_cedrick_] (Что?...)"
msgstr "[_cedrick_] (Что?...)"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:23 #-#-# translate crowdin talk_with_phobos_3_2194bca6:
msgid "[_phobos_] Ты спрашивал меня сегодня, почему я выбрал Райтера, хоть я и знал, что в качестве главнокомандующего он бесполезен"
msgstr "[_phobos_] Ты спрашивал меня сегодня, почему я выбрал Райтера, хоть я и знал, что в качестве главнокомандующего он бесполезен"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:27 #-#-# translate crowdin talk_with_phobos_3_b7337b50:
msgid "[_cedrick_] Ах... Д-да, верно... И каков ваш ответ?"
msgstr "[_cedrick_] Ах... Д-да, верно... И каков ваш ответ?"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:31 #-#-# translate crowdin talk_with_phobos_3_6f53d8d8:
msgid "[_phobos_] Все просто, Седрик. Все из-за моей излишней сентиментальности"
msgstr "[_phobos_] Все просто, Седрик. Все из-за моей излишней сентиментальности"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:35 #-#-# translate crowdin talk_with_phobos_3_09cca77d:
msgid "[_cedrick_] ...О чем вы говорите?"
msgstr "[_cedrick_] ...О чем вы говорите?"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:39 #-#-# translate crowdin talk_with_phobos_3_cd358e91:
msgid "[_phobos_] Изначально я выбрал Райтера лишь ради одного - подтолкнуть моего старого друга и бывшего товарища по оружию к прогрессу"
msgstr "[_phobos_] Изначально я выбрал Райтера лишь ради одного - подтолкнуть моего старого друга и бывшего товарища по оружию к прогрессу"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:43 #-#-# translate crowdin talk_with_phobos_3_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:47 #-#-# translate crowdin talk_with_phobos_3_d81a9ec8:
msgid "[_phobos_] Я думал, что уж Райтер то точно разожжет в тебе огонь и ненависть, на реактивной тяге которой ты снесешь стражниц с лица земли"
msgstr "[_phobos_] Я думал, что уж Райтер то точно разожжет в тебе огонь и ненависть, на реактивной тяге которой ты снесешь стражниц с лица земли"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:51 #-#-# translate crowdin talk_with_phobos_3_081682b7:
msgid "[_cedrick_] Без... без своих способностей?"
msgstr "[_cedrick_] Без... без своих способностей?"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:55 #-#-# translate crowdin talk_with_phobos_3_91c5fb13:
msgid "[_phobos_] Перестань, Седрик. Эти стены яркое свидетельство того, на что ты способен. На них не только следы от когтей и хвоста, но ведь и от меча, от ударов руками"
msgstr "[_phobos_] Перестань, Седрик. Эти стены яркое свидетельство того, на что ты способен. На них не только следы от когтей и хвоста, но ведь и от меча, от ударов руками"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:56 #-#-# translate crowdin talk_with_phobos_3_542f2c39:
msgid "[_phobos_] Да, для моего деда казалась сокрушительной та победа, в которой ты обрушил на меня потолок. Но для меня, хах..."
msgstr "[_phobos_] Да, для моего деда казалась сокрушительной та победа, в которой ты обрушил на меня потолок. Но для меня, хах..."

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:57 #-#-# translate crowdin talk_with_phobos_3_6e489a4b:
msgid "[_phobos_] Для меня куда более унизительными были те бои, в которых ты побеждал меня, не используя ни магию ни свою форму змея..."
msgstr "[_phobos_] Для меня куда более унизительными были те бои, в которых ты побеждал меня, не используя ни магию ни свою форму змея..."

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:61 #-#-# translate crowdin talk_with_phobos_3_abd71ba1:
msgid "[_phobos_] Ты умудрялся победить меня, будущего князя, используя лишь арсенал, доступный даже... людям."
msgstr "[_phobos_] Ты умудрялся победить меня, будущего князя, используя лишь арсенал, доступный даже... людям."

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:65 #-#-# translate crowdin talk_with_phobos_3_49316299_1:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:69 #-#-# translate crowdin talk_with_phobos_3_0279bb0a:
msgid "[_phobos_] Это повергало меня в настоящий ужас тогда, знаешь? Я изо всех сил стремился к прогрессу, чтобы такого больше никогда не произошло"
msgstr "[_phobos_] Это повергало меня в настоящий ужас тогда, знаешь? Я изо всех сил стремился к прогрессу, чтобы такого больше никогда не произошло"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:73 #-#-# translate crowdin talk_with_phobos_3_00b0f72c:
msgid "[_phobos_] И вот я князь. А кто ты, Седрик? Что с тобой вообще стало? Даже жалкий Райтер не смог разжечь в тебе тот огонь, которым ты когда-то мог сражаться со мной почти на равных"
msgstr "[_phobos_] И вот я князь. А кто ты, Седрик? Что с тобой вообще стало? Даже жалкий Райтер не смог разжечь в тебе тот огонь, которым ты когда-то мог сражаться со мной почти на равных"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:77 #-#-# translate crowdin talk_with_phobos_3_87b7ed4a:
msgid "[_cedrick_] ......"
msgstr "[_cedrick_] ......"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:81 #-#-# translate crowdin talk_with_phobos_3_384cfcab:
msgid "[_cedrick_] Ваш прогресс куда стремительнее моего, Ваша светлость, так что вполне естественно, что со временем я начал отставать и..."
msgstr "[_cedrick_] Ваш прогресс куда стремительнее моего, Ваша светлость, так что вполне естественно, что со временем я начал отставать и..."

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:85 #-#-# translate crowdin talk_with_phobos_3_67cf3759:
msgid "[_phobos_] Хватит с меня этого бреда. Я прекрасно знаю, на что способен. Речь сейчас не обо мне, а о тебе. Ты стал слабее"
msgstr "[_phobos_] Хватит с меня этого бреда. Я прекрасно знаю, на что способен. Речь сейчас не обо мне, а о тебе. Ты стал слабее"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:86 #-#-# translate crowdin talk_with_phobos_3_03ed1ee6:
msgid "[_phobos_] Ты ослабел задолго до того, как я отнял твои силы"
msgstr "[_phobos_] Ты ослабел задолго до того, как я отнял твои силы"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:90 #-#-# translate crowdin talk_with_phobos_3_99cc9aca:
msgid "[_cedrick_] ........."
msgstr "[_cedrick_] ........."

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:94 #-#-# translate crowdin talk_with_phobos_3_22647460:
msgid "[_phobos_] Я... Хм, да, верно... Было ошибкой считать, что назначения Райтера поможет вернуть твой потерянный потенциал"
msgstr "[_phobos_] Я... Хм, да, верно... Было ошибкой считать, что назначения Райтера поможет вернуть твой потерянный потенциал"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:98 #-#-# translate crowdin talk_with_phobos_3_71825ddd:
msgid "[_phobos_] Это все моя сентиментальность сыграла со мной в злую шутку"
msgstr "[_phobos_] Это все моя сентиментальность сыграла со мной в злую шутку"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:102 #-#-# translate crowdin talk_with_phobos_3_253a5d33:
msgid "[_cedrick_] (Сентиментальность? Он сейчас вообще серьезно? Гребаный психопат...)"
msgstr "[_cedrick_] (Сентиментальность? Он сейчас вообще серьезно? Гребаный психопат...)"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:106 #-#-# translate crowdin talk_with_phobos_3_7edd45fb:
msgid "[_phobos_] И этого больше не повторится. Лишь я один властен над всем, не стоит об этом забывать. Если захочу, то даже прошлое я смогу переписать"
msgstr "[_phobos_] И этого больше не повторится. Лишь я один властен над всем, не стоит об этом забывать. Если захочу, то даже прошлое я смогу переписать"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:110 #-#-# translate crowdin talk_with_phobos_3_49f9a8e9:
msgid "[_cedrick_] Что вы имеете ввиду?"
msgstr "[_cedrick_] Что вы имеете ввиду?"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:115 #-#-# translate crowdin talk_with_phobos_3_6e28b01d:
msgid "[_phobos_] Я покажу тебе"
msgstr "[_phobos_] Я покажу тебе"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:117 #-#-# translate crowdin talk_with_phobos_3_aa8aee0d:
msgid "[_cedrick_] Ч-что... Что за..."
msgstr "[_cedrick_] Ч-что... Что за..."

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:119 #-#-# translate crowdin talk_with_phobos_3_2f8fd24c:
msgid "[_cedrick_] (Это... Это не иллюзия... И даже не физическая завеса... Это переписывание физической реальности...)"
msgstr "[_cedrick_] (Это... Это не иллюзия... И даже не физическая завеса... Это переписывание физической реальности...)"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:122 #-#-# translate crowdin talk_with_phobos_3_0e3435ac:
msgid "[_cedrick_] (Он полностью изменяет комнату... Одним лишь своим желанием... И с этой силой нам придется тягаться?...)"
msgstr "[_cedrick_] (Он полностью изменяет комнату... Одним лишь своим желанием... И с этой силой нам придется тягаться?...)"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:124 #-#-# translate crowdin talk_with_phobos_3_feef0367:
msgid "[_phobos_] Вот. Как видишь, от некогда позорного прошлого теперь не осталось и следа"
msgstr "[_phobos_] Вот. Как видишь, от некогда позорного прошлого теперь не осталось и следа"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:125 #-#-# translate crowdin talk_with_phobos_3_c07752e1:
msgid "[_cedrick_] (Какого черта? Он так распинался о значимости этой комнаты, а теперь...)"
msgstr "[_cedrick_] (Какого черта? Он так распинался о значимости этой комнаты, а теперь...)"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:128 #-#-# translate crowdin talk_with_phobos_3_c3cc710e:
msgid "[_phobos_] А теперь слушай, Седрик"
msgstr "[_phobos_] А теперь слушай, Седрик"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:132 #-#-# translate crowdin talk_with_phobos_3_39c99269:
msgid "[_phobos_] Я отзываю должность Райтера как главнокомандующего. Теперь у нас будет новый главнокомандующий"
msgstr "[_phobos_] Я отзываю должность Райтера как главнокомандующего. Теперь у нас будет новый главнокомандующий"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:136 #-#-# translate crowdin talk_with_phobos_3_e3aca383:
msgid "[_cedrick_] И... И кто же..."
msgstr "[_cedrick_] И... И кто же..."

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:140 #-#-# translate crowdin talk_with_phobos_3_a5b1fc4e:
msgid "[_phobos_] Охотник"
msgstr "[_phobos_] Охотник"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:144 #-#-# translate crowdin talk_with_phobos_3_f77cbb7d:
msgid "[_cedrick_] О-охотник..."
msgstr "[_cedrick_] О-охотник..."

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:148 #-#-# translate crowdin talk_with_phobos_3_89c6a660:
msgid "[_phobos_] Сейчас он занят тем, что ищет новую базу повстанцев в лесу. Учитывая его навыки, проблемы это не составит"
msgstr "[_phobos_] Сейчас он занят тем, что ищет новую базу повстанцев в лесу. Учитывая его навыки, проблемы это не составит"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:149 #-#-# translate crowdin talk_with_phobos_3_f2eee6eb:
msgid "[_phobos_] После чего я поручу ему найти Райтера. И после того, как Охотник лично казнит прошлого главнокомандующего, будет назначен новый"
msgstr "[_phobos_] После чего я поручу ему найти Райтера. И после того, как Охотник лично казнит прошлого главнокомандующего, будет назначен новый"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:153 #-#-# translate crowdin talk_with_phobos_3_c1ff0690:
msgid "[_phobos_] И после этого, Седрик, Охотник возьмет на себя твои обязанности"
msgstr "[_phobos_] И после этого, Седрик, Охотник возьмет на себя твои обязанности"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:157 #-#-# translate crowdin talk_with_phobos_3_d3eb9ae0:
msgid "[_cedrick_] Ч-что..."
msgstr "[_cedrick_] Ч-что..."

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:161 #-#-# translate crowdin talk_with_phobos_3_c8743787:
msgid "[_phobos_] Ты на земле уже достаточно долгое время, но все равно ни привел к нам ни одной стражницы. Уверен, охотник справится с этой задачей лучше"
msgstr "[_phobos_] Ты на земле уже достаточно долгое время, но все равно ни привел к нам ни одной стражницы. Уверен, охотник справится с этой задачей лучше"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:162 #-#-# translate crowdin talk_with_phobos_3_ff889c3f:
msgid "[_phobos_] На тебе остается лишь привести мне Элион. Охотник, как бы не старался, не сможет изобразить из себя человека"
msgstr "[_phobos_] На тебе остается лишь привести мне Элион. Охотник, как бы не старался, не сможет изобразить из себя человека"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:166 #-#-# translate crowdin talk_with_phobos_3_f60516d5:
msgid "[_phobos_] Хоть в этом ты лучше, чем он, Седрик. В том, чтобы уподобляться людям"
msgstr "[_phobos_] Хоть в этом ты лучше, чем он, Седрик. В том, чтобы уподобляться людям"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:170 #-#-# translate crowdin talk_with_phobos_3_21025df0:
msgid "[_cedrick_] (Чертов ублюдок, он...)"
msgstr "[_cedrick_] (Чертов ублюдок, он...)"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:171 #-#-# translate crowdin talk_with_phobos_3_49316299_2:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:172 #-#-# translate crowdin talk_with_phobos_3_9db030e3:
msgid "[_cedrick_] Получается, перетасовывание казарм сегодня было ради этого?"
msgstr "[_cedrick_] Получается, перетасовывание казарм сегодня было ради этого?"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:176 #-#-# translate crowdin talk_with_phobos_3_9d37cb0f:
msgid "[_phobos_] Верно, стражники меняются местами, поскольку для Охотника будет сформирован абсолютно новый отряд из самых эффективных бойцов."
msgstr "[_phobos_] Верно, стражники меняются местами, поскольку для Охотника будет сформирован абсолютно новый отряд из самых эффективных бойцов."

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:180 #-#-# translate crowdin talk_with_phobos_3_459755e2:
msgid "[_cedrick_] (Проклятье... У нас огромные проблемы)"
msgstr "[_cedrick_] (Проклятье... У нас огромные проблемы)"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:184 #-#-# translate crowdin talk_with_phobos_3_3020facb:
msgid "[_phobos_] А теперь ступай, Седрик. На сегодня у меня больше нет с тобой никаких дел"
msgstr "[_phobos_] А теперь ступай, Седрик. На сегодня у меня больше нет с тобой никаких дел"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:188 #-#-# translate crowdin talk_with_phobos_3_49316299_3:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:189 #-#-# translate crowdin talk_with_phobos_3_b4442662:
msgid "[_cedrick_] Как прикажете..."
msgstr "[_cedrick_] Как прикажете..."

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:194 #-#-# translate crowdin talk_with_phobos_3_06c388ba:
msgid "[_cedrick_] (С одной стороны, большим плюсом для нас является то, что Фобос не видит во мне источник угрозы. Он скорее тотально разочарован)"
msgstr "[_cedrick_] (С одной стороны, большим плюсом для нас является то, что Фобос не видит во мне источник угрозы. Он скорее тотально разочарован)"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:195 #-#-# translate crowdin talk_with_phobos_3_703b8f09:
msgid "[_cedrick_] (То, что он меня недооценивает, его и погубит. Но, с другой стороны...)"
msgstr "[_cedrick_] (То, что он меня недооценивает, его и погубит. Но, с другой стороны...)"

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_3.rpy:196 #-#-# translate crowdin talk_with_phobos_3_3dadd1ff:
