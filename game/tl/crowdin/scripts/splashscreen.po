msgid "[_attention_] {size=80}{color=#f00}ВНИМАНИЕ!{/color}{/size}\n{size=40}ЭТА ВИДЕОИГРА СОДЕРЖИТ КОНТЕНТ ДЛЯ ВЗРОСЛЫХ.\nИГРА СДЕЛАНА ДЛЯ СОВЕРШЕННОЛЕТНИХ\nИ СОДЕРЖИТ В СЕБЕ ИЗОБРАЖЕНИЯ И МАТЕРИАЛЫ,\nКОТОРЫЕ НЕКОТОРЫЕ МОГУТ СЧЕСТЬ ОСКОРБИТЕЛЬНЫМИ.\nЕСЛИ ВАМ НЕ ИСПОЛНИЛОСЬ 18 ЛЕТ,\nЕСЛИ ТАКОЙ МАТЕРИАЛ ОСКОРБЛЯЕТ ВАС,\nИЛИ ЕСЛИ ОН ЯВЛЯЕТСЯ НЕЗАКОННЫМ В ВАШЕЙ СТРАНЕ,\nТО ПОЖАЛУЙСТА, ЗАКРОЙТЕ ИГРУ.\nИМЕНА, ПЕРСОНАЖИ, МЕСТА И СОБЫТИЯ ЯВЛЯЮТСЯ\nЛИБО ПЛОДОМ ВООБРОЖЕНИЯ АВТОРА,\nЛИБО ИСПОЛЬЗУЮТСЯ В ВЫМЫШЛЕННОМ ВИДЕ.\nЛЮБОЕ СХОДСТВО С РЕАЛЬНЫМИ ЛЮДЬМИ, ЖИВЫМИ ИЛИ МЕРТВЫМИ,\nИЛИ РЕАЛЬНЫМИ СОБЫТИЯМИ — ЧИСТОЕ СОВПАДЕНИЕ.\nВСЕМ ПЕРСОНАЖАМ В ИГРЕ НЕ МЕНЕЕ 18 ЛЕТ.\nВАМ УЖЕ ИСПОЛНИЛОСЬ 18 ЛЕТ?\n{/size}"
msgstr "[_attention_] {size=80}{color=#f00}ВНИМАНИЕ!{/color}{/size}\n{size=40}ЭТА ВИДЕОИГРА СОДЕРЖИТ КОНТЕНТ ДЛЯ ВЗРОСЛЫХ.\nИГРА СДЕЛАНА ДЛЯ СОВЕРШЕННОЛЕТНИХ\nИ СОДЕРЖИТ В СЕБЕ ИЗОБРАЖЕНИЯ И МАТЕРИАЛЫ,\nКОТОРЫЕ НЕКОТОРЫЕ МОГУТ СЧЕСТЬ ОСКОРБИТЕЛЬНЫМИ.\nЕСЛИ ВАМ НЕ ИСПОЛНИЛОСЬ 18 ЛЕТ,\nЕСЛИ ТАКОЙ МАТЕРИАЛ ОСКОРБЛЯЕТ ВАС,\nИЛИ ЕСЛИ ОН ЯВЛЯЕТСЯ НЕЗАКОННЫМ В ВАШЕЙ СТРАНЕ,\nТО ПОЖАЛУЙСТА, ЗАКРОЙТЕ ИГРУ.\nИМЕНА, ПЕРСОНАЖИ, МЕСТА И СОБЫТИЯ ЯВЛЯЮТСЯ\nЛИБО ПЛОДОМ ВООБРОЖЕНИЯ АВТОРА,\nЛИБО ИСПОЛЬЗУЮТСЯ В ВЫМЫШЛЕННОМ ВИДЕ.\nЛЮБОЕ СХОДСТВО С РЕАЛЬНЫМИ ЛЮДЬМИ, ЖИВЫМИ ИЛИ МЕРТВЫМИ,\nИЛИ РЕАЛЬНЫМИ СОБЫТИЯМИ — ЧИСТОЕ СОВПАДЕНИЕ.\nВСЕМ ПЕРСОНАЖАМ В ИГРЕ НЕ МЕНЕЕ 18 ЛЕТ.\nВАМ УЖЕ ИСПОЛНИЛОСЬ 18 ЛЕТ?\n{/size}"

