# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/tarani/giveAlchemyForBlank.rpy:7 #-#-# translate crowdin giveAlchemyForBlank_e1f6e456:
msgid "Спустя некоторое время в темнице меридиана"
msgstr "Dopo un po' di tempo nella prigione del meridiano"

# game/scripts/quests/tarani/giveAlchemyForBlank.rpy:12 #-#-# translate crowdin gallery_d_010_d6374a37:
msgid "[_cedrick_] ну вот и твоя женщина для секса, Бланк."
msgstr "[_cedrick_] Ecco la tua donna per il sesso, Blunk."

# game/scripts/quests/tarani/giveAlchemyForBlank.rpy:13 #-#-# translate crowdin gallery_d_010_e6e16c17:
msgid "[_cedrick_] Можешь ее трахнуть."
msgstr "[_cedrick_] Puoi scoparla."

# game/scripts/quests/tarani/giveAlchemyForBlank.rpy:14 #-#-# translate crowdin gallery_d_010_a2c3de76:
msgid "[_blank_] Хе-хе, Бланк будет секс!"
msgstr "[_blank_] Hehe, Blunk sta per fare sesso!"

# game/scripts/quests/tarani/giveAlchemyForBlank.rpy:18 #-#-# translate crowdin gallery_d_010_c5c0cd05:
msgid "[_alchemy_] Я не дам себя трахать этому мерзкому гоблину!.. фууу.. от него воняет!"
msgstr "[_alchemy_] Non permetterò a quel disgustoso folletto di scoparmi!... puzza!"

# game/scripts/quests/tarani/giveAlchemyForBlank.rpy:19 #-#-# translate crowdin gallery_d_010_b7614c42:
msgid "[_blank_] Бланк пахнет мужчиной!"
msgstr "[_blank_] Blunk ha l'odore di un uomo!"

# game/scripts/quests/tarani/giveAlchemyForBlank.rpy:24 #-#-# translate crowdin gallery_d_010_d6626bce:
msgid "[_cedrick_] Ты будешь послушной девочкой и позволишь этому мерзкому гоблину себя трахнуть или я скормлю твоего брата Лурденам по кусочкам.."
msgstr "[_cedrick_] Fai la brava e lascia che quel brutto folletto ti scopi o darò tuo fratello in pasto ai Lourden pezzo per pezzo..."

# game/scripts/quests/tarani/giveAlchemyForBlank.rpy:25 #-#-# translate crowdin gallery_d_010_8cb7dc2a:
msgid "[_alchemy_] …."
msgstr "[_alchemy_] …."

# game/scripts/quests/tarani/giveAlchemyForBlank.rpy:30 #-#-# translate crowdin gallery_d_010_f31580f0:
msgid "….."
msgstr "….."

# game/scripts/quests/tarani/giveAlchemyForBlank.rpy:33 #-#-# translate crowdin gallery_d_010_4764adba:
msgid "[_blank_] Узкооо.. бланк хорошооо.."
msgstr "[_blank_] Stretto... la forma è buona..."

# game/scripts/quests/tarani/giveAlchemyForBlank.rpy:36 #-#-# translate crowdin gallery_d_010_4c4f5d54:
msgid "[_alchemy_] больно..."
msgstr "[_alchemy_] fa male..."

# game/scripts/quests/tarani/giveAlchemyForBlank.rpy:39 #-#-# translate crowdin gallery_d_010_40386887:
msgid "[_blank_] Прости.. Бланк делать хорошо! У тебя очень узкая попа..."
msgstr "[_blank_] Mi dispiace... Blunk è buono! Hai un sedere molto stretto..."

# game/scripts/quests/tarani/giveAlchemyForBlank.rpy:42 #-#-# translate crowdin gallery_d_010_8dabefc6:
msgid ".."
msgstr ".."

# game/scripts/quests/tarani/giveAlchemyForBlank.rpy:45 #-#-# translate crowdin gallery_d_010_92890a1b:
msgid "[_blank_] Бланк стал мужчиной!"
msgstr "[_blank_] Blunk è diventato un uomo!"

# game/scripts/quests/tarani/giveAlchemyForBlank.rpy:50 #-#-# translate crowdin gallery_d_010_ffe22964:
msgid "[_blank_] Бланк кончатть…."
msgstr "[_blank_] Blunk conchat…."

# game/scripts/quests/tarani/giveAlchemyForBlank.rpy:52 #-#-# translate crowdin gallery_d_010_86774ec3:
msgid "[_blank_] Оххх.. бланк хорошо.."
msgstr "[_blank_] Ohhhh... Blunk è buona.."

# game/scripts/quests/tarani/giveAlchemyForBlank.rpy:56 #-#-# translate crowdin gallery_d_010_f31580f0_1:
msgid "….."
msgstr "….."

# game/scripts/quests/tarani/giveAlchemyForBlank.rpy:57 #-#-# translate crowdin gallery_d_010_3b971b59:
msgid "[_cedrick_] Теперь ступай и выполни мою просьбу!"
msgstr "[_cedrick_] Ora andate e fate quello che vi chiedo!"

# game/scripts/quests/tarani/giveAlchemyForBlank.rpy:58 #-#-# translate crowdin gallery_d_010_bd7e0b95:
msgid "[_blank_] Бланк все сделать в худшем виде!"
msgstr "[_blank_] Blunk per fare tutto nel peggiore dei modi!"

# game/scripts/quests/tarani/giveAlchemyForBlank.rpy:59 #-#-# translate crowdin gallery_d_010_f5eb8118:
msgid "[_cedrick_] ( Осталось только дождаться фотографий.. Надеюсь брат Найджела и в правду настолько плох, как говорила о нем мать Тарани.)"
msgstr "[_cedrick_] ( Non mi resta che aspettare le foto. Spero che il fratello di Nigel sia davvero così cattivo come ha detto la madre di Taranee)."

