# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:5 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_d54f4eca:
msgid "[_cedrick_] Элион, ты ведь не отправляешься школьную поездку?"
msgstr "[_cedrick_] Elyon, non andrai in gita scolastica, vero?"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:9 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_47aa7bed:
msgid "[_elion_] Нет, мои родители меня бы не отпустили.."
msgstr "[_elion_] No, i miei genitori non mi hanno lasciato andare..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:12 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_b591bd2f:
msgid "[_cedrick_] Я уезжаю на выходные. Оставляю тебя за главную. Сможешь присмотреть за магазином?"
msgstr "[_cedrick_] Vado via per il fine settimana. Ti lascio il comando. Puoi occuparti del negozio?"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:15 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_9e28a28f:
msgid "[_elion_] Да, конечно! Можешь на меня положится!"
msgstr "[_elion_] Sì, certo! Potete contare su di me!"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:18 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_257ff46f:
msgid "[_cedrick_] Не сомневаюсь. Главное не забывай закрывать магазин и держи его в чистоте."
msgstr "[_cedrick_] Non ne dubito. L'importante è ricordarsi di chiudere il negozio e di tenerlo pulito."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:21 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_ce0c6562:
msgid "[_elion_] Хорошо!"
msgstr "[_elion_] Va bene!"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:24 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_cfda0ebe:
msgid "[_cedrick_] И еще.. Книги на верхней полке.. Не стоит их трогать, они довольно старые и могут легко повредиться."
msgstr "[_cedrick_] E inoltre... I libri sullo scaffale superiore... Non bisogna toccarli, sono piuttosto vecchi e potrebbero danneggiarsi facilmente."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:27 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_f6babc5b:
msgid "[_elion_] Хорошо, Рик. Удачной поездки!"
msgstr "[_elion_] Va bene, Rick. Buon viaggio!"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:30 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_df6f601c:
msgid "[_cedrick_] (Что ж, нужно отправляться в школу)"
msgstr "[_cedrick_] (Bene, via a scuola)"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:33 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_5580fa0a:
msgid "[_centered_] {size=37}Через некоторое время у школы{/size}"
msgstr "[_centered_] {size=37}Dopo un po' di tempo fuori dalla scuola{/size}"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:36 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_50eb4847:
msgid "[_cedrick_] Так, кажется уже почти все собрались."
msgstr "[_cedrick_] Ok, ci siamo quasi."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:40 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_bde08ccd:
msgid "[_sondra_] Ох спасибо мальчики..."
msgstr "[_sondra_] Oh grazie ragazzi..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:41 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_8ce9ab9c:
msgid "[_sondra_] Мерси боку, мерси гарсонс."
msgstr "[_sondra_] Merci beaucoup, merci garçons."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:44 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_bcd124bf:
msgid "[_will_] ..."
msgstr "[_will_] ..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:45 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_0aa44383:
msgid "[_cedrick_] Что-то не так?"
msgstr "[_cedrick_] C'è qualcosa che non va?"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:49 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_ea20e13d:
msgid "[_will_] Я в порядке.."
msgstr "[_will_] Sto bene..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:53 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_69f1bda6:
msgid "[_cedrick_] А выглядишь не очень довольной.. Твоя мама говорила, что ты не очень любишь лыжи, так что я был удивлен, когда ты собралась поехать."
msgstr "[_cedrick_] Non sembri molto felice. Tua madre mi ha detto che non sei un grande sciatore, quindi sono rimasto sorpreso quando ci sei andato."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:57 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_d29cd7ab:
msgid "[_will_] Просто я никогда не пробовала... и решила, вдруг мне понравится?"
msgstr "[_will_] E' solo che non l'ho mai provato... così ho pensato: e se mi piacesse?"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:61 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_8e93b1ae:
msgid "[_cedrick_] Понятно.. Надеюсь у тебя все получится, Вилл."
msgstr "[_cedrick_] Capisco... Spero che funzioni per te, Will."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:65 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_4f71757f:
msgid "[_will_] Угу.."
msgstr "[_will_] Ah-ah..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:68 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:69 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_877cf37f:
msgid "[_cedrick_] (Что ж, вроде бы все засранцы собрались, пора отправляться.)"
msgstr "[_cedrick_] (Sembra che tutti gli stronzi siano qui, è ora di andare)."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:71 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_8f85a4cf:
msgid "[_cedrick_] (Пока я в дороге, нужно успеть прочитать путеводитель по горам Хезерфилд, чтобы не выглядеть идиотом перед толпой школьников.)"
msgstr "[_cedrick_] (Mentre sono in viaggio, devo avere il tempo di leggere la Heatherfield Mountain Guide per non fare la figura dell'idiota davanti a una folla di scolari)."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:72 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_496d3521:
msgid "[_centered_] {size=37}Через некоторое продолжительное время. На горе Хезерфилд{/size}"
msgstr "[_centered_] {size=37}Dopo un periodo di tempo considerevole. Sul monte Heatherfield{/size}"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:74 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_19506776:
msgid "[_cedrick_] И помните дети, кататься только по Северному склону!"
msgstr "[_cedrick_] E ricordate ragazzi, pattinate solo sulla North Face!"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:75 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_45cb27d9:
msgid "[_cedrick_] Не пытайтесь пройти Трассу самоубийц.. Это может быть опасно!"
msgstr "[_cedrick_] Non cercate di prendere il sentiero dei suicidi... Può essere pericoloso!"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:76 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_7d77d672:
msgid "[_guy_] Вот блииин... Обломщик!"
msgstr "[_guy_] Oh, cielo... Che peccato!"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:77 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_8fbb3746:
msgid "[_cedrick_] (Идиоты... Мне плевать, если вы подохнете там, но из-за этого у меня будет только больше неприятностей.)"
msgstr "[_cedrick_] (Idioti... Non mi importa se morirai là fuori, ma mi metterai solo nei guai)."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:78 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_25b0d9ac:
msgid "[_cedrick_] Безопасность прежде всего!"
msgstr "[_cedrick_] La sicurezza prima di tutto!"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:79 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_504e6611:
msgid "[_cedrick_] На этом все, можете идти."
msgstr "[_cedrick_] È tutto, potete andare."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:80 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_a20cefa7_1:
msgid "..."
msgstr "..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:82 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_07bdde05:
msgid "....."
msgstr "....."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:86 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_ce094809:
msgid "[_will_] Кххм, Мэтт вот это да, не знала, что ты лыжник!"
msgstr "[_will_] Matt wow, non sapevo che fossi uno sciatore!"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:90 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_408bf0d3:
msgid "[_will_] Ох, верно, ты же спортсмен.."
msgstr "[_will_] Oh, giusto, sei un atleta..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:94 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_3efd21ef:
msgid "[_will_] Н-не хочешь скатится за мной?"
msgstr "[_will_] Ti piacerebbe rotolare dopo di me?"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:98 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_8fef97d7:
msgid "[_will_] Ээ.. То есть, со мной!"
msgstr "[_will_] Ehm... Cioè, con me!"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:102 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_2b7674e0:
msgid "[_matt_] Эмм... С радостью"
msgstr "[_matt_] Ehm... Con piacere."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:108 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_d18a8be3:
msgid "[_will_] Правда!?"
msgstr "[_will_] Davvero?"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:112 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_b1da52f8:
msgid "[_matt_] Только позже.."
msgstr "[_matt_] Solo più tardi..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:116 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_d948f803:
msgid "[_matt_] Сперва помогу Сондре с ботинками."
msgstr "[_matt_] Prima aiuto Sondra con le scarpe."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:122 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_219ba34a:
msgid "[_will_] Хм..."
msgstr "[_will_] Hmmm..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:128 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_517eed67:
msgid "[_sondra_] Оо, здесь ты есть, Мэтью.."
msgstr "[_sondra_] Oh, eccoti qui, Matthew."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:133 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_f97ce3bb:
msgid "[_sondra_] А кто подружка ??"
msgstr "[_sondra_] Chi è la fidanzata?"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:140 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_12f759bb:
msgid "[_will_] Я Вилл... Мы уже пересекались на уроках истории и физики..."
msgstr "[_will_] Io sono Will... Ci siamo già incrociati nelle lezioni di storia e di fisica..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:146 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_f420ee99:
msgid "[_sondra_] Я не есть помнить каждый всякий..."
msgstr "[_sondra_] Non devo ricordare ogni singolo..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:150 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_9a98ab80:
msgid "[_sondra_] Оо ты можешь катать лыжи на своих кривеньких ножках?"
msgstr "[_sondra_] Puoi sciare sulle tue gambe storte?"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:158 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_11029d3c:
msgid "[_will_] Ну ты же можешь встать на лыжи со своим маленьким умишком..."
msgstr "[_will_] Beh, puoi salire sugli sci con la tua piccola mente..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:166 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_7fb520fa:
msgid "[_sondra_] Хехе..."
msgstr "[_sondra_] Hehe..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:171 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_4ec5b1b4:
msgid "[_sondra_] Что ты сказать???"
msgstr "[_sondra_] Che ne dici?"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:177 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_e45c2dd5:
msgid "[_will_] Я сказала, что ты потеряешь свои козьи штаны пока меня догонишь... Ты даже ботинки сама надеть не в состоянии!"
msgstr "[_will_] Ho detto che avresti perso i tuoi pantaloni da capra prima di raggiungermi... Non puoi nemmeno metterti le scarpe da solo!"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:185 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_31dca1d6:
msgid "[_sondra_] Тогда будем делать соревнование!"
msgstr "[_sondra_] Poi faremo una gara!"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:189 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_3a82aff5:
msgid "[_sondra_] Кто победит, будет ехать с Мэттом обратно"
msgstr "[_sondra_] Chiunque vinca, tornerà in sella con Matt"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:196 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_5064d80b:
msgid "[_will_] Годится!"
msgstr "[_will_] Questo va bene!"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:202 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_c19a5b13:
msgid "[_matt_] Эмм, девочки..."
msgstr "[_matt_] Ragazze..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:210 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_2528ad8d:
msgid "[_wands_] А ты не лезь!"
msgstr "[_wands_] Tu stanne fuori!"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:213 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_a20cefa7_2:
msgid "..."
msgstr "..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:215 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_fbe25f32:
msgid "[_cedrick_] (Ну и представление они тут устроили....)"
msgstr "[_cedrick_] (Che spettacolo hanno messo in scena qui....)"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:216 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_9d474dc8:
msgid "[_cedrick_] (А у Сондры довольно забавная речь..)"
msgstr "[_cedrick_] (E Sondra ha un discorso piuttosto divertente...)"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:217 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_657e65ee:
msgid "[_cedrick_] (Странно, но когда она просила показать мой член, не было слышно даже акцента. Хах, видимо в некоторых вопросах она учила язык с особым усердием)"
msgstr "[_cedrick_] (Stranamente, quando ha chiesto di vedere il mio cazzo, non si è sentito nemmeno un accento. A quanto pare ha studiato la lingua con particolare diligenza in alcune materie)."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:218 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_fdb466ad:
msgid "[_cedrick_] (А что касается Вилл.. Мне не пойдет на пользу, если у нее что-то получится с Мэттом...)"
msgstr "[_cedrick_] (E per quanto riguarda Will... Non mi farebbe bene se si mettesse con Matt...)."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:219 #-#-# translate crowdin quest_new_student_wait_for_a_trip_to_mount_heatherfield_df25e217:
msgid "[_cedrick_] (Что ж, нужно проследить, чтобы все вещи доставили в гостевой домик, ученики расположились в своих комнатах и получили снаряжение.. учительская рутина.)"
