msgstr "[_cedrick_] Bene, lasciate che vi aiuti nella ricerca."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:450 #-#-# translate crowdin gallery_d_029_5f68a538:
msgid "[_centered_] {size=37} Спустя какое то время поиски выхода не к чему не привели {/size}"
msgstr "[_centered_] {size=37} Dopo un po' la ricerca di una via d'uscita non portò a nulla {/size}"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:455 #-#-# translate crowdin gallery_d_029_c987b9c8:
msgid "[_cedrick_] Не волнуйся, они точно рано или поздно заметят нашу пропажу и тогда отправят спасателей на наши поиски."
msgstr "[_cedrick_] Non preoccupatevi, prima o poi si accorgeranno della nostra scomparsa e manderanno le squadre di soccorso a cercarci."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:456 #-#-# translate crowdin gallery_d_029_175605b6:
msgid "[_cedrick_] Во время лавины они должны быть особенно обеспокоены о безопасности учеников, так что скоро все поймут, что нас могло накрыть волной."
msgstr "[_cedrick_] Durante una valanga, devono essere particolarmente preoccupati per la sicurezza degli studenti, quindi presto tutti si renderanno conto che potremmo essere stati colpiti da un'onda."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:460 #-#-# translate crowdin gallery_d_029_6b8d41b9:
msgid "[_will_] Да, я... Я надеюсь."
msgstr "[_will_] Sì, io... Lo spero."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:464 #-#-# translate crowdin gallery_d_029_6ed151c8:
msgid "[_cedrick_] Что ж... Вилл, раз уж мы тут на долго, можешь располагаться."
msgstr "[_cedrick_] Beh... Will, visto che siamo qui per un lungo periodo, potresti anche sistemarti."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:468 #-#-# translate crowdin gallery_d_029_03811a94:
msgid "[_will_] Точно... Спасибо."
msgstr "[_will_] Giusto... Grazie."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:472 #-#-# translate crowdin gallery_d_029_75eda4b1:
msgid "[_will_] (Из-за того, что я не могу использовать свои силы, я сама не своя. Защитница земли, а чувствую себя такой беспомощной. А Рик, будучи обычным человеком, так спокоен и уверен в себе, хоть нас и завалило снегом.)"
msgstr "[_will_] (Perché non posso usare i miei poteri, non sono me stesso. Protettore della terra, e mi sento così impotente. E Rick, essendo un essere umano comune, è così calmo e fiducioso, anche se siamo bloccati dalla neve)."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:476 #-#-# translate crowdin gallery_d_029_bc23d7bd:
msgid "[_will_] (Я начинаю понимать, что мама в нем нашла...)"
msgstr "[_will_] (Comincio a capire che cosa vedeva mia madre in lui...)"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:478 #-#-# translate crowdin gallery_d_029_5f9b772e_3:
msgid "...."
msgstr "...."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:479 #-#-# translate crowdin gallery_d_029_0fd4d656:
msgid "......"
msgstr "......"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:480 #-#-# translate crowdin gallery_d_029_278c7e29:
msgid "........."
msgstr "........."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:484 #-#-# translate crowdin gallery_d_029_b2e8b28e:
msgid "[_cedrick_] Знаешь... По правде говоря, я ведь никогда раньше не катался на лыжах. Просто хотел помочь тебе."
msgstr "[_cedrick_] Sai... La verità è che non ho mai sciato prima. Volevo solo aiutarvi."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:488 #-#-# translate crowdin gallery_d_029_637f077c:
msgid "[_will_] Хах, честно говоря, я заметила."
msgstr "[_will_] Onestamente, l'ho notato."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:492 #-#-# translate crowdin gallery_d_029_37e6884c:
msgid "[_will_] На самом деле, мне все равно было больше некого попросить"
msgstr "[_will_] In effetti, non avevo nessun altro a cui chiederlo."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:496 #-#-# translate crowdin gallery_d_029_217d3b16:
msgid "[_will_] Но, спасибо тебе. Я была рада, что ты решил мне помочь. Ты не первый раз меня выручаешь."
msgstr "[_will_] Ma grazie. Mi ha fatto piacere che abbia deciso di aiutarmi. Non è la prima volta che mi aiutate."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:497 #-#-# translate crowdin gallery_d_029_e849cf41:
msgid "[_cedrick_] А почему ты не поехала вместе со своими подругами? Вы же всегда были так близки..."
msgstr "[_cedrick_] Perché non sei andato con i tuoi amici? Sei sempre stato così vicino..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:501 #-#-# translate crowdin gallery_d_029_99e0a5f2:
msgid "[_will_] Они не считают, что я... "
msgstr "[_will_] Non pensano che io... "

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:505 #-#-# translate crowdin gallery_d_029_a852fecc:
msgid "[_will_] В общем, последнее время мы не очень-то ладим."
msgstr "[_will_] Comunque, ultimamente non andiamo molto d'accordo."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:506 #-#-# translate crowdin gallery_d_029_7d34451e:
msgid "[_cedrick_] (Если все не ладят даже с хранительницей Сердце Кондракара, значит Стражницы на грани полного распада. Лорд Фобос будет очень рад таким новостям.)"
msgstr "[_cedrick_] (Se tutti non vanno d'accordo nemmeno con il guardiano del Cuore di Kondrakar, allora i Guardiani sono sull'orlo della completa disintegrazione. Lord Phobos sarà felicissimo di questa notizia)."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:510 #-#-# translate crowdin gallery_d_029_a3dcddcc:
msgid "[_will_] Я ведь поехала сюда только из-за Мэтта.."
msgstr "[_will_] Sono venuta qui solo per Matt."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:511 #-#-# translate crowdin gallery_d_029_cbf2ce57:
msgid "[_will_] По правде говоря, раньше и я ему нравилась... По крайней мере, я так думала."
msgstr "[_will_] La verità è che anch'io gli piacevo... O almeno, io pensavo che lo facesse."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:515 #-#-# translate crowdin gallery_d_029_6db070fd:
msgid "[_will_] Но после появления Сондры он совсем перестал обращать на меня внимание, а ведь я приехала сюда только из-за него."
msgstr "[_will_] Ma dopo l'arrivo di Sondra, non ha più prestato attenzione a me e sono venuta qui solo per lui."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:519 #-#-# translate crowdin gallery_d_029_f4c1ba7c:
msgid "[_cedrick_] Хм... Если Мэтт так обошелся с тобой и не ценил то, что ты для него делаешь, может, он не лучший для тебя вариант?"
msgstr "[_cedrick_] Hmmm... Se Matt ti ha trattato in questo modo e non ha apprezzato quello che stavi facendo per lui, forse non è la scelta migliore per te?"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:520 #-#-# translate crowdin gallery_d_029_8d2e6225:
msgid "[_cedrick_] Ведь не появись Сондра сейчас, потом на ее месте могла бы появиться другая и тогда он бы в любом случае перестал обращать на тебя внимание."
msgstr "[_cedrick_] Se Sondra non si presentasse ora, potrebbe presentarsi qualcun altro e lui smetterebbe comunque di prestarle attenzione."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:521 #-#-# translate crowdin gallery_d_029_554b4d85:
msgid "[_cedrick_] Дело не в Сондре, такие поступки в целом характеризуют Мэтта, как человека. И нужен ли тогда тебе такой человек?"
msgstr "[_cedrick_] Non si tratta di Sondra, ma di ciò che Matt fa in generale e che lo caratterizza come persona. E poi hai bisogno di un uomo così?"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:525 #-#-# translate crowdin gallery_d_029_28400234:
msgid "[_will_] Возможно, ты прав... Может я изначально зря так относилась к нему."
msgstr "[_will_] Forse hai ragione... Forse ho sbagliato a trattarlo in quel modo."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:527 #-#-# translate crowdin gallery_d_029_81645fc1:
msgid "[_centered_] {size=37} Вечером{/size}"
msgstr "[_centered_] {size=37} In serata{/size}"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:530 #-#-# translate crowdin gallery_d_030_bddd00b0:
msgid "[_will_] Рик... Мне холодно..."
msgstr "[_will_] Rick... Ho freddo..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:531 #-#-# translate crowdin gallery_d_030_b77f97c4:
msgid "[_cedrick_] Воздух становится холоднее из-за того, что весь дом находится под снегом."
msgstr "[_cedrick_] L'aria diventa più fredda perché tutta la casa è sotto la neve."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:532 #-#-# translate crowdin gallery_d_030_3078b382:
msgid "[_cedrick_] А тут даже камин разжечь не выйдет. Дымоход снаружи тоже завалило и если мы разведем костер, то в итоге просто задохнемся от дыма."
msgstr "[_cedrick_] E qui non c'è nemmeno un fuoco da accendere. Anche il camino esterno è bloccato e se accendiamo un fuoco finiremo per soffocare a causa del fumo."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:533 #-#-# translate crowdin gallery_d_030_071b0933:
msgid "[_cedrick_] Вилл, нам придется раздеться."
msgstr "[_cedrick_] Will, dobbiamo spogliarci."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:534 #-#-# translate crowdin gallery_d_030_504e2a07:
msgid "[_will_] Что?!... Д-думаешь, это хорошая идея? Мы же так только быстрее замерзнем."
msgstr "[_will_] Cosa...?! Pensi che sia una buona idea? Così moriremo di freddo."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:535 #-#-# translate crowdin gallery_d_030_066880ff:
msgid "[_cedrick_] Наша одежда промокла и из-за холодного воздуха со временем она заледенеет."
msgstr "[_cedrick_] I nostri vestiti sono fradici e l'aria fredda li farà congelare nel tempo."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:536 #-#-# translate crowdin gallery_d_030_b973d9cb:
msgid "[_cedrick_] Так мы намного быстрее замерзнем, если не снимем ее."
msgstr "[_cedrick_] In questo modo ci congeleremo molto più velocemente se non lo togliamo."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:537 #-#-# translate crowdin gallery_d_030_b4368951:
msgid "[_will_] Да... Наверное, ты прав."
msgstr "[_will_] Sì... Probabilmente hai ragione."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:540 #-#-# translate crowdin gallery_d_030_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:544 #-#-# translate crowdin gallery_d_030_8440ff66:
msgid "[_will_] РИК!?"
msgstr "[_will_] RICK!?"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:545 #-#-# translate crowdin gallery_d_030_ff36074a:
msgid "[_will_] Ты... Ты без трусов..."
msgstr "[_will_] Tu sei... Non indossi i pantaloni..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:546 #-#-# translate crowdin gallery_d_030_98525f60:
msgid "[_will_] И у тебя... Я вижу твой... Твою штуку."
msgstr "[_will_] E tu hai... Capisco il tuo... La tua cosa."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:547 #-#-# translate crowdin gallery_d_030_bd656b4b:
msgid "[_will_] (Черт, теперь я точно знаю, что мама в нем нашла.)"
msgstr "[_will_] (Accidenti, ora so esattamente cosa vedeva la mamma in lui)."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:548 #-#-# translate crowdin gallery_d_030_cf9fc7a9:
msgid "[_cedrick_] Прости... Я ведь не знал, что мы с тобой окажемся в такой ситуации. Надеюсь, это не будет сильно тебя смущать."
msgstr "[_cedrick_] Mi dispiace... Non sapevo che io e te ci saremmo trovati in questa situazione. Spero che questo non vi metta troppo in imbarazzo."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:549 #-#-# translate crowdin gallery_d_030_f99a6444:
msgid "[_will_] Д-да... Иначе ведь ты замерзнешь."
msgstr "[_will_] Sì, sì... Altrimenti morirete di freddo."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:553 #-#-# translate crowdin gallery_d_030_d32667c3:
msgid "[_cedrick_] Вилл, нам нужно лечь вместе, так мы дольше сохраним тепло."
msgstr "[_cedrick_] Will, dobbiamo sdraiarci insieme per restare al caldo più a lungo."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:557 #-#-# translate crowdin gallery_d_030_a31d72ec:
msgid "[_will_] Ты уверен?"
msgstr "[_will_] Sei sicuro?"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:558 #-#-# translate crowdin gallery_d_030_d17d4bb7:
msgid "[_cedrick_] Вспомни наши с тобой уроки истории. Во время зимы во второй мировой солдаты так же отогревали друг друга, чтобы не замерзнуть насмерть в окопах."
msgstr "[_cedrick_] Ricordate le nostre lezioni di storia. Durante l'inverno della Seconda Guerra Mondiale, i soldati si scaldavano a vicenda per non morire di freddo nelle trincee."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:562 #-#-# translate crowdin gallery_d_030_2e602179:
msgid "[_will_] Да, ты прав. Наверное, у нас нет другого выхода."
msgstr "[_will_] Sì, hai ragione. Credo che non abbiamo altra scelta."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:563 #-#-# translate crowdin gallery_d_030_c45118f9:
msgid "[_cedrick_] (Кто бы мог подумать, что эта хрень в итоге поможет мне затащить ее в постель!)"
msgstr "[_cedrick_] (Chi l'avrebbe mai detto che questa roba mi avrebbe aiutato a portarla a letto!)."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:565 #-#-# translate crowdin gallery_d_030_a20cefa7_1:
msgid "..."
msgstr "..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:567 #-#-# translate crowdin gallery_d_030_51f0e251:
msgid "[_cedrick_] Так и вправду стало теплее, не правда ли?"
msgstr "[_cedrick_] Fa davvero più caldo, non è vero?"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:568 #-#-# translate crowdin gallery_d_030_75cbf236:
msgid "[_will_] Да, теплее..."
msgstr "[_will_] Sì, più caldo..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:569 #-#-# translate crowdin gallery_d_030_c2e5b994:
msgid "[_will_] ...Они ведь смогут нас найти?"
msgstr "[_will_] ...Saranno in grado di trovarci, vero?"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:570 #-#-# translate crowdin gallery_d_030_35f00ff8:
msgid "[_cedrick_] Уверен, что смогут. После сошедшей лавины первым делом они должны будут искать в засыпанных снегом домах. Так нас и найдут."
msgstr "[_cedrick_] Sono sicuro che possono farlo. Dopo la valanga, la prima cosa che dovranno fare è cercare nelle case coperte di neve. È così che ci troveranno."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:571 #-#-# translate crowdin gallery_d_030_d57dbc3b:
msgid "[_will_] И откуда только ты знаешь такие детали? Не уж то сам работал спасателем?"
msgstr "[_will_] Come fa a conoscere questi dettagli? Non hai lavorato come bagnino anche tu?"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:572 #-#-# translate crowdin gallery_d_030_1a13292c:
msgid "[_cedrick_] (На Меридиане где только мне не приходилось ловить повстанцев и беглецов для Фобоса.)"
msgstr "[_cedrick_] (Su Meridian ovunque ho dovuto catturare ribelli e fuggitivi per Phobos)."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:573 #-#-# translate crowdin gallery_d_030_b2d0ae03:
msgid "[_cedrick_] (После лавины, которую я на них обрушил, они всегда прятались в ближайших постройках, как крысы. Кто же знал, что я сам окажусь в такой ситуации... да еще и с хранительницей Сердца Кондракара. Хотя из этого я еще могу получить какую-то выгоду.)"
msgstr "[_cedrick_] (Dopo la valanga che ho fatto cadere su di loro, si sono sempre nascosti negli edifici vicini come topi. Chi l'avrebbe mai detto che mi sarei trovato in una situazione del genere... E con il guardiano del Cuore di Kondrakar. Anche se potrei comunque trarne qualche beneficio)."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:574 #-#-# translate crowdin gallery_d_030_305ea7bf:
msgid "[_will_] ...Рик?"
msgstr "[_will_] ...Rick?"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:575 #-#-# translate crowdin gallery_d_030_e4fed858:
msgid "[_cedrick_] ...Я же учитель истории, я должен знать такие вещи. История многому учит, знаешь ли."
msgstr "[_cedrick_] ...sono un insegnante di storia, dovrei sapere queste cose. La storia insegna molto, si sa."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:576 #-#-# translate crowdin gallery_d_030_320b9e29:
msgid "[_will_] Хах, и правда."
msgstr "[_will_] È vero."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:578 #-#-# translate crowdin gallery_d_030_a20cefa7_2:
msgid "..."
msgstr "..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:580 #-#-# translate crowdin gallery_d_030_60409178:
msgid "[_will_] Рииик?!!"
msgstr "[_will_] Reeek?!"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:583 #-#-# translate crowdin gallery_d_030_7d399caa:
msgid "[_will_] То, что я чувствую своими бедрами..."
msgstr "[_will_] Quello che sento con le mie cosce..."

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:584 #-#-# translate crowdin gallery_d_030_92884040:
msgid "[_will_] Это ведь не то, что я думаю?"
msgstr "[_will_] Non è quello che penso, vero?"

# game/scripts/quests/newStudent/quest_new_student_wait_for_a_trip_to_mount_heatherfield.rpy:585 #-#-# translate crowdin gallery_d_030_55002046:
msgid "[_cedrick_] Прости, я... Я думал ты не заметишь."
msgstr "[_cedrick_] Mi dispiace, io... Pensavo che non l'avresti notato."

