# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda_3.rpy:6 #-#-# translate crowdin go_to_meredian_to_miranda_3_58e1cfa5:
msgid "[_miranda_] Седрик, все получилось?"
msgstr "[_miranda_] Cedric, ha funzionato tutto?"

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda_3.rpy:10 #-#-# translate crowdin go_to_meredian_to_miranda_3_fdd19426:
msgid "[_cedrick_] Можно и так сказать, но..."
msgstr "[_cedrick_] Si potrebbe dire così, ma..."

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda_3.rpy:14 #-#-# translate crowdin go_to_meredian_to_miranda_3_944239f5:
msgid "[_miranda_] Что случилось?"
msgstr "[_miranda_] Che è successo?"

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda_3.rpy:18 #-#-# translate crowdin go_to_meredian_to_miranda_3_5122167d:
msgid "[_cedrick_] Фобос, он... Он собирается назначить следующим главнокомандующим охотника"
msgstr "[_cedrick_] Phobos, lui... nominerà un cacciatore come prossimo comandante in capo"

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda_3.rpy:22 #-#-# translate crowdin go_to_meredian_to_miranda_3_4ec6c56e:
msgid "[_miranda_] О нет... Это плохо... Очень плохо..."
msgstr "[_miranda_] Oh no... Questo è brutto... Molto brutto..."

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda_3.rpy:26 #-#-# translate crowdin go_to_meredian_to_miranda_3_56bd16ee:
msgid "[_cedrick_] Да. Но с этим мы разберемся потом. Главное сейчас сосредоточиться на нынешней задаче - вытащить стражниц"
msgstr "[_cedrick_] Sì.  Ma di questo ci occuperemo più tardi.  La cosa principale ora è concentrarsi sul compito attuale: far uscire le guardie"

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda_3.rpy:30 #-#-# translate crowdin go_to_meredian_to_miranda_3_c35aff61:
msgid "[_cedrick_] Спектакль окончен. Пока публике покинуть зал"
msgstr "[_cedrick_] Lo spettacolo è finito.  Fino a quando il pubblico non abbandona la sala"

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda_3.rpy:34 #-#-# translate crowdin go_to_meredian_to_miranda_3_944dd228:
msgid "[_miranda_] Хорошо. Как поступим?"
msgstr "[_miranda_] Bene.  Che cosa dobbiamo fare?"

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda_3.rpy:38 #-#-# translate crowdin go_to_meredian_to_miranda_3_322bd158:
msgid "[_cedrick_] нам лучше действовать по-отдельности. Булдж приведет Вилл, а ты приведи Ирму и Тарани. Корнелия и Хай Лин будут ждать нас в Борделе. Соберем всех там"
msgstr "[_cedrick_] È meglio agire separatamente.  Bulge porterà Will e tu porterai Irma e Taranee.  Cornelia e Hay Lin ci aspetteranno al bordello.  Riuniamo tutti lì"

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda_3.rpy:42 #-#-# translate crowdin go_to_meredian_to_miranda_3_ade293c6:
msgid "[_miranda_] Поняла. Тогда до встречи"
msgstr "[_miranda_] Inteso.  Ci vediamo"

# game/scripts/quests/questTrainingOfGuards/go_to_meredian_to_miranda_3.rpy:44 #-#-# translate crowdin go_to_meredian_to_miranda_3_681c8f32:
msgid "[_cedrick_] (Нужно вернуться в бордель. Мы не вызовем подозрений, если уйдем из замка в разное время)"
msgstr "[_cedrick_] (Dobbiamo tornare al bordello.  Non susciteremo sospetti se lasceremo il castello in orari diversi.)"

