# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:311 #-#-# translate crowdin gallery_d_098_446c9a02:
msgid "[_vanessa_] Прааавда?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:312 #-#-# translate crowdin gallery_d_098_a8ab3639:
msgid "[_cedrick_] Да... Черт, я... Я кончаю..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:313 #-#-# translate crowdin gallery_d_098_052c3d99:
msgid "[_julia_] О да... Давай прямо на меня... Белый цвет хорошо смотрится на моей коже..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:316 #-#-# translate crowdin gallery_d_098_506729f0:
msgid "[_cedrick_] Уууууфффф..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:317 #-#-# translate crowdin gallery_d_098_ef8f3bda:
msgid "[_vanessa_] Мммммм..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:318 #-#-# translate crowdin gallery_d_098_087c1967:
msgid "[_julia_] Что ж, это именно то, чего мы хотели услышать, Седрик. Будем ждать тебя. И не забудь захватить побольше золота, я не мало стою"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:319 #-#-# translate crowdin gallery_d_098_69136f54:
msgid "[_cedrick_] А-ага..."
msgstr "[_cedrick_] A-sì..."

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:322 #-#-# translate crowdin gallery_d_098_533a268c:
msgid "[_cedrick_] (С-стоп... Они сейчас что, устроили промо-компанию моему члену? Это что, все для того, чтобы я просадил все золото в их борделе?)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:324 #-#-# translate crowdin gallery_d_098_2adb105a:
msgid "[_cedrick_] (Хах, хотя не могу сказать, что этот прием не сработал. В этой Джулии что-то есть...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:325 #-#-# translate crowdin gallery_d_098_a6d757f8:
msgid "[_cedrick_] (Ладно, я отвлекся. Пора собирать стражниц. Стоит отправиться к Миранде)"
msgstr ""

