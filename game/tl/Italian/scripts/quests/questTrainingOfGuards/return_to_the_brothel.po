# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:5 #-#-# translate crowdin return_to_the_brothel_1349163e:
msgid "[_cedrick_] Джулия, надеюсь ты не слишком жестоко обращаешься с девушками?"
msgstr "[_cedrick_] Julia, spero che tu non tratti le ragazze troppo duramente?"

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:6 #-#-# translate crowdin return_to_the_brothel_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:7 #-#-# translate crowdin return_to_the_brothel_9d6c018f:
msgid "[_cedrick_] Джулия..?"
msgstr "[_cedrick_] Julia..?"

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:8 #-#-# translate crowdin return_to_the_brothel_87b7ed4a:
msgid "[_cedrick_] ......"
msgstr "[_cedrick_] ......"

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:9 #-#-# translate crowdin return_to_the_brothel_8024b64e:
msgid "[_cedrick_] (Черт, здесь никого нет.. И что это за звуки? Они из другой комнаты..)"
msgstr "[_cedrick_] (Maledizione, qui non c'è nessuno.. E cosa sono questi suoni?  Vengono da un'altra stanza..)"

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:10 #-#-# translate crowdin return_to_the_brothel_d6cb3836:
msgid "[_cedrick_] (П-проклятье... Неужели они...)"
msgstr "[_cedrick_] (Maledizione, qui non c'è nessuno.. E cosa sono questi suoni?  Vengono da un'altra stanza...)"

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:14 #-#-# translate crowdin return_to_the_brothel_e116e86d:
msgid "Вы совершили неправильный выбор. Далее вас ждет GAME OVER, в котором присутствует NTR-сцена с клиентами. Если вы хотите продолжить, нажмите «Да». Чтобы пропустить этот контент и вернуться в главное меню, нажмите «Нет». Вы хотите продолжить?"
msgstr "Hai fatto la scelta sbagliata.  Successivamente troverai GAME OVER, che presenta una scena NTR con i clienti.  Se vuoi continuare, clicca su Sì.  Per saltare questo contenuto e tornare al menu principale, fare clic su No.  Vuoi continuare?"

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:20 #-#-# translate crowdin gallery_d_096_12793fab:
msgid "[_cornelia_] Мммввв... Т-так грубо... Н-нельзя ли по нежнее?"
msgstr "[_cornelia_] Mmmvvv... C-così scortese... C-non potresti essere più gentile?"

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:21 #-#-# translate crowdin gallery_d_096_972a8f6a:
msgid "[_haylin_] Аааххх... Т-так глубоко... Я... Ммм... Я еще не готова к очередному раунду..."
msgstr "[_haylin_] Aaahhh... S-così profondo... Io... Mmm... non sono ancora pronto per il prossimo round..."

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:22 #-#-# translate crowdin gallery_d_096_6a07c7a6:
msgid "[_cedrick_] Ч-что... Что ты здесь устроила, Джулия!?..."
msgstr "[_cedrick_] C-cosa... Cosa hai fatto qui, Julia!?..."

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:25 #-#-# translate crowdin gallery_d_096_87db94a8:
msgid "[_julia_] А что такого? Все ведь согласно сценарию. Как ты и планировал, я развращаю девушек и тренирую их"
msgstr "[_julia_] E allora?  Tutto è secondo la sceneggiatura.  Come avevi previsto, corrompo le ragazze e le addestro"

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:26 #-#-# translate crowdin gallery_d_096_1b7c34f6:
msgid "[_cedrick_] (К-какого черта.. Эта стерва... Обсуждает мой план так прямо, в открытую...)"
msgstr "[_cedrick_] (C-Che diavolo... Questa stronza... Discute il mio piano in modo così diretto, apertamente...)"

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:28 #-#-# translate crowdin gallery_d_096_f8ed3e6b:
msgid "[_julia_] Седрик, чего ты такой напряженный? Не переживай, я так их натренировала, что теперь им абсолютно все равно, было это частью твоего плана или нет..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:30 #-#-# translate crowdin gallery_d_096_49a4f2fc:
msgid "[_haylin_] Мммммххх... Аааахаххх... Еще... Прошу, еще..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:32 #-#-# translate crowdin gallery_d_096_d6358030:
msgid "[_cornelia_] Д-да, вот так... Возьми меня..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:34 #-#-# translate crowdin gallery_d_096_8d74a757:
msgid "[_cedrick_] Что за черт..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:36 #-#-# translate crowdin gallery_d_096_e6601ffd:
msgid "[_julia_] Теперь они развратны и покорны, считай идеальные наложницы. Разве это не превосходит все твои ожидания?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:37 #-#-# translate crowdin gallery_d_096_926a298c:
msgid "[_cedrick_] (Так вот, что имела ввиду Ванесса, когда говорила, что у этой женщины огромный опыт в обучении и тренировках...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:39 #-#-# translate crowdin gallery_d_096_8acdc432:
msgid "[_cedrick_] (Уж прогресса за такой короткий срок я никак не мог ожидать... Это что-то за гранью моего понимания)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:40 #-#-# translate crowdin gallery_d_096_6b5045d8:
msgid "[_cornelia_] (Даже у члена короля морпионов нет таких способностей. Эта женщина опасна...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:41 #-#-# translate crowdin gallery_d_096_354b9904:
msgid "[_cedrick_] С-стоп..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:43 #-#-# translate crowdin gallery_d_096_ea2b7d0b:
msgid "[_julia_] Что такое?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:45 #-#-# translate crowdin gallery_d_096_7ac783ee:
msgid "[_haylin_] Да... Аааххх... Да, долби мою киску..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:47 #-#-# translate crowdin gallery_d_096_e8fe4f89:
msgid "[_cornelia_] Ну же... Еще... Еще... Жестче..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:49 #-#-# translate crowdin gallery_d_096_b210836b:
msgid "[_cedrick_] Джулия... А что именно тебе сказала Ванесса?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:51 #-#-# translate crowdin gallery_d_096_809ac8b4:
msgid "[_julia_] Эм... Что нужно тренировать девчонок, как будущих наложниц, до твоего прихода. Я, конечно, знаю, что это все понарошку, но разве такой результат не лучше любой постановки?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:53 #-#-# translate crowdin gallery_d_096_5319483d:
msgid "[_cedrick_] Джулия... Эти девушки нужны были мне не в качестве наложниц... А в качестве бойцов..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:55 #-#-# translate crowdin gallery_d_096_88770aa2:
msgid "[_julia_] Кто? Они!? Эти слабачки... Да ты должно быть шутишь..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:57 #-#-# translate crowdin gallery_d_096_f0bf5eeb:
msgid "[_haylin_] Ммммм... Я скоро... Совсем скоро... К-кончу..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:59 #-#-# translate crowdin gallery_d_096_9377b2ed:
msgid "[_cornelia_] Ааааавв... Я тоже... Уже совсем близко... К оргазму..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:61 #-#-# translate crowdin gallery_d_096_86f7b261:
msgid "[_cedrick_] Эти слабачки - стражницы завесы и у них есть сила, если использовать на них сердце кондракара"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:63 #-#-# translate crowdin gallery_d_096_a0c21f49:
msgid "[_julia_] Хм... Ну, в эти подробности меня не посвящали"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:65 #-#-# translate crowdin gallery_d_096_9fb66b52:
msgid "[_cedrick_] Ты что, даже не в курсе, кто такие стражницы? Да откуда ты вообще появилась на Меридиане"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:67 #-#-# translate crowdin gallery_d_096_eb2670e6:
msgid "[_julia_] Это... Кхм... Это долгая история..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:69 #-#-# translate crowdin gallery_d_096_4d7793ac:
msgid "[_cedrick_] В прочем не важно... Как по твоему, они теперь годятся как будущие воины, которые должны свергнуть Фобоса!?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:71 #-#-# translate crowdin gallery_d_096_2f77859e:
msgid "[_julia_] Ну не знаю... Только если ты не дашь им приказ затрахать его до смерти"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:73 #-#-# translate crowdin gallery_d_096_c68bdbce:
msgid "[_cedrick_] Это что, шутки для тебя... Ты только что кувалдой проехалась по сознанию двух из пяти стражниц завесы, уничтожив мой план..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:75 #-#-# translate crowdin gallery_d_096_bef9458a:
msgid "[_haylin_] Ааааахххх... К-кончаю..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:77 #-#-# translate crowdin gallery_d_096_baab003f:
msgid "[_cornelia_] Ммммм... Как же хорошооо..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:78 #-#-# translate crowdin gallery_d_096_91be66ce:
msgid "[_cedrick_] Ты можешь вернуть все как было?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:80 #-#-# translate crowdin gallery_d_096_8273c18c:
msgid "[_julia_] Боюсь, что нет. Накопленный опыт назад не вернешь, ты разве не знал?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:82 #-#-# translate crowdin gallery_d_096_939dcb74:
msgid "[_cedrick_] (Как я и думал... Это конец... Как боевые единицы на поле боя они полностью бесполезны... А без стихии земли и ветра нам рассчитывать не на что...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:83 #-#-# translate crowdin gallery_d_096_2ef90216:
msgid "[_cedrick_] (...)"
msgstr "[_cedrick_] (...)"

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:84 #-#-# translate crowdin gallery_d_096_f402bb1d:
msgid "[_cedrick_] (Это конец...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:93 #-#-# translate crowdin gallery_d_097_52abf7a5:
msgid "[_cedrick_] Ванесса, как успехи с Корнелией и Хай Лин. Надеюсь ты не была с ними слишком строга"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:94 #-#-# translate crowdin gallery_d_097_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:95 #-#-# translate crowdin gallery_d_097_5c97d336:
msgid "[_cedrick_] Ванесса?..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:96 #-#-# translate crowdin gallery_d_097_5f32efff:
msgid "[_cedrick_] Ч-что за..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:97 #-#-# translate crowdin gallery_d_097_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:98 #-#-# translate crowdin gallery_d_097_0fd4d656:
msgid "......"
msgstr "......"

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:99 #-#-# translate crowdin gallery_d_097_278c7e29:
msgid "........."
msgstr "........."

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:100 #-#-# translate crowdin gallery_d_097_a34f256b:
msgid "[_cedrick_] Ванесса, как это понимать?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:101 #-#-# translate crowdin gallery_d_097_5b8bd96a:
msgid "[_haylin_] Мммххх..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:105 #-#-# translate crowdin gallery_d_097_ffb4bbc5:
msgid "[_vanessa_] Ох, а вот и ты. Быстро вернулся. Но даже за такое короткое время я смогла научить их паре новых трюков"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:106 #-#-# translate crowdin gallery_d_097_cc2f087c:
msgid "[_cedrick_] И что это?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:107 #-#-# translate crowdin gallery_d_097_596841a2:
msgid "[_vanessa_] Это приветственная поза. Так настоящие наложницы должны встречать своего господина"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:108 #-#-# translate crowdin gallery_d_097_fdc3da01:
msgid "[_vanessa_] Девочки. Поздоровайтесь."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:110 #-#-# translate crowdin gallery_d_097_7cdba64b:
msgid "[_haylin_] С-с возвращением, мастер Седрик"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:112 #-#-# translate crowdin gallery_d_097_6c5b8f82:
msgid "[_cornelia_] Р-рады вашему визиту, мастер..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:114 #-#-# translate crowdin gallery_d_097_9a36b840:
msgid "[_cedrick_] Ванесса... Как-то это... Не думаешь, что это перебор?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:115 #-#-# translate crowdin gallery_d_097_6887ffc5:
msgid "[_vanessa_] Думаю Князь Фобос оценит. Разве это не для него делается, а?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:116 #-#-# translate crowdin gallery_d_097_b5cede1c:
msgid "[_cedrick_] Да-да... Все верно... Просто... Видя их в таком состоянии..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:118 #-#-# translate crowdin gallery_d_097_5b8bd96a_1:
msgid "[_haylin_] Мммххх..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:120 #-#-# translate crowdin gallery_d_097_35580445:
msgid "[_cedrick_] (Хай Лин явно неловко, но раз она не сопротивляется, значит уже поняла свое положение. Хорошо, видимо Ванесса привела ее в чувство)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:121 #-#-# translate crowdin gallery_d_097_b3124ead:
msgid "[_vanessa_] Ох, у нас еще один трюк для тебя есть"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:122 #-#-# translate crowdin gallery_d_097_d7414141:
msgid "[_cedrick_] Ч-что? Еще один? Я отошел же не на долго..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:123 #-#-# translate crowdin gallery_d_097_aa12b046:
msgid "[_vanessa_] Так, Седрик, ложись на кровать. Девочки, теперь будете упражняться не с дилдо, а с реальным мужчиной"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:124 #-#-# translate crowdin gallery_d_097_ef4aeb96:
msgid "[_vanessa_] Ну-ка быстро приняли позу G48, как я вас учила. Не разочаровывайте свою наставницу"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:126 #-#-# translate crowdin gallery_d_097_09bcc8e0:
msgid "[_haylin_] Д-да..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:128 #-#-# translate crowdin gallery_d_097_89241318:
msgid "[_cornelia_] Как пожелаете..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:130 #-#-# translate crowdin gallery_d_097_93b6a307:
msgid "[_vanessa_] Ну же, Седрик, ложись"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:131 #-#-# translate crowdin gallery_d_097_2c707316:
msgid "[_cedrick_] (Кажется Ванесса все же немного увлеклась...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:134 #-#-# translate crowdin gallery_d_097_a4a61d00:
msgid "[_centered_] {size=37}Седрик ложится на кровать{/size}"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:137 #-#-# translate crowdin gallery_d_097_d8e80ea8:
msgid "[_vanessa_] Так, девочки, смотрим на меня. Я буду оценивать, как хорошо вы справляетесь"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:140 #-#-# translate crowdin gallery_d_097_ea70cd27:
msgid "[_haylin_] В-вот так?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:142 #-#-# translate crowdin gallery_d_097_c43a0a4f:
msgid "[_cornelia_] Мы все правильно делаем?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:144 #-#-# translate crowdin gallery_d_097_9ab5b034:
msgid "[_vanessa_] Позу подобрали правильно, и в нужное положение встали довольно быстро. Неплохо неплохо..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:146 #-#-# translate crowdin gallery_d_097_f95912ff:
msgid "[_vanessa_] Так, а что на счет движений? Ну же, двигайтесь"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:148 #-#-# translate crowdin gallery_d_097_5b8bd96a_2:
msgid "[_haylin_] Мммххх..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:150 #-#-# translate crowdin gallery_d_097_8e7c3c4c:
msgid "[_cornelia_] Аааааххх..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:151 #-#-# translate crowdin gallery_d_097_2bd76558:
msgid "[_vanessa_] Седрик, как твои ощущения? Описывай, ты же не просто дилдо на кровати. Мы должны понять, хорошо ли девушки справляются"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:152 #-#-# translate crowdin gallery_d_097_876028b8:
msgid "[_cedrick_] Эм... Это определенно приятно..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:153 #-#-# translate crowdin gallery_d_097_2f945d3a:
msgid "[_vanessa_] Больше подробностей, Седрик. На сколько приятно и как? Не сдавливают ли они твой член слишком сильно своими булками?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:154 #-#-# translate crowdin gallery_d_097_5f70585d:
msgid "[_vanessa_] Не дует ли тебе в член холодные потоки воздуха из-за того, что между девушками образовалось пустое пространство?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:155 #-#-# translate crowdin gallery_d_097_345e6cd7:
msgid "[_cedrick_] (Что за бред она несет эта безумная женщина? Я как будто сам на экзамене)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:156 #-#-# translate crowdin gallery_d_097_a2521615:
msgid "[_cedrick_] Кхм... Мне кажется они справляются отлично..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:158 #-#-# translate crowdin gallery_d_097_c268bccd:
msgid "[_cornelia_] С-спасибо, Седрик..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:160 #-#-# translate crowdin gallery_d_097_87c5dd71:
msgid "[_haylin_] ..."
msgstr "[_haylin_] ..."

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:161 #-#-# translate crowdin gallery_d_097_c634e2a5:
msgid "[_vanessa_] По шкале от 1 до 10, на сколько хорошо по твоему они справляются?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:162 #-#-# translate crowdin gallery_d_097_37ef8d6d:
msgid "[_cedrick_] Эм... 9?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:163 #-#-# translate crowdin gallery_d_097_9bacd5df:
msgid "[_vanessa_] 9!? Да ты издеваешься. Сколько же тогда ты бы поставил, если бы на их месте была я с Джулией? 9000?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:164 #-#-# translate crowdin gallery_d_097_857e85dc:
msgid "[_cedrick_] Возможно... Не знаю, нужно проверить"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:165 #-#-# translate crowdin gallery_d_097_6db4b277:
msgid "[_vanessa_] Хах, все с тобой ясно. Девочки, ускоряйтесь. Посмотрим, как быстро вы заставите его кончить"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:167 #-#-# translate crowdin gallery_d_097_98c1fc13:
msgid "[_haylin_] Д-да... Как скажете..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:169 #-#-# translate crowdin gallery_d_097_4fc9d2a3:
msgid "[_cedrick_] Ванесса, не могла бы ты ненадолго выйти из комнаты?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:171 #-#-# translate crowdin gallery_d_097_18cac29d:
msgid "[_vanessa_] Что!? Но экзамен в самом разгаре"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:173 #-#-# translate crowdin gallery_d_097_77027de6:
msgid "[_cedrick_] Ванесса..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:174 #-#-# translate crowdin gallery_d_097_9917fe7d:
msgid "[_vanessa_] Кхм... Хорошо... Но не забывай, Фобосу нужны хорошие наложницы. Сейчас или позже, но мы должны их испытать"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:177 #-#-# translate crowdin gallery_d_097_74a09372:
msgid "[_centered_] {size=37}Ванесса уходит{/size}"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:186 #-#-# translate crowdin gallery_d_097_c6a201e9:
msgid "[_cedrick_] Хай Лин, Корнелия, как вы? Не пострадали?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:187 #-#-# translate crowdin gallery_d_097_87c5dd71_1:
msgid "[_haylin_] ..."
msgstr "[_haylin_] ..."

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:191 #-#-# translate crowdin gallery_d_097_b8dab362:
msgid "[_haylin_] Р-рик... П-прошу... Вытащи нас отсюда..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:197 #-#-# translate crowdin gallery_d_097_3ec6af61:
msgid "[_cedrick_] Хай Лин? Ты..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:203 #-#-# translate crowdin gallery_d_097_7f66be27:
msgid "[_haylin_] Я слышала ваш разговор с Корнелией за стенкой... Я не хочу такой жизни для себя... То, что нам рассказывала Ванесса... То, чему она нас обучала..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:207 #-#-# translate crowdin gallery_d_097_f3cb6112:
msgid "[_haylin_] Это... Это... Б-боже, я просто хочу домой... К своей семье... Если для этого придется сотрудничать с тобой, то я согласна... Только вытащи меня отсюда..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:211 #-#-# translate crowdin gallery_d_097_4bc1f207:
msgid "[_cedrick_] Я понял тебя, Хай Лин. Обещаю, я сегодня же выведу вас с Меридиана"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:217 #-#-# translate crowdin gallery_d_097_3659022d:
msgid "[_haylin_] П-правда?..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:221 #-#-# translate crowdin gallery_d_097_0d6839aa:
msgid "[_cedrick_] Да... Но для начала, вам придется еще немного подождать здесь..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:227 #-#-# translate crowdin gallery_d_097_80909342:
msgid "[_haylin_] Н-нет... Не оставляй нас с этой женщиной..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:228 #-#-# translate crowdin gallery_d_097_362a9fef:
msgid "[_cedrick_] (Вау, Ванесса видимо как следует постаралась, стоит отдать ей должное..)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:234 #-#-# translate crowdin gallery_d_097_54c724fc:
msgid "[_cedrick_] Хай Лин, не переживай... Я сделаю так, чтобы эта женщина не доставала вас, пока меня нет..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:235 #-#-# translate crowdin gallery_d_097_07cd1ccf:
msgid "[_cedrick_] Но выбраться на землю всем проще всего через Бордель, поэтому я оставляю вас здесь"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:239 #-#-# translate crowdin gallery_d_097_bedd2718:
msgid "[_haylin_] Х-хорошо... Я поняла..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:245 #-#-# translate crowdin gallery_d_097_8ca9d38d:
msgid "[_cornelia_] Седрик, у тебя правда получится?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:249 #-#-# translate crowdin gallery_d_097_e96cfda1:
msgid "[_cedrick_] Да, я... есть у меня одна уловка с Могриффами... Объясню позже... А пока. Мне нужно забрать остальных девушек..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:250 #-#-# translate crowdin gallery_d_097_16ad8075:
msgid "[_cedrick_] Дождитесь меня"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:254 #-#-# translate crowdin gallery_d_097_38014cfe:
msgid "[_haylin_] М-мы будем ждать, Рик..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:259 #-#-# translate crowdin gallery_d_097_d2980077:
msgid "[_cedrick_] (Отлично, Хай Лин тоже проглотила наживку. Осталась финальная часть)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:260 #-#-# translate crowdin gallery_d_097_9c972fc2:
msgid "[_cedrick_] (Нужно собрать их всех в одном месте и...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:261 #-#-# translate crowdin gallery_d_097_d75bc406:
msgid "[_vanessa_] Не так быстро, Седрик"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:262 #-#-# translate crowdin gallery_d_097_978d9723:
msgid "[_cedrick_] Что?..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:271 #-#-# translate crowdin gallery_d_098_0ae9b21b:
msgid "[_cedrick_] Что вы двое задумали?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel.rpy:275 #-#-# translate crowdin gallery_d_098_6062db66:
msgid "[_vanessa_] Неужели ты думал, что мы так просто тебя отпустим?"
