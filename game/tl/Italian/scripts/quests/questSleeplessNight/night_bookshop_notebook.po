# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:38 #-#-# translate crowdin notebook_650aa5e4:
msgid "[_cedrick_] (О, вот она, отлично. Теперь мне нужно расписать мои нынешние отношения с каждой из стражниц)"
msgstr "[_cedrick_] (Oh, eccola qui, fantastico. Ora devo descrivere il mio attuale rapporto con ciascuna delle guardie)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:43 #-#-# translate crowdin notebook_78d0e176:
msgid "[_cedrick_] (Стоит отразить мой уровень доверия с каждой из стражниц просто и понятно. Думаю хватит даже заполненной шкалы)"
msgstr "[_cedrick_] (Vale la pena riflettere il mio livello di fiducia con ciascuna delle guardie in modo semplice e chiaro. Penso che anche una scala piena sarà sufficiente)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:45 #-#-# translate crowdin notebook_0eb00793:
msgid "[_cedrick_] (Итак, начнем с Вилл... Эссенция королевы Морпионов дала свои плоды, теперь Вилл можно назвать самой преданной стражницей из всех)"
msgstr "[_cedrick_] (Allora cominciamo con Will... L'essenza della Regina Morpion ha dato i suoi frutti, ora Will può essere definito il guardiano più devoto di tutti)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:48 #-#-# translate crowdin notebook_0c7d09d4:
msgid "[_cedrick_] (Хотя, случай с Алхими и показал, что эффект эссенции далеко не вечен)"
msgstr "[_cedrick_] (Anche se il caso dell'Alchimia ha dimostrato che l'effetto dell'essenza è tutt'altro che eterno)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:50 #-#-# translate crowdin notebook_c1394d26:
msgid "[_cedrick_] (Ведь та же Алхими уже не питает теплых чувств к Фобосу, а вот ее развратность осталась на том же уровне)"
msgstr "[_cedrick_] (Dopo tutto, la stessa Alhimi non prova più sentimenti affettuosi per Phobos, ma la sua depravazione rimane allo stesso livello)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:52 #-#-# translate crowdin notebook_f3520dbf:
msgid "[_cedrick_] (А значит и с Вилл мне стоит быть осторожнее, ее преданность не бесконечна. Не стоит испытывать ее на прочность)"
msgstr "[_cedrick_] (E questo significa che dovrei stare attento con Will, la sua devozione non è infinita. Non dovrei mettere alla prova la sua forza)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:54 #-#-# translate crowdin notebook_defdffaf:
msgid "[_cedrick_] (Но пока что, я могу поставить ей 5 из 5 пунктов)"
msgstr "[_cedrick_] (Ma per ora posso darle 5 punti su 5)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:56 #-#-# translate crowdin notebook_b66691a5:
msgid "[_cedrick_] (Далее Ирма. Запущенный случай. Я использовал на ней силу короля морпионов, но это дало спорный эффект)"
msgstr "[_cedrick_] (Avanti Irma. Un caso trascurato. Ho usato il potere del Re Morpion su di lei, ma ha avuto un effetto controverso)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:59 #-#-# translate crowdin notebook_d00c9573:
msgid "[_cedrick_] (Теперь ее личность имеет в себе противоречия. Не говоря уже о том, как мы начали с ней наши отношения)"
msgstr "[_cedrick_] (Ora la sua personalità ha delle contraddizioni. Per non parlare di come abbiamo iniziato la nostra relazione con lei)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:61 #-#-# translate crowdin notebook_0060d163:
msgid "[_cedrick_] (Хах, черт, я буквально путем шантажа заставил ее отсосать мне. Думая об этом сейчас, кажется, словно это было в другой жизни)"
msgstr "[_cedrick_] (Hah, cavolo, l'ho letteralmente ricattata per farmi un pompino. Ripensandoci adesso, sembra che sia successo in un'altra vita)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:63 #-#-# translate crowdin notebook_5e519546:
msgid "[_cedrick_] (Тем не менее, нельзя сказать, что она совершенно мне не доверяет)"
msgstr "[_cedrick_] (Tuttavia non si può dire che non si fidi affatto di me)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:64 #-#-# translate crowdin notebook_e012911b:
msgid "[_cedrick_] (Хотя, скорее я путаю доверие и покладистость. Она не доверяет мне, но сделает то, что я скажу. В разумных пределах...)"
msgstr "[_cedrick_] (Anche se preferisco confondere fiducia e conformità. Lei non si fida di me, ma farà quello che dico. Entro limiti ragionevoli...)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:66 #-#-# translate crowdin notebook_7027fc11:
msgid "[_cedrick_] (Думаю это тянет на 3 пункта из 5)"
msgstr "[_cedrick_] (penso che questo ottenga 3 punti su 5)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:68 #-#-# translate crowdin notebook_d42d7759:
msgid "[_cedrick_] (Теперь Тарани. Черт, вот уж кто точно не будет меня слушать ни при каких условиях)"
msgstr "[_cedrick_] (Ora Taranee. Cavolo, c'è qualcuno che sicuramente non mi ascolterà in nessuna circostanza)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:71 #-#-# translate crowdin notebook_9fb8b35b:
msgid "[_cedrick_] (В отличие от всех остальных стражниц, к Тарани я все еще не смог найти подход, она огрызается на любые мои уловки)"
msgstr "[_cedrick_] (A differenza di tutte le altre guardie, non sono ancora riuscito a trovare un approccio con Taranee, lei si arrabbia con qualsiasi dei miei trucchi)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:73 #-#-# translate crowdin notebook_2750f009:
msgid "[_cedrick_] (Да и вспоминая прошлое... Ух, та ситуация с Найджелом - одна из моих самых больших промашек)"
msgstr "[_cedrick_] (E ricordando il passato... Wow, quella situazione con Nigel è uno dei miei più grandi errori)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:75 #-#-# translate crowdin notebook_80bcb5a8:
msgid "[_cedrick_] (Возможно я смогу в будущем подобраться к ней через других стражниц. Или может через ее мать)"
msgstr "[_cedrick_] (Forse potrò contattarla in futuro tramite altre guardie. O forse tramite sua madre)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:77 #-#-# translate crowdin notebook_5b78a1f0:
msgid "[_cedrick_] (Но, констатируя факт, прямо сейчас у меня с ней самые ужасные отношения. Да, предстоит много работы)"
msgstr "[_cedrick_] (Ma, a dire il vero, in questo momento ho il rapporto peggiore con lei. Sì, c'è molto lavoro da fare)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:79 #-#-# translate crowdin notebook_d82c8d5a:
msgid "[_cedrick_] (А пока это тянет на 1 пункт из 5)"
msgstr "[_cedrick_] (Per ora vale 1 punto su 5)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:81 #-#-# translate crowdin notebook_e0abdfc0:
msgid "[_cedrick_] (Корнелия, хм... Вот уж с кем у меня нет проблем)"
msgstr "[_cedrick_] (Cornelia, hmm... ecco con chi non ho problemi)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:84 #-#-# translate crowdin notebook_5c9bd21b:
msgid "[_cedrick_] (С помощью силы короля морпионов я смог использовать ее комплексы и жажду внимания, так что теперь она в моей власти)"
msgstr "[_cedrick_] (Con l'aiuto del potere del Re Morpion, sono riuscito a sfruttare le sue inibizioni e la sua brama di attenzione, quindi ora è alla mia mercé)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:86 #-#-# translate crowdin notebook_a9253cb9:
msgid "[_cedrick_] (Все же с отношения не так хороши, как Вилл. В конце концов Вилл никогда не сталкивалась с моей темной стороной напрямую)"
msgstr "[_cedrick_] (Tuttavia, il rapporto non è buono come Will. Dopotutto, Will non ha mai incontrato direttamente il mio lato oscuro)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:88 #-#-# translate crowdin notebook_3620d8db:
msgid "[_cedrick_] (С другой стороны, возможно именно то, что Корнелия знает о моих темных делах и все равно помогает мне, делает ее более надежным союзником)"
msgstr "[_cedrick_] (D'altra parte, forse il fatto che Cornelia sappia dei miei affari oscuri e mi aiuti comunque la rende un'alleata più affidabile)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:90 #-#-# translate crowdin notebook_753cd73b:
msgid "[_cedrick_] (Хм... Пожалуй это 4 из 5)"
msgstr "[_cedrick_] (Hmm... Forse questo è 4 su 5)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:92 #-#-# translate crowdin notebook_e22413f3:
msgid "[_cedrick_] (И теперь Хай Лин. Черт, еще одна проблема. Она не такая строптивая, как Тарани, но и не такая покладистая, как Ирма)"
msgstr "[_cedrick_] (E ora Hay Lin. Cavolo, un altro problema. Non è ostinata come Taranee, ma nemmeno flessibile come Irma)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:95 #-#-# translate crowdin notebook_61a40bed:
msgid "[_cedrick_] (Возможно мне стоило применить на ней силу короля морпионов, но я не уверен, что она сработает должным образом)"
msgstr "[_cedrick_] (Probabilmente avrei dovuto usare il potere del Re Morpion su di lei, ma non sono sicuro che avrebbe funzionato correttamente)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:97 #-#-# translate crowdin notebook_17a11e9a:
msgid "[_cedrick_] (Пока что не хочу рисковать. Возможно, когда узнаю ее получше)"
msgstr "[_cedrick_] (Non voglio rischiare ancora. Magari quando la conoscerò meglio)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:99 #-#-# translate crowdin notebook_12b87445:
msgid "[_cedrick_] (Хах, вот если бы ее мать была стражницей воздуха, было бы куда проще)"
msgstr "[_cedrick_] (Hah, se sua madre fosse una guardiana dell'aria, sarebbe molto più semplice)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:101 #-#-# translate crowdin notebook_4d3fad8b:
msgid "[_cedrick_] (Но на данный момент это 2 из 5)"
msgstr "[_cedrick_] (Ma al momento sono 2 su 5)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:102 #-#-# translate crowdin notebook_0e6d6058:
msgid "[_cedrick_] (Получается вот такая картина. Хм, не совсем ужасно, но и работы еще много...)"
msgstr "[_cedrick_] (Questa è l'immagine che otteniamo. Hmm, non del tutto terribile, ma c'è ancora molto lavoro da fare...)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:103 #-#-# translate crowdin notebook_db9c6d87:
msgid "[_cedrick_] (Пожалуй проведу красную черту между пятью и четырьмя пунктами. Для слаженной работы им не обязательно доверять мне также, как это делает Вилл)"
msgstr "[_cedrick_] (Penso che traccerò una linea rossa tra i punti cinque e quattro. Per funzionare bene, non devono fidarsi di me tanto quanto Will)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:105 #-#-# translate crowdin notebook_8ff6a569:
msgid "[_cedrick_] (Чтобы стать одной командой, достаточно уровня доверия Корнелии)"
msgstr "[_cedrick_] (Чтобы стать одной командой, достаточно уровня доверия Корнелии)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:106 #-#-# translate crowdin notebook_3074342c:
msgid "[_cedrick_] (Итак... Получается у каждой из них должно быть хотя бы 4 пункта, чтобы мы не распались как команда и одолели Фобоса)"
msgstr "[_cedrick_] (Quindi... si scopre che ognuno di loro deve avere almeno 4 punti in modo da non crollare come squadra e sconfiggere Phobos)"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:108 #-#-# translate crowdin notebook_89a1ac80:
msgid "[_cedrick_] (Хорошо, теперь хотя бы знаю к чему стремиться. А пока... Я на самом деле чертовски устал. Пора и мне немного отдохнуть)"
msgstr "[_cedrick_] (Okay, ora almeno so per cosa lottare. Nel frattempo... in realtà sono dannatamente stanco. È ora che mi riposi un po')"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:117 #-#-# translate crowdin zaglushka_317dc90d:
msgid "[_cedrick_] Мне нужна записная книжка, она в прилавке"
msgstr "[_cedrick_] Mi serve un taccuino, è sul bancone"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:119 #-#-# translate crowdin zaglushka_d09a2f93:
msgid "[_cedrick_] Мне нужно поспать"
msgstr "[_cedrick_] Ho bisogno di dormire"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:121 #-#-# translate crowdin zaglushka_539b59bc:
msgid "[_cedrick_] Смс от Вилл... может что то важное? Нужно посмотреть."
msgstr "[_cedrick_] Sms da Will... forse qualcosa di importante? Ho bisogno di vedere."

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:124 #-#-# translate crowdin zaglushka_621efd64:
msgid "[_cedrick_] Сначала к Миранде"
msgstr "[_cedrick_] Prima a Miranda"

# game/scripts/quests/questSleeplessNight/night_bookshop_notebook.rpy:127 #-#-# translate crowdin zaglushka_3985d151:
msgid "[_cedrick_] Переночую у вендомов"
msgstr "[_cedrick_] Trascorrerò la notte con i Vendom"

