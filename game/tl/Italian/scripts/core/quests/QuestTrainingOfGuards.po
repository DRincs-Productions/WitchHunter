msgid "Подготовка стражниц завесы"
msgstr "Preparazione delle protezioni del velo"

# game/scripts/core/quests/QuestTrainingOfGuards.rpy:26
msgid "Обсудить план с Мирандой и Булджем в лаборатории Миранды"
msgstr "Discutere il piano con Miranda e Bulge nel laboratorio di Miranda"

# game/scripts/core/quests/QuestTrainingOfGuards.rpy:26
msgid "Отправится к Фобосу в тронный зал"
msgstr "Andate da Phobos nella sala del trono"

# game/scripts/core/quests/QuestTrainingOfGuards.rpy:26
msgid "Проверить Вилл в темнице"
msgstr "Guarda Will nel sotterraneo"

# game/scripts/core/quests/QuestTrainingOfGuards.rpy:26
msgid "Вернуться к Миранде"
msgstr "Torniamo a Miranda"

# game/scripts/core/quests/QuestTrainingOfGuards.rpy:26
msgid "Заглянуть в темницу к Ирме"
msgstr "Una sbirciatina nella prigione di Irma"

# game/scripts/core/quests/QuestTrainingOfGuards.rpy:26
msgid "Снова отправится к Фобосу в тронный зал"
msgstr "Andrà di nuovo da Phobos nella sala del trono"

# game/scripts/core/quests/QuestTrainingOfGuards.rpy:26
msgid "Проверить Ирму и Тарани в казармах"
msgstr "Controlla Irma e Taranee alla caserma"

# game/scripts/core/quests/QuestTrainingOfGuards.rpy:26
msgid "Навестить Корнелию и Хай Лин в борделе"
msgstr "Per visitare Cornelia e Hay Lin al bordello"

# game/scripts/core/quests/QuestTrainingOfGuards.rpy:26
msgid "Явиться к Фобосу"
msgstr "Rapporto su Phobos"

# game/scripts/core/quests/QuestTrainingOfGuards.rpy:26
msgid "Вернуться в бордель"
msgstr "Ritorno al bordello"

# game/scripts/core/quests/QuestTrainingOfGuards.rpy:26
msgid "Собрать стражниц в борделе"
msgstr "Riunire le guardie del bordello"

