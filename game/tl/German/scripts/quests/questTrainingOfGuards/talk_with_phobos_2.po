# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:7 #-#-# translate crowdin talk_with_phobos_2_54be13e5:
msgid "[_phobos_] Ты не сильно ко мне торопился, Седрик"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:11 #-#-# translate crowdin talk_with_phobos_2_8e841519:
msgid "[_cedrick_] Прошу прощения, Милорд..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:15 #-#-# translate crowdin talk_with_phobos_2_4469c06a:
msgid "[_phobos_] Хм, не расскажешь, что стряслось?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:19 #-#-# translate crowdin talk_with_phobos_2_24906d29:
msgid "[_cedrick_] (Ему же обычно не нужны мои оправдания... Черт, не нравится мне это...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:20 #-#-# translate crowdin talk_with_phobos_2_6e2bc707:
msgid "[_cedrick_] Эм... Когда мы готовили необходимое нам зелье, произошел небольшой взрыв в лаборатории..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:24 #-#-# translate crowdin talk_with_phobos_2_e83cbebd:
msgid "[_phobos_] Хм... И чья же ошибка привела к подобному результату?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:28 #-#-# translate crowdin talk_with_phobos_2_a78262d0:
msgid "[_cedrick_] Судя по всему один из ингредиентов, что я принес Миранде, оказался не тем, что ей был нужен... Это была моя вина"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:32 #-#-# translate crowdin talk_with_phobos_2_e25f289f:
msgid "[_phobos_] Хах, берешь всю вину сразу на себя, хоть Миранда и сама должна была проверить все ингредиенты перед их использованием?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:33 #-#-# translate crowdin talk_with_phobos_2_3368cedf:
msgid "[_phobos_] А ты в своем репертуаре, Седрик. Хоть в чем-то не изменяешь старому себе"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:37 #-#-# translate crowdin talk_with_phobos_2_49316299:
msgid "[_cedrick_] ..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:41 #-#-# translate crowdin talk_with_phobos_2_03b9a5b7:
msgid "[_phobos_] Мне уж казалось, что ты охладел к нашей маленькой паучихе, но видимо твои чувства к ней все так же сильны"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:45 #-#-# translate crowdin talk_with_phobos_2_6368e6b8:
msgid "[_cedrick_] Вы как всегда наблюдательны, Мой князь.."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:49 #-#-# translate crowdin talk_with_phobos_2_29554bc7:
msgid "[_cedrick_] Эм... Куда бы вы хотели отправиться на этот раз? Какая часть ваших покоев интересна вам для осмотра?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:53 #-#-# translate crowdin talk_with_phobos_2_5ccaef76:
msgid "[_phobos_] Ты как-то сильно зациклен на моем сегодняшнем осмотре. Не уж то в моем замке что-то не так?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:57 #-#-# translate crowdin talk_with_phobos_2_a157fccc:
msgid "[_cedrick_] (Проклятье... Из-за стражниц я расслабился... С Фобосом такие простые формулировки не пройдут, нужно четко подбирать каждое слово...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:61 #-#-# translate crowdin talk_with_phobos_2_6b9208e0:
msgid "[_phobos_] В любом случае, у меня есть свои планы, Седрик. И даже если сейчас в моем замке происходит что-то, что мне неведомо, моих планов это не нарушит"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:62 #-#-# translate crowdin talk_with_phobos_2_d55209d6:
msgid "[_cedrick_] (Он говорит так, словно обо всем знает, но его это не волнует... Или же это абстрактная фраза? Черт, с ним приходится играть сразу на нескольких уровнях...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:63 #-#-# translate crowdin talk_with_phobos_2_ffaaba7d:
msgid "[_phobos_] Сейчас мне вполне комфортно находиться и здесь. Раньше мои предки устраивали в этом зале переговоры, строили всяческие козни"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:64 #-#-# translate crowdin talk_with_phobos_2_a50e2b57:
msgid "[_phobos_] Но сейчас этот зал пустует и собирает пыль. Не только потому что в отличие от старых времен, теперь все решаю единолично один лишь я и посему переговорные залы более не нужны"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:68 #-#-# translate crowdin talk_with_phobos_2_55599dd7:
msgid "[_phobos_] Но и потому что всех тех, кто мог строить различные козни, я уже давно убил. Каждого, будь то сослуживец или даже родственник"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:69 #-#-# translate crowdin talk_with_phobos_2_a493380e:
msgid "[_phobos_] Впрочем, Седрик, ты и так это знаешь. В конце концов ты сам был свидетелем всего этого, а нередко и участником"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:73 #-#-# translate crowdin talk_with_phobos_2_a208c05c:
msgid "[_phobos_] Без твоей помощи многих моих родственников не удалось бы так легко устранить. Особенно моего старшего братца"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:74 #-#-# translate crowdin talk_with_phobos_2_e704b6fe:
msgid "[_phobos_] Его единственным просчетом было то, что он не рассчитал, насколько ты мне верен. Правда, мы тогда тоже понесли потери. Рог Гипноса так и не удалось вернуть..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:78 #-#-# translate crowdin talk_with_phobos_2_d7b15ae4:
msgid "[_cedrick_] Да... Для нас это большая потеря"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:82 #-#-# translate crowdin talk_with_phobos_2_dbf40550:
msgid "[_phobos_] Еще какая. Уверен, тебе со стражницами он бы сейчас очень пригодился"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:86 #-#-# translate crowdin talk_with_phobos_2_933cc5b4:
msgid "[_cedrick_] Ч-что?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:90 #-#-# translate crowdin talk_with_phobos_2_abbd91b1:
msgid "[_phobos_] Со стражницами. Чтобы подчинить их. Ты ведь все еще не сделал этого, хоть и находишься на земле довольно давно, Седрик"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:94 #-#-# translate crowdin talk_with_phobos_2_49316299_1:
msgid "[_cedrick_] ..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:95 #-#-# translate crowdin talk_with_phobos_2_0cc7e5a7:
msgid "[_cedrick_] Д-да, князь Фобос. Я делаю все так быстро, как только могу"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:99 #-#-# translate crowdin talk_with_phobos_2_767a116c:
msgid "[_phobos_] Охотно верю..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:103 #-#-# translate crowdin talk_with_phobos_2_c709e55c:
msgid "[_phobos_] А теперь ступай. Я хочу немного побыть здесь наедине, поразмыслить о прошлом и будущем. Я доложу стражникам, когда ты мне снова понадобишься"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:107 #-#-# translate crowdin talk_with_phobos_2_f0885907:
msgid "[_cedrick_] К-как прикажете, Князь Фобос"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:108 #-#-# translate crowdin talk_with_phobos_2_a7009369:
msgid "[_cedrick_] (Что с ним такое... Он словно уже давно обо всем догадался. Хотя, может он просто вспоминает прошлое. Сегодня он то и дело окунается в воспоминания о прошлом)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:109 #-#-# translate crowdin talk_with_phobos_2_ad29f8d5:
msgid "[_cedrick_] (Даже наши с ним тренировки вспомнил и совместную работу бок о бок... Хм... Словно сегодня он какой-то более сентиментальный... Что бы это могло значить)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/talk_with_phobos_2.rpy:112 #-#-# translate crowdin talk_with_phobos_2_a848e164:
msgid "[_cedrick_] (В любом случае, я должен воспользоваться предоставленным мне временем с пользой)"
msgstr ""

