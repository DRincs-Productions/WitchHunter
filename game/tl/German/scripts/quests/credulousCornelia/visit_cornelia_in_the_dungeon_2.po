# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon_2.rpy:6 #-#-# translate crowdin gallery_d_043_ad12f4c0:
msgid "[_cedrick_] Итак, Корнелия, я вернулся. Готова к тому, что в этот раз я тебя выебу?"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon_2.rpy:10 #-#-# translate crowdin gallery_d_043_559d520b:
msgid "[_cornelia_] Ч-что!? Ты не посмеешь!"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon_2.rpy:14 #-#-# translate crowdin gallery_d_043_1f03a658:
msgid "[_cedrick_] Все еще строишь из себя принцессу? На Земле это еще срабатывало, но здесь я Лорд и мне плевать, против ты или нет. Я просто возьму свое"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon_2.rpy:18 #-#-# translate crowdin gallery_d_043_fedb637e:
msgid "[_cornelia_] ........."
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon_2.rpy:20 #-#-# translate crowdin gallery_d_043_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon_2.rpy:23 #-#-# translate crowdin gallery_d_043_a2217416:
msgid "[_cornelia_] У-ублюдок.. Ты не предупредил, что будешь трахать меня прямо в зад!"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon_2.rpy:24 #-#-# translate crowdin gallery_d_043_e07f1e24:
msgid "[_cedrick_] А я не ждал приглашения! К тому же, что это вообще значит? То есть в киску ты меня принять была сегодня готова?"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon_2.rpy:26 #-#-# translate crowdin gallery_d_043_cf29eff4:
msgid "[_cornelia_] ..иди к черту"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon_2.rpy:27 #-#-# translate crowdin gallery_d_043_9e1fb005:
msgid "[_cedrick_] Ох, точно, у нас же на земле было что-то вроде влюбленности. Ты ведь первая меня поцеловала, помнишь"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon_2.rpy:28 #-#-# translate crowdin gallery_d_043_cf937600:
msgid "[_cornelia_] З-заткнись.. Я была пьяна!"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon_2.rpy:29 #-#-# translate crowdin gallery_d_043_a3fe044f:
msgid "[_cedrick_] А сейчас что? Твоя попка так легко меня принимает, потому что ты пьяна от моего члена?"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon_2.rpy:30 #-#-# translate crowdin gallery_d_043_e854c8c2:
msgid "[_cornelia_] П-пошел ты! Ааааа... Это все твой сундучный монстр.."
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon_2.rpy:31 #-#-# translate crowdin gallery_d_043_d693d639:
msgid "[_cedrick_] Да? Не помню, чтобы он трахал тебя в попку. Мне кажется, все дело в том, что на самом деле наша принцесса любит, когда ее берут против ее воли"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon_2.rpy:33 #-#-# translate crowdin gallery_d_043_03ff0d6e:
msgid "[_cornelia_] Э-это не так.. Все не так"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon_2.rpy:34 #-#-# translate crowdin gallery_d_043_64798403:
msgid "[_cedrick_] Тогда хватит подыгрывать мне бедрами!"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon_2.rpy:35 #-#-# translate crowdin gallery_d_043_e918de29:
msgid "[_cornelia_] Я... Я просто хочу, чтобы ты быстрее кончил и отвязался от меня"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon_2.rpy:36 #-#-# translate crowdin gallery_d_043_2fef0929:
msgid "[_cedrick_] Хах, ну тогда получай!"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon_2.rpy:38 #-#-# translate crowdin gallery_d_043_b0f62a10:
msgid "[_cornelia_] Аааааааах....."
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon_2.rpy:41 #-#-# translate crowdin gallery_d_043_0936b07c:
msgid "[_cedrick_] Но не думай, что после подобного я от тебя отстану. Ты моя пленница, не забывай. Увидимся до следующего раза. Пойду пока трахать твоих подруг"
msgstr ""

# game/scripts/quests/credulousCornelia/visit_cornelia_in_the_dungeon_2.rpy:42 #-#-# translate crowdin gallery_d_043_3387e05d:
msgid "[_cornelia_] ...Ч-чертов мерзавец.. ненавижу..."
msgstr ""

