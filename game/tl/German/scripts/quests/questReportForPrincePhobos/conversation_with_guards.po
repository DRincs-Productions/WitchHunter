# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:7 #-#-# translate crowdin conversation_with_guards_edb4f255:
msgid "[_cedrick_] Дальше я сам, Булдж, спасибо. Как закончу я тебя вызову"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:8 #-#-# translate crowdin conversation_with_guards_24ffe9ee:
msgid "[_bulj_] Как скажете, главнокомандующий"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:13 #-#-# translate crowdin gallery_d_084_9fa17a84:
msgid "[_will_] Р-рик, наконец-то!"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:18 #-#-# translate crowdin gallery_d_084_49b98e8b:
msgid "[_cornelia_] Хах, наконец явился"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:23 #-#-# translate crowdin gallery_d_084_795678bb:
msgid "[_irma_] ..."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:27 #-#-# translate crowdin gallery_d_084_5e872f95:
msgid "[_tarani_] Ублюдок, теперь и Вилл с Корнелией привел.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:35 #-#-# translate crowdin gallery_d_084_1ab43a93:
msgid "[_cedrick_] Так, всем тихо!"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:36 #-#-# translate crowdin gallery_d_084_fc410bc3:
msgid "[_cedrick_] Для начала, девочки, расположимся должным образом и подведем итоги прошедшего суда"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:37 #-#-# translate crowdin gallery_d_084_632e5a95:
msgid "[_cedrick_] Я же в конце-концов ваш преподаватель, вы ведь не забыли? Считайте что суд был зачетом и самое время озвучить ваши оценки. Присаживайтесь"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:40 #-#-# translate crowdin gallery_d_084_a20cefa7:
msgid "..."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:41 #-#-# translate crowdin gallery_d_084_07bdde05:
msgid "....."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:42 #-#-# translate crowdin gallery_d_084_3928a113:
msgid "......."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:45 #-#-# translate crowdin gallery_d_084_e6eb6843:
msgid "[_will_] Р-рик, что происходит!? П-почему.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:47 #-#-# translate crowdin gallery_d_084_04aafa07:
msgid "[_cedrick_] Тише, Вилл. Сейчас я все объясню"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:49 #-#-# translate crowdin gallery_d_084_0c97b537:
msgid "[_cedrick_] Каждая из вас справилась с поставленной в суде задачей абсолютно по-разному"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:51 #-#-# translate crowdin gallery_d_084_209410ac:
msgid "[_cedrick_] И лучше всего выступила, как вы могли догадаться, Корнелия. Поэтому она получает оценку отлично и занимает почетное место"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:53 #-#-# translate crowdin gallery_d_084_82c31eca:
msgid "[_will_] Н-несправедливо!!"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:55 #-#-# translate crowdin gallery_d_084_78882055:
msgid "[_cedrick_] Без Корнелии, возможно, этот суд и вовсе провалился бы. Она очень мне помогла"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:57 #-#-# translate crowdin gallery_d_084_eb29f59e:
msgid "[_cornelia_] Мммвв.. Так пвиятно, когда твою ваботу ценят.. Ммхх.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:59 #-#-# translate crowdin gallery_d_084_a442f232:
msgid "[_cedrick_] Тише, Вилл. За выкрики во время объявления оценок можно и выгнать из класса"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:61 #-#-# translate crowdin gallery_d_084_23406dcf:
msgid "[_will_] Пф.. Я поняла"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:69 #-#-# translate crowdin grade_guard_52ba64c1:
msgid "[_cedrick_] (Чью оценку стоит объявить следующей?)"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:74 #-#-# translate crowdin dialog_captive_tarani_d63c9b96:
msgid "[_cedrick_] Говоря о тебе, Тарани"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:76 #-#-# translate crowdin dialog_captive_tarani_c2f6b408:
msgid "[_tarani_] А что я.. Меня на твоем гребаном суде не было.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:78 #-#-# translate crowdin dialog_captive_tarani_96179f9f:
msgid "[_cedrick_] Вот именно. Поэтому за неявку ты остаешься после уроков. Фигурально выражаясь.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:80 #-#-# translate crowdin dialog_captive_tarani_43bdaeb4:
msgid "[_tarani_] Что за бред.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:82 #-#-# translate crowdin dialog_captive_tarani_515e6dd5:
msgid "[_cedrick_] Нам с тобой предстоит особая работа, Тарани. Из всех учениц ты пока что самая проблематичная"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:84 #-#-# translate crowdin dialog_captive_tarani_6556101b:
msgid "[_tarani_] Как будто меня парит твое мнение, придурок.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:86 #-#-# translate crowdin dialog_captive_tarani_7f17e2ed:
msgid "[_cedrick_] (Хм, все такая же грубая.. Ни намека на брешь, хоть она и видит, в каком положении находятся остальные стражницы)"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:96 #-#-# translate crowdin dialog_captive_will_0e0bf9dc:
msgid "[_cedrick_] Что касается тебя, Вилл"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:98 #-#-# translate crowdin dialog_captive_will_18175b66:
msgid "[_will_] Д-да! Что насчет меня!? Ты же не забыл тот охрененный минет в кабинке, верно?"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:100 #-#-# translate crowdin dialog_captive_will_258666f5:
msgid "[_cedrick_] Нет, Вилл, не забыл.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:102 #-#-# translate crowdin dialog_captive_will_95d717f8:
msgid "[_cedrick_] И именно поэтому твоя оценка - слабо"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:104 #-#-# translate crowdin dialog_captive_will_bcd124bf:
msgid "[_will_] ..."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:106 #-#-# translate crowdin dialog_captive_will_1ef4ebff:
msgid "[_will_] Ч-что!? Так тебе не понравилось!? Если так, то я могу быть лучше.. М-мне просто нужно больше практики"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:108 #-#-# translate crowdin dialog_captive_will_61a04937:
msgid "[_cedrick_] Нет, Вилл, дело не в этом. У тебя отлично получается, дело здесь в твоей напористости и наглости"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:110 #-#-# translate crowdin dialog_captive_will_4b0ec667:
msgid "[_cedrick_] Ты не осознаешь до конца своего места, Вилл. Думаешь, раз я живу с тобой и сплю с твоей мамой, то наши с тобой отношения особенные?"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:112 #-#-# translate crowdin dialog_captive_will_5856c4a6:
msgid "[_will_] Н-ну.. да.. я думала, что так.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:114 #-#-# translate crowdin dialog_captive_will_ee7aa487:
msgid "[_cedrick_] Твое непонимание границ и постоянное желание сделать все по-своему начали вставлять мне палки в колеса"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:116 #-#-# translate crowdin dialog_captive_will_300acf27:
msgid "[_will_] Н-но как!?"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:118 #-#-# translate crowdin dialog_captive_will_4247a89c:
msgid "[_cedrick_] Это как раз таки тебе знать не обязательно, Вилл. В этом и проявляется понимание личных границ. У тебя этого понимания нет и мы поработаем над этим"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:120 #-#-# translate crowdin dialog_captive_will_8ea98ecd:
msgid "[_will_] Р-рик.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:122 #-#-# translate crowdin dialog_captive_will_ff04c002:
msgid "[_cedrick_] Это мое финальное слово, Вилл, не усугубляй свое положение"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:124 #-#-# translate crowdin dialog_captive_will_5a70d2c0:
msgid "[_will_] Д-да.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:126 #-#-# translate crowdin dialog_captive_will_26c27d8c:
msgid "[_tarani_] Пф.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:128 #-#-# translate crowdin dialog_captive_will_091da595:
msgid "[_cornelia_] Мвввмв.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:130 #-#-# translate crowdin dialog_captive_will_2fc0ec41:
msgid "[_cedrick_] (Ух, Корнелии явно нравится, как я отчитываю ее подруг. Она стала работать ртом куда активнее)"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:132 #-#-# translate crowdin dialog_captive_will_cfd240a6:
msgid "[_cedrick_] (Но надо постараться не кончать до того, как я не оглашу все результаты..)"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:142 #-#-# translate crowdin dialog_captive_irma_cafdf7bc:
msgid "[_cedrick_] Следующая на очереди - Ирма"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:144 #-#-# translate crowdin dialog_captive_irma_e3e59787:
msgid "[_cedrick_] Ты выступала на стороне моей защиты, но из-за твоей выходки все сказанное тобой скорее пошло в защиту Мактиннена, а для меня звучало как обвинение"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:146 #-#-# translate crowdin dialog_captive_irma_2879661c:
msgid "[_irma_] П-прости.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:148 #-#-# translate crowdin dialog_captive_irma_c59c5e97:
msgid "[_tarani_] Ирма, хватит! Ты сделала все правильно, ни к чему тебе.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:150 #-#-# translate crowdin dialog_captive_irma_09ec171a:
msgid "[_cedrick_] Тарани, то, что в твоем рту нет кляпа лучше воспринимать как доброту с моей стороны. Не испытывай мое терпение, сейчас ты не в том положении, чтобы возникать"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:152 #-#-# translate crowdin dialog_captive_irma_bcd75d3e:
msgid "[_tarani_] Тебе это с рук не сойдет.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:154 #-#-# translate crowdin dialog_captive_irma_b63df0bb:
msgid "[_cedrick_] И так, Ирма получает оценку неудовлетворительно. Этот момент мы с тобой еще обязательно проработаем"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:156 #-#-# translate crowdin dialog_captive_irma_cd18ed6c:
msgid "[_irma_] Я поняла.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:158 #-#-# translate crowdin dialog_captive_irma_5e4a2fb4:
msgid "[_cornelia_] Ааааввв.. Я могу помочь профести с ней дополнительные фанятия.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:160 #-#-# translate crowdin dialog_captive_irma_93e8b45f:
msgid "[_cedrick_] Хах, для тебя у меня будет особое задание, Корнелия, а пока не отвлекайся"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:162 #-#-# translate crowdin dialog_captive_irma_b3b8f18b:
msgid "[_cornelia_] Афаам.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:175 #-#-# translate crowdin itog_grade_ac4be0b7:
msgid "[_cornelia_] Аааамммвв.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:177 #-#-# translate crowdin itog_grade_073d8b54:
msgid "[_cedrick_] Ухх, К-корнелия.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:179 #-#-# translate crowdin itog_grade_011ce536:
msgid "[_cornelia_] Авааа.. Кончи мне пвямо в рот.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:181 #-#-# translate crowdin itog_grade_7c8c51ce:
msgid "[_cedrick_] Уффф.. Н-на этом выставление оценок можно считать законченным.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:183 #-#-# translate crowdin itog_grade_f5bbdda5:
msgid "[_cedrick_] Черт, Корнелия, ты отлично используешь язык.. К-кончаю.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:188 #-#-# translate crowdin itog_grade_e23f819b:
msgid "[_will_] (Это должна была быть я..)"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:190 #-#-# translate crowdin itog_grade_4e7b29a3:
msgid "[_irma_] (Корнелии это судя по всему искренне нравится..)"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:192 #-#-# translate crowdin itog_grade_873cca31:
msgid "[_tarani_] (Как она только может получать удовольствие от подобного..)"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:193 #-#-# translate crowdin itog_grade_277d3735:
msgid "[_cornelia_] (Аааххх.. Так приятно чувствовать себя нужной.. Даже если это кто-то вроде Седрика..)"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:198 #-#-# translate crowdin itog_grade_46081999:
msgid "[_cedrick_] Булдж, подойди"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:199 #-#-# translate crowdin itog_grade_462ee1a0:
msgid "[_bulj_] Вызывали, сэр?"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:200 #-#-# translate crowdin itog_grade_a632bcec:
msgid "[_cedrick_] Да. Я составил список инструментов и магических предметов, необходимый мне. Как быстро сможешь достать"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:201 #-#-# translate crowdin itog_grade_cbc7d4c7:
msgid "[_bulj_] Так.. Это у нас есть в казарме.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:202 #-#-# translate crowdin itog_grade_5fd98188:
msgid "[_bulj_] Это в пыточной найдется.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:203 #-#-# translate crowdin itog_grade_0fd9ecbd:
msgid "[_bulj_] Ух, и эту тварь хотите задействовать? Сурово.."
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:204 #-#-# translate crowdin itog_grade_b93c531d:
msgid "[_bulj_] Так, и зелья, восстанавливающие магическую силу. Я так понимаю вам 10 штук, на два использования.. Это будет готово только через пару дней"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:205 #-#-# translate crowdin itog_grade_4d27d41e:
msgid "[_cedrick_] Отлично. Как раз успею закончить кое-какие дела на Земле и привести сюда Хай Лин"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:206 #-#-# translate crowdin itog_grade_c910ecfb:
msgid "[_cedrick_] Присмотри пока за стражницами. Никто не должен знать, что они здесь"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:207 #-#-# translate crowdin itog_grade_a5cd1f4f:
msgid "[_bulj_] Вас понял, Главнокомандующий. К вашему возвращению все будет готово"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:208 #-#-# translate crowdin itog_grade_d2b8436c:
msgid "[_cedrick_] Так держать, Булдж"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:214 #-#-# translate crowdin gallery_d_085_6dbf7e9e:
msgid "[_will_] Рик, не так быстро!"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:215 #-#-# translate crowdin gallery_d_085_8d127cbf:
msgid "[_cedrick_] Хм, что такое, Вилл?"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:218 #-#-# translate crowdin gallery_d_085_8c156ff0:
msgid "[_will_] Уж не знаю, что ты там задумал, но я хочу обжаловать твою оценку! Все ведь по школьным правилам, верно? Значит и такая функция есть"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:219 #-#-# translate crowdin gallery_d_085_fda4fc86:
msgid "[_cedrick_] (Хах, умно. Иногда ее рвение дает интересные плоды)"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:223 #-#-# translate crowdin gallery_d_085_23149570:
msgid "[_cedrick_] Хм, допустим так. И как же ты хочешь обжаловать мое решение?"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:226 #-#-# translate crowdin gallery_d_085_8b21497a:
msgid "[_cornelia_] Седрик, это все конечно очень интересно, но что насчет меня?"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:227 #-#-# translate crowdin gallery_d_085_d4ee1b0e:
msgid "[_cedrick_] Да, Корнелия, ты хорошо поработала, так что можешь идти отдыхать"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:231 #-#-# translate crowdin gallery_d_085_6774af07:
msgid "[_cornelia_] Урааа! Спасибо, Седрик"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:237 #-#-# translate crowdin gallery_d_085_1501e75f:
msgid "[_tarani_] А что насчет меня?"
msgstr ""

# game/scripts/quests/questReportForPrincePhobos/conversation_with_guards.rpy:238 #-#-# translate crowdin gallery_d_085_b45e7811:
