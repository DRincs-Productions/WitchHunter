# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:52 #-#-# translate crowdin gallery_d_052_cd63e35e:
msgid "[_elion_] Думаю, это вполне ожидаемо, что рано или поздно я бы тебе отсосала. К сексу я пока явно не готова, это слишком ответственный для меня шаг. Но.. Но отсосать тебе, Рик, я готова"
msgstr ""

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:54 #-#-# translate crowdin gallery_d_052_3ede2948:
msgid "[_cedrick_] (Ебать, такого ответа я не ожидал. Эту девчонку уже даже не нужно шантажировать, еще чуть-чуть и она скоро сама ко мне в штаны полезет..)"
