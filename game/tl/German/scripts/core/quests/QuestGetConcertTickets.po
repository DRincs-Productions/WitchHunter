# TODO: Translation updated at 2023-07-25 15:56 #|#|# # §translate crowdin strings: #|#|# # game/scripts/core/quests/QuestGetConcertTickets.rpy:3
msgid "Музыкальная группа Сортирный союз"
msgstr "Die Musikgruppe Sorta Union"

# game/scripts/core/quests/QuestGetConcertTickets.rpy:22
msgid "Достать билеты на концерт Сортирного союза (по телефону либо в магазине Wall mart)"
msgstr "Holen Sie sich Tickets für das Konzert der Sorting Union (per Telefon oder im Wall-Mart)"

# game/scripts/core/quests/QuestGetConcertTickets.rpy:22
msgid "Попросить Бланка достать билеты на концерт"
msgstr "Bitten Sie Blank, Karten für das Konzert zu besorgen"

# game/scripts/core/quests/QuestGetConcertTickets.rpy:22
msgid "Добыть футболку для Бланка"
msgstr "Um ein T-Shirt für Blank zu bekommen"

# game/scripts/core/quests/QuestGetConcertTickets.rpy:22
msgid "Отдать футболку Бланку"
msgstr "Um Rohlings T-Shirt zu geben"

# game/scripts/core/quests/QuestGetConcertTickets.rpy:22
msgid "Дождаться когда Бланк добудет билеты и забрать их"
msgstr "Warten Sie darauf, dass Blank die Tickets erhält und holen Sie sie ab"

# game/scripts/core/quests/QuestGetConcertTickets.rpy:22
msgid "Позвать Корнелию на концерт когда она заглянет в Букшоп"
msgstr "Bringen Sie Cornelia dazu, zum Konzert zu kommen, wenn sie in der Buchhandlung vorbeikommt"

# game/scripts/core/quests/QuestGetConcertTickets.rpy:22
msgid "Сходить на концерт с Корнелией вечером, дождавшись ее в Букшопе"
msgstr "Abends mit Cornelia zu einem Konzert gehen, in der Buchhandlung auf sie warten"

