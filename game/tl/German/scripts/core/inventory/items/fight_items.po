msgid "Большое Зелье Здоровья"
msgstr "Großer Gesundheitstrank"

# game/scripts/core/inventory/items/fight_items.rpy:2
msgid "Зелье восстанавливает 100 единиц здоровья"
msgstr "Der Trank stellt 100 Lebenspunkte wieder her"

# game/scripts/core/inventory/items/fight_items.rpy:2
msgid "Малое Зелье Здоровья"
msgstr "Kleiner Gesundheitstrank"

# game/scripts/core/inventory/items/fight_items.rpy:2
msgid "Зелье восстанавливает 50 единиц здоровья"
msgstr "Der Trank stellt 50 Einheiten Gesundheit wieder her"

# game/scripts/core/inventory/items/fight_items.rpy:2
msgid "Зелье с ядом"
msgstr "Gifttrank"

# game/scripts/core/inventory/items/fight_items.rpy:2
msgid "Отравляет врага на 5 ходов, каждый ход враг получает 15 урона"
msgstr "Vergiftet den Feind 5 Runden lang, jede Runde erleidet der Feind 15 Schaden"

# game/scripts/core/inventory/items/fight_items.rpy:2
msgid "Сонное зелье"
msgstr "Schlaftrunk"

# game/scripts/core/inventory/items/fight_items.rpy:2
msgid "Заставляет уснуть врага на 3 хода"
msgstr "Verursacht, dass der Gegner 3 Runden lang schläft"

# game/scripts/core/inventory/items/fight_items.rpy:2
msgid "Паутинное зелье"
msgstr "Zaubertrank der Spinne"

# game/scripts/core/inventory/items/fight_items.rpy:2
msgid "Замедляет врага на 4 хода"
msgstr "Verlangsamt den Feind für 4 Runden"

