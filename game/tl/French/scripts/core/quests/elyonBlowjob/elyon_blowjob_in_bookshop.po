# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:88 #-#-# translate crowdin gallery_d_052_4892a06c:
msgid "[_elion_] Мм, ну.. я постараюсь.."
msgstr "[_elion_] Um, bien... Je vais essayer de..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:91 #-#-# translate crowdin gallery_d_052_a20cefa7_1:
msgid "..."
msgstr "..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:92 #-#-# translate crowdin gallery_d_052_76b471ea:
msgid "[_elion_] Аааам"
msgstr "[_elion_] Aaam"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:96 #-#-# translate crowdin gallery_d_052_d0d60e84:
msgid "[_cedrick_] Оооххх, как тепло.."
msgstr "[_cedrick_] Ooohhhhh, quelle chaleur..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:97 #-#-# translate crowdin gallery_d_052_cb98770b:
msgid "[_elion_] (Не могу поверить, Рик практически трахает меня в рот..)"
msgstr "[_elion_] (Je n'arrive pas à croire que Rick me baise pratiquement dans la bouche...)"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:98 #-#-# translate crowdin gallery_d_052_eca8629b:
msgid "[_cedrick_] Так, хорошо, главное будь поаккуратнее с зубами.."
msgstr "[_cedrick_] D'accord, fais juste attention à tes dents..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:99 #-#-# translate crowdin gallery_d_052_6b07f613:
msgid "[_elion_] Х-хофофо"
msgstr "[_elion_] X-hofofo"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:102 #-#-# translate crowdin gallery_d_052_a20cefa7_2:
