# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:7 #-#-# translate crowdin gallery_d_052_380afb6d:
msgid "[_cedrick_] Элион, у меня к тебе есть серьезный разговор"
msgstr "[_cedrick_] Elyon, j'ai quelque chose de sérieux à vous dire."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:15 #-#-# translate crowdin gallery_d_052_1556e974:
msgid "[_elion_] Д-да, Рик, что-то стряслось?"
msgstr "[_elion_] O-oui, Rick, quelque chose ne va pas ?"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:16 #-#-# translate crowdin gallery_d_052_985eb14c:
msgid "[_cedrick_] Мне не хотелось этого признавать, Элион, но последнее время ты очень плохо справляешься со своими обязанностями"
msgstr "[_cedrick_] Je déteste l'admettre, Elyon, mais vous avez été très mauvais dans votre travail ces derniers temps."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:19 #-#-# translate crowdin gallery_d_052_c4608af3:
msgid "[_elion_] Ч-что?! Что ты имеешь ввиду, Рик?"
msgstr "[_elion_] Q-Quoi ? ! Qu'est-ce que tu veux dire, Rick ?"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:20 #-#-# translate crowdin gallery_d_052_58a32c40:
msgid "[_cedrick_] Подожди, дай мне договорить. Например, пыль на верхней полке – я проверил ее сегодня, ее там чертовски много"
msgstr "[_cedrick_] Attends, laisse-moi finir. Comme la poussière sur l'étagère du haut - j'ai vérifié aujourd'hui, il y en a beaucoup."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:23 #-#-# translate crowdin gallery_d_052_2c7b8b9f:
msgid "[_elion_] Но ты же постоянно лапаешь меня, когда я пытаюсь там прибраться.."
msgstr "[_elion_] Mais tu me tripotes toujours quand j'essaie de nettoyer..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:24 #-#-# translate crowdin gallery_d_052_364f570c:
msgid "[_cedrick_] Так же, я заметил, что все наши книги не отсортированы в алфавитном порядке"
msgstr "[_cedrick_] J'ai aussi remarqué que tous nos livres ne sont pas triés par ordre alphabétique."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:27 #-#-# translate crowdin gallery_d_052_87afeec8:
msgid "[_elion_] Потому что я отсортировала их по жанрам.."
msgstr "[_elion_] Parce que je les ai triés par genre..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:28 #-#-# translate crowdin gallery_d_052_30d4dbd3:
msgid "[_cedrick_] И самое главное, Элион.. За все время работы ты не продала ни единой книги. А это же книжный магазин, как вообще такое возможно?"
msgstr "[_cedrick_] Et le plus important, Elion... Tu n'as pas vendu un seul livre depuis que tu es ici. Et c'est une librairie, comment c'est possible ?"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:31 #-#-# translate crowdin gallery_d_052_f7a923a8:
msgid "[_elion_] Но ты же никогда не просил меня продавать книги и сам всегда стоишь за прилавком.."
msgstr "[_elion_] Mais tu ne m'as jamais demandé de vendre des livres et tu es toujours derrière le comptoir toi-même..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:32 #-#-# translate crowdin gallery_d_052_18ebc686:
msgid "[_cedrick_] В свете всех этих событий, мне ничего не остается, кроме как уволить тебя"
msgstr "[_cedrick_] À la lumière de tout cela, je n'ai pas d'autre choix que de vous renvoyer"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:35 #-#-# translate crowdin gallery_d_052_89c59728:
msgid "[_elion_] ..."
msgstr "[_elion_] ..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:36 #-#-# translate crowdin gallery_d_052_64f38a43:
msgid "[_cedrick_] Но, подожди, не паникуй. Я готов простить тебя и закрывать в дальнейшем глаза на твое халатное отношение к работе, если.."
msgstr "[_cedrick_] Mais, attends, ne panique pas. Je suis prêt à te pardonner et à fermer les yeux sur ton attitude négligente envers le travail à l'avenir, si..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:39 #-#-# translate crowdin gallery_d_052_ec519dda:
msgid "[_elion_] ...Если?"
msgstr "[_elion_] ...Si ?"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:40 #-#-# translate crowdin gallery_d_052_f5bee51b:
msgid "[_cedrick_] Если ты прямо сейчас мне отсосешь"
msgstr "[_cedrick_] Si tu me suces maintenant"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:43 #-#-# translate crowdin gallery_d_052_14ebd1d8:
msgid "[_elion_] ...Ты просто хотел, чтобы я тебе отсосала, но не смог найти достойный предлог?"
msgstr "[_elion_] ...Tu voulais juste que je te suce, mais tu n'as pas trouvé d'excuse valable ?"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:44 #-#-# translate crowdin gallery_d_052_4ad81dea:
msgid "[_cedrick_] Совсем не.."
msgstr "[_cedrick_] Pas du tout..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:47 #-#-# translate crowdin gallery_d_052_a9808e58:
msgid "[_elion_] Ты же мог просто попросить меня.."
msgstr "[_elion_] Vous auriez pu simplement me demander..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:48 #-#-# translate crowdin gallery_d_052_25b7a4cd:
msgid "[_cedrick_] Не... Что!? Что ты сейчас сказала?"
msgstr "[_cedrick_] Ne fais pas... Quoi ? Qu'est-ce que tu viens de dire ?"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:51 #-#-# translate crowdin gallery_d_052_eb9a7429:
msgid "[_elion_] Э-эм, ну.. После всего, что мы делали вместе и после того, как много ты помогал мне с развратной стороной моего характера..."
msgstr "[_elion_] Um, eh bien... Après tout ce que nous avons fait ensemble et après combien vous m'avez aidé avec le côté dépravé de mon personnage..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:52 #-#-# translate crowdin gallery_d_052_cd63e35e:
msgid "[_elion_] Думаю, это вполне ожидаемо, что рано или поздно я бы тебе отсосала. К сексу я пока явно не готова, это слишком ответственный для меня шаг. Но.. Но отсосать тебе, Рик, я готова"
msgstr "[_elion_] Je pense qu'il faut s'attendre à ce que tôt ou tard, je te taille une pipe. Je ne suis évidemment pas encore prête pour le sexe, c'est une étape trop responsable pour moi. Mais... Mais je suis prête à te sucer, Rick."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:54 #-#-# translate crowdin gallery_d_052_3ede2948:
msgid "[_cedrick_] (Ебать, такого ответа я не ожидал. Эту девчонку уже даже не нужно шантажировать, еще чуть-чуть и она скоро сама ко мне в штаны полезет..)"
msgstr "[_cedrick_] (Putain, je ne m'attendais pas à cette réponse. Cette fille n'a même plus besoin qu'on la fasse chanter, elle sera dans mon pantalon en un rien de temps...)"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:55 #-#-# translate crowdin gallery_d_052_f9aed630:
msgid "[_cedrick_] (Не думал, что с ней будет так просто. Видимо, нужно было просто найти правильный подход. К тому же не стоит забывать, что в ее семье и так одни развратники и насильники)"
msgstr "[_cedrick_] (Je ne pensais pas que ce serait aussi facile avec elle. Je suppose que je devais juste trouver la bonne approche. De plus, n'oublie pas que sa famille est déjà pleine d'abuseurs et de violeurs)."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:58 #-#-# translate crowdin gallery_d_052_f9d60fcd:
msgid "[_elion_] Рик?"
msgstr "[_elion_] Rick ?"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:59 #-#-# translate crowdin gallery_d_052_0e69be3b:
msgid "[_cedrick_] А, да, кхм.. Хорошо, не буду ломать комедию, я просто хочу, чтобы ты мне отсосала"
msgstr "[_cedrick_] Oh, ouais, ahem... OK, je ne vais pas faire la comédie, je veux juste que tu me suces."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:62 #-#-# translate crowdin gallery_d_052_3a45f712:
msgid "[_elion_] Хах, я уже поняла"
msgstr "[_elion_] Huh, je comprends."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:63 #-#-# translate crowdin gallery_d_052_0b79aaff:
msgid "[_cedrick_] Прямо сейчас"
msgstr "[_cedrick_] En ce moment même"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:66 #-#-# translate crowdin gallery_d_052_63aa7bcb:
msgid "[_elion_] Ч-что? Прямо посреди дня, когда в любой момент могут зайти посетители?"
msgstr "[_elion_] Q-quoi ? En plein milieu de la journée, alors que des visiteurs peuvent arriver à tout moment ?"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:67 #-#-# translate crowdin gallery_d_052_1a2d26e2:
msgid "[_cedrick_] Именно так. Тебя что-то смущает, ты же минуту назад выражала полную готовность"
msgstr "[_cedrick_] Exactement. Vous êtes embarrassé par quelque chose, il y a juste une minute vous avez exprimé votre volonté de..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:70 #-#-# translate crowdin gallery_d_052_b22659f0:
msgid "[_elion_] Эм, н-ну.."
msgstr "[_elion_] Um, n-bien..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:71 #-#-# translate crowdin gallery_d_052_a0402e64:
msgid "[_cedrick_] (Если она готова, это не значит, что моя работа закончена. Нужно продолжать бросать ей новые вызовы, чтобы еще больше развратить..)"
msgstr "[_cedrick_] (Si elle est prête, cela ne signifie pas que mon travail est terminé. Il faut continuer à la défier pour la corrompre encore plus...)"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:74 #-#-# translate crowdin gallery_d_052_a59a0a08:
msgid "[_elion_] Х-хорошо, я готова.. Если подумать, это довольно возбуждающе.."
msgstr "[_elion_] H-okay, je suis prêt... Si vous y pensez, c'est assez excitant..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:75 #-#-# translate crowdin gallery_d_052_1af49d12:
msgid "[_cedrick_] Отлично, тогда располагайся"
msgstr "[_cedrick_] Bien, alors mettez-vous à l'aise."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:77 #-#-# translate crowdin gallery_d_052_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:81 #-#-# translate crowdin gallery_d_052_a5edb1e0:
msgid "[_cedrick_] Уффф, да, Элион, отлично.."
msgstr "[_cedrick_] Ouf, oui, Elyon, super..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:82 #-#-# translate crowdin gallery_d_052_b3c5af5c:
msgid "[_elion_] Р-рик, тебе нравится? Я все правильно делаю?"
msgstr "[_elion_] R-r-rick, tu aimes ça ? Est-ce que je le fais bien ?"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:83 #-#-# translate crowdin gallery_d_052_fca8030a:
msgid "[_cedrick_] Д-да, продолжай. Ты хорошо работаешь губками.."
msgstr "[_cedrick_] O-oui, continuez. Tu fais un bon travail avec tes lèvres..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:84 #-#-# translate crowdin gallery_d_052_3a3ede1a:
msgid "[_elion_] В-вдруг нас кто-то увидит.."
msgstr "[_elion_] Au cas où quelqu'un nous verrait..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:85 #-#-# translate crowdin gallery_d_052_f219e6e7:
msgid "[_cedrick_] Не переживай, со стороны не происходит ничего необычного.. Просто, оххх, я периодически издаю странные звуки"
msgstr "[_cedrick_] Ne vous inquiétez pas, il n'y a rien d'extraordinaire qui se passe... C'est juste que, ohhhh, je fais des bruits bizarres de temps en temps."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:86 #-#-# translate crowdin gallery_d_052_7b5bc50d:
msgid "[_elion_] Х-хорошо.."
msgstr "[_elion_] H-okay..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:87 #-#-# translate crowdin gallery_d_052_0541e3ea:
msgid "[_cedrick_] Элион, сможешь взять его в рот?"
