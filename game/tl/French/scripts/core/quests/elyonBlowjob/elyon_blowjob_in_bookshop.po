msgstr "[_will_] Rick, salut."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:107 #-#-# translate crowdin gallery_d_052_b5951cd5:
msgid "[_cedrick_] Вилл!?"
msgstr "[_cedrick_] Will !?"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:108 #-#-# translate crowdin gallery_d_052_b6af30b5:
msgid "[_elion_] (Вилл!?)"
msgstr "[_elion_] (Will !?)"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:109 #-#-# translate crowdin gallery_d_052_031650f8:
msgid "[_cedrick_] Ч-что ты тут делаешь?"
msgstr "[_cedrick_] Qu'est-ce que tu fais ici ?"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:110 #-#-# translate crowdin gallery_d_052_b7ad2194:
msgid "[_will_] Эм, ну.. Это же книжный магазин.. А я пришла за книгами.."
msgstr "[_will_] Hum, eh bien... C'est une librairie... Et je suis ici pour les livres..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:111 #-#-# translate crowdin gallery_d_052_8adebd7e:
msgid "[_cedrick_] А, д-да, я просто, уфф.."
msgstr "[_cedrick_] Oh, oui, j'ai juste, euh..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:112 #-#-# translate crowdin gallery_d_052_5b107787:
msgid "[_cedrick_] (Черт, а это негодница не останавливается. Хотя, не буду отрицать, что это еще сильнее возбуждает)"
msgstr "[_cedrick_] (Merde, et ce coquin ne s'arrête pas. Bien que je ne nierai pas que c'est encore plus excitant)"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:113 #-#-# translate crowdin gallery_d_052_a1f9c0f9:
msgid "[_will_] Рик, все хорошо?"
msgstr "[_will_] Rick, tu vas bien ?"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:114 #-#-# translate crowdin gallery_d_052_84b3670d:
msgid "[_cedrick_] Д-да, просто нога вдруг резко заболела.."
msgstr "[_cedrick_] Oui, c'est juste que ma jambe est devenue soudainement très douloureuse..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:115 #-#-# translate crowdin gallery_d_052_f3443eda:
msgid "[_will_] Хреново.. Эм, так вот.. Помнишь мы с тобой проходили племенные группы ацтеков? Может не подскажешь подходящую книгу для повторения, нам на завтрашний тест нужно"
msgstr "[_will_] Ca craint. Hum, alors... Tu te souviens des groupes tribaux aztèques qu'on a étudiés ? Tu as de bons livres à réviser, on a un contrôle demain."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:116 #-#-# translate crowdin gallery_d_052_aec6e6ae:
msgid "[_cedrick_] Ммффф, д-да, конечно. Это есть в книге про культуру Мексики 14-16 века. К-кажется это третий шкаф справа, шестая полка, где-то слева"
msgstr "[_cedrick_] Mmfffff, o-oui, bien sûr. C'est dans un livre sur la culture du Mexique des 14-16ème siècles. Je pense que c'est le troisième cabinet en partant de la droite, sixième étagère, quelque part sur la gauche."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:117 #-#-# translate crowdin gallery_d_052_503ed655:
msgid "[_will_] О, кажется нашла. Сколько с меня"
msgstr "[_will_] Oh, je crois que je l'ai trouvé. Combien je dois"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:118 #-#-# translate crowdin gallery_d_052_270dc51c:
msgid "[_cedrick_] Э-эм, уфф, да не важно, можешь просто потом вернуть"
msgstr "[_cedrick_] Erm, ooh, c'est pas grave, tu peux le rendre plus tard."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:119 #-#-# translate crowdin gallery_d_052_c7f94249:
msgid "[_will_] А, хорошо. Спасибо, Рик! Ладно, я побегу по делам, надеюсь твоя нога придет в норму"
msgstr "[_will_] Ah, bien. Merci, Rick ! Bon, je vais aller faire quelques courses, j'espère que ta jambe ira mieux."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:120 #-#-# translate crowdin gallery_d_052_141a93da:
msgid "[_cedrick_] А-ага.. обязательно.."
msgstr "[_cedrick_] Uh-huh..."

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:124 #-#-# translate crowdin gallery_d_052_93e5f9b1:
msgid "[_elion_] Она уфла?"
msgstr "[_elion_] Est-elle ufla ?"

# game/scripts/core/quests/elyonBlowjob/elyon_blowjob_in_bookshop.rpy:125 #-#-# translate crowdin gallery_d_052_078c1601:
