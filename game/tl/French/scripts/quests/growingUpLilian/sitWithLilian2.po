# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:260 #-#-# translate crowdin minigame_2_21124fb0:
msgid "[_cedrick_] (Вроде бы спит она крепко.. Для начала стоит аккуратно снять с нее одеяло)"
msgstr "[_cedrick_] (Elle semble dormir profondément, il est conseillé de commencer par lui enlever doucement sa couverture)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:274 #-#-# translate crowdin minigame_2_9658c27f:
msgid "[_lilith_] Мхх.. Ч-что?"
msgstr "[_lilith_] Mm-hmm. Qu'est-ce qu'il y a ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:276 #-#-# translate crowdin minigame_2_884040b8:
msgid "[_cedrick_] Вот черт.."
msgstr "[_cedrick_] Oh, merde."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:278 #-#-# translate crowdin minigame_2_460f27c4:
msgid "[_lilith_] Что происходит.."
msgstr "[_lilith_] Qu'est-ce qui se passe..."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:279 #-#-# translate crowdin minigame_2_c7fffe04:
msgid "[_lilith_] Рик?"
msgstr "[_lilith_] Rick ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:281 #-#-# translate crowdin minigame_2_4263b25f:
msgid "[_cedrick_] Эм.. Да, Лилит?"
msgstr "[_cedrick_] Oui, Lilith ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:283 #-#-# translate crowdin minigame_2_6f338fec:
msgid "[_lilith_] Что ты делаешь?"
msgstr "[_lilith_] Que faites-vous ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:285 #-#-# translate crowdin minigame_2_b6e8cbfa:
msgid "[_cedrick_] Я просто хотел укрыть тебя одеялом поплотнее"
msgstr "[_cedrick_] Je voulais juste te border avec une couverture."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:287 #-#-# translate crowdin minigame_2_0b90b7dd:
msgid "[_lilith_] И поэтому его на мне нет? Все с тобой ясно, Рик. Решил воспользоваться моей слабостью?"
msgstr "[_lilith_] C'est pour ça que je ne le porte pas ? Tout est clair pour toi, Rick. Vous profitez de ma faiblesse ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:288 #-#-# translate crowdin minigame_2_b7867ecb:
msgid "[_cedrick_] Эм, нет, я.."
msgstr "[_cedrick_] Euh, non, je..."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:289 #-#-# translate crowdin minigame_2_402f5bd6:
msgid "[_lilith_] Выметайся отсюда, Рик. Иначе я вызову полицию. Сил набрать номер у меня хватит, уж поверь"
msgstr "[_lilith_] Sors d'ici, Rick. Ou j'appelle la police. Je suis assez fort pour composer un numéro, crois-moi."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:291 #-#-# translate crowdin minigame_2_ee44a430:
msgid "[_cedrick_] (Черт.. Придется отступить.. Да и не думаю что после подобного она меня к себе подпустит)"
msgstr "[_cedrick_] (Bon sang... Je vais devoir reculer. Et je ne pense pas qu'elle me laissera partir après ça)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:292 #-#-# translate crowdin minigame_2_2529c999:
msgid "[_cedrick_] (Это был единственный шанс.. К тому же отношения с Корнелией это тоже явно испортит.. Я облажался)"
msgstr "[_cedrick_] (C'était la seule chance... En plus, ça va tout gâcher avec Cornelia. J'ai merdé.)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:309 #-#-# translate crowdin gallery_d_039_c5f7bd83:
msgid "[_cedrick_] (Отлично! У меня получилось снять одеяло и не разбудить ее)"
msgstr "[_cedrick_] (Super ! J'ai réussi à enlever la couverture sans la réveiller)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:310 #-#-# translate crowdin gallery_d_039_0dc19019:
msgid "[_cedrick_] (Но это только начало.. Основная проблема будет в том, чтобы найти что-то, похожее на волшебный артефакт, и при этом не потревожить ее..)"
msgstr "[_cedrick_] (Mais ce n'est que le début... Le principal problème sera de trouver quelque chose qui ressemble à un artefact magique, et en même temps de ne pas la déranger...)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:311 #-#-# translate crowdin gallery_d_039_2d865931:
msgid "[_cedrick_] (Я сильно рискую, но возможно шанса лучше уже не будет)"
msgstr "[_cedrick_] (Je prends un gros risque, mais il n'y a peut-être pas de meilleure chance)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:312 #-#-# translate crowdin gallery_d_039_79ddbea6:
msgid "[_cedrick_] (Можно было бы постепенно втереться к ней в доверие и облапать с ее согласия, но не факт, что у меня получится..)"
msgstr "[_cedrick_] (Je pourrais progressivement gagner sa confiance et la tripoter avec son consentement, mais je ne sais pas si j'en serais capable...)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:313 #-#-# translate crowdin gallery_d_039_3f9bab3a:
msgid "[_cedrick_] (К тому же, учитывая, что она учится в интернате, она может пропасть из виду в любой момент)"
msgstr "[_cedrick_] (De plus, étant donné qu'elle est en internat, elle peut disparaître à tout moment)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:314 #-#-# translate crowdin gallery_d_039_3595f962:
msgid "[_cedrick_] (Риск оправдан, я должен попытаться.. Но действовать нужно очень аккуратно)"
msgstr "[_cedrick_] (Le risque est justifié, je dois essayer... Mais je dois être très prudent)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:315 #-#-# translate crowdin gallery_d_039_04621f1a:
msgid "[_cedrick_] (Самое время вспомнить старые навыки, как когда я ласкал самых робких придворных дам)"
msgstr "[_cedrick_] (C'est le bon moment pour se rappeler d'anciennes compétences, comme lorsque j'avais l'habitude de caresser les plus timides des dames de la cour)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:322 #-#-# translate crowdin gallery_d_039_b4e1658d:
msgid "[_lilith_] (Мххх.. Ч-что это..)"
msgstr "[_lilith_] (Mm-hmm. Qu'est-ce que c'est.)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:325 #-#-# translate crowdin gallery_d_039_da8788b5:
msgid "[_lilith_] (Это чувство..)"
msgstr "[_lilith_] (C'est un sentiment...)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:328 #-#-# translate crowdin gallery_d_039_3a99c4f0:
msgid "[_lilith_] (Эти прикосновения…)"
msgstr "[_lilith_] (Ces touches…)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:331 #-#-# translate crowdin gallery_d_039_47661d3d:
msgid "[_cedrick_] (Хм.. здесь ничего..)"
msgstr "[_cedrick_] (Hmm...rien ici...)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:334 #-#-# translate crowdin gallery_d_039_c22be3cf:
msgid "[_cedrick_] (Может быть тут?)"
msgstr "[_cedrick_] (Peut-être ici ?)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:339 #-#-# translate crowdin gallery_d_039_531ffc6e:
msgid "[_lilith_] (Аххх.. Это сон?)"
msgstr "[_lilith_] (Ahhhh. Est-ce un rêve ?)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:342 #-#-# translate crowdin gallery_d_039_1bcbae03:
msgid "[_lilith_] (Или реальность..)"
msgstr "[_lilith_] (Ou la réalité...)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:345 #-#-# translate crowdin gallery_d_039_cffefc2b:
msgid "[_lilith_] (Н-нет, я брежу..)"
msgstr "[_lilith_] (N-non, je délire...)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:348 #-#-# translate crowdin gallery_d_039_cff5dc2d:
msgid "[_lilith_] (Но этот бред в полусне такой..)"
msgstr "[_lilith_] (Mais cette divagation est tellement...)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:351 #-#-# translate crowdin gallery_d_039_0e7ac59a:
msgid "[_lilith_] (Такой пикантный.. Эти прикосновения такие нежные..)"
msgstr "[_lilith_] (Si savoureux, ces touches sont si tendres...)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:354 #-#-# translate crowdin gallery_d_039_ec32f2ce:
msgid "[_cedrick_] (И здесь ничего, кроме просто атрибутики..)"
msgstr "[_cedrick_] (Et rien d'autre qu'un simple attirail ici...)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:357 #-#-# translate crowdin gallery_d_039_24b9c9fd:
msgid "[_cedrick_] (Тогда попробую так)"
msgstr "[_cedrick_] (Je vais donc essayer de cette façon.)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:362 #-#-# translate crowdin gallery_d_039_399d6f02:
msgid "[_lilith_] (Мххх, так много прикосновений..)"
msgstr "[_lilith_] (Mhhhhh, tant de touches...)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:365 #-#-# translate crowdin gallery_d_039_7b613b55:
msgid "[_lilith_] (Быстрые и хаотичные, еле уловимые..)"
msgstr "[_lilith_] (Rapide et chaotique, à peine perceptible...)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:368 #-#-# translate crowdin gallery_d_039_c6bcf153:
msgid "[_lilith_] (Но при этом такие чуткие и аккуратные..)"
msgstr "[_lilith_] (Mais aussi si sensible et prudent...)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:373 #-#-# translate crowdin gallery_d_039_e042c9b9:
msgid "[_lilith_] (Что это.. Что это за чувство..)"
msgstr "[_lilith_] (Qu'est-ce que c'est ? Qu'est-ce que c'est que ce sentiment...)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:376 #-#-# translate crowdin gallery_d_039_874553ea:
msgid "[_lilith_] (У меня кружится голова.. Так странно..)"
msgstr "[_lilith_] (J'ai le vertige. C'est tellement bizarre.)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:379 #-#-# translate crowdin gallery_d_039_ad2b8090:
msgid "[_lilith_] (Но при этом так..)"
msgstr "[_lilith_] (Cela dit.)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:382 #-#-# translate crowdin gallery_d_039_2deb5a88:
msgid "[_lilith_] (Ах.. Меня словно домогаются.. Но при этом.. Делают это так аккуратно..)"
msgstr "[_lilith_] (Ah, j'ai l'impression d'être harcelé, mais c'est fait avec beaucoup de précautions)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:385 #-#-# translate crowdin gallery_d_039_0936f8c9:
msgid "[_lilith_] (Такие смешанные чувства..)"
msgstr "[_lilith_] (Des sentiments si contradictoires...)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:388 #-#-# translate crowdin gallery_d_039_47fa32fa:
msgid "[_lilith_] (Но при этом так спокойно..)"
msgstr "[_lilith_] (Et pourtant si calme...)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:391 #-#-# translate crowdin gallery_d_039_60648a81:
msgid "[_lilith_] (Сознание тускнеет.. Словно я проваливаюсь в еще более глубокий сон..)"
msgstr "[_lilith_] (La conscience s'estompe, c'est comme si je tombais dans un sommeil encore plus profond...)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:396 #-#-# translate crowdin gallery_d_039_3ff8d141:
msgid "[_cedrick_] (Черт, я работал с ее телом как настоящий ювелир или взломщик замков, но при этом не нашел ничего подозрительного..)"
msgstr "[_cedrick_] (J'ai travaillé sur son corps comme un vrai bijoutier ou un crocheteur de serrures, et pourtant je n'ai rien trouvé de suspect...)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:397 #-#-# translate crowdin gallery_d_039_0235e38e:
msgid "[_cedrick_] (Это раздражает…)"
msgstr "[_cedrick_] (C'est ennuyeux…)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:398 #-#-# translate crowdin gallery_d_039_3cf807a0:
msgid "[_cedrick_] (Еще больше раздражает то, что лапая ее тело я в итоге словил жесткий стояк)"
msgstr "[_cedrick_] (Ce qui est encore plus ennuyeux, c'est qu'en tripotant son corps, j'ai fini par avoir la trique)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:399 #-#-# translate crowdin gallery_d_039_3bb3b7ad:
msgid "[_cedrick_] (Черт, ее грудь и вправду бесподобна.. Ходить в таком топике, имея подобные размеры - это довольно жестокая провокация)"
msgstr "[_cedrick_] (Bon sang, ses seins sont vraiment incomparables.... Se promener avec un tel haut, à cette taille, est une provocation cruelle)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:400 #-#-# translate crowdin gallery_d_039_e31a6c2f:
msgid "[_cedrick_] (Ладно, хватит с меня. Просто разбужу ее и пойду домой)"
msgstr "[_cedrick_] (Bon, ça suffit, je vais la réveiller et rentrer chez moi)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:401 #-#-# translate crowdin gallery_d_039_6dca9e94:
msgid "[_cedrick_] Лилит"
msgstr "[_cedrick_] Lilith"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:402 #-#-# translate crowdin gallery_d_039_e19676fd:
msgid "[_lilith_] ..."
msgstr "[_lilith_] ..."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:403 #-#-# translate crowdin gallery_d_039_c4021896:
msgid "[_cedrick_] Лилит, я пожалуй пойду домой"
msgstr "[_cedrick_] Lilith, je crois que je vais rentrer chez moi."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:404 #-#-# translate crowdin gallery_d_039_699bdb6d:
msgid "[_lilith_] ...."
msgstr "[_lilith_] ...."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:405 #-#-# translate crowdin gallery_d_039_a316c96a:
msgid "[_cedrick_] Эм.. Ты меня слышишь?"
msgstr "[_cedrick_] Hum, vous m'entendez ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:406 #-#-# translate crowdin gallery_d_039_cbe14e91:
msgid "[_lilith_] ....."
msgstr "[_lilith_] ....."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:407 #-#-# translate crowdin gallery_d_039_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:408 #-#-# translate crowdin gallery_d_039_b20a7c6c:
msgid "[_cedrick_] Лилиан?"
msgstr "[_cedrick_] Lillian ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:409 #-#-# translate crowdin gallery_d_039_5e45d948:
msgid "[_lilith_] ......"
msgstr "[_lilith_] ......"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:410 #-#-# translate crowdin gallery_d_039_2f17bf47:
msgid "[_cedrick_] (Черт.. А она довольно крепко уснула)"
msgstr "[_cedrick_] (Mince. Elle est presque endormie.)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:411 #-#-# translate crowdin gallery_d_039_782da11f:
msgid "[_cedrick_] ...."
msgstr "[_cedrick_] ...."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:412 #-#-# translate crowdin gallery_d_039_ebed3d65:
msgid "[_cedrick_] ......."
msgstr "[_cedrick_] ......."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:413 #-#-# translate crowdin gallery_d_039_3af9e1f2:
msgid "[_cedrick_] (А, да какого черта..)"
msgstr "[_cedrick_] (Oh, et puis zut...)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:414 #-#-# translate crowdin gallery_d_039_6706b938:
msgid "[_cedrick_] (Я так долго нежил эту девчонку. Пора и мне получить немного удовольствия)"
msgstr "[_cedrick_] (J'ai cette fille depuis si longtemps, il est temps pour moi de m'amuser)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:419 #-#-# translate crowdin gallery_d_039_079cd6b9:
msgid "[_cedrick_] (Ухххх.. Когда вставляешь между ними член, они кажутся еще более огромными..)"
msgstr "[_cedrick_] (Uhhhhh. Quand on met sa bite entre eux, ils semblent encore plus gros...)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:420 #-#-# translate crowdin gallery_d_039_ee098f0e:
msgid "[_cedrick_] (Мххх, да, вот так..)"
msgstr "[_cedrick_] (Mhhhhh, oui, c'est ça...)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:421 #-#-# translate crowdin gallery_d_039_4d0b11e8:
msgid "[_cedrick_] (Хах, ее грудь идеально.. Так и хочется забить на все и забрать ее на Меридиан, только чтобы наслаждаться ее формами днями напролет)"
msgstr "[_cedrick_] (Huh, ses seins sont parfaits. Cela me donne envie de tout laisser tomber et de l'emmener à Meridian juste pour profiter de sa forme pendant des jours)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:422 #-#-# translate crowdin gallery_d_039_f40eff98:
msgid "[_cedrick_] (И как только она отрастила такие бидоны)"
msgstr "[_cedrick_] (Et comment a-t-elle fait pousser ces boîtes de conserve)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:423 #-#-# translate crowdin gallery_d_039_e915212f:
msgid "[_cedrick_] (Хм.. Насколько помню из научной литературы, шведские ученые обнаружили параллель между потреблением кофе и ростом женской груди в момент ее формирования)"
msgstr "[_cedrick_] (Hmmm... Si je me souviens bien de la littérature scientifique, des scientifiques suédois ont établi un parallèle entre la consommation de café et la croissance des seins des femmes en formation)."

