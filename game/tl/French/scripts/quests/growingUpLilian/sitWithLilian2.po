# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:6 #-#-# translate crowdin sitWithLilian2_ed6f5ac9:
msgid "Телефонный звонок"
msgstr "Appel téléphonique"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:9 #-#-# translate crowdin sitWithLilian2_2ad59957:
msgid "[_cedrick_] да?"
msgstr "[_cedrick_] N'est-ce pas ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:10 #-#-# translate crowdin sitWithLilian2_86f7bc99:
msgid "[_cornelia_] Рик, Это Корнелия! Прости, что опять тебя тревожу, но дело срочное!"
msgstr "[_cornelia_] Rick, c'est Cornelia. Désolée de te déranger encore, mais c'est urgent !"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:11 #-#-# translate crowdin sitWithLilian2_f7074bd6:
msgid "[_cornelia_] У меня появились неотложные дела и мне нужно ненадолго уехать. Не мог бы ты посидеть с Лилиан? Мои родители так и не вернулись, а мне ее не на кого оставить..."
msgstr "[_cornelia_] J'ai des affaires urgentes et je dois m'absenter un moment. Tu pourrais garder Lillian ? Mes parents ne sont pas rentrés et je n'ai personne à qui la laisser..."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:12 #-#-# translate crowdin sitWithLilian2_b38bb853:
msgid "[_cedrick_] Эм, знаешь, в прошлый раз у нас с Лилит все закончилось не самым лучшим образом.."
msgstr "[_cedrick_] Hum, tu sais, la dernière fois que Lilith et moi avons mal fini.."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:13 #-#-# translate crowdin sitWithLilian2_7ee977b9:
msgid "[_cornelia_] Рик, я знаю, иногда она та еще головная боль, но я не могу ее оставить.."
msgstr "[_cornelia_] Rick, je sais qu'elle est parfois un casse-tête, mais je ne peux pas la laisser.."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:14 #-#-# translate crowdin sitWithLilian2_697665c7:
msgid "[_cornelia_] Мне больше не на кого рассчитывать.."
msgstr "[_cornelia_] Je n'ai personne d'autre sur qui compter.."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:15 #-#-# translate crowdin sitWithLilian2_1b22e284:
msgid "[_cedrick_] Хорошо, Корнелия. Если для тебя это так важно, то конечно я присмотрю за ней"
msgstr "[_cedrick_] D'accord, Cornelia. Si c'est si important pour vous, bien sûr que je m'occuperai d'elle"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:16 #-#-# translate crowdin sitWithLilian2_54f9c4e9:
msgid "[_cornelia_] Спасибо, Рик! Я знала, что могу на тебя рассчитывать!"
msgstr "[_cornelia_] Merci, Rick ! Je savais que je pouvais compter sur toi !"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:17 #-#-# translate crowdin sitWithLilian2_cb522d35:
msgid "[_cornelia_] Ты не представляешь, как это для меня важно сейчас.."
msgstr "[_cornelia_] Tu n'as pas idée de l'importance que cela revêt pour moi en ce moment.."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:18 #-#-# translate crowdin sitWithLilian2_24acaa40:
msgid "[_cornelia_] Ты лучший!"
msgstr "[_cornelia_] Vous êtes le meilleur !"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:19 #-#-# translate crowdin sitWithLilian2_6adc8364:
msgid "[_cedrick_] (Мда, снова оставаться наедине с этой девчонкой..)"
msgstr "[_cedrick_] (Ouais, être à nouveau seul avec cette fille...)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:22 #-#-# translate crowdin sitWithLilian2_aa3e213b:
msgid "[_centered_] {size=37}позже в доме хейлов{/size}"
msgstr "[_centered_] {size=37}plus tard, dans la maison des Hale{/size}"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:26 #-#-# translate crowdin sitWithLilian2_b63eb2fb:
msgid "[_cedrick_] Как твое самочувствие, Лилит?"
msgstr "[_cedrick_] Comment vous sentez-vous, Lilith ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:28 #-#-# translate crowdin sitWithLilian2_0288b963:
msgid "[_lilith_] Еще хуже, если честно. Тот факт, что мне нужна нянька не делает ситуацию лучше"
msgstr "[_lilith_] C'est pire, pour être honnête. Le fait que j'aie besoin d'une baby-sitter n'arrange rien."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:29 #-#-# translate crowdin sitWithLilian2_693ce41e:
msgid "[_lilith_] Без обид, просто меня раздражает это чувство беспомощности"
msgstr "[_lilith_] Sans vouloir vous offenser, c'est juste que ce sentiment d'impuissance m'agace."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:31 #-#-# translate crowdin sitWithLilian2_2f72c9f0:
msgid "[_cedrick_] Без обид? Хах, я думал тебе все равно, обижусь я или нет"
msgstr "[_cedrick_] Sans rancune ? Je croyais que vous ne vous souciiez pas de savoir si j'étais offensé ou non."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:33 #-#-# translate crowdin sitWithLilian2_423181ee:
msgid "[_lilith_] Эм.. Мне все равно, просто.."
msgstr "[_lilith_] Je m'en fiche, je..."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:34 #-#-# translate crowdin sitWithLilian2_b74b61cc:
msgid "[_lilith_] Ладно, не суть. Я собиралась сейчас смотреть аниме. Не то чтобы у тебя есть выбор, но если хочешь, можешь присоединиться"
msgstr "[_lilith_] D'accord, peu importe. Je vais regarder un anime maintenant. Non pas que tu aies le choix, mais si tu veux, tu peux te joindre à moi."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:36 #-#-# translate crowdin sitWithLilian2_a4d6b593:
msgid "[_cedrick_] Эм.. Спасибо за предложение. Пожалуй у меня и вправду нет особо выбора"
msgstr "[_cedrick_] Merci pour l'offre. Je suppose que je n'ai pas vraiment le choix."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:38 #-#-# translate crowdin sitWithLilian2_1aaa7dcc:
msgid "[_cedrick_] (Смотреть аниме.. До чего я докатился?)"
msgstr "[_cedrick_] (Regarder un anime. Où en suis-je arrivé ?)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:41 #-#-# translate crowdin sitWithLilian2_ada6468d:
msgid "[_centered_] {size=37}Спустя одну серию аниме{/size}"
msgstr "[_centered_] {size=37}Un épisode de l'anime{/size}"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:49 #-#-# translate crowdin sitWithLilian2_becf8350:
msgid "[_cedrick_] Получается у школьника есть тетрадь, с помощью которой он может убить кого угодно, вписав его имя в тетрадь?"
msgstr "[_cedrick_] Un écolier dispose donc d'un carnet avec lequel il peut tuer n'importe qui en écrivant son nom dans le carnet ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:51 #-#-# translate crowdin sitWithLilian2_946db81d:
msgid "[_lilith_] Ага"
msgstr "[_lilith_] Oui, c'est vrai."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:53 #-#-# translate crowdin sitWithLilian2_69594d60:
msgid "[_cedrick_] И противостоит этому злому школьнику другой аутичный школьник-детектив"
msgstr "[_cedrick_] Et c'est un autre écolier autiste qui affronte cet écolier maléfique."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:55 #-#-# translate crowdin sitWithLilian2_8d825387:
msgid "[_lilith_] Что за предрассудки? Он просто сирота, не познавший социальных рамок и норм коммуникации"
msgstr "[_lilith_] Quel genre de préjugé est-ce là ? Ce n'est qu'un orphelin qui n'a pas appris le cadre social et les normes de communication."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:57 #-#-# translate crowdin sitWithLilian2_54b55ef3:
msgid "[_cedrick_] Понял. И злой школьник с тетрадью не знает имя школьника-детектива. А даже если узнает и запишет в тетрадь, то это его скомпрометирует"
msgstr "[_cedrick_] J'ai compris. Et l'écolier maléfique avec le cahier ne connaît pas le nom de l'écolier détective. Et même s'il le connaissait et l'écrivait dans son carnet, cela le compromettrait."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:59 #-#-# translate crowdin sitWithLilian2_6f2b5886:
msgid "[_lilith_] Именно"
msgstr "[_lilith_] Exactement"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:61 #-#-# translate crowdin sitWithLilian2_640336c9:
msgid "[_cedrick_] Хм.. Я понимаю, почему персонажи здесь такие, это расчет на целевую аудиторию. Но в целом, сюжет довольно интересный"
msgstr "[_cedrick_] Hmm. Je comprends pourquoi les personnages sont comme ça, c'est un calcul sur le public cible. Mais dans l'ensemble, l'intrigue est assez intéressante"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:62 #-#-# translate crowdin sitWithLilian2_31b6c2d4:
msgid "[_cedrick_] Постоянные интриги и игры разума, завязанные на следовании мистическим правилам и магическим принципам.. Это мне знакомо"
msgstr "[_cedrick_] Des intrigues et des jeux d'esprit constants, liés au respect de règles mystiques et de principes magiques... Cela m'est familier"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:63 #-#-# translate crowdin sitWithLilian2_255c1e16:
msgid "[_cedrick_] Эм, то есть.. Это явно находит во мне отклик, скажем так.."
msgstr "[_cedrick_] Je veux dire... Cela résonne clairement en moi, dirons-nous."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:65 #-#-# translate crowdin sitWithLilian2_1fec6fea:
msgid "[_lilith_] Кто бы мог подумать что кто-то вроде тебя заинтересуется.."
msgstr "[_lilith_] Qui aurait cru que quelqu'un comme vous serait intéressé ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:67 #-#-# translate crowdin sitWithLilian2_b51116bc:
msgid "[_cedrick_] Хах, что за предрассудки?"
msgstr "[_cedrick_] Pourquoi ces préjugés ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:69 #-#-# translate crowdin sitWithLilian2_5dfff8de:
msgid "[_lilith_] Ох, черт… Неплохо, Рик, поймал меня.. Да, я тоже порой становлюсь жертвой предрассудков"
msgstr "[_lilith_] Oh, merde.… Bien vu, Rick, tu m'as eu. Oui, il m'arrive aussi de tomber dans les préjugés."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:71 #-#-# translate crowdin sitWithLilian2_9edb4a40:
msgid "[_cedrick_] Ничего, от этого никто не застрахован. Даже гении-неформалы, считывающие музыкальные вкусы людей"
msgstr "[_cedrick_] Ce n'est pas grave, personne n'est à l'abri. Pas même les génies qui lisent les goûts musicaux des gens."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:73 #-#-# translate crowdin sitWithLilian2_e19676fd:
msgid "[_lilith_] ..."
msgstr "[_lilith_] ..."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:74 #-#-# translate crowdin sitWithLilian2_cbe14e91:
msgid "[_lilith_] ....."
msgstr "[_lilith_] ....."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:76 #-#-# translate crowdin sitWithLilian2_73a16893:
msgid "[_cedrick_] Что такое?"
msgstr "[_cedrick_] Qu'est-ce que c'est ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:78 #-#-# translate crowdin sitWithLilian2_5bf25fa3:
msgid "[_lilith_] Рик, слушай.."
msgstr "[_lilith_] Rick, écoute."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:79 #-#-# translate crowdin sitWithLilian2_7ba1288f:
msgid "[_lilith_] Я скажу это один единственный раз"
msgstr "[_lilith_] Je ne le répéterai qu'une seule fois."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:81 #-#-# translate crowdin sitWithLilian2_d66f7090:
msgid "[_cedrick_] (Вот черт, она меня снова на чем-то поймала? Сейчас будет расставлять границы?)"
msgstr "[_cedrick_] (Oh merde, elle m'a encore surpris à faire quelque chose ? Va-t-elle poser des limites maintenant ?)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:83 #-#-# translate crowdin sitWithLilian2_3c729a80:
msgid "[_lilith_] Я ненавижу говорить подобное, но.."
msgstr "[_lilith_] Je déteste dire ça, mais..."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:84 #-#-# translate crowdin sitWithLilian2_09bf78ec:
msgid "[_lilith_] Прости.."
msgstr "[_lilith_] Je suis désolée."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:86 #-#-# translate crowdin sitWithLilian2_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:88 #-#-# translate crowdin sitWithLilian2_5832333c:
msgid "[_lilith_] В прошлый раз я повела себя как последняя сука.. Ты нашел моего кота, а я тебя даже не поблагодарила"
msgstr "[_lilith_] La dernière fois, j'ai agi comme une salope. Tu as trouvé mon chat, et je ne t'ai même pas remercié."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:89 #-#-# translate crowdin sitWithLilian2_a4e3edf9:
msgid "[_lilith_] Не важно, какие там у тебя мысли и мотивы были, но ты нашел и принес то, что мне дорого.."
msgstr "[_lilith_] Quelles que soient vos pensées et vos motivations, vous avez trouvé et apporté quelque chose qui me tient à cœur."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:90 #-#-# translate crowdin sitWithLilian2_840ced69:
msgid "[_lilith_] Спасибо.."
msgstr "[_lilith_] Nous vous remercions."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:92 #-#-# translate crowdin sitWithLilian2_a2772ee2:
msgid "[_cedrick_] (Вау.. Неожиданно..)"
msgstr "[_cedrick_] (Wow. Inattendu.)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:94 #-#-# translate crowdin sitWithLilian2_21a5d7a0:
msgid "[_cedrick_] Лилит.."
msgstr "[_cedrick_] Lilith."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:96 #-#-# translate crowdin sitWithLilian2_1dd6baad:
msgid "[_lilith_] Я просто.. Черт, это всегда очень тяжело мне дается. Благодарность и все такое, понимаешь?"
msgstr "[_lilith_] J'ai juste... Merde, ça a toujours été très dur pour moi. La gratitude et tout ça, tu vois ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:97 #-#-# translate crowdin sitWithLilian2_e87e0c69:
msgid "[_lilith_] Я не.. не совсем понимаю сам концепт искренней дружелюбности и заинтересованности"
msgstr "[_lilith_] Je ne comprends pas... je ne comprends pas très bien le concept même d'amitié et d'intérêt sincères."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:98 #-#-# translate crowdin sitWithLilian2_e7d2d64d:
msgid "[_lilith_] Знаешь, эм, если говорить.."
msgstr "[_lilith_] Vous savez, hum, si je devais dire."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:99 #-#-# translate crowdin sitWithLilian2_fad13d52:
msgid "[_lilith_] Когда в классе из всех девочек у тебя первой начинает расти грудь и ты ловишь на себе бесконечные взгляды пубертатных придурков.."
msgstr "[_lilith_] Quand tu es la première fille de ta classe à avoir des seins et que les abrutis de la puberté te regardent sans cesse."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:100 #-#-# translate crowdin sitWithLilian2_43213d97:
msgid "[_lilith_] Когда каждый день тебя окружают ублюдки, раздевающие тебя взглядом, просто потому что ты обладаешь сочными формами.."
msgstr "[_lilith_] Quand on est entouré chaque jour de salauds qui vous déshabillent du regard juste parce que vous avez des formes juteuses..."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:101 #-#-# translate crowdin sitWithLilian2_9a23dc98:
msgid "[_lilith_] Это со временем формирует патологическое недоверие к мужчинам в целом"
msgstr "[_lilith_] Au fil du temps, il en résulte une méfiance pathologique à l'égard des hommes en général"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:102 #-#-# translate crowdin sitWithLilian2_55ff5f8c:
msgid "[_lilith_] Я понимаю, что сама в итоге стала жертвой предрассудков, которые осуждаю.."
msgstr "[_lilith_] Je me rends compte que j'ai moi-même fini par être victime des préjugés que je condamne."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:103 #-#-# translate crowdin sitWithLilian2_05eb6b5f:
msgid "[_lilith_] Ты здесь ни при чем.. не стану утверждать, что ты хороший парень, в конце концов я тебя толком даже не знаю"
msgstr "[_lilith_] Cela n'a rien à voir avec vous. Je ne dis pas que vous êtes un gentil garçon, après tout, je ne vous connais même pas."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:104 #-#-# translate crowdin sitWithLilian2_34209d2a:
msgid "[_lilith_] Но ты определенно не заслужил того жесткого отношения, которое я проявила к тебе в прошлый раз.."
msgstr "[_lilith_] Mais tu ne méritais certainement pas le traitement sévère que je t'ai infligé la dernière fois."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:106 #-#-# translate crowdin sitWithLilian2_9e43b4f7:
msgid "[_cedrick_] (Хм.. Кажется я начинаю понимать..)"
msgstr "[_cedrick_] (Hmm. Je crois que je commence à comprendre.)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:107 #-#-# translate crowdin sitWithLilian2_9feec7f7:
msgid "[_cedrick_] (Лилит человек с жесткими принципами и когда она ловит себя на противоречии собственным убеждениям, то начинает винить себя)"
msgstr "[_cedrick_] (Lilith est une personne aux principes rigides et lorsqu'elle se surprend à contredire ses propres croyances, elle s'en veut)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:108 #-#-# translate crowdin sitWithLilian2_b79bb467:
msgid "[_cedrick_] (С любой другой девушкой я бы просто начал давить на эту болевую точку и это сработало бы. Но не с ней, она слишком проницательна)"
msgstr "[_cedrick_] (Avec n'importe quelle autre fille, je commencerais à pousser ce point de douleur et ça marcherait. Mais pas avec elle, elle est trop perspicace)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:109 #-#-# translate crowdin sitWithLilian2_74b50a0f:
msgid "[_cedrick_] (Здесь нужна другая тактика..)"
msgstr "[_cedrick_] (Une autre tactique est nécessaire ici...)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:111 #-#-# translate crowdin sitWithLilian2_dbdf3139:
msgid "[_cedrick_] Я понимаю тебя, Лилит. Ты же скорее всего ушла учиться в колледж-интернат, потому что обычно такие учебные заведения разделяются по половому признаку"
msgstr "[_cedrick_] Je te comprends, Lilith. Tu as probablement fréquenté un internat parce qu'il y a généralement une ségrégation entre les sexes."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:112 #-#-# translate crowdin sitWithLilian2_6ea3412e:
msgid "[_cedrick_] Учиться с такими же девушками и не ловить на себе взгляды парней куда комфортнее и безопаснее. Но также это приводит к изоляции"
msgstr "[_cedrick_] Étudier avec les mêmes filles et ne pas attirer les regards des garçons est beaucoup plus confortable et sûr. Mais cela conduit aussi à l'isolement"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:113 #-#-# translate crowdin sitWithLilian2_98f07ef6:
msgid "[_cedrick_] Изоляции взглядов и мнений, ты начинаешь вариться в одном конкретном взгляде на мир. Например, что все мужики козлы"
msgstr "[_cedrick_] L'isolement des points de vue et des opinions, vous commencez à vous complaire dans une vision particulière du monde. Comme si tous les hommes étaient des trous du cul."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:115 #-#-# translate crowdin sitWithLilian2_19a87660:
msgid "[_lilith_] По правде говоря, боюсь, что так оно и есть.."
msgstr "[_lilith_] À vrai dire, je crains que ce ne soit le cas."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:117 #-#-# translate crowdin sitWithLilian2_5615e038:
msgid "[_lilith_] А то, что сестра так падка на мужское внимание и готова каждому второму на шею вешаться в итоге меня еще больше отталкивает от мужчин в целом"
msgstr "[_lilith_] Et le fait que ma sœur soit si avide d'attention masculine et prête à se jeter au cou de n'importe quel autre homme me pousse à m'éloigner encore plus des hommes en général"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:119 #-#-# translate crowdin sitWithLilian2_3bf1bf5d:
msgid "[_cedrick_] Хочешь поговорить об этом?"
msgstr "[_cedrick_] Voulez-vous en parler ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:121 #-#-# translate crowdin sitWithLilian2_e19676fd_1:
msgid "[_lilith_] ..."
msgstr "[_lilith_] ..."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:123 #-#-# translate crowdin sitWithLilian2_40c25a9a:
msgid "[_lilith_] В любой другой ситуации я бы сказала нет.. Не знаю, может это последствие температуры и у меня уже мозги плавятся, но…"
msgstr "[_lilith_] Dans n'importe quelle autre situation, je dirais non. Je ne sais pas, peut-être que c'est la fièvre et que mon cerveau est en train de fondre, mais…."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:124 #-#-# translate crowdin sitWithLilian2_5994236f:
msgid "[_lilith_] Сейчас я готова обсудить это с тобой.."
msgstr "[_lilith_] Je suis maintenant prêt à en discuter avec vous."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:125 #-#-# translate crowdin sitWithLilian2_ce59d414:
msgid "[_cedrick_] (Отлично, это мой шанс)"
msgstr "[_cedrick_] (Super, c'est ma chance)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:128 #-#-# translate crowdin sitWithLilian2_fe0192ff:
msgid "[_centered_] {size=37}СПУСТЯ НЕСКОЛЬКО ДОЛГИХ ОТКРОВЕННЫХ РАЗГОВОРОВ{/size}"
msgstr "[_centered_] {size=37}Sans quelques longues discussions{/size}."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:135 #-#-# translate crowdin sitWithLilian2_6eccb8b3:
msgid "[_lilith_] Знаешь, основная проблема Корнелии в том, что она все еще видит во мне ребенка"
msgstr "[_lilith_] Vous savez, le principal problème de Cornelia est qu'elle me considère toujours comme un enfant."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:136 #-#-# translate crowdin sitWithLilian2_4836b7bd:
msgid "[_lilith_] Да, это довольно избитая фраза, но.. Черт, я уже давно не клоп, как она любила меня называть. Не та светлая маленькая девочка"
msgstr "[_lilith_] Ouais, c'est une phrase assez éculée, mais... Bon sang, je ne suis pas la punaise qu'elle aimait m'appeler. Pas cette petite fille brillante"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:137 #-#-# translate crowdin sitWithLilian2_494fa560:
msgid "[_lilith_] Я меняюсь, меняются мои интересы, меняются мои взгляды.. Все меняется, я же человек"
msgstr "[_lilith_] Je change, mes intérêts changent, mes opinions changent. Les choses changent, je suis humain."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:138 #-#-# translate crowdin sitWithLilian2_38e7f49a:
msgid "[_lilith_] Ожидать, что я навсегда останусь ребенком, который любит мягкие игрушки и мультики про пони.. Это.. даже не знаю.."
msgstr "[_lilith_] S'attendre à ce que je sois un enfant qui aime les animaux en peluche et les dessins animés sur les poneys pour toujours. C'est... je ne sais pas."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:139 #-#-# translate crowdin sitWithLilian2_d4f7b126:
msgid "[_lilith_] Это как-то нездорово.."
msgstr "[_lilith_] C'est un peu malsain."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:140 #-#-# translate crowdin sitWithLilian2_078f8314:
msgid "[_lilith_] Черт, если бы она просто поинтересовалась тем, что мне стало интересно сейчас, а не цеплялась за прошлую меня и те мои интересы, что уже давно ушли.."
msgstr "[_lilith_] Si seulement elle s'était renseignée sur ce qui m'intéresse aujourd'hui, au lieu de s'accrocher au passé et à mes centres d'intérêt depuis longtemps disparus...."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:141 #-#-# translate crowdin sitWithLilian2_bbd15d0d:
msgid "[_lilith_] Ей как будто просто не хочется узнать новые стороны моей личности.."
msgstr "[_lilith_] C'est comme si elle ne voulait pas découvrir de nouvelles facettes de ma personnalité."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:142 #-#-# translate crowdin sitWithLilian2_6b6cb508:
msgid "[_lilith_] Думаешь мы хоть когда-нибудь смотрели с ней вот так аниме? Пф, да никогда.."
msgstr "[_lilith_] Tu crois qu'on a déjà regardé un anime avec elle comme ça ? Pfft, jamais."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:143 #-#-# translate crowdin sitWithLilian2_6fb9c269:
msgid "[_lilith_] И она никогда не хотела послушать мою музыку.."
msgstr "[_lilith_] Et elle n'a jamais voulu entendre ma musique."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:144 #-#-# translate crowdin sitWithLilian2_5bf89daf:
msgid "[_lilith_] Черт, даже ты был в ней заинтересован, а мы с тобой знакомы пару дней.."
msgstr "[_lilith_] Même toi, tu t'intéressais à elle, et tu me connais depuis quelques jours."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:146 #-#-# translate crowdin sitWithLilian2_e5582729:
msgid "[_cedrick_] Мда, это все печально.. Но это же классические проблемы недопонимания. Ты пробовала обсудить с ней это?"
msgstr "[_cedrick_] Oui, c'est triste. Mais il s'agit là de problèmes classiques d'incompréhension. Avez-vous essayé de lui en parler ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:148 #-#-# translate crowdin sitWithLilian2_43d31c85:
msgid "[_lilith_] Пф, конечно нет.. Думаешь она стала бы слушать?"
msgstr "[_lilith_] Pfft, bien sûr que non. Tu crois qu'elle écouterait ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:150 #-#-# translate crowdin sitWithLilian2_f24efae4:
msgid "[_cedrick_] Я бы как минимум попробовал. К тому же ей определенно на тебя не плевать"
msgstr "[_cedrick_] Je lui donnerais au moins une chance. De plus, elle se soucie vraiment de toi."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:152 #-#-# translate crowdin sitWithLilian2_344e3e0d:
msgid "[_lilith_] С чего ты взял?"
msgstr "[_lilith_] Qu'est-ce qui vous fait dire cela ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:154 #-#-# translate crowdin sitWithLilian2_2d554c24:
msgid "[_cedrick_] Хм.. Как минимум она несколько раз просила меня присмотреть за тобой, потому что она не хочет оставлять тебя одну"
msgstr "[_cedrick_] Hmm. Au moins, elle m'a demandé de te surveiller plusieurs fois parce qu'elle ne voulait pas te laisser seule."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:156 #-#-# translate crowdin sitWithLilian2_e19676fd_2:
msgid "[_lilith_] ..."
msgstr "[_lilith_] ..."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:158 #-#-# translate crowdin sitWithLilian2_047a9bab:
msgid "[_lilith_] Черт, из-за болезни я стала слишком эмоциональна…"
msgstr "[_lilith_] Bon sang, la maladie m'a rendu trop émotif…"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:159 #-#-# translate crowdin sitWithLilian2_613b4a5d:
msgid "[_lilith_] Давай сменим тему, а то я так могу и расплакаться.. Но, да, думаю ты прав.."
msgstr "[_lilith_] Changeons de sujet, ou je pourrais pleurer. Mais, oui, je crois que tu as raison."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:161 #-#-# translate crowdin sitWithLilian2_1901f8a6:
msgid "[_cedrick_] Окей.. эм.."
msgstr "[_cedrick_] D'accord, hum."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:162 #-#-# translate crowdin sitWithLilian2_d0a2f625:
msgid "[_cedrick_] Ты правда перевелась в интернат потому что тебе надоели похотливые взгляды одноклассников?"
msgstr "[_cedrick_] As-tu vraiment été transférée dans un internat parce que tu en avais marre des regards lubriques de tes camarades de classe ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:164 #-#-# translate crowdin sitWithLilian2_995a213b:
msgid "[_lilith_] Хах, отчасти. Если бы меня это настолько доставало, то я бы просто одевалась бы скромнее"
msgstr "[_lilith_] En quelque sorte. Si cela me dérangeait à ce point, je m'habillerais plus modestement."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:165 #-#-# translate crowdin sitWithLilian2_227f47ce:
msgid "[_lilith_] Надела бы специальный корсет, чтобы сиськи не так вызывающе торчали и так далее"
msgstr "[_lilith_] Elle porterait un corset spécial pour que ses seins ne ressortent pas trop, etc."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:166 #-#-# translate crowdin sitWithLilian2_cfd33b2f:
msgid "[_lilith_] Но знаешь, мне нравится мое тело и я считаю что никто не может мне диктовать то, как я должна выглядеть"
msgstr "[_lilith_] Mais, vous savez, j'aime mon corps et je ne pense pas que quelqu'un puisse me dicter à quoi je dois ressembler."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:167 #-#-# translate crowdin sitWithLilian2_40c2f641:
msgid "[_lilith_] Только я это решаю и если я хочу выглядеть не только брутально и готично, но и сексуально, то, черт, я это сделаю и никто меня не остановит"
msgstr "[_lilith_] Je suis la seule à décider de cela et si je veux avoir l'air non seulement brutal et gothique mais aussi sexy, alors je le ferai et personne ne pourra m'en empêcher."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:169 #-#-# translate crowdin sitWithLilian2_a847aa91:
msgid "[_cedrick_] Хах, это в духе твоей принципиальности"
msgstr "[_cedrick_] Huh, c'est dans l'esprit de votre intégrité."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:171 #-#-# translate crowdin sitWithLilian2_a9d0d6de:
msgid "[_lilith_] Ох, говоришь так, словно знаешь меня, но не обольщайся"
msgstr "[_lilith_] Oh, vous parlez comme si vous me connaissiez, mais ne vous laissez pas abuser."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:172 #-#-# translate crowdin sitWithLilian2_972675fb:
msgid "[_lilith_] Я просто достаточно невменяемая сейчас из-за температуры, чтобы откровенничать тут с тобой и поднимать всякие щепетильные темы"
msgstr "[_lilith_] Je suis juste assez fou en ce moment avec la fièvre pour vous parler et aborder des sujets sensibles."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:174 #-#-# translate crowdin sitWithLilian2_08eda71f:
msgid "[_cedrick_] Да уж, тут с тобой не поспоришь"
msgstr "[_cedrick_] Oui, je ne peux pas vous contredire sur ce point."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:176 #-#-# translate crowdin sitWithLilian2_b3d7441d:
msgid "[_lilith_] К вопросу о щепетильных темах. Черт, Рик, ты хоть представляешь, насколько сложно жить с такой большой грудью?"
msgstr "[_lilith_] En parlant de sujets sensibles. Bon sang, Rick, as-tu la moindre idée de la difficulté de vivre avec des seins aussi gros ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:178 #-#-# translate crowdin sitWithLilian2_47ffec59:
msgid "[_cedrick_] (Она сейчас что, начинает со мной разговаривать как со своей подружкой?)"
msgstr "[_cedrick_] (Est-ce qu'elle commence à me parler comme si j'étais sa petite amie ?)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:179 #-#-# translate crowdin sitWithLilian2_3e823ac6:
msgid "[_cedrick_] Даже не представляю.."
msgstr "[_cedrick_] Je n'en ai aucune idée."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:181 #-#-# translate crowdin sitWithLilian2_34eefc6b:
msgid "[_lilith_] Вот именно, не представляешь.. Они ж блин подпрыгивают как баскетбольные мячи, стоит мне хоть немного прибавить шаг.."
msgstr "[_lilith_] Exactement, vous n'avez pas idée. Ils rebondissent comme des ballons de basket dès que j'accélère un peu."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:183 #-#-# translate crowdin sitWithLilian2_6e55a28f:
msgid "[_cedrick_] Хм.. Ты правда хочешь, чтобы я сейчас начал обсуждать с тобой твою грудь?"
msgstr "[_cedrick_] Hmm. Tu veux vraiment que je commence à parler de tes seins maintenant ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:184 #-#-# translate crowdin sitWithLilian2_d30b69dd:
msgid "[_cedrick_] Думаю ты и так прекрасно знаешь, что я мог бы сказать на эту тему"
msgstr "[_cedrick_] Je pense que vous savez déjà très bien ce que je pourrais dire à ce sujet."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:186 #-#-# translate crowdin sitWithLilian2_1aa0b5c7:
msgid "[_lilith_] Да, само собой, и не только сказать"
msgstr "[_lilith_] Oui, bien sûr, et pas seulement pour dire"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:187 #-#-# translate crowdin sitWithLilian2_bd15fbac:
msgid "[_lilith_] Думаю ты бы ее облапал, позволь я тебе и будь мы в достаточно близких отношениях. Даже девушки хотят ее облапать, что уж там говорить"
msgstr "[_lilith_] Je pense que tu la toucherais si je te laissais faire et si nous étions assez proches. Même les filles veulent la tripoter, n'en parlons même pas."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:189 #-#-# translate crowdin sitWithLilian2_0ee4e372:
msgid "[_cedrick_] Хах, я не удивлен.. Значит, побег в интернат не сильно помог"
msgstr "[_cedrick_] Je ne suis pas surpris. S'enfuir dans un pensionnat n'a donc pas beaucoup aidé."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:191 #-#-# translate crowdin sitWithLilian2_ce3d76ab:
msgid "[_lilith_] Типо того"
msgstr "[_lilith_] En quelque sorte."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:192 #-#-# translate crowdin sitWithLilian2_e19676fd_3:
msgid "[_lilith_] ..."
msgstr "[_lilith_] ..."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:193 #-#-# translate crowdin sitWithLilian2_21c62688:
msgid "[_lilith_] Честно говоря, туда меня отправили родители за плохое поведение.. Если можно так выразиться.."
msgstr "[_lilith_] Pour être honnête, mes parents m'y ont envoyé pour mauvaise conduite. Si je puis dire."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:195 #-#-# translate crowdin sitWithLilian2_b5abd8b4:
msgid "[_cedrick_] Вау.. Жестко.. За что они тебя так?"
msgstr "[_cedrick_] Ouah ! C'est très dur. Pourquoi vous font-ils ça ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:197 #-#-# translate crowdin sitWithLilian2_88f3def0:
msgid "[_lilith_] Хах, вот об этом я с тобой пока не готова говорить"
msgstr "[_lilith_] Huh, c'est quelque chose dont je ne suis pas encore prêt à vous parler."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:199 #-#-# translate crowdin sitWithLilian2_ec94b092:
msgid "[_cedrick_] Понял. И давно у тебя такие, кхм, проблемы с родителями и Корнелией?"
msgstr "[_cedrick_] J'ai compris. Depuis combien de temps avez-vous des problèmes avec vos parents et Cornelia ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:201 #-#-# translate crowdin sitWithLilian2_8f0c6642:
msgid "[_lilith_] Ну знаешь, как это бывает. Сначала хардкорная музыка, потом первая серьга, потом более вызывающая одежда. Классика.."
msgstr "[_lilith_] Vous savez ce que c'est. D'abord la musique hardcore, puis la première boucle d'oreille, puis des vêtements plus provocants. Les classiques."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:202 #-#-# translate crowdin sitWithLilian2_9d0ae59d:
msgid "[_lilith_] Думаю пирсинг и одежда стали переломным моментом, после которого мы с семьей начали отдаляться"
msgstr "[_lilith_] Je pense que les piercings et les vêtements ont été le point de bascule après lequel ma famille et moi avons commencé à nous éloigner l'un de l'autre"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:204 #-#-# translate crowdin sitWithLilian2_d02673ca:
msgid "[_cedrick_] (Хм.. Пирсинг и одежда.. Возможно она когда-то давно случайно надела на себя какой-то волшебный артефакт и он постепенно начал менять ее личность)"
msgstr "[_cedrick_] (Hmm. Des piercings et des vêtements. Peut-être qu'elle a accidentellement mis une sorte d'artefact magique sur elle-même il y a longtemps et que cela a commencé à changer sa personnalité)"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:205 #-#-# translate crowdin sitWithLilian2_29ef0316:
msgid "[_cedrick_] (Поэтому появились такие резкие перемены в характере и оттого она настолько проницательная)"
msgstr "[_cedrick_] (C'est la raison pour laquelle son caractère a changé de façon si radicale et qu'elle est si perspicace)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:206 #-#-# translate crowdin sitWithLilian2_abfcaa28:
msgid "[_cedrick_] (Черт, она буквально сказала 'лорд' описывая меня, это явно не просто совпадение..)"
msgstr "[_cedrick_] (Elle a littéralement dit \"seigneur\" en me décrivant, ce n'est manifestement pas une coïncidence...)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:207 #-#-# translate crowdin sitWithLilian2_70ee997d:
msgid "[_cedrick_] (Да и то, что она не хочет, чтобы ее называли старым именем, выглядит довольно странно)"
msgstr "[_cedrick_] (Oh, et le fait qu'elle ne veuille pas être appelée par son ancien nom semble plutôt étrange)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:208 #-#-# translate crowdin sitWithLilian2_50f80769:
msgid "[_cedrick_] (На сколько я помню из книг, прочитанных в магазинчике, Лилит - это демоница в еврейской мифологии и первая жена Адама..)"
msgstr "[_cedrick_] (Pour autant que je me souvienne des livres que j'ai lus dans le magasin, Lilith est une démone de la mythologie juive et la première femme d'Adam...)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:209 #-#-# translate crowdin sitWithLilian2_be728881:
msgid "[_cedrick_] (Я должен разобраться, вдруг она носит этот артефакт на себе прямо сейчас)"
msgstr "[_cedrick_] (Il faut que je vérifie, au cas où elle porterait cet artefact sur elle en ce moment même)."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:211 #-#-# translate crowdin sitWithLilian2_ae558ce1:
msgid "[_lilith_] Ох, знаешь.. Все эти откровенные разговоры - это, конечно, хорошо, но подобные эмоциональные качели меня еще больше вымотали.. А я и так без сил.."
msgstr "[_lilith_] Oh, tu sais. Je veux dire, c'est bien de parler ouvertement, mais tout ce balancement émotionnel m'épuise. Et je suis déjà épuisée."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:213 #-#-# translate crowdin sitWithLilian2_48d74e81:
msgid "[_cedrick_] Ты это к чему?"
msgstr "[_cedrick_] Où voulez-vous en venir ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:215 #-#-# translate crowdin sitWithLilian2_104433fe:
msgid "[_lilith_] К тому, что меня начинает вырубать.. В общем, если хочешь, можешь побыть тут и дождаться Корнелию, но я в любом случае ложусь спать"
msgstr "[_lilith_] Je commence à m'évanouir. De toute façon, tu peux rester ici et attendre Cornelia si tu veux, mais je vais me coucher de toute façon."

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:217 #-#-# translate crowdin sitWithLilian2_7dac0ed4:
msgid "[_cedrick_] Эм.. проводить тебя до кровати?"
msgstr "[_cedrick_] Um, t'accompagner au lit ?"

# game/scripts/quests/growingUpLilian/sitWithLilian2.rpy:219 #-#-# translate crowdin sitWithLilian2_d5bf6abe:
msgid "[_lilith_] Еще чего.. Знаю я до чего это все доводит, хаха…"
