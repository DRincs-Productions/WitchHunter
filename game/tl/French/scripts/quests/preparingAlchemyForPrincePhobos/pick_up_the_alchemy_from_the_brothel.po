# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:460 #-#-# translate crowdin gallery_d_038_ecaad052:
msgid "[_miranda_] И это все влияние одной единственной железы Королевы морпионов.. "
