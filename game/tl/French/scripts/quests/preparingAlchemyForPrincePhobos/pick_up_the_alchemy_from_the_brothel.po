msgstr "[_cedrick_] (Nous devrions aller la voir)"

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:450 #-#-# translate crowdin gallery_d_037_3d518c3f:
msgid "[_centered_] {size=37} СПУСТЯ НЕКОТОРОЕ ВРЕМЯ ПЕРЕСКАЗА ПРОИЗОШЕДШЕГО {/size}"
msgstr "[_centered_] {size=37} APRÈS AVOIR RACONTÉ CE QUI S'EST PASSÉ {/size}"

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:455 #-#-# translate crowdin gallery_d_038_a13ba10a:
msgid "[_miranda_] Да, именно это и происходит, когда человек выпивает эссенцию.."
msgstr "[_miranda_] Oui, c'est exactement ce qui se passe lorsqu'on boit l'essence..."

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:456 #-#-# translate crowdin gallery_d_038_e6c8f2d7:
msgid "[_miranda_] Человек полностью подчиняется другой воле и не может даже кончить без приказа"
