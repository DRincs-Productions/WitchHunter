# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:246 #-#-# translate crowdin gallery_d_036_d478271c:
msgid "[_miranda_] У нас во всем замке только одна девушка-оборотень, Седрик! Поэтому я так напряглась, когда узнала, что Фобос поручил это мне.."
