# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:229 #-#-# translate crowdin gallery_d_036_ed36efa5:
msgid "[_cedrick_] Не уверен, что хочу знать, но, какой же? И почему его так много?"
