# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:519 #-#-# translate crowdin gallery_d_038_d2d28a2d:
msgid "[_miranda_] Да.. Дааа, спусти все в меня"
