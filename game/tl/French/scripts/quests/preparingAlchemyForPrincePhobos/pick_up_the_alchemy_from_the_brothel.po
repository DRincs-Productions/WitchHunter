# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:542 #-#-# translate crowdin gallery_d_038_3a53e5dc:
msgid "[_medina_] Четверо пропали без вести и все крутится вокруг одного человека и одного книжного магазина!"
