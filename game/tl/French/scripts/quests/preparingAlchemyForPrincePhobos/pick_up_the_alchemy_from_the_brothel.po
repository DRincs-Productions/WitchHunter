# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:440 #-#-# translate crowdin gallery_d_037_abae1399:
msgid "[_phobos_] Ты можешь идти. Дальше я сам разберусь"
msgstr "[_phobos_] Tu peux y aller. Je m'en occupe à partir d'ici."

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:441 #-#-# translate crowdin gallery_d_037_24255120:
