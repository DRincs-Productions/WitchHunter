# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:499 #-#-# translate crowdin gallery_d_038_34808934:
msgid "[_miranda_] Ну наконец-то, Седрик"
msgstr "[_miranda_] Enfin, Cédric."

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:501 #-#-# translate crowdin gallery_d_038_8861d3ac:
msgid "[_centered_] {size=37} СПУСТЯ НЕКОТОРОЕ ВРЕМЯ {/size}"
msgstr "[_centered_] {size=37} LAST TIME {/size}"

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:505 #-#-# translate crowdin gallery_d_038_67d2ba6e:
msgid "[_miranda_] Дааа.. Ооооо да, наконец-то! Наконец, ты трахаешь меня как дикий зверь!"
msgstr "[_miranda_] Oui... Ohhhh oui, enfin ! enfin, tu me baises comme un animal sauvage !"

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:507 #-#-# translate crowdin gallery_d_038_a661d270:
msgid "[_miranda_] Совсем как раньше.. Совершенно безжалостно долбишь мою киску, как же долго я этого ждала"
