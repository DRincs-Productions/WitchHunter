# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:517 #-#-# translate crowdin gallery_d_038_04b55f29:
msgid "[_cedrick_] Миранда, я близко, приготовься"
