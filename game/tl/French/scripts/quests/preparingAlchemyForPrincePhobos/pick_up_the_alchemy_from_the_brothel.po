msgstr "[_alchemy_] (Je ne peux pas... Frère, pardonnez-moi... Je...)"

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:422 #-#-# translate crowdin gallery_d_037_2cf47d56:
msgid "[_alchemy_] Я очень сильно хочу кончить! Мой князь, мой господин, прошу вас, позвольте! Это все, о чем я прошу. Я сделаю все..."
msgstr "[_alchemy_] J'ai très envie de jouir ! Mon prince, mon seigneur, laissez-moi faire ! C'est tout ce que je demande. Je ferai n'importe quoi..."

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:425 #-#-# translate crowdin gallery_d_037_33462652:
msgid "[_phobos_] Если таковы твои искренние желания, то так уж и быть, я тебе позволяю. Кончи для меня, Алхими"
msgstr "[_phobos_] Si c'est ce que tu souhaites sincèrement, je te laisse faire. Joue pour moi, Alchemy"

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:429 #-#-# translate crowdin gallery_d_037_238a10b5:
msgid "[_alchemy_] Спасибо... Ааааааххх, спасибо, мой господин"
msgstr "[_alchemy_] Merci... Aaahhhh, merci, mon seigneur."

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:431 #-#-# translate crowdin gallery_d_037_2ff9a2aa:
msgid "[_alchemy_] (Прости, брат.. Я не смогла.. Это.. Все это слишком хорошо, чтобы отказаться от этого..)"
msgstr "[_alchemy_] (Je suis désolé, mon frère... Je n'ai pas pu... C'est... C'est trop beau pour le laisser passer...)"

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:432 #-#-# translate crowdin gallery_d_037_83f2ef5d:
msgid "[_alchemy_] (Видимо теперь.. мое тело.. и мой разум.. и вправду принадлежат ему..)"
msgstr "[_alchemy_] (Apparemment maintenant... mon corps... et mon esprit... lui appartiennent vraiment...)"

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:436 #-#-# translate crowdin gallery_d_037_d443b7b3:
msgid "[_phobos_] Ну-ну, не набрасывайся так на него, ты еще не побывала на источниках, чтобы ко мне прикасаться"
msgstr "[_phobos_] Ne sois pas si dur avec lui, tu n'es pas encore allé aux sources pour me toucher."

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:437 #-#-# translate crowdin gallery_d_037_c8b36df4:
msgid "[_alchemy_] Прошу князь.. Молю, дайте мне его"
msgstr "[_alchemy_] S'il vous plaît, Prince... Je vous en supplie, donnez-la-moi."

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:438 #-#-# translate crowdin gallery_d_037_d9128789:
msgid "[_phobos_] Седрик?"
msgstr "[_phobos_] Cedric ?"

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:439 #-#-# translate crowdin gallery_d_037_50eca9b4:
