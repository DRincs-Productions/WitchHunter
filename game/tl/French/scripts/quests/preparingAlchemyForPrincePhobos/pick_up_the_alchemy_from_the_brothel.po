# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:521 #-#-# translate crowdin gallery_d_038_f88685ee:
msgid "[_cedrick_] Я кончаю!"
