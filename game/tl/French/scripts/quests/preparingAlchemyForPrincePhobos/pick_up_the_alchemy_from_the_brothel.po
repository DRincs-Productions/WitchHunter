# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:445 #-#-# translate crowdin gallery_d_037_5dfe53ba:
msgid "[_cedrick_] (......)"
msgstr "[_cedrick_] (......)"

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:446 #-#-# translate crowdin gallery_d_037_6f98d0da:
msgid "[_cedrick_] (Так вот как работает эта эссенция. Начинаю понимать, о чем Миранда так беспокоилась)"
msgstr "[_cedrick_] (C'est ainsi que fonctionne cette essence. Je commence à comprendre pourquoi Miranda était si inquiète)."

# game/scripts/quests/preparingAlchemyForPrincePhobos/pick_up_the_alchemy_from_the_brothel.rpy:447 #-#-# translate crowdin gallery_d_037_a3bc3cb1:
