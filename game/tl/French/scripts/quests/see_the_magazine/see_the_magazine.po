# game/scripts/quests/see_the_magazine/see_the_magazine.rpy:224 #-#-# translate crowdin journal_sletty_sluts2_c915af27:
msgid "[_cedrick_] Интересно, рыжую девушку в центре принуждают к тому, что она делает?"
msgstr "[_cedrick_] Je me demande si la jeune fille aux cheveux rouges au centre est forcée de faire ce qu'elle fait ?"

