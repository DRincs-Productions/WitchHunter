# game/scripts/quests/see_the_magazine/see_the_magazine.rpy:214 #-#-# translate crowdin journal_sletty_sluts2_3ed058ca:
msgid "[_cedrick_] Интересно, что происходит в ее голове. Определенно какие-нибудь жесткие непотребства"
msgstr "[_cedrick_] Je me demande ce qui se passe dans sa tête. Il s'agit sans aucun doute d'une mauvaise conduite caractérisée"

# game/scripts/quests/see_the_magazine/see_the_magazine.rpy:215 #-#-# translate crowdin journal_sletty_sluts2_cf00ef3a:
