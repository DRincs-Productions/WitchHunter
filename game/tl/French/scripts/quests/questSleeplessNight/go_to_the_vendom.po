# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:6 #-#-# translate crowdin go_to_the_vendom_03fea05e:
msgid "[_centered_] {size=37}Седрик тихо вошел в дом, зашел в комнату Сьюзан и тут же грохнулся спать на кровать{/size}"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:7 #-#-# translate crowdin go_to_the_vendom_b1e2054b:
msgid "[_centered_] {size=37}Следующим утром{/size}"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:12 #-#-# translate crowdin gallery_d_100_2ef90216:
msgid "[_cedrick_] (...)"
msgstr "[_cedrick_] (...)"

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:14 #-#-# translate crowdin gallery_d_100_13a4e0ca:
msgid "[_cedrick_] (Черт, я что, так быстро отрубился!?)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:16 #-#-# translate crowdin gallery_d_100_e1b5b696:
msgid "[_cedrick_] (Видимо мне и вправду нужен отдых. Хорошо что хоть не превращаюсь неконтролируемо в змея...)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:18 #-#-# translate crowdin gallery_d_100_415790db:
msgid "[_cedrick_] (И все же так странно просыпаться не в книжном магазине. Удивлен, что привык к нему)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:19 #-#-# translate crowdin gallery_d_100_eae8308b:
msgid "[_cedrick_] (Хотя, к этому месту я тоже уже начинаю привыкать. Все это одновременно закономерно и странно)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:20 #-#-# translate crowdin gallery_d_100_2934885c:
msgid "[_cedrick_] (Я прожил столько лет на Меридиане, по сравнению с тем временем жизнь здесь - лишь мгновение)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:21 #-#-# translate crowdin gallery_d_100_4ddd3b1a:
msgid "[_cedrick_] (Но при этом... Это настолько иная жизнь, насыщенная совершенно иными событиями и эмоциями...)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:23 #-#-# translate crowdin gallery_d_100_4b86e175:
msgid "[_cedrick_] (Книжный магазин стал моим личным штабом, мозговым центром, в котором я придумывал все свои, кхм, злодеяния...)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:24 #-#-# translate crowdin gallery_d_100_2e86b0fd:
msgid "[_cedrick_] (Забавно, там были придуманы самые удачные планы за последнее время и при этом одни из самых неудачных за всю мою жизнь...)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:26 #-#-# translate crowdin gallery_d_100_0e7dedc3:
msgid "[_cedrick_] (Да, начало не было гладким, но сейчас все идет относительно спокойно... Я смог встать на новый для себя путь и пока держусь хорошо)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:27 #-#-# translate crowdin gallery_d_100_8487ad44:
msgid "[_cedrick_] (Что же касается этого места... Черт, изначально это же просто место, где я трахал одну из своих главных целей и ее сочную мать в придачу...)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:29 #-#-# translate crowdin gallery_d_100_249e2ad8:
msgid "[_cedrick_] (Но стоило начать немного привыкать к этому месту... И оно стало для меня комфортнее дома на Меридиане...)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:30 #-#-# translate crowdin gallery_d_100_8d1a2eaa:
msgid "[_cedrick_] (Как так вышло... Эта абсолютно чуждая мне спокойная и размеренная жизнь... Становится все более и более привлекательной...)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:32 #-#-# translate crowdin gallery_d_100_e7b765fd:
msgid "[_cedrick_] (Неужели..)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:34 #-#-# translate crowdin gallery_d_100_aa49cf57:
msgid "[_cedrick_] (Неужели я становлюсь все более человечным с этой семейкой?)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:35 #-#-# translate crowdin gallery_d_100_49316299:
msgid "[_cedrick_] ..."
msgstr "[_cedrick_] ..."

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:37 #-#-# translate crowdin gallery_d_100_f89f7db9:
msgid "[_cedrick_] ....."
msgstr "[_cedrick_] ....."

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:39 #-#-# translate crowdin gallery_d_100_c4baae06:
msgid "[_cedrick_] (Может кто-то распыляет здесь специальные феромоны, которые делают меня мягким овощем?)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:41 #-#-# translate crowdin gallery_d_100_3f029a0a:
msgid "[_cedrick_] (Что вообще со мной происходит..)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:43 #-#-# translate crowdin gallery_d_100_4acc2003:
msgid "[_cedrick_] (Хах, ладно тебе, Седрик, не будь параноиком..)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:44 #-#-# translate crowdin gallery_d_100_bf417d80:
msgid "[_cedrick_] (Возможно все дело в частом общении с обычными людьми Шеффилда)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:45 #-#-# translate crowdin gallery_d_100_ac30816d:
msgid "[_cedrick_] (Даже при том, что я постоянно их использую и шантажирую, если они чувствуют себя в комфорте, то эти эмоции распространяются от них как радиация)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:46 #-#-# translate crowdin gallery_d_100_b4f4e6fd:
msgid "[_cedrick_] (Видимо меня просто тоже немного облучило их спокойствием...)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:48 #-#-# translate crowdin gallery_d_100_35d197d0:
msgid "[_cedrick_] (Так или иначе... Подобные ощущения в достижении моей цели не помогут. Я не должен терять хватку, работы еще много)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:50 #-#-# translate crowdin gallery_d_100_a4df19b1:
msgid "[_cedrick_] (Но, черт... Кровать Сьюзан такая мягкая, что после тяжелого дня с нее и вправду не хочется вставать...)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:53 #-#-# translate crowdin gallery_d_100_d532cb90:
msgid "[_susan_] Хей, Рик, ты уже проснулся?"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:55 #-#-# translate crowdin gallery_d_100_c4faa469:
msgid "[_cedrick_] М? Сьюзан? Что такое?"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:57 #-#-# translate crowdin gallery_d_100_b5f675a8:
msgid "[_cedrick_] (Что это за шум? Вода?)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:59 #-#-# translate crowdin gallery_d_100_d673b2c2:
msgid "[_cedrick_] (Ох, кажется я понял)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:60 #-#-# translate crowdin gallery_d_100_7047a852:
msgid "[_susan_] Я в душе, не поможешь мне? Одной порой тааак сложно со всем справиться"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:62 #-#-# translate crowdin gallery_d_100_b877e6a1:
msgid "[_cedrick_] (Бинго, я так и думал...)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:63 #-#-# translate crowdin gallery_d_100_fe19b7d3:
msgid "[_cedrick_] (Черт, если вставать с постели, то ради этого)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:66 #-#-# translate crowdin gallery_d_100_ddb89391:
msgid "[_centered_] {size=37}Седрик стремительно направляется в душ{/size}"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:71 #-#-# translate crowdin gallery_d_100_684270ef:
msgid "[_susan_] Ох, Рик, быстро же ты прибежал на мой зов. Это так мило"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:73 #-#-# translate crowdin gallery_d_100_afc6586c:
msgid "[_cedrick_] Конечно, как можно не помочь такой прекрасной женщине. Особенно, когда тут такая пикантная ситуация"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:74 #-#-# translate crowdin gallery_d_100_54a571f0:
msgid "[_cedrick_] Кхм, Сьюзан. Мне кажется или ты используешь душевую насадку немного.. немного неправильно.."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:76 #-#-# translate crowdin gallery_d_100_36a1af46:
msgid "[_susan_] Ммм, знаешь, изначально я хотела пойти принять душ, пока ты не проснулся. Привести себя в порядок и разбудить тебя отменным минетом"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:79 #-#-# translate crowdin gallery_d_100_e0e3eff7:
msgid "[_cedrick_] Огооо..."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:82 #-#-# translate crowdin gallery_d_100_ad27f214:
msgid "[_susan_] Но, пока я тут мылась, натирая все свои прелести и думая о том, как приду и буду сосать твой член, я все сильнее начала возбуждаться"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:84 #-#-# translate crowdin gallery_d_100_fa02a488:
msgid "[_cedrick_] Ммм, вот значит как. Получается душевая лейка - это..."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:86 #-#-# translate crowdin gallery_d_100_c041f50e:
msgid "[_susan_] Это твой член, да. Я зажала его между грудей представляя, что это твой член"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:88 #-#-# translate crowdin gallery_d_100_41538bb9:
msgid "[_susan_] И не могу сказать, что мне стыдно"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:90 #-#-# translate crowdin gallery_d_100_48dd3a13:
msgid "[_cedrick_] Ахахах, еще бы. Ты же на деле та еще бесстыдница, Сьюзан"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:92 #-#-# translate crowdin gallery_d_100_9cb5a32c:
msgid "[_susan_] Ну, знаешь ли.. Когда у тебя долгое время не было нормального мужчины и все о чем ты могла думать это, кхм..."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:94 #-#-# translate crowdin gallery_d_100_d3792882:
msgid "[_susan_] Карьерный рост в it-компании, воспитание непослушной дочери, оплата всех счетов и расходов и прочие прелести жизни матери-одиночки..."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:96 #-#-# translate crowdin gallery_d_100_27ec0460:
msgid "[_susan_] Когда во всей этой рутине появляется хороший мужчина, который заботится о тебе, находит общий язык с твоей дочкой, берет на себя бытовые обязанности..."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:98 #-#-# translate crowdin gallery_d_100_992cdc20:
msgid "[_susan_] А в спальне, во время просмотра кино, на кухне, вообще где угодно и когда угодно так жестко трахает тебя..."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:100 #-#-# translate crowdin gallery_d_100_8cca62fb:
msgid "[_susan_] Тут, знаешь ли, либидо любой женщины начнет искриться всеми цветами радуги..."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:102 #-#-# translate crowdin gallery_d_100_ae1c245f:
msgid "[_cedrick_] Не совсем понял метафору в последней части, но в остальном, хах, да, теперь я понял, о чем ты"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:103 #-#-# translate crowdin gallery_d_100_fcb43ea9:
msgid "[_cedrick_] То есть причиной твоего развратного поведения стал я? Это одновременно приятно и смущающе..."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:105 #-#-# translate crowdin gallery_d_100_2b44dd34:
msgid "[_susan_] Ахах, Рик.. Ну же, иди сюда и выеби меня..."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:107 #-#-# translate crowdin gallery_d_100_d6b5b589:
msgid "[_cedrick_] Хммм..."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:108 #-#-# translate crowdin gallery_d_100_61e44679:
msgid "[_cedrick_] (Вообще, если так подумать, то сейчас утро и Вилл тоже скоро проснется и первым делом, очевидно, пойдет в ванну)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:109 #-#-# translate crowdin gallery_d_100_9903ed88:
msgid "[_cedrick_] (Не хотелось бы тем самым спровоцировать очередную сцену, как в прошлый раз было на кухне)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:110 #-#-# translate crowdin gallery_d_100_ffe0ad44:
msgid "[_cedrick_] (Вилл то уже все прекрасно понимает, но вот Сьюзан...)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:111 #-#-# translate crowdin gallery_d_100_9c5ff608:
msgid "[_cedrick_] (Постоянное столкновение ее дочери с моментами, в которых Сьюзан трахается со мной, может в итоге вызвать неверные ассоциации с процессом)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:112 #-#-# translate crowdin gallery_d_100_ba8369e3:
msgid "[_cedrick_] (Иными словами, если Вилл часто будет нас случайно ловить во время секса, то со временем Сьюзан может закрыться и быть менее откровенной...)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:123 #-#-# translate crowdin gallery_d_100_01f46f45:
msgid "[_cedrick_] Так нравится?"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:125 #-#-# translate crowdin gallery_d_100_0d24b33f:
msgid "[_susan_] Ммммххх, дааа..."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:127 #-#-# translate crowdin gallery_d_100_c9e8f4cc:
msgid "[_susan_] В меру грубо... И в меру нежно... Как и весь ты, Рик... О-обожаю..."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:129 #-#-# translate crowdin gallery_d_100_26ee93b6:
msgid "[_cedrick_] Ух, мне тоже очень нравится, как ощущается твоя киска..."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:130 #-#-# translate crowdin gallery_d_100_bae00d4d:
msgid "[_cedrick_] Она так и пульсирует, словно подзывая меня все глубже и глубже внутрь"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:132 #-#-# translate crowdin gallery_d_100_feb110d0:
msgid "[_susan_] Хах, ты чувствуешь, что говорит тебе моя киска... Не знаю, это мило или странно..."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:134 #-#-# translate crowdin gallery_d_100_eb61b1c4:
msgid "[_susan_] Но мне нравится... Уууухххх, в-вот так, дааа..."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:136 #-#-# translate crowdin gallery_d_100_1571bfb9:
msgid "[_susan_] Дааа, долби меня своим членом сильнее..."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:137 #-#-# translate crowdin gallery_d_100_bae7c34d:
msgid "[_cedrick_] Ах, Сьюзан, ты потрясающая женщина..."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:139 #-#-# translate crowdin gallery_d_100_562bcb48:
msgid "[_cedrick_] Твоя фигура, твои движения, твои желания... Такая развратная, но при этом такая властная... Серьезная и при этом жаждущая властного сильного мужчину..."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:141 #-#-# translate crowdin gallery_d_100_091d80ab:
msgid "[_susan_] Мммм... Хахах, Р-рик, что с тобой? Я восхищаюсь твоим членом, а ты восхищаешься моим характером? Вот это мне определенно нравится..."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:143 #-#-# translate crowdin gallery_d_100_7afa809d:
msgid "[_cedrick_] (Черт, а ведь и правда, что со мной... Это все влияние их семьи и дома, о которых я думал в кровати?)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:145 #-#-# translate crowdin gallery_d_100_24b2cdfa:
msgid "[_cedrick_] (Она же просто мать одной из стражниц... Откуда вообще у меня могли возникнуть теплые чувства...)"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:147 #-#-# translate crowdin gallery_d_100_c566a829:
msgid "[_susan_] Ааааххх... Р-рик, я почти все... Н-не останавливайся..."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:149 #-#-# translate crowdin gallery_d_100_73b3498b:
msgid "[_cedrick_] Д-да... Ммххх, я тоже близко..."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:151 #-#-# translate crowdin gallery_d_100_b9a773c3:
msgid "[_susan_] Заполни меня всю, Рик..."
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:152 #-#-# translate crowdin gallery_d_100_74950778:
msgid "[_cedrick_] Ух, иного варианта у тебя и не было... После того, как твоя киска втягивала мой член, она обязана получить свою порцию спермы"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:154 #-#-# translate crowdin gallery_d_100_62860697:
msgid "[_susan_] Ммммммм, даааа!!"
msgstr ""

# game/scripts/quests/questSleeplessNight/go_to_the_vendom.rpy:157 #-#-# translate crowdin gallery_d_100_85d769b8:
msgid "[_cedrick_] К-кончаю..."
msgstr ""

