# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:233 #-#-# translate crowdin gallery_d_014_b16e7140:
msgid "[_irma_] ПАПА?!"
msgstr ""

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:234 #-#-# translate crowdin gallery_d_014_e8a31e09:
msgid "[_cedrick_] Ох… Прости, дорогая! Ты не закрыла дверь..."
msgstr ""

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:240 #-#-# translate crowdin gallery_d_015_10fef26c:
msgid "[_anna_] Том?"
msgstr ""

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:244 #-#-# translate crowdin gallery_d_015_ce617998:
msgid "…"
msgstr ""

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:245 #-#-# translate crowdin gallery_d_015_f31580f0:
msgid "….."
msgstr ""

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:246 #-#-# translate crowdin gallery_d_015_7f6983a0:
msgid "[_anna_] Я так волновалась…"
msgstr ""

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:250 #-#-# translate crowdin gallery_d_015_7013e5d1:
msgid "[_anna_] Где ты был, черт тебя подери!??"
msgstr ""

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:251 #-#-# translate crowdin gallery_d_015_9678fc51:
msgid "[_anna_] Я вся извелась! Тебя не было несколько недель и тут ты явился!"
msgstr ""

# game/scripts/quests/questNotGuilty/give_miranda_shred_of_tom_lair_hair.rpy:252 #-#-# translate crowdin gallery_d_015_a6697a6c:
msgid "[_cedrick_] Я знаю, что это прозвучит нелепо..."
