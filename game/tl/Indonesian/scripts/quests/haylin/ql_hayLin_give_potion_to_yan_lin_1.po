# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:6 #-#-# translate crowdin ql_hayLin_give_potion_to_yan_lin_1_77013e39:
msgid "[_johnlin_] Рик! Привет! Снова пришел поработать?"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:7 #-#-# translate crowdin ql_hayLin_give_potion_to_yan_lin_1_c8980c22:
msgid "[_cedrick_] Нет, сегодня не смогу вам помочь, извините. Я хочу заскочить к Хай Лин, проведать ее..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:11 #-#-# translate crowdin ql_hayLin_give_potion_to_yan_lin_1_4c5684aa:
msgid "[_johnlin_] Оу, понятно... Ну, проходи! Она у себя в комнате..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:17 #-#-# translate crowdin ql_hayLin_give_potion_to_yan_lin_1_25b8426d:
msgid "[_haylin_] Ты принес лекарство? Моей бабушке опять становится хуже..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:21 #-#-# translate crowdin ql_hayLin_give_potion_to_yan_lin_1_00cba5f4:
msgid "[_cedrick_] Ага, принес... Чего это ты сегодня так нарядилась? Специально для меня?"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:25 #-#-# translate crowdin ql_hayLin_give_potion_to_yan_lin_1_c4c85296:
msgid "[_haylin_] Сегодня 'Цинмин' — это народный праздник, который отмечается на 108 день после зимнего солнцестояния..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:31 #-#-# translate crowdin gallery_d_019_ba1614a0:
msgid "[_cedrick_] Понятно... У меня сегодня тоже кое-что стоит, хе-хе..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:32 #-#-# translate crowdin gallery_d_019_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:33 #-#-# translate crowdin gallery_d_019_e4f9c089:
msgid "[_cedrick_] Ну что ж... Приступим..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:34 #-#-# translate crowdin gallery_d_019_4c312d8c:
msgid "[_cedrick_] Снимай юбку и повернись..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:38 #-#-# translate crowdin gallery_d_019_e667b45f:
msgid "[_haylin_] Подожди! Сперва отдай мне зелье!"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:39 #-#-# translate crowdin gallery_d_019_f1878e9a:
msgid "[_cedrick_] Ну уж нет..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:43 #-#-# translate crowdin gallery_d_019_a4caf49e:
msgid "[_haylin_] Ну так не честно! Дай мне сначала зелье..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:47 #-#-# translate crowdin gallery_d_019_6149be40:
msgid "[_cedrick_] Здесь я ставлю условия! Сперва я тебя трахну и только потом ты получишь лекарство... Если ты, конечно, хочешь, чтобы твоя бабушка осталась жива... А ведь я могу все вылить, смотри..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:51 #-#-# translate crowdin gallery_d_019_39f682ad:
msgid "[_haylin_] Стой, подожди! Я согласна!"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:55 #-#-# translate crowdin gallery_d_019_fefa6166:
msgid "[_haylin_] Но почему ты это делаешь? Зачем я тебе?"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:59 #-#-# translate crowdin gallery_d_019_9e046424:
msgid "[_cedrick_] Это не так важно... Можешь считать, что это мои инстинкты... Тем более сегодня праздник, так?"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:60 #-#-# translate crowdin gallery_d_019_810c7faa:
msgid "[_cedrick_] Давай все сделаем аккуратно и красиво. Сейчас ты ляжешь на кровать, потерпишь и в конце, после того, как я в тебя кончу, отдам тебе зелье, которое так тебе нужно... По-моему это равноценный обмен, да?"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:64 #-#-# translate crowdin gallery_d_019_8311d86a:
msgid "[_haylin_] Только давай быстрее, пока мои родители не поднялись к нам..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:65 #-#-# translate crowdin gallery_d_019_86d79b06:
msgid "[_cedrick_] Я всегда знал, что ты умная девочка..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:68 #-#-# translate crowdin gallery_d_019_49316299:
msgid "[_cedrick_] ..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:70 #-#-# translate crowdin gallery_d_019_fb46895a:
msgid "[_haylin_] Ау..!"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:72 #-#-# translate crowdin gallery_d_019_13b9eceb:
msgid "[_haylin_] Рик... Мне больно..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:74 #-#-# translate crowdin gallery_d_019_60c87c63:
msgid "[_cedrick_] Терпи, девчонка... Сначала будет немного больно, потом станет лучше... Скоро ты привыкнешь и тебе начнет нравится..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:79 #-#-# translate crowdin gallery_d_019_bbdbfe5c:
msgid "[_haylin_] Ахх! Полегче... Рик!"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:80 #-#-# translate crowdin gallery_d_019_b9775c22:
msgid "[_cedrick_] О да-а... всегда хотел трахнуть азиатскую шлюшку..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:81 #-#-# translate crowdin gallery_d_019_cbd5bd3e:
msgid "[_haylin_] Ах..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:82 #-#-# translate crowdin gallery_d_019_49316299_1:
msgid "[_cedrick_] ..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:83 #-#-# translate crowdin gallery_d_019_774f7b6d:
msgid "[_cedrick_] О-ох... Кажется... Я сейчас кончу..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:88 #-#-# translate crowdin gallery_d_019_3cb194f8:
msgid "[_cedrick_] О да-а-а..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:89 #-#-# translate crowdin gallery_d_019_5de55156:
msgid "[_haylin_] Наконец-то... У меня голова кружится... Что-то не так..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:94 #-#-# translate crowdin gallery_d_019_40644dca:
msgid "[_centered_] {size=36}СЕДРИК ВЫХОДИТ ИЗ КОМНАТЫ ХАЙ ЛИН, НЕДАЛЕКО ОТ ВХОДНОЙ ДВЕРИ ОН ВСТРЕЧАЕТ ДЖОАН ЛИН{/size}"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:99 #-#-# translate crowdin gallery_d_020_7a1debb9:
msgid "[_johnlin_] Рик, вы уже уходите?"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:103 #-#-# translate crowdin gallery_d_020_fecfc850:
msgid "[_cedrick_] А, д-да, мы с Хай Лин уже сделали все, что планировали, так что я ухожу. Не хочу ее задерживать"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:104 #-#-# translate crowdin gallery_d_020_3699dc24:
msgid "[_cedrick_] (Фух, я чуть не попался. Держу пари, она уже направлялась в комнату Хай Лин, чтобы проверить, что мы делаем)"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:108 #-#-# translate crowdin gallery_d_020_779a8ff1:
msgid "[_johnlin_] Знаете, Рик. Я понимаю, что вы помогаете моей дочери и все такое.."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:112 #-#-# translate crowdin gallery_d_020_9fd5c1bd:
msgid "[_johnlin_] Но, не кажется ли вам, что для школьного учителя вы проводите слишком много времени со своей ученицей?"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:116 #-#-# translate crowdin gallery_d_020_9daa7071:
msgid "[_cedrick_] (Черт! Я оказался слишком подозрительным.. Нужно было сразу догадаться, что такая строгая мать обратит внимание на подобное..)"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:120 #-#-# translate crowdin gallery_d_020_9d3d41de:
msgid "[_johnlin_] ..Вы что, встречаетесь с Хай Лин?"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:124 #-#-# translate crowdin gallery_d_020_d3dfd0c8:
msgid "[_cedrick_] Ч-Что..?"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:128 #-#-# translate crowdin gallery_d_020_fb46fc06:
msgid "[_johnlin_] Я могу понять, если вы это скрываете.. Все же Хай Лин считает меня через чур опекающей.. Возможно, иногда даже деспотичной матерью.."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:132 #-#-# translate crowdin gallery_d_020_38bf0862:
msgid "[_johnlin_] К тому же вы ее учитель и, очевидно, молчали бы о подобных отношениях, даже если бы они оказались правдой.."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:136 #-#-# translate crowdin gallery_d_020_6359fb71:
msgid "[_cedrick_] Эм.. Я.. Я не понимаю, о чем вы"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:140 #-#-# translate crowdin gallery_d_020_3c42351d:
msgid "[_johnlin_] Все в порядке, Рик. Как я уже говорила, вы проявили себя как хорошего молодого человека.."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:141 #-#-# translate crowdin gallery_d_020_487a2b9f:
msgid "[_johnlin_] Так что, несмотря на то, что вы учитель и значительно старше Хай Лин, я была бы не против, если бы моя дочь была с таким человеком, как вы, Рик"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:145 #-#-# translate crowdin gallery_d_020_13877006:
msgid "[_cedrick_] Миссис Лин.."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:149 #-#-# translate crowdin gallery_d_020_c4d97780:
msgid "[_johnlin_] К тому же, мой муж тоже был старше меня, когда мы только начинали встречаться, я могу ее понять. Это всегда кажется интересным.. По крайней мере в ее возрасте..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:153 #-#-# translate crowdin gallery_d_020_cb9fe82c:
msgid "[_cedrick_] Мне кажется, вы торопите события.."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:157 #-#-# translate crowdin gallery_d_020_f44627d6:
msgid "[_johnlin_] Потом, конечно, возраст берет свое.. Мужчинам все эти возрастные изменения пережить куда труднее.."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:161 #-#-# translate crowdin gallery_d_020_620ba371:
msgid "[_johnlin_] Знаете, Рик, надеюсь вы с такими проблемами не столкнетесь, когда станете старше.. Ради блага моей же дочери"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:162 #-#-# translate crowdin gallery_d_020_e3f820c1:
msgid "[_cedrick_] (Куда эту женщину понесло.. Она что, только что говорила о том, что у ее мужа импотенция или мне показалось?)"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:163 #-#-# translate crowdin gallery_d_020_7401cb4f:
msgid "[_johnlin_] Ох, что-то я забегаю вперед.. Во всяком случае, Рик, надеюсь, вы хорошо обращаетесь с моей дочерью"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:167 #-#-# translate crowdin gallery_d_020_b5934ce2:
msgid "[_cedrick_] ...Можете не сомневаться"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:171 #-#-# translate crowdin gallery_d_020_a8efa71a:
msgid "[_johnlin_] Вот и хорошо.. На самом деле, я завела весь этот разговор только для того, чтобы взять у вас номер телефона"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:175 #-#-# translate crowdin gallery_d_020_be4dcd43:
msgid "[_cedrick_] ...Что?"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:179 #-#-# translate crowdin gallery_d_020_48dae285:
msgid "[_johnlin_] Я уже взяла номера у всех новых подруг Хай Лин, чтобы всегда знать где она, если вдруг что-то случится. Раз вы так много времени проводите с моей дочерью, я должна взять и ваш номер"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:183 #-#-# translate crowdin gallery_d_020_c99a0813:
msgid "[_cedrick_] А..."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:184 #-#-# translate crowdin gallery_d_020_848ddb18:
msgid "[_cedrick_] (Что-то я уже совсем не о том думаю..)"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:185 #-#-# translate crowdin gallery_d_020_5aa5f7c0:
msgid "[_cedrick_] Да, конечно.. Ох, вот беда, я не помню свой номер, у меня новый телефон)"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:186 #-#-# translate crowdin gallery_d_020_b9829505:
msgid "[_cedrick_] (Не хочу, чтобы она звонила мне каждый раз, когда я трахаюсь с Хай Лин..)"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:190 #-#-# translate crowdin gallery_d_020_ae3343f9:
msgid "[_johnlin_] Ничего страшного, вы можете записать мой номер и как только позвоните мне, я буду знать ваш"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:194 #-#-# translate crowdin gallery_d_020_13b9e06b:
msgid "[_cedrick_] ...Ну хорошо ...Секунду, достану свой телефон"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:197 #-#-# translate crowdin gallery_d_020_a20cefa7:
msgid "..."
msgstr "..."

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:203 #-#-# translate crowdin gallery_d_020_7c203972:
msgid "[_johnlin_] Это... Это же мой старый телефон.. О-откуда он у вас!?"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:208 #-#-# translate crowdin gallery_d_020_fbbf8d21:
msgid "[_cedrick_] В-ваш телефон?!"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:212 #-#-# translate crowdin gallery_d_020_3d7cf352:
msgid "[_johnlin_] ...В-верните его!"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:216 #-#-# translate crowdin gallery_d_020_8e46f5f2:
msgid "[_cedrick_] Секундочку... Так те развратные диалоги... Вы та шлюха, что берет за анал 100 баксов в час!?"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:220 #-#-# translate crowdin gallery_d_020_ff07a9f3:
msgid "[_johnlin_] Т-тише.. Не кричите так, люди могут услышать.."
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:224 #-#-# translate crowdin gallery_d_020_dbf6207a:
msgid "[_cedrick_] Хооо, так значит, вот какая вы на самом деле.. На словах строгая, а на деле такая развратница?"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:228 #-#-# translate crowdin gallery_d_020_d9f7d7d8:
msgid "[_johnlin_] ...Вы ничего не докажете"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:232 #-#-# translate crowdin gallery_d_020_41be354c:
msgid "[_cedrick_] Да неужели? Получается Любимый – это ваш муж. Интересно, что будет, если я ему наберу и попрошу встретиться. Я думаю он узнает старый телефон своей жены"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:236 #-#-# translate crowdin gallery_d_020_4d21bde3:
msgid "[_johnlin_] ...Рик ...чего вы хотите?"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:240 #-#-# translate crowdin gallery_d_020_3b10a5ea:
msgid "[_cedrick_] После того, что я о вас узнал.. Все, чего я сейчас хочу – это узнать, на сколько ты хороша, Джоан"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:244 #-#-# translate crowdin gallery_d_020_26588a88:
msgid "[_johnlin_] ...Черт, я так и знала, что все к этому приведет. Нужно было просто промолчать на счет телефона, дура"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:248 #-#-# translate crowdin gallery_d_020_2c42db90:
msgid "[_cedrick_] Ну так что?"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:252 #-#-# translate crowdin gallery_d_020_cea57eae:
msgid "[_johnlin_] Не здесь.. Давай спустимся в подвал"
msgstr ""

# game/scripts/quests/haylin/ql_hayLin_give_potion_to_yan_lin_1.rpy:254 #-#-# translate crowdin gallery_d_020_2206b40d:
msgid "[_centered_] {size=36}СПУСТИВШИСЬ В ПОДВАЛ, ДЖОАН СРАЗУ ВСТАЕТ НА КОЛЕНИ И ДОСТАЕТ ЧЛЕН СЕДРИКА{/size} [withDissolve1]"
msgstr ""

