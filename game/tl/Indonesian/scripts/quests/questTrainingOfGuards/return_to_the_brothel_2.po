# TODO: Translation updated at 2024-04-26 10:51 #|#|# # game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:5 #-#-# translate crowdin return_to_the_brothel_2_23a021dd:
msgid "[_cedrick_] И так, все в сборе. Рад, что каждая из вас добралась сюда в целости"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:8 #-#-# translate crowdin return_to_the_brothel_2_edd851c8:
msgid "[_cedrick_] Вилл..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:12 #-#-# translate crowdin return_to_the_brothel_2_7ee095ca:
msgid "[_cedrick_] Ирма..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:16 #-#-# translate crowdin return_to_the_brothel_2_31486bbe:
msgid "[_cedrick_] Тарани..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:20 #-#-# translate crowdin return_to_the_brothel_2_d722669d:
msgid "[_cedrick_] Корнелия..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:24 #-#-# translate crowdin return_to_the_brothel_2_c0bd74b4:
msgid "[_cedrick_] Хай Лин..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:25 #-#-# translate crowdin return_to_the_brothel_2_3e36a57f:
msgid "[_cedrick_] Мы убираемся отсюда"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:26 #-#-# translate crowdin return_to_the_brothel_2_e1d4d7cb:
msgid "[_cedrick_] Обратно. На землю."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:30 #-#-# translate crowdin return_to_the_brothel_2_183ed543:
msgid "[_will_] Рик... Я в тебе не сомневалась"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:34 #-#-# translate crowdin return_to_the_brothel_2_5bafa8c5:
msgid "[_irma_] И все же, ты оказался не таким уж злодеем"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:38 #-#-# translate crowdin return_to_the_brothel_2_cc0dcc2d:
msgid "[_tarani_] Я бы не была столь однозначна на его счет... У нас просто теперь схожие интересы"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:42 #-#-# translate crowdin return_to_the_brothel_2_2273ed58:
msgid "[_cornelia_] А я вот уже давно поняла, что Седрик не такой плохиш, каким хочет показаться. Это все нити Фобоса за его спиной делали из Седрика монстра"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:46 #-#-# translate crowdin return_to_the_brothel_2_43c38bdd:
msgid "[_haylin_] Но, даже с учетом этого... Как будто мы сможем его простить..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:50 #-#-# translate crowdin return_to_the_brothel_2_49316299:
msgid "[_cedrick_] ..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:54 #-#-# translate crowdin return_to_the_brothel_2_b5153673:
msgid "[_cedrick_] Вам и не нужно меня прощать... Просто... Теперь мы на одной стороне и будем сражаться за одно дело..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:55 #-#-# translate crowdin return_to_the_brothel_2_481d31e5:
msgid "[_cedrick_] А после того, как уничтожим общего врага, уже и будем думать о прошлом и его ошибках... Сейчас для нас это непозволительная роскошь..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:59 #-#-# translate crowdin return_to_the_brothel_2_209dd42f:
msgid "[_will_] Да, ты прав..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:63 #-#-# translate crowdin return_to_the_brothel_2_d7bd70d9:
msgid "[_irma_] И все же... Прежде чем мы согласимся сотрудничать с тобой, думаю стоит прояснить пару моментов, Седрик. Больше ты никогда нам не навредишь"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:67 #-#-# translate crowdin return_to_the_brothel_2_b6fef3af:
msgid "[_tarani_] И нашим близким тоже. Ни семье, ни друзьям..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:71 #-#-# translate crowdin return_to_the_brothel_2_c996d946:
msgid "[_cornelia_] Хм..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:75 #-#-# translate crowdin return_to_the_brothel_2_8550c4f8:
msgid "[_haylin_] И больше никого не будешь совращать... Вообще никого... Тебе ясно!?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:79 #-#-# translate crowdin return_to_the_brothel_2_942f985d:
msgid "[_cedrick_] (Хах, само собой, теперь пошли требования. Вполне ожидаемо. Что ж, к этому был готов)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:80 #-#-# translate crowdin return_to_the_brothel_2_ea4dbb6c:
msgid "[_cedrick_] (Переход от захватчика в их союзника неизбежно накладывает на меня множество ограничений)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:81 #-#-# translate crowdin return_to_the_brothel_2_9751d50b:
msgid "[_cedrick_] (Большинство из них, конечно же, я буду обходить с помощью лжи и уловок, если это будет необходимо)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:82 #-#-# translate crowdin return_to_the_brothel_2_2155e29e:
msgid "[_cedrick_] (Но... Взаимодействовать с ними напрямую с помощью насилия я больше не смогу. Теперь для меня это будет дорогой в один конец)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:83 #-#-# translate crowdin return_to_the_brothel_2_55ffbfe4:
msgid "[_cedrick_] (Попытайся я совратить кого-то из них еще раз против воли и мне этого уже никогда не простят...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:84 #-#-# translate crowdin return_to_the_brothel_2_f7d927d3:
msgid "[_cedrick_] (С другой стороны, как минимум Вилл и Корнелия и так будут полностью на все согласны и зачастую добровольно)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:85 #-#-# translate crowdin return_to_the_brothel_2_59c39f34:
msgid "[_cedrick_] (А значит, и с остальными при должном старании может еще получиться... Я просто должен быть аккуратнее и хитрее)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:86 #-#-# translate crowdin return_to_the_brothel_2_394550f6:
msgid "[_cedrick_] (Словно теперь вместо кувалды как основного инструмента я буду использовать хирургический скальпель. Сложно, но не невозможно...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:87 #-#-# translate crowdin return_to_the_brothel_2_3ae8440f:
msgid "[_cedrick_] Я согласен"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:91 #-#-# translate crowdin return_to_the_brothel_2_5373f32c:
msgid "[_will_] Что ж. Вот и разобрались. Тогда, думаю, можем отправляться"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:95 #-#-# translate crowdin return_to_the_brothel_2_8adfbff5:
msgid "[_tarani_] Не так быстро. Я хочу, чтобы ты раз и навсегда уяснил. Я никогда не прощу тебя за то, что произошло с Найджелом"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:99 #-#-# translate crowdin return_to_the_brothel_2_c47b56c5:
msgid "[_haylin_] Как и я не прощу того, что из-за тебя моя семья могла развалиться"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:103 #-#-# translate crowdin return_to_the_brothel_2_edfb176d:
msgid "[_tarani_] Мы еще не союзники. Все наши условия мы скажем позже. А пока... Хм... Пока что ты на испытательном сроке, Седрик"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:107 #-#-# translate crowdin return_to_the_brothel_2_10426948:
msgid "[_cedrick_] Справедливо..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:108 #-#-# translate crowdin return_to_the_brothel_2_b6815c8f:
msgid "[_cedrick_] В любом случае, я бы обсудил это на земле. Или вы хотите и дальше торчать в борделе?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:112 #-#-# translate crowdin return_to_the_brothel_2_bd340a89:
msgid "[_cornelia_] Да, думаю нам пора"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:118 #-#-# translate crowdin gallery_d_099_74f09c2c:
msgid "[_vanessa_] А ну ка подождите, девочки"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:122 #-#-# translate crowdin gallery_d_099_d4a80b83:
msgid "[_cedrick_] (В-ванесса!? Что она здесь делает... Ч-что она задумала?)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:126 #-#-# translate crowdin gallery_d_099_f6a4d413:
msgid "[_vanessa_] Прежде чем вы куда либо уйдете, я должна убедиться, что мои девочки хоть чему-то научились"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:130 #-#-# translate crowdin gallery_d_099_7cd62039:
msgid "[_haylin_] О боже... н-нет..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:134 #-#-# translate crowdin gallery_d_099_e5a6f65c:
msgid "[_cedrick_] (Стражницы все еще думают, что Ванесса посланник Фобоса, поэтому они не будут перечить ей, чтобы не вызывать подозрений)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:135 #-#-# translate crowdin gallery_d_099_e1ac8343:
msgid "[_cedrick_] (Ванесса хочет этим воспользоваться? Или же усилить эффект неприязни к Фобосу)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:139 #-#-# translate crowdin gallery_d_099_03a7864d:
msgid "[_vanessa_] Как Корнелия и Хай Лин справляются с мужчиной я уже примерно поняла. Но что на счет женщин? Здесь как раз полно кандидаток для проверки"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:143 #-#-# translate crowdin gallery_d_099_bb5485b7:
msgid "[_cornelia_] Ч-что... Подождите, мы..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:147 #-#-# translate crowdin gallery_d_099_1c8999b5:
msgid "[_vanessa_] И так, ты, пухленькая рыжеволосая, отойди"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:151 #-#-# translate crowdin gallery_d_099_592f7b0f:
msgid "[_irma_] Я-я!? Но... Почему?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:155 #-#-# translate crowdin gallery_d_099_6ea6db85:
msgid "[_vanessa_] Потому что на тебе проверить их навыки не удастся. Я ведь сразу по твоему лицу все вижу"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:159 #-#-# translate crowdin gallery_d_099_6d94cabf:
msgid "[_vanessa_] Если одна из этих девушек начнет ласкать тебя, то ты точно получишь от этого кайф, даже не важно, насколько умело они будут это делать"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:163 #-#-# translate crowdin gallery_d_099_9acb3e9f:
msgid "[_irma_] ....."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:164 #-#-# translate crowdin gallery_d_099_c3d736eb:
msgid "[_tarani_] Кхм..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:168 #-#-# translate crowdin gallery_d_099_6b9110a7:
msgid "[_vanessa_] Так, Корнелия. Ты займешься красноволосой. Хай Лин, возьми на себя малышку в очках"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:172 #-#-# translate crowdin gallery_d_099_0e880219:
msgid "[_tarani_] Ч-что!? Н-нет, я..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:174 #-#-# translate crowdin gallery_d_099_85ce6671:
msgid "[_will_] Аааххх..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:177 #-#-# translate crowdin gallery_d_099_33852617:
msgid "[_will_] Ммммххх.. Р-рик..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:179 #-#-# translate crowdin gallery_d_099_c6343382:
msgid "[_cornelia_] (Прости, Вилл, но чем быстрее мы закончим, тем быстрее сможем вернуться домой. Просто расслабься получай удовольствие)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:181 #-#-# translate crowdin gallery_d_099_0e0c6c19:
msgid "[_vanessa_] Как ощущения, малышка?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:183 #-#-# translate crowdin gallery_d_099_35441aa0:
msgid "[_will_] Ааааххх... Это... Это определенно... Неожиданно... Н-но... Приятно..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:185 #-#-# translate crowdin gallery_d_099_261eb0a7:
msgid "[_will_] Р-руки Корнелии очень нежные и достаточно аккуратные... Н-но при этом она двигается интенсивно..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:187 #-#-# translate crowdin gallery_d_099_d9c97445:
msgid "[_vanessa_] А что насчет ее рта?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:189 #-#-# translate crowdin gallery_d_099_97e78d56:
msgid "[_will_] Аааавввв... Ее рот... Боже... Такие мягкие губы, мои соски моментально твердеют... Н-но..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:191 #-#-# translate crowdin gallery_d_099_242f7b3a:
msgid "[_will_] Но при этом она нещадно стимулирует меня своим языком... Это очень интенсивно... Н-но, при этом очень приятно..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:193 #-#-# translate crowdin gallery_d_099_cc9d1afb:
msgid "[_cornelia_] (Вау, я даже не ожидала, что Вилл окажется такой отзывчивой. Видимо ей и вправду нравится)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:194 #-#-# translate crowdin gallery_d_099_703b1e0d:
msgid "[_cornelia_] (Интересно, дело в моих навыках или же в том, что Вилл изначально была настроена на ласки...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:195 #-#-# translate crowdin gallery_d_099_d2ff30aa:
msgid "[_cornelia_] (К тому же, в самом начале она выкрикнула не мое имя, а Седрика. Хм... Интересно...)"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:196 #-#-# translate crowdin gallery_d_099_e86b3adc:
msgid "[_vanessa_] Хорошо, а как успехи у вас, девочки?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:199 #-#-# translate crowdin gallery_d_099_5cddee09:
msgid "[_tarani_] Ааааххх... Х-хай Лин, п-перестань... Я же так... Аааввв..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:201 #-#-# translate crowdin gallery_d_099_c352c503:
msgid "[_haylin_] П-прости, Тарани... Но я... Я хочу закончить с этим как можно скорее... И... И если придется довести тебя до оргазма... Я сделаю это"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:203 #-#-# translate crowdin gallery_d_099_41e447be:
msgid "[_tarani_] Ммммхххх... Н-не так напористо... Т-ты слишком сильно сжимаешь мою грудь..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:205 #-#-# translate crowdin gallery_d_099_2a3a0392:
msgid "[_vanessa_] И так, девушка в очках, какие твои впечатления?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:207 #-#-# translate crowdin gallery_d_099_54b289b5:
msgid "[_tarani_] Кхм, я... Аааххх... Это заставляет чувствовать себя неловко... И... И немного раздражает..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:209 #-#-# translate crowdin gallery_d_099_f4191138:
msgid "[_tarani_] Но, возможно, раздражение в основном связано с вашими надоедливыми вопросами..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:211 #-#-# translate crowdin gallery_d_099_66537006:
msgid "[_vanessa_] Ого, у нас тут малышка с характером. Так так, а что скажешь на счет навыков Хай Лин?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:213 #-#-# translate crowdin gallery_d_099_4fab97a6:
msgid "[_tarani_] Мммм... О-она слишком торопится... Ее напор не соответствует моему ритму, она не совсем хорошо считывает мое настроение"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:215 #-#-# translate crowdin gallery_d_099_77200b0b:
msgid "[_haylin_] Ох..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:217 #-#-# translate crowdin gallery_d_099_2b9cc362:
msgid "[_tarani_] Н-но при этом с моей киской она справляется довольно хорошо..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:219 #-#-# translate crowdin gallery_d_099_1673c12f:
msgid "[_vanessa_] Хм.. Как думаешь, с чем это может быть связано?"
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:221 #-#-# translate crowdin gallery_d_099_bb16e59b:
msgid "[_tarani_] Я... Аааххх... Я не знаю..."
msgstr ""

# game/scripts/quests/questTrainingOfGuards/return_to_the_brothel_2.rpy:223 #-#-# translate crowdin gallery_d_099_585d54bb:
msgid "[_vanessa_] Может есть какие-нибудь идеи или предположения?"
msgstr ""

